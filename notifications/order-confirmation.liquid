{% comment %}
  DYNAEIMIC — Order confirmation email
  Paste into: Shopify admin → Settings → Notifications → Customer notifications
  → Order confirmation → Edit code (replace everything, Save).
  Email clients are strict: tables + inline styles only, system fonts.
{% endcomment %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order {{ order_name }}</title>
</head>
<body style="margin:0;padding:0;background:#b3242a;">
  <!-- word-wall top band -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#b3242a;">
    <tr>
      <td align="center" style="padding:18px 10px 6px;font-family:Arial Black,Arial,sans-serif;font-size:11px;font-weight:900;letter-spacing:2px;color:#8f1d22;line-height:1.9;">
        &ldquo;MUG&rdquo;&nbsp;&nbsp;&ldquo;PEN&rdquo;&nbsp;&nbsp;&ldquo;WALLET&rdquo;&nbsp;&nbsp;&ldquo;TUMBLER&rdquo;&nbsp;&nbsp;&ldquo;BOOKMARK&rdquo;&nbsp;&nbsp;&ldquo;T-SHIRT&rdquo;&nbsp;&nbsp;&ldquo;TROPHY&rdquo;&nbsp;&nbsp;&ldquo;NOTE BOOK&rdquo;
      </td>
    </tr>
    <tr>
      <td align="center" style="padding:6px 16px 0;">
        <!-- logo -->
        <div style="display:inline-block;background:#111010;color:#f4efe3;font-family:Arial Black,Arial,sans-serif;font-size:26px;font-weight:900;letter-spacing:6px;padding:10px 22px;border:3px solid #f4efe3;">
          DYNAEIMIC
        </div>
      </td>
    </tr>
    <tr>
      <td align="center" style="padding:22px 12px 34px;">
        <!-- cream card -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:94%;background:#f4efe3;border:3px solid #111010;">
          <tr>
            <td style="padding:30px 30px 10px;">
              <div style="font-family:Arial Black,Arial,sans-serif;font-size:24px;font-weight:900;letter-spacing:2px;color:#111010;text-transform:uppercase;">
                Order confirmed
              </div>
              <div style="width:120px;height:4px;background:#b3242a;margin:10px 0 18px;"></div>
              <div style="font-family:Georgia,'Times New Roman',serif;font-size:15px;color:#111010;line-height:1.6;">
                {% if customer.first_name %}Hey {{ customer.first_name }},{% else %}Hey,{% endif %}
                thanks for your order <strong>{{ order_name }}</strong>!
                We&rsquo;re prepping your custom pieces — made to order in 3&ndash;5 days.
              </div>
            </td>
          </tr>
          <tr>
            <td align="left" style="padding:8px 30px 24px;">
              <a href="{{ order_status_url }}"
                 style="display:inline-block;background:#111010;color:#f4efe3;font-family:Arial Black,Arial,sans-serif;font-size:13px;font-weight:900;letter-spacing:3px;text-transform:uppercase;text-decoration:none;padding:13px 26px;border:2px solid #111010;">
                View your order &rarr;
              </a>
            </td>
          </tr>

          <!-- items -->
          <tr>
            <td style="padding:0 30px;">
              <div style="font-family:Arial Black,Arial,sans-serif;font-size:12px;font-weight:900;letter-spacing:3px;color:#b3242a;text-transform:uppercase;border-bottom:2px solid #111010;padding-bottom:8px;">
                Your items
              </div>
            </td>
          </tr>
          {% for line in subtotal_line_items %}
          <tr>
            <td style="padding:16px 30px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  {% if line.image %}
                  <td width="72" valign="top" style="padding-right:14px;">
                    <img src="{{ line | img_url: 'compact_cropped' }}" alt="" width="72" style="display:block;border:2px solid #111010;background:#ffffff;">
                  </td>
                  {% endif %}
                  <td valign="top" style="font-family:Georgia,'Times New Roman',serif;font-size:14px;color:#111010;line-height:1.5;">
                    <strong>{{ line.title }}</strong> &times; {{ line.quantity }}
                    {% if line.properties.size > 0 %}
                      <div style="font-size:12.5px;color:#4a4540;padding-top:4px;">
                      {% for p in line.properties %}
                        {% assign pfx = p.first | slice: 0, 1 %}
                        {% if p.last != blank and pfx != '_' %}
                          {% if p.last contains 'http' %}
                            {{ p.first }}: <a href="{{ p.last }}" style="color:#b3242a;">view file</a><br>
                            {% if p.last contains '.png' or p.last contains '.jpg' or p.last contains '.jpeg' %}
                              <img src="{{ p.last }}" alt="{{ p.first }}" width="180" style="display:block;max-width:180px;border:2px solid #111010;margin:6px 0;background:#ffffff;">
                            {% endif %}
                          {% else %}
                            {{ p.first }}: {{ p.last }}<br>
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                      </div>
                    {% endif %}
                  </td>
                  <td valign="top" align="right" style="font-family:Arial,sans-serif;font-size:14px;font-weight:bold;color:#111010;white-space:nowrap;padding-left:10px;">
                    {{ line.final_line_price | money }}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endfor %}

          <!-- totals -->
          <tr>
            <td style="padding:22px 30px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:2px solid #111010;">
                <tr>
                  <td style="font-family:Georgia,serif;font-size:14px;color:#111010;padding-top:12px;">Subtotal</td>
                  <td align="right" style="font-family:Arial,sans-serif;font-size:14px;color:#111010;padding-top:12px;">{{ subtotal_price | money }}</td>
                </tr>
                {% if discounts %}
                <tr>
                  <td style="font-family:Georgia,serif;font-size:14px;color:#b3242a;padding-top:6px;">Discount</td>
                  <td align="right" style="font-family:Arial,sans-serif;font-size:14px;color:#b3242a;padding-top:6px;">&minus;{{ discounts_amount | money }}</td>
                </tr>
                {% endif %}
                {% for shipping_line in shipping_lines %}
                <tr>
                  <td style="font-family:Georgia,serif;font-size:14px;color:#111010;padding-top:6px;">Shipping ({{ shipping_line.title }})</td>
                  <td align="right" style="font-family:Arial,sans-serif;font-size:14px;color:#111010;padding-top:6px;">{{ shipping_line.price | money }}</td>
                </tr>
                {% endfor %}
                {% if tax_price > 0 %}
                <tr>
                  <td style="font-family:Georgia,serif;font-size:14px;color:#111010;padding-top:6px;">Tax</td>
                  <td align="right" style="font-family:Arial,sans-serif;font-size:14px;color:#111010;padding-top:6px;">{{ tax_price | money }}</td>
                </tr>
                {% endif %}
                <tr>
                  <td style="font-family:Arial Black,Arial,sans-serif;font-size:16px;font-weight:900;letter-spacing:1px;color:#111010;padding-top:12px;text-transform:uppercase;">Total</td>
                  <td align="right" style="font-family:Arial Black,Arial,sans-serif;font-size:16px;font-weight:900;color:#111010;padding-top:12px;">{{ total_price | money }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- shipping address -->
          {% if shipping_address %}
          <tr>
            <td style="padding:26px 30px 30px;">
              <div style="font-family:Arial Black,Arial,sans-serif;font-size:12px;font-weight:900;letter-spacing:3px;color:#b3242a;text-transform:uppercase;border-bottom:2px solid #111010;padding-bottom:8px;margin-bottom:10px;">
                Shipping to
              </div>
              <div style="font-family:Georgia,serif;font-size:14px;color:#111010;line-height:1.6;">
                {{ shipping_address | format_address }}
              </div>
            </td>
          </tr>
          {% endif %}
        </table>
      </td>
    </tr>

    <!-- footer band -->
    <tr>
      <td align="center" style="background:#111010;padding:20px 12px 8px;">
        <div style="font-family:Arial Black,Arial,sans-serif;font-size:10px;font-weight:900;letter-spacing:2px;color:#3b3734;line-height:1.9;">
          &ldquo;CRYSTAL BALL&rdquo;&nbsp;&nbsp;&ldquo;TROPHY&rdquo;&nbsp;&nbsp;&ldquo;MUG&rdquo;&nbsp;&nbsp;&ldquo;BOOKMARK&rdquo;&nbsp;&nbsp;&ldquo;PEN&rdquo;&nbsp;&nbsp;&ldquo;WALLET&rdquo;&nbsp;&nbsp;&ldquo;T-SHIRT&rdquo;
        </div>
      </td>
    </tr>
    <tr>
      <td align="center" style="background:#111010;padding:4px 12px 26px;">
        <div style="font-family:Arial Black,Arial,sans-serif;font-size:12px;font-weight:900;letter-spacing:4px;color:#f4efe3;text-transform:uppercase;">
          DYNAEIMIC &mdash; design your own
        </div>
        <div style="font-family:Georgia,serif;font-size:12px;color:#8a837c;padding-top:6px;">
          Questions? Just reply to this email.
        </div>
      </td>
    </tr>
  </table>
</body>
</html>
