{%- comment -%}
  Browser-tab favicon.

  Preferred: upload a square image in Theme settings (if your theme
  settings include a "Favicon" field) - this snippet will use it and
  it works in every browser, including Safari.

  Fallback: with no theme-settings favicon, a drawn mark ships inline -
  a black square with the cream "D" and red quote marks, matching the
  zine look. No upload needed (Safari may ignore SVG favicons; upload
  one in theme settings for full coverage there).

  Install: render this once in the <head> of layout/theme.liquid:
    {% render 'dynamic-favicon' %}
{%- endcomment -%}
{%- if settings.favicon != blank -%}
<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
<link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
{%- else -%}
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230e0c0d'/%3E%3Ctext x='30' y='47' font-family='Arial Black,Arial,sans-serif' font-size='42' font-weight='900' fill='%23f2efe9' text-anchor='middle'%3ED%3C/text%3E%3Crect x='48' y='14' width='4' height='9' fill='%23e10600'/%3E%3Crect x='54' y='14' width='4' height='9' fill='%23e10600'/%3E%3C/svg%3E">
{%- endif -%}
