{%- comment -%}
  Site-wide phone hamburger menu, matching the hero's: a torn-paper tab
  (hamburger icon only) fixed top-RIGHT on phones on every page — the
  back button keeps the top-left. Tapping it springs a full-page
  crumpled-paper menu down from the top, closed by a stamped ink X.
  On the landing-hero page the hero's own tab takes over and this one
  hides itself.

  Menu background image: upload a file named  dyn-menu-paper.png  (or
  .jpg) in Shopify admin > Content > Files and it becomes the full-page
  paper behind the open menu. Delete the file to go back to the
  built-in crumpled paper.

  Links come from Online Store -> Navigation. Default menu: "main-menu".

  Install: render this once in layout/theme.liquid, right AFTER the
  opening <body ...> tag:
    {% render 'dynamic-menu' %}
  To use a different navigation menu:
    {% render 'dynamic-menu', menu: 'footer' %}
{%- endcomment -%}
{%- assign gm_handle = menu | default: 'main-menu' -%}
{%- assign gm_nav = linklists[gm_handle] -%}
{%- assign gm_paper = images['dyn-menu-paper.png'] -%}
{%- if gm_paper == blank -%}{%- assign gm_paper = images['dyn-menu-paper.jpg'] -%}{%- endif -%}
{%- if gm_nav != blank and gm_nav.links.size > 0 -%}
<style>
  :root { --gmx: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Cg%20fill='%23141110'%3E%3Cpath%20d='M10.5%2014%2016%206.5%2023.5%2010%2033%2021.5%2042%209%2050.5%205%2057%2012.5%2051.5%2020%2040.5%2031%2050%2041.5%2058%2050%2051%2058%2042.5%2053%2032%2041.5%2021.5%2054%2013%2058%206%2050.5%2012.5%2043%2022.5%2031%2014%2021.5Z'/%3E%3Ccircle%20cx='8'%20cy='5'%20r='1.7'/%3E%3Ccircle%20cx='26'%20cy='3.4'%20r='1.1'/%3E%3Ccircle%20cx='59.4'%20cy='30'%20r='1.3'/%3E%3Ccircle%20cx='4.6'%20cy='33'%20r='1.2'/%3E%3Ccircle%20cx='33'%20cy='61'%20r='1.5'/%3E%3Ccircle%20cx='58'%20cy='59.4'%20r='1'/%3E%3C/g%3E%3C/svg%3E"); }
  /* torn-paper menu tab: cream stock, ink outline, dot shadow (same family as the hero's) */
  .dyn-gmenu-btn { display: none; position: fixed; top: 22px; right: 20px; z-index: 70; appearance: none;
    width: 58px; height: 52px; padding: 0 4px 6px 0; border: none; border-radius: 0;
    background: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2092%2066'%20preserveAspectRatio='none'%3E%3Cdefs%3E%3Cpattern%20id='d'%20width='7'%20height='7'%20patternUnits='userSpaceOnUse'%3E%3Ccircle%20cx='3'%20cy='3'%20r='1.6'%20fill='%23141110'/%3E%3C/pattern%3E%3C/defs%3E%3Crect%20x='14'%20y='56'%20width='72'%20height='10'%20fill='url(%23d)'/%3E%3Crect%20x='82'%20y='14'%20width='10'%20height='46'%20fill='url(%23d)'/%3E%3Cpath%20d='M6%205%20L18%203.4%20L31%203.8%20L44%202.9%20L57%203.6%20L69%202.8%20L78%203.4%20L78.6%2013%20L79.4%2023%20L78.8%2033%20L79.6%2043%20L80%2052.6%20L68%2052.2%20L56%2053.4%20L43%2052.8%20L30%2053.8%20L18%2053.2%20L8%2054.4%20L8.4%2044%20L7.6%2034%20L7%2024%20L7.4%2014%20Z'%20fill='%23efe9da'%20stroke='%23141110'%20stroke-width='2'/%3E%3C/svg%3E") center / 100% 100% no-repeat;
    color: #141110; cursor: pointer; align-items: center; justify-content: center;
    box-shadow: none; transform: rotate(1.6deg); transition: transform 0.12s; }
  .dyn-gmenu-btn:hover { transform: rotate(1.6deg) scale(1.05); }
  .dyn-gmenu-btn:active { transform: rotate(1.6deg) scale(0.95); }
  .dyn-gmenu-btn svg { width: 22px; height: 22px; display: block; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; }
  @media (max-width: 700px) { .dyn-gmenu-btn { display: flex; } }
  /* the landing hero brings its own identical tab */
  body:has(.dyn-hero.dh-landing) .dyn-gmenu-btn { display: none; }

  /* menu: full-page crumpled paper, springs down from the top (same as the hero's) */
  .dyn-gmenu { position: fixed; inset: 0; z-index: 140; color: #141110;
    background: none; display: flex; align-items: stretch; justify-content: stretch;
    padding: 0; box-sizing: border-box; opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease;
    font-family: "Archivo", "Inter", "Helvetica Neue", Arial, sans-serif; }
  .dyn-gmenu.is-open { opacity: 1; pointer-events: auto; }
