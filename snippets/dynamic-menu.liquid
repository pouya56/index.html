{%- comment -%}
  Site-wide phone hamburger menu (Bécane-style). Shows a fixed white chip
  top-RIGHT on phones on every page; tapping it drops a full-screen menu
  listing the links of a navigation menu. On the landing-hero page the
  hero's own top-LEFT hamburger takes over, and this one hides itself.

  Links come from Online Store → Navigation. Default menu: "main-menu".

  Install: render this once in layout/theme.liquid, right AFTER the
  opening <body ...> tag:
    {% render 'dynamic-menu' %}
  To use a different navigation menu:
    {% render 'dynamic-menu', menu: 'footer' %}
{%- endcomment -%}
{%- assign gm_handle = menu | default: 'main-menu' -%}
{%- assign gm_nav = linklists[gm_handle] -%}
{%- if gm_nav != blank and gm_nav.links.size > 0 -%}
<style>
  /* Liquid glass, matching the account bar's back button: frosted fill,
     etched ring and a soft under-shadow, so it sits over any page content
     without blocking the view. */
  .dyn-gmenu-btn { display: none; position: fixed; top: 16px; right: 16px; z-index: 70; appearance: none;
    width: 46px; height: 46px; border-radius: 50%; padding: 0; align-items: center; justify-content: center;
    background: rgba(255, 255, 255, 0.32);
    -webkit-backdrop-filter: blur(16px) saturate(1.5); backdrop-filter: blur(16px) saturate(1.5);
    border: 1px solid rgba(255, 255, 255, 0.65); color: #1d1d1f; cursor: pointer;
    box-shadow: 0 12px 26px -8px rgba(29, 29, 31, 0.28);
    transition: box-shadow 0.15s, background 0.15s, transform 0.08s; }
  .dyn-gmenu-btn:hover { background: rgba(255, 255, 255, 0.5); box-shadow: 0 18px 34px -10px rgba(29, 29, 31, 0.32); }
  .dyn-gmenu-btn:active { transform: scale(0.95); }
  .dyn-gmenu-btn svg { width: 18px; height: 18px; display: block; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  @media (max-width: 700px) { .dyn-gmenu-btn { display: flex; } }
  /* the landing hero brings its own (left-side) hamburger */
  body:has(.dyn-hero.dh-landing) .dyn-gmenu-btn { display: none; }

  /* Open menu is liquid glass: the page shows through, frosted. */
  .dyn-gmenu { position: fixed; inset: 0; z-index: 140; color: #0a0a0a;
    background: rgba(255, 255, 255, 0.35);
    -webkit-backdrop-filter: blur(22px) saturate(1.6) brightness(1.05);
    backdrop-filter: blur(22px) saturate(1.6) brightness(1.05);
    transform: translateY(-102%); transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    padding: 76px 22px 30px; box-sizing: border-box; overflow-y: auto;
    font-family: "Archivo", "Inter", "Helvetica Neue", Arial, sans-serif; }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .dyn-gmenu { background: #f5f5f5; }
  }
  .dyn-gmenu.is-open { transform: translateY(0); }
  .dyn-gmenu-close { position: absolute; top: 16px; right: 16px; appearance: none; border: 0; background: #fff;
    color: #0a0a0a; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    line-height: 1; padding: 9px 11px; cursor: pointer; box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05); }
  .dyn-gmenu-nav { min-height: 100%; display: flex; flex-direction: column; gap: 6px;
    align-items: center; justify-content: center; text-align: center; }
  .dyn-gmenu-link { color: inherit; text-decoration: none; font-size: 27px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.25; }
  @media (prefers-reduced-motion: reduce) { .dyn-gmenu { transition: none; } }
</style>
<button class="dyn-gmenu-btn" type="button" id="dynGmenuBtn" aria-label="Menu" aria-expanded="false">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
</button>
<div class="dyn-gmenu" id="dynGmenu" role="dialog" aria-modal="true" aria-label="Menu">
  <button class="dyn-gmenu-close" type="button" id="dynGmenuClose">Close &times;</button>
  <nav class="dyn-gmenu-nav">
    {%- for link in gm_nav.links -%}
      <a class="dyn-gmenu-link" href="{{ link.url }}">{{ link.title | escape }}</a>
    {%- endfor -%}
  </nav>
</div>
<script>
(function () {
  var btn = document.getElementById("dynGmenuBtn");
  var menu = document.getElementById("dynGmenu");
  var close = document.getElementById("dynGmenuClose");
  if (!btn || !menu || !close) return;
  /* fallback for browsers without :has() — the hero page hides this one */
  var hideForHero = function () {
    if (document.querySelector(".dyn-hero.dh-landing")) btn.style.display = "none";
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", hideForHero);
  else hideForHero();
  function setOpen(v) {
    menu.classList.toggle("is-open", v);
    btn.setAttribute("aria-expanded", v ? "true" : "false");
    document.documentElement.style.overflow = v ? "hidden" : "";
    /* the manifesto ducks out while the glass menu is open */
    document.documentElement.classList.toggle("dyn-menu-open", v);
  }
  btn.addEventListener("click", function () { setOpen(!menu.classList.contains("is-open")); });
  close.addEventListener("click", function () { setOpen(false); });
  menu.addEventListener("click", function (e) {
    if (e.target && e.target.closest && e.target.closest(".dyn-gmenu-link")) setOpen(false);
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && menu.classList.contains("is-open")) setOpen(false);
  });
})();
</script>
{%- endif -%}
