    width: 100%; height: 100%; overflow-y: auto; box-sizing: border-box;
    padding: 76px 26px 44px; display: flex; flex-direction: column; gap: 6px;
    align-items: center; justify-content: center; text-align: center;
    transform: translateY(-60vh); transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1); }
  .dyn-gmenu.is-open .dyn-gmenu-nav { transform: translateY(0); }
  {%- if gm_paper -%}
  .dyn-gmenu-nav { background: url('{{ gm_paper | image_url: width: 1600 }}') center / cover no-repeat; }
  {%- endif -%}
  .dyn-gmenu-close { position: absolute; top: 16px; right: 14px; z-index: 3; width: 56px; height: 56px;
    appearance: none; border: 0; background: transparent var(--gmx) center / contain no-repeat;
    color: transparent; font-size: 0; line-height: 0; padding: 0; cursor: pointer; transform: rotate(-3deg); }
  .dyn-gmenu-link { color: inherit; text-decoration: none; font-size: 27px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.25; }
  @media (prefers-reduced-motion: reduce) { .dyn-gmenu, .dyn-gmenu-nav { transition: none; } }
</style>
<button class="dyn-gmenu-btn" type="button" id="dynGmenuBtn" aria-label="Menu" aria-expanded="false">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
</button>
<div class="dyn-gmenu" id="dynGmenu" role="dialog" aria-modal="true" aria-label="Menu">
  <button class="dyn-gmenu-close" type="button" id="dynGmenuClose" aria-label="Close menu">&times;</button>
  <nav class="dyn-gmenu-nav">
    {%- for link in gm_nav.links -%}
      <a class="dyn-gmenu-link" href="{{ link.url }}">{{ link.title | escape }}</a>
    {%- endfor -%}
  </nav>
</div>
<script>
(function () {
  var btn = document.getElementById("dynGmenuBtn");
  var menu = document.getElementById("dynGmenu");
  var close = document.getElementById("dynGmenuClose");
  if (!btn || !menu || !close) return;
  /* fallback for browsers without :has() — the hero page hides this one */
  var hideForHero = function () {
    if (document.querySelector(".dyn-hero.dh-landing")) btn.style.display = "none";
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", hideForHero);
  else hideForHero();
  function setOpen(v) {
    menu.classList.toggle("is-open", v);
    btn.setAttribute("aria-expanded", v ? "true" : "false");
    document.documentElement.style.overflow = v ? "hidden" : "";
    /* the manifesto ducks out while the menu is open */
    document.documentElement.classList.toggle("dyn-menu-open", v);
  }
  btn.addEventListener("click", function () { setOpen(!menu.classList.contains("is-open")); });
  close.addEventListener("click", function () { setOpen(false); });
  menu.addEventListener("click", function (e) {
    if (e.target && e.target.closest && e.target.closest(".dyn-gmenu-link")) setOpen(false);
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && menu.classList.contains("is-open")) setOpen(false);
  });
})();
</script>
{%- endif -%}
