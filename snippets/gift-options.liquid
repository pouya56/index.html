{% # theme-check-disable UnusedAssign %}
{%- comment -%}
  theme-check note: the two config assigns below ARE used lower in the file; they
  only look unused while the default wrap id is empty, so we silence UnusedAssign.
  The "OrphanedSnippet" warning (this snippet is added via a runtime Custom Liquid
  block, invisible to static analysis) can't be silenced inline — it's handled in
  the theme's .theme-check.yml instead.
{%- endcomment -%}
{% comment %}
  ============================================================================
  Gift options — "This is a gift" toggle that reveals paid gift wrapping
  (a separate line item) + a free 250-char gift note (a line item property).
  ----------------------------------------------------------------------------
  SETUP (once):
  1. Products > Add product. Name it "Gift Wrapping", set its price to 8.00,
     set it to "Don't track quantity", and (optional) hide it from all sales
     channels EXCEPT the online store so nobody browses to it directly. Save.
  2. On that product, open the variant (or the "Edit" under the price) and copy
     the numeric VARIANT ID from the URL. It looks like:
       .../products/12345?variant=98765432101   <- the 98765432101 part
  3. Paste that number into `gift_wrap_variant_id` below. Set `gift_wrap_price`
     (in cents) to match, e.g. 800 for $8.00.
  4. Add this snippet to the product page (see the chat steps).
  Leave gift_wrap_variant_id empty to show ONLY the note (no wrapping option).
  ============================================================================
{% endcomment %}

{%- assign gift_wrap_variant_id = '' -%}
{%- assign gift_wrap_price = 800 -%}

<div class="gift-options" data-gift-options data-wrap-id="{{ gift_wrap_variant_id }}">
  <label class="gift-toggle">
    <input type="checkbox" class="gift-toggle-input" data-gift-is-gift>
    <span class="gift-toggle-track"><span class="gift-toggle-knob"></span></span>
    <span class="gift-toggle-label">{% if gift_wrap_variant_id != blank %}Add gift wrapping — <strong>{{ gift_wrap_price | money }}</strong>{% else %}This is a gift{% endif %}</span>
  </label>

  <div class="gift-panel" data-gift-panel hidden>
    <div class="gift-note-field">
      <label class="gift-note-heading" for="giftNoteInput">Add a gift note (optional)</label>
      <textarea id="giftNoteInput" class="gift-note-input" name="properties[Gift note]"
        maxlength="250" rows="3" placeholder="Write your message…" data-gift-note disabled></textarea>
      <div class="gift-note-count"><span data-gift-count>0</span>/250</div>
    </div>
  </div>
</div>

<style>
  /* Matches the Dynamic design system (SF Pro, ink/line/accent tokens, rounded panels). */
  .gift-options {
    --ink: #1d1d1f; --ink-soft: #6e6e73; --ink-faint: #86868b;
    --line: #d2d2d7; --panel: #f5f5f7; --accent: #0071e3;
    --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    margin: 24px 0; font-family: var(--font); color: var(--ink); -webkit-font-smoothing: antialiased;
  }
  .gift-options *, .gift-options *::before, .gift-options *::after { box-sizing: border-box; }

  /* iOS "liquid glass" green toggle for "This is a gift" */
  .gift-options .gift-toggle { display: inline-flex; align-items: center; gap: 12px; cursor: pointer; user-select: none; }
  .gift-options .gift-toggle-input { position: absolute; opacity: 0; width: 0; height: 0; }
  .gift-options .gift-toggle-track { position: relative; width: 50px; height: 30px; border-radius: 999px; flex: none;
    background: rgba(120,120,128,0.22); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.18), inset 0 0 0 1px rgba(255,255,255,0.22);
    transition: background .28s ease, box-shadow .28s ease; }
  /* glass sheen across the top half */
  .gift-options .gift-toggle-track::before { content: ""; position: absolute; left: 2px; right: 2px; top: 1px; height: 45%;
    border-radius: 999px; background: linear-gradient(180deg, rgba(255,255,255,0.5), rgba(255,255,255,0)); pointer-events: none; }
  .gift-options .gift-toggle-knob { position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%;
    background: linear-gradient(180deg, #ffffff, #eef0f2); box-shadow: 0 2px 5px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.9);
    transition: transform .28s cubic-bezier(.4,1.25,.5,1); }
  .gift-options .gift-toggle-input:checked + .gift-toggle-track {
    background: linear-gradient(180deg, rgba(76,222,128,0.92), rgba(40,199,84,0.92));
    -webkit-backdrop-filter: blur(8px) saturate(1.5); backdrop-filter: blur(8px) saturate(1.5);
    box-shadow: inset 0 1px 1px rgba(255,255,255,0.6), inset 0 -2px 4px rgba(0,90,35,0.28),
      0 2px 9px rgba(52,199,89,0.5), inset 0 0 0 1px rgba(255,255,255,0.28); }
  .gift-options .gift-toggle-input:checked + .gift-toggle-track .gift-toggle-knob { transform: translateX(20px); }
  .gift-options .gift-toggle-input:focus-visible + .gift-toggle-track { outline: 2px solid #30c754; outline-offset: 2px; }
  .gift-options .gift-toggle-label { font-size: 15px; font-weight: 500; letter-spacing: 0.01em; }

  .gift-options .gift-panel { margin-top: 14px; padding: 18px 20px; background: var(--panel);
    border: 1px solid var(--line); border-radius: 16px; display: grid; gap: 16px; }
  .gift-options .gift-panel[hidden] { display: none; }

  .gift-options .gift-row { display: flex; align-items: center; gap: 11px; cursor: pointer; font-size: 15px; }
  .gift-options .gift-check { width: 19px; height: 19px; accent-color: var(--ink); flex: none; cursor: pointer; margin: 0; }
  .gift-options .gift-row-text strong { font-weight: 600; }

  .gift-options .gift-note-heading { display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; }
  .gift-options .gift-note-input { width: 100%; resize: vertical; min-height: 76px; padding: 12px 14px;
    font-family: var(--font); font-size: 15px; line-height: 1.45; color: var(--ink); background: #fff;
    border: 1px solid var(--line); border-radius: 12px; transition: border-color .16s ease, box-shadow .16s ease; }
  .gift-options .gift-note-input::placeholder { color: var(--ink-faint); }
  .gift-options .gift-note-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(0,113,227,0.15); }
  .gift-options .gift-note-input:disabled { opacity: 0.55; }
  .gift-options .gift-note-count { margin-top: 8px; text-align: right; font-size: 12px; color: var(--ink-faint);
    font-variant-numeric: tabular-nums; }
</style>

<script>
(function () {
  var box = document.querySelector("[data-gift-options]");
  if (!box || box.dataset.giftBound) return;
  box.dataset.giftBound = "1";

  var wrapId = (box.getAttribute("data-wrap-id") || "").trim();
  var isGift = box.querySelector("[data-gift-is-gift]");   // the toggle = "Add gift wrapping"
  var panel  = box.querySelector("[data-gift-panel]");
  var note   = box.querySelector("[data-gift-note]");
  var count  = box.querySelector("[data-gift-count]");

  // The product's add-to-cart form (works whether this snippet sits inside or
  // outside the form — we look it up rather than relying on placement).
  var form = box.closest('form[action*="/cart/add"]') ||
             document.querySelector('product-form form[action*="/cart/add"], form[action*="/cart/add"]');

  function syncCount() { if (count) count.textContent = String(note.value.length); }
  note.addEventListener("input", syncCount); syncCount();

  function togglePanel() {
    var on = isGift.checked;
    panel.hidden = !on;
    note.disabled = !on;                 // disabled fields never submit (no stale note)
  }
  isGift.addEventListener("change", togglePanel); togglePanel();

  if (!form) return; // no product form found — the note still works if placed inside a form

  // When it's a gift we take over the add so we can attach the note AND add the
  // wrapping as its own line item in a single, reliable /cart/add.js call.
  // Listen on `document` in the CAPTURE phase: an ancestor's capture handler
  // always runs before the form's own submit handler, so stopImmediatePropagation
  // here reliably preempts the theme (no double-add).
  document.addEventListener("submit", function (e) {
    if (e.target !== form) return;       // only our product form
    if (!isGift.checked) return;         // not a gift → let the theme add normally
    var idEl = form.querySelector('[name="id"]');
    if (!idEl || !idEl.value) return;    // no variant selected → let the theme handle/validate
    e.preventDefault(); e.stopImmediatePropagation();

    var qtyEl = form.querySelector('[name="quantity"]');
    var qty = Math.max(1, parseInt(qtyEl && qtyEl.value, 10) || 1);

    // Preserve any other line item properties already on the form (other apps).
    var props = {};
    form.querySelectorAll('[name^="properties["]').forEach(function (inp) {
      if (inp.disabled) return;
      if ((inp.type === "checkbox" || inp.type === "radio") && !inp.checked) return;
      var m = inp.name.match(/^properties\[(.+)\]$/);
      if (m && String(inp.value).trim() !== "") props[m[1]] = inp.value;
    });
    if (note.value.trim()) props["Gift note"] = note.value.trim();
    props["Gift"] = "Yes";               // flags the item as a gift on the order/packing slip

    var items = [{ id: idEl.value, quantity: qty, properties: props }];
    // Toggle on IS the wrapping choice — add the wrapping line item when configured.
    if (wrapId) {
      var title = (window.DYN_SHOPIFY && window.DYN_SHOPIFY.productTitle) || document.title || "item";
      items.push({ id: parseInt(wrapId, 10), quantity: 1, properties: { "_For": title, "Gift wrapping": "Yes" } });
    }

    var btn = form.querySelector('[type="submit"]');
    if (btn) { btn.setAttribute("aria-busy", "true"); btn.classList.add("loading"); }

    fetch("/cart/add.js", {
      method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({ items: items })
    })
      .then(function (r) { if (!r.ok) return r.json().then(function (x) { throw x; }); return r.json(); })
      .then(function () {
        if (window.DynamicHeader && window.DynamicHeader.openCart) window.DynamicHeader.openCart();
        else window.location.href = "/cart";
      })
      .catch(function (err) {
        console.warn("[gift-options] add failed", err);
        alert((err && err.description) || "Sorry — couldn't add this to your cart.");
      })
      .then(function () { if (btn) { btn.removeAttribute("aria-busy"); btn.classList.remove("loading"); } });
  }, true); // capture phase so we run before the theme's own submit handler
})();
</script>
