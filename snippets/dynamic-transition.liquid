{%- comment -%}
  Bécane-style page transitions: on every same-site navigation the NEW page
  slides up smoothly from the bottom while the old one holds still beneath it.
  Uses the browser's native cross-document View Transitions (Chrome, Edge,
  Safari); other browsers simply navigate normally.

  Install: render this once in the <head> of layout/theme.liquid:
    {% render 'dynamic-transition' %}
{%- endcomment -%}
<style>
  @view-transition { navigation: auto; }

  @keyframes dynVtUp {
    from { transform: translateY(100vh); }
    to { transform: translateY(0); }
  }

  /* the old page holds still underneath… */
  ::view-transition-old(root) {
    animation: none;
    z-index: 1;
  }
  /* …while the new one glides up over it */
  ::view-transition-new(root) {
    animation: dynVtUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    z-index: 2;
    box-shadow: 0 -18px 60px rgba(0, 0, 0, 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
  }
</style>
