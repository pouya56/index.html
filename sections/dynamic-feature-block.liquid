{%- comment -%}
  Apple Feature Block — Skiper76-style liquid-glass showcase.
  Full-bleed background media (image OR video) behind translucent iOS-glass
  "tab" pills on the left. By default NO tab is open. Click a pill to open it
  like a page: it expands into a glass card (title + detail, or the colour
  swatches) AND swaps the background media to that tab's media. Close with the
  × (top-right); step through tabs with the ↑ / ↓ arrows.
  Blocks: "Color" (swatch + media) and "Feature" (title + detail + media).
{%- endcomment -%}

{%- assign colors = section.blocks | where: 'type', 'color' -%}
{%- assign feats  = section.blocks | where: 'type', 'feature' -%}
{%- assign canv   = section.blocks | where: 'type', 'canvas' -%}
{%- assign stak   = section.blocks | where: 'type', 'stack' -%}
{%- assign scrl   = section.blocks | where: 'type', 'scroll' -%}
{%- assign fb_justify = 'center' -%}
{%- if section.settings.align == 'left' -%}{%- assign fb_justify = 'flex-start' -%}{%- elsif section.settings.align == 'right' -%}{%- assign fb_justify = 'flex-end' -%}{%- endif -%}
{%- assign has_default = false -%}
{%- if section.settings.default_image != blank or section.settings.default_video != blank -%}{%- assign has_default = true -%}{%- endif -%}

<section class="dyn-fb" id="dynFb-{{ section.id }}">
  <style>
    #shopify-section-{{ section.id }} { background: {{ section.settings.page_bg | default: '#141414' }}; }
    #dynFb-{{ section.id }} {
      --card: {{ section.settings.card_bg | default: '#050505' }};
      --glass: rgba(58,58,60,0.42); --glass-hover: rgba(78,78,80,0.5); --glass-brd: rgba(255,255,255,0.14);
      --ink: #f5f5f7; --soft: #c4c4c8; --accent: {{ section.settings.accent | default: '#0071e3' }};
      --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: var(--ink); font-family: var(--font); -webkit-font-smoothing: antialiased;
      --fb-cardh: {{ section.settings.card_height | default: 640 }}px;
      display: flex; justify-content: {{ fb_justify }}; box-sizing: border-box;
      {% if section.settings.full_height %}min-height: 100vh; align-items: center; padding: 40px 0;{% else %}align-items: flex-start; padding: {{ section.settings.pad_top | default: 40 }}px 0 {{ section.settings.pad_bottom | default: 40 }}px;{% endif %}
    }
    .dyn-fb .fb-wrap { width: {{ section.settings.content_width | default: 85 }}%; max-width: 1600px; }
    .dyn-fb .fb-head { max-width: 640px; margin: 0 auto 26px; text-align: center; }
    .dyn-fb .fb-eyebrow { font-size: 14px; font-weight: 600; color: var(--accent); margin: 0 0 10px; }
    .dyn-fb .fb-title { font-size: clamp(26px, 4vw, 44px); line-height: 1.06; font-weight: 700; letter-spacing: -0.03em; margin: 0; }
    .dyn-fb .fb-desc { font-size: clamp(15px, 2vw, 19px); line-height: 1.5; color: var(--soft); margin: 14px 0 0; }

    .dyn-fb .fb-card { position: relative; overflow: hidden; border-radius: 30px; background: var(--card); height: var(--fb-cardh); }

    /* Background media layers (crossfade) */
    .dyn-fb .fb-bg { position: absolute; inset: 0; z-index: 0; }
    .dyn-fb .fb-bg-layer { position: absolute; inset: 0; opacity: 0; transition: opacity .6s ease; pointer-events: none; }
    .dyn-fb .fb-bg-layer.is-active { opacity: 1; pointer-events: auto; }
    .dyn-fb .fb-media { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }

    /* Close button (top-right) — appears when a tab is open */
    .dyn-fb .fb-close { position: absolute; top: 22px; right: 22px; z-index: 6; width: 46px; height: 46px; border-radius: 50%;
      background: var(--glass); -webkit-backdrop-filter: blur(20px) saturate(160%); backdrop-filter: blur(20px) saturate(160%);
      border: 1px solid var(--glass-brd); color: var(--ink); cursor: pointer; display: grid; place-items: center;
      opacity: 0; pointer-events: none; transform: scale(.9); transition: opacity .25s, transform .25s; box-shadow: inset 0 1px 0 rgba(255,255,255,.14), 0 8px 24px rgba(0,0,0,.3); }
    .dyn-fb .fb-close svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
    .dyn-fb.is-open .fb-close { opacity: 1; pointer-events: auto; transform: scale(1); }

    /* Left column: nav arrows + pills */
    .dyn-fb .fb-left { position: relative; z-index: 3; display: flex; align-items: center; gap: 16px; height: var(--fb-cardh); padding: 24px clamp(20px,4vw,52px); box-sizing: border-box; pointer-events: none; }
    .dyn-fb .fb-nav, .dyn-fb .fb-navbtn, .dyn-fb .fb-pill, .dyn-fb .fb-panel, .dyn-fb .fb-close, .dyn-fb .fb-list { pointer-events: auto; }
    .dyn-fb .fb-nav { display: flex; flex-direction: column; gap: 10px; opacity: 0; pointer-events: none; transition: opacity .25s; }
    .dyn-fb.is-open .fb-nav { opacity: 1; pointer-events: auto; }
    .dyn-fb .fb-navbtn { width: 44px; height: 44px; border-radius: 50%; background: var(--glass); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
      border: 1px solid var(--glass-brd); color: var(--ink); cursor: pointer; display: grid; place-items: center; transition: background .15s, transform .12s; box-shadow: inset 0 1px 0 rgba(255,255,255,.12); }
    .dyn-fb .fb-navbtn:hover { background: var(--glass-hover); }
    .dyn-fb .fb-navbtn:active { transform: scale(.92); }
    .dyn-fb .fb-navbtn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    .dyn-fb .fb-list { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; width: 100%; max-width: 424px; max-height: 100%; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; padding: 8px 24px 18px; margin-left: -22px; scroll-behavior: smooth; }
    .dyn-fb .fb-list::-webkit-scrollbar { width: 0; height: 0; }
    .dyn-fb .fb-item { max-width: 100%; }

    /* Glass pill (collapsed) */
    .dyn-fb .fb-pill { display: inline-flex; align-items: center; gap: 12px; padding: 10px 22px 10px 10px; border: 1px solid var(--glass-brd); border-radius: 999px;
      background: var(--glass); -webkit-backdrop-filter: blur(20px) saturate(160%); backdrop-filter: blur(20px) saturate(160%);
      color: var(--ink); cursor: pointer; font: inherit; text-align: left; box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 6px 20px rgba(0,0,0,.22); transition: background .18s, transform .12s; }
    .dyn-fb .fb-pill:hover { background: var(--glass-hover); }
    .dyn-fb .fb-pill:active { transform: scale(.98); }
    .dyn-fb .fb-pill-title { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
    .dyn-fb .fb-ic { flex: none; width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.4); background: transparent; position: relative; }
    .dyn-fb .fb-ic::before, .dyn-fb .fb-ic::after { content: ""; position: absolute; top: 50%; left: 50%; width: 11px; height: 1.7px; background: #fff; border-radius: 2px; transform: translate(-50%,-50%); }
    .dyn-fb .fb-ic::after { transform: translate(-50%,-50%) rotate(90deg); }
    .dyn-fb .fb-item[data-colors] .fb-ic { background: #fff; border-color: #fff; }
    .dyn-fb .fb-item[data-colors] .fb-ic::before, .dyn-fb .fb-item[data-colors] .fb-ic::after { opacity: 0; }

    /* Glass panel (expanded "page") */
    .dyn-fb .fb-panel { display: none; border: 1px solid var(--glass-brd); border-radius: 22px; background: var(--glass);
      -webkit-backdrop-filter: blur(24px) saturate(160%); backdrop-filter: blur(24px) saturate(160%); padding: 20px 24px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.14), 0 10px 34px rgba(0,0,0,.34); max-width: 380px; animation: fbIn .32s cubic-bezier(.22,1,.36,1); }
    .dyn-fb .fb-item.is-open .fb-pill { display: none; }
    .dyn-fb .fb-item.is-open .fb-panel { display: block; }
    @keyframes fbIn { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }
    .dyn-fb .fb-panel-text { font-size: 15px; line-height: 1.55; color: var(--soft); }
    .dyn-fb .fb-panel-text strong { color: var(--ink); font-weight: 600; }
    .dyn-fb .fb-colorname { color: var(--ink); font-weight: 600; }
    .dyn-fb .fb-swatches { display: flex; flex-wrap: wrap; gap: 13px; margin-top: 16px; }
    .dyn-fb .fb-swatch { width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(255,255,255,.22); background: var(--sw, #888); cursor: pointer; padding: 0; transition: transform .14s; }
    .dyn-fb .fb-swatch:hover { transform: scale(1.14); }
    .dyn-fb .fb-swatch.is-active { box-shadow: 0 0 0 2px rgba(0,0,0,.35), 0 0 0 4px #fff; }

    /* Before / After comparison (usable as any tab's media) — a sizable, positionable box */
    .dyn-fb .fb-ba { position: absolute; top: 50%; transform: translateY(-50%); width: var(--ba-w, 55%); aspect-ratio: var(--ba-ratio, 4 / 3);
      border-radius: 20px; overflow: hidden; user-select: none; touch-action: none; box-shadow: 0 30px 80px rgba(0,0,0,.42); pointer-events: auto; }
    .dyn-fb .fb-ba[data-pos="right"] { right: var(--ba-inset, 5%); }
    .dyn-fb .fb-ba[data-pos="left"] { left: var(--ba-inset, 5%); }
    .dyn-fb .fb-ba[data-pos="center"] { left: 50%; transform: translate(-50%, -50%); }
    .dyn-fb .fb-ba-before, .dyn-fb .fb-ba-after { position: absolute; inset: 0; }
    .dyn-fb .fb-ba-after { clip-path: inset(0 0 0 50%); -webkit-clip-path: inset(0 0 0 50%); }
    .dyn-fb .fb-ba-before img, .dyn-fb .fb-ba-after img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .dyn-fb .fb-ba-badge { position: absolute; top: 18px; font: 600 11px/1 var(--font); letter-spacing: .12em; text-transform: uppercase; padding: 7px 12px; border-radius: 50px; z-index: 3; color: #fff; background: rgba(255,255,255,.14); -webkit-backdrop-filter: blur(10px) saturate(150%); backdrop-filter: blur(10px) saturate(150%); border: 1px solid rgba(255,255,255,.35); }
    .dyn-fb .fb-ba-l { left: 18px; } .dyn-fb .fb-ba-r { right: 18px; }
    .dyn-fb .fb-ba-handle { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; background: rgba(255,255,255,.65); transform: translateX(-1px); z-index: 4; box-shadow: 0 0 18px rgba(0,0,0,.45); }
    .dyn-fb .fb-ba-grip { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 46px; height: 46px; border-radius: 50%; background: rgba(255,255,255,.2); -webkit-backdrop-filter: blur(10px) saturate(140%); backdrop-filter: blur(10px) saturate(140%); border: 1px solid rgba(255,255,255,.5); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 16px; box-shadow: 0 6px 22px rgba(0,0,0,.35); }

    /* Infinite canvas (draggable, wrapping grid of images) */
    .dyn-fb .fb-canvas { position: absolute; inset: 0; overflow: hidden; cursor: grab; touch-action: none; }
    .dyn-fb .fb-canvas.is-grab { cursor: grabbing; }
    .dyn-fb .fb-canvas-plane { position: absolute; top: 0; left: 0; will-change: transform; }
    .dyn-fb .fb-tile { position: absolute; top: 0; left: 0; border-radius: 14px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,.28); }
    .dyn-fb .fb-canvas-empty { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); max-width: 70%; text-align: center; color: var(--soft); font-size: 14px; line-height: 1.5; padding: 16px 20px; border: 1px dashed rgba(255,255,255,.25); border-radius: 14px; }
    .dyn-fb .fb-tile img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; -webkit-user-drag: none; }

    /* Image stack (hover-expand accordion) as a tab's media */
    .dyn-fb .fb-stack { position: absolute; inset: 0; }
    .dyn-fb .fb-stk { position: absolute; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 4px; width: var(--stk-w, 340px); max-width: 88%; }
    .dyn-fb .fb-stk[data-pos="right"] { right: var(--stk-inset, 5%); }
    .dyn-fb .fb-stk[data-pos="left"] { left: var(--stk-inset, 5%); }
    .dyn-fb .fb-stk[data-pos="center"] { left: 50%; transform: translate(-50%, -50%); }
    .dyn-fb .fb-stk-card { flex: 0 0 var(--scol, 40px); overflow: hidden; border-radius: 22px; position: relative; cursor: pointer; transition: flex-grow .55s cubic-bezier(.22,1,.36,1); box-shadow: 0 12px 34px rgba(0,0,0,.34); }
    .dyn-fb .fb-stk-card.is-open { flex-grow: 1; }
    .dyn-fb .fb-stk-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .dyn-fb .fb-stk-grad { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.5), transparent 55%); opacity: 0; transition: opacity .3s; pointer-events: none; }
    .dyn-fb .fb-stk-card.is-open .fb-stk-grad { opacity: 1; }

    /* Progressive-blur scroll (fades at top & bottom) as a tab's media */
    .dyn-fb .fb-scroll { position: absolute; top: 6%; bottom: 6%; width: var(--scr-w, 42%); overflow: hidden; }
    .dyn-fb .fb-scroll[data-pos="right"] { right: var(--scr-inset, 5%); }
    .dyn-fb .fb-scroll[data-pos="left"] { left: var(--scr-inset, 5%); }
    .dyn-fb .fb-scroll[data-pos="center"] { left: 50%; transform: translateX(-50%); }
    .dyn-fb .fb-scroll-inner { position: absolute; inset: 0; overflow-y: auto; padding: 90px 24px; color: #e6e6ea; font-size: 15px; line-height: 1.75; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .dyn-fb .fb-scroll-inner::-webkit-scrollbar { width: 0; height: 0; }
    .dyn-fb .fb-scroll-inner > * { margin: 0 0 1.2em; }
    .dyn-fb .fb-scroll-blur { position: absolute; left: 0; width: 100%; height: 130px; pointer-events: none; z-index: 2; }
    .dyn-fb .fb-scroll-blur.is-top { top: 0; background: linear-gradient(to top, transparent, var(--card)); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent); mask-image: linear-gradient(to bottom, #000 45%, transparent); }
    .dyn-fb .fb-scroll-blur.is-bot { bottom: 0; background: linear-gradient(to bottom, transparent, var(--card)); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); -webkit-mask-image: linear-gradient(to top, #000 45%, transparent); mask-image: linear-gradient(to top, #000 45%, transparent); }

    .dyn-fb .fb-empty { color: var(--soft); font-size: 15px; padding: 30px; }

    @media (max-width: 860px) {
      .dyn-fb .fb-card { height: auto; min-height: 0; }
      .dyn-fb .fb-bg { position: relative; height: 300px; }
      .dyn-fb .fb-left { position: relative; height: auto; min-height: 0; margin-top: -70px; padding: 20px; align-items: flex-start; }
      .dyn-fb .fb-list { max-height: none; overflow: visible; padding: 4px 6px 12px; margin-left: 0; }
      .dyn-fb .fb-pill-title { white-space: normal; }
      .dyn-fb .fb-close { top: 14px; right: 14px; }
      .dyn-fb .fb-ba, .dyn-fb .fb-ba[data-pos="right"], .dyn-fb .fb-ba[data-pos="left"], .dyn-fb .fb-ba[data-pos="center"] {
        inset: 0; width: auto; height: auto; top: 0; left: 0; right: 0; transform: none; aspect-ratio: auto; border-radius: 0; }
      .dyn-fb .fb-stk, .dyn-fb .fb-stk[data-pos="right"], .dyn-fb .fb-stk[data-pos="left"], .dyn-fb .fb-stk[data-pos="center"] {
        left: 50%; right: auto; transform: translate(-50%, -50%); width: 88%; }
      .dyn-fb .fb-scroll, .dyn-fb .fb-scroll[data-pos="right"], .dyn-fb .fb-scroll[data-pos="left"], .dyn-fb .fb-scroll[data-pos="center"] {
        left: 0; right: 0; top: 0; bottom: 0; width: auto; transform: none; }
    }
  </style>

  <div class="fb-wrap">
    {%- if section.settings.title != blank or section.settings.eyebrow != blank or section.settings.description != blank -%}
      <div class="fb-head">
        {%- if section.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="fb-title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.description != blank -%}<p class="fb-desc">{{ section.settings.description }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="fb-card">
      <div class="fb-bg">
        {%- if has_default -%}
          <div class="fb-bg-layer is-active" data-key="default">
            {%- if section.settings.default_video != blank -%}
              <video class="fb-media" autoplay muted loop playsinline{% if section.settings.default_image != blank %} poster="{{ section.settings.default_image | image_url: width: 40 }}"{% endif %}>
                {%- for s in section.settings.default_video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
              </video>
            {%- elsif section.settings.default_image != blank -%}
              <img class="fb-media" src="{{ section.settings.default_image | image_url: width: 1800 }}" width="{{ section.settings.default_image.width }}" height="{{ section.settings.default_image.height }}" alt="" loading="lazy">
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- for block in colors -%}
          <div class="fb-bg-layer{% if has_default == false and forloop.first %} is-active{% endif %}" data-key="c{{ forloop.index0 }}">
            {%- if block.settings.ba_before != blank and block.settings.ba_after != blank -%}
              <div class="fb-ba" data-fb-ba data-pos="{{ block.settings.ba_pos | default: 'right' }}" style="--ba-w:{{ block.settings.ba_width | default: 55 }}%;--ba-ratio:{{ block.settings.ba_ratio | default: '4 / 3' }};--ba-inset:{{ block.settings.ba_inset | default: 5 }}%">
                <div class="fb-ba-before"><img class="fb-media" src="{{ block.settings.ba_before | image_url: width: 1800 }}" width="1600" height="1000" alt="Before" loading="lazy"></div>
                <div class="fb-ba-after" data-fb-ba-after><img class="fb-media" src="{{ block.settings.ba_after | image_url: width: 1800 }}" width="1600" height="1000" alt="After" loading="lazy"></div>
                <div class="fb-ba-badge fb-ba-l">{{ block.settings.ba_before_label | default: 'Before' }}</div>
                <div class="fb-ba-badge fb-ba-r">{{ block.settings.ba_after_label | default: 'After' }}</div>
                <div class="fb-ba-handle" data-fb-ba-handle><div class="fb-ba-grip">⇄</div></div>
              </div>
            {%- elsif block.settings.video != blank -%}
              <video class="fb-media" autoplay muted loop playsinline{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 40 }}"{% endif %}>
                {%- for s in block.settings.video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
              </video>
            {%- elsif block.settings.image != blank -%}
              <img class="fb-media" src="{{ block.settings.image | image_url: width: 1800 }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" alt="{{ block.settings.label | escape }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endfor -%}
        {%- for block in feats -%}
          <div class="fb-bg-layer{% if has_default == false and colors.size == 0 and forloop.first %} is-active{% endif %}" data-key="f{{ forloop.index0 }}">
            {%- if block.settings.ba_before != blank and block.settings.ba_after != blank -%}
              <div class="fb-ba" data-fb-ba data-pos="{{ block.settings.ba_pos | default: 'right' }}" style="--ba-w:{{ block.settings.ba_width | default: 55 }}%;--ba-ratio:{{ block.settings.ba_ratio | default: '4 / 3' }};--ba-inset:{{ block.settings.ba_inset | default: 5 }}%">
                <div class="fb-ba-before"><img class="fb-media" src="{{ block.settings.ba_before | image_url: width: 1800 }}" width="1600" height="1000" alt="Before" loading="lazy"></div>
                <div class="fb-ba-after" data-fb-ba-after><img class="fb-media" src="{{ block.settings.ba_after | image_url: width: 1800 }}" width="1600" height="1000" alt="After" loading="lazy"></div>
                <div class="fb-ba-badge fb-ba-l">{{ block.settings.ba_before_label | default: 'Before' }}</div>
                <div class="fb-ba-badge fb-ba-r">{{ block.settings.ba_after_label | default: 'After' }}</div>
                <div class="fb-ba-handle" data-fb-ba-handle><div class="fb-ba-grip">⇄</div></div>
              </div>
            {%- elsif block.settings.video != blank -%}
              <video class="fb-media" autoplay muted loop playsinline{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 40 }}"{% endif %}>
                {%- for s in block.settings.video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
              </video>
            {%- elsif block.settings.image != blank -%}
              <img class="fb-media" src="{{ block.settings.image | image_url: width: 1800 }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endfor -%}
        {%- for block in canv -%}
          <div class="fb-bg-layer{% if has_default == false and colors.size == 0 and feats.size == 0 and forloop.first %} is-active{% endif %}" data-key="k{{ forloop.index0 }}">
            {%- assign ccount = 0 -%}{%- for n in (1..10) -%}{%- assign ck2 = 'img' | append: n -%}{%- if block.settings[ck2] != blank -%}{%- assign ccount = ccount | plus: 1 -%}{%- endif -%}{%- endfor -%}
            <div class="fb-canvas" data-fb-canvas data-tile="{{ block.settings.tile_size | default: 220 }}" data-gap="{{ block.settings.gap | default: 16 }}">
              <div class="fb-canvas-plane" data-fb-canvas-plane></div>
              <script type="application/json" data-fb-canvas-imgs>[{%- assign cfirst = true -%}{%- for n in (1..10) -%}{%- assign ck = 'img' | append: n -%}{%- assign cimg = block.settings[ck] -%}{%- if cimg != blank -%}{%- unless cfirst %},{% endunless %}{%- assign cfirst = false -%}{{ cimg | image_url: width: 600 | json }}{%- endif -%}{%- endfor -%}]</script>
              {%- if ccount == 0 and request.design_mode -%}<div class="fb-canvas-empty">Add images (Image 1–10) to this canvas block so there’s something to drag.</div>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
        {%- for block in stak -%}
          <div class="fb-bg-layer{% if has_default == false and colors.size == 0 and feats.size == 0 and canv.size == 0 and forloop.first %} is-active{% endif %}" data-key="s{{ forloop.index0 }}">
            {%- assign scount = 0 -%}{%- for n in (1..8) -%}{%- assign sk = 'img' | append: n -%}{%- if block.settings[sk] != blank -%}{%- assign scount = scount | plus: 1 -%}{%- endif -%}{%- endfor -%}
            {%- assign snm1 = scount | minus: 1 -%}
            {%- assign scol = block.settings.collapsed | default: 40 -%}{%- assign sexp = block.settings.expanded | default: 360 -%}
            {%- assign sh = snm1 | times: scol -%}{%- assign sgaps = snm1 | times: 4 -%}{%- assign stkh = sexp | plus: sh | plus: sgaps -%}
            {%- assign sdef = 1 -%}{%- if scount < 2 -%}{%- assign sdef = 0 -%}{%- endif -%}
            <div class="fb-stack">
              <div class="fb-stk" data-fb-stack data-def="{{ sdef }}" data-pos="{{ block.settings.stk_pos | default: 'center' }}" style="height:{{ stkh }}px;--scol:{{ scol }}px;--stk-w:{{ block.settings.stk_width | default: 340 }}px;--stk-inset:{{ block.settings.stk_inset | default: 5 }}%">
                {%- assign si = 0 -%}
                {%- for n in (1..8) -%}{%- assign sk = 'img' | append: n -%}{%- assign simg = block.settings[sk] -%}{%- if simg != blank -%}
                  <div class="fb-stk-card{% if si == sdef %} is-open{% endif %}" data-fb-stk-card>
                    <img src="{{ simg | image_url: width: 800 }}" width="{{ simg.width }}" height="{{ simg.height }}" alt="" loading="lazy">
                    <span class="fb-stk-grad" aria-hidden="true"></span>
                  </div>
                {%- assign si = si | plus: 1 -%}{%- endif -%}{%- endfor -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
        {%- for block in scrl -%}
          <div class="fb-bg-layer{% if has_default == false and colors.size == 0 and feats.size == 0 and canv.size == 0 and stak.size == 0 and forloop.first %} is-active{% endif %}" data-key="b{{ forloop.index0 }}">
            <div class="fb-scroll" data-pos="{{ block.settings.scr_pos | default: 'right' }}" style="--scr-w:{{ block.settings.scr_width | default: 42 }}%;--scr-inset:{{ block.settings.scr_inset | default: 5 }}%">
              <div class="fb-scroll-inner">{{ block.settings.content }}</div>
              <span class="fb-scroll-blur is-top" aria-hidden="true"></span>
              <span class="fb-scroll-blur is-bot" aria-hidden="true"></span>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <button type="button" class="fb-close" aria-label="Close"><svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>

      <div class="fb-left">
        <div class="fb-nav">
          <button type="button" class="fb-navbtn" data-fb-up aria-label="Previous"><svg viewBox="0 0 24 24"><polyline points="6 15 12 9 18 15"/></svg></button>
          <button type="button" class="fb-navbtn" data-fb-down aria-label="Next"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></button>
        </div>

        <div class="fb-list">
          {%- comment -%} Tabs render in real block order so you can drag to reorder any of them. {%- endcomment -%}
          {%- assign fi = 0 -%}{%- assign ki = 0 -%}{%- assign sj = 0 -%}{%- assign bi = 0 -%}{%- assign colors_shown = false -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'color' -%}
                {%- unless colors_shown -%}
                  {%- assign colors_shown = true -%}
                  <div class="fb-item" data-fb-item data-colors>
                    <button type="button" class="fb-pill"><span class="fb-ic" aria-hidden="true"></span><span class="fb-pill-title">{{ section.settings.colors_label | default: 'Colors' }}</span></button>
                    <div class="fb-panel">
                      <div class="fb-panel-text"><strong>{{ section.settings.colors_label | default: 'Colors' }}.</strong> {{ section.settings.colors_intro | default: 'Choose from a range of finishes.' }} Shown in <span class="fb-colorname" data-fb-colorname>{{ colors.first.settings.label }}</span>.</div>
                      <div class="fb-swatches">
                        {%- for cb in colors -%}
                          <button type="button" class="fb-swatch{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}" data-name="{{ cb.settings.label | escape }}" style="--sw: {{ cb.settings.swatch }}" aria-label="{{ cb.settings.label | escape }}" {{ cb.shopify_attributes }}></button>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                {%- endunless -%}
              {%- when 'feature' -%}
                <div class="fb-item" data-fb-item data-media="f{{ fi }}" {{ block.shopify_attributes }}>
                  <button type="button" class="fb-pill"><span class="fb-ic" aria-hidden="true"></span><span class="fb-pill-title">{{ block.settings.title }}</span></button>
                  {%- if block.settings.title != blank or block.settings.detail != blank -%}<div class="fb-panel"><div class="fb-panel-text">{% if block.settings.title != blank %}<strong>{{ block.settings.title }}.</strong> {% endif %}{{ block.settings.detail }}</div></div>{%- endif -%}
                </div>
                {%- assign fi = fi | plus: 1 -%}
              {%- when 'canvas' -%}
                <div class="fb-item" data-fb-item data-media="k{{ ki }}" {{ block.shopify_attributes }}>
                  <button type="button" class="fb-pill"><span class="fb-ic" aria-hidden="true"></span><span class="fb-pill-title">{{ block.settings.title }}</span></button>
                  {%- if block.settings.title != blank or block.settings.detail != blank -%}<div class="fb-panel"><div class="fb-panel-text">{% if block.settings.title != blank %}<strong>{{ block.settings.title }}.</strong> {% endif %}{{ block.settings.detail }}</div></div>{%- endif -%}
                </div>
                {%- assign ki = ki | plus: 1 -%}
              {%- when 'stack' -%}
                <div class="fb-item" data-fb-item data-media="s{{ sj }}" {{ block.shopify_attributes }}>
                  <button type="button" class="fb-pill"><span class="fb-ic" aria-hidden="true"></span><span class="fb-pill-title">{{ block.settings.title }}</span></button>
                  {%- if block.settings.title != blank or block.settings.detail != blank -%}<div class="fb-panel"><div class="fb-panel-text">{% if block.settings.title != blank %}<strong>{{ block.settings.title }}.</strong> {% endif %}{{ block.settings.detail }}</div></div>{%- endif -%}
                </div>
                {%- assign sj = sj | plus: 1 -%}
              {%- when 'scroll' -%}
                <div class="fb-item" data-fb-item data-media="b{{ bi }}" {{ block.shopify_attributes }}>
                  <button type="button" class="fb-pill"><span class="fb-ic" aria-hidden="true"></span><span class="fb-pill-title">{{ block.settings.title }}</span></button>
                  {%- if block.settings.title != blank or block.settings.detail != blank -%}<div class="fb-panel"><div class="fb-panel-text">{% if block.settings.title != blank %}<strong>{{ block.settings.title }}.</strong> {% endif %}{{ block.settings.detail }}</div></div>{%- endif -%}
                </div>
                {%- assign bi = bi | plus: 1 -%}
            {%- endcase -%}
          {%- endfor -%}

          {%- if colors.size == 0 and feats.size == 0 and canv.size == 0 and stak.size == 0 and scrl.size == 0 and request.design_mode -%}
            <div class="fb-empty">Add “Color”, “Feature”, “Infinite canvas”, “Image stack”, or “Scroll text” blocks and give each one media.</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var root = document.getElementById("dynFb-{{ section.id }}");
    if (!root) return;
    var items = Array.prototype.slice.call(root.querySelectorAll("[data-fb-item]"));
    var layers = Array.prototype.slice.call(root.querySelectorAll(".fb-bg-layer"));
    var closeBtn = root.querySelector(".fb-close");
    var nameEl = root.querySelector("[data-fb-colorname]");
    var selColor = 0, openIndex = -1;

    function showBg(key) { layers.forEach(function (l) { l.classList.toggle("is-active", l.getAttribute("data-key") === key); }); }
    function defaultKey() {
      if (root.querySelector('[data-key="default"]')) return "default";
      if (root.querySelector('[data-colors]')) return "c" + selColor;
      var f = items[0]; return f ? f.getAttribute("data-media") : "";
    }
    function closeAll() {
      openIndex = -1;
      items.forEach(function (it) { it.classList.remove("is-open"); });
      root.classList.remove("is-open");
      showBg(defaultKey());
    }
    function openTab(i) {
      if (i < 0 || i >= items.length) return;
      openIndex = i;
      items.forEach(function (it, k) { it.classList.toggle("is-open", k === i); });
      root.classList.add("is-open");
      var it = items[i];
      showBg(it.hasAttribute("data-colors") ? ("c" + selColor) : it.getAttribute("data-media"));
      /* Scroll the opened tab (and its panel) into view within the list so it's never cut off. */
      requestAnimationFrame(function () { if (it.scrollIntoView) { try { it.scrollIntoView({ block: "nearest" }); } catch (e) { it.scrollIntoView(); } } });
    }

    items.forEach(function (it, i) {
      var pill = it.querySelector(".fb-pill");
      if (pill) pill.addEventListener("click", function () { openTab(i); });
    });
    if (closeBtn) closeBtn.addEventListener("click", closeAll);
    var up = root.querySelector("[data-fb-up]"), down = root.querySelector("[data-fb-down]");
    if (up) up.addEventListener("click", function () { openTab((openIndex - 1 + items.length) % items.length); });
    if (down) down.addEventListener("click", function () { openTab((openIndex + 1) % items.length); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && openIndex >= 0) closeAll(); });

    /* Colour swatches: change the phone colour (background media) */
    root.querySelectorAll(".fb-swatch").forEach(function (sw) {
      sw.addEventListener("click", function (e) {
        e.stopPropagation();
        selColor = parseInt(sw.getAttribute("data-i"), 10) || 0;
        root.querySelectorAll(".fb-swatch").forEach(function (s) { s.classList.toggle("is-active", s === sw); });
        if (nameEl) nameEl.textContent = sw.getAttribute("data-name") || "";
        showBg("c" + selColor);
      });
    });

    /* Infinite canvas — a draggable, wrapping grid of images */
    function initCanvas(el) {
      var plane = el.querySelector("[data-fb-canvas-plane]"), src = el.querySelector("[data-fb-canvas-imgs]");
      var imgs = []; try { imgs = JSON.parse(src.textContent) || []; } catch (e) {}
      if (!plane || !imgs.length) return;
      var tile = parseInt(el.getAttribute("data-tile"), 10) || 220, gap = parseInt(el.getAttribute("data-gap"), 10) || 16;
      var cellW = tile + gap, cellH = tile + gap;
      var ox = 0, oy = 0, gridW = 0, gridH = 0, cols = 0, rows = 0, vx = 0, vy = 0, dragging = false, lx = 0, ly = 0, raf = null;
      function apply() { var tx = (((ox % gridW) + gridW) % gridW) - gridW, ty = (((oy % gridH) + gridH) % gridH) - gridH; plane.style.transform = "translate(" + tx + "px," + ty + "px)"; }
      function build() {
        var W = el.clientWidth || 600, H = el.clientHeight || 600;
        cols = Math.ceil(W / cellW) + 1; rows = Math.ceil(H / cellH) + 1; gridW = cols * cellW; gridH = rows * cellH;
        var frag = document.createDocumentFragment();
        for (var j = 0; j < rows * 2; j++) { for (var i = 0; i < cols * 2; i++) {
          var d = document.createElement("div"); d.className = "fb-tile"; d.style.width = tile + "px"; d.style.height = tile + "px";
          d.style.transform = "translate(" + (i * cellW) + "px," + (j * cellH) + "px)";
          var idx = ((i % cols) + (j % rows) * cols) % imgs.length;
          var im = new Image(); im.src = imgs[idx]; im.loading = "lazy"; im.draggable = false; d.appendChild(im); frag.appendChild(d);
        } }
        plane.innerHTML = ""; plane.appendChild(frag); apply();
      }
      function momentum() { if (dragging) { raf = null; return; } vx *= 0.94; vy *= 0.94; ox += vx; oy += vy; apply(); raf = (Math.abs(vx) > 0.15 || Math.abs(vy) > 0.15) ? requestAnimationFrame(momentum) : null; }
      el.addEventListener("pointerdown", function (e) { dragging = true; lx = e.clientX; ly = e.clientY; vx = vy = 0; el.classList.add("is-grab"); if (el.setPointerCapture) { try { el.setPointerCapture(e.pointerId); } catch (er) {} } });
      el.addEventListener("pointermove", function (e) { if (!dragging) return; var dx = e.clientX - lx, dy = e.clientY - ly; lx = e.clientX; ly = e.clientY; ox += dx; oy += dy; vx = dx; vy = dy; apply(); });
      function end() { if (!dragging) return; dragging = false; el.classList.remove("is-grab"); if (!raf) raf = requestAnimationFrame(momentum); }
      el.addEventListener("pointerup", end); el.addEventListener("pointercancel", end);
      el.addEventListener("wheel", function (e) { ox -= e.deltaX; oy -= e.deltaY; apply(); e.preventDefault(); }, { passive: false });
      build();
      window.addEventListener("resize", build);
    }
    root.querySelectorAll("[data-fb-canvas]").forEach(initCanvas);

    /* Image stack — hover/tap a card to expand it (used as a tab's media) */
    function initStack(el) {
      var cards = Array.prototype.slice.call(el.querySelectorAll("[data-fb-stk-card]"));
      if (!cards.length) return;
      var def = parseInt(el.getAttribute("data-def"), 10) || 0;
      function open(i) { var n = cards.length; var k = ((i % n) + n) % n; cards.forEach(function (c, idx) { c.classList.toggle("is-open", idx === k); }); }
      cards.forEach(function (c, i) { c.addEventListener("mouseenter", function () { open(i); }); c.addEventListener("click", function () { open(i); }); });
      open(def);
    }
    root.querySelectorAll("[data-fb-stack]").forEach(initStack);

    /* Before / After sliders — drag to compare (used as a tab's media) */
    function initBA(el) {
      var after = el.querySelector("[data-fb-ba-after]"), handle = el.querySelector("[data-fb-ba-handle]");
      if (!after || !handle) return;
      var target = 50, cur = 50, raf = null;
      function paint() { var v = cur.toFixed(2); after.style.clipPath = "inset(0 0 0 " + v + "%)"; after.style.webkitClipPath = "inset(0 0 0 " + v + "%)"; handle.style.left = v + "%"; }
      function tick() { cur += (target - cur) * 0.15; if (Math.abs(target - cur) < 0.05) cur = target; paint(); raf = (cur !== target) ? requestAnimationFrame(tick) : null; }
      function to(p) { target = Math.max(2, Math.min(98, p)); if (!raf) raf = requestAnimationFrame(tick); }
      paint();
      el.addEventListener("mousemove", function (e) { var r = el.getBoundingClientRect(); to((e.clientX - r.left) / r.width * 100); });
      el.addEventListener("touchmove", function (e) { var r = el.getBoundingClientRect(); to((e.touches[0].clientX - r.left) / r.width * 100); }, { passive: true });
    }
    root.querySelectorAll("[data-fb-ba]").forEach(initBA);

    closeAll(); /* start with nothing open */
  })();
  </script>
</section>

{% schema %}
{
  "name": "Apple Feature Block",
  "tag": "section",
  "class": "dynamic-feature-block-section",
  "settings": [
    { "type": "paragraph", "content": "Liquid-glass tabs over a full-bleed background. By default nothing is open. Clicking a tab opens it like a page (glass card + swaps the background media). Close with the × (top-right); step with the ↑/↓ arrows. Add a “Color” block per colour (swatch + media) and a “Feature” block per detail (title + detail + media)." },
    { "type": "header", "content": "Size & position" },
    { "type": "range", "id": "content_width", "min": 40, "max": 100, "step": 1, "unit": "%", "label": "Width", "default": 85 },
    { "type": "range", "id": "card_height", "min": 360, "max": 1000, "step": 10, "unit": "px", "label": "Height", "default": 640 },
    { "type": "select", "id": "align", "label": "Horizontal position", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "checkbox", "id": "full_height", "label": "Center in the full screen height", "default": true, "info": "On = the block is vertically centered in a full screen. Off = it flows normally with the spacing below." },
    { "type": "range", "id": "pad_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Space above (when not full height)", "default": 40 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Space below (when not full height)", "default": 40 },
    { "type": "header", "content": "Default cover (shown before any tab is open)" },
    { "type": "image_picker", "id": "default_image", "label": "Default background image", "info": "Shown when no tab is open, and again whenever you close a tab. Leave empty to use the first tab's media." },
    { "type": "video", "id": "default_video", "label": "Default background video (optional)", "info": "If set, plays instead of the image above." },
    { "type": "header", "content": "Heading (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "header", "content": "Colors tab" },
    { "type": "text", "id": "colors_label", "label": "Colors tab label", "default": "Colors" },
    { "type": "textarea", "id": "colors_intro", "label": "Colors tab text", "default": "Choose from a range of bold finishes." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "page_bg", "label": "Section background", "default": "#141414" },
    { "type": "color", "id": "card_bg", "label": "Card background (behind media)", "default": "#050505" },
    { "type": "color", "id": "accent", "label": "Accent (eyebrow)", "default": "#0071e3" }
  ],
  "blocks": [
    { "type": "color", "name": "Color", "settings": [
      { "type": "text", "id": "label", "label": "Color name", "default": "Cosmic Orange" },
      { "type": "color", "id": "swatch", "label": "Swatch color", "default": "#c65a2e" },
      { "type": "image_picker", "id": "image", "label": "Background image (this colour)" },
      { "type": "video", "id": "video", "label": "Background video (optional, overrides image)" },
      { "type": "header", "content": "Before / after slider (optional)" },
      { "type": "paragraph", "content": "Set BOTH images to show a draggable before/after comparison as this tab's background (overrides the image/video above)." },
      { "type": "image_picker", "id": "ba_before", "label": "Before image" },
      { "type": "image_picker", "id": "ba_after", "label": "After image" },
      { "type": "text", "id": "ba_before_label", "label": "Before label", "default": "Before" },
      { "type": "text", "id": "ba_after_label", "label": "After label", "default": "After" },
      { "type": "range", "id": "ba_width", "min": 30, "max": 100, "step": 1, "unit": "%", "label": "Slider width", "default": 55 },
      { "type": "select", "id": "ba_ratio", "label": "Slider shape", "default": "4 / 3", "options": [ { "value": "4 / 3", "label": "Landscape 4:3" }, { "value": "1 / 1", "label": "Square" }, { "value": "3 / 4", "label": "Portrait 3:4" }, { "value": "16 / 9", "label": "Wide 16:9" }, { "value": "3 / 2", "label": "Photo 3:2" } ] },
      { "type": "select", "id": "ba_pos", "label": "Slider position", "default": "right", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
      { "type": "range", "id": "ba_inset", "min": 0, "max": 25, "step": 1, "unit": "%", "label": "Distance from the side", "default": 5 }
    ]},
    { "type": "feature", "name": "Feature (tab)", "settings": [
      { "type": "text", "id": "title", "label": "Feature title", "default": "Ceramic Shield" },
      { "type": "textarea", "id": "detail", "label": "Details", "default": "Describe this feature — what it is and why it matters." },
      { "type": "image_picker", "id": "image", "label": "Background image (this feature)" },
      { "type": "video", "id": "video", "label": "Background video (optional, overrides image)" },
      { "type": "header", "content": "Before / after slider (optional)" },
      { "type": "paragraph", "content": "Set BOTH images to show a draggable before/after comparison as this tab's background (overrides the image/video above)." },
      { "type": "image_picker", "id": "ba_before", "label": "Before image" },
      { "type": "image_picker", "id": "ba_after", "label": "After image" },
      { "type": "text", "id": "ba_before_label", "label": "Before label", "default": "Before" },
      { "type": "text", "id": "ba_after_label", "label": "After label", "default": "After" },
      { "type": "range", "id": "ba_width", "min": 30, "max": 100, "step": 1, "unit": "%", "label": "Slider width", "default": 55 },
      { "type": "select", "id": "ba_ratio", "label": "Slider shape", "default": "4 / 3", "options": [ { "value": "4 / 3", "label": "Landscape 4:3" }, { "value": "1 / 1", "label": "Square" }, { "value": "3 / 4", "label": "Portrait 3:4" }, { "value": "16 / 9", "label": "Wide 16:9" }, { "value": "3 / 2", "label": "Photo 3:2" } ] },
      { "type": "select", "id": "ba_pos", "label": "Slider position", "default": "right", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
      { "type": "range", "id": "ba_inset", "min": 0, "max": 25, "step": 1, "unit": "%", "label": "Distance from the side", "default": 5 }
    ]},
    { "type": "canvas", "name": "Infinite canvas (tab)", "settings": [
      { "type": "text", "id": "title", "label": "Tab title", "default": "Gallery" },
      { "type": "textarea", "id": "detail", "label": "Details", "default": "Drag to explore." },
      { "type": "range", "id": "tile_size", "min": 120, "max": 360, "step": 10, "unit": "px", "label": "Image size", "default": 220 },
      { "type": "range", "id": "gap", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Gap between images", "default": 16 },
      { "type": "paragraph", "content": "Add up to 10 images — they tile into an endless draggable grid (drag, scroll, or swipe to move)." },
      { "type": "image_picker", "id": "img1", "label": "Image 1" },
      { "type": "image_picker", "id": "img2", "label": "Image 2" },
      { "type": "image_picker", "id": "img3", "label": "Image 3" },
      { "type": "image_picker", "id": "img4", "label": "Image 4" },
      { "type": "image_picker", "id": "img5", "label": "Image 5" },
      { "type": "image_picker", "id": "img6", "label": "Image 6" },
      { "type": "image_picker", "id": "img7", "label": "Image 7" },
      { "type": "image_picker", "id": "img8", "label": "Image 8" },
      { "type": "image_picker", "id": "img9", "label": "Image 9" },
      { "type": "image_picker", "id": "img10", "label": "Image 10" }
    ]},
    { "type": "stack", "name": "Image stack (tab)", "settings": [
      { "type": "text", "id": "title", "label": "Tab title", "default": "Gallery" },
      { "type": "textarea", "id": "detail", "label": "Details", "default": "Hover a card to expand it." },
      { "type": "range", "id": "stk_width", "min": 220, "max": 560, "step": 10, "unit": "px", "label": "Stack width", "default": 340 },
      { "type": "range", "id": "expanded", "min": 200, "max": 520, "step": 10, "unit": "px", "label": "Expanded card height", "default": 360 },
      { "type": "range", "id": "collapsed", "min": 28, "max": 90, "step": 2, "unit": "px", "label": "Collapsed bar height", "default": 40 },
