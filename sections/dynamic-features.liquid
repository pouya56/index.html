{% comment %}
  ============================================================================
  Dynamic Features — editable "3 columns with icons" section
  ----------------------------------------------------------------------------
  INSTALL:
  1. Theme code editor > Sections > Add a new section > name it "dynamic-features"
     and REPLACE its contents with this whole file.
  2. In the theme editor (Customize), click "Add section" > "Dynamic Features",
     then drag it wherever you want on the page.
  3. Heading and subheading are editable at the top. Each column is a Block:
     click a column to change its icon, title, and text; use "Add Feature" to
     add more, and drag to reorder. Leave the icon empty to hide it.
  No apps required.
  ============================================================================
{% endcomment %}

<style>
  .dyn-feat { max-width: 1240px; margin: 40px auto; padding: 72px 22px 84px;
    background: {{ section.settings.bg_color }}; border-radius: {{ section.settings.corner_radius }}px;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: inherit; text-align: center; -webkit-font-smoothing: antialiased; }
  .dyn-feat-title { font-size: clamp(30px, 4vw, 52px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.06; margin: 0; color: inherit; }
  .dyn-feat-lead { max-width: 760px; margin: 24px auto 0; font-size: 21px; line-height: 1.5; opacity: 0.85; color: inherit; }
  .dyn-feat-cols { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, 1fr); gap: 40px; margin-top: 72px; }
  .dyn-feat-col { display: flex; flex-direction: column; align-items: center; }
  .dyn-feat-ico { width: 74px; height: 74px; object-fit: contain; }
  .dyn-feat-col h3 { font-size: 24px; font-weight: 700; letter-spacing: -0.01em; margin: 24px 0 0; color: inherit; }
  .dyn-feat-col p { font-size: 17px; opacity: 0.62; margin: 12px 0 0; max-width: 26ch; line-height: 1.45; color: inherit; }
  .dyn-feat-empty { opacity: 0.55; font-size: 16px; }
  @media (max-width: 860px) {
    .dyn-feat { padding: 56px 20px 64px; }
    .dyn-feat-cols { grid-template-columns: 1fr; gap: 48px; margin-top: 56px; }
  }
</style>

<section class="dyn-feat">
  {% if section.settings.heading != blank %}
    <h2 class="dyn-feat-title">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <p class="dyn-feat-lead">{{ section.settings.subheading }}</p>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="dyn-feat-cols">
      {% for block in section.blocks %}
        <div class="dyn-feat-col" {{ block.shopify_attributes }}>
          {% if block.settings.icon %}
            <img class="dyn-feat-ico" src="{{ block.settings.icon | image_url: width: 160 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% endif %}
          {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
          {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="dyn-feat-empty">Add your first feature with “Add Feature”.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Dynamic Features",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Breakthrough hearing health experience." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Take a scientifically validated Hearing Test in five minutes from the comfort of your home." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#eef0fb" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Short description of this feature." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Dynamic Features",
      "blocks": [
        { "type": "feature", "settings": { "title": "Hearing Test", "text": "Test your hearing in the comfort of your home." } },
        { "type": "feature", "settings": { "title": "Hearing Aid", "text": "Clinical-grade support for perceived mild to moderate hearing loss." } },
        { "type": "feature", "settings": { "title": "Hearing Protection", "text": "Helps prevent exposure to loud environmental noise." } }
      ]
    }
  ]
}
{% endschema %}
