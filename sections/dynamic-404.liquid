{% comment %}
  ============================================================================
  Dynamic 404 — a video 404 page where the person in the clip "follows" the
  mouse: the video is paused and the cursor's X position scrubs the timeline,
  so their movement tracks the pointer. On touch screens (no cursor) the clip
  simply plays on a loop.
  SETUP:
  1. Theme editor > Sections > add "dynamic-404" > paste this file.
  2. Online Store > Customize > template dropdown > "404 page" > Add section >
     "Dynamic 404" (remove the theme's default 404 section if you like).
  3. In the section settings, pick your video (it uploads to Content > Files).
  ============================================================================
{% endcomment %}

{%- assign s4 = section.settings -%}

<style>
  .dyn404 { --ink:#1d1d1f; --soft:#6e6e73; --accent:#0071e3;
    --font:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    font-family:var(--font); color:var(--ink); -webkit-font-smoothing:antialiased;
    min-height:{{ s4.height | default: 86 }}svh; display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:48px 22px 64px; }
  .dyn404 .d4-stage { position:relative; width:min({{ s4.video_width | default: 420 }}px, 86vw); border-radius:26px; overflow:hidden;
    box-shadow:0 24px 70px rgba(0,0,0,0.18); background:#000; }
  .dyn404 .d4-stage video { display:block; width:100%; height:auto; }
  .dyn404 h1 { font-size:clamp(44px,9vw,84px); font-weight:700; letter-spacing:-0.03em; margin:30px 0 6px; line-height:1; }
  .dyn404 p { font-size:17px; color:var(--soft); margin:0 0 24px; max-width:460px; line-height:1.55; }
  .dyn404 .d4-btn { display:inline-flex; align-items:center; gap:8px; height:50px; padding:0 26px; border-radius:999px;
    background:var(--ink); color:#fff; font-size:15.5px; font-weight:600; text-decoration:none; transition:opacity .16s, transform .1s; }
  .dyn404 .d4-btn:hover { opacity:.9; } .dyn404 .d4-btn:active { transform:scale(.98); }
  .dyn404 .d4-hint { font-size:12.5px; color:var(--soft); opacity:.7; margin-top:14px; }
  @media (hover: none) { .dyn404 .d4-hint { display:none; } }
</style>

<div class="dyn404" id="dyn404">
  <div class="d4-stage">
    <video id="d4Video" muted playsinline preload="auto" loop
      {%- if s4.vid.preview_image %} poster="{{ s4.vid.preview_image | image_url: width: 900 }}"{%- endif -%}>
      {%- if s4.vid != blank -%}
        {%- for src in s4.vid.sources -%}
          <source src="{{ src.url }}" type="{{ src.mime_type }}">
        {%- endfor -%}
      {%- elsif s4.video_url != blank -%}
        <source src="{{ s4.video_url }}" type="video/mp4">
      {%- endif -%}
    </video>
  </div>
  <h1>{{ s4.heading | default: '404' }}</h1>
  <p>{{ s4.message | default: "This page wandered off — but she's keeping an eye on you." }}</p>
  <a class="d4-btn" href="{{ s4.button_url | default: routes.root_url }}">{{ s4.button_label | default: 'Back to home' }}</a>
  {%- if s4.hint != blank -%}<div class="d4-hint">{{ s4.hint }}</div>{%- endif -%}
</div>

<script>
(function () {
  var v = document.getElementById("d4Video");
  if (!v || !v.querySelector("source")) return;
  var INVERT = {% if s4.invert %}true{% else %}false{% endif %};
  var R0 = {{ s4.scrub_start | default: 0 | divided_by: 100.0 }};
  var R1 = {{ s4.scrub_end | default: 100 | divided_by: 100.0 }};
  var noHover = window.matchMedia && window.matchMedia("(hover: none)").matches;

  // Touch screens: no cursor to follow — just play the clip on a loop.
  if (noHover) { v.autoplay = true; v.play().catch(function () {}); return; }

  var dur = 0, target = 0, cur = 0, started = false;
  v.addEventListener("loadedmetadata", function () {
    dur = v.duration || 0;
    v.pause();
    // Park on the middle frame so she starts looking straight ahead.
    cur = target = dur * (R0 + (R1 - R0) * 0.5);
    try { v.currentTime = cur; } catch (e) {}
  });
  // The cursor's X position picks a point on the timeline; we glide toward it.
  document.addEventListener("mousemove", function (e) {
    if (!dur) return;
    var x = e.clientX / Math.max(1, window.innerWidth);
    if (INVERT) x = 1 - x;
    target = dur * (R0 + (R1 - R0) * Math.min(1, Math.max(0, x)));
    started = true;
  });
  (function tick() {
    if (dur && started) {
      cur += (target - cur) * 0.14;                    // easing — feels like she turns to you
      if (Math.abs(cur - (v.currentTime || 0)) > 0.033) {
        try { if (v.fastSeek) v.fastSeek(cur); else v.currentTime = cur; } catch (e) {}
      }
    }
    requestAnimationFrame(tick);
  })();
})();
</script>

{% schema %}
{
  "name": "Dynamic 404",
  "tag": "section",
  "class": "dynamic-404-section",
  "settings": [
    { "type": "paragraph", "content": "A 404 page where the person in your video follows the mouse: the clip is paused and the cursor scrubs its timeline. Works best with a clip where they turn their head or move across the frame. On phones it just plays on a loop." },
    { "type": "video", "id": "vid", "label": "Video", "info": "Upload your clip here (goes to Content → Files). Short clips (5–20s, a few MB) feel the most responsive." },
    { "type": "text", "id": "video_url", "label": "…or a direct video URL", "info": "Only used if no video is picked above. Paste an .mp4 URL from Content → Files." },
    { "type": "range", "id": "video_width", "label": "Video width", "min": 260, "max": 720, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "height", "label": "Section height", "min": 60, "max": 100, "step": 2, "unit": "%", "default": 86 },
    { "type": "header", "content": "Mouse follow" },
    { "type": "range", "id": "scrub_start", "label": "Use clip from", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 0, "info": "Trim the scrub range if only part of the clip has the movement." },
    { "type": "range", "id": "scrub_end", "label": "Use clip to", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "invert", "label": "Reverse direction", "default": false, "info": "Tick if she looks the wrong way (moves opposite to the mouse)." },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "404" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "This page wandered off — but she's keeping an eye on you." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Back to home" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Defaults to the home page." },
    { "type": "text", "id": "hint", "label": "Small hint under the button", "default": "Psst — move your mouse." }
  ],
  "presets": [ { "name": "Dynamic 404" } ],
  "enabled_on": { "templates": ["404", "page", "index"] }
}
{% endschema %}
