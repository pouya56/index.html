{% comment %}
  ============================================================================
  Dynamic 404 — a paper canvas you collage yourself: upload PNG pieces as
  "Photo scrap" blocks and place them with position / width / tilt settings.
  Images are shown exactly as uploaded (no border, no effects) and visitors
  can pick them up and drag them around. The page itself only draws the
  "back on track" line and the two torn-paper buttons at the bottom.
  SETUP:
  1. Theme editor > Sections > add "dynamic-404" > paste this file.
  2. Online Store > Customize > template dropdown > "404 page" > Add section >
     "Dynamic 404" (remove the theme's default 404 section if you like).
  3. Add "Photo scrap" blocks and upload your collage PNGs.
  ============================================================================
{% endcomment %}

{%- assign s4 = section.settings -%}

<style>
  .dyn404 { --ink: #17130f; --cream: #efe8d8; --paper: #e7dfcf; --red: #c22127;
    --head: "Archivo Black", "Archivo", "Helvetica Neue", Arial, sans-serif;
    --type: "Courier Prime", "Courier New", Courier, monospace;
    background: var(--paper);
    background-image: radial-gradient(rgba(23, 19, 15, 0.05) 1px, transparent 1.4px);
    background-size: 26px 26px;
    color: var(--ink); -webkit-font-smoothing: antialiased;
    display: flex; align-items: center; justify-content: center;
    padding: clamp(20px, 4vw, 48px) 18px; overflow: hidden; }

  .dyn404 .d4-poster { position: relative; width: min(760px, 94vw);
    min-height: {{ s4.height | default: 86 }}svh; }

  .dyn404 .d4-foot { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    text-align: center; }
  .dyn404 .d4-track { font-family: var(--type); font-size: clamp(13px, 2.1vw, 16px);
    letter-spacing: 0.04em; margin: 0 0 18px; }
  .dyn404 .d4-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .dyn404 .d4-btn { font-family: var(--head); font-weight: 900; text-transform: uppercase;
    font-size: clamp(12px, 1.8vw, 14px); letter-spacing: 0.08em; text-decoration: none;
    padding: 15px 22px 14px; display: inline-block; line-height: 1;
    clip-path: polygon(1% 12%, 28% 0%, 58% 8%, 100% 3%, 98% 55%, 100% 90%, 68% 100%, 34% 92%, 0% 98%, 2% 50%);
    filter: drop-shadow(3px 4px 0 rgba(23, 19, 15, 0.28));
    transition: transform 0.14s ease; }
  .dyn404 .d4-btn:hover { transform: translateY(-2px) rotate(-0.6deg); }
  .dyn404 .d4-home { background: #16120f; color: var(--cream); transform: rotate(-1deg); }
  .dyn404 .d4-shop { background: var(--red); color: var(--cream); transform: rotate(0.8deg); }

  /* uploaded collage pieces: shown exactly as uploaded, draggable by visitors */
  .dyn404 .d4-photo { position: absolute; z-index: 4; cursor: grab; touch-action: none;
    user-select: none; -webkit-user-select: none;
    transform: rotate(var(--rot, 0deg)); }
  .dyn404 .d4-photo img { display: block; width: 100%; height: auto; pointer-events: none;
    -webkit-user-drag: none; }
  .dyn404 .d4-photo.is-drag { cursor: grabbing; z-index: 40; }
</style>

<div class="dyn404">
  <div class="d4-poster">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        <div class="d4-photo"
          style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%; width: {{ block.settings.w }}%; --rot: {{ block.settings.tilt }}deg;"
          {{ block.shopify_attributes }}>
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="" loading="lazy"
            width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
        </div>
      {%- endif -%}
    {%- endfor -%}
    <div class="d4-foot">
      <p class="d4-track">{{ s4.track_text | default: "let's get you back on track." }}</p>
      <div class="d4-btns">
        <a class="d4-btn d4-home" href="{{ s4.button_url | default: routes.root_url }}">&larr; {{ s4.button_label | default: 'Go back home' }}</a>
        <a class="d4-btn d4-shop" href="{{ s4.button2_url | default: routes.all_products_collection_url }}">{{ s4.button2_label | default: 'Browse collection' }}</a>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var scraps = document.querySelectorAll(".dyn404 .d4-photo");
  Array.prototype.forEach.call(scraps, function (el) {
    el.addEventListener("pointerdown", function (e) {
      if (e.button && e.button !== 0) return;
      e.preventDefault();
      var sx = e.clientX, sy = e.clientY;
      var bx = parseFloat(el.dataset.dx || 0), by = parseFloat(el.dataset.dy || 0);
      el.classList.add("is-drag");
      try { el.setPointerCapture(e.pointerId); } catch (err) {}
      function mv(ev) {
        var dx = bx + ev.clientX - sx, dy = by + ev.clientY - sy;
        el.dataset.dx = dx; el.dataset.dy = dy;
        el.style.transform = "translate(" + dx + "px," + dy + "px) rotate(var(--rot, 0deg))";
      }
      function up(ev) {
        el.classList.remove("is-drag");
        try { el.releasePointerCapture(ev.pointerId); } catch (err) {}
        el.removeEventListener("pointermove", mv);
        el.removeEventListener("pointerup", up);
        el.removeEventListener("pointercancel", up);
      }
      el.addEventListener("pointermove", mv);
      el.addEventListener("pointerup", up);
      el.addEventListener("pointercancel", up);
    });
  });
})();
</script>

{% schema %}
{
  "name": "Dynamic 404",
  "tag": "section",
  "class": "dynamic-404-section",
  "settings": [
    { "type": "paragraph", "content": "A blank paper canvas for your own 404 collage: add 'Photo scrap' blocks (bottom of this panel) and upload PNG pieces — each is shown exactly as uploaded, placed with its position, width and tilt settings, and visitors can drag the pieces around. The page itself only draws the line and the two torn-paper buttons at the bottom." },
    { "type": "range", "id": "height", "label": "Canvas height", "min": 60, "max": 100, "step": 2, "unit": "%", "default": 86, "info": "How much of the screen the collage canvas fills." },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "track_text", "label": "Line above the buttons", "default": "let's get you back on track." },
    { "type": "text", "id": "button_label", "label": "Black button text", "default": "Go back home" },
    { "type": "url", "id": "button_url", "label": "Black button link", "info": "Defaults to the home page." },
    { "type": "text", "id": "button2_label", "label": "Red button text", "default": "Browse collection" },
    { "type": "url", "id": "button2_url", "label": "Red button link", "info": "Defaults to the all-products collection." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo scrap",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (PNG)", "info": "Shown exactly as uploaded — no border or effects. Visitors can pick it up and drag it around (moves don't save). Later blocks stack on top of earlier ones." },
        { "type": "range", "id": "x", "label": "Left position", "min": -10, "max": 90, "step": 1, "unit": "%", "default": 30 },
        { "type": "range", "id": "y", "label": "Top position", "min": -10, "max": 90, "step": 1, "unit": "%", "default": 20 },
        { "type": "range", "id": "w", "label": "Width", "min": 6, "max": 100, "step": 1, "unit": "%", "default": 40 },
        { "type": "range", "id": "tilt", "label": "Tilt", "min": -15, "max": 15, "step": 1, "unit": "deg", "default": 0 }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [ { "name": "Dynamic 404" } ],
  "enabled_on": { "templates": ["404", "page", "index"] }
}
{% endschema %}
