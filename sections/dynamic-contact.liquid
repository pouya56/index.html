    { "type": "text", "id": "eyebrow", "label": "Small label above title", "default": "Contact" },
    { "type": "checkbox", "id": "show_logo", "label": "Show logo", "default": true },
    { "type": "image_picker", "id": "contact_logo", "label": "Logo (optional)", "info": "Centered above the title. Leave empty to use your Theme settings → Logo." },
    { "type": "text", "id": "heading", "label": "Title", "default": "Let's create something great" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Whether you need a custom print, business stationery, branded merchandise, or simply have a question - we'd love to hear about your project." },
    { "type": "text", "id": "reply_line", "label": "Reply-time line", "default": "We typically reply within one business day", "info": "Small tracked caps under the intro. Type hide to remove it." },

    { "type": "header", "content": "Studio info (left column)" },
    { "type": "checkbox", "id": "show_info", "label": "Show studio info", "default": true },
    { "type": "text", "id": "info_heading", "label": "Column heading", "default": "Contact" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@dynaeimic.com" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "address", "label": "Studio location", "default": "New York City" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Monday – Friday, 9:00 AM – 6:00 PM" },
    { "type": "text", "id": "response_line", "label": "Average response", "default": "Within one business day", "info": "Type hide to remove the row." },
    { "type": "text", "id": "pencil_note", "label": "Handwritten pencil note", "default": "we read every message ourselves —", "info": "Type hide to remove it." },
    { "type": "url", "id": "instagram_url", "label": "Instagram link" },
    { "type": "url", "id": "facebook_url", "label": "Facebook link" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok link" },

    { "type": "header", "content": "Project form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Start Your Project" },
    { "type": "text", "id": "form_sub", "label": "Line under the form heading", "default": "A short brief helps us reply with real answers" },
    { "type": "textarea", "id": "project_types", "label": "Project type options", "default": "Business Cards, Apparel, Packaging, Wedding, Stickers, Stationery, Custom Project, Other", "info": "Comma-separated list for the dropdown." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Send Project" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — your project is on our desk. We'll reply within one business day." },
    { "type": "text", "id": "form_note", "label": "Small note under the button", "default": "We never share your details." },

    { "type": "header", "content": "Trust line & FAQ" },
    { "type": "textarea", "id": "trust_items", "label": "Trust items (one per line)", "default": "Professional artwork review\nFast response\nMade in New York\nPremium materials\nProduction guidance included", "info": "Type hide to remove the whole line." },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Common questions" },
    { "type": "textarea", "id": "faq_items", "label": "FAQ items (Question|Answer, one per line)", "default": "How long does production take?|3–5 business days after artwork approval.\nCan you help with design?|Yes. We can prepare or adjust artwork before printing.\nIs there a minimum order?|Depends on the product — most start at one piece.", "info": "Type hide to remove the FAQ." },
    { "type": "url", "id": "faq_url", "label": "Link to the full FAQ page" }
  ],
  "presets": [ { "name": "Dynamic Contact" } ],
  "enabled_on": { "templates": ["page", "index"] }
