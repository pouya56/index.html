{%- comment -%}
  Dynamic Account Dashboard — a tabbed customer account page.

  Put this section on a page (e.g. create a page called "Account" so its address
  is /pages/account) and point your account/menu link there. Deep-link a tab by
  adding a hash, e.g. /pages/account#wishlist.

  Sidebar: Orders and Profile are direct links to Shopify's native customer
  account pages (https://shopify.com/<shop.id>/account/orders and /account/profile),
  which hold order details, tracking, name, email and addresses (a theme can't
  change those). Wishlist / Saved Designs / Reviews are in-page tabs, saved in
  the shopper's browser (no app needed); the profile photo is too. Point your
  header account icon here by setting the header's "Account page" URL to this
  page (default /pages/account).
{%- endcomment -%}

<section class="dyn-acct" id="dynAcct" data-login="{{ routes.account_login_url }}">
  <style>
    #shopify-section-{{ section.id }} { background: {{ section.settings.page_bg | default: '#ffffff' }}; }
    .dyn-acct {
      --ink:#1d1d1f; --ink-soft:#6e6e73; --ink-faint:#86868b; --line:#e5e5ea; --line-soft:#f0f0f2;
      --panel:#f5f5f7; --accent:#0071e3; --danger:#c0392b; --ok:#1a7f37;
      --font:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      color:var(--ink); font-family:var(--font); -webkit-font-smoothing:antialiased;
    }
    .dyn-acct .da-topbar { max-width:1120px; margin:0 auto; padding:26px 22px 0; }
    .dyn-acct .da-logo { display:inline-flex; align-items:center; text-decoration:none; color:var(--ink); }
    .dyn-acct .da-logo img { display:block; height:auto; }
    .dyn-acct .da-logo-text { font-size:22px; font-weight:700; letter-spacing:-0.02em; }
    .dyn-acct .da-wrap { max-width:1120px; margin:0 auto; padding:28px 22px 90px; display:grid; grid-template-columns:230px 1fr; gap:40px; align-items:start; }
    .dyn-acct .da-nav { display:flex; flex-direction:column; gap:2px; position:sticky; top:24px; }
    .dyn-acct .da-hi { font-size:19px; font-weight:600; margin-bottom:16px; letter-spacing:-0.01em; }
    .dyn-acct .da-tab { text-align:left; border:0; background:none; cursor:pointer; font:inherit; font-size:15px; color:var(--ink-soft); padding:10px 14px; border-radius:10px; transition:background .15s,color .15s; }
    .dyn-acct .da-tab:hover { background:var(--line-soft); color:var(--ink); }
    .dyn-acct .da-tab.is-active { background:var(--ink); color:#fff; font-weight:500; }
    .dyn-acct .da-navlink { display:flex; align-items:center; gap:6px; text-align:left; font-size:15px; color:var(--ink-soft); padding:10px 14px; border-radius:10px; text-decoration:none; transition:background .15s,color .15s; }
    .dyn-acct .da-navlink:hover { background:var(--line-soft); color:var(--ink); }
    .dyn-acct .da-navlink svg { width:13px; height:13px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
    .dyn-acct .da-logout { margin-top:14px; padding:10px 14px; font-size:14px; color:var(--ink-faint); text-decoration:none; }
    .dyn-acct .da-logout:hover { color:var(--danger); }
    .dyn-acct .da-idbar { display:flex; align-items:center; gap:11px; margin-bottom:18px; }
    .dyn-acct .da-idbar .da-hi { margin:0; }
    .dyn-acct .da-avatar { width:42px; height:42px; flex:none; border-radius:50%; overflow:hidden; background:var(--panel); display:flex; align-items:center; justify-content:center; }
    .dyn-acct .da-avatar img { width:100%; height:100%; object-fit:cover; }
    .dyn-acct .da-avatar-fb { font-weight:600; color:var(--ink-faint); font-size:17px; }
    .dyn-acct .da-avatar-lg { width:78px; height:78px; }
    .dyn-acct .da-avatar-lg .da-avatar-fb { font-size:30px; }
    .dyn-acct .da-profile-row { display:flex; gap:18px; align-items:center; }
    .dyn-acct .da-profile-name { font-size:17px; font-weight:600; }
    .dyn-acct .da-profile-email { color:var(--ink-soft); font-size:14px; margin-top:2px; }
    .dyn-acct .da-profile-actions { display:flex; align-items:center; gap:12px; margin-top:12px; }
    .dyn-acct .da-profile-actions label { cursor:pointer; }
    .dyn-acct .da-profile-note { font-size:12px; color:var(--ink-faint); margin-top:8px; }
    .dyn-acct .da-avatar-btn { position:relative; border:0; padding:0; cursor:pointer; }
    .dyn-acct .da-avatar-cam { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.42); opacity:0; transition:opacity .15s; border-radius:50%; }
    .dyn-acct .da-avatar-cam svg { width:45%; height:45%; fill:none; stroke:#fff; stroke-width:1.7; stroke-linejoin:round; }
    .dyn-acct .da-avatar-btn:hover .da-avatar-cam, .dyn-acct .da-avatar-btn:focus-visible .da-avatar-cam { opacity:1; }
    .dyn-acct .da-sech { font-size:19px; font-weight:600; margin:0; letter-spacing:-0.01em; }
    .dyn-acct .da-signout { margin-top:30px; padding-top:20px; border-top:1px solid var(--line-soft); }
    .dyn-acct .da-ext svg { width:13px; height:13px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; vertical-align:-1px; margin-left:5px; }

    .dyn-acct .da-main { min-width:0; }
    .dyn-acct .da-panel { display:none; }
    .dyn-acct .da-panel.is-active { display:block; animation:daFade .25s ease; }
    @keyframes daFade { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:none} }
    .dyn-acct .da-h { font-size:26px; font-weight:600; letter-spacing:-0.02em; margin:0 0 4px; }
    .dyn-acct .da-sub { color:var(--ink-faint); font-size:14px; margin:0 0 22px; }
    .dyn-acct .da-empty { padding:40px 22px; text-align:center; color:var(--ink-faint); font-size:15px; background:var(--panel); border-radius:16px; }

    /* Cards / lists */
    .dyn-acct .da-card { border:1px solid var(--line); border-radius:16px; padding:18px 20px; margin-bottom:14px; }
    .dyn-acct .da-row { display:flex; justify-content:space-between; align-items:flex-start; gap:14px; flex-wrap:wrap; }
    .dyn-acct .da-order-no { font-weight:600; font-size:16px; }
    .dyn-acct .da-order-meta { color:var(--ink-faint); font-size:13px; margin-top:2px; }
    .dyn-acct .da-badge { display:inline-block; font-size:12px; font-weight:600; padding:3px 10px; border-radius:999px; background:var(--panel); color:var(--ink-soft); }
    .dyn-acct .da-badge.paid { background:#e7f6ec; color:var(--ok); }
    .dyn-acct .da-badge.pending { background:#fff4e5; color:#b26a00; }
    .dyn-acct .da-badge.fulfilled { background:#e7f0fb; color:#0a6ebd; }
    .dyn-acct .da-items { margin-top:12px; padding-top:12px; border-top:1px solid var(--line-soft); font-size:14px; color:var(--ink-soft); display:flex; flex-wrap:wrap; gap:6px 14px; }
    .dyn-acct .da-total { font-weight:600; }
    .dyn-acct .da-link { color:var(--accent); text-decoration:none; font-size:14px; font-weight:500; }
    .dyn-acct .da-link:hover { text-decoration:underline; }
    .dyn-acct .da-odtoggle { margin-top:12px; border:0; background:none; padding:0; cursor:pointer; font:inherit; font-size:14px; font-weight:500; color:var(--accent); }
    .dyn-acct .da-odtoggle:hover { text-decoration:underline; }
    .dyn-acct .da-oddetail { margin-top:14px; padding-top:14px; border-top:1px solid var(--line-soft); }
    .dyn-acct .da-oi { display:flex; gap:12px; align-items:flex-start; padding:10px 0; border-bottom:1px solid var(--line-soft); }
    .dyn-acct .da-oi-img { width:56px; height:56px; flex:none; border-radius:10px; overflow:hidden; background:var(--panel); }
    .dyn-acct .da-oi-img img { width:100%; height:100%; object-fit:cover; }
    .dyn-acct .da-oi-main { flex:1 1 auto; min-width:0; font-size:14px; }
    .dyn-acct .da-oi-title { font-weight:500; }
    .dyn-acct .da-oi-variant { color:var(--ink-faint); font-size:13px; margin-top:2px; }
    .dyn-acct .da-oi-prop { color:var(--ink-soft); font-size:13px; margin-top:3px; word-break:break-word; }
    .dyn-acct .da-oi-price { flex:none; font-size:14px; font-weight:500; }
    .dyn-acct .da-odtot { margin-top:12px; font-size:14px; }
    .dyn-acct .da-odtot > div { display:flex; justify-content:space-between; padding:4px 0; color:var(--ink-soft); }
    .dyn-acct .da-odtot-total { border-top:1px solid var(--line-soft); margin-top:4px; padding-top:8px !important; color:var(--ink) !important; font-weight:600; }
    .dyn-acct .da-odblock { margin-top:14px; }
    .dyn-acct .da-odblock-h { font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-faint); margin-bottom:5px; }
    .dyn-acct .da-odblock-b { font-size:14px; color:var(--ink-soft); line-height:1.55; }

    .dyn-acct .da-btn { display:inline-flex; align-items:center; justify-content:center; height:42px; padding:0 20px; border-radius:999px; background:var(--ink); color:#fff; border:0; font:inherit; font-size:14px; font-weight:500; cursor:pointer; text-decoration:none; }
    .dyn-acct .da-btn:hover { opacity:.9; }
    .dyn-acct .da-btn.ghost { background:none; color:var(--ink); border:1px solid var(--line); }
    .dyn-acct .da-btn.ghost:hover { border-color:var(--ink); opacity:1; }
    .dyn-acct .da-btn.sm { height:34px; padding:0 14px; font-size:13px; }
    .dyn-acct .da-btn.danger { color:var(--danger); background:none; border:1px solid var(--line); }
    .dyn-acct .da-btn.danger:hover { border-color:var(--danger); }

    .dyn-acct .da-track { display:flex; align-items:center; gap:6px; }
    .dyn-acct .da-track svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:1.7; }

    /* Grid tabs (wishlist / designs) */
    .dyn-acct .da-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:18px; }
    .dyn-acct .da-tile { border:1px solid var(--line); border-radius:16px; overflow:hidden; display:flex; flex-direction:column; }
    .dyn-acct .da-tile-img { aspect-ratio:1/1; background:var(--panel); position:relative; display:block; }
    .dyn-acct .da-tile-img img { width:100%; height:100%; object-fit:cover; }
    .dyn-acct .da-tile-b { padding:12px 14px 14px; display:flex; flex-direction:column; gap:6px; flex:1; }
    .dyn-acct .da-tile-name { font-size:14px; font-weight:500; color:var(--ink); text-decoration:none; }
    .dyn-acct .da-tile-name:hover { color:var(--accent); }
    .dyn-acct .da-tile-price { font-size:13px; color:var(--ink-soft); }
    .dyn-acct .da-tile-actions { margin-top:auto; display:flex; gap:8px; padding-top:8px; }
    .dyn-acct .da-x { background:none; border:0; color:var(--ink-faint); cursor:pointer; font:inherit; font-size:13px; padding:2px; text-decoration:underline; }
    .dyn-acct .da-x:hover { color:var(--danger); }

    /* Address forms */
    .dyn-acct .da-addr { border:1px solid var(--line); border-radius:16px; padding:18px 20px; margin-bottom:14px; }
    .dyn-acct .da-addr.def { border-color:var(--accent); }
    .dyn-acct .da-addr p { margin:0; font-size:14px; line-height:1.5; color:var(--ink-soft); }
    .dyn-acct .da-addr .nm { color:var(--ink); font-weight:600; font-size:15px; }
    .dyn-acct .da-addr-actions { margin-top:12px; display:flex; gap:10px; flex-wrap:wrap; }
    .dyn-acct .da-form { border:1px solid var(--line); border-radius:16px; padding:20px; margin-bottom:16px; }
    .dyn-acct .da-form[hidden] { display:none; }
    .dyn-acct .da-field { margin-bottom:12px; }
    .dyn-acct .da-field label { display:block; font-size:13px; font-weight:500; margin-bottom:5px; color:var(--ink-soft); }
    .dyn-acct .da-field input, .dyn-acct .da-field select, .dyn-acct .da-field textarea {
      width:100%; box-sizing:border-box; border:1px solid var(--line); border-radius:10px; padding:10px 12px; font:inherit; font-size:14px; background:#fff; color:var(--ink); }
    .dyn-acct .da-field input:focus, .dyn-acct .da-field select:focus, .dyn-acct .da-field textarea:focus { outline:none; border-color:var(--accent); }
    .dyn-acct .da-2col { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .dyn-acct .da-check { display:flex; align-items:center; gap:8px; font-size:14px; color:var(--ink-soft); margin:6px 0 14px; }
    .dyn-acct .da-check input { width:auto; }
    .dyn-acct .da-form-actions { display:flex; gap:10px; align-items:center; }

    .dyn-acct .da-note { font-size:14px; color:var(--ink-soft); line-height:1.6; }
    .dyn-acct .da-rvmore { display:block; width:100%; margin-top:6px; padding:12px; border:1px solid var(--line); border-radius:12px; background:none; color:var(--ink-soft); font:inherit; font-size:14px; font-weight:500; cursor:pointer; transition:border-color .15s, color .15s; }
    .dyn-acct .da-rvmore:hover { border-color:var(--ink); color:var(--ink); }
    .dyn-acct .da-rv-stars { color:#f5b301; letter-spacing:1px; }

    .dyn-acct .da-guest { max-width:520px; margin:80px auto; text-align:center; padding:40px 22px; }
    .dyn-acct .da-guest h2 { font-size:24px; margin:0 0 10px; }
    .dyn-acct .da-guest a.da-btn { margin-top:18px; }

    @media (max-width:820px) {
      .dyn-acct .da-wrap { grid-template-columns:1fr; gap:8px; }
      .dyn-acct .da-nav { position:static; flex-direction:row; overflow-x:auto; gap:4px; padding-bottom:8px; margin-bottom:12px; border-bottom:1px solid var(--line-soft); }
      .dyn-acct .da-idbar { display:none; }
      .dyn-acct .da-tab, .dyn-acct .da-navlink { white-space:nowrap; flex:none; }
      .dyn-acct .da-logout { display:none; }
      .dyn-acct .da-2col { grid-template-columns:1fr; }
    }
  </style>

  {%- if section.settings.logo != blank or section.settings.show_shop_name -%}
    <div class="da-topbar">
      <a class="da-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — home">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_w = section.settings.logo_width | default: 160 -%}
          {%- assign logo_src_w = logo_w | times: 2 -%}
          {%- assign logo_h = section.settings.logo.height | times: logo_w | divided_by: section.settings.logo.width -%}
          <img src="{{ section.settings.logo | image_url: width: logo_src_w }}" alt="{{ shop.name | escape }}" width="{{ logo_w }}" height="{{ logo_h }}" style="max-width:{{ logo_w }}px">
        {%- else -%}
          <span class="da-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>
  {%- endif -%}

  {%- if customer -%}
  <input id="daAvatarFile" type="file" accept="image/*" hidden>
  <div class="da-wrap">
    <aside class="da-nav">
      <div class="da-idbar">
        <button type="button" class="da-avatar da-avatar-btn" id="daAvatarSide" title="Change photo" aria-label="Change profile photo"><span class="da-avatar-fb">{{ customer.first_name | default: customer.name | default: 'U' | slice: 0 | upcase }}</span><span class="da-avatar-cam" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.2"/></svg></span></button>
        <div class="da-hi">Hi, {{ customer.first_name | default: customer.name | default: 'there' }}</div>
      </div>
      <a class="da-navlink" href="https://shopify.com/{{ shop.id }}/account/orders" title="Opens your Shopify orders page">Orders <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg></a>
      <button type="button" class="da-tab is-active" data-tab="wishlist">Wishlist</button>
      <button type="button" class="da-tab" data-tab="designs">Saved Designs</button>
      <button type="button" class="da-tab" data-tab="reviews">Reviews</button>
      <a class="da-navlink" href="https://shopify.com/{{ shop.id }}/account/profile" title="Opens your Shopify profile page">Profile <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg></a>
      <a class="da-logout" href="{{ routes.account_logout_url }}">Log out</a>
    </aside>

    <div class="da-main">

      {%- comment -%} ---------- WISHLIST ---------- {%- endcomment -%}
      <div class="da-panel is-active" data-panel="wishlist">
        <h1 class="da-h">Wishlist</h1>
        <p class="da-sub">Products you saved with the ♡ / bookmark button.</p>
        <div id="daWish"></div>
      </div>

      {%- comment -%} ---------- SAVED DESIGNS (the custom designs from past orders) ---------- {%- endcomment -%}
      <div class="da-panel" data-panel="designs">
        <h1 class="da-h">Saved Designs</h1>
        <p class="da-sub">The custom designs from your orders — order any of them again.</p>
        {%- capture design_cards -%}
          {%- for order in customer.orders -%}
            {%- for line in order.line_items -%}
              {%- assign preview_url = '' -%}
              {%- for prop in line.properties -%}
                {%- assign pn = prop.first | downcase -%}
                {%- if pn contains 'preview' -%}
                  {%- assign pv = prop.last -%}
                  {%- if pv contains 'http' and preview_url == '' -%}{%- assign preview_url = pv -%}{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if preview_url != '' -%}
                {%- if line.product -%}{%- assign purl = line.product.url -%}{%- else -%}{%- assign purl = order.customer_url -%}{%- endif -%}
                <div class="da-tile">
                  <a class="da-tile-img" href="{{ purl }}"><img src="{{ preview_url }}" alt="{{ line.title | escape }}" width="600" height="600" loading="lazy"></a>
                  <div class="da-tile-b">
                    <a class="da-tile-name" href="{{ purl }}">{{ line.title }}</a>
                    <div class="da-tile-price">{{ order.name }} · {{ order.created_at | date: "%b %-d, %Y" }}</div>
                    <div class="da-tile-actions"><a class="da-btn sm" href="{{ purl }}">Order again</a></div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign design_cards_trim = design_cards | strip -%}
        {%- if design_cards_trim != '' -%}
          <div class="da-grid">{{ design_cards }}</div>
        {%- else -%}
          <div class="da-empty">Your custom designs from past orders will show up here.</div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- REVIEWS ---------- {%- endcomment -%}
      <div class="da-panel" data-panel="reviews">
        <h1 class="da-h">Reviews</h1>
        <p class="da-sub">Products you’ve ordered — leave a review, or see the one you wrote.</p>
        <script type="application/json" id="daPurchased">
        [
          {%- assign seen_products = '' -%}{%- assign first_p = true -%}
          {%- for order in customer.orders -%}
            {%- for line in order.line_items -%}
              {%- comment -%} Skip add-on/fee lines (gift wrapping, back-print fee) — they carry a _For marker and aren't reviewable products. {%- endcomment -%}
              {%- if line.product and line.product.id and line.properties["_For"] == blank -%}
                {%- assign pkey = '|' | append: line.product.id | append: '|' -%}
                {%- unless seen_products contains pkey -%}
                  {%- assign seen_products = seen_products | append: pkey -%}
                  {%- unless first_p %},{% endunless %}{%- assign first_p = false -%}
                  {"handle": {{ line.product.handle | json }}, "title": {{ line.product.title | json }}, "url": {{ line.product.url | json }}, "image": {% if line.product.featured_image %}{{ line.product.featured_image | image_url: width: 160 | json }}{% else %}""{% endif %}}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        ]
        </script>
        <div id="daReviews"></div>
      </div>

    </div>
  </div>
  {%- else -%}
  <div class="da-guest">
    <h2>Your account</h2>
    <p class="da-note">Please log in to see your orders, wishlist, addresses and more.</p>
    <a class="da-btn" href="{{ routes.account_login_url }}">Log in</a>
  </div>
  {%- endif -%}

  <script>
  (function () {
    var root = document.getElementById("dynAcct");
    if (!root) return;

    /* ---- Tabs (with #hash deep-linking) ---- */
    var tabs = root.querySelectorAll(".da-tab"), panels = root.querySelectorAll(".da-panel");
    function show(name) {
      var found = false;
      tabs.forEach(function (t) { var on = t.getAttribute("data-tab") === name; t.classList.toggle("is-active", on); if (on) found = true; });
      panels.forEach(function (p) { p.classList.toggle("is-active", p.getAttribute("data-panel") === name); });
      return found;
    }
    tabs.forEach(function (t) { t.addEventListener("click", function () { var n = t.getAttribute("data-tab"); show(n); try { history.replaceState(null, "", "#" + n); } catch (e) {} }); });
    function paramTab() { var m = (location.search || "").match(/[?&]tab=([^&]+)/); return m ? decodeURIComponent(m[1]) : ""; }
    var initial = paramTab() || (location.hash || "").replace("#", "");
    if (initial) show(initial);
    window.addEventListener("hashchange", function () { var n = (location.hash || "").replace("#", ""); if (n) show(n); });

    /* ---- Profile photo (avatar) — upload, shrink, store on this device ---- */
    var AVA_KEY = "dyn_avatar";
    var avaEls = [document.getElementById("daAvatarSide"), document.getElementById("daAvatarBig")];
    avaEls.forEach(function (el) { if (el) el.addEventListener("click", function () { var f = document.getElementById("daAvatarFile"); if (f) f.click(); }); });
    var avaFile = document.getElementById("daAvatarFile"), avaRemove = document.getElementById("daAvatarRemove"), avaNote = document.getElementById("daAvatarNote");
    function paintAvatar() {
      var url = ""; try { url = localStorage.getItem(AVA_KEY) || ""; } catch (e) {}
      avaEls.forEach(function (el) {
        if (!el) return;
        var fb = el.querySelector(".da-avatar-fb"), img = el.querySelector("img");
        if (url) { if (!img) { img = document.createElement("img"); img.alt = "Profile photo"; el.appendChild(img); } img.src = url; if (fb) fb.style.display = "none"; }
        else { if (img) img.remove(); if (fb) fb.style.display = ""; }
      });
      if (avaRemove) avaRemove.hidden = !url;
    }
    function shrinkImg(dataUrl, max, cb) {
      var im = new Image();
      im.onload = function () {
        var scale = Math.min(1, max / Math.max(im.naturalWidth || max, im.naturalHeight || max));
        var w = Math.max(1, Math.round((im.naturalWidth || max) * scale)), h = Math.max(1, Math.round((im.naturalHeight || max) * scale));
        var c = document.createElement("canvas"); c.width = w; c.height = h;
        c.getContext("2d").drawImage(im, 0, 0, w, h);
        try { cb(c.toDataURL("image/jpeg", 0.85)); } catch (e) { cb(dataUrl); }
      };
      im.onerror = function () { cb(dataUrl); };
      im.src = dataUrl;
    }
    if (avaFile) avaFile.addEventListener("change", function () {
      var f = avaFile.files && avaFile.files[0]; if (!f) return;
      if (!/^image\//.test(f.type)) { if (avaNote) avaNote.textContent = "Please choose an image file."; return; }
      var rd = new FileReader();
      rd.onload = function () {
        shrinkImg(String(rd.result), 320, function (small) {
          try { localStorage.setItem(AVA_KEY, small); paintAvatar(); if (avaNote) avaNote.textContent = "Saved on this device."; }
          catch (e) { if (avaNote) avaNote.textContent = "Couldn’t save — please try a smaller image."; }
        });
      };
      rd.readAsDataURL(f);
      avaFile.value = "";
    });
    if (avaRemove) avaRemove.addEventListener("click", function () { try { localStorage.removeItem(AVA_KEY); } catch (e) {} paintAvatar(); if (avaNote) avaNote.textContent = "Saved on this device."; });
    paintAvatar();

    /* ---- helpers ---- */
    function jget(k, d) { try { var v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch (e) { return d; } }
    function jset(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
    function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    function stars(n) { n = Math.max(0, Math.min(5, Math.round(n))); return "★★★★★".slice(0, n) + "☆☆☆☆☆".slice(0, 5 - n); }

    /* ---- Wishlist tab (reads the shared dyn_wishlist) ---- */
    var wishEl = document.getElementById("daWish");
    function renderWish() {
      if (!wishEl) return;
      var list = jget("dyn_wishlist", []);
      if (!Array.isArray(list) || !list.length) { wishEl.innerHTML = '<div class="da-empty">Your wishlist is empty. Tap the bookmark on any product to save it here.</div>'; return; }
      wishEl.innerHTML = '<div class="da-grid">' + list.map(function (it) {
        var url = esc(it.url || "#");
        return '<div class="da-tile"><a class="da-tile-img" href="' + url + '">' + (it.image ? '<img src="' + esc(it.image) + '" alt="" loading="lazy">' : '') + '</a>' +
          '<div class="da-tile-b"><a class="da-tile-name" href="' + url + '">' + esc(it.title || "Product") + '</a>' +
          (it.price ? '<div class="da-tile-price">' + esc(it.price) + '</div>' : '') +
          '<div class="da-tile-actions"><a class="da-btn sm" href="' + url + '">View</a><button type="button" class="da-x" data-wish="' + esc(it.id) + '">Remove</button></div></div></div>';
      }).join("") + '</div>';
    }
    if (wishEl) wishEl.addEventListener("click", function (e) {
      var b = e.target.closest ? e.target.closest("[data-wish]") : null; if (!b) return;
      var id = b.getAttribute("data-wish");
      jset("dyn_wishlist", jget("dyn_wishlist", []).filter(function (x) { return String(x.id) !== String(id); }));
      try { window.dispatchEvent(new CustomEvent("dyn-wishlist-change")); } catch (e2) {}
      renderWish();
    });
    window.addEventListener("dyn-wishlist-change", renderWish);
    renderWish();

    /* Saved Designs are rendered server-side from the customer's past orders. */

    /* ---- Reviews tab — lists purchased products; prompt to review, or show the
       review they wrote (from dyn_myreviews, saved when they post a review). ---- */
    var rvEl = document.getElementById("daReviews");
    var RV_PAGE = 6, rvExpanded = false;
    function rvCard(p) {
      var r = myReview(p.handle), done = jget("dyn_rvdone_" + p.handle, false) === true;
      var url = esc(p.url || "#");
      var thumb = p.image ? '<a href="' + url + '" style="flex:none"><img src="' + esc(p.image) + '" alt="" style="width:52px;height:52px;border-radius:10px;object-fit:cover"></a>' : '';
      var meta = r ? '<div class="da-order-meta"><span class="da-rv-stars">' + stars(r.rating || 5) + '</span>' + (r.t ? ' · ' + new Date(r.t).toLocaleDateString() : '') + '</div>' : '';
      var action;
      if (r) { action = ''; }
      else if (done) { action = '<a class="da-link" href="' + url + '#igSocial">View your review →</a>'; }
      else { action = '<a class="da-btn sm" href="' + url + '?review=1">Write a review</a>'; }
      return '<div class="da-card">' +
        '<div class="da-row" style="align-items:center; gap:14px">' +
          '<div style="display:flex; align-items:center; gap:12px; min-width:0">' + thumb +
            '<div style="min-width:0"><a class="da-tile-name" href="' + url + '">' + esc(p.title || "Product") + '</a>' + meta + '</div>' +
          '</div>' +
          (action ? '<div style="flex:none">' + action + '</div>' : '') +
        '</div>' +
        (r && r.text ? '<div class="da-items" style="border-top:1px solid var(--line-soft); margin-top:12px; padding-top:12px">' + esc(r.text) + '</div>' : '') +
      '</div>';
    }
    var mine = [];
    function myReview(h) { for (var i = 0; i < mine.length; i++) { if (mine[i].handle === h) return mine[i]; } return null; }
    function renderReviews() {
      if (!rvEl) return;
      var purchased = []; try { purchased = JSON.parse((document.getElementById("daPurchased") || {}).textContent || "[]"); } catch (e) {}
      if (!Array.isArray(purchased)) purchased = [];
      mine = jget("dyn_myreviews", []); if (!Array.isArray(mine)) mine = [];
      if (!purchased.length) { rvEl.innerHTML = '<div class="da-empty">Products you’ve ordered will appear here so you can review them.</div>'; return; }
      var visible = rvExpanded ? purchased : purchased.slice(0, RV_PAGE);
      var html = visible.map(rvCard).join("");
      if (purchased.length > RV_PAGE) {
        html += '<button type="button" class="da-rvmore" id="daRvMore">' + (rvExpanded ? "Show less" : ("Show more (" + (purchased.length - RV_PAGE) + ")")) + '</button>';
      }
      rvEl.innerHTML = html;
      var moreBtn = document.getElementById("daRvMore");
      if (moreBtn) moreBtn.onclick = function () { rvExpanded = !rvExpanded; renderReviews(); };
    }
    renderReviews();
  })();
  </script>
</section>

{% schema %}
{
  "name": "Dynamic Account",
  "tag": "section",
  "class": "dynamic-account-section",
  "settings": [
    { "type": "paragraph", "content": "A tabbed account dashboard. Wishlist, Saved Designs and Reviews are in-page tabs; Orders and Profile link out to Shopify’s native account pages (order details, tracking, name, email, addresses). Add it to a page (e.g. a page called “Account” → /pages/account) and point your account link there. The shopper must be logged in." },

    { "type": "header", "content": "Logo (top of page)" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Shown at the top, linked to your home page. Leave empty to show your store name as text (if turned on below)." },
    { "type": "range", "id": "logo_width", "min": 80, "max": 320, "step": 10, "unit": "px", "label": "Logo width", "default": 160 },
    { "type": "checkbox", "id": "show_shop_name", "label": "Show store name when no logo is set", "default": true },

    { "type": "color", "id": "page_bg", "label": "Page background", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Dynamic Account" } ],
  "enabled_on": { "templates": ["page", "customers/account"] }
}
{% endschema %}
