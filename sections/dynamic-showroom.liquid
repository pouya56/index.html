{% comment %}
  ============================================================================
  Dynamic Showroom — a visionOS-style "spatial" shopping room.
  ----------------------------------------------------------------------------
  A warm room backdrop with floating liquid-glass panes: category tabs on top,
  a product shelf in the middle (the selected piece front and centre, its
  neighbours fading away to the sides), and a detail bar below with the price,
  Add to cart, Checkout and a link to personalize.

  INSTALL:
  1. Edit code > Sections > Add a new section > name it "dynamic-showroom" and
     REPLACE its contents with this whole file. Save.
  2. Online Store > Pages > Add page > title "Showroom" (any name). Save.
  3. Customize > open that page > Add section > "Dynamic Showroom".
  4. In the section settings pick the collection to show. Done.
  ============================================================================
{% endcomment %}

<style>
  .dyn-spa { position: relative; min-height: 100dvh; overflow: hidden; color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    background:
      radial-gradient(120% 90% at 82% 10%, rgba(255, 214, 150, 0.5), rgba(255, 214, 150, 0) 55%),
      radial-gradient(90% 70% at 12% 24%, rgba(112, 130, 120, 0.45), rgba(112, 130, 120, 0) 60%),
      linear-gradient(180deg, #6d5f4e 0%, #7d6d59 34%, #8d7c65 55%, #4e4034 72%, #2f2820 100%); }
  .dyn-spa, .dyn-spa *, .dyn-spa *::before, .dyn-spa *::after { box-sizing: border-box; }
  /* Optional photo backdrop (settings) sits under a warm wash so glass still reads. */
  .dyn-spa .spa-bgimg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dyn-spa .spa-bgimg + .spa-wash { position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(60, 48, 36, 0.25), rgba(24, 19, 14, 0.45)); }
  /* CSS room (used when no photo is picked): window light, floor, plant. */
  .dyn-spa .spa-win { position: absolute; width: 150px; height: 46%; border-radius: 10px;
    background: linear-gradient(180deg, #ffdf9e, #f7b45f 70%, #c97e3f); filter: blur(2px); opacity: 0.8; }
  .dyn-spa .spa-win.w1 { right: 3%; top: 8%; transform: perspective(700px) rotateY(-24deg); }
  .dyn-spa .spa-win.w2 { right: 14%; top: 10%; height: 40%; width: 110px; transform: perspective(700px) rotateY(-18deg); opacity: 0.55; }
  .dyn-spa .spa-win.w3 { left: -30px; top: 11%; height: 38%; width: 120px; transform: perspective(700px) rotateY(22deg); opacity: 0.4; }
  .dyn-spa .spa-floor { position: absolute; left: 0; right: 0; bottom: 0; height: 26%;
    background: repeating-linear-gradient(90deg, #55402e 0 90px, #4a3728 90px 92px),
      linear-gradient(180deg, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.55)); background-blend-mode: multiply; }
  .dyn-spa .spa-rug { position: absolute; left: 50%; bottom: 2%; transform: translateX(-50%) perspective(600px) rotateX(55deg);
    width: 900px; max-width: 120vw; height: 240px; border-radius: 30px; background: #83755f; opacity: 0.5; filter: blur(3px); }
  .dyn-spa .spa-plant { position: absolute; right: 6%; bottom: 14%; width: 190px; height: 300px; filter: blur(1.5px); opacity: 0.9; }
  /* ---- glass helper ---- */
  .dyn-spa .spa-glass { background: rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(26px) saturate(1.7) brightness(1.06);
    backdrop-filter: blur(26px) saturate(1.7) brightness(1.06);
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.45); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .dyn-spa .spa-glass { background: rgba(80, 70, 58, 0.88); } }
  .dyn-spa .spa-brand { position: absolute; left: 42px; top: 30px; z-index: 4;
    font: 700 15px/1 inherit; letter-spacing: 0.22em; opacity: 0.85; }
  /* Category tabs */
  .dyn-spa .spa-seg { position: absolute; top: 26px; left: 50%; transform: translateX(-50%); z-index: 4;
    display: flex; gap: 4px; padding: 6px; border-radius: 999px; max-width: min(92vw, 720px);
    overflow-x: auto; scrollbar-width: none; }
  .dyn-spa .spa-seg::-webkit-scrollbar { display: none; }
  .dyn-spa .spa-seg button { border: 0; cursor: pointer; background: none; color: rgba(255, 255, 255, 0.85);
    font: 600 13.5px/1 inherit; font-family: inherit; padding: 11px 18px; border-radius: 999px; white-space: nowrap;
    transition: background 0.15s; }
  .dyn-spa .spa-seg button.is-on { background: rgba(255, 255, 255, 0.28); color: #fff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 4px 14px -6px rgba(0, 0, 0, 0.4); }
  /* Main pane */
  .dyn-spa .spa-pane { position: absolute; left: 50%; top: 96px; transform: translateX(-50%); z-index: 3;
    width: min(92vw, 880px); height: min(62dvh, 540px); border-radius: 30px; }
  .dyn-spa .spa-shelf { position: absolute; inset: 24px 0 0 0;
    display: flex; align-items: center; justify-content: center; gap: 40px; }
  .dyn-spa .spa-slot { text-align: center; border: 0; background: none; padding: 0; color: #fff;
    font-family: inherit; cursor: pointer; transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .dyn-spa .spa-slot[hidden] { display: none; }
  .dyn-spa .spa-slot img { display: block; margin: 0 auto; object-fit: contain;
    filter: drop-shadow(0 22px 26px rgba(0, 0, 0, 0.4)); border-radius: 18px; }
  .dyn-spa .spa-slot .spa-nm { display: block; margin-top: 14px; font: 600 14px/1.3 inherit; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35); }
  .dyn-spa .spa-slot .spa-pr { display: block; margin-top: 5px; font: 700 16px/1 inherit; }
  .dyn-spa .spa-slot.is-hero { cursor: default; }
  .dyn-spa .spa-slot.is-hero img { width: 250px; height: 250px; }
  .dyn-spa .spa-slot.is-hero .spa-nm { font-size: 16px; }
  .dyn-spa .spa-slot.is-hero .spa-pr { font-size: 19px; }
  .dyn-spa .spa-slot.is-side { opacity: 0.92; transform: translateY(6px) scale(0.86); }
  .dyn-spa .spa-slot.is-side img { width: 160px; height: 160px; }
  .dyn-spa .spa-slot.is-side:hover { opacity: 1; transform: translateY(2px) scale(0.9); }
  .dyn-spa .spa-slot.is-edge { opacity: 0.5; transform: scale(0.68); margin: 0 -52px; }
  .dyn-spa .spa-slot.is-edge img { width: 140px; height: 140px; }
  .dyn-spa .spa-slot.is-edge .spa-nm, .dyn-spa .spa-slot.is-edge .spa-pr { display: none; }
  .dyn-spa .spa-slot.is-edge:hover { opacity: 0.75; }
  .dyn-spa .spa-slot.is-swap { opacity: 0; transform: scale(0.9); transition: none; }
  /* Shelf arrows (mid-height, like the product gallery) */
  .dyn-spa .spa-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5;
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(14px) saturate(1.5); backdrop-filter: blur(14px) saturate(1.5);
    color: #fff; font-size: 22px; line-height: 1; display: grid; place-items: center; cursor: pointer;
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.4); transition: background 0.15s, transform 0.15s; }
  .dyn-spa .spa-arrow:hover { background: rgba(255, 255, 255, 0.32); transform: translateY(-50%) scale(1.07); }
  .dyn-spa .spa-prev { left: 10px; } .dyn-spa .spa-next { right: 10px; }
  /* Top row of the pane */
  .dyn-spa .spa-panetop { position: absolute; top: 0; left: 0; right: 0; z-index: 4;
    display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; }
  .dyn-spa .spa-chip { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.3); font: 600 12.5px/1 inherit; }
  .dyn-spa .spa-chip .spa-dot { width: 9px; height: 9px; border-radius: 50%;
    background: conic-gradient(from 0deg, #4f8cff, #a06bff, #ff5ea8, #ff9d5e, #4f8cff); }
  .dyn-spa .spa-actions { display: flex; gap: 8px; }
  .dyn-spa .spa-pill { display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35); background: rgba(255, 255, 255, 0.2);
    font: 600 13px/1 inherit; font-family: inherit; color: #fff; cursor: pointer; text-decoration: none;
    transition: background 0.15s, transform 0.1s; }
  .dyn-spa .spa-pill:hover { background: rgba(255, 255, 255, 0.32); }
  .dyn-spa .spa-pill:active { transform: scale(0.97); }
  .dyn-spa .spa-pill.is-dark { background: rgba(20, 20, 22, 0.55); }
  .dyn-spa .spa-pill.is-dark:hover { background: rgba(20, 20, 22, 0.75); }
  .dyn-spa .spa-pill svg { width: 15px; height: 15px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .dyn-spa .spa-pill.is-ok { background: rgba(26, 127, 55, 0.85); }
  /* Detail bar */
  .dyn-spa .spa-detail { position: absolute; left: 50%; bottom: 34px; transform: translateX(-50%); z-index: 4;
    width: min(92vw, 520px); border-radius: 22px; padding: 16px 18px 14px; }
  .dyn-spa .spa-d1 { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font: 700 17px/1.25 inherit; }
  .dyn-spa .spa-d1 .spa-dtitle { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dyn-spa .spa-d2 { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
  .dyn-spa .spa-open { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px 14px; border-radius: 12px; background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22); font: 600 13px/1 inherit; color: #fff; text-decoration: none;
    transition: background 0.15s; }
  .dyn-spa .spa-open:hover { background: rgba(255, 255, 255, 0.26); }
  .dyn-spa .spa-empty { position: absolute; inset: 0; display: none; place-items: center; z-index: 2;
    font: 500 15px/1.6 inherit; color: rgba(255, 255, 255, 0.85); text-align: center; padding: 20px; }
  .dyn-spa.is-empty .spa-empty { display: grid; }
  .dyn-spa.is-empty .spa-shelf, .dyn-spa.is-empty .spa-arrow { display: none; }
  /* Phone */
  @media (max-width: 700px) {
    .dyn-spa .spa-brand { left: 18px; top: 20px; font-size: 12px; }
    .dyn-spa .spa-seg { top: 54px; }
    .dyn-spa .spa-pane { top: 116px; width: 94vw; height: min(58dvh, 460px); }
    .dyn-spa .spa-panetop { padding: 12px; }
    .dyn-spa .spa-chip { display: none; }
    .dyn-spa .spa-slot.is-edge, .dyn-spa .spa-slot.is-side { display: none; }
    .dyn-spa .spa-slot.is-hero img { width: 210px; height: 210px; }
    .dyn-spa .spa-shelf { gap: 18px; inset: 70px 0 0 0; }
    .dyn-spa .spa-detail { bottom: 18px; }
    .dyn-spa .spa-plant { display: none; }
  }
</style>

{%- assign spa_coll = section.settings.collection -%}
<section class="dyn-spa" id="dynSpa-{{ section.id }}">
  {%- if section.settings.bg_image != blank -%}
    {%- assign spa_bgh = 2200 | divided_by: section.settings.bg_image.aspect_ratio | round -%}
    <img class="spa-bgimg" src="{{ section.settings.bg_image | image_url: width: 2200 }}" alt="" loading="lazy" width="2200" height="{{ spa_bgh }}">
    <span class="spa-wash"></span>
  {%- else -%}
    <span class="spa-win w1"></span><span class="spa-win w2"></span><span class="spa-win w3"></span>
    <span class="spa-floor"></span><span class="spa-rug"></span>
    <svg class="spa-plant" viewBox="0 0 190 300" aria-hidden="true">
      <g fill="#2e4432">
        <path d="M95 300 C95 200 60 150 20 130 C70 130 95 180 95 230 Z"/>
        <path d="M95 300 C95 190 130 140 175 125 C125 130 98 185 96 235 Z"/>
        <path d="M92 300 C88 170 70 90 40 55 C85 80 100 180 98 260 Z"/>
        <path d="M98 300 C102 160 120 80 158 48 C115 80 100 175 99 255 Z"/>
        <path d="M95 300 C95 140 95 70 95 20 C104 80 104 200 100 300 Z"/>
      </g>
      <rect x="60" y="268" width="70" height="34" rx="8" fill="#7a4d33"/>
    </svg>
  {%- endif -%}

  <div class="spa-brand">{{ section.settings.brand_text | default: shop.name | upcase }}</div>

  <div class="spa-seg spa-glass" id="spaSeg-{{ section.id }}">
    <button type="button" class="is-on" data-cat="">All</button>
    {%- assign spa_types = "" -%}
    {%- if spa_coll != blank -%}
      {%- for p in spa_coll.products limit: 48 -%}
        {%- if p.type != blank -%}
          {%- assign tkey = "|" | append: p.type | append: "|" -%}
          {%- unless spa_types contains tkey -%}
            {%- assign spa_types = spa_types | append: tkey -%}
            <button type="button" data-cat="{{ p.type | escape }}">{{ p.type }}</button>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="spa-pane spa-glass">
    <div class="spa-panetop">
      <span class="spa-chip"><span class="spa-dot"></span> {{ section.settings.chip_text | default: 'Made yours' }}</span>
      <div class="spa-actions">
        <button type="button" class="spa-pill" id="spaAdd-{{ section.id }}">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="20" r="1.6"/><circle cx="17" cy="20" r="1.6"/><path d="M3 4h2.4l2.2 12h10.8l2-8H7"/></svg>
          <span>Add to cart</span>
        </button>
        <a class="spa-pill is-dark" href="/checkout">
          <svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg> Checkout
        </a>
      </div>
    </div>
    <div class="spa-empty">Nothing here yet — pick a collection in the section settings.</div>
    <div class="spa-shelf" id="spaShelf-{{ section.id }}">
      <button type="button" class="spa-slot is-edge" data-off="-2"><img alt="" width="140" height="140"><span class="spa-nm"></span><span class="spa-pr"></span></button>
      <button type="button" class="spa-slot is-side" data-off="-1"><img alt="" width="160" height="160"><span class="spa-nm"></span><span class="spa-pr"></span></button>
      <div class="spa-slot is-hero"><img alt="" width="250" height="250"><div class="spa-nm"></div><div class="spa-pr"></div></div>
      <button type="button" class="spa-slot is-side" data-off="1"><img alt="" width="160" height="160"><span class="spa-nm"></span><span class="spa-pr"></span></button>
      <button type="button" class="spa-slot is-edge" data-off="2"><img alt="" width="140" height="140"><span class="spa-nm"></span><span class="spa-pr"></span></button>
    </div>
    <button type="button" class="spa-arrow spa-prev" data-off="-1" aria-label="Previous product">&#8249;</button>
    <button type="button" class="spa-arrow spa-next" data-off="1" aria-label="Next product">&#8250;</button>
  </div>

  <div class="spa-detail spa-glass">
    <div class="spa-d1"><span class="spa-dtitle" id="spaTitle-{{ section.id }}">&nbsp;</span><span id="spaPrice-{{ section.id }}"></span></div>
    <div class="spa-d2">
      <a class="spa-open" id="spaOpen-{{ section.id }}" href="#">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        View &amp; personalize
      </a>
    </div>
  </div>

  <script type="application/json" id="spaData-{{ section.id }}">
    [
      {%- if spa_coll != blank -%}
        {%- for p in spa_coll.products limit: 48 -%}
          {
            "t": {{ p.title | json }},
            "pr": {{ p.price | money | strip_html | json }},
            "u": {{ p.url | json }},
            "img": {% if p.featured_image %}{{ p.featured_image | image_url: width: 640 | json }}{% else %}""{% endif %},
            "ty": {{ p.type | default: "" | json }},
            "v": {{ p.selected_or_first_available_variant.id | default: 0 | json }},
            "av": {% if p.available %}true{% else %}false{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- endif -%}
    ]
  </script>
</section>

<script>
(function () {
  var root = document.getElementById("dynSpa-{{ section.id }}");
  if (!root || root.__spaInit) return;
  root.__spaInit = true;
  var all = [];
  try { all = JSON.parse(document.getElementById("spaData-{{ section.id }}").textContent) || []; } catch (e0) {}
  all = all.filter(function (p) { return p.img; });
  var seg = document.getElementById("spaSeg-{{ section.id }}");
  var shelf = document.getElementById("spaShelf-{{ section.id }}");
  var titleEl = document.getElementById("spaTitle-{{ section.id }}");
  var priceEl = document.getElementById("spaPrice-{{ section.id }}");
  var openEl = document.getElementById("spaOpen-{{ section.id }}");
  var addBtn = document.getElementById("spaAdd-{{ section.id }}");
  var slots = Array.prototype.slice.call(shelf.querySelectorAll(".spa-slot"));
  var list = all.slice(), idx = 0;

  function mod(n, m) { return ((n % m) + m) % m; }
  function paint() {
    if (!list.length) { root.classList.add("is-empty"); return; }
    root.classList.remove("is-empty");
    var offs = [-2, -1, 0, 1, 2];
    slots.forEach(function (slot, i) {
      var off = offs[i];
      /* With few products, hide the outer slots instead of repeating items. */
      var need = off === 0 ? 1 : Math.abs(off) * 2 + 1;
      if (list.length < need) { slot.hidden = true; return; }
      slot.hidden = false;
      var p = list[mod(idx + off, list.length)];
      slot.querySelector("img").src = p.img;
      slot.querySelector("img").alt = p.t;
      slot.querySelector(".spa-nm").textContent = p.t;
      slot.querySelector(".spa-pr").textContent = p.pr;
    });
    var cur = list[idx];
    titleEl.textContent = cur.t;
    priceEl.textContent = cur.pr;
    openEl.href = cur.u;
    addBtn.disabled = !cur.av;
    addBtn.querySelector("span").textContent = cur.av ? "Add to cart" : "Sold out";
    addBtn.classList.remove("is-ok");
  }
  function go(delta) {
    if (!list.length) return;
    idx = mod(idx + delta, list.length);
    /* quick swap animation on the shelf */
    slots.forEach(function (s) { s.classList.add("is-swap"); });
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        paint();
        slots.forEach(function (s) { s.classList.remove("is-swap"); });
      });
    });
  }
  root.querySelectorAll("[data-off]").forEach(function (b) {
    b.addEventListener("click", function () { go(parseInt(b.getAttribute("data-off"), 10) || 0); });
  });
  /* Category tabs */
  if (seg) seg.addEventListener("click", function (e) {
    var bt = e.target.closest ? e.target.closest("button[data-cat]") : null;
    if (!bt) return;
    Array.prototype.slice.call(seg.querySelectorAll("button")).forEach(function (b2) {
      b2.classList.toggle("is-on", b2 === bt);
    });
    var cat = bt.getAttribute("data-cat") || "";
    list = cat ? all.filter(function (p) { return p.ty === cat; }) : all.slice();
    idx = 0;
    paint();
  });
  /* Swipe on the shelf */
  var tx = null;
  shelf.addEventListener("touchstart", function (e) { if (e.touches[0]) tx = e.touches[0].clientX; }, { passive: true });
  shelf.addEventListener("touchend", function (e) {
    if (tx === null || !e.changedTouches[0]) { tx = null; return; }
    var dx = e.changedTouches[0].clientX - tx; tx = null;
    if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
  }, { passive: true });
  /* Keyboard */
  document.addEventListener("keydown", function (e) {
    if (e.key === "ArrowRight") go(1);
    else if (e.key === "ArrowLeft") go(-1);
  });
  /* Add the centre product's default variant to the cart. */
  if (addBtn) addBtn.addEventListener("click", function () {
    var cur = list[idx];
    if (!cur || !cur.v) return;
    addBtn.disabled = true;
    fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id: cur.v, quantity: 1 })
    }).then(function (r) {
      addBtn.disabled = false;
      if (!r.ok) throw new Error("add failed");
      addBtn.classList.add("is-ok");
      addBtn.querySelector("span").textContent = "Added ✓";
      setTimeout(function () {
        addBtn.classList.remove("is-ok");
        addBtn.querySelector("span").textContent = "Add to cart";
      }, 1800);
      try { window.dispatchEvent(new CustomEvent("dyn-cart-changed")); } catch (e1) {}
    }).catch(function () {
      addBtn.disabled = false;
      /* Products with required personalization can't be added blind — open the page. */
      location.href = cur.u;
    });
  });
  paint();
})();
</script>

{% schema %}
{
  "name": "Dynamic Showroom",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "A visionOS-style spatial room: floating glass panes, your products on a shelf, category tabs from each product's Type. Pick a collection below." },
    { "type": "collection", "id": "collection", "label": "Collection to show" },
    { "type": "text", "id": "brand_text", "label": "Brand text (top-left)", "info": "Defaults to your shop name." },
    { "type": "text", "id": "chip_text", "label": "Small chip label", "default": "Made yours" },
    { "type": "image_picker", "id": "bg_image", "label": "Room photo (optional)", "info": "Leave empty for the built-in warm room." }
  ],
  "presets": [ { "name": "Dynamic Showroom" } ],
  "enabled_on": { "templates": ["page", "index"] }
}
{% endschema %}
