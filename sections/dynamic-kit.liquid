{% comment %}
  ============================================================================
  Dynamic Kit — build-a-kit page: pick several products, customize each one
  in turn, and check out with everything together.
  ----------------------------------------------------------------------------
  HOW IT WORKS
  The shopper ticks the products they want, hits "Start customizing", and is
  walked through each product page in order — the customizer's kit bar
  advances to the next item after every Add to cart (or Skip). The last item
  lands on the cart with every kit line tagged, ready to purchase together.

  INSTALL:
  1. Edit code > Sections > Add a new section > name it "dynamic-kit" and
     REPLACE its contents with this file. Save.
  2. Create a page (e.g. "Build a kit") with a blank template, or add this
     section to any page: Customize > that page > Add section > "Dynamic Kit".
  3. Pick the collection of kit-eligible products in its settings.
  Requires the dynamic-customizer.js asset (the kit bar lives there).
  ============================================================================
{% endcomment %}

<style>
  .dyn-kit { --ink: #1d1d1f; --ink-soft: #6e6e73; --line: #d2d2d7; --accent: #0071e3; --bg-panel: #f5f5f7;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink); background: var(--bg-panel); padding: 46px 0 120px; }
  .dyn-kit * { box-sizing: border-box; }
  .dyn-kit .dk-wrap { max-width: 1180px; margin: 0 auto; padding: 0 22px; }
  .dyn-kit .dk-head { text-align: center; max-width: 700px; margin: 0 auto 34px; }
  .dyn-kit .dk-head h1 { font-family: var(--font-heading-family, "Cormorant Garamond", Georgia, serif); font-weight: 500;
    font-size: clamp(32px, 5vw, 52px); line-height: 1.05; margin: 0; letter-spacing: -0.01em; }
  .dyn-kit .dk-sub { font-size: 16.5px; color: var(--ink-soft); line-height: 1.55; margin: 12px auto 0; }
  /* Resume banner for a kit already in progress */
  .dyn-kit .dk-resume { display: none; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;
    margin: 0 auto 26px; padding: 13px 18px; max-width: 640px; border-radius: 16px;
    background: #fff; border: 1px solid var(--line); font-size: 14.5px; font-weight: 500; }
  .dyn-kit .dk-resume.is-on { display: flex; }
  .dyn-kit .dk-resume button { appearance: none; border: 0; cursor: pointer; font: inherit; font-weight: 600;
    border-radius: 999px; padding: 9px 16px; }
  .dyn-kit .dk-resume .dk-resume-go { background: #0a0a0a; color: #fff; }
  .dyn-kit .dk-resume .dk-resume-go:hover { background: #000; }
  .dyn-kit .dk-resume .dk-resume-reset { background: none; color: var(--ink-soft); text-decoration: underline; text-underline-offset: 3px; padding: 9px 6px; }
  .dyn-kit .dk-resume .dk-resume-reset:hover { color: var(--ink); }
  /* Product picker grid */
  .dyn-kit .dk-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 15px; }
  @media (max-width: 1100px) { .dyn-kit .dk-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px)  { .dyn-kit .dk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; } }
  .dyn-kit .dk-card { position: relative; display: flex; flex-direction: column; text-align: left; cursor: pointer;
    appearance: none; border: 2px solid transparent; border-radius: 22px; background: #fff; padding: 0; overflow: hidden;
    font-family: inherit; color: inherit; transition: border-color 0.16s, transform 0.16s, box-shadow 0.2s; }
  .dyn-kit .dk-card:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(0, 0, 0, 0.1); }
  .dyn-kit .dk-card.is-sel { border-color: var(--accent); }
  .dyn-kit .dk-media { position: relative; aspect-ratio: 1 / 1; background: #fff; }
  .dyn-kit .dk-media img { position: absolute; inset: 14px; width: calc(100% - 28px); height: calc(100% - 28px);
    object-fit: contain; }
  .dyn-kit .dk-check { position: absolute; top: 12px; right: 12px; width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(255, 255, 255, 0.92); border: 1.5px solid var(--line);
    color: transparent; transition: background 0.15s, border-color 0.15s, color 0.15s; }
  .dyn-kit .dk-card.is-sel .dk-check { background: var(--accent); border-color: var(--accent); color: #fff; }
  .dyn-kit .dk-check svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.6;
    stroke-linecap: round; stroke-linejoin: round; }
  .dyn-kit .dk-body { padding: 14px 16px 16px; }
  .dyn-kit .dk-title { font-size: 15.5px; font-weight: 600; line-height: 1.3; }
  .dyn-kit .dk-price { font-size: 14px; color: var(--ink-soft); margin-top: 4px; }
  /* Sticky start bar */
  .dyn-kit .dk-bar { position: fixed; left: 50%; transform: translateX(-50%); bottom: 18px; z-index: 60;
    display: flex; align-items: center; gap: 16px; padding: 10px 12px 10px 20px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.5); backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.18); font-size: 14.5px; font-weight: 600; white-space: nowrap; }
  .dyn-kit .dk-bar[hidden] { display: none; }
  .dyn-kit .dk-start { appearance: none; border: 0; cursor: pointer; font: inherit; font-weight: 600;
    letter-spacing: 0.02em; border-radius: 999px; padding: 12px 22px; background: #0a0a0a; color: #fff;
    transition: background 0.15s, transform 0.12s, opacity 0.15s; }
  .dyn-kit .dk-start:hover { background: #000; }
  .dyn-kit .dk-start:active { transform: scale(0.97); }
  .dyn-kit .dk-start:disabled { opacity: 0.4; cursor: not-allowed; }
  .dyn-kit .dk-empty { text-align: center; color: var(--ink-soft); padding: 60px 20px; font-size: 16px; }
</style>

{%- assign kit_col = section.settings.collection -%}
{%- assign kit_min = section.settings.min_items | default: 2 -%}

<section class="dyn-kit" id="dynKit-{{ section.id }}" data-min="{{ kit_min }}">
  <div class="dk-wrap">
    <div class="dk-head">
      <h1>{{ section.settings.heading | default: 'Build your kit' }}</h1>
      {%- if section.settings.subtext != blank -%}<p class="dk-sub">{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
    <div class="dk-resume" id="dkResume">
      <span id="dkResumeTxt">You have a kit in progress.</span>
      <button type="button" class="dk-resume-go" id="dkResumeGo">Resume kit</button>
      <button type="button" class="dk-resume-reset" id="dkResumeReset">Start over</button>
    </div>
    {%- if kit_col != blank and kit_col.products.size > 0 -%}
      <div class="dk-grid" id="dkGrid">
        {%- for product in kit_col.products limit: 48 -%}
          {%- if product.available -%}
            <button type="button" class="dk-card" data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" aria-pressed="false">
              <span class="dk-media">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="300" height="300" loading="lazy">
                {%- endif -%}
                <span class="dk-check" aria-hidden="true"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              </span>
              <span class="dk-body">
                <span class="dk-title">{{ product.title }}</span>
                <span class="dk-price">{{ product.price | money }}{% if product.price_varies %}+{% endif %}</span>
              </span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="dk-empty">Pick a collection of kit products in this section's settings.</div>
    {%- endif -%}
  </div>
  <div class="dk-bar" id="dkBar" hidden>
    <span id="dkCount">0 selected</span>
    <button type="button" class="dk-start" id="dkStart" disabled>{{ section.settings.start_label | default: 'Start customizing' }}</button>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById("dynKit-{{ section.id }}");
  if (!root || root.__kit) return;
  root.__kit = true;
  var KEY = "dyn_kit";
  var MIN = Math.max(1, parseInt(root.getAttribute("data-min"), 10) || 2);
  var grid = document.getElementById("dkGrid");
  var bar = document.getElementById("dkBar");
  var countEl = document.getElementById("dkCount");
  var startBtn = document.getElementById("dkStart");
  function loadKit() { try { return JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) { return null; } }
  function saveKit(k) { try { localStorage.setItem(KEY, JSON.stringify(k)); } catch (e) {} }
  function clearKit() { try { localStorage.removeItem(KEY); } catch (e) {} }
  function selected() { return grid ? Array.prototype.slice.call(grid.querySelectorAll(".dk-card.is-sel")) : []; }
  function sync() {
    var n = selected().length;
    if (countEl) countEl.textContent = n + " selected" + (n < MIN ? " — pick at least " + MIN : "");
    if (startBtn) startBtn.disabled = n < MIN;
    if (bar) bar.hidden = n === 0;
  }
  if (grid) grid.addEventListener("click", function (e) {
    var card = e.target.closest(".dk-card"); if (!card) return;
    card.classList.toggle("is-sel");
    card.setAttribute("aria-pressed", card.classList.contains("is-sel") ? "true" : "false");
    sync();
  });
  if (startBtn) startBtn.addEventListener("click", function () {
    var items = selected().map(function (c) { return c.getAttribute("data-handle"); }).filter(Boolean);
    if (items.length < MIN) return;
    var kit = {
      id: "k" + Date.now().toString(36) + Math.floor(Math.random() * 1e9).toString(36),
      items: items, done: [], from: location.pathname
    };
    saveKit(kit);
    location.href = "/products/" + items[0] + "?dynkit=1";
  });
  /* A kit already underway: offer to resume where it left off. */
  var existing = loadKit();
  if (existing && existing.items && existing.items.length) {
    var left = existing.items.filter(function (h) { return (existing.done || []).indexOf(h) < 0; });
    if (left.length) {
      var box = document.getElementById("dkResume");
      var txt = document.getElementById("dkResumeTxt");
      if (txt) txt.textContent = "You have a kit in progress — " + (existing.items.length - left.length) + " of " + existing.items.length + " done.";
      if (box) box.classList.add("is-on");
      var go = document.getElementById("dkResumeGo");
      var reset = document.getElementById("dkResumeReset");
      if (go) go.addEventListener("click", function () { location.href = "/products/" + left[0] + "?dynkit=1"; });
      if (reset) reset.addEventListener("click", function () { clearKit(); box.classList.remove("is-on"); });
    } else { clearKit(); }
  }
  sync();
})();
</script>

{% schema %}
{
  "name": "Dynamic Kit",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "A build-a-kit page: shoppers tick several products, customize each one in turn (the kit bar walks them through), and land on the cart with everything together." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your kit" },
    { "type": "textarea", "id": "subtext", "label": "Intro text", "default": "Pick the pieces, personalize each one, and check out with the whole kit." },
    { "type": "collection", "id": "collection", "label": "Kit products", "info": "The products offered on this page." },
    { "type": "range", "id": "min_items", "label": "Minimum items", "min": 1, "max": 6, "step": 1, "default": 2 },
    { "type": "text", "id": "start_label", "label": "Start button text", "default": "Start customizing" }
  ],
  "presets": [ { "name": "Dynamic Kit" } ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
