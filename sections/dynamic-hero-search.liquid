{% comment %}
  ============================================================================
  Dynamic Hero Search - a Google-style landing search for gifts
  ----------------------------------------------------------------------------
  INSTALL:
  1. Theme code editor > Sections > Add a new section > name it
     "dynamic-hero-search" and REPLACE its contents with this whole file.
  2. Customize > (Home page or any page) > Add section > "Dynamic Hero Search".
     Put it at the top for a landing/hero feel. Save.
  A big centered search box. As the shopper types (e.g. "a gift for dad") it
  previews matching products (Shopify predictive search); Enter or "See all"
  takes them to the search results page. Prompt chips give quick starts.
  TIP: results are only as good as your product titles/tags. Tag products with
  words people search - "gift", "for him", "birthday", "minimalist", etc.
  ============================================================================
{% endcomment %}

<style>
  .dyn-hs {
    --bg:#ffffff; --panel:#f5f5f7; --ink:#1d1d1f; --ink-soft:#6e6e73; --ink-faint:#86868b;
    --line:#d2d2d7; --accent:#0071e3;
    --font:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    --serif:{% if section.settings.heading_font == 'sans' %}var(--font){% else %}"Cormorant Garamond",Georgia,"Times New Roman",Times,serif{% endif %};
    font-family:var(--font); color:var(--ink); -webkit-font-smoothing:antialiased;
    position:relative; display:flex; align-items:center; justify-content:center;
    min-height:{{ section.settings.height | default: 86 }}vh;
    {% if section.settings.bg_image %}background:#000;{% else %}background:linear-gradient(180deg,#ffffff 0%,var(--panel) 100%);{% endif %}
    overflow:hidden;
  }
  .dyn-hs, .dyn-hs *, .dyn-hs *::before, .dyn-hs *::after { box-sizing:border-box; }
  {% if section.settings.bg_image %}
  .dyn-hs .hs-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; }
  .dyn-hs .hs-bg-overlay { position:absolute; inset:0; z-index:1;
    background:linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,.55)); }
  .dyn-hs.is-image { color:#fff; }
  .dyn-hs.is-image .hs-sub { color:rgba(255,255,255,.86); }
  {% endif %}

  .dyn-hs .hs-wrap { position:relative; z-index:2; width:100%; max-width:720px; padding:60px 22px; text-align:center; }
  .dyn-hs .hs-eyebrow { font-size:12px; letter-spacing:0.16em; text-transform:uppercase; opacity:.8; margin:0 0 14px; }
  .dyn-hs .hs-title { font-family:var(--serif); font-weight:500; font-size:clamp(38px,7vw,68px); line-height:1.01;
    letter-spacing:-0.015em; margin:0 0 16px; }
  .dyn-hs .hs-sub { font-size:clamp(15px,2.4vw,18px); color:var(--ink-soft); line-height:1.55; margin:0 auto 30px; max-width:520px; }

  .dyn-hs .hs-box { position:relative; }
  .dyn-hs .hs-form { position:relative; display:flex; align-items:center; }
  .dyn-hs .hs-mag { position:absolute; left:22px; width:22px; height:22px; fill:none; stroke:var(--ink-faint); stroke-width:2;
    stroke-linecap:round; pointer-events:none; z-index:2; }
  .dyn-hs .hs-input { width:100%; font-family:var(--font); font-size:18px; color:var(--ink); background:#fff;
    border:1px solid var(--line); border-radius:999px; padding:20px 130px 20px 56px; box-shadow:0 10px 40px rgba(0,0,0,0.10);
    transition:border-color .16s, box-shadow .16s; }
  .dyn-hs .hs-input::placeholder { color:var(--ink-faint); }
  .dyn-hs .hs-input:focus { outline:none; border-color:var(--accent); box-shadow:0 12px 46px rgba(0,0,0,0.14), 0 0 0 4px rgba(0,113,227,0.14); }
  .dyn-hs .hs-go { position:absolute; right:8px; background:var(--ink); color:#fff; border:none; border-radius:999px;
    padding:13px 26px; font-family:var(--font); font-weight:600; font-size:15px; cursor:pointer; transition:opacity .16s; z-index:2; }
  .dyn-hs .hs-go:hover { opacity:.9; }

  /* Live predictive results */
  .dyn-hs .hs-results { position:absolute; left:0; right:0; top:calc(100% + 12px); background:#fff; border:1px solid var(--line);
    border-radius:20px; box-shadow:0 24px 60px rgba(0,0,0,0.18); padding:8px; text-align:left; z-index:5; display:none; overflow:hidden; }
  .dyn-hs .hs-results.open { display:block; }
  .dyn-hs .hs-res { display:flex; align-items:center; gap:14px; padding:10px 12px; border-radius:12px; text-decoration:none; color:var(--ink);
    transition:background .14s; }
  .dyn-hs .hs-res:hover { background:var(--panel); }
  .dyn-hs .hs-res-img { width:46px; height:46px; border-radius:10px; object-fit:cover; background:var(--panel); flex:none; }
  .dyn-hs .hs-res > span { display:flex; flex-direction:column; min-width:0; }
  .dyn-hs .hs-res-t { display:block; font-size:15px; font-weight:500; line-height:1.3; }
  .dyn-hs .hs-res-p { display:block; font-size:13px; color:var(--ink-soft); margin-top:1px; }
  .dyn-hs .hs-all { display:flex; align-items:center; justify-content:center; gap:8px; margin:6px 4px 4px; padding:13px;
    background:var(--ink); color:#fff; border-radius:12px; text-decoration:none; font-weight:600; font-size:14px; }
  .dyn-hs .hs-all:hover { opacity:.92; }
  .dyn-hs .hs-empty { padding:18px 14px; color:var(--ink-faint); font-size:14px; text-align:center; }

  .dyn-hs .hs-chips { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:22px; }
  .dyn-hs .hs-chip { background:{% if section.settings.bg_image %}rgba(255,255,255,0.16){% else %}var(--bg){% endif %};
    color:{% if section.settings.bg_image %}#fff{% else %}var(--ink){% endif %};
    border:1px solid {% if section.settings.bg_image %}rgba(255,255,255,0.3){% else %}var(--line){% endif %};
    border-radius:999px; padding:10px 18px; font-family:var(--font); font-size:14px; cursor:pointer; transition:transform .14s, background .16s; }
  .dyn-hs .hs-chip:hover { transform:translateY(-2px); }

  @media (max-width:520px){
    .dyn-hs .hs-input { font-size:16px; padding:17px 108px 17px 48px; }
    .dyn-hs .hs-mag { left:18px; }
    .dyn-hs .hs-go { padding:11px 18px; }
  }
</style>

<section class="dyn-hs{% if section.settings.bg_image %} is-image{% endif %}" id="dynHeroSearch"
  data-search-url="{{ routes.search_url | default: '/search' }}"
  data-limit="{{ section.settings.results_limit | default: 6 }}">
  {%- if section.settings.bg_image -%}
    <img class="hs-bg" src="{{ section.settings.bg_image | image_url: width: 2200 }}" alt="" loading="lazy"
      width="{{ section.settings.bg_image.width }}" height="{{ section.settings.bg_image.height }}">
    <div class="hs-bg-overlay"></div>
  {%- endif -%}

  <div class="hs-wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="hs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="hs-title">{{ section.settings.heading | default: 'Find the perfect gift' }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="hs-sub">{{ section.settings.subheading }}</p>{%- endif -%}

    <div class="hs-box">
      <form class="hs-form" action="{{ routes.search_url }}" method="get" role="search" autocomplete="off">
        <svg class="hs-mag" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <input class="hs-input" id="hsInput" type="search" name="q"
          placeholder="{{ section.settings.placeholder | default: 'Describe a gift… “something for my dad”' }}" aria-label="Search">
        <button class="hs-go" type="submit">{{ section.settings.button_label | default: 'Search' }}</button>
      </form>
      <div class="hs-results" id="hsResults" role="listbox" aria-label="Product suggestions"></div>
    </div>

    {%- comment -%} Auto chips from a collection's product tags, else the manual chips. {%- endcomment -%}
    {%- assign auto_chips = false -%}
    {%- if section.settings.auto_chips and section.settings.chips_collection != blank and section.settings.chips_collection.all_tags.size > 0 -%}{%- assign auto_chips = true -%}{%- endif -%}
    {%- assign has_chips = false -%}
    {%- if section.settings.chip_1 != blank or section.settings.chip_2 != blank or section.settings.chip_3 != blank or section.settings.chip_4 != blank -%}{%- assign has_chips = true -%}{%- endif -%}

    {%- if auto_chips -%}
      <div class="hs-chips" id="hsChips">
        {%- assign shown = 0 -%}
        {%- for t in section.settings.chips_collection.all_tags -%}
          {%- unless t contains '-' or t contains '_' -%}
            {%- if shown < section.settings.chips_count -%}
              <button type="button" class="hs-chip">{{ t | capitalize }}</button>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- elsif has_chips -%}
      <div class="hs-chips" id="hsChips">
        {%- if section.settings.chip_1 != blank -%}<button type="button" class="hs-chip">{{ section.settings.chip_1 }}</button>{%- endif -%}
        {%- if section.settings.chip_2 != blank -%}<button type="button" class="hs-chip">{{ section.settings.chip_2 }}</button>{%- endif -%}
        {%- if section.settings.chip_3 != blank -%}<button type="button" class="hs-chip">{{ section.settings.chip_3 }}</button>{%- endif -%}
        {%- if section.settings.chip_4 != blank -%}<button type="button" class="hs-chip">{{ section.settings.chip_4 }}</button>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById("dynHeroSearch");
  if (!root) return;
  var input = document.getElementById("hsInput");
  var resultsEl = document.getElementById("hsResults");
  var chips = document.getElementById("hsChips");
  var searchUrl = root.getAttribute("data-search-url") || "/search";
  var LIMIT = parseInt(root.getAttribute("data-limit"), 10) || 6;
  var debounceT = 0, seq = 0;

  function go(q) { if (!q) return; window.location.href = searchUrl + "?q=" + encodeURIComponent(q) + "&type=product&options%5Bprefix%5D=last"; }
  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }

  function render(products, q) {
    if (!products.length) {
      resultsEl.innerHTML = '<div class="hs-empty">No matches yet — press Enter to search &ldquo;' + esc(q) + '&rdquo;.</div>';
      resultsEl.classList.add("open"); return;
    }
    var html = "";
    products.forEach(function (p) {
      var img = p.image || (p.featured_image && (p.featured_image.url || p.featured_image)) || "";
      var price = p.price != null ? p.price : "";
      html += '<a class="hs-res" href="' + esc(p.url) + '">' +
        (img ? '<img class="hs-res-img" src="' + esc(img) + '" alt="" width="46" height="46">' : '<span class="hs-res-img"></span>') +
        '<span><span class="hs-res-t">' + esc(p.title) + "</span>" +
        (price !== "" ? '<span class="hs-res-p">' + esc(price) + "</span>" : "") + "</span></a>";
    });
    html += '<a class="hs-all" href="' + searchUrl + "?q=" + encodeURIComponent(q) + '&type=product">See all results for &ldquo;' + esc(q) + '&rdquo;</a>';
    resultsEl.innerHTML = html;
    resultsEl.classList.add("open");
  }

  function suggest(q) {
    var mine = ++seq;
    var url = "/search/suggest.json?q=" + encodeURIComponent(q) +
      "&resources[type]=product&resources[limit]=" + LIMIT +
      "&resources[options][unavailable_products]=last" +
      "&resources[options][fields]=title,product_type,variants.title,vendor,tag";
    fetch(url, { headers: { "Accept": "application/json" } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (mine !== seq) return;
        var products = (d && d.resources && d.resources.results && d.resources.results.products) || [];
        render(products, q);
      })
      .catch(function () { if (mine === seq) resultsEl.classList.remove("open"); });
  }

  input.addEventListener("input", function () {
    var q = input.value.trim();
    clearTimeout(debounceT);
    if (q.length < 2) { resultsEl.classList.remove("open"); resultsEl.innerHTML = ""; return; }
    debounceT = setTimeout(function () { suggest(q); }, 180);
  });

  input.addEventListener("keydown", function (e) {
    if (e.key === "Enter") { e.preventDefault(); go(input.value.trim()); }
  });

  // Chips: fill the box and run the preview.
  if (chips) chips.addEventListener("click", function (e) {
    var chip = e.target.closest(".hs-chip"); if (!chip) return;
    input.value = chip.textContent.trim(); input.focus();
    var q = input.value.trim(); if (q.length >= 2) suggest(q);
  });

  // Close results when clicking outside the box.
  document.addEventListener("click", function (e) {
    if (!e.target.closest("#dynHeroSearch .hs-box")) resultsEl.classList.remove("open");
  });
})();
</script>

{% schema %}
{
  "name": "Dynamic Hero Search",
  "tag": "section",
  "class": "dynamic-hero-search-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small label above)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the perfect gift" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif",
      "options": [ { "value": "serif", "label": "Elegant serif (matches store)" }, { "value": "sans", "label": "Clean sans" } ] },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Describe who it’s for or the occasion — we’ll find the closest matches." },
    { "type": "text", "id": "placeholder", "label": "Search box placeholder", "default": "Describe a gift… “something for my dad”" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Search" },
    { "type": "range", "id": "results_limit", "min": 3, "max": 10, "step": 1, "label": "Live previews shown", "default": 6 },
    { "type": "range", "id": "height", "min": 50, "max": 100, "step": 2, "label": "Section height (vh)", "default": 86 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)", "info": "Leave empty for a clean light hero. With an image, text turns white over a dark overlay." },
    { "type": "header", "content": "Prompt chips (quick starts)" },
    { "type": "checkbox", "id": "auto_chips", "label": "Auto-build chips from product tags", "default": false, "info": "When on, chips are generated from the collection's product tags below (tags with - or _, like made-to-order, are skipped). The manual chips below are used when this is off." },
    { "type": "collection", "id": "chips_collection", "label": "Collection for auto chips" },
    { "type": "range", "id": "chips_count", "min": 3, "max": 10, "step": 1, "label": "Number of auto chips", "default": 6 },
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "A gift for dad" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Something minimalist" },
    { "type": "text", "id": "chip_3", "label": "Chip 3", "default": "Birthday under $30" },
    { "type": "text", "id": "chip_4", "label": "Chip 4", "default": "For a new home" }
  ],
  "presets": [ { "name": "Dynamic Hero Search" } ]
}
{% endschema %}
