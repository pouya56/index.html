{% comment %}
  ============================================================================
  Dynamic Bulk Order — multi-product request form. Emails YOU directly.
  ----------------------------------------------------------------------------
  Each row: tap the "+" tile to pick a product from a grid, choose the options
  (Size / Colour dropdowns), set a quantity, "Add another variation" for more
  combos, and upload a design per variation. On submit, designs are hosted on
  Shopify and the request is emailed straight to you via FormSubmit (no
  Shopify captcha, no page reload) — then a thank-you shows on the page.
  No prices, no cart, no mockup.
  SETUP:
  1. Theme editor > Sections > add "dynamic-bulk-order" > paste this.
  2. Pages > Add page "Bulk order". Customize > that page > Add section >
     "Dynamic Bulk Order". Choose the Collection + your notification email.
  3. FIRST submission only: FormSubmit sends a one-time "Activate" email to
     your address — click it once, and every request after that is delivered
     automatically, with no puzzle for the customer.
  ============================================================================
{% endcomment %}

{%- assign bo_coll = section.settings.collection -%}
{%- if bo_coll == blank -%}{%- assign bo_coll = collections.all -%}{%- endif -%}
{%- assign notify_email = section.settings.notify_email | default: shop.email -%}

<style>
  .dbo { --ink:#1d1d1f; --soft:#6e6e73; --faint:#86868b; --line:#e3e3e8; --line2:#d2d2d7; --accent:#0071e3; --accent-soft:#e8f2fd; --panel:#f5f5f7; --danger:#c0392b; --ok:#1a7f37;
    --font:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    font-family:var(--font); color:var(--ink); -webkit-font-smoothing:antialiased; max-width:1000px; margin:0 auto; padding:40px 22px 80px; }
  .dbo *, .dbo *::before, .dbo *::after { box-sizing:border-box; }
  .dbo-topbar { display:flex; align-items:center; margin-bottom:28px; }
  .dbo-topbar.is-left { justify-content:flex-start; }
  .dbo-topbar.is-center { justify-content:center; }
  .dbo-logo { display:inline-flex; align-items:center; text-decoration:none; transition:opacity .16s; }
  .dbo-logo:hover { opacity:0.72; }
  .dbo-logo img { display:block; height:auto; max-width:62vw; }
  .dbo-logo-text { font-size:22px; font-weight:600; letter-spacing:-0.02em; color:var(--ink); }
  .dbo-head { text-align:center; margin-bottom:30px; }
  .dbo-head h1 { font-size:clamp(28px,5vw,44px); font-weight:600; letter-spacing:-0.02em; margin:0 0 10px; }
  .dbo-head p { font-size:16px; color:var(--soft); line-height:1.55; margin:0 auto; max-width:620px; }
  .dbo-rows { display:flex; flex-direction:column; gap:16px; }
  .dbo-row { display:grid; grid-template-columns:110px 1fr; gap:18px; padding:18px; border:1px solid var(--line); border-radius:20px; background:#fff; box-shadow:0 1px 2px rgba(0,0,0,0.03); }
  .dbo-pick { width:110px; height:110px; border-radius:16px; border:1.5px dashed var(--line2); background:var(--panel); cursor:pointer; display:grid; place-items:center; overflow:hidden; padding:0; transition:border-color .16s, background .16s; }
  .dbo-pick:hover { border-color:var(--accent); background:#eef4ff; }
  .dbo-pick img { width:100%; height:100%; object-fit:contain; }
  .dbo-pick .dbo-plus { display:flex; flex-direction:column; align-items:center; gap:4px; color:var(--faint); font-size:12px; }
  .dbo-pick .dbo-plus svg { width:26px; height:26px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; }
  .dbo-fields { display:flex; flex-direction:column; gap:12px; min-width:0; }
  .dbo-pname { font-size:16px; font-weight:600; }
  .dbo-pname.empty { color:var(--faint); font-weight:500; }
  .dbo-varlines { display:flex; flex-direction:column; gap:8px; }
  .dbo-varline { display:flex; flex-wrap:wrap; align-items:flex-end; gap:10px; padding:10px; border:1px solid var(--line); border-radius:12px; background:var(--panel); }
  .dbo-optgroup { display:flex; flex-direction:column; gap:4px; flex:1 1 140px; min-width:120px; }
  .dbo-optname { font-size:11px; font-weight:600; letter-spacing:.02em; text-transform:uppercase; color:var(--faint); }
  .dbo-opt { height:40px; padding:0 10px; border:1px solid var(--line2); border-radius:10px; font:inherit; font-size:14.5px; background:#fff; width:100%; }
  .dbo-opt:focus { outline:none; border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .dbo-qtywrap { display:flex; flex-direction:column; gap:4px; }
  .dbo-qtywrap span { font-size:11px; font-weight:600; letter-spacing:.02em; text-transform:uppercase; color:var(--faint); }
  .dbo-qty { width:80px; height:40px; padding:0 10px; border:1px solid var(--line2); border-radius:10px; font:inherit; font-size:15px; text-align:center; background:#fff; }
  .dbo-qty:focus { outline:none; border-color:var(--accent); }
  .dbo-varremove { flex:none; width:36px; height:40px; border:1px solid var(--line2); border-radius:10px; background:#fff; color:var(--danger); font-size:19px; line-height:1; cursor:pointer; }
  .dbo-varremove:hover { background:#fdeceb; border-color:#f3c6c3; }
  .dbo-addvar { align-self:flex-start; display:inline-flex; align-items:center; gap:6px; border:0; background:transparent; color:var(--accent); font:inherit; font-size:13.5px; font-weight:600; cursor:pointer; padding:2px 0; }
  .dbo-addvar svg { width:15px; height:15px; fill:none; stroke:currentColor; stroke-width:2.4; stroke-linecap:round; }
  .dbo-file-btn { display:inline-flex; align-items:center; gap:8px; height:42px; padding:0 14px; border:1px dashed var(--line2); border-radius:12px; cursor:pointer; font-size:14px; color:var(--soft); background:#fff; }
  .dbo-file-btn:hover { border-color:var(--accent); color:var(--accent); }
  .dbo-file-btn svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; flex:none; }
  .dbo-file-btn input[type=file] { display:none; }
  .dbo-varfile { flex:1 1 150px; min-width:130px; max-width:210px; height:40px; }
  .dbo-varfile.has-file { border-style:solid; border-color:var(--accent); color:var(--accent); }
  .dbo-varfile .dbo-varfile-label { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .dbo-row-foot { display:flex; justify-content:flex-end; padding-top:4px; }
  .dbo-remove { border:0; background:transparent; color:var(--danger); font:inherit; font-size:13px; cursor:pointer; padding:6px 8px; border-radius:8px; }
  .dbo-remove:hover { background:#fdeceb; }
  .dbo-add { display:inline-flex; align-items:center; gap:8px; margin-top:18px; height:46px; padding:0 20px; border:1px solid var(--line2); border-radius:999px; background:#fff; color:var(--ink); font:inherit; font-size:15px; font-weight:500; cursor:pointer; transition:background .16s; }
  .dbo-add:hover { background:var(--panel); }
  .dbo-add svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; }
  .dbo-summary { margin-top:28px; padding:20px 22px; border:1px solid var(--line); border-radius:20px; background:var(--panel); }
  .dbo-contact { display:grid; grid-template-columns:1fr 1fr; gap:12px 14px; margin-bottom:16px; }
  .dbo-contact .dbo-full { grid-column:1 / -1; }
  .dbo-contact label { display:flex; flex-direction:column; gap:5px; font-size:12.5px; font-weight:600; }
  .dbo-contact input, .dbo-contact textarea { padding:11px 12px; border:1px solid var(--line2); border-radius:12px; font:inherit; font-size:15px; background:#fff; }
  .dbo-contact textarea { min-height:70px; resize:vertical; }
  .dbo-submit { width:100%; height:52px; border:0; border-radius:999px; background:var(--ink); color:#fff; font:inherit; font-size:16px; font-weight:600; cursor:pointer; transition:opacity .16s, transform .1s; }
  .dbo-submit:hover { opacity:0.92; } .dbo-submit:active { transform:scale(0.99); }
  .dbo-submit[disabled] { opacity:0.55; cursor:default; }
  .dbo-note { font-size:12.5px; color:var(--faint); text-align:center; margin-top:12px; line-height:1.5; }
  .dbo-errors { margin:0 0 20px; padding:12px 16px; border:1px solid #f3c6c3; background:#fdeceb; color:var(--danger); border-radius:12px; font-size:14px; }
  .dbo-success { text-align:center; padding:56px 20px; border:1px solid var(--line); border-radius:20px; background:#fff; }
  .dbo-success svg { width:60px; height:60px; color:var(--ok); margin:0 auto 18px; display:block; }
  .dbo-success h2 { font-size:26px; font-weight:600; margin:0 0 10px; }
  .dbo-success p { color:var(--soft); margin:0 auto; max-width:440px; line-height:1.55; }
  .dbo-empty { text-align:center; padding:60px 20px; color:var(--soft); }
  /* product picker modal */
  .dbo-picker { position:fixed; inset:0; z-index:9999; display:none; align-items:center; justify-content:center; padding:20px; background:rgba(0,0,0,0.4); }
  .dbo-picker.is-open { display:flex; }
  .dbo-picker-panel { width:min(760px,96vw); max-height:86vh; display:flex; flex-direction:column; background:#fff; border-radius:22px; overflow:hidden; box-shadow:0 30px 80px rgba(0,0,0,0.3); }
  .dbo-picker-head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:16px 18px; border-bottom:1px solid var(--line); }
  .dbo-picker-head h3 { font-size:17px; font-weight:600; margin:0; }
  .dbo-picker-x { width:34px; height:34px; border:0; border-radius:50%; background:var(--panel); cursor:pointer; font-size:18px; color:var(--soft); }
  .dbo-picker-search { padding:12px 18px; }
  .dbo-picker-search input { width:100%; height:42px; padding:0 14px; border:1px solid var(--line2); border-radius:12px; font:inherit; font-size:15px; }
  .dbo-picker-grid { overflow:auto; padding:6px 18px 20px; display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:12px; }
  .dbo-tile { border:1px solid var(--line); border-radius:16px; padding:10px; cursor:pointer; background:#fff; text-align:center; transition:border-color .14s, transform .1s; }
  .dbo-tile:hover { border-color:var(--accent); transform:translateY(-2px); }
  .dbo-tile-img { width:100%; aspect-ratio:1/1; border-radius:12px; object-fit:contain; background:var(--panel); }
  .dbo-tile-name { font-size:13px; font-weight:500; margin-top:8px; line-height:1.25; }
  @media (max-width:640px) { .dbo-contact { grid-template-columns:1fr; } }
</style>

<section class="dbo" id="dboRoot" data-minqty="{{ section.settings.min_qty | default: 1 }}" data-notify="{{ notify_email }}">
  {%- assign bo_logo = section.settings.logo | default: settings.logo -%}
  {%- if section.settings.show_logo != false -%}
    {%- assign lw = settings.logo_width | default: 140 -%}
    <div class="dbo-topbar is-{{ section.settings.logo_align | default: 'center' }}">
      <a href="{{ routes.root_url }}" class="dbo-logo" aria-label="{{ shop.name | escape }} — home">
        {%- if bo_logo != blank -%}
          {%- assign lh = lw | divided_by: bo_logo.aspect_ratio | round -%}
          <img src="{{ bo_logo | image_url: width: 500 }}" alt="{{ shop.name | escape }}" width="{{ lw }}" height="{{ lh }}" style="width:{{ lw }}px;">
        {%- else -%}
          <span class="dbo-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>
  {%- endif -%}

  <div class="dbo-head">
    <h1>{{ section.settings.heading | default: 'Bulk order' }}</h1>
    {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
  </div>

  {%- if bo_coll.products.size == 0 -%}
    <div class="dbo-empty">No products are available for bulk order yet.</div>
  {%- else -%}
    <script type="application/json" id="dboData">
[
{%- for product in bo_coll.products -%}
  {
    "id": {{ product.id }},
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 500 | json }}{% else %}null{% endif %},
    "options": [{%- for o in product.options_with_values -%}{%- assign o_vals = o.values | join: '@@@' | split: '@@@' -%}{ "name": {{ o.name | json }}, "values": {{ o_vals | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
    "variants": [{%- for v in product.variants -%}{ "id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
    </script>

    <div id="dboForm">
      <div class="dbo-rows" id="dboRows"></div>
      <button type="button" class="dbo-add" id="dboAdd">
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        {{ section.settings.add_label | default: 'Add another product' }}
      </button>
      <div class="dbo-summary">
        <div class="dbo-contact">
          <label class="dbo-full">Name<input type="text" id="dboName" autocomplete="name"></label>
          <label>Email<input type="email" id="dboEmail" autocomplete="email" required></label>
          <label>Phone (optional)<input type="tel" id="dboPhone" autocomplete="tel"></label>
          <label class="dbo-full">Notes (optional)<textarea id="dboNotes" placeholder="Deadline, special instructions…"></textarea></label>
        </div>
        <button type="button" class="dbo-submit" id="dboSubmit">{{ section.settings.submit_label | default: 'Send my bulk order' }}</button>
        <p class="dbo-note">{{ section.settings.submit_note | default: 'We’ll email you a confirmation. Your uploaded designs are included automatically.' }}</p>
      </div>
    </div>

    <div class="dbo-success" id="dboSuccess" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <h2>{{ section.settings.success_title | default: 'Request sent!' }}</h2>
      <p>{{ section.settings.success_text | default: 'Thanks — we’ve received your bulk order request and will email you a confirmation and quote shortly.' }}</p>
    </div>

    <template id="dboRowTpl">
      <div class="dbo-row">
        <button type="button" class="dbo-pick"><span class="dbo-plus"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Choose product</span></button>
        <div class="dbo-fields">
          <div class="dbo-pname empty">No product selected</div>
          <div class="dbo-varlines"></div>
          <button type="button" class="dbo-addvar" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> {{ section.settings.addvar_label | default: 'Add another variation' }}</button>
          <div class="dbo-row-foot"><button type="button" class="dbo-remove">Remove product</button></div>
        </div>
      </div>
    </template>

    <div class="dbo-picker" id="dboPicker">
      <div class="dbo-picker-panel">
        <div class="dbo-picker-head"><h3>Choose a product</h3><button type="button" class="dbo-picker-x" id="dboPickerX" aria-label="Close">&times;</button></div>
        <div class="dbo-picker-search"><input type="search" id="dboPickerSearch" placeholder="Search products…"></div>
        <div class="dbo-picker-grid" id="dboPickerGrid"></div>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  var root = document.getElementById("dboRoot");
  var dataEl = document.getElementById("dboData");
  var rowsEl = document.getElementById("dboRows");
  var tpl = document.getElementById("dboRowTpl");
  if (!root || !dataEl || !rowsEl || !tpl) return;
  var PRODUCTS = [], LOAD_ERR = false;
  try { PRODUCTS = JSON.parse(dataEl.textContent) || []; } catch (e) { LOAD_ERR = true; }
  // Option values can arrive as plain names or (newer Shopify) as objects.
  function valNames(o) {
    return (o && o.values ? o.values : []).map(function (v) {
      return (v && typeof v === "object") ? String(v.name || v.title || "") : String(v);
    });
  }
  PRODUCTS.forEach(function (p) {
    (p.options || []).forEach(function (o) { o.values = valNames(o); });
  });

  var addBtn = document.getElementById("dboAdd");
  var submitBtn = document.getElementById("dboSubmit");
  var formBox = document.getElementById("dboForm");
  var successBox = document.getElementById("dboSuccess");
  var picker = document.getElementById("dboPicker");
  var pickerGrid = document.getElementById("dboPickerGrid");
  var pickerSearch = document.getElementById("dboPickerSearch");
  var minQty = parseInt(root.getAttribute("data-minqty"), 10) || 1;
  var NOTIFY = (root.getAttribute("data-notify") || "").trim();

  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;" }[c]; }); }
  function rows() { return Array.prototype.slice.call(rowsEl.querySelectorAll(".dbo-row")); }
  function isDefault(prod) {
    return !prod.options || prod.options.length === 0 ||
      (prod.options.length === 1 && prod.options[0].values.length === 1 && prod.options[0].values[0] === "Default Title");
  }
  function firstVariantId(prod) {
    if (!prod || !prod.variants || !prod.variants.length) return null;
    for (var i = 0; i < prod.variants.length; i++) if (prod.variants[i].available) return prod.variants[i].id;
    return prod.variants[0].id;
  }
  // Resolve the exact variant from the dropdown selections (falls back to first).
  function resolveVariantId(prod, line) {
    if (!prod || !prod.variants) return null;
    var sels = Array.prototype.slice.call(line.querySelectorAll(".dbo-opt"));
    if (!sels.length) return firstVariantId(prod);
    var chosen = sels.map(function (s) { return s.value; });
    for (var i = 0; i < prod.variants.length; i++) {
      var vo = prod.variants[i].options || [];
      var match = chosen.length === vo.length && chosen.every(function (val, idx) { return val === vo[idx]; });
      if (match) return prod.variants[i].id;
    }
    return firstVariantId(prod);
  }

  // ---- product picker ----
  function buildPicker() {
    pickerGrid.innerHTML = "";
    if (LOAD_ERR || !PRODUCTS.length) {
      var msg = document.createElement("div");
      msg.style.cssText = "grid-column:1/-1;padding:30px 10px;text-align:center;color:#6e6e73;font-size:14.5px;line-height:1.5;";
      msg.textContent = LOAD_ERR
        ? "The product list couldn’t be loaded — please refresh the page. If it keeps happening, re-save the section in the theme editor."
        : "No products found — pick a collection with products in the section settings.";
      pickerGrid.appendChild(msg);
      return;
    }
    PRODUCTS.forEach(function (p) {
      var t = document.createElement("button"); t.type = "button"; t.className = "dbo-tile"; t.setAttribute("data-id", p.id); t.setAttribute("data-name", (p.title || "").toLowerCase());
      t.innerHTML = (p.image ? '<img class="dbo-tile-img" src="' + p.image + '" alt="">' : '<div class="dbo-tile-img"></div>') + '<div class="dbo-tile-name">' + esc(p.title) + '</div>';
      t.addEventListener("click", function () { if (_activeRow) setRowProduct(_activeRow, p); closePicker(); });
      pickerGrid.appendChild(t);
    });
  }
  var _activeRow = null;
  function openPicker(row) { _activeRow = row; picker.classList.add("is-open"); pickerSearch.value = ""; filterPicker(""); setTimeout(function(){ pickerSearch.focus(); }, 50); }
  function closePicker() { picker.classList.remove("is-open"); _activeRow = null; }
  function filterPicker(q) {
    q = (q || "").toLowerCase();
    Array.prototype.forEach.call(pickerGrid.children, function (t) { t.style.display = (!q || t.getAttribute("data-name").indexOf(q) >= 0) ? "" : "none"; });
  }
  if (picker) {
    buildPicker();
    document.getElementById("dboPickerX").addEventListener("click", closePicker);
    picker.addEventListener("click", function (e) { if (e.target === picker) closePicker(); });
    pickerSearch.addEventListener("input", function () { filterPicker(pickerSearch.value); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closePicker(); });
  }

  // ---- variation line (dropdowns) ----
  function makeVarLine(prod) {
    var line = document.createElement("div"); line.className = "dbo-varline";
    if (!isDefault(prod)) {
      prod.options.forEach(function (o) {
        var grp = document.createElement("div"); grp.className = "dbo-optgroup";
        var nm = document.createElement("span"); nm.className = "dbo-optname"; nm.textContent = o.name; grp.appendChild(nm);
        var sel = document.createElement("select"); sel.className = "dbo-opt"; sel.setAttribute("data-name", o.name);
        var first = document.createElement("option"); first.value = ""; first.textContent = "Select " + o.name.toLowerCase(); sel.appendChild(first);
        o.values.forEach(function (v) { var op = document.createElement("option"); op.value = v; op.textContent = v; sel.appendChild(op); });
        grp.appendChild(sel); line.appendChild(grp);
      });
    }
    var qw = document.createElement("div"); qw.className = "dbo-qtywrap";
    qw.innerHTML = '<span>Qty</span><input type="number" class="dbo-qty" min="0" step="1" value="0" inputmode="numeric">';
    line.appendChild(qw);
    // per-variation design upload
    var fileWrap = document.createElement("label"); fileWrap.className = "dbo-file-btn dbo-varfile";
    fileWrap.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg><span class="dbo-varfile-label">Design</span><input type="file" class="dbo-varfile-input" accept="image/*,.pdf,.ai,.svg">';
    var fileInput = fileWrap.querySelector("input");
    var fileLabel = fileWrap.querySelector(".dbo-varfile-label");
    fileInput.addEventListener("change", function () {
      var f = fileInput.files && fileInput.files[0];
      if (!f) { line._file = null; fileWrap.classList.remove("has-file"); fileLabel.textContent = "Design"; return; }
      line._file = f; fileWrap.classList.add("has-file"); fileLabel.textContent = f.name;
    });
    line.appendChild(fileWrap);
    var rm = document.createElement("button"); rm.type = "button"; rm.className = "dbo-varremove"; rm.setAttribute("aria-label", "Remove variation"); rm.textContent = "×";
    rm.addEventListener("click", function () { var box = line.parentNode; line.remove(); if (!box.querySelector(".dbo-varline")) box.appendChild(makeVarLine(prod)); });
    line.appendChild(rm);
    return line;
  }

  function setRowProduct(row, prod) {
    row._product = prod;
    var pick = row.querySelector(".dbo-pick");
    pick.innerHTML = prod.image ? '<img src="' + prod.image + '" alt="">' : '<span class="dbo-plus">' + esc(prod.title) + '</span>';
    var pname = row.querySelector(".dbo-pname"); pname.textContent = prod.title; pname.classList.remove("empty");
    var varlines = row.querySelector(".dbo-varlines"); varlines.innerHTML = ""; varlines.appendChild(makeVarLine(prod));
    row.querySelector(".dbo-addvar").hidden = isDefault(prod);
  }

  function bindRow(row) {
    row.querySelector(".dbo-pick").addEventListener("click", function () { openPicker(row); });
    row.querySelector(".dbo-addvar").addEventListener("click", function () { if (row._product) row.querySelector(".dbo-varlines").appendChild(makeVarLine(row._product)); });
  }

  function addRow() {
    var node = tpl.content.firstElementChild.cloneNode(true);
    rowsEl.appendChild(node);
    bindRow(node);
    node.querySelector(".dbo-remove").addEventListener("click", function () { node.remove(); if (!rows().length) addRow(); });
    return node;
  }
  addBtn.addEventListener("click", addRow);
  var firstRow = addRow();

  // Preselect a product if the page was opened with ?product=<handle>
  (function () {
    try {
      var pre = new URLSearchParams(window.location.search).get("product");
      if (!pre) return;
      var match = null;
      for (var i = 0; i < PRODUCTS.length; i++) {
        if (String(PRODUCTS[i].handle) === pre || String(PRODUCTS[i].id) === pre) { match = PRODUCTS[i]; break; }
      }
      if (match && firstRow) setRowProduct(firstRow, match);
    } catch (e) {}
  })();

  // ---- Shopify file hosting (upload to cart, read hosted URL, then clear) ----
  var _addedToCart = false;
  async function uploadViaShopify(file, variantId) {
    if (!file || !variantId) return "";
    try {
      var fd = new FormData();
      fd.append("id", String(variantId)); fd.append("quantity", "1");
      fd.append("properties[Bulk design]", file, file.name);
      var res = await fetch("/cart/add.js", { method: "POST", headers: { Accept: "application/json" }, body: fd });
      if (!res.ok) return "";
      var j = await res.json(); _addedToCart = true;
      var it = (j.items && j.items[0]) || j;
      return (it && it.properties && (it.properties["Bulk design"] || it.properties.Bulk_design)) || "";
    } catch (e) { return ""; }
  }
  async function clearCart() { try { await fetch("/cart/clear.js", { method: "POST", headers: { Accept: "application/json" } }); } catch (e) {} }

  async function buildBody() {
    var phone = (document.getElementById("dboPhone").value || "").trim();
    var notes = (document.getElementById("dboNotes").value || "").trim();
    var itemLines = [], any = false;
    var rws = rows();
    for (var r = 0; r < rws.length; r++) {
      var row = rws[r];
      if (!row._product) continue;
      var prod = row._product;
      var pName = prod.title;
      var lines = Array.prototype.slice.call(row.querySelectorAll(".dbo-varline"));
      for (var l = 0; l < lines.length; l++) {
        var line = lines[l];
        var q = parseInt(line.querySelector(".dbo-qty").value, 10) || 0;
        if (q < Math.max(1, minQty)) continue;
        var sels = Array.prototype.slice.call(line.querySelectorAll(".dbo-opt"));
        var parts = [], complete = true;
        sels.forEach(function (s) { if (!s.value) complete = false; else parts.push(s.getAttribute("data-name") + ": " + s.value); });
        if (sels.length && !complete) continue;
        var label = parts.length ? parts.join(", ") : "Standard";
        itemLines.push("- " + pName + " — " + label + " — Qty " + q);
        // upload this variation's own design, if any
        if (line._file) {
          var url = await uploadViaShopify(line._file, resolveVariantId(prod, line));
          itemLines.push("    Design: " + (url || ("(couldn't attach '" + line._file.name + "')")));
        }
        any = true;
      }
    }
    if (_addedToCart) await clearCart();
    if (!any) return null;
    var out = [];
    if (phone) out.push("Phone: " + phone);
    out.push("", "Items:");
    out = out.concat(itemLines);
    if (notes) out.push("", "Notes: " + notes);
    return out.join("\n");
  }

  var submitting = false;
  submitBtn.addEventListener("click", function () {
    if (submitting) return;
    var name = (document.getElementById("dboName").value || "").trim();
    var email = (document.getElementById("dboEmail").value || "").trim();
    if (!email) { document.getElementById("dboEmail").focus(); return; }
    if (!NOTIFY) { alert("This form isn’t set up yet (missing notification email)."); return; }
    submitting = true; submitBtn.disabled = true; var t = submitBtn.textContent; submitBtn.textContent = "Sending…";

    buildBody().then(function (body) {
      if (!body) { alert("Please pick a product, choose the options, and enter a quantity for at least one variation."); submitting = false; submitBtn.disabled = false; submitBtn.textContent = t; return; }
      var payload = {
        _subject: "Bulk order request" + (name ? " — " + name : ""),
        name: name || "(no name)",
        email: email,          // shopper's email (so you can reply straight to them)
        _template: "box",
        _captcha: "false",     // no puzzle for the customer
        message: body
      };
      fetch("https://formsubmit.co/ajax/" + encodeURIComponent(NOTIFY), {
        method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" }, body: JSON.stringify(payload)
      }).then(function (res) { return res.ok ? res.json() : Promise.reject(); })
        .then(function () { formBox.style.display = "none"; if (successBox) successBox.hidden = false; window.scrollTo({ top: root.offsetTop - 20, behavior: "smooth" }); })
        .catch(function () { alert("Sorry, we couldn’t send that. Please try again or email us directly."); submitting = false; submitBtn.disabled = false; submitBtn.textContent = t; });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Dynamic Bulk Order",
  "tag": "section",
  "class": "dynamic-bulk-order-section",
  "settings": [
    { "type": "header", "content": "Logo (links to home)" },
    { "type": "checkbox", "id": "show_logo", "label": "Show logo at top", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to use your theme logo." },
    { "type": "select", "id": "logo_align", "label": "Logo position", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "header", "content": "Order settings" },
    { "type": "collection", "id": "collection", "label": "Products available for bulk order", "info": "Choose a collection. Leave empty to allow all products." },
    { "type": "text", "id": "notify_email", "label": "Your notification email", "info": "Where bulk requests are emailed. Leave empty to use your store contact email." },
    { "type": "paragraph", "content": "Requests are emailed straight to you with no captcha for the customer. FIRST submission only: FormSubmit sends a one-time ‘Activate’ email to the address above — click it once, then every request is delivered automatically. Uploaded designs are hosted on Shopify and included as links." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bulk order" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Order several products at once — pick each item, choose the options and quantity, and upload your design." },
    { "type": "text", "id": "add_label", "label": "Add-product button text", "default": "Add another product" },
    { "type": "text", "id": "addvar_label", "label": "Add-variation button text", "default": "Add another variation" },
    { "type": "text", "id": "submit_label", "label": "Submit button text", "default": "Send my bulk order" },
    { "type": "text", "id": "submit_note", "label": "Note under the submit button", "default": "We’ll email you a confirmation. Your uploaded designs are included automatically." },
    { "type": "text", "id": "success_title", "label": "Success title", "default": "Request sent!" },
    { "type": "textarea", "id": "success_text", "label": "Success message", "default": "Thanks — we’ve received your bulk order request and will email you a confirmation and quote shortly." },
    { "type": "range", "id": "min_qty", "label": "Minimum quantity per variation", "min": 1, "max": 100, "step": 1, "default": 1 }
  ],
  "presets": [ { "name": "Dynamic Bulk Order" } ],
  "enabled_on": { "templates": ["page", "index"] }
}
{% endschema %}
