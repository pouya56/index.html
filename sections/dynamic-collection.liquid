  var MAP = {
    black:"#1d1d1f", white:"#f5f5f7", grey:"#8e8e93", gray:"#8e8e93", silver:"#c7c7cc",
    red:"#d0021b", crimson:"#b00020", maroon:"#7b1e1e", orange:"#f5820d", amber:"#ffb300",
    yellow:"#f7c948", gold:"#c9a227", green:"#2b9348", olive:"#7a7a2e", teal:"#008080",
    blue:"#0071e3", navy:"#1b2a4a", "sky blue":"#4aa8e0", "light blue":"#8ec6ef",
    purple:"#7b2ff7", violet:"#8f00ff", pink:"#ff5c8a", "hot pink":"#ff2d78", rose:"#e75480",
    brown:"#7a4b2b", tan:"#d2b48c", beige:"#e8dcc4", cream:"#f4efe1", ivory:"#fffff0",
    khaki:"#c3b091", charcoal:"#36454f", "off white":"#efefe9", natural:"#e8e0d0",
    burgundy:"#800020", mustard:"#d4a017", mint:"#a8e6cf", lavender:"#b57edc", coral:"#ff7f50",
    turquoise:"#40e0d0", indigo:"#4b0082", magenta:"#d0208a"
  };
  function colorFor(name) {
    var n = (name || "").trim().toLowerCase();
    if (MAP[n]) return MAP[n];
    var words = n.split(/[\s/]+/);
    for (var i = words.length - 1; i >= 0; i--) { if (MAP[words[i]]) return MAP[words[i]]; }
    var t = new Option().style; t.color = ""; t.color = n; if (t.color !== "") return n;
    return "#c7c7cc";
  }
  cards.forEach(function (card) {
    var img1 = card.querySelector(".dc-media .dc-img-1");
    var baseSrc = img1 ? img1.getAttribute("src") : "";
    card.querySelectorAll(".dc-swatch").forEach(function (sw) {
      sw.style.background = colorFor(sw.getAttribute("data-color"));
      var vimg = sw.getAttribute("data-img");
      if (vimg && img1) sw.addEventListener("mouseenter", function () { img1.src = vimg; });
    });
    if (img1) card.addEventListener("mouseleave", function () { if (baseSrc) img1.src = baseSrc; });
  });
})();
</script>

<script>
/* Instagram-style save button -> browser wishlist (same "dyn_wishlist" list the
   wishlist page and header drawer use). */
(function () {
  var KEY = "dyn_wishlist";
  var btns = document.querySelectorAll(".dyn-col .dc-save");
  if (!btns.length) return;
  function read() { try { var a = JSON.parse(localStorage.getItem(KEY) || "[]"); return Array.isArray(a) ? a : []; } catch (e) { return []; } }
  function write(l) { try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (e) {} try { window.dispatchEvent(new CustomEvent("dyn-wishlist-change")); } catch (e) {} }
  function has(id) { return read().some(function (x) { return String(x.id) === String(id); }); }
  function paint() {
    btns.forEach(function (b) {
      var on = has(b.getAttribute("data-wl-id"));
      b.classList.toggle("is-saved", on);
      b.setAttribute("aria-pressed", on ? "true" : "false");
      b.setAttribute("aria-label", on ? "Saved — remove from wishlist" : "Save to wishlist");
    });
  }
  btns.forEach(function (b) {
    b.addEventListener("click", function (e) {
      e.preventDefault(); e.stopPropagation();
      var id = b.getAttribute("data-wl-id"), l = read(), i = -1, k;
      for (k = 0; k < l.length; k++) { if (String(l[k].id) === String(id)) { i = k; break; } }
      if (i >= 0) { l.splice(i, 1); }
      else {
        l.unshift({ id: id, title: b.getAttribute("data-wl-title"), url: b.getAttribute("data-wl-url"), image: b.getAttribute("data-wl-image"), price: b.getAttribute("data-wl-price") });
        b.classList.remove("just-saved"); void b.offsetWidth; b.classList.add("just-saved");
      }
      write(l); paint();
    });
  });
  window.addEventListener("dyn-wishlist-change", paint);
  window.addEventListener("storage", function (e) { if (e.key === KEY) paint(); });
  paint();
})();
</script>

<script>
/* 3D card tilt: each card leans toward the cursor (max ~7deg) with a slight
   lift, and settles back on leave. Fine pointers only. */
(function () {
  var fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  var TILT = 7;
  document.querySelectorAll(".dyn-col .dc-card").forEach(function (card) {
    if (card.__tilt) return;
    card.__tilt = true;
    card.addEventListener("mousemove", function (e) {
      if (!fine.matches) return;
      var r = card.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      card.style.transform = "perspective(900px) rotateX(" + (-py * TILT).toFixed(2) +
        "deg) rotateY(" + (px * TILT).toFixed(2) + "deg) scale(1.02)";
    });
    card.addEventListener("mouseleave", function () { card.style.transform = ""; });
  });
})();
</script>

