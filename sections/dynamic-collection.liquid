{% # theme-check-disable LiquidComplexity, ExcessiveSettingsCount %}
{% comment %}
  ============================================================================
  Dynamic Collection - Apple-Store-style tabbed product grid
  ----------------------------------------------------------------------------
  INSTALL:
  1. Theme code editor > Sections > Add a new section > name it
     "dynamic-collection" and REPLACE its contents with this whole file.
  2. Online Store > Themes > Customize > switch the template dropdown (top) to
     "Collection". Remove the default product-grid section, then
     Add section > "Dynamic Collection". Save.
  Category tabs sit at the top (built from product type or tag). Selecting a
  tab filters instantly and the grid re-reveals with a left-to-right cascade.
  Works with JS off (all products show, no animation). Cards link to the
  product page so shoppers personalise before adding. No apps required.
  ============================================================================
{% endcomment %}

{{ 'dyn-dc.css' | asset_url | stylesheet_tag }}
<style>

  .dyn-col {
    /* The full-bleed bar backgrounds below span 100vw, which includes the
       scrollbar on Windows browsers — clip the overshoot so the page never
       gets a sideways wiggle. (clip, not hidden: keeps the sticky bar.) */
    overflow-x: clip;
    --bg: #ffffff; --bg-panel: #f5f5f7;
    --ink: #1d1d1f; --ink-soft: #6e6e73; --ink-faint: #86868b;
    --line: #d2d2d7; --accent: #0071e3; --danger: #c0392b;
    --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-head: {% if section.settings.heading_font == 'sans' %}var(--font){% else %}"Cormorant Garamond", Georgia, "Times New Roman", Times, serif{% endif %};
    --cols: {{ section.settings.columns | default: 4 }};
    --ratio: {% case section.settings.image_ratio %}{% when 'square' %}1{% when 'portrait' %}0.8{% when 'landscape' %}1.3{% else %}0.85{% endcase %};
    font-family: var(--font); color: var(--ink); -webkit-font-smoothing: antialiased;
    background: {{ section.settings.page_bg | default: '#f5f5f7' }};
    position: relative;
  }

  .dyn-col, .dyn-col *, .dyn-col *::before, .dyn-col *::after { box-sizing: border-box; }

  /* Paint the whole page the same soft grey so there's no white strip below the grid.
     (This style only loads on pages that use this section.) */
  html, body { background: {{ section.settings.page_bg | default: '#f5f5f7' }}; }

  .dyn-col .dc-search-below.dc-below-open::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; transform: translateX(-50%); width: 100vw; z-index: -1;
    background: {{ section.settings.page_bg | default: '#f5f5f7' }}; box-shadow: 0 10px 20px -8px rgba(0,0,0,0.10); }

  .dyn-col .dc-tabs-wrap::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; transform: translateX(-50%); width: 100vw; z-index: -1;
    background: {{ section.settings.page_bg | default: '#f5f5f7' }}; }

  .dyn-col .dc-tabs.is-pills::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; transform: translateX(-50%); width: 100vw; z-index: -1;
    background: {{ section.settings.page_bg | default: '#f5f5f7' }}; }

  {%- if section.settings.sleeve_image != blank %}
  /* uploaded sleeve artwork replaces the generated textures; the spine
     column goes clear so the artwork's own black strip shows through */
  .dyn-col .dc-card, .dyn-col .dc-card:hover {
    background: url('{{ section.settings.sleeve_image | image_url: width: 900 }}') center / 100% 100% no-repeat;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .dyn-col .dc-body, .dyn-col.dc-fill .dc-body { background: transparent; border-left: none; }

  {%- endif %}


  /* ---- Category tiles: zine stickers - each photo goes inked black &
     white with a white die-cut sticker edge, like a cutout pasted on the
     paper. The sticky bar itself stays plain paper when you scroll (the
     torn-black manifesto strip is gone). ---- */
  .dyn-col .dc-tabs.is-images .dc-tab-img { background: transparent !important; border-radius: 0 !important;
    transition: transform .15s ease; }

  /* the scrolled bar stays paper even if an old copy of the black-bar CSS
     is still loaded somewhere on the page */
  .dyn-col.dc-scrolled .dc-tabs-wrap::before, .dyn-col.dc-scrolled .dc-tabs.is-pills::before {
    background-color: {{ section.settings.page_bg | default: '#f5f5f7' }} !important; background-image: none !important; }

  {%- if section.settings.bar_paper_image != blank %}
  /* uploaded bar artwork: covers the bar and hangs 28px below it, so the
     image's own torn bottom edge (transparent PNG) does the ripping */
  .dyn-col.dc-scrolled .dc-tabs-wrap::before, .dyn-col.dc-scrolled .dc-tabs.is-pills::before {
    bottom: -28px;
    background: url('{{ section.settings.bar_paper_image | image_url: width: 2800 }}') center top / 100% 100% no-repeat !important;
  }

  .dyn-col.dc-scrolled .dc-tabs-wrap::after, .dyn-col.dc-scrolled .dc-tabs.is-pills::after { display: none; }

  /* on uploaded (light) paper the bar's type goes back to black ink */
  .dyn-col.dc-scrolled .dc-tabs.is-pills .dc-tab { color: rgba(20, 17, 16, 0.72); }

  .dyn-col.dc-scrolled .dc-tabs.is-pills .dc-tab:hover { color: #141110; background: rgba(0, 0, 0, 0.06); }

  .dyn-col.dc-scrolled .dc-tabs.is-pills .dc-tab.is-active { background: #141110; color: #f5f3ef; }

  .dyn-col.dc-scrolled .dc-tabs.is-images .dc-tab-label { color: rgba(20, 17, 16, 0.72); }

  .dyn-col.dc-scrolled .dc-tabs.is-images .dc-tab:hover .dc-tab-label,
  .dyn-col.dc-scrolled .dc-tabs.is-images .dc-tab.is-active .dc-tab-label { color: #141110; opacity: 1; }

  .dyn-col.dc-scrolled .dc-search-trigger .dc-tab-label,
  .dyn-col.dc-scrolled .dc-search-trigger[aria-expanded="true"] .dc-tab-label { color: #141110; }

  .dyn-col.dc-scrolled .dc-tabs.is-images .dc-tab-init { color: rgba(20, 17, 16, 0.8); }

  .dyn-col.dc-scrolled .dc-tabs.is-images .dc-tab-all svg { fill: rgba(20, 17, 16, 0.8); }

  {%- endif %}
  /* the names under the category images are hidden - the uploaded
     word-art IS the label. The text stays in the markup, visually
     hidden, so screen readers still announce each tab. */
  .dyn-col .dc-tabs.is-images .dc-tab-label {
    position: absolute !important; width: 1px !important; height: 1px !important;
    margin: -1px !important; padding: 0 !important; border: 0 !important;
    clip: rect(0 0 0 0) !important; overflow: hidden !important; white-space: nowrap !important;
    background: none !important; box-shadow: none !important; text-shadow: none !important; }

  /* category stickers 25% bigger (74px -> 92px desktop, 59px -> 74px phones) */
  .dyn-col .dc-tabs.is-images .dc-tab-img { width: 92px; height: 92px; }

  .dyn-col .dc-card { box-shadow: 0 2px 3px rgba(20,17,16,0.14), 0 14px 28px -10px rgba(20,17,16,0.3), 0 34px 64px -30px rgba(20,17,16,0.35) !important; }

  /* minimalist editorial category navigation: printed-label type, no pictures */
  .dyn-col .dc-tabs.is-images .dc-tab-img { display: none !important; }

  .dyn-col .dc-tabs.is-images .dc-tab-label { position: static !important; width: auto !important; height: auto !important;
    margin: 0 !important; padding: 7px 1px !important; clip: auto !important; overflow: visible !important; white-space: nowrap !important;
    font-size: 11.5px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(20,17,16,0.5) !important; background: none !important; box-shadow: none !important; text-shadow: none !important;
    border-bottom: 2px solid transparent; }

  .dyn-col.dc-scrolled .dc-tabs-wrap::before, .dyn-col.dc-scrolled .dc-tabs.is-pills::before {
    background: rgba(246, 245, 241, 0.93) !important;
    -webkit-backdrop-filter: blur(10px) saturate(1.05); backdrop-filter: blur(10px) saturate(1.05);
    border-bottom: 1px solid rgba(20, 17, 16, 0.12);
    box-shadow: 0 12px 26px -20px rgba(20, 17, 16, 0.4); }

  /* refined link interactions: colour + a breath of letter-spacing, no scaling */
  .dyn-col .dc-tabs.is-images .dc-tab-label { transition: color 0.25s ease, letter-spacing 0.25s ease, border-color 0.25s ease; }
</style>

{%- comment -%} Match the store theme's heading font when it exposes one (Dawn & most modern themes). {%- endcomment -%}
{%- if settings.type_header_font -%}
  <style>
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .dyn-col .dc-grid-heading { font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      font-weight: {{ settings.type_header_font.weight }}; font-style: {{ settings.type_header_font.style }}; }
  </style>
{%- endif -%}

{%- assign coll = section.settings.collection | default: collection -%}
{%- if coll == blank and collection != blank -%}{%- assign coll = collection -%}{%- endif -%}
{%- assign cat_source = section.settings.category_source | default: 'type' -%}

<section class="dyn-col{% if section.settings.hide_until_search %} dc-landing{% endif %}{% if section.settings.image_bg %} dc-fill{% endif %}{% unless section.settings.blend_images == false %} dc-blend{% endunless %}" id="dynCol"
  data-currency="{{ shop.currency }}"
  data-cat-source="{{ cat_source }}"
  data-top-best="{% if section.settings.top_bestsellers_only %}true{% else %}false{% endif %}"
  data-hide-until-search="{% if section.settings.hide_until_search %}true{% else %}false{% endif %}"
  data-results-url="{{ section.settings.results_page_url }}">
  {%- comment -%} Back button removed here — the site-wide “Account & apps bar” now provides the back button. {%- endcomment -%}
  {%- if false -%}
    <a class="dc-back" href="{{ section.settings.back_url | default: routes.root_url }}" aria-label="Back to home">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    </a>
  {%- endif -%}
  {%- if section.settings.hide_until_search -%}
    {%- if section.settings.corner_tl_label != blank -%}<a class="dc-corner dc-corner-tl" href="{{ section.settings.corner_tl_url | default: '#' }}">{{ section.settings.corner_tl_label }}</a>{%- endif -%}
    {%- if section.settings.corner_tr_label != blank -%}<a class="dc-corner dc-corner-tr" href="{{ section.settings.corner_tr_url | default: '#' }}">{{ section.settings.corner_tr_label }}</a>{%- endif -%}
    {%- if section.settings.corner_bl_label != blank -%}<a class="dc-corner dc-corner-bl" href="{{ section.settings.corner_bl_url | default: '#' }}">{{ section.settings.corner_bl_label }}</a>{%- endif -%}
    {%- if section.settings.corner_br_label != blank -%}<a class="dc-corner dc-corner-br" href="{{ section.settings.corner_br_url | default: '#' }}">{{ section.settings.corner_br_label }}</a>{%- endif -%}
  {%- endif -%}
  <div class="dc-wrap">
    <div class="dc-head">
      {%- assign dc_logo = section.settings.heading_logo | default: settings.logo -%}
      {%- if section.settings.head_video != blank -%}
        <video class="dc-head-video" autoplay muted playsinline preload="metadata"
          {% if section.settings.head_video.preview_image %}poster="{{ section.settings.head_video.preview_image | image_url: width: 800 }}"{% endif %}>
          {%- for source in section.settings.head_video.sources -%}
            {%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}
          {%- endfor -%}
        </video>
      {%- elsif dc_logo != blank -%}
        {%- assign hlw = dc_logo.width | times: 56 | divided_by: dc_logo.height -%}
        <a href="{{ routes.root_url }}" class="dc-head-logo-link" aria-label="{{ shop.name | escape }} — home"><img class="dc-head-logo" style="--dyn-lw: {{ settings.logo_width | default: 140 }}px" src="{{ dc_logo | image_url: width: 700 }}" alt="{{ shop.name | escape }}" width="{{ hlw }}" height="56"></a>
      {%- else -%}
        <h1>{{ section.settings.heading | default: coll.title | default: 'Store' }}</h1>
      {%- endif -%}
      {%- if section.settings.show_description and coll.description != blank -%}
        <div class="dc-desc">{{ coll.description | strip_html | truncatewords: 40 }}</div>
      {%- endif -%}
    </div>

    {%- assign prods = coll.products -%}
    {%- if prods.size == 0 -%}
      <div class="dc-empty">
        <p>{{ section.settings.empty_text | default: 'Nothing here yet.' }}</p>
        <a href="{{ routes.all_products_collection_url }}">{{ section.settings.empty_link_label | default: 'Browse all products' }}</a>
      </div>
    {%- else -%}
      {%- if section.settings.show_search -%}
        {%- capture dc_search_html -%}<div class="dc-search{% unless section.settings.show_search_button %} dc-nogo{% endunless %}" id="dcSearchBar">
          <span class="dc-search-mag" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
          <input type="search" id="dcSearch" class="dc-search-input" autocomplete="off" aria-label="Search products"
            data-typing="{{ section.settings.search_examples | escape }}"
            placeholder="{{ section.settings.search_placeholder | default: 'Search these products…' }}">
          {%- if section.settings.show_search_button -%}
          <button type="button" class="dc-search-go" id="dcSearchGo" aria-label="Search">
            <span class="dc-go-ic dc-go-back"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
            <span class="dc-go-ic dc-go-up"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg></span>
            <span class="dc-go-ic dc-go-check"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
          {%- endif -%}
        </div>{%- endcapture -%}
        {%- assign tab_block_count = 0 -%}
        {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}{%- assign tab_block_count = tab_block_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- assign dc_has_img_tabs = false -%}{%- if section.settings.show_tabs and tab_block_count > 0 -%}{%- assign dc_has_img_tabs = true -%}{%- endif -%}
        {%- unless dc_has_img_tabs -%}{{ dc_search_html }}{%- endunless -%}
        {%- assign show_b1 = false -%}{%- if section.settings.show_btn1 and section.settings.btn1_label != blank -%}{%- assign show_b1 = true -%}{%- endif -%}
        {%- assign show_b2 = false -%}{%- if section.settings.show_btn2 and section.settings.btn2_label != blank -%}{%- assign show_b2 = true -%}{%- endif -%}
        {%- if show_b1 or show_b2 -%}
          <div class="dc-hero-btns">
            {%- if show_b1 -%}<a class="dc-gbtn" href="{{ section.settings.btn1_url | default: '#' }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
            {%- if show_b2 -%}<a class="dc-gbtn" href="{{ section.settings.btn2_url | default: '#' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
      {%- comment -%} Build the category tabs from product type or tag. {%- endcomment -%}
      {%- if cat_source == 'tag' -%}
        {%- assign cats = coll.all_tags -%}
      {%- else -%}
        {%- assign cats = coll.all_types -%}
      {%- endif -%}

      {%- assign real_cats = '' -%}
      {%- for c in cats -%}{%- if c != blank -%}{%- assign real_cats = real_cats | append: '1' -%}{%- endif -%}{%- endfor -%}

      {%- if section.settings.show_tabs and tab_block_count > 0 -%}
        {%- comment -%} Image tabs: merchant-defined blocks with an uploaded picture per category. {%- endcomment -%}
        <div class="dc-tabs-wrap" id="dcTabsWrap">
        {%- if dc_logo != blank -%}
          {%- assign bar_lw = dc_logo.width | times: 40 | divided_by: dc_logo.height -%}
          <a href="{{ routes.root_url }}" class="dc-bar-logo" id="dcBarLogo" aria-label="{{ shop.name | escape }} — home">
            <img src="{{ dc_logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="{{ bar_lw }}" height="40" loading="lazy">
          </a>
        {%- endif -%}
        {%- if section.settings.show_search -%}
        <div class="dc-inline-search" id="dcInlineSearch">
          <span class="dc-inline-mag" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
          <input type="search" class="dc-inline-input" id="dcInlineInput" autocomplete="off" aria-label="Search products"
            placeholder="{{ section.settings.search_placeholder | default: 'Search…' }}">
        </div>
        {%- endif -%}
        <button type="button" class="dc-tabs-arrow dc-prev" id="dcPrev" aria-label="Scroll categories left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
        <div class="dc-tabs is-images" id="dcTabs" role="tablist">
          {%- if section.settings.show_search -%}
          <button type="button" class="dc-tab dc-search-trigger" id="dcSearchTrigger" aria-label="Search" aria-expanded="false">
            <span class="dc-tab-img dc-tab-all">
              {%- if section.settings.search_image != blank -%}
                <img src="{{ section.settings.search_image | image_url: width: 200 }}" alt="Search" width="68" height="68" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              {%- endif -%}
            </span>
            <span class="dc-tab-label">Search</span>
          </button>
          {%- endif -%}
          {%- if section.settings.show_all_tab -%}
          <button type="button" class="dc-tab is-active" data-cat="__all" role="tab" aria-selected="true">
            <span class="dc-tab-img dc-tab-all">
              {%- if section.settings.all_image != blank -%}
                <img src="{{ section.settings.all_image | image_url: width: 200 }}" alt="{{ section.settings.all_label | default: 'All' | escape }}" width="68" height="68" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
              {%- endif -%}
            </span>
            <span class="dc-tab-label">{{ section.settings.all_label | default: 'All' }}</span>
          </button>
          {%- endif -%}
          {%- assign tab_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- unless block.type == 'tab' -%}{%- continue -%}{%- endunless -%}
            {%- assign tab_i = tab_i | plus: 1 -%}
            {%- assign cv = block.settings.category_value -%}
            {%- assign first_active = false -%}
            {%- if section.settings.show_all_tab == false and tab_i == 1 -%}{%- assign first_active = true -%}{%- endif -%}
            <button type="button" class="dc-tab{% if first_active %} is-active{% endif %}" data-cat="{{ cv | handle }}" role="tab" aria-selected="{% if first_active %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
              <span class="dc-tab-img">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.label | escape }}" width="68" height="68" loading="lazy">
                {%- else -%}
                  <span class="dc-tab-init">{{ block.settings.label | default: cv | slice: 0 | upcase }}</span>
                {%- endif -%}
              </span>
              <span class="dc-tab-label">{{ block.settings.label | default: cv }}</span>
            </button>
          {%- endfor -%}
        </div>
        <button type="button" class="dc-tabs-arrow dc-next" id="dcNext" aria-label="Scroll categories right" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
        </div>
      {%- elsif section.settings.show_tabs and real_cats != blank -%}
        {%- comment -%} Auto text-pill tabs from product type / tag. {%- endcomment -%}
        <div class="dc-tabs is-pills" id="dcTabs" role="tablist">
          {%- if section.settings.show_all_tab -%}
          <button type="button" class="dc-tab is-active" data-cat="__all" role="tab" aria-selected="true">{{ section.settings.all_label | default: 'All' }}</button>
          {%- endif -%}
          {%- assign shown_i = 0 -%}
          {%- for c in cats -%}
            {%- unless c == blank -%}
              {%- assign shown_i = shown_i | plus: 1 -%}
              {%- assign first_active = false -%}
              {%- if section.settings.show_all_tab == false and shown_i == 1 -%}{%- assign first_active = true -%}{%- endif -%}
              <button type="button" class="dc-tab{% if first_active %} is-active{% endif %}" data-cat="{{ c | handle }}" role="tab" aria-selected="{% if first_active %}true{% else %}false{% endif %}">{{ c }}</button>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_search and dc_has_img_tabs -%}
        <div class="dc-search-below" id="dcSearchBelow">{{ dc_search_html }}</div>
      {%- endif -%}

      {%- comment -%} Per-tab hero banners, sorted into a TOP set (right under
          the tabs) and a BOTTOM set (below the products) by each block's
          Position setting. Same slider chrome for both. {%- endcomment -%}
      {%- assign heros_top = '' -%}
      {%- assign heros_bottom = '' -%}
      {%- for block in section.blocks -%}
          {%- unless block.type == 'tab_banner' -%}{%- continue -%}{%- endunless -%}
          {%- assign hfor = '' -%}
          {%- assign hfor_raw = block.settings.show_for | default: '' | strip -%}
          {%- if hfor_raw != '' -%}
            {%- assign hfor_parts = hfor_raw | split: ',' -%}
            {%- for hp in hfor_parts -%}
              {%- assign hph = hp | strip | handle -%}
              {%- if hph == 'all' -%}{%- assign hph = '__all' -%}{%- endif -%}
              {%- if hph != '' -%}
                {%- if hfor == '' -%}{%- assign hfor = hph -%}{%- else -%}{%- assign hfor = hfor | append: ' ' | append: hph -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- capture dc_hero_one -%}
          <div class="dc-tabhero" data-for="{{ hfor }}" style="background: {{ block.settings.bg_color | default: '#eef1f6' }}; color: {{ block.settings.text_color | default: '#0b1c33' }};" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img class="dc-tabhero-bg" src="{{ block.settings.image | image_url: width: 2400 }}" alt="" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
            {%- endif -%}
            <div class="dc-tabhero-txt">
              {%- if block.settings.kicker != blank -%}
                <p class="dc-tabhero-kick"{% if block.settings.kicker_color != blank %} style="color: {{ block.settings.kicker_color }}"{% endif %}>{{ block.settings.kicker }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}<h2 class="dc-tabhero-title"{% if block.settings.heading_color != blank %} style="color: {{ block.settings.heading_color }}"{% endif %}>{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.subtext != blank -%}<p class="dc-tabhero-sub">{{ block.settings.subtext }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a class="dc-tabhero-btn" href="{{ block.settings.button_link }}" style="background: {{ block.settings.button_bg | default: '#0a0a0a' }}; color: {{ block.settings.button_text | default: '#ffffff' }};">{{ block.settings.button_label }}</a>
              {%- endif -%}
            </div>
          </div>
          {%- endcapture -%}
          {%- assign hpos = block.settings.pos | default: 'top' -%}
          {%- if hpos == 'bottom' -%}
            {%- assign heros_bottom = heros_bottom | append: dc_hero_one -%}
          {%- else -%}
            {%- assign heros_top = heros_top | append: dc_hero_one -%}
          {%- endif -%}
      {%- endfor -%}
      {%- if heros_top != '' -%}
        <div id="dcTabHeros" class="dc-tabheros">
          {{ heros_top }}
          <button type="button" class="dc-tabhero-arrow dc-prev" id="dcHeroPrev" aria-label="Previous banner" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
          <button type="button" class="dc-tabhero-arrow dc-next" id="dcHeroNext" aria-label="Next banner" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
          <div class="dc-tabhero-dots" id="dcHeroDots" aria-hidden="true" hidden></div>
        </div>
      {%- endif -%}

      {%- assign hide_tag = section.settings.hide_tag | default: 'hidden' -%}
      {%- capture dc_cards_html -%}
        {%- for product in prods limit: section.settings.max_products -%}
          {%- if product.tags contains hide_tag -%}{%- continue -%}{%- endif -%}
          {%- assign on_sale = false -%}
          {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}

          {%- comment -%} Best-seller badge: by tag, and/or the top N when the collection is sorted by Best selling. {%- endcomment -%}
          {%- assign is_best = false -%}
          {%- if section.settings.show_bestseller -%}
            {%- assign bs_tag = section.settings.bestseller_tag | default: 'bestseller' | downcase | strip -%}
            {%- for t in product.tags -%}
              {%- assign tl = t | downcase | strip -%}
              {%- if tl == bs_tag -%}{%- assign is_best = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- assign bs_top = section.settings.bestseller_top | default: 0 -%}
            {%- if bs_top > 0 and forloop.index <= bs_top -%}{%- assign is_best = true -%}{%- endif -%}
          {%- endif -%}

          {%- comment -%} New badge: shows for a set number of days after the product was published, then disappears on its own. {%- endcomment -%}
          {%- assign is_new = false -%}
          {%- if section.settings.show_new -%}
            {%- assign new_days = section.settings.new_days | default: 14 -%}
            {%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
            {%- assign pub_s = product.published_at | date: '%s' | plus: 0 -%}
            {%- if pub_s > 0 -%}
              {%- assign age_days = now_s | minus: pub_s | divided_by: 86400 -%}
              {%- if age_days <= new_days -%}{%- assign is_new = true -%}{%- endif -%}
            {%- endif -%}
          {%- endif -%}

          {%- if cat_source == 'tag' -%}
            {%- capture card_cat -%}{% for tag in product.tags %}{{ tag | handle }} {% endfor %}{%- endcapture -%}
          {%- else -%}
            {%- assign card_cat = product.type | handle -%}
          {%- endif -%}

          {%- assign img2 = blank -%}
          {%- if product.images.size > 1 -%}{%- assign img2 = product.images[1] -%}{%- endif -%}

          {%- capture card_search -%}{{ product.title }} {{ product.type }} {{ product.vendor }} {% for t in product.tags %}{{ t }} {% endfor %}{% for opt in product.options_with_values %}{{ opt.name }} {% for v in opt.values %}{{ v }} {% endfor %}{% endfor %}{%- endcapture -%}
          <div class="dc-card" data-cat="{{ card_cat | strip }}" data-flags="{% if is_new %}new {% endif %}{% if is_best %}best {% endif %}{% if on_sale %}sale {% endif %}" data-search="{{ card_search | downcase | strip_newlines | escape }}" data-price="{{ product.price }}" data-url="{{ product.url }}" data-thumb="{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 }}{% endif %}">
            <div class="dc-media-wrap">
            <a class="dc-media" href="{{ product.url }}">
              <div class="dc-badges">
                {%- if is_new -%}
                  <span class="dc-badge dc-badge-new">{{ section.settings.new_label | default: 'New' }}</span>
                {%- endif -%}
                {%- if is_best -%}
                  <span class="dc-badge dc-badge-best"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9z"/></svg>{{ section.settings.bestseller_label | default: 'Best seller' }}</span>
                {%- endif -%}
                {%- if on_sale -%}
                  {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                  <span class="dc-badge dc-badge-sale">Save {{ pct }}%</span>
                {%- endif -%}
                {%- unless product.available -%}<span class="dc-badge dc-badge-soldout">Sold out</span>{%- endunless -%}
              </div>
              {%- if product.featured_image -%}
                <img class="dc-img-1{% if img2 != blank %} has-2{% endif %}" src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}" width="600" height="600" loading="lazy">
                {%- if img2 != blank -%}
                  <img class="dc-img-2" src="{{ img2 | image_url: width: 600 }}" alt="" width="600" height="600" loading="lazy" aria-hidden="true">
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'dc-img-1 dc-ph' }}
              {%- endif -%}
            </a>
            </div>
            {%- comment -%} Save button lives on the card (not the image) so it can pin to the card's top-right corner in every layout. {%- endcomment -%}
            <button type="button" class="dc-save" aria-label="Save to wishlist" aria-pressed="false"
              data-wl-id="{{ product.handle }}"
              data-wl-title="{{ product.title | escape }}"
              data-wl-url="{{ product.url }}"
              data-wl-image="{{ product.featured_image | image_url: width: 400 }}"
              data-wl-price="{{ product.price | money_without_trailing_zeros }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-5-7 5V4a1 1 0 0 1 1-1Z"/></svg>
            </button>

            <div class="dc-body">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <div class="dc-vendor">{{ product.vendor }}</div>
              {%- endif -%}
              <h3 class="dc-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="dc-price">
                <span class="dc-now{% if on_sale %} on-sale{% endif %}">{{ product.price | money_without_trailing_zeros }}</span>
                {%- if on_sale -%}<span class="dc-was">{{ product.compare_at_price | money_without_trailing_zeros }}</span>{%- endif -%}
              </div>

              {%- if section.settings.show_swatches -%}
                {%- assign color_opt = blank -%}
                {%- for o in product.options_with_values -%}
                  {%- assign on = o.name | downcase -%}
                  {%- if on contains 'color' or on contains 'colour' -%}{%- assign color_opt = o -%}{%- endif -%}
                {%- endfor -%}
                {%- if color_opt != blank -%}
                  <div class="dc-swatches">
                    {%- assign shown = 0 -%}
                    {%- assign cidx = color_opt.position | minus: 1 -%}
                    {%- for val in color_opt.values -%}
                      {%- if shown < 5 -%}
                        {%- assign vimg = '' -%}
                        {%- for v in product.variants -%}
                          {%- assign optval = v.options[cidx] -%}
                          {%- if optval == val and v.image -%}{%- assign vimg = v.image | image_url: width: 600 -%}{%- break -%}{%- endif -%}
                        {%- endfor -%}
                        <button type="button" class="dc-swatch" data-color="{{ val | escape }}" data-img="{{ vimg }}"
                          title="{{ val | escape }}" aria-label="{{ val | escape }}"></button>
                        {%- assign shown = shown | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign extra = color_opt.values.size | minus: 5 -%}
                    {%- if extra > 0 -%}<span class="dc-swatch-more">+{{ extra }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
              {%- if section.settings.show_buy_link -%}
                <a class="dc-buy" href="{{ product.url }}">{{ section.settings.buy_label | default: 'Open' }} <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endcapture -%}
      {%- comment -%} ------------------------------------------------------------------
           Best-seller row + promo banners are each captured, then printed in the
           order of the blocks below. Add a "Popular products row" block and drag it
           above or below your banner blocks to move the row. If no such block has
           been added yet, the row still shows first (unchanged behaviour).
           --------------------------------------------------------------------- {%- endcomment -%}
      {%- assign row_heading = section.settings.grid_heading -%}
      {%- for b in section.blocks -%}
        {%- if b.type == 'product_row' and b.settings.heading != blank -%}{%- assign row_heading = b.settings.heading -%}{%- endif -%}
      {%- endfor -%}
      {%- capture dc_shelf_html -%}
        {%- if row_heading != blank -%}<h2 class="dc-grid-heading">{{ row_heading }}</h2>{%- endif -%}
        <div class="dc-shelf-wrap" id="dcShelfWrap">
        <button type="button" class="dc-shelf-arrow dc-prev" id="dcGridPrev" aria-label="Scroll products left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
        <div class="dc-grid" id="dcGrid">{{ dc_cards_html }}</div>
        <button type="button" class="dc-shelf-arrow dc-next" id="dcGridNext" aria-label="Scroll products right" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
        </div>
        {%- if section.settings.show_scrollbar -%}
          <div class="dc-scrollbar" id="dcScrollbar"><div class="dc-scrollbar-thumb" id="dcScrollThumb"></div></div>
        {%- endif -%}
      {%- endcapture -%}

      {%- comment -%} Editable promo banners — bento-grid tiles, captured as one group. {%- endcomment -%}
      {%- comment -%} Tiles sort into a TOP set (in block order, as before) and
          a BOTTOM set (below the products) via each block's Position. {%- endcomment -%}
      {%- assign banners_top = '' -%}
      {%- assign banners_bottom = '' -%}
      {%- for block in section.blocks -%}
            {%- unless block.type == 'banner' -%}{%- continue -%}{%- endunless -%}
            {%- assign bsize = block.settings.size | default: 'sm' -%}
            {%- comment -%} Always fill the tile (full-bleed). {%- endcomment -%}
            {%- assign bimg = 'cover' -%}
            {%- assign bink = block.settings.text_color | default: '#17223b' -%}
            {%- assign bbg = block.settings.bg_color | default: '#eef1f5' -%}
            {%- assign bcls = 'dc-banner dc-banner--' | append: bsize | append: ' dc-banner--' | append: bimg -%}
            {%- if block.settings.scrim and block.settings.image != blank and bimg == 'cover' -%}{%- assign bcls = bcls | append: ' dc-banner--shade' -%}{%- endif -%}
            {%- capture banner_inner -%}
              <div class="dc-banner-txt">
                {%- if block.settings.kicker != blank -%}<span class="dc-banner-kicker">{{ block.settings.kicker }}</span>{%- endif -%}
                {%- if block.settings.heading != blank -%}<span class="dc-banner-title">{{ block.settings.heading }}</span>{%- endif -%}
                {%- if block.settings.heading2 != blank -%}<span class="dc-banner-title dc-banner-title2"{% if block.settings.accent_color != blank %} style="color:{{ block.settings.accent_color }}"{% endif %}>{{ block.settings.heading2 }}</span>{%- endif -%}
                {%- if block.settings.subtext != blank -%}<span class="dc-banner-sub">{{ block.settings.subtext }}</span>{%- endif -%}
                {%- if block.settings.button_label != blank -%}<span class="dc-banner-cta">{{ block.settings.button_label }}</span>{%- endif -%}
              </div>
              {%- if block.settings.image != blank -%}
                <img class="dc-banner-img" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.heading | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
              {%- endif -%}
            {%- endcapture -%}
            {%- comment -%} Per-tab scoping: empty = every tab; "All" = the All
                tab; otherwise a comma list of category values (handleized so
                they compare with the tabs' data-cat). {%- endcomment -%}
            {%- assign bfor = '' -%}
            {%- assign bfor_raw = block.settings.show_for | default: '' | strip -%}
            {%- if bfor_raw != '' -%}
              {%- assign bfor_parts = bfor_raw | split: ',' -%}
              {%- for bp in bfor_parts -%}
                {%- assign bph = bp | strip | handle -%}
                {%- if bph == 'all' -%}{%- assign bph = '__all' -%}{%- endif -%}
                {%- if bph != '' -%}
                  {%- if bfor == '' -%}{%- assign bfor = bph -%}{%- else -%}{%- assign bfor = bfor | append: ' ' | append: bph -%}{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- capture dc_banner_one -%}
            {%- if block.settings.link != blank -%}
              <a class="{{ bcls }}" href="{{ block.settings.link }}" data-for="{{ bfor }}" style="background:{{ bbg }};color:{{ bink }};" {{ block.shopify_attributes }}>{{ banner_inner }}</a>
            {%- else -%}
              <div class="{{ bcls }}" data-for="{{ bfor }}" style="background:{{ bbg }};color:{{ bink }};" {{ block.shopify_attributes }}>{{ banner_inner }}</div>
            {%- endif -%}
            {%- endcapture -%}
            {%- assign bpos = block.settings.pos | default: 'top' -%}
            {%- if bpos == 'bottom' -%}
              {%- assign banners_bottom = banners_bottom | append: dc_banner_one -%}
            {%- else -%}
              {%- assign banners_top = banners_top | append: dc_banner_one -%}
            {%- endif -%}
      {%- endfor -%}
      {%- capture dc_banners_html -%}
      {%- if banners_top != '' -%}
        {%- if section.settings.banners_heading != blank -%}
          <h2 class="dc-grid-heading dc-banners-heading">{{ section.settings.banners_heading }}</h2>
        {%- endif -%}
        <div class="dc-banners-wrap" id="dcBannersWrap">
        <div class="dc-banners" id="dcBanners">{{ banners_top }}</div>
        </div>
      {%- endif -%}
      {%- endcapture -%}

      {%- comment -%} Print the row + banners in block order. {%- endcomment -%}
      {%- assign has_row_block = false -%}
      {%- for b in section.blocks -%}{%- if b.type == 'product_row' -%}{%- assign has_row_block = true -%}{%- endif -%}{%- endfor -%}
      {%- comment -%} The row now shows ONLY when a "Popular products row" block is
           added. When it isn't, the shelf is still emitted but kept hidden (off the
           page) because the search / grid script relies on #dcGrid existing. {%- endcomment -%}
      {%- unless has_row_block -%}<div class="dc-shelf-hidden" style="display:none" aria-hidden="true">{{ dc_shelf_html }}</div>{%- endunless -%}
      {%- assign banners_done = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_row' -%}
          {{ dc_shelf_html }}
        {%- elsif block.type == 'banner' and banners_done == false -%}
          {{ dc_banners_html }}
          {%- assign banners_done = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.show_all_grid -%}
        {%- if section.settings.all_heading != blank -%}
          <h2 class="dc-grid-heading dc-allgrid-heading">{{ section.settings.all_heading }}</h2>
        {%- endif -%}
        <div class="dc-allwrap">
          <button type="button" class="dc-all-arrow dc-prev" id="dcAllPrev" aria-label="Scroll products left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
          <div class="dc-gridall" id="dcGridAll">{{ dc_cards_html }}</div>
          <button type="button" class="dc-all-arrow dc-next" id="dcAllNext" aria-label="Scroll products right" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
        </div>
      {%- endif -%}
      {%- comment -%} Bottom-position hero slider and promo tiles. {%- endcomment -%}
      {%- if heros_bottom != '' -%}
        <div id="dcTabHerosB" class="dc-tabheros dc-tabheros--bottom">
          {{ heros_bottom }}
          <button type="button" class="dc-tabhero-arrow dc-prev" id="dcHeroPrevB" aria-label="Previous banner" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
          <button type="button" class="dc-tabhero-arrow dc-next" id="dcHeroNextB" aria-label="Next banner" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
          <div class="dc-tabhero-dots" id="dcHeroDotsB" aria-hidden="true" hidden></div>
        </div>
      {%- endif -%}
      {%- if banners_bottom != '' -%}
        <div class="dc-banners-wrap" id="dcBannersWrapB">
        <div class="dc-banners">{{ banners_bottom }}</div>
        </div>
      {%- endif -%}
      <div class="dc-noresults" id="dcNoResults">
        <svg class="dc-nr-face" viewBox="0 0 48 48" aria-hidden="true"><circle cx="18" cy="20" r="2" fill="currentColor"/><circle cx="30" cy="20" r="2" fill="currentColor"/><path class="dc-nr-mouth" d="M15 30 Q24 23 33 30" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        <p class="dc-nr-title">{{ section.settings.noresults_title | default: 'No matches — yet.' }}</p>
        <p class="dc-nr-dym" id="dcDym" hidden>Did you mean <button type="button" id="dcDymBtn"></button>?</p>
        <p class="dc-nr-msg">{{ section.settings.noresults_message | default: "Can't find what you're looking for? Tell us what you had in mind — we might still be able to make it." }}</p>
        <a class="dc-nr-btn" href="{{ section.settings.noresults_url | default: '/pages/contact' }}">{{ section.settings.noresults_link_label | default: 'Contact us' }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<noscript>
  <style>.dyn-col .dc-grid .dc-card { opacity: 1 !important; transform: none !important; }</style>
</noscript>

<script type="application/json" id="dcSmartCfg">
{
  "synonyms": {{ section.settings.search_synonyms | default: '' | json }},
  "fb": {{ section.settings.search_fb_url | default: '' | json }},
  "cheap": {{ section.settings.cheap_price | default: 25 | times: 100 }}
}
</script>

<script src="{{ 'dyn-dc-1.js' | asset_url }}"></script>

<script src="{{ 'dyn-dc-2.js' | asset_url }}"></script>

<script src="{{ 'dyn-dc-3.js' | asset_url }}"></script>

<script src="{{ 'dyn-dc-4.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Dynamic Collection",
  "tag": "section",
  "class": "dynamic-collection-section",
  "settings": [
    { "type": "image_picker", "id": "sleeve_image", "label": "Card sleeve artwork", "info": "Optional worn-sleeve image used as every card's background. Use artwork with the black spine strip on the right (about a quarter of the width) so the title column lines up. Leave empty for the built-in generated texture." },
    { "type": "image_picker", "id": "bar_paper_image", "label": "Scrolled bar paper", "info": "Optional artwork for the sticky bar once the page is scrolled. Use a wide PNG around 2800\u00d7280px: solid paper texture on top, a torn bottom edge with transparency below it \u2014 the bottom ~60px hang under the bar as the rip. Leave empty for the built-in torn black paper." },
    { "type": "header", "content": "Content" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty on a Collection template to use the current collection automatically." },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave empty to use the collection title." },
    { "type": "image_picker", "id": "heading_logo", "label": "Logo instead of heading", "info": "Leave blank to use the logo from Theme settings → Logo (uploaded once for the whole site)." },
    { "type": "video", "id": "head_video", "label": "Video instead of logo", "info": "Plays muted on loop in place of the logo/heading. Takes priority over the logo when set." },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif",
      "options": [ { "value": "serif", "label": "Elegant serif (matches store)" }, { "value": "sans", "label": "Clean sans" } ] },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },

    { "type": "header", "content": "Search box" },
    { "type": "checkbox", "id": "show_search", "label": "Show live search box", "default": true, "info": "Filters the products already on this page as the shopper types — no page reload." },
    { "type": "checkbox", "id": "hide_until_search", "label": "Hide the grid until someone searches", "default": false, "info": "Great for the home page: only the search box shows; the products appear once the shopper types." },
    { "type": "url", "id": "results_page_url", "label": "Show results on another page (URL)", "info": "Optional. Paste your Shop page URL (e.g. /collections/shop). When set, pressing Enter here opens that page with the results instead of filtering in place. Leave empty to filter on this page." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search these products…" },
    { "type": "checkbox", "id": "show_search_button", "label": "Show the arrow button inside the search bar", "default": true },
    { "type": "textarea", "id": "search_examples", "label": "Typing examples", "info": "One phrase per line. They type out in the search box one after another. Clear to turn the effect off.", "default": "I'm shopping for my wife.\nI'm looking for a birthday gift.\nI need a gift for my mom.\nI'm shopping for my dad.\nI want a gift for my best friend.\nI'm buying a gift for my boyfriend.\nI need an anniversary gift.\nI'm shopping for my daughter.\nI want something personalized.\nI'm looking for a unique gift.\nI need a Christmas gift.\nI'm shopping for a coworker.\nI want a custom mug.\nI'm shopping for myself.\nI'm not sure what to buy." },

    { "type": "header", "content": "Home corners (Google-style, landing only)" },
    { "type": "paragraph", "content": "Four links, one in each corner. Only show when 'Hide grid until search' is on. Leave a label empty to hide that corner." },
    { "type": "text", "id": "corner_tl_label", "label": "Top-left label", "default": "About" },
    { "type": "url", "id": "corner_tl_url", "label": "Top-left link" },
    { "type": "text", "id": "corner_tr_label", "label": "Top-right label", "default": "Log in" },
    { "type": "url", "id": "corner_tr_url", "label": "Top-right link" },
    { "type": "text", "id": "corner_bl_label", "label": "Bottom-left label", "default": "Contact" },
    { "type": "url", "id": "corner_bl_url", "label": "Bottom-left link" },
    { "type": "text", "id": "corner_br_label", "label": "Bottom-right label", "default": "Terms" },
    { "type": "url", "id": "corner_br_url", "label": "Bottom-right link" },

    { "type": "header", "content": "Category tabs" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show category tabs", "default": true, "info": "Turn off to hide the category row (e.g. on the home page)." },
    { "type": "select", "id": "category_source", "label": "Build tabs from", "default": "type",
      "options": [ { "value": "type", "label": "Product type" }, { "value": "tag", "label": "Product tag" } ],
      "info": "Used for AUTO text tabs and for matching products to your image tabs. Set each product's Product type (or tag) in its admin page. Add image tabs below for the Apple-style picture tabs." },
    { "type": "checkbox", "id": "show_all_tab", "label": "Show 'All' tab", "default": true, "info": "Turn off to start on the first category instead of an All tab." },
    { "type": "text", "id": "all_label", "label": "'All' tab label", "default": "All" },
    { "type": "image_picker", "id": "all_image", "label": "'All' tab image (optional)", "info": "Shown on the 'All' tab when you add image tabs below. Leave empty for a grid icon." },
    { "type": "image_picker", "id": "search_image", "label": "Search tile image (optional)", "info": "Shown on the Search tile instead of the magnifier icon. A transparent PNG cutout works best." },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Products visible at once (desktop)", "default": 4,
      "info": "The shelf scrolls sideways with arrows to reveal the rest." },
    { "type": "range", "id": "max_products", "min": 8, "max": 50, "step": 2, "label": "Max products shown", "default": 48,
      "info": "Tabs filter this loaded set instantly. Raise it if a category looks short." },
    { "type": "text", "id": "hide_tag", "label": "Hide products with this tag", "default": "hidden", "info": "Products with this tag (e.g. the internal back-print add-on) are hidden from the grid." },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "natural",
      "options": [ { "value": "natural", "label": "Natural (tall)" }, { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape" } ] },

    { "type": "header", "content": "Card" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    { "type": "text", "id": "grid_heading", "label": "Row heading", "default": "Best sellers", "info": "Heading above the horizontal best-seller row. Clear to hide." },
    { "type": "checkbox", "id": "top_bestsellers_only", "label": "Top row shows best sellers only", "default": true, "info": "The horizontal row shows only products flagged as best sellers (see the ‘Best seller badge’ section). If none are flagged, it shows all products." },
    { "type": "text", "id": "banners_heading", "label": "Promo banner heading", "info": "Optional heading above the promo banners. Clear to hide." },
    { "type": "checkbox", "id": "show_all_grid", "label": "Show all products in a grid below", "default": true, "info": "Adds a vertical, wrapping grid of every product under the best-seller row." },
    { "type": "text", "id": "all_heading", "label": "Grid heading", "default": "All products", "info": "Heading above the vertical grid. Clear to hide." },
    { "type": "checkbox", "id": "image_bg", "label": "Fill each box with the product image", "default": false, "info": "The photo covers the whole card as a background; the name and price overlay on top." },
    { "type": "checkbox", "id": "show_buy_link", "label": "Show a 'Buy' link on each card", "default": false },
    { "type": "checkbox", "id": "blend_images", "label": "Melt white photo backgrounds into the cards", "default": true, "info": "Products shot on white read as clean cut-outs. Turn off if your product photos have coloured backgrounds." },
    { "type": "text", "id": "buy_label", "label": "Buy link text", "default": "Buy" },
    { "type": "checkbox", "id": "show_scrollbar", "label": "Show a scroll bar under the row", "default": true },

    { "type": "header", "content": "Best seller badge ⭐" },
    { "type": "checkbox", "id": "show_bestseller", "label": "Show “Best seller” badge", "default": true },
    { "type": "text", "id": "bestseller_label", "label": "Badge text", "default": "Best seller" },
    { "type": "text", "id": "bestseller_tag", "label": "Show badge on products tagged", "default": "bestseller", "info": "In Shopify admin, add this tag (e.g. bestseller) to any product you want badged. Not case-sensitive." },
    { "type": "range", "id": "bestseller_top", "min": 0, "max": 12, "step": 1, "label": "Or auto-badge the top N products", "default": 0, "info": "0 = off. If set, the first N products get the badge — use this when the collection is sorted by ‘Best selling’ so it's automatic (no tagging needed)." },

    { "type": "header", "content": "New arrivals badge 🆕" },
    { "type": "checkbox", "id": "show_new", "label": "Show “New” badge", "default": true },
    { "type": "text", "id": "new_label", "label": "Badge text", "default": "New" },
    { "type": "range", "id": "new_days", "min": 1, "max": 90, "step": 1, "label": "Show as new for (days)", "default": 14, "info": "The badge shows automatically for this many days after a product is published, then disappears on its own — no tagging needed." },

    { "type": "header", "content": "Buttons under the search" },
    { "type": "checkbox", "id": "show_btn1", "label": "Show button 1", "default": false },
    { "type": "text", "id": "btn1_label", "label": "Button 1 text", "default": "Shop all" },
    { "type": "url", "id": "btn1_url", "label": "Button 1 link" },
    { "type": "checkbox", "id": "show_btn2", "label": "Show button 2", "default": false },
    { "type": "text", "id": "btn2_label", "label": "Button 2 text", "default": "Contact us" },
    { "type": "url", "id": "btn2_url", "label": "Button 2 link" },

    { "type": "header", "content": "Back button" },
    { "type": "checkbox", "id": "show_back", "label": "Show back button (top-left)", "default": true },
    { "type": "url", "id": "back_url", "label": "Back button goes to", "info": "Defaults to your home page." },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "page_bg", "label": "Page background", "default": "#f5f5f7", "info": "Fills the whole page so there's no white strip below the grid." },

    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_text", "label": "Empty message", "default": "Nothing here yet." },
    { "type": "text", "id": "empty_link_label", "label": "Empty button label", "default": "Browse all products" },

    { "type": "header", "content": "No search results" },
    { "type": "header", "content": "Smart search" },
    { "type": "paragraph", "content": "The search already handles typos, plurals, filler words (\"a gift for my dad\" → men), prices (\"under $25\", \"cheap\") and ranks results best-first. Add your own synonyms below." },
    { "type": "textarea", "id": "search_synonyms", "label": "Extra synonyms", "info": "One pair per line, e.g. cup=mug. Both directions apply. Built-in pairs (cup=mug, tee=t-shirt, journal=notebook…) stay active." },
    { "type": "range", "id": "cheap_price", "label": "“Cheap” means under", "min": 5, "max": 200, "step": 5, "unit": "$", "default": 25 },
    { "type": "text", "id": "search_fb_url", "label": "Firebase URL for search analytics (optional)", "info": "Paste the same Firebase Realtime Database URL you use for likes, and searches that found nothing are counted under /search_misses — so you can see what shoppers wanted." },
    { "type": "text", "id": "noresults_title", "label": "Title", "default": "No matches — yet." },
    { "type": "textarea", "id": "noresults_message", "label": "Message", "default": "Can't find what you're looking for? Tell us what you had in mind — we might still be able to make it." },
    { "type": "text", "id": "noresults_link_label", "label": "Button text", "default": "Contact us" },
    { "type": "url", "id": "noresults_url", "label": "Button link", "info": "Defaults to /pages/contact." }
  ],
  "blocks": [
    { "type": "product_row", "name": "Popular products row", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Adds the horizontal best-seller row to the page (it only shows when this block is present). Drag this block up or down to place the row above or below your promo banners." },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Popular products" }
    ]},
    { "type": "tab", "name": "Image category tab", "settings": [
      { "type": "text", "id": "label", "label": "Tab label", "default": "Category" },
      { "type": "text", "id": "category_value", "label": "Filters products where Type =",
        "info": "Type the exact Product type value of the items for this tab, e.g. Drinkware. (If 'Build tabs from' is set to Tag, enter the tag instead.)" },
      { "type": "image_picker", "id": "image", "label": "Tab image" }
    ]},
    { "type": "tab_banner", "name": "Category hero banner", "settings": [
      { "type": "paragraph", "content": "A full-width image banner under the tabs with the text and button laid over it. Add several with the same category tab and they become a slider (arrows + dots)." },
      { "type": "text", "id": "show_for", "label": "Show on category tab", "info": "The tab's category value (e.g. Apparel). Several: separate with commas. Type All for the All tab. Leave empty to show on every tab." },
      { "type": "select", "id": "pos", "label": "Position", "default": "top", "options": [
        { "value": "top", "label": "Above the products" }, { "value": "bottom", "label": "Below the products" } ] },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Fills the WHOLE banner, fit to the page. Use a wide photo (~3:1) with quiet space on the left for the text." },
      { "type": "text", "id": "kicker", "label": "Small top line", "info": "e.g. DYNAEIMIC SELECTED Materials" },
      { "type": "color", "id": "kicker_color", "label": "Small top line colour", "default": "#0aa574" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Born for great gifts" },
      { "type": "color", "id": "heading_color", "label": "Heading colour", "info": "Leave empty to use the text colour below." },
      { "type": "textarea", "id": "subtext", "label": "Text", "default": "Picked, tested and personalized — all to get the best result for the person you have in mind." },
      { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop now" },
      { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "color", "id": "bg_color", "label": "Background colour (behind the image)", "default": "#eef1f6" },
      { "type": "color", "id": "text_color", "label": "Text colour", "default": "#0b1c33" },
      { "type": "color", "id": "button_bg", "label": "Button colour", "default": "#0a0a0a" },
      { "type": "color", "id": "button_text", "label": "Button text colour", "default": "#ffffff" }
    ]},
    { "type": "banner", "name": "Promo banner", "settings": [
      { "type": "select", "id": "size", "label": "Tile size", "default": "tall",
        "info": "Put two ‘Small’ tiles next to each other and they stack on top of each other in one column.",
        "options": [
          { "value": "sm", "label": "Small (two stack in a column)" },
          { "value": "tall", "label": "Full height" },
          { "value": "wide", "label": "Wide (double width)" },
          { "value": "lg", "label": "Large (double width, full height)" }
        ] },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Fills the whole tile." },
      { "type": "checkbox", "id": "scrim", "label": "Shadow behind the text", "default": true, "info": "Keeps the text readable over the photo." },
      { "type": "text", "id": "kicker", "label": "Small top line", "info": "e.g. In as fast as an hour" },
      { "type": "text", "id": "heading", "label": "Heading (line 1)", "default": "Best-in-Class" },
      { "type": "text", "id": "heading2", "label": "Heading (line 2, accent colour)", "info": "Shown under line 1 in the accent colour — e.g. ‘Auto Heat Press’." },
      { "type": "color", "id": "accent_color", "label": "Accent colour (line 2)", "default": "#0071e3" },
      { "type": "text", "id": "subtext", "label": "Small text line", "info": "A short line under the heading." },
      { "type": "text", "id": "button_label", "label": "Link text" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "show_for", "label": "Show on category tab", "info": "Leave EMPTY to show on every tab. Type a tab's category value (e.g. Apparel) to show it only there — several separated by commas. Type All for the All tab only." },
      { "type": "select", "id": "pos", "label": "Position", "default": "top", "options": [
        { "value": "top", "label": "Above the products" }, { "value": "bottom", "label": "Below the products" } ] },
      { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#e9f0fb" },
      { "type": "color", "id": "text_color", "label": "Text colour", "default": "#17223b" }
    ]}
  ],
  "max_blocks": 24,
  "presets": [ { "name": "Dynamic Collection" } ],
  "enabled_on": { "templates": ["collection", "list-collections", "index"] }
}
{% endschema %}
