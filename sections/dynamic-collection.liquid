    }
    // Top best-seller row: stays fixed across category tabs (ignores the
    // category), only responding to search text / badge filters.
    function shelfMatch(c) {
      var okQ = !query || queryMatch(query, c.getAttribute("data-search") || "");
      if (badgeFilter) {
