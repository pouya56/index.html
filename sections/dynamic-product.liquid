{% comment %}
  ============================================================================
  Dynamic Product — center PNG product shot on a dark stage, with the title/
  price/cart on the LEFT and a liquid-glass accordion on the RIGHT.
  ----------------------------------------------------------------------------
  INSTALL:
  1. Edit code > Sections > Add a new section > "dynamic-product" and REPLACE
     its contents with this whole file. Save.
  2. Online Store > Themes > Customize > Products template > add "Dynamic
     product" (remove the default product section). Save.
  3. Add "Detail" blocks for the right-side accordion (Description, Nutrition,
     Ingredients…). Everything else pulls from the product automatically.
  TIP: use a transparent PNG product photo so it floats over the arch.
  ============================================================================
{% endcomment %}

{%- assign p = product -%}
{%- assign v = p.selected_or_first_available_variant -%}

<style>
  .dyn-pr { --bg: {{ section.settings.bg_color | default: '#0e0e12' }};
    --glow: {{ section.settings.arch_color | default: '#8f9bb0' }};
    --ink: #ffffff; --soft: rgba(255,255,255,0.62); --line: rgba(255,255,255,0.14);
    --glass: rgba(255,255,255,0.06); --accent: {{ section.settings.accent | default: '#3fb98f' }};
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; position: relative; overflow: hidden; }
  .dyn-pr, .dyn-pr *, .dyn-pr *::before, .dyn-pr *::after { box-sizing: border-box; }
  /* Soft corner glow like the reference */
  .dyn-pr::after { content: ""; position: absolute; top: -20%; right: -10%; width: 46%; height: 60%;
    background: radial-gradient(circle, rgba(150,110,200,0.28), transparent 70%); pointer-events: none; }
  .dyn-pr .pr-wrap { position: relative; z-index: 1; max-width: 1500px; margin: 0 auto;
    display: grid; grid-template-columns: 1.05fr 1.25fr 1.05fr; gap: clamp(16px, 3vw, 40px);
    align-items: center; padding: clamp(28px, 5vw, 60px) clamp(18px, 4vw, 60px); min-height: min(92vh, 900px); }
  @media (max-width: 980px) { .dyn-pr .pr-wrap { grid-template-columns: 1fr; gap: 24px; text-align: center; } }

  /* ---- Center: PNG product on an arch ---- */
  .dyn-pr .pr-stage { position: relative; order: 2; display: grid; place-items: center; min-height: min(70vh, 640px); }
  @media (max-width: 980px) { .dyn-pr .pr-stage { order: -1; } }
  .dyn-pr .pr-arch { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: min(78%, 360px); height: min(90%, 620px); border-radius: 999px 999px 34px 34px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--glow) 60%, transparent), color-mix(in srgb, var(--glow) 22%, transparent));
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
  .dyn-pr .pr-orbit { position: absolute; top: 50%; left: 50%; width: min(88%, 460px); height: min(88%, 460px);
    transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none;
    background:
      radial-gradient(6px 6px at 82% 30%, #fff 60%, transparent 62%),
      radial-gradient(10px 10px at 20% 44%, #fff 60%, transparent 62%),
      radial-gradient(14px 14px at 74% 66%, #fff 60%, transparent 62%);
    opacity: 0.85; }
  .dyn-pr .pr-orbit::before, .dyn-pr .pr-orbit::after { content: ""; position: absolute; inset: 6% 2%;
    border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.22); }
  .dyn-pr .pr-orbit::after { inset: 20% 16%; transform: rotate(24deg); border-color: rgba(255,255,255,0.14); }
  .dyn-pr .pr-photo { position: relative; z-index: 2; width: min(86%, 420px); }
  .dyn-pr .pr-photo img { width: 100%; height: auto; display: block; object-fit: contain;
    filter: drop-shadow(0 40px 50px rgba(0,0,0,0.55)); transition: opacity 0.35s ease; }
  .dyn-pr .pr-photo-ph { aspect-ratio: 3 / 5; border-radius: 20px; display: grid; place-items: center;
    color: var(--soft); font-size: 14px; background: rgba(255,255,255,0.05); border: 1px dashed var(--line); }
  /* gallery arrows + scroll cue */
  .dyn-pr .pr-arrows { position: absolute; z-index: 3; top: 8%; right: 4%; display: flex; gap: 10px; }
  .dyn-pr .pr-arrow, .dyn-pr .pr-scroll { display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; border: 1px solid var(--line); background: var(--glass);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); color: #fff; cursor: pointer; }
  .dyn-pr .pr-arrow { width: 44px; height: 44px; }
  .dyn-pr .pr-arrow:hover { background: rgba(255,255,255,0.16); }
  .dyn-pr .pr-arrow svg, .dyn-pr .pr-scroll svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .dyn-pr .pr-scroll { position: absolute; z-index: 3; bottom: 4%; left: 50%; transform: translateX(-50%); width: 60px; height: 60px; }
  @media (max-width: 980px) { .dyn-pr .pr-arrows, .dyn-pr .pr-scroll { display: none; } }

  /* ---- Left: title / price / cart (liquid glass) ---- */
  .dyn-pr .pr-left { order: 1; }
  .dyn-pr .pr-panel { background: var(--glass); border: 1px solid var(--line); border-radius: 28px;
    -webkit-backdrop-filter: blur(24px) saturate(1.4); backdrop-filter: blur(24px) saturate(1.4);
    padding: clamp(22px, 3vw, 34px); box-shadow: 0 30px 70px -30px rgba(0,0,0,0.6); }
  .dyn-pr .pr-eyebrow { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; }
  .dyn-pr .pr-title { margin: 0; font-weight: 800; font-size: clamp(34px, 5vw, 62px); line-height: 0.98; letter-spacing: -0.02em; }
  .dyn-pr .pr-price { margin-top: 18px; font-size: clamp(26px, 3vw, 34px); font-weight: 700; }
  .dyn-pr .pr-price .was { margin-left: 10px; font-size: 0.6em; font-weight: 500; color: var(--soft); text-decoration: line-through; }
  .dyn-pr .pr-desc { margin-top: 16px; font-size: 15.5px; line-height: 1.6; color: var(--soft); max-width: 42ch; }
  @media (max-width: 980px) { .dyn-pr .pr-desc { margin-inline: auto; } }
  .dyn-pr .pr-variants { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 980px) { .dyn-pr .pr-variants { justify-content: center; } }
  .dyn-pr .pr-swatch { padding: 9px 16px; border-radius: 999px; border: 1px solid var(--line);
    background: rgba(255,255,255,0.05); color: #fff; font-size: 13.5px; cursor: pointer; transition: background 0.15s, border-color 0.15s; }
  .dyn-pr .pr-swatch.is-on { background: #fff; color: #111; border-color: #fff; }
  .dyn-pr .pr-swatch[disabled] { opacity: 0.4; text-decoration: line-through; cursor: not-allowed; }
  .dyn-pr .pr-cta { margin-top: 26px; display: flex; align-items: center; gap: 16px; }
  @media (max-width: 980px) { .dyn-pr .pr-cta { justify-content: center; } }
  .dyn-pr .pr-add { flex: 0 1 auto; display: inline-flex; align-items: center; gap: 10px; justify-content: center;
    padding: 16px 30px; border-radius: 999px; border: 0; background: #fff; color: #111; font-size: 15.5px; font-weight: 700;
    cursor: pointer; transition: transform 0.15s, box-shadow 0.15s; }
  .dyn-pr .pr-add:hover { transform: translateY(-2px); box-shadow: 0 16px 34px -14px rgba(255,255,255,0.4); }
  .dyn-pr .pr-add[disabled] { background: rgba(255,255,255,0.3); color: rgba(255,255,255,0.7); cursor: not-allowed; transform: none; box-shadow: none; }
  .dyn-pr .pr-add svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .dyn-pr .pr-heart { width: 52px; height: 52px; flex: none; border-radius: 50%; border: 1px solid var(--line);
    background: var(--glass); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.15s; }
  .dyn-pr .pr-heart:hover { background: rgba(255,255,255,0.14); }
  .dyn-pr .pr-heart svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .dyn-pr .pr-heart.is-saved svg { fill: #ff5e7a; stroke: #ff5e7a; }

  /* ---- Right: accordion (liquid glass) ---- */
  .dyn-pr .pr-right { order: 3; display: flex; flex-direction: column; gap: 12px; }
  .dyn-pr .pr-acc { background: var(--glass); border: 1px solid var(--line); border-radius: 22px;
    -webkit-backdrop-filter: blur(20px) saturate(1.4); backdrop-filter: blur(20px) saturate(1.4); overflow: hidden; }
  .dyn-pr .pr-acc-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 20px 24px; background: none; border: 0; color: #fff; font-size: 17px; font-weight: 600; text-align: left; cursor: pointer; }
  .dyn-pr .pr-acc-ic { position: relative; width: 18px; height: 18px; flex: none; }
  .dyn-pr .pr-acc-ic::before, .dyn-pr .pr-acc-ic::after { content: ""; position: absolute; background: #fff; border-radius: 2px; transition: transform 0.25s ease, opacity 0.25s ease; }
  .dyn-pr .pr-acc-ic::before { top: 8px; left: 0; width: 18px; height: 2px; }
  .dyn-pr .pr-acc-ic::after { left: 8px; top: 0; width: 2px; height: 18px; }
  .dyn-pr .pr-acc.is-open .pr-acc-ic::after { transform: scaleY(0); opacity: 0; }
  .dyn-pr .pr-acc-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
  .dyn-pr .pr-acc.is-open .pr-acc-body { grid-template-rows: 1fr; }
  .dyn-pr .pr-acc-inner { overflow: hidden; }
  .dyn-pr .pr-acc-text { padding: 0 24px 22px; font-size: 15px; line-height: 1.65; color: var(--soft); }
  .dyn-pr .pr-acc-text p { margin: 0 0 0.8em; } .dyn-pr .pr-acc-text p:last-child { margin: 0; }
  .dyn-pr .pr-note { color: var(--soft); font-size: 13px; padding: 10px 4px 0; }
</style>

<section class="dyn-pr" id="dynPr-{{ section.id | slice: -6, 6 }}">
  <div class="pr-wrap">

    <!-- LEFT -->
    <div class="pr-left">
      <div class="pr-panel">
        {%- if section.settings.eyebrow != blank -%}<div class="pr-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h1 class="pr-title">{{ p.title | default: 'Product name' }}</h1>
        <div class="pr-price" data-pr-price>
          {%- if v -%}{{ v.price | money }}{%- if v.compare_at_price > v.price -%}<span class="was">{{ v.compare_at_price | money }}</span>{%- endif -%}
          {%- else -%}£39.00{%- endif -%}
        </div>
        {%- assign short = section.settings.short_desc | default: p.description -%}
        {%- if short != blank -%}<div class="pr-desc">{{ short | strip_html | truncatewords: 26 }}</div>{%- endif -%}

        {%- if p and p.variants.size > 1 -%}
          <div class="pr-variants" data-pr-variants>
            {%- for var in p.variants -%}
              <button type="button" class="pr-swatch{% if var.id == v.id %} is-on{% endif %}" data-vid="{{ var.id }}"
                data-price="{{ var.price | money }}"{% unless var.available %} disabled{% endunless %}>{{ var.title }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="pr-cta">
          {%- if p -%}
            <form method="post" action="{{ routes.cart_add_url }}" id="prForm-{{ section.id | slice: -6, 6 }}" data-pr-form>
              <input type="hidden" name="id" value="{{ v.id }}" data-pr-id>
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="pr-add" {% unless v.available %}disabled{% endunless %} data-pr-add>
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span data-pr-addlabel>{% if v.available %}{{ section.settings.add_label | default: 'Add to cart' }}{% else %}Sold out{% endif %}</span>
              </button>
            </form>
          {%- else -%}
            <button type="button" class="pr-add"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>{{ section.settings.add_label | default: 'Add to cart' }}</span></button>
          {%- endif -%}
          <button type="button" class="pr-heart" data-pr-heart aria-label="Save to wishlist" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.3C.6 8.6 2 5.5 5 5.1c2-.3 3.5.9 4.5 2.2C10.5 6 12 4.8 14 5.1c3 .4 4.4 3.5 3 6.6C19.5 16.3 12 21 12 21Z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- CENTER -->
    <div class="pr-stage">
      <div class="pr-arch" aria-hidden="true"></div>
      <div class="pr-orbit" aria-hidden="true"></div>
      {%- assign imgs = p.images -%}
      <div class="pr-photo" data-pr-photo>
        {%- if imgs.size > 0 -%}
          <img src="{{ imgs.first | image_url: width: 1000 }}"
            srcset="{{ imgs.first | image_url: width: 600 }} 600w, {{ imgs.first | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 980px) 70vw, 420px" alt="{{ p.title | escape }}" data-pr-mainimg
            width="{{ imgs.first.width }}" height="{{ imgs.first.height }}" fetchpriority="high">
          {%- if imgs.size > 1 -%}
            <script type="application/json" data-pr-imgs>[{% for im in imgs %}{{ im | image_url: width: 1000 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
          {%- endif -%}
        {%- elsif section.settings.fallback_image != blank -%}
          <img src="{{ section.settings.fallback_image | image_url: width: 1000 }}" alt="{{ p.title | escape }}" data-pr-mainimg
            width="{{ section.settings.fallback_image.width }}" height="{{ section.settings.fallback_image.height }}">
        {%- else -%}
          <div class="pr-photo-ph">Transparent PNG product photo</div>
        {%- endif -%}
      </div>
      {%- if imgs.size > 1 -%}
        <div class="pr-arrows">
          <button type="button" class="pr-arrow" data-pr-prev aria-label="Previous image"><svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></button>
          <button type="button" class="pr-arrow" data-pr-next aria-label="Next image"><svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
        </div>
      {%- endif -%}
      {%- if section.settings.show_scroll -%}
        <a class="pr-scroll" href="#prDetails-{{ section.id | slice: -6, 6 }}" aria-label="Scroll for details"><svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg></a>
      {%- endif -%}
    </div>

    <!-- RIGHT -->
    <div class="pr-right" id="prDetails-{{ section.id | slice: -6, 6 }}">
      {%- assign detail_blocks = section.blocks | where: 'type', 'detail' -%}
      {%- if detail_blocks.size > 0 -%}
        {%- for block in detail_blocks -%}
          <div class="pr-acc{% if block.settings.open %} is-open{% endif %}" {{ block.shopify_attributes }}>
            <button type="button" class="pr-acc-btn" data-pr-acc>
              <span>{{ block.settings.title | default: 'Detail' }}</span>
              <span class="pr-acc-ic" aria-hidden="true"></span>
            </button>
            <div class="pr-acc-body"><div class="pr-acc-inner"><div class="pr-acc-text">
              {%- if block.settings.text != blank -%}{{ block.settings.text }}
              {%- elsif block.settings.use_description and p.description != blank -%}{{ p.description }}
              {%- else -%}Add text in this block.{%- endif -%}
            </div></div></div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="pr-note">Add “Detail” blocks (Description, Nutrition, Ingredients…) in the section settings.</div>
      {%- endif -%}
    </div>

  </div>

  <script>
  (function () {
    var root = document.getElementById("dynPr-{{ section.id | slice: -6, 6 }}");
    if (!root) return;

    /* Accordion */
    root.querySelectorAll("[data-pr-acc]").forEach(function (btn) {
      btn.addEventListener("click", function () { btn.closest(".pr-acc").classList.toggle("is-open"); });
    });

    /* Variant pick → update price, hidden id, add button state */
    var priceEl = root.querySelector("[data-pr-price]");
    var idEl = root.querySelector("[data-pr-id]");
    var addBtn = root.querySelector("[data-pr-add]");
    root.querySelectorAll(".pr-swatch").forEach(function (sw) {
      sw.addEventListener("click", function () {
        if (sw.hasAttribute("disabled")) return;
        root.querySelectorAll(".pr-swatch").forEach(function (s) { s.classList.remove("is-on"); });
        sw.classList.add("is-on");
        if (idEl) idEl.value = sw.getAttribute("data-vid");
        if (priceEl && sw.getAttribute("data-price")) priceEl.textContent = sw.getAttribute("data-price");
      });
    });

    /* AJAX add to cart (falls back to normal form POST if fetch fails) */
    var form = root.querySelector("[data-pr-form]");
    if (form) {
      form.addEventListener("submit", function (e) {
        if (!window.fetch) return;
        e.preventDefault();
        var label = root.querySelector("[data-pr-addlabel]");
        var prev = label ? label.textContent : "";
        if (label) label.textContent = "Adding…";
        fetch("{{ routes.cart_add_url }}.js", { method: "POST", body: new FormData(form),
          headers: { "Accept": "application/json" } })
          .then(function (r) { return r.json(); })
          .then(function () {
            if (label) label.textContent = "Added ✓";
            try { document.dispatchEvent(new CustomEvent("dyn:cart:refresh")); } catch (e2) {}
            document.dispatchEvent(new CustomEvent("cart:refresh"));
            setTimeout(function () { if (label) label.textContent = prev; }, 1600);
          })
          .catch(function () { form.submit(); });
      });
    }

    /* Gallery arrows */
    var imgEl = root.querySelector("[data-pr-mainimg]");
    var dataEl = root.querySelector("[data-pr-imgs]");
    if (imgEl && dataEl) {
      var list = [];
      try { list = JSON.parse(dataEl.textContent) || []; } catch (e3) {}
      var idx = 0;
      function show(n) {
        if (!list.length) return;
        idx = (n + list.length) % list.length;
        imgEl.style.opacity = "0";
        setTimeout(function () { imgEl.src = list[idx]; imgEl.style.opacity = "1"; }, 180);
      }
      var nx = root.querySelector("[data-pr-next]"), pv = root.querySelector("[data-pr-prev]");
      if (nx) nx.addEventListener("click", function () { show(idx + 1); });
      if (pv) pv.addEventListener("click", function () { show(idx - 1); });
    }

    /* Wishlist heart — shares the store's dyn_wishlist (orb reacts too) */
    var heart = root.querySelector("[data-pr-heart]");
    if (heart) {
      var item = {
        id: {{ p.id | default: 0 | json }},
        title: {{ p.title | default: '' | json }},
        url: {{ p.url | default: '' | json }},
        image: {% if p.featured_image %}{{ p.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %},
        price: {% if v %}{{ v.price | money | json }}{% else %}""{% endif %}
      };
      function read() { try { return JSON.parse(localStorage.getItem("dyn_wishlist") || "[]") || []; } catch (e4) { return []; } }
      function has(l) { return l.some(function (x) { return String(x.id) === String(item.id); }); }
      function paint() { var on = has(read()); heart.classList.toggle("is-saved", on); heart.setAttribute("aria-pressed", String(on)); }
      paint();
      heart.addEventListener("click", function () {
        if (!item.id) return;
        var l = read();
        if (has(l)) { l = l.filter(function (x) { return String(x.id) !== String(item.id); }); }
        else { l.push(item); }
        try { localStorage.setItem("dyn_wishlist", JSON.stringify(l)); } catch (e5) {}
        try { window.dispatchEvent(new Event("dyn-wishlist-change")); } catch (e6) {}
        paint();
      });
    }
  })();
  </script>
</section>

{% schema %}
{
  "name": "Dynamic product",
  "tag": "section",
  "class": "dynamic-product-section",
  "settings": [
    { "type": "paragraph", "content": "A dark product page: transparent PNG product photo in the center on an arch, with the title/price/Add-to-cart on the left and a liquid-glass accordion on the right. Add on your product template. Use a PNG with a transparent background for the floating look." },
    { "type": "text", "id": "eyebrow", "label": "Small label above the title", "default": "New" },
    { "type": "textarea", "id": "short_desc", "label": "Short description (left side)", "info": "Leave empty to use the start of the product description." },
    { "type": "text", "id": "add_label", "label": "Add-to-cart button text", "default": "Add to cart" },
    { "type": "checkbox", "id": "show_scroll", "label": "Show the scroll-down button", "default": true },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0e0e12" },
    { "type": "color", "id": "arch_color", "label": "Arch color (behind the photo)", "default": "#8f9bb0" },
    { "type": "color", "id": "accent", "label": "Accent (small label)", "default": "#3fb98f" },
    { "type": "image_picker", "id": "fallback_image", "label": "Fallback photo (if the product has none)" }
  ],
  "blocks": [
    {
      "type": "detail", "name": "Detail (accordion)",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Description" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "use_description", "label": "Use the product description instead", "default": false },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic product",
      "blocks": [
        { "type": "detail", "settings": { "title": "Description", "use_description": true, "open": false } },
        { "type": "detail", "settings": { "title": "Nutrition" } },
        { "type": "detail", "settings": { "title": "Ingredients", "open": true } }
      ]
    }
  ]
}
{% endschema %}
