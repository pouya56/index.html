.qty-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.bulk-link { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px;
  border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--ink);
