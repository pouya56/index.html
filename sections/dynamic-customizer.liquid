{% comment %}
  ============================================================================
  Dynamic Customizer — AirPods Pro 3 engraving experience
  ----------------------------------------------------------------------------
  HOW TO INSTALL (Shopify):
  1. In your theme code editor (Online Store > Themes > ... > Edit code),
     under "Sections", click "Add a new section", name it
     "dynamic-customizer", and REPLACE its contents with this whole file.
  2. Upload the 10 image files to "Assets" (Add a new asset):
     logo.svg, airpods-pro-3.png, gal-1.png, gal-2.png, gal-3.png, gal-4.png, gal-5.png, ic-test.png, ic-aid.png, ic-protect.png
  3. Add the section to any template/page:
     - Theme editor: Add section > "Dynamic Customizer", OR
     - In a template .json: add a block referencing "dynamic-customizer".
  Libraries (Fabric.js, GSAP) load from CDN. No app or backend required.
  When placed on a PRODUCT template, "Add to Bag" adds the real product to the
  cart with the engraving saved as a line-item property (shows on the order).
  On non-product pages it runs in demo mode and logs the payload to the console.
  ============================================================================
{% endcomment %}

{%- comment -%}
  On a product page, ALWAYS use that page's own product so one "Default product"
  template works for every product. The manual picker is only a fallback for when
  this section is placed on a non-product page (home page, custom page, etc.).
{%- endcomment -%}
{%- if product != blank -%}
  {%- assign dyn_product = product -%}
{%- else -%}
  {%- assign dyn_product = section.settings.product_ref -%}
{%- endif -%}
<script type="application/json" id="dyn-config">
{
  "assets": {
    "logo.svg": {{ 'logo.svg' | asset_url | json }},
    "airpods-pro-3.png": {{ 'airpods-pro-3.png' | asset_url | json }},
    "gal-1.png": {{ 'gal-1.png' | asset_url | json }},
    "gal-2.png": {{ 'gal-2.png' | asset_url | json }},
    "gal-3.png": {{ 'gal-3.png' | asset_url | json }},
    "gal-4.png": {{ 'gal-4.png' | asset_url | json }},
    "gal-5.png": {{ 'gal-5.png' | asset_url | json }},
    "ic-test.png": {{ 'ic-test.png' | asset_url | json }},
    "ic-aid.png": {{ 'ic-aid.png' | asset_url | json }},
    "ic-protect.png": {{ 'ic-protect.png' | asset_url | json }}
  },
  "shopify": {
    "variantId": {{ dyn_product.selected_or_first_available_variant.id | default: 0 }},
    "productTitle": {{ dyn_product.title | default: '' | json }},
    "productDescription": {{ dyn_product.description | default: '' | json }},
    "priceMoney": {% if dyn_product %}{{ dyn_product.selected_or_first_available_variant.price | money | json }}{% else %}""{% endif %},
    "priceCents": {% if dyn_product %}{{ dyn_product.selected_or_first_available_variant.price | default: 0 }}{% else %}0{% endif %},
    "productMainImage": {% if dyn_product and dyn_product.featured_image %}{{ dyn_product.featured_image | image_url: width: 1400 | json }}{% else %}""{% endif %},
    "productImages": [{% if dyn_product %}{% for img in dyn_product.images %}{{ img | image_url: width: 1400 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}],
    "rootUrl": {{ routes.root_url | default: '/' | json }},
    "productUrl": {% if dyn_product %}{{ dyn_product.url | json }}{% else %}""{% endif %},
    "productHandle": {% if dyn_product %}{{ dyn_product.handle | json }}{% else %}""{% endif %},
    "variants": [{% if dyn_product %}{% for v in dyn_product.variants %}{ "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available }}, "price": {{ v.price | money | json }}, "options": {{ v.options | json }}, "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 120 | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}],
    "options": [{% if dyn_product %}{% for o in dyn_product.options_with_values %}{ "name": {{ o.name | json }}, "values": {{ o.values | json }}, "swatches": [{% for v in o.values %}{ "value": {{ v | json }}, "color": {% if v.swatch and v.swatch.color %}{{ v.swatch.color | json }}{% else %}null{% endif %}, "image": {% if v.swatch and v.swatch.image %}{{ v.swatch.image | image_url: width: 80 | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}{% endfor %}] }{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}],
    "cartUrl": {{ routes.cart_url | default: '/cart' | json }},
    "cartCount": {{ cart.item_count | default: 0 }},
    "accountUrl": {{ routes.account_url | default: '/account' | json }},
    "searchUrl": {{ routes.search_url | default: '/search' | json }},
    "accountsEnabled": {% if shop.customer_accounts_enabled %}true{% else %}false{% endif %},
    "cloudName": {{ section.settings.cloudinary_cloud_name | default: '' | json }},
    "uploadPreset": {{ section.settings.cloudinary_upload_preset | default: '' | json }},
    "onProductPage": {% if dyn_product %}true{% else %}false{% endif %}
  },
  "settings": {
    "customizerType": {{ section.settings.customizer_type | default: 'airpods' | json }},
    "madeToOrder": {% if section.settings.made_to_order %}true{% else %}false{% endif %},
    "print": {
      "show": {% if section.settings.print_show %}true{% else %}false{% endif %},
      "x": {{ section.settings.print_x | default: 22 }},
      "y": {{ section.settings.print_y | default: 30 }},
      "w": {{ section.settings.print_w | default: 56 }},
      "h": {{ section.settings.print_h | default: 40 }}
    },
    "eyebrow": {{ section.settings.eyebrow | default: '' | json }},
    "title": {{ section.settings.title | default: '' | json }},
    "price": {{ section.settings.price | default: '' | json }},
    "priceNote": {{ section.settings.price_note | default: '' | json }},
    "description": {{ section.settings.description | default: '' | json }},
    "modelLabel": {{ section.settings.model_label | default: '' | json }},
    "customizeLabel": {{ section.settings.customize_label | default: '' | json }},
    "addcartLabel": {{ section.settings.addcart_label | default: '' | json }},
    "engraveTitle": {{ section.settings.engrave_title | default: '' | json }},
    "engraveSub": {{ section.settings.engrave_sub | default: '' | json }},
    "engrave": {
      "x": {{ section.settings.engrave_x | default: 50 }},
      "y": {{ section.settings.engrave_y | default: 56 }},
      "size": {{ section.settings.engrave_size | default: 5 }},
      "rotate": {{ section.settings.engrave_rotate | default: 0 }},
      "color": {{ section.settings.engrave_color | default: '#9a9ba2' | json }}
    },
    "mainImage": {% if section.settings.main_image %}{{ section.settings.main_image | image_url: width: 1400 | json }}{% else %}""{% endif %},
    "gallery": [
      {% if section.settings.gallery_1 %}{{ section.settings.gallery_1 | image_url: width: 1400 | json }}{% else %}""{% endif %},
      {% if section.settings.gallery_2 %}{{ section.settings.gallery_2 | image_url: width: 1400 | json }}{% else %}""{% endif %},
      {% if section.settings.gallery_3 %}{{ section.settings.gallery_3 | image_url: width: 1400 | json }}{% else %}""{% endif %},
      {% if section.settings.gallery_4 %}{{ section.settings.gallery_4 | image_url: width: 1400 | json }}{% else %}""{% endif %},
      {% if section.settings.gallery_5 %}{{ section.settings.gallery_5 | image_url: width: 1400 | json }}{% else %}""{% endif %}
    ]
  }
}
</script>

{% raw %}
<script>
(function(){
  try {
    var el = document.getElementById('dyn-config');
    if (el) {
      var cfg = JSON.parse(el.textContent || el.innerText || '{}');
      window.DYN_ASSETS = cfg.assets || {};
      window.DYN_SHOPIFY = cfg.shopify || {};
      window.DYN_SETTINGS = cfg.settings || {};
    } else { window.__dynCfgErr = 'dyn-config element not found'; }
  } catch (e) { window.__dynCfgErr = String(e); }
})();
</script>
<style>
@font-face{font-family:'DynEmoji';src:url(data:font/woff2;base64,) format('woff2');font-display:swap;}
/* ============================================================================
   Dynamic — Premium Product Customization Platform
   Design system: Apple-inspired. Minimal, elegant, generous whitespace.
   ========================================================================== */

:root {
  /* Palette */
  --bg: #ffffff;
  --bg-elevated: #fbfbfd;
  --bg-panel: #f5f5f7;
  --ink: #1d1d1f;
  --ink-soft: #6e6e73;
  --ink-faint: #86868b;
  --line: #d2d2d7;
  --line-soft: #e8e8ed;
  --accent: #0071e3;
  --accent-hover: #0077ed;
  --accent-press: #006edb;
  --accent-soft: #e8f2fd;
  --gold: #b8860b;
  --success: #1a7f37;
  --danger: #d70015;
  --scrim: rgba(0, 0, 0, 0.48);

  /* Typography */
  --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter",
    "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

  /* Radii */
  --r-sm: 8px;
  --r-md: 12px;
  --r-lg: 18px;
  --r-xl: 28px;
  --r-pill: 980px;

  /* Motion */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --dur-fast: 180ms;
  --dur: 320ms;
  --dur-slow: 520ms;

  /* Elevation (kept subtle, Apple-like) */
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 30px 80px rgba(0, 0, 0, 0.18);
}

/* Locked to light theme (white background) to match apple.com/shop, regardless of OS setting. */
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #ffffff;
    --bg-elevated: #fbfbfd;
    --bg-panel: #f5f5f7;
    --ink: #1d1d1f;
    --ink-soft: #6e6e73;
    --ink-faint: #86868b;
    --line: #d2d2d7;
    --line-soft: #e8e8ed;
    --accent-soft: #e8f2fd;
    --scrim: rgba(0, 0, 0, 0.48);
    --shadow-lg: 0 30px 80px rgba(0, 0, 0, 0.18);
  }
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

body {
  font-family: var(--font);
  color: var(--ink);
  background: var(--bg);
  line-height: 1.47;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size: 17px;
  letter-spacing: -0.01em;
}

img { max-width: 100%; display: block; }
button { font-family: inherit; cursor: pointer; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 6px; }

/* ---------- Typography scale ---------- */
.eyebrow {
  font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
  text-transform: none; color: var(--accent);
}
.display {
  font-size: clamp(40px, 6vw, 72px); font-weight: 700;
  line-height: 1.03; letter-spacing: -0.02em;
}
.headline { font-size: clamp(28px, 4vw, 44px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.08; }
.title { font-size: 24px; font-weight: 600; letter-spacing: -0.015em; }
.lead { font-size: 21px; color: var(--ink-soft); font-weight: 400; line-height: 1.4; }
.meta { font-size: 13px; color: var(--ink-faint); }

/* ---------- Buttons ---------- */
.btn {
  appearance: none; border: none; border-radius: var(--r-pill);
  font-size: 17px; font-weight: 500; padding: 13px 26px;
  transition: transform var(--dur-fast) var(--ease-out),
    background var(--dur-fast) var(--ease-out), opacity var(--dur-fast);
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  white-space: nowrap;
}
.btn:active { transform: scale(0.97); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-hover); }
.btn-secondary {
  background: transparent; color: var(--accent);
  border: 1px solid var(--line);
}
.btn-secondary:hover { border-color: var(--accent); background: var(--accent-soft); }
.btn-ghost { background: var(--bg-panel); color: var(--ink); }
.btn-ghost:hover { background: var(--line-soft); }
.btn-block { width: 100%; }
.btn-lg { font-size: 19px; padding: 16px 32px; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }

/* ============================================================================
   PRODUCT PAGE
   ========================================================================== */
/* Header (logo, glass bar, search) now lives in its own section: dynamic-header.liquid */
.dyn-cart-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.42); opacity: 0; pointer-events: none;
  transition: opacity .3s ease; z-index: 9998; -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
.dyn-cart-overlay.open { opacity: 1; pointer-events: auto; }
.dyn-cart { position: fixed; top: 0; right: 0; height: 100%; width: min(420px, 92vw); background: var(--bg);
  z-index: 9999; display: flex; flex-direction: column; transform: translateX(100%);
  transition: transform .38s cubic-bezier(.16,1,.3,1);
  font-family: var(--font); color: var(--ink); }
/* Shadow only while open, so the off-screen drawer doesn't bleed onto the page edge. */
.dyn-cart.open { transform: none; box-shadow: -20px 0 60px rgba(0,0,0,0.18); }
.dyn-cart-head { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid var(--line-soft); }
.dyn-cart-head h3 { font-size: 20px; font-weight: 600; margin: 0; }
.dyn-cart-close { width: 34px; height: 34px; border-radius: 50%; border: none; background: var(--bg-panel); color: var(--ink); font-size: 16px; cursor: pointer; display: grid; place-items: center; transition: background .18s; }
.dyn-cart-close:hover { background: var(--line-soft); }
.dyn-cart-items { flex: 1; overflow-y: auto; padding: 4px 24px; }
.dyn-cart-empty, .dyn-cart-loading { text-align: center; color: var(--ink-faint); padding: 60px 20px; font-size: 15px; }
.dyn-cart-item { display: grid; grid-template-columns: 62px 1fr auto; gap: 14px; padding: 18px 0; border-bottom: 1px solid var(--line-soft); align-items: start; }
.dyn-cart-item img { width: 62px; height: 62px; object-fit: cover; border-radius: 10px; background: var(--bg-panel); }
.dyn-cart-item .ci-title { font-size: 14px; font-weight: 600; line-height: 1.3; }
.dyn-cart-item .ci-opt { font-size: 12px; color: var(--ink-faint); margin-top: 3px; }
.dyn-cart-item .ci-price { font-size: 14px; font-weight: 600; white-space: nowrap; }
.dyn-cart-qty { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; margin-top: 8px; }
.dyn-cart-qty button { width: 26px; height: 26px; border: none; background: transparent; cursor: pointer; color: var(--ink); font-size: 15px; line-height: 1; }
.dyn-cart-qty span { min-width: 26px; text-align: center; font-size: 13px; }
.dyn-cart-remove { display: block; background: none; border: none; color: var(--ink-faint); font-size: 12px; cursor: pointer; margin-top: 6px; padding: 0; text-decoration: underline; }
.dyn-cart-remove:hover { color: var(--danger); }
.dyn-cart-foot:not(:empty) { border-top: 1px solid var(--line-soft); padding: 20px 24px; }
.dyn-cart-subtotal { display: flex; justify-content: space-between; font-size: 16px; font-weight: 600; margin-bottom: 6px; }
.dyn-cart-note { font-size: 12px; color: var(--ink-faint); margin-bottom: 16px; }
.dyn-cart-foot .btn { width: 100%; margin-bottom: 8px; }

.product {
  max-width: 1120px; margin: 0 auto; padding: 40px 22px 128px;
  display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 72px; align-items: start;
}
.gallery {
  position: sticky; top: 28px;
  display: flex; flex-direction: column; gap: 16px;
}
.gallery-main {
  position: relative;
  background: var(--bg-panel); border-radius: var(--r-xl);
  aspect-ratio: 1 / 1; display: grid; place-items: center; overflow: hidden;
}
.gallery-stage { width: 82%; height: 82%; display: grid; place-items: center; position: relative; }
.gallery-stage img { width: 100%; height: 100%; object-fit: contain; transition: opacity var(--dur) var(--ease-out); }
.gallery svg { width: 100%; height: 100%; object-fit: contain; }
.gal-arrow {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
  width: 40px; height: 40px; border-radius: 50%; border: none;
  background: color-mix(in srgb, var(--bg) 78%, transparent);
  -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  box-shadow: var(--shadow-sm); color: var(--ink); font-size: 22px; line-height: 1;
  display: grid; place-items: center; opacity: 0.92;
  transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast);
}
.gal-arrow:hover { transform: translateY(-50%) scale(1.08); background: var(--bg); }
.gal-prev { left: 14px; }
.gal-next { right: 14px; }
.gallery-thumbs { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
.gal-thumb {
  width: 58px; height: 58px; border-radius: 12px; border: 1px solid var(--line);
  background: var(--bg-panel); overflow: hidden; padding: 0; cursor: pointer;
  transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast);
}
.gal-thumb img { width: 100%; height: 100%; object-fit: cover; }
.gal-thumb:hover { transform: translateY(-2px); }
.gal-thumb.sel { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }

.detail { padding-top: 8px; }
.detail .eyebrow { margin-bottom: 10px; }
.detail h1 { margin-bottom: 6px; }
.price-row { display: flex; align-items: baseline; gap: 12px; margin: 22px 0 20px; }
.price { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; }
.price-note { font-size: 13px; color: var(--ink-faint); }
.detail p.desc { color: var(--ink-soft); font-size: 17px; max-width: 46ch; margin-bottom: 34px; }

.opt-group { margin-bottom: 28px; }
.opt-label { font-size: 12px; font-weight: 600; color: var(--ink-soft); margin-bottom: 12px;
  display: flex; justify-content: space-between; }
.opt-label span { font-weight: 400; color: var(--ink); }
.swatches { display: flex; gap: 12px; flex-wrap: wrap; }
.swatch {
  width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line);
  position: relative; transition: transform var(--dur-fast) var(--ease-out);
  background: var(--swatch, #ccc);
}
.swatch:hover { transform: scale(1.06); }
.swatch[aria-pressed="true"]::after {
  content: ""; position: absolute; inset: -5px; border-radius: 50%;
  border: 2px solid var(--accent);
}
.pills { display: flex; gap: 10px; flex-wrap: wrap; }
.pill {
  min-width: 52px; padding: 10px 16px; border-radius: var(--r-md);
  border: 1px solid var(--line); background: transparent; color: var(--ink);
  font-size: 15px; font-weight: 500; transition: all var(--dur-fast) var(--ease-out);
}
.pill:hover { border-color: var(--ink-faint); }
/* Sold-out variation options: crossed out + dimmed so customers see it. */
.pill.soldout { color: var(--ink-faint); border-color: var(--line); opacity: 0.55;
  text-decoration: line-through; text-decoration-thickness: 1.5px; }
.swatch.soldout { opacity: 0.5; }
.swatch.soldout::before { content: ""; position: absolute; inset: 0; border-radius: 50%;
  background: linear-gradient(to top left, transparent calc(50% - 1.5px), var(--ink-soft) calc(50% - 1px), var(--ink-soft) calc(50% + 1px), transparent calc(50% + 1.5px)); }
.variant-status { margin-top: 12px; font-size: 14px; font-weight: 600; color: #c4122f; }
.pill[aria-pressed="true"] { border-color: var(--accent); color: var(--accent);
  background: var(--accent-soft); }

.qty { display: inline-flex; align-items: center; border: 1px solid var(--line);
  border-radius: var(--r-md); overflow: hidden; }
.qty button { width: 44px; height: 44px; background: transparent; border: none; font-size: 20px;
  color: var(--ink); transition: background var(--dur-fast); }
.qty button:hover { background: var(--bg-panel); }
.qty input { width: 48px; height: 44px; text-align: center; border: none; background: transparent;
  color: var(--ink); font-size: 16px; -moz-appearance: textfield; }
.qty input::-webkit-outer-spin-button, .qty input::-webkit-inner-spin-button { -webkit-appearance: none; }

.cta-stack { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
.cta-row { display: flex; gap: 12px; align-items: stretch; }
.cta-row .btn-block { flex: 1; }
.wish-btn { flex: none; width: 58px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg);
  display: grid; place-items: center; cursor: pointer; color: var(--ink);
  transition: border-color .16s, background .16s, transform .1s; }
.wish-btn:hover { border-color: var(--accent); }
.wish-btn:active { transform: scale(0.94); }
.wish-btn svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8;
  stroke-linecap: round; stroke-linejoin: round; transition: fill .16s, stroke .16s; }
.wish-btn.is-saved { border-color: #ff3b5c; color: #ff3b5c; background: #fff0f3; }
.wish-btn.is-saved svg { fill: #ff3b5c; stroke: #ff3b5c; }
.customize-summary {
  font-size: 13px; color: var(--ink-soft); text-align: center; min-height: 18px;
  transition: opacity var(--dur-fast);
}
.reassure { display: flex; gap: 26px; justify-content: center; margin-top: 34px; flex-wrap: wrap; }
.reassure-item { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ink-faint); }
.reassure-item svg { width: 16px; height: 16px; stroke: var(--ink-faint); }

/* ============================================================================
   APPLE-STYLE FULLSCREEN MODAL
   ========================================================================== */
.modal-root { position: fixed; inset: 0; z-index: 9990; display: none; }
/* The window itself doesn't scroll — its content is fixed height; if it's taller
   than the screen you scroll the overlay (the page) to see the rest. */
.modal-root.open { display: flex; background: rgba(0, 0, 0, 0.55); overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 3vh 0; }
.modal-scrim { position: fixed; inset: 0; background: transparent;
  -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
.modal-sheet {
  /* Window: 7.7in wide; height follows its content and grows when the keyboard opens. */
  position: relative; margin: auto; width: 7.7in; height: auto; max-width: 96vw; background: var(--bg);
  border-radius: var(--r-xl); box-shadow: var(--shadow-lg);
  /* Clip the header/footer to the rounded corners so all 4 corners are round. */
  overflow: hidden;
  display: flex; flex-direction: column;
  opacity: 0; transform: translateY(28px) scale(0.985);
}
@media (max-width: 820px) { .modal-sheet { width: 96vw; } }
@media (max-width: 720px) { .modal-root.open { padding: 0; } .modal-sheet { width: 100%; max-width: none; border-radius: 0; min-height: 100%; margin: 0; } }

.modal-head {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 34px 40px 20px; gap: 16px;
}
.modal-head h2 { font-size: clamp(26px, 3.4vw, 40px); font-weight: 700; letter-spacing: -0.02em; }
.modal-head .sub { color: var(--ink-soft); font-size: 18px; margin-top: 4px; }
.modal-close {
  width: 40px; height: 40px; border-radius: 50%; border: none; flex: none;
  background: var(--bg-panel); color: var(--ink); font-size: 19px; line-height: 1;
  display: grid; place-items: center; transition: background var(--dur-fast), transform var(--dur-fast);
}
.modal-close:hover { background: var(--line-soft); transform: rotate(90deg); }

.modal-body {
  display: grid; grid-template-columns: 1fr 400px; min-height: 0;
}
@media (max-width: 900px) { .modal-body { grid-template-columns: 1fr; grid-template-rows: 1fr auto; } }

/* Canvas stage */
.stage {
  position: relative; background:
    radial-gradient(120% 120% at 50% 0%, var(--bg-elevated), var(--bg-panel));
  display: flex; flex-direction: column; min-height: 0;
}
.stage-toolbar {
  display: flex; align-items: center; gap: 6px; padding: 12px 18px;
  border-bottom: 1px solid var(--line-soft); flex-wrap: wrap;
}
.area-tabs { display: flex; gap: 4px; background: var(--bg-panel); border-radius: var(--r-pill); padding: 4px; }
.area-tab {
  border: none; background: transparent; color: var(--ink-soft); font-size: 13px; font-weight: 500;
  padding: 7px 15px; border-radius: var(--r-pill); position: relative;
  transition: color var(--dur-fast);
}
.area-tab[aria-selected="true"] { color: var(--ink); }
.area-tab-bg {
  position: absolute; inset: 0; background: var(--bg); border-radius: var(--r-pill);
  box-shadow: var(--shadow-sm); z-index: -1;
}
.tool-spacer { flex: 1; }
.tool-btn {
  width: 36px; height: 36px; border-radius: var(--r-sm); border: none; background: transparent;
  color: var(--ink-soft); display: grid; place-items: center;
  transition: background var(--dur-fast), color var(--dur-fast);
}
.tool-btn:hover:not(:disabled) { background: var(--bg-panel); color: var(--ink); }
.tool-btn:disabled { opacity: 0.32; cursor: not-allowed; }
.tool-btn svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.7;
  stroke-linecap: round; stroke-linejoin: round; }
.tool-divider { width: 1px; height: 22px; background: var(--line-soft); margin: 0 4px; }

.canvas-wrap { flex: 1; display: grid; place-items: center; padding: 24px; min-height: 320px; position: relative; overflow: hidden; }
.canvas-frame { position: relative; transition: transform var(--dur) var(--ease-out); }
.canvas-frame canvas { border-radius: 4px; }
.zoom-badge {
  position: absolute; bottom: 14px; left: 18px; font-size: 12px; color: var(--ink-faint);
  background: color-mix(in srgb, var(--bg) 70%, transparent); padding: 4px 10px; border-radius: var(--r-pill);
  backdrop-filter: blur(8px);
}
.stage-empty {
  position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none;
  color: var(--ink-faint); font-size: 14px; text-align: center; padding: 40px;
  transition: opacity var(--dur);
}

/* Side panel */
.panel {
  border-left: 1px solid var(--line-soft); display: flex; flex-direction: column;
  min-height: 0; background: var(--bg);
}
@media (max-width: 900px) { .panel { border-left: none; border-top: 1px solid var(--line-soft); max-height: 46vh; } }
.mode-rail { display: flex; gap: 6px; padding: 16px 20px 8px; overflow-x: auto; }
.mode-btn {
  border: none; background: var(--bg-panel); color: var(--ink-soft);
  border-radius: var(--r-pill); padding: 9px 15px; font-size: 13px; font-weight: 500; white-space: nowrap;
  transition: all var(--dur-fast) var(--ease-out); display: inline-flex; align-items: center; gap: 6px;
}
.mode-btn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 1.7; }
.mode-btn:hover { color: var(--ink); }
.mode-btn[aria-selected="true"] { background: var(--ink); color: var(--bg); }

.panel-scroll { flex: 1; overflow-y: auto; padding: 12px 20px 20px; }
.panel-pane { display: none; animation: fadeUp var(--dur) var(--ease-out); }
.panel-pane.active { display: block; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

.field { margin-bottom: 18px; }
.field > label { display: block; font-size: 12px; font-weight: 600; color: var(--ink-soft); margin-bottom: 8px; }
.input, .textarea, .select {
  width: 100%; border: 1px solid var(--line); border-radius: var(--r-md);
  padding: 12px 14px; font-size: 15px; color: var(--ink); background: var(--bg);
  transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
}
.input:focus, .textarea:focus, .select:focus {
  outline: none; border-color: var(--accent);
  box-shadow: 0 0 0 4px var(--accent-soft);
}
.textarea { resize: vertical; min-height: 84px; line-height: 1.4; }

.font-grid, .swatch-grid { display: grid; gap: 8px; }
.font-grid { grid-template-columns: 1fr 1fr; }
.font-chip {
  border: 1px solid var(--line); border-radius: var(--r-md); padding: 12px 10px; background: var(--bg);
  font-size: 17px; color: var(--ink); text-align: center; transition: all var(--dur-fast);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.font-chip:hover { border-color: var(--ink-faint); }
.font-chip[aria-pressed="true"] { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
.swatch-grid { grid-template-columns: repeat(8, 1fr); }
.color-dot { aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--line-soft);
  background: var(--c); transition: transform var(--dur-fast); }
.color-dot:hover { transform: scale(1.12); }
.color-dot[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent); }

.dropzone {
  border: 2px dashed var(--line); border-radius: var(--r-lg); padding: 34px 20px; text-align: center;
  color: var(--ink-faint); transition: all var(--dur-fast) var(--ease-out); background: var(--bg-elevated);
}
.dropzone.drag { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
.dropzone strong { color: var(--ink); display: block; margin-bottom: 4px; font-size: 15px; }
.dropzone .formats { font-size: 12px; margin-top: 10px; }

.emoji-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.emoji-btn { border: none; background: transparent; font-size: 22px; padding: 6px; border-radius: var(--r-sm);
  transition: background var(--dur-fast); line-height: 1; }
.emoji-btn:hover { background: var(--bg-panel); }

.template-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.template-card {
  border: 1px solid var(--line-soft); border-radius: var(--r-md); overflow: hidden; background: var(--bg-panel);
  aspect-ratio: 4/3; padding: 0; transition: transform var(--dur-fast), box-shadow var(--dur-fast);
}
.template-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.template-card svg { width: 100%; height: 100%; }

.layer-list { display: flex; flex-direction: column; gap: 6px; }
.layer {
  display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--r-sm);
  background: var(--bg-elevated); border: 1px solid transparent; transition: all var(--dur-fast);
}
.layer.sel { border-color: var(--accent); background: var(--accent-soft); }
.layer-ico { width: 22px; height: 22px; display: grid; place-items: center; color: var(--ink-soft); flex: none; }
.layer-name { flex: 1; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.layer-del { border: none; background: transparent; color: var(--ink-faint); padding: 4px; border-radius: 6px; }
.layer-del:hover { color: var(--danger); background: var(--bg-panel); }

.spin { width: 18px; height: 18px; border: 2px solid var(--line); border-top-color: var(--accent);
  border-radius: 50%; animation: spin 0.7s linear infinite; display: inline-block; }
@keyframes spin { to { transform: rotate(360deg); } }

.hint { font-size: 12px; color: var(--ink-faint); line-height: 1.5; }
.divider { height: 1px; background: var(--line-soft); margin: 18px 0; }

/* Modal footer — dynamic pricing */
.modal-foot {
  display: flex; align-items: center; gap: 20px; padding: 18px 40px;
  border-top: 1px solid var(--line-soft); background: var(--bg-elevated);
}
@media (max-width: 720px) { .modal-foot { padding: 14px 20px; flex-wrap: wrap; } }
.price-breakdown { flex: 1; min-width: 0; }
.price-breakdown-toggle {
  display: flex; align-items: baseline; gap: 10px; background: none; border: none; padding: 0; color: var(--ink);
}
.price-breakdown-toggle .total { font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
.price-breakdown-toggle .caret { color: var(--ink-faint); font-size: 12px; transition: transform var(--dur-fast); }
.price-breakdown.open .caret { transform: rotate(180deg); }
.price-items {
  display: grid; grid-template-rows: 0fr; overflow: hidden;
  transition: grid-template-rows var(--dur) var(--ease-out);
}
.price-breakdown.open .price-items { grid-template-rows: 1fr; }
.price-items-inner { min-height: 0; }
.price-items ul { list-style: none; padding: 12px 0 4px; }
.price-items li { display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-soft);
  padding: 3px 0; }
.price-items li .free { color: var(--success); }
.foot-actions { display: flex; gap: 12px; flex: none; }

/* Toast */
.toast-host { position: fixed; bottom: 26px; left: 50%; transform: translateX(-50%); z-index: 10001;
  display: flex; flex-direction: column; gap: 8px; align-items: center; pointer-events: none; }
.toast {
  background: var(--ink); color: var(--bg); padding: 12px 20px; border-radius: var(--r-pill);
  font-size: 14px; box-shadow: var(--shadow-md); opacity: 0; transform: translateY(12px);
  transition: all var(--dur) var(--ease-out); max-width: 90vw;
}
.toast.show { opacity: 1; transform: none; }

/* ============================================================================
   APPLE-STYLE ENGRAVING MODAL (real product photo)
   ========================================================================== */
.engrave-sheet { display: flex; flex-direction: column; }
.engrave-sheet .modal-close { position: absolute; top: 26px; right: 26px; z-index: 3; }
.engrave-scroll { flex: 1 1 auto; min-height: 0; overflow: visible; }
.engrave-head { text-align: center; padding: 20px 32px 2px; }
.engrave-head h2 { font-size: clamp(24px, 3.6vw, 38px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.06; }
.engrave-head p { max-width: 560px; margin: 10px auto 0; color: var(--ink-soft); font-size: 15px; line-height: 1.4; }
.engrave-stage { background: var(--bg-panel); margin-top: 10px; padding: 10px 16px; display: grid; place-items: center; }
.engrave-frame { position: relative; width: min(92%, 429px); container-type: inline-size; }
.engrave-frame img { width: 100%; height: auto; display: block; }
.upload-overlay { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 40%; display: grid; place-items: center; pointer-events: none; }
.upload-overlay img { max-width: 100%; max-height: 60cqmin; object-fit: contain;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.18)); pointer-events: none; -webkit-user-drag: none; }
.upload-overlay.has-img { pointer-events: auto; cursor: move; touch-action: none;
  outline: 1.5px dashed rgba(0,113,227,0.6); outline-offset: 5px; border-radius: 2px; }
.upload-handle { position: absolute; right: -10px; bottom: -10px; width: 20px; height: 20px;
  border-radius: 50%; background: var(--accent); border: 2px solid #fff; cursor: nwse-resize;
  box-shadow: 0 1px 5px rgba(0,0,0,0.35); touch-action: none; }
.up-remove { position: absolute; left: -11px; top: -11px; width: 22px; height: 22px; border-radius: 50%;
  background: var(--danger); color: #fff; border: 2px solid #fff; font-size: 14px; line-height: 1; cursor: pointer;
  display: grid; place-items: center; padding: 0; box-shadow: 0 1px 5px rgba(0,0,0,0.35); }
.rotate-handle { position: absolute; left: 50%; top: -30px; transform: translateX(-50%);
  width: 20px; height: 20px; border-radius: 50%; background: #fff; border: 2px solid var(--accent);
  cursor: grab; box-shadow: 0 1px 5px rgba(0,0,0,0.35); touch-action: none; }
.rotate-handle::before { content: ""; position: absolute; left: 50%; top: 100%; width: 2px; height: 10px;
  background: var(--accent); transform: translateX(-50%); }
.rotate-handle:active { cursor: grabbing; }
.upload-handle, .up-remove, .rotate-handle { opacity: 0; transition: opacity .2s ease; }
.up-el:hover .upload-handle, .up-el.selected .upload-handle,
.up-el:hover .up-remove, .up-el.selected .up-remove,
.up-el:hover .rotate-handle, .up-el.selected .rotate-handle { opacity: 1; }
.up-el { position: absolute; transform: translate(-50%, -50%); pointer-events: auto; cursor: move; touch-action: none;
  outline: 1.5px dashed transparent; outline-offset: 5px; border-radius: 2px; transition: outline-color .2s ease; }
.up-el:hover, .up-el.selected { outline-color: rgba(0,113,227,0.7); }
.up-guide { position: absolute; background: #ff375f; opacity: 0; pointer-events: none; z-index: 6; transition: opacity .12s; }
.up-guide-v { left: 50%; top: 0; bottom: 0; width: 1.5px; transform: translateX(-0.75px); }
.up-guide-h { top: 50%; left: 0; right: 0; height: 1.5px; transform: translateY(-0.75px); }
.up-guide.on { opacity: 0.9; }
/* Printable area: the box the customer's design must stay inside (set per product). */
.print-area { position: absolute; left: 22%; top: 30%; width: 56%; height: 40%;
  container-type: inline-size; z-index: 5; pointer-events: none; border-radius: 3px; }
/* Shown to the customer as a blue guide line. */
.print-area.outline { outline: 1.8px dashed #0071e3; outline-offset: 0; }
/* Label sits just OUTSIDE (above) the print-area box, centred. */
.print-area-label { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 5px;
  font-size: 10px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: #0071e3;
  background: rgba(255, 255, 255, 0.85); padding: 1px 7px; border-radius: 5px; pointer-events: none;
  white-space: nowrap; opacity: 0; transition: opacity .2s ease; }
.print-area.outline .print-area-label { opacity: 1; }
.print-area .up-el { pointer-events: auto; }
/* Setup mode (merchant only, via ?printsetup=1): drag/resize the box. */
.print-area.setup { pointer-events: auto; cursor: move; outline: 2.5px solid #0071e3;
  background: rgba(0, 113, 227, 0.07); z-index: 8; }
.pa-resize { position: absolute; right: -9px; bottom: -9px; width: 18px; height: 18px; z-index: 9;
  background: #0071e3; border: 2px solid #fff; border-radius: 50%; cursor: nwse-resize;
  box-shadow: 0 1px 5px rgba(0,0,0,0.4); touch-action: none; }
.pa-readout { position: fixed; top: 12px; left: 50%; transform: translateX(-50%); z-index: 10000;
  background: #0071e3; color: #fff; padding: 9px 16px; border-radius: 12px; font-size: 13px; font-weight: 600;
  text-align: center; box-shadow: 0 8px 24px rgba(0,0,0,0.28); max-width: 92vw; }
.pa-readout span { display: block; opacity: 0.9; font-size: 11px; font-weight: 400; margin-top: 2px; }
.up-img { display: grid; place-items: center; }
.up-img img { max-width: 100%; max-height: 60cqmin; object-fit: contain; pointer-events: none; -webkit-user-drag: none;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.18)); }
/* Lines break only at the wrap points we insert (20 letters / 12 emoji per line). */
.up-txt { white-space: pre; text-align: center; font-weight: 600; line-height: 1.2; text-shadow: 0 1px 2px rgba(255,255,255,0.55); }
.up-txt-content { pointer-events: none; display: inline-block; }
.up-controls { display: flex; flex-direction: column; gap: 12px; padding: 16px 24px 8px; }
.dropzone.small { padding: 13px 16px; display: flex; align-items: center; justify-content: center; gap: 10px; border-radius: var(--r-md); }
.dropzone.small strong { display: inline; margin: 0; font-size: 14px; }
.dropzone.small .formats { margin: 0; }
.up-fonts { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
.up-font { border: 1px solid var(--line); border-radius: 10px; padding: 6px 14px; background: var(--bg);
  font-size: 18px; color: var(--ink); cursor: pointer; min-width: 46px; line-height: 1.2; transition: border-color .15s, box-shadow .15s; }
.up-font:hover { border-color: var(--ink-faint); }
.up-font[aria-pressed="true"] { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
.upload-empty { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: max-content; max-width: 74%; font-size: 14px; color: var(--ink-faint);
  pointer-events: none; text-align: center; line-height: 1.4; }
.engrave-overlay {
  position: absolute; left: 50%; top: 56.5%; transform: translate(-50%, -50%);
  font-size: clamp(13px, 5.2cqw, 24px); letter-spacing: 0.03em; font-weight: 500;
  color: #9a9ba2; text-align: center; white-space: pre-wrap; pointer-events: none;
  text-shadow: 0 1px 0 rgba(255,255,255,0.7); line-height: 1.25;
}
.engrave-input-wrap { display: flex; justify-content: center; align-items: center; gap: 10px; padding: 36px 40px 6px; }
.engrave-input {
  width: min(560px, 100%); text-align: center; border: 1px solid var(--line);
  border-radius: var(--r-pill); padding: 18px 24px; font-size: 18px; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--ink); background: var(--bg);
  transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
}
/* The field is a textarea now (multi-line, up to 3 lines) — keep the pill look. */
textarea.engrave-input { resize: none; overflow-y: hidden; line-height: 1.35; font-family: inherit;
  display: block; min-height: 56px; max-height: 132px; }
.ios-field textarea.engrave-input { text-align: left; padding: 14px 18px; letter-spacing: .04em; text-transform: none; min-height: 50px; }
.engrave-input-wrap .engrave-input { flex: 0 1 480px; width: auto; }
/* Keyboard show/hide arrow next to the text field */
/* Keyboard is always visible now — the open/close arrow is not used. */
.kbd-arrow { display: none; }
.kbd-arrow-legacy {
  flex: none; width: 40px; height: 40px; border-radius: 50%; border: none; cursor: pointer;
  background: #e4e4ea; color: #3c3c43; display: grid; place-items: center; transition: background var(--dur-fast) ease;
}
.kbd-arrow:hover { background: #d6d6dd; }
.kbd-arrow svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s ease; }
.kbd-arrow.open svg { transform: rotate(180deg); }
.engrave-input::placeholder { color: var(--ink-faint); letter-spacing: 0.14em; }
.engrave-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
/* Fonts row + iPhone keyboard wrapper */
.engrave-tools { display: flex; flex-direction: column; align-items: stretch; gap: 12px; margin: 14px 0 0; }
.engrave-tools .up-fonts { justify-content: center; }

/* iMessage-style compose bar (used in the Upload tool) */
.ios-compose { display: flex; align-items: center; gap: 10px; width: 4.05in; max-width: 100%; margin: 0 auto; padding: 0; }
.ios-plus {
  flex: none; width: 42px; height: 42px; border-radius: 50%; border: none; cursor: pointer;
  background: #e4e4ea; color: #3c3c43; line-height: 1;
  display: grid; place-items: center; transition: background var(--dur-fast) ease;
}
.ios-plus:hover { background: #d6d6dd; }
.ios-plus svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.ios-field { flex: 1; }
.ios-field .engrave-input { width: 100%; text-align: left; padding: 12px 18px; letter-spacing: .04em; text-transform: none; }

/* Emoji picker — borderless, no box around the emoji */
.ios-kb {
  width: 4.05in; max-width: 100%; margin: 6px auto 0; box-sizing: border-box;
  background: transparent; padding: 4px 0 0; user-select: none; -webkit-user-select: none;
  border: none;
}
.ios-keys { display: flex; flex-direction: column; gap: 5px; }
.ios-row { display: flex; gap: 4px; justify-content: center; }
.ios-row-mid { padding: 0 11px; }
.ios-key {
  flex: 1 1 0; min-width: 0; height: 0.336in; padding: 0; display: grid; place-items: center;
  background: transparent; color: #111; border: none; border-radius: 50%; cursor: pointer;
  font-size: 17px; font-weight: 500; box-shadow: none;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
  transition: background .1s ease;
}
/* Hovering a character shows a circle around it. */
.ios-key:not(.ios-fn):hover { background: radial-gradient(circle at center, #e8e8ee 0 0.95em, transparent 1em); }
.ios-key:not(.ios-fn):active { background: radial-gradient(circle at center, #d6d6df 0 0.95em, transparent 1em); }
.ios-fn { background: #f0f0f4; color: #111; font-size: 13px; font-weight: 500; box-shadow: none; border-radius: 9px; }
.ios-fn:hover { background: #e6e6ec; }
.ios-fn:active { background: #dcdce4; }
.ios-key.ios-space:hover { background: #ececf1; border-radius: 12px; }
.ios-key.ios-space:active { background: #e0e0e8; border-radius: 12px; }
.ios-shift, .ios-del { flex: 1.4 1 0; }
.ios-shift.on { background: #fff; }
.ios-del { font-size: 16px; }
.ios-mode, .ios-emokey.ios-fn { flex: 1.3 1 0; }
.ios-globe { flex: 1.1 1 0; }
.ios-globe-ic { width: 17px; height: 17px; fill: none; stroke: #000; stroke-width: 1.4; }
.ios-return { flex: 1.9 1 0; font-size: 12px; }
.ios-space { flex: 5 1 0; font-size: 12px; font-weight: 500; }
.ios-wide { flex: 1.4 1 0; }
