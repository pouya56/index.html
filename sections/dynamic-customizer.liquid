    "labelBackPreview": {{ section.settings.label_back_preview | default: 'Preview Back' | json }},
    "labelText": {{ section.settings.label_text | default: 'Text' | json }},
    "labelBackText": {{ section.settings.label_back_text | default: 'Back text' | json }},
    "backImage": {% if blk_print.settings.back_image %}{{ blk_print.settings.back_image | image_url: width: 1400 | json }}{% else %}""{% endif %},
    {%- assign bpos = blk_print.settings.back_pos | default: '22, 30, 56, 40' | replace: ' ', '' | replace: '.', ',' | split: ',' -%}
    "printBack": {
      "show": {% if blk_print.settings.back_print_show %}true{% else %}false{% endif %},
      "shape": {{ blk_print.settings.back_shape | default: 'rect' | json }},
      "x": {{ bpos[0] | plus: 0 }},
      "y": {{ bpos[1] | plus: 0 }},
      "w": {{ bpos[2] | plus: 0 }},
      "h": {{ bpos[3] | plus: 0 }}
    },
    "backFeeVariantId": {{ blk_print.settings.back_fee_variant_id | default: '' | json }},
    "backFeeMoney": {{ blk_print.settings.back_fee_money | default: '' | json }},
    "sidesOption": {{ blk_print.settings.sides_option_name | default: '' | json }},
    "sidesFrontValue": {{ blk_print.settings.sides_front_value | default: '' | json }},
    "sidesBothValue": {{ blk_print.settings.sides_both_value | default: '' | json }},
    "frontTabLabel": {{ blk_print.settings.front_tab_label | default: 'Front' | json }},
    "backTabLabel": {{ blk_print.settings.back_tab_label | default: 'Back' | json }},
    "eyebrow": {{ dyn_product.vendor | default: '' | json }},
    "title": "",
    "price": "",
    "priceNote": {{ section.settings.price_note | default: '' | json }},
    "description": "",
    "modelLabel": "",
    "customizeLabel": {{ 'Customize' | json }},
