</script>

{%- comment -%} Verified buyer check: has the logged-in customer ordered this product? {%- endcomment -%}
{%- assign dyn_purchased = false -%}
{%- if customer and dyn_product -%}
  {%- for order in customer.orders -%}
    {%- for li in order.line_items -%}
      {%- if li.product_id == dyn_product.id -%}{%- assign dyn_purchased = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if dyn_purchased -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- comment -%} Owner check: is the logged-in customer the account you named as admin? {%- endcomment -%}
{%- assign dyn_owner = false -%}
{%- if customer and customer.email and blk_reviews != blank and blk_reviews.settings.admin_email != blank -%}
  {%- assign dyn_admin_email = blk_reviews.settings.admin_email | downcase | strip -%}
  {%- assign dyn_customer_email = customer.email | downcase | strip -%}
  {%- if dyn_customer_email == dyn_admin_email -%}{%- assign dyn_owner = true -%}{%- endif -%}
{%- endif -%}
<script type="application/json" id="dyn-social-config">
{
  "show": {% if blk_reviews != blank %}true{% else %}false{% endif %},
  "likeBase": {{ blk_reviews.settings.like_base | default: 0 }},
  "shareBase": {{ blk_reviews.settings.share_base | default: 0 }},
  "fbUrl": {{ blk_reviews.settings.firebase_db_url | default: 'https://dynaeimic-social-default-rtdb.firebaseio.com' | json }},
  "verifiedOnly": {% if blk_reviews.settings.reviews_verified_only %}true{% else %}false{% endif %},
  "loggedIn": {% if customer %}true{% else %}false{% endif %},
  "purchased": {% if dyn_purchased %}true{% else %}false{% endif %},
  "customerName": {{ customer.name | default: '' | json }},
  "loginUrl": {{ routes.account_login_url | default: '/account/login' | json }},
  "handle": {% if dyn_product %}{{ dyn_product.handle | json }}{% else %}"product"{% endif %},
  "title": {% if dyn_product %}{{ dyn_product.title | json }}{% else %}""{% endif %},
  "url": {% if dyn_product %}{{ dyn_product.url | json }}{% else %}""{% endif %},
  "image": {% if dyn_product and dyn_product.featured_image %}{{ dyn_product.featured_image | image_url: width: 200 | json }}{% else %}""{% endif %},
  "price": {% if dyn_product %}{{ dyn_product.selected_or_first_available_variant.price | money | json }}{% else %}""{% endif %},
  "adminHash": {% if blk_reviews.settings.admin_key != blank %}{{ blk_reviews.settings.admin_key | sha256 | json }}{% else %}""{% endif %},
  "owner": {% if dyn_owner %}true{% else %}false{% endif %},
  "adminName": {{ blk_reviews.settings.admin_name | default: shop.name | json }}
}
</script>

