/* Apple-style account icon: a grey circle with a person silhouette cropped by it. */
.ig-rv-av { width: 38px; height: 38px; flex: none; border-radius: 50%; overflow: hidden; background: var(--panel); display: flex; align-items: flex-end; justify-content: center; }
