/* the popup keeps it simple: photo on top, then - all centered - the
   product name over an ink rule, the red serif price, and the Admit One
   button underneath. No variations, no description. */
.dyn-popup-open { display: none; }
#dhSlide.dh-slide-half .dh-slide-body { overflow: hidden !important; }
/* vertical centering: the content block floats in the middle of the
   window (auto margins collapse safely if it ever outgrows the panel) */
#dhSlide.dh-slide-half .dh-slide-inject { min-height: 100%; display: flex !important; flex-direction: column; }
#dhSlide.dh-slide-half .dh-slide-inject .product { margin-top: auto !important; margin-bottom: auto !important; }
#dhSlide .dh-slide-inject .product { display: flex !important; flex-direction: column !important;
  align-items: center !important; width: 100% !important; max-width: none !important;
  margin-left: 0 !important; margin-right: 0 !important;
  height: auto !important; max-height: none !important; overflow: visible !important;
  gap: 20px !important; padding-top: 14px !important; padding-bottom: 18px !important; }
#dhSlide .dh-slide-inject .gallery { order: -1; position: static !important;
  width: 100%; display: flex !important; flex-direction: column; align-items: center; }
/* the product is the focal point: ~13% larger, floating on a soft white
   wash that quiets the paper wrinkles behind it, over a faint gallery
   ground shadow */
#dhSlide .dh-slide-inject .gallery-main { width: min(100%, 43vh) !important; position: relative;
  background: radial-gradient(closest-side, rgba(255,255,255,0.9), rgba(255,255,255,0.55) 60%, rgba(255,255,255,0) 100%) !important; }
#dhSlide .dh-slide-inject .gallery-main::after { content: ""; position: absolute; left: 50%; bottom: 2%;
  transform: translateX(-50%); width: 52%; height: 16px; z-index: -1; pointer-events: none;
  background: radial-gradient(ellipse closest-side, rgba(20,17,16,0.16), rgba(20,17,16,0) 75%); }
/* editorial navigation: the hand-drawn arrows keep tiny letterspaced labels */
#dhSlide .dh-slide-inject .gal-nav .gal-prev { left: -84px; }
#dhSlide .dh-slide-inject .gal-nav .gal-next { right: -84px; }
#dhSlide .dh-slide-inject .gal-nav .gal-arrow { overflow: visible !important; }
#dhSlide .dh-slide-inject .gal-nav .gal-arrow::after { position: absolute; top: 100%; left: 50%;
  transform: translateX(-50%); margin-top: 7px; font-size: 9px; font-weight: 600;
  letter-spacing: 0.32em; text-transform: uppercase; color: rgba(23,19,15,0.62); white-space: nowrap; }
#dhSlide .dh-slide-inject .gal-nav .gal-prev::after { content: "Previous"; }
#dhSlide .dh-slide-inject .gal-nav .gal-next::after { content: "Next"; }
/* tiny collectible product line above the photo, magazine-style */
#dhSlide .dh-slide-inject .dyn-popup-meta { order: -2; text-align: center; margin: 0; width: 100%;
  font-size: 9.5px; font-weight: 600; letter-spacing: 0.34em; text-transform: uppercase;
  color: rgba(23,19,15,0.55); }
/* while the window is open, the brand mark rises a touch */
body:has(#dhSlide.dh-slide-half.is-open) .dyn-hero .dh-head { transform: translateY(-10px); }
#dhSlide .dh-slide-inject #buyBox.col-right { display: flex !important; position: relative;
  flex-direction: column; align-items: center; text-align: center; gap: 14px;
  width: min(100%, 660px); margin: 0 auto; padding: 26px 8% 30px !important; }
#dhSlide .dh-slide-inject #buyBox.col-right .headline {
  margin: 0; padding: 0 0 10px; border-bottom: 2.5px solid #17130f; min-width: 46%;
  font-family: Georgia, "Times New Roman", serif !important; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.06em; font-size: clamp(23px, 2.3vw, 34px); color: #17130f !important; }
/* the price whispers: small letterspaced label, not a shouting number */
#dhSlide .dh-slide-inject #buyBox.col-right .price-row { margin: 0; justify-content: center; }
#dhSlide .dh-slide-inject #buyBox.col-right .price-row .price {
  font-family: Georgia, "Times New Roman", serif !important; font-weight: 600;
  font-size: 13.5px; letter-spacing: 0.28em; text-transform: uppercase; color: #8f2b30 !important; }
#dhSlide .dh-slide-inject #buyBox.col-right .price-row .price-note { display: none; }
#dhSlide .dh-slide-inject #buyBox.col-right .dyn-popup-open { display: flex !important;
  position: static !important; top: auto !important; bottom: auto !important; right: auto !important;
  width: auto !important; margin: 12px 0 0 !important; }
#dhSlide .dh-slide-inject #buyBox.col-right .dyn-popup-open:hover span { color: #a1272e !important; border-color: #a1272e !important; }
#dhSlide .dh-slide-inject #buyBox.col-right .dyn-actionbar,
#dhSlide .dh-slide-inject #buyBox.col-right .dyn-steps,
#dhSlide .dh-slide-inject #buyBox.col-right .eyebrow,
#dhSlide .dh-slide-inject #buyBox.col-right .opt-group,
#dhSlide .dh-slide-inject #buyBox.col-right .dyn-acc,
#dhSlide .dh-slide-inject #buyBox.col-right .reassure,
#dhSlide .dh-slide-inject #buyBox.col-right .ig-social { display: none !important; }
#dhSlide .dh-slide-inject .dyn-topbar { position: static; padding: 42px 22px 0; }
{%- if section.settings.popup_ticket_image != blank -%}
/* uploaded ticket artwork behind the whole info area */
#dhSlide .dh-slide-inject #buyBox.col-right {
  background: url('{{ section.settings.popup_ticket_image | image_url: width: 1400 }}') center / 100% 100% no-repeat; }
{%- endif -%}

</style>

  <!-- Header (logo + glass bar + search) is now its own section: dynamic-header.liquid -->

  <!-- Logo masthead (links home) — filled by the injector script below -->
  <div class="dyn-topbar is-center" id="dynTopbar" hidden>
    <a class="dyn-logo" id="dynTopLogo" href="/" aria-label="Home"></a>
  </div>

  <!-- Inflation filter for CTA outlines. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <filter id="dynPuff" x="-8%" y="-20%" width="116%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.045" numOctaves="2" seed="4" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="7" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>

  <!-- Editorial overlay (loads after base styles; steps out of raw). -->
  {% endraw %}{{ 'dynamic-editorial.css' | asset_url | stylesheet_tag }}{% raw %}

  <!-- Product page -->
  <main class="product">
    <div class="gallery">
      <div class="gallery-main">
        <!-- Hidden original stage + arrows: app hooks + fallback. -->
        <div class="gallery-stage" id="galleryStage" hidden></div>
        <button class="gal-arrow" id="galPrev" hidden aria-hidden="true">&#8249;</button>
        <button class="gal-arrow" id="galNext" hidden aria-hidden="true">&#8250;</button>
        <!-- Swipeable card-stack deck (self-contained, no external library). -->
        <div class="dyn-cards" id="dynCards"></div>
        <!-- Prev / next arrows in a glass pill at the bottom. -->
        <div class="gal-nav">
          <button class="gal-arrow gal-prev" id="cardsPrev" aria-label="Previous image">&#8249;</button>
          <button class="gal-arrow gal-next" id="cardsNext" aria-label="Next image">&#8250;</button>
        </div>
      </div>
      <!-- Thumbnails hidden; app wiring intact. -->
      <div class="gallery-thumbs" id="galleryThumbs" hidden></div>
      <script type="application/json" id="dynCardsData">
        {
          "product": [{% if dyn_product %}{% for img in dyn_product.images %}{{ img | image_url: width: 1000 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}],
          "gallery": [
            {% if section.settings.gallery_1 %}{{ section.settings.gallery_1 | image_url: width: 1000 | json }}{% else %}""{% endif %},
            {% if section.settings.gallery_2 %}{{ section.settings.gallery_2 | image_url: width: 1000 | json }}{% else %}""{% endif %},
            {% if section.settings.gallery_3 %}{{ section.settings.gallery_3 | image_url: width: 1000 | json }}{% else %}""{% endif %},
            {% if section.settings.gallery_4 %}{{ section.settings.gallery_4 | image_url: width: 1000 | json }}{% else %}""{% endif %},
            {% if section.settings.gallery_5 %}{{ section.settings.gallery_5 | image_url: width: 1000 | json }}{% else %}""{% endif %}
          ],
          "demo": [{{ 'gal-1.png' | asset_url | json }}, {{ 'gal-2.png' | asset_url | json }}, {{ 'gal-3.png' | asset_url | json }}, {{ 'gal-4.png' | asset_url | json }}, {{ 'gal-5.png' | asset_url | json }}]
        }
      </script>
    </div>

    <section class="detail col-right" id="buyBox">
      <h1 class="headline" id="pName"></h1>
      <div class="eyebrow" id="pEyebrow"></div>

      <div class="price-row">
        <span class="price" id="pPrice"></span>
        <span class="price-note" id="pPriceNote"></span>
      </div>

      <!-- Primary actions under the price. -->
      <div class="dyn-actionbar" id="dynActionBar">
        <div class="dyn-actionbar-inner">
          <div class="cta-stack">
            <div class="cta-row">
              <button class="btn btn-primary btn-lg btn-block" id="customizeBtn">Start Designing</button>
            </div>
            <!-- Appears once a design is saved; submits it with the gift-wrap choice. -->
            <button class="btn btn-primary btn-lg btn-block" id="pageAddCart" hidden>Add to Cart</button>
            <div class="customize-summary" id="customizeSummary"></div>
          </div>
          <!-- Gift options mount (filled by the app when enabled in settings) -->
          <div id="giftMount"></div>
        </div>
      </div>
      <!-- Popup-only: one button straight to the product page (inline styles). -->
      <a class="dyn-popup-open" href="#"
        style="display:none;flex-direction:column;gap:8px;align-items:center;justify-content:center;text-decoration:none;z-index:6;background:none;border:0;box-shadow:none;padding:8px 2px;margin:6px 0 0;">
        <span style="font:800 19px Georgia,'Times New Roman',serif;letter-spacing:.14em;text-transform:uppercase;color:#17130f;border-bottom:2px solid #17130f;padding-bottom:7px;white-space:nowrap;">Open Product</span>
        <span style="font:600 10.5px Georgia,'Times New Roman',serif;letter-spacing:.3em;text-transform:uppercase;color:rgba(23,19,15,0.72);white-space:nowrap;">Start customizing</span>
      </a>
      <script>
      /* Popup stub belt-and-braces (no-op on the normal page). */
      (function () {
        var tries = 0;
        function imp(el, map) { for (var k in map) { try { el.style.setProperty(k, map[k], "important"); } catch (e) {} } }
        function stub() {
          tries++;
          var bb = document.querySelector("#dhSlide .dh-slide-inject #buyBox");
          if (!bb) { if (tries < 80) setTimeout(stub, 250); return; }
          var a = bb.querySelector(".dyn-popup-open");
          if (!a) {
            a = document.createElement("a");
            a.className = "dyn-popup-open";
            bb.appendChild(a);
          }
          /* the product URL comes from the page's own config JSON - the
             markup href stays a plain # so no Liquid ever sits in it */
          var url = "#";
          try { url = (JSON.parse(document.getElementById("dyn-config").textContent).shopify || {}).productUrl || "#"; } catch (e) {}
          var cur = a.getAttribute("href") || "#";
          if (url && url !== "#" && (cur === "#" || cur.indexOf("%7B") !== -1 || cur.indexOf("{") !== -1)) a.href = url;
          if (getComputedStyle(bb).position === "static") bb.style.position = "relative";
          imp(a, { position: "relative", top: "auto", bottom: "auto", right: "auto", width: "auto",
            display: "flex", "flex-direction": "column", gap: "8px", "align-items": "center",
            "justify-content": "center", "text-decoration": "none", "z-index": "6",
            visibility: "visible", opacity: "1", background: "none", border: "0", "box-shadow": "none",
            padding: "8px 2px", margin: "6px 0 0", "min-height": "0", height: "auto" });
          var art = getComputedStyle(a).backgroundImage;
          if ((!art || art === "none") && !a.querySelector("span") && !a.querySelector(".dyn-po-t")) {
            a.innerHTML = "";
            var s1 = document.createElement("span");
            s1.className = "dyn-po-t"; s1.textContent = "Open Product";
            s1.style.cssText = "font:800 19px Georgia,'Times New Roman',serif;letter-spacing:.14em;text-transform:uppercase;color:#17130f;border-bottom:2px solid #17130f;padding-bottom:7px;white-space:nowrap;";
            var s2 = document.createElement("span");
            s2.textContent = "Start customizing";
            s2.style.cssText = "font:600 10.5px Georgia,'Times New Roman',serif;letter-spacing:.3em;text-transform:uppercase;color:rgba(23,19,15,0.72);white-space:nowrap;";
            a.appendChild(s1); a.appendChild(s2);
          }
          /* premium price copy: "$22.00" reads as "FROM $22" */
          var pp = document.querySelector("#dhSlide .dh-slide-inject #pPrice");
          if (pp) {
            var pt = (pp.textContent || "").trim();
            if (pt && !/^from/i.test(pt)) pp.textContent = "From " + pt.replace(/\.00$/, "");
          }
          /* collectible product number above the photo, derived from the URL */
          var prod = document.querySelector("#dhSlide .dh-slide-inject .product");
          if (prod && !prod.querySelector(".dyn-popup-meta")) {
            var hsh = 0, uu = url || "";
            for (var hi = 0; hi < uu.length; hi++) hsh = (hsh * 31 + uu.charCodeAt(hi)) % 997;
            var meta = document.createElement("div");
            meta.className = "dyn-popup-meta";
            meta.textContent = "Dynaeimic \u00b7 Product " + String(hsh + 1).replace(/^(\d)$/, "00$1").replace(/^(\d\d)$/, "0$1");
            prod.insertBefore(meta, prod.firstChild);
          }
          if (tries < 80) setTimeout(stub, 500);
        }
        stub();
      })();
