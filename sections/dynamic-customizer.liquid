    "accountsEnabled": {% if shop.customer_accounts_enabled %}true{% else %}false{% endif %},
    "cloudName": "",
    "uploadPreset": "",
    "onProductPage": {% if dyn_product %}true{% else %}false{% endif %}
  },
  "settings": {
    "customizerType": {{ cust_method | json }},
    "customizeEnabled": {% if customize_on %}true{% else %}false{% endif %},
    "methodLabel": {{ blk_m.settings.method_label | default: '' | json }},
    "methodUpload": {% if blk_m != blank %}{% if blk_m.settings.allow_upload %}true{% else %}false{% endif %}{% else %}null{% endif %},
    "methodUploadBack": {% if blk_m != blank %}{% if blk_m.settings.allow_upload_back %}true{% else %}false{% endif %}{% else %}null{% endif %},
    "methodText": {% if blk_m != blank %}{% if blk_m.settings.allow_text %}true{% else %}false{% endif %}{% else %}null{% endif %},
    "showEmoji": {% if blk_m != blank %}{% if blk_m.settings.show_emoji %}true{% else %}false{% endif %}{% else %}null{% endif %},
    "emojiList": {{ blk_m.settings.emoji_list | default: '' | json }},
    "madeToOrder": {% if dyn_product.tags contains 'made-to-order' or dyn_product.tags contains 'made_to_order' %}true{% else %}false{% endif %},
    {%- assign gw_vid = blk_gift.settings.gift_wrap_variant_id -%}
    {%- assign gw_money = blk_gift.settings.gift_wrap_money -%}
    {%- if blk_gift.settings.gift_wrap_product != blank -%}
      {%- assign gw_prod = blk_gift.settings.gift_wrap_product -%}
      {%- assign gw_vid = gw_prod.selected_or_first_available_variant.id -%}
      {%- assign gw_money = gw_prod.price | money -%}
    {%- endif -%}
    "gift": {
      "enabled": {% if blk_gift != blank %}true{% else %}false{% endif %},
      "wrapOption": {{ blk_gift.settings.gift_wrap_option | default: '' | json }},
      "wrappedValue": {{ blk_gift.settings.gift_wrapped_value | default: 'Yes' | json }},
      "unwrappedValue": {{ blk_gift.settings.gift_unwrapped_value | default: 'No' | json }},
      "wrapVariantId": {{ gw_vid | default: '' | json }},
      "wrapMoney": {{ gw_money | default: '' | json }},
      "toggleLabel": {{ blk_gift.settings.gift_toggle_label | default: 'This is a gift' | json }},
      "wrapLabel": {{ blk_gift.settings.gift_wrap_label | default: 'Add gift wrapping' | json }},
      "noteLabel": {{ blk_gift.settings.gift_note_label | default: 'Add a gift note (optional)' | json }}
    },
    {%- comment -%} Tolerant parse: spaces ignored, a '.' typo counts as a comma. {%- endcomment -%}
    {%- assign fpos = blk_print.settings.print_pos | default: '22, 30, 56, 40' | replace: ' ', '' | replace: '.', ',' | split: ',' -%}
    "print": {
      "show": {% if blk_print == blank or blk_print.settings.print_show %}true{% else %}false{% endif %},
      "shape": {{ blk_print.settings.print_shape | default: 'rect' | json }},
      "x": {{ fpos[0] | plus: 0 }},
      "y": {{ fpos[1] | plus: 0 }},
      "w": {{ fpos[2] | plus: 0 }},
      "h": {{ fpos[3] | plus: 0 }}
    },
    "enableBack": {% if blk_print.settings.enable_back %}true{% else %}false{% endif %},
    "frontImage": {% if blk_print.settings.front_image %}{{ blk_print.settings.front_image | image_url: width: 1400 | json }}{% else %}""{% endif %},
    "exampleImage": {% if blk_print.settings.example_image %}{{ blk_print.settings.example_image | image_url: width: 1000 | json }}{% else %}""{% endif %},
    "sampleImage": {% if blk_print.settings.sample_image %}{{ blk_print.settings.sample_image | image_url: width: 1200 | json }}{% else %}""{% endif %},
    "sampleImage2": {% if blk_print.settings.sample_image_2 %}{{ blk_print.settings.sample_image_2 | image_url: width: 1200 | json }}{% else %}""{% endif %},
    "sampleCaption": {{ blk_print.settings.sample_caption | default: 'How your finished product will look' | json }},
    "sampleButtonLabel": {{ blk_print.settings.sample_button_label | default: 'See a finished sample' | json }},
    "labelDesign": {{ section.settings.label_design | default: 'Print Front' | json }},
    "labelBackDesign": {{ section.settings.label_back_design | default: 'Print Back' | json }},
