{% endraw %}
{%- comment -%} Button skins & effects resolve from THIS section first, then from
   Theme settings (Theme settings -> Dynamic buttons) — so one global setup can
   cover every product page, with per-template overrides. {%- endcomment -%}
{%- assign img_cz = section.settings.cta_img_customize | default: settings.cta_img_customize -%}
{%- assign img_ac = section.settings.cta_img_addcart | default: settings.cta_img_addcart -%}
{%- assign img_ad = section.settings.cta_img_adddesign | default: settings.cta_img_adddesign -%}
{%- assign img_ck = section.settings.cta_img_checkout | default: settings.cta_img_checkout -%}
{%- if img_cz != blank -%}{%- assign img_cz_w = section.settings.cta_img_customize_w | default: 100 -%}{%- else -%}{%- assign img_cz_w = settings.cta_img_customize_w | default: 100 -%}{%- endif -%}
{%- if img_ac != blank -%}{%- assign img_ac_w = section.settings.cta_img_addcart_w | default: 100 -%}{%- else -%}{%- assign img_ac_w = settings.cta_img_addcart_w | default: 100 -%}{%- endif -%}
{%- if img_ad != blank -%}{%- assign img_ad_h = section.settings.cta_img_adddesign_h | default: 54 -%}{%- else -%}{%- assign img_ad_h = settings.cta_img_adddesign_h | default: 54 -%}{%- endif -%}
{%- if img_ck != blank -%}{%- assign img_ck_w = section.settings.cta_img_checkout_w | default: 100 -%}{%- else -%}{%- assign img_ck_w = settings.cta_img_checkout_w | default: 100 -%}{%- endif -%}
{%- assign img_text_on = true -%}
{%- unless section.settings.cta_img_text -%}{%- assign img_text_on = false -%}{%- endunless -%}
{%- if settings.cta_img_text == false -%}{%- assign img_text_on = false -%}{%- endif -%}
{%- assign fxo_lift = false -%}{%- if section.settings.fx_lift or settings.fx_lift -%}{%- assign fxo_lift = true -%}{%- endif -%}
{%- assign fxo_breathe = false -%}{%- if section.settings.fx_breathe or settings.fx_breathe -%}{%- assign fxo_breathe = true -%}{%- endif -%}
{%- assign fxo_squish = false -%}{%- if section.settings.fx_squish or settings.fx_squish -%}{%- assign fxo_squish = true -%}{%- endif -%}
{%- assign fxo_gloss = false -%}{%- if section.settings.fx_gloss or settings.fx_gloss -%}{%- assign fxo_gloss = true -%}{%- endif -%}
{%- assign fxo_confetti = false -%}{%- if section.settings.fx_confetti or settings.fx_confetti -%}{%- assign fxo_confetti = true -%}{%- endif -%}
{%- comment -%} Image button skins: each uploaded image IS its button — shown
   whole, at its own proportions, with a silhouette drop shadow. Separate
   images for Customize and Add to Cart. (Lives OUTSIDE the raw block so the
   Liquid evaluates.) {%- endcomment -%}
{%- if img_cz != blank -%}
<style>
#customizeBtn.btn-primary {
  background: url({{ img_cz | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  box-shadow: none; border-radius: 0; border: none; overflow: visible;
  -webkit-backdrop-filter: none; backdrop-filter: none;
  aspect-ratio: {{ img_cz.aspect_ratio }};
  width: {{ img_cz_w }}%; margin-left: auto; margin-right: auto;
  padding: 0;
  filter: drop-shadow(0 16px 22px rgba(60, 60, 90, 0.3));
}
#customizeBtn.btn-primary::before, #customizeBtn.btn-primary::after { display: none; }
{%- unless img_text_on -%}
#customizeBtn.btn-primary { font-size: 0; text-shadow: none; }
{%- endunless -%}
#customizeBtn.btn-primary:hover {
  filter: drop-shadow(0 20px 28px rgba(60, 60, 90, 0.38)) brightness(1.04);
}
</style>
{%- endif -%}
{%- if img_ac != blank -%}
<style>
#pageAddCart.btn-primary {
  background: url({{ img_ac | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  box-shadow: none; border-radius: 0; border: none; overflow: visible;
  -webkit-backdrop-filter: none; backdrop-filter: none;
  aspect-ratio: {{ img_ac.aspect_ratio }};
  width: {{ img_ac_w }}%; margin-left: auto; margin-right: auto;
  padding: 0;
  filter: drop-shadow(0 16px 22px rgba(60, 60, 90, 0.3));
}
#pageAddCart.btn-primary::before, #pageAddCart.btn-primary::after { display: none; }
{%- unless img_text_on -%}
#pageAddCart.btn-primary { font-size: 0; text-shadow: none; }
{%- endunless -%}
#pageAddCart.btn-primary:hover {
  filter: drop-shadow(0 20px 28px rgba(60, 60, 90, 0.38)) brightness(1.04);
}
</style>
{%- endif -%}
{%- if img_ck != blank -%}
<style>
#dynCartCheckout.btn-primary {
  background: url({{ img_ck | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  box-shadow: none; border-radius: 0; border: none; overflow: visible;
  -webkit-backdrop-filter: none; backdrop-filter: none;
  aspect-ratio: {{ img_ck.aspect_ratio }};
  width: {{ img_ck_w }}%; margin-left: auto; margin-right: auto;
  padding: 0; text-decoration: none;
  filter: drop-shadow(0 16px 22px rgba(60, 60, 90, 0.3));
}
#dynCartCheckout.btn-primary::before, #dynCartCheckout.btn-primary::after { display: none; }
{%- unless img_text_on -%}
#dynCartCheckout.btn-primary { font-size: 0; text-shadow: none; }
{%- endunless -%}
#dynCartCheckout.btn-primary:hover {
  filter: drop-shadow(0 20px 28px rgba(60, 60, 90, 0.38)) brightness(1.04);
}
</style>
{%- endif -%}
{%- if img_ad != blank -%}
<style>
#uploadApply.btn-primary {
  background: url({{ img_ad | image_url: width: 900 }}) center / 100% 100% no-repeat;
  box-shadow: none; border-radius: 0; border: none; overflow: visible;
  -webkit-backdrop-filter: none; backdrop-filter: none;
  height: {{ img_ad_h }}px; aspect-ratio: {{ img_ad.aspect_ratio }};
  padding: 0;
  filter: drop-shadow(0 10px 16px rgba(60, 60, 90, 0.3));
}
#uploadApply.btn-primary::before { display: none; }
{%- unless img_text_on -%}
#uploadApply.btn-primary { font-size: 0; text-shadow: none; }
{%- endunless -%}
#uploadApply.btn-primary:hover:not([disabled]) {
  /* Re-assert the image: the pink cushion's hover rule otherwise repaints the background */
  background: url({{ img_ad | image_url: width: 900 }}) center / 100% 100% no-repeat;
  box-shadow: none;
  filter: drop-shadow(0 14px 20px rgba(60, 60, 90, 0.38)) brightness(1.04);
}
#uploadApply.btn-primary[disabled] { filter: drop-shadow(0 10px 16px rgba(60, 60, 90, 0.25)) grayscale(0.4) opacity(0.6); }
</style>
{%- endif -%}
{%- if fxo_lift or fxo_breathe or fxo_squish or fxo_gloss or fxo_confetti -%}
{%- comment -%} Optional button effects — each is a checkbox in "Button effects". {%- endcomment -%}
<style>
{%- if fxo_breathe -%}
@media (prefers-reduced-motion: no-preference) {
  #customizeBtn.btn-primary, #pageAddCart.btn-primary, #dynCartCheckout.btn-primary, #uploadApply.btn-primary:not([disabled]) {
    animation: dynFxBreathe 3.4s ease-in-out infinite;
  }
}
@keyframes dynFxBreathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.025); } }
{%- endif -%}
{%- if fxo_lift -%}
#customizeBtn.btn-primary, #pageAddCart.btn-primary, #dynCartCheckout.btn-primary, #uploadApply.btn-primary { transition: transform .18s ease, filter .2s ease, box-shadow .2s ease; }
#customizeBtn.btn-primary:hover, #pageAddCart.btn-primary:hover, #dynCartCheckout.btn-primary:hover, #uploadApply.btn-primary:hover:not([disabled]) {
  animation: none; transform: translateY(-4px) scale(1.02);
}
{%- endif -%}
{%- if fxo_squish -%}
#customizeBtn.btn-primary.dyn-fx-squish, #pageAddCart.btn-primary.dyn-fx-squish, #uploadApply.btn-primary.dyn-fx-squish {
  animation: dynFxSquish .5s cubic-bezier(.3, 1.6, .4, 1); transform-origin: 50% 100%;
}
@keyframes dynFxSquish {
  0% { transform: scaleY(1) scaleX(1); }
  35% { transform: scaleY(0.78) scaleX(1.12); }
  65% { transform: scaleY(1.06) scaleX(0.97); }
  100% { transform: scaleY(1) scaleX(1); }
}
@media (prefers-reduced-motion: reduce) { .dyn-fx-squish { animation: none !important; } }
{%- endif -%}
{%- if fxo_gloss -%}
{%- if img_cz != blank -%}
#customizeBtn.btn-primary { position: relative; }
#customizeBtn.btn-primary::after { content: "" !important; display: block !important; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(115deg, transparent 42%, rgba(255,255,255,0.55) 50%, transparent 58%) no-repeat; background-size: 260% 100%;
  -webkit-mask: url({{ img_cz | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  mask: url({{ img_cz | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  animation: dynFxGloss 5.5s ease-in-out infinite; }
{%- endif -%}
{%- if img_ac != blank -%}
#pageAddCart.btn-primary { position: relative; }
#pageAddCart.btn-primary::after { content: "" !important; display: block !important; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(115deg, transparent 42%, rgba(255,255,255,0.55) 50%, transparent 58%) no-repeat; background-size: 260% 100%;
  -webkit-mask: url({{ img_ac | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  mask: url({{ img_ac | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  animation: dynFxGloss 5.5s ease-in-out infinite; animation-delay: 1.1s; }
{%- endif -%}
{%- if img_ad != blank -%}
#uploadApply.btn-primary { position: relative; }
#uploadApply.btn-primary::after { content: "" !important; display: block !important; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(115deg, transparent 42%, rgba(255,255,255,0.55) 50%, transparent 58%) no-repeat; background-size: 260% 100%;
  -webkit-mask: url({{ img_ad | image_url: width: 900 }}) center / 100% 100% no-repeat;
  mask: url({{ img_ad | image_url: width: 900 }}) center / 100% 100% no-repeat;
  animation: dynFxGloss 5.5s ease-in-out infinite; animation-delay: 2.2s; }
{%- endif -%}
{%- if img_ck != blank -%}
#dynCartCheckout.btn-primary { position: relative; }
#dynCartCheckout.btn-primary::after { content: "" !important; display: block !important; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(115deg, transparent 42%, rgba(255,255,255,0.55) 50%, transparent 58%) no-repeat; background-size: 260% 100%;
  -webkit-mask: url({{ img_ck | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  mask: url({{ img_ck | image_url: width: 1200 }}) center / 100% 100% no-repeat;
  animation: dynFxGloss 5.5s ease-in-out infinite; animation-delay: 3.3s; }
{%- endif -%}
@keyframes dynFxGloss { 0% { background-position: 220% 0; } 55% { background-position: -60% 0; } 100% { background-position: -60% 0; } }
@media (prefers-reduced-motion: reduce) {
  #customizeBtn.btn-primary::after, #pageAddCart.btn-primary::after, #dynCartCheckout.btn-primary::after, #uploadApply.btn-primary::after { animation: none !important; }
}
{%- endif -%}
</style>
<script>
(function () {
  {%- if fxo_squish -%}
  ["customizeBtn", "pageAddCart", "uploadApply"].forEach(function (id) {
    var b = document.getElementById(id); if (!b) return;
    b.addEventListener("click", function () {
      if (b.disabled) return;
      b.classList.remove("dyn-fx-squish"); void b.offsetWidth; // restart the animation
      b.classList.add("dyn-fx-squish");
      setTimeout(function () { b.classList.remove("dyn-fx-squish"); }, 520);
    });
  });
  {%- endif -%}
  {%- if fxo_confetti -%}
  var COLORS = ["#ff5c8a", "#ffb340", "#4cd964", "#5ac8fa", "#af7aff", "#ffd60a"];
  window.addEventListener("dyn:added-to-cart", function () {
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var el = document.getElementById("pageAddCart") || document.getElementById("customizeBtn");
    if (!el) return;
    var r = el.getBoundingClientRect();
    var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
    for (var i = 0; i < 26; i++) {
      var p = document.createElement("div");
      var s = 5 + Math.random() * 6;
      p.style.cssText = "position:fixed;left:" + cx + "px;top:" + cy + "px;width:" + s + "px;height:" + (s * 0.6) + "px;background:" + COLORS[i % COLORS.length] + ";border-radius:2px;z-index:100002;pointer-events:none;";
      document.body.appendChild(p);
      var ang = Math.random() * Math.PI * 2, v = 60 + Math.random() * 130;
      var dx = Math.cos(ang) * v, dy = Math.sin(ang) * v - 90;
      var anim = p.animate([
        { transform: "translate(0,0) rotate(0deg)", opacity: 1 },
        { transform: "translate(" + dx + "px," + (dy + 60) + "px) rotate(" + (Math.random() * 540 - 270) + "deg)", opacity: 1, offset: 0.6 },
        { transform: "translate(" + (dx * 1.2) + "px," + (dy + 240) + "px) rotate(" + (Math.random() * 720 - 360) + "deg)", opacity: 0 }
      ], { duration: 950 + Math.random() * 350, easing: "cubic-bezier(.2,.7,.3,1)" });
      anim.onfinish = (function (node) { return function () { node.remove(); }; })(p);
    }
  });
  {%- endif -%}
})();
</script>
{%- endif -%}
{%- comment -%} Instant pre-fill: paint the REAL title/price the moment the shell
   exists, so nothing flashes while the deferred app JS loads. The price mirrors
   the app's boot choice: a "Print sides" option is forced to its front-only
   value, so the number doesn't change once the app resolves variants. {%- endcomment -%}
{%- if dyn_product -%}
{%- assign pf_first = dyn_product.selected_or_first_available_variant -%}
{%- assign pf_price = pf_first.price -%}
{%- assign pf_front_val = blk_print.settings.sides_front_value | default: 'Front only' | downcase -%}
{%- assign pf_idx = -1 -%}
{%- for o in dyn_product.options_with_values -%}
  {%- assign pf_on = o.name | downcase -%}
  {%- if pf_on contains 'side' and o.values.size > 1 and pf_idx == -1 -%}{%- assign pf_idx = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- if pf_idx > -1 -%}
  {%- assign pf_match = blank -%}{%- assign pf_any = blank -%}
  {%- for v in dyn_product.variants -%}
    {%- assign pf_v = v.options[pf_idx] | downcase -%}
    {%- if pf_v == pf_front_val -%}
      {%- if pf_any == blank -%}{%- assign pf_any = v -%}{%- endif -%}
      {%- if pf_match == blank and v.options.first == pf_first.options.first -%}{%- assign pf_match = v -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if pf_match != blank -%}{%- assign pf_price = pf_match.price -%}
  {%- elsif pf_any != blank -%}{%- assign pf_price = pf_any.price -%}{%- endif -%}
{%- endif -%}
