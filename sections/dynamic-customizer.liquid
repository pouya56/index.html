/* Owner (store admin) — an X.com-style blue verified seal on the owner's replies. */
.ig-owner-badge { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; margin: 0 4px 0 2px; vertical-align: middle; }
.ig-x-badge { width: 100%; height: 100%; display: block; }
.ig-x-badge .seal { fill: #1d9bf0; }
.ig-x-badge .tick { fill: #fff; }
.is-owner-reply .ig-rv-cbody b { color: #0a6ebd; }
.ig-owner-pill { display: flex; align-items: center; gap: 8px; margin: 12px 0 2px; padding: 8px 12px; border-radius: 12px; background: rgba(29,155,240,.1); color: #0a6ebd; font-size: 13px; font-weight: 600; }
.ig-owner-pill .ig-owner-check { display: inline-flex; width: 18px; height: 18px; flex: none; }
