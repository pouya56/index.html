{%- comment -%} In-place designer: the workspace mounts into the product
  page itself (stage on the image, tools in the buy box). Same machinery;
  untick the setting for the popup. {%- endcomment -%}
{%- unless section.settings.inline_designer == false -%}
<style>
  /* While designing (dyn-designing set only when the in-page move worked),
     the modal shell never shows: its stage lives on the product image and
     its tabs/controls/footer sit under Start Designing in the buy box. */
  html.dyn-designing #modalRoot.open { display: none !important; }
  html.dyn-designing #customizeBtn { display: none !important; }
  /* the bulk-order button and its note step aside while designing */
  html.dyn-designing .bulk-link,
  html.dyn-designing .bulk-note { display: none !important; }
  html.dyn-designing .gallery-main .dyn-cards,
  html.dyn-designing .gallery-main .gal-nav,
  html.dyn-designing .gallery-main .gallery-stage { visibility: hidden; }
  #dynInlineStage { position: absolute; inset: 0; z-index: 60; display: grid; place-items: center; }
  #dynInlineStage .engrave-stage { width: 100%; height: 100%; display: grid; place-items: center; padding: 0; }
  /* the stage sits straight on the paper - no white backdrop */
  #dynInlineStage .engrave-stage, #dynInlineStage .engrave-frame {
    background: none; box-shadow: none; border: 0; border-radius: 0;
  }
  /* upload prompt on a paper tag - readable on any product colour */
  #dynInlineStage .print-hint { background: rgba(23, 19, 15, 0.08); }
  #dynInlineStage .print-hint::before {
    content: ""; position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: min(82%, 300px); height: 112px;
    background: rgba(250, 249, 245, 0.96);
    border: 1px solid rgba(23, 19, 15, 0.2); border-radius: 2px;
    box-shadow: 0 12px 26px -12px rgba(23, 19, 15, 0.5);
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }
  #dynInlineStage .print-hint:hover::before {
    transform: translate(-50%, -50%) translateY(-2px);
    box-shadow: 0 16px 30px -12px rgba(23, 19, 15, 0.6);
  }
  #dynInlineStage .print-hint svg,
  #dynInlineStage .print-hint span { position: relative; z-index: 1; }
  #dynInlineStage .print-hint svg { stroke: #17130f; width: 26px; height: 26px; }
  #dynInlineStage .print-hint span {
    color: #17130f; font-size: 11.5px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; max-width: 240px;
  }
  #dynInlineStage .print-hint:hover { background: rgba(23, 19, 15, 0.12); }
  /* same footprint as the product photo: the frame fills the gallery box
     instead of the designer's 429px default, so the image size never jumps */
  #dynInlineStage .engrave-stage { margin: 0; }
  #dynInlineStage .engrave-frame { width: 100%; max-width: none; }
  #dynInlineStage .engrave-frame > img { max-height: 100%; object-fit: contain; }
  /* The design tools live in an obvious archive card: white stock, hairline
     border, red spine, small tracked label - the page's own language. */
  #dynInlineTools {
    display: flex; flex-direction: column; gap: 14px; margin: 14px 0 0;
    background: #ffffff; border: 1px solid rgba(23, 19, 15, 0.16);
    border-left: 3px solid #b3242a; border-radius: 2px; padding: 16px;
    box-shadow: 0 14px 30px -22px rgba(23, 19, 15, 0.45);
  }
  #dynInlineTools::before {
    content: "Design Studio"; display: block;
    font-size: 9.5px; font-weight: 800; letter-spacing: 0.26em; text-transform: uppercase;
    color: rgba(23, 19, 15, 0.55);
    padding-bottom: 10px; border-bottom: 1px solid rgba(23, 19, 15, 0.12);
  }
  #dynInlineTools[hidden], #dynInlineStage[hidden] { display: none !important; }
  #dynInlineTools .side-tabs { margin: 0; justify-content: flex-start; }
  #dynInlineTools .side-tab {
    border-radius: 2px; border: 1px solid rgba(23, 19, 15, 0.4); background: transparent;
    color: #17130f; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
  }
  #dynInlineTools .side-tab:hover { border-color: #17130f; }
  #dynInlineTools .side-tab.on { background: #17130f; color: #f6f5f1; border-color: #17130f; }
  #dynInlineTools .up-controls { margin: 0; }
  /* collapse hollow blocks (e.g. only a hidden file input) - no empty gaps */
  #dynInlineTools .up-controls:not(:has(:not([hidden]))) { display: none; }
  #dynInlineTools .side-tabs:empty { display: none; }
  #dynInlineTools > * { margin: 0; }
  /* text pill, font picker, emoji + plus buttons: square + hairline */
  #dynInlineTools .engrave-input {
    border-radius: 2px !important; border: 1px solid rgba(23, 19, 15, 0.25) !important;
    background: #fbfaf7 !important; box-shadow: none !important;
  }
  #dynInlineTools .engrave-input:focus {
    border-color: #17130f !important; box-shadow: 0 0 0 3px rgba(23, 19, 15, 0.07) !important;
  }
  #dynInlineTools .up-controls button,
  #dynInlineTools .up-controls select,
  #dynInlineTools .up-controls .ios-field { border-radius: 2px !important; }
  /* footer inside the card: price row on top, buttons full-width below */
  #dynInlineTools .modal-foot {
    background: none; border: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px;
  }
  /* no price inside the card - the page already shows it above */
  #dynInlineTools .price-breakdown { display: none !important; }
  #dynInlineTools .foot-actions { display: flex; gap: 10px; width: 100%; }
  #dynInlineTools .foot-actions .btn { flex: 1; }
  #dynInlineTools .btn-ghost {
    border-radius: 2px; border: 1px solid rgba(23, 19, 15, 0.35); background: transparent;
    color: #17130f; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
  }
  #dynInlineTools .btn-ghost:hover { border-color: #17130f; background: rgba(23, 19, 15, 0.04); }
  /* Add design: matte ink, red on hover - the flip-skin faces retire */
  #dynInlineTools #uploadApply.btn-primary,
  #dynInlineTools #uploadApply.btn-primary.is-flipped {
    background: #17130f !important; border-radius: 2px; box-shadow: none; text-shadow: none;
    /* the retired flip skin sets color: transparent mid-flip - keep the label */
    color: #f6f5f1 !important;
    font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  #dynInlineTools #uploadApply.btn-primary::before,
  #dynInlineTools #uploadApply.btn-primary::after { display: none; }
  #dynInlineTools #uploadApply.btn-primary:hover:not(:disabled) {
    background: #b3242a !important; transform: translateY(-1px);
    box-shadow: 0 12px 24px -14px rgba(23, 19, 15, 0.5);
  }
  #dynInlineTools #uploadApply.btn-primary:disabled { opacity: 0.35; }
</style>
<script>
(function () {
  function ready(fn) { if (document.readyState !== "loading") fn(); else document.addEventListener("DOMContentLoaded", fn); }
  ready(function () {
    var root = document.getElementById("modalRoot");
    if (!root || !window.MutationObserver) return;
    var stageHolder = null, toolsHolder = null;

    function cleanup() {
      if (stageHolder && stageHolder.parentNode) stageHolder.parentNode.removeChild(stageHolder);
      if (toolsHolder && toolsHolder.parentNode) toolsHolder.parentNode.removeChild(toolsHolder);
      stageHolder = toolsHolder = null;
    }
    /* Adopt the designer's live nodes into the page (listeners ride along):
       the stage onto the product image, tabs/controls/footer under the
       Start Designing button. Returns false for modal types this doesn't
       cover (they keep the normal popup). */
    function engage() {
      if (!root.querySelector(".modal-sheet.engrave-sheet")) return false;
      var stage = root.querySelector(".engrave-stage");
      if (stage) { /* fresh build - (re)adopt it */
        cleanup();
        var gal = document.querySelector(".gallery-main");
        var bar = document.getElementById("dynActionBar");
        if (!gal || !bar || !bar.parentNode) return false;
        stageHolder = document.createElement("div");
        stageHolder.id = "dynInlineStage";
        stageHolder.appendChild(stage);
        gal.appendChild(stageHolder);
        toolsHolder = document.createElement("div");
        toolsHolder.id = "dynInlineTools";
        var tabs = root.querySelector(".side-tabs");
        if (tabs) toolsHolder.appendChild(tabs);
        var ctr = root.querySelector(".up-controls");
        if (ctr) toolsHolder.appendChild(ctr);
        var foot = root.querySelector(".modal-foot");
        if (foot) toolsHolder.appendChild(foot);
        bar.parentNode.insertBefore(toolsHolder, bar.nextSibling);
        /* same image as the page: the front view shows the photo the
           customer was just looking at, not the designer's own mock */
        var applyPageImage = function () {
          var pageImg = document.querySelector(".gallery-main .dyn-cards img") ||
                        document.querySelector("#galleryStage img");
          var frameImg = stageHolder && stageHolder.querySelector(".engrave-frame > img");
          var src = pageImg && (pageImg.currentSrc || pageImg.src);
          if (frameImg && src) frameImg.src = src;
        };
        applyPageImage();
        toolsHolder.addEventListener("click", function (e) {
          var t = e.target.closest(".side-tab");
          /* switching back to Front restores the designer mock - re-apply */
          if (t && t.getAttribute("data-side") === "front") setTimeout(applyPageImage, 0);
        });
      }
      if (!stageHolder || !toolsHolder) return false;
      stageHolder.hidden = false;
      toolsHolder.hidden = false;
      /* re-opening an existing design: the primary reads Update, not Add */
      var applyBtn = toolsHolder.querySelector("#uploadApply");
      var pageAdd = document.getElementById("pageAddCart");
      if (applyBtn && pageAdd && !pageAdd.hidden) applyBtn.textContent = "Update design";
      return true;
    }
    function sync() {
      var open = root.classList.contains("open");
      var inline = open && engage();
      document.documentElement.classList.toggle("dyn-designing", inline);
      if (inline) document.body.style.overflow = ""; /* page stays scrollable */
      if (!open) {
        if (stageHolder) stageHolder.hidden = true;
        if (toolsHolder) toolsHolder.hidden = true;
      }
    }
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["class"], childList: true });
  });
})();
</script>
{%- endunless -%}

{%- if section.settings.show_top_logo -%}
{%- assign top_logo = section.settings.top_logo | default: settings.logo -%}
<script>
(function () {
  var bar = document.getElementById("dynTopbar");
  var a = document.getElementById("dynTopLogo");
  if (!bar || !a) return;
  a.setAttribute("href", {{ routes.root_url | default: '/' | json }});
  bar.className = "dyn-topbar is-{{ section.settings.top_logo_align | default: 'center' }}";
  {%- if top_logo != blank -%}
  var img = document.createElement("img");
  img.src = {{ top_logo | image_url: width: 500 | json }};
  img.alt = {{ shop.name | json }};
  img.width = {{ settings.logo_width | default: 140 }};
  img.height = {{ settings.logo_width | default: 140 | divided_by: top_logo.aspect_ratio | round }};
  img.style.width = "{{ settings.logo_width | default: 140 }}px";
  a.appendChild(img);
  {%- else -%}
  a.textContent = {{ shop.name | json }};
  a.className += " dyn-logo-text";
  {%- endif -%}
  bar.hidden = false;
  /* publish the masthead's real height so the product grid below can
     budget exactly one screen for masthead + product together */
  var setH = function () {
    document.documentElement.style.setProperty("--dyn-top-h", (bar.hidden ? 0 : bar.offsetHeight) + "px");
  };
  setH();
  window.addEventListener("resize", setH);
  {%- if top_logo != blank -%}
  img.addEventListener("load", setH);
  {%- endif -%}
})();
</script>
{%- endif -%}

{%- comment -%} Visual print-area positioner. Open any product page with ?setarea=1 to
   drag/resize the print box on your Front / Back design images (Front/Back tabs) and
   read off the four numbers. Hidden from customers (only shows with the URL flag). {%- endcomment -%}
<script>
(function () {
  var cfgEl = document.getElementById("dyn-config");
  if (!cfgEl) return;
  var cfg; try { cfg = JSON.parse(cfgEl.textContent); } catch (e) { return; }
  var _open = false, _styled = false;
  function openTool() {
  if (_open) return; _open = true;
  var s = cfg.settings || {}, shop = cfg.shopify || {};
  var prodImg = shop.productMainImage || (shop.productImages && shop.productImages[0]) || "";
  var sides = [{ key: "front", label: "Front", img: s.frontImage || prodImg, field: "Print area position", p: s.print || {} }];
  if (s.backImage || s.printBack) sides.push({ key: "back", label: "Back", img: s.backImage || s.frontImage || prodImg, field: "Back print area position", p: s.printBack || {} });
  sides.forEach(function (sd) { var p = sd.p; sd.box = { x: +p.x || 22, y: +p.y || 30, w: +p.w || 56, h: +p.h || 40 }; });
  var cur = (/[?&#]setarea=back\b/.test(location.href) && sides.length > 1) ? 1 : 0;

  if (!_styled) { _styled = true;
  var st = document.createElement("style");
  st.textContent = ".pa-tool{position:fixed;inset:0;z-index:100000;background:rgba(20,20,25,.72);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',sans-serif;}"
    + ".pa-stage{position:relative;line-height:0;box-shadow:0 20px 60px rgba(0,0,0,.5);border-radius:10px;background:#fff;}"
    + ".pa-stage img{display:block;max-width:min(560px,90vw);max-height:62vh;width:auto;height:auto;border-radius:10px;-webkit-user-drag:none;user-select:none;}"
    + ".pa-box{position:absolute;border:2px solid #0071e3;background:rgba(0,113,227,.14);cursor:move;box-sizing:border-box;touch-action:none;}"
    + ".pa-box .pa-h{position:absolute;width:26px;height:26px;border-radius:50%;background:#0071e3;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.45);touch-action:none;}"
    + ".pa-h.nw{left:-13px;top:-13px;cursor:nwse-resize;}.pa-h.ne{right:-13px;top:-13px;cursor:nesw-resize;}.pa-h.sw{left:-13px;bottom:-13px;cursor:nesw-resize;}.pa-h.se{right:-13px;bottom:-13px;cursor:nwse-resize;}"
    + ".pa-tag{position:absolute;top:-24px;left:0;background:#0071e3;color:#fff;font-size:11px;font-weight:600;padding:2px 7px;border-radius:5px;white-space:nowrap;}"
    + ".pa-panel{margin-top:16px;background:#fff;border-radius:14px;padding:14px 18px;max-width:90vw;text-align:center;box-shadow:0 8px 30px rgba(0,0,0,.3);}"
    + ".pa-tabs{display:inline-flex;gap:4px;background:#f0f0f2;border-radius:999px;padding:4px;margin-bottom:12px;}"
    + ".pa-tab{border:0;background:transparent;padding:7px 18px;border-radius:999px;font:inherit;font-size:13px;font-weight:600;cursor:pointer;color:#6e6e73;}"
    + ".pa-tab.on{background:#fff;color:#1d1d1f;box-shadow:0 1px 3px rgba(0,0,0,.12);}"
    + ".pa-nums{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:12px;font-variant-numeric:tabular-nums;}"
    + ".pa-nums b{display:block;font-size:22px;color:#1d1d1f;}.pa-nums span{font-size:11px;color:#6e6e73;text-transform:uppercase;letter-spacing:.03em;}"
    + ".pa-row{display:flex;gap:10px;justify-content:center;}"
    + ".pa-btn{height:40px;padding:0 18px;border-radius:999px;border:0;font:inherit;font-size:14px;font-weight:600;cursor:pointer;}"
    + ".pa-copy{background:#1d1d1f;color:#fff;}.pa-close{background:#f0f0f2;color:#1d1d1f;}"
    + ".pa-hint{font-size:12.5px;color:#6e6e73;margin:10px 0 0;line-height:1.5;}";
  document.head.appendChild(st); }

  var tabsHtml = sides.length > 1 ? ('<div class="pa-tabs">' + sides.map(function (sd, i) { return '<button class="pa-tab" data-side="' + i + '">' + sd.label + '</button>'; }).join("") + '</div>') : "";
  var root = document.createElement("div"); root.className = "pa-tool";
  root.innerHTML = '<div class="pa-stage" id="paStage">'
    + '<img id="paImg" alt="">'
    + '<div class="pa-box" id="paBox"><div class="pa-tag" id="paTag"></div><i class="pa-h nw" data-c="nw"></i><i class="pa-h ne" data-c="ne"></i><i class="pa-h sw" data-c="sw"></i><i class="pa-h se" data-c="se"></i></div></div>'
    + '<div class="pa-panel">' + tabsHtml + '<div class="pa-nums">'
    + '<div><b id="paL">0</b><span>Left</span></div><div><b id="paT">0</b><span>Top</span></div>'
    + '<div><b id="paW">0</b><span>Width</span></div><div><b id="paHt">0</b><span>Height</span></div></div>'
    + '<div class="pa-row"><button class="pa-btn pa-copy" id="paCopy">Copy the 4 numbers</button>'
    + '<button class="pa-btn pa-close" id="paCloseBtn">Done</button></div>'
    + '<p class="pa-hint" id="paHint"></p></div>';
  document.body.appendChild(root);

  var stage = root.querySelector("#paStage"), boxEl = root.querySelector("#paBox"), imgEl = root.querySelector("#paImg");
  var L = root.querySelector("#paL"), T = root.querySelector("#paT"), W = root.querySelector("#paW"), H = root.querySelector("#paHt"), tag = root.querySelector("#paTag"), hint = root.querySelector("#paHint");
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function box() { return sides[cur].box; }
  function render() {
    var b = box();
    b.x = clamp(b.x, 0, 100 - b.w); b.y = clamp(b.y, 0, 100 - b.h);
    boxEl.style.left = b.x + "%"; boxEl.style.top = b.y + "%"; boxEl.style.width = b.w + "%"; boxEl.style.height = b.h + "%";
    var r = [Math.round(b.x), Math.round(b.y), Math.round(b.w), Math.round(b.h)];
    L.textContent = r[0]; T.textContent = r[1]; W.textContent = r[2]; H.textContent = r[3];
    tag.textContent = r[0] + " · " + r[1] + " · " + r[2] + " · " + r[3];
  }
  function selectSide(i) {
    cur = i;
    imgEl.src = sides[cur].img || "";
    // Circle-shaped areas draw as an oval in the tool too.
    boxEl.style.borderRadius = (sides[cur].p && sides[cur].p.shape === "circle") ? "50%" : "0";
    Array.prototype.forEach.call(root.querySelectorAll(".pa-tab"), function (t, ti) { t.classList.toggle("on", ti === cur); });
    hint.textContent = "Drag to move, drag the blue dot to resize. Tap Copy, then paste into the “" + sides[cur].field + "” field" + (sides.length > 1 ? " of the " + sides[cur].label + " block." : ".");
    render();
  }
  selectSide(cur);
  Array.prototype.forEach.call(root.querySelectorAll(".pa-tab"), function (t) { t.addEventListener("click", function () { selectSide(+t.getAttribute("data-side")); }); });

  var drag = null; // { c: 'move'|'nw'|'ne'|'sw'|'se', o:{x,y,w,h}, sx, sy }
  function rect() { return stage.getBoundingClientRect(); }
  function start(c) {
    return function (e) {
      e.preventDefault(); e.stopPropagation();
      var b = box(); drag = { c: c, o: { x: b.x, y: b.y, w: b.w, h: b.h }, sx: e.clientX, sy: e.clientY };
      try { e.target.setPointerCapture && e.target.setPointerCapture(e.pointerId); } catch (err) {}
    };
  }
  boxEl.addEventListener("pointerdown", start("move"));
  Array.prototype.forEach.call(boxEl.querySelectorAll(".pa-h"), function (h) { h.addEventListener("pointerdown", start(h.getAttribute("data-c"))); });
  document.addEventListener("pointermove", function (e) {
    if (!drag) return;
    var rc = rect(); var b = box(); var o = drag.o;
    var dx = (e.clientX - drag.sx) / rc.width * 100, dy = (e.clientY - drag.sy) / rc.height * 100;
    if (drag.c === "move") { b.x = o.x + dx; b.y = o.y + dy; }
    else {
      var right = o.x + o.w, bottom = o.y + o.h;
      if (drag.c.indexOf("w") >= 0) { b.x = clamp(o.x + dx, 0, right - 2); b.w = right - b.x; }
      if (drag.c.indexOf("e") >= 0) { b.w = clamp(o.w + dx, 2, 100 - o.x); }
      if (drag.c.indexOf("n") >= 0) { b.y = clamp(o.y + dy, 0, bottom - 2); b.h = bottom - b.y; }
      if (drag.c.indexOf("s") >= 0) { b.h = clamp(o.h + dy, 2, 100 - o.y); }
    }
    render();
  });
  document.addEventListener("pointerup", function () { drag = null; });
  document.addEventListener("pointercancel", function () { drag = null; });

  root.querySelector("#paCopy").addEventListener("click", function () {
    var b = box();
    var txt = Math.round(b.x) + ", " + Math.round(b.y) + ", " + Math.round(b.w) + ", " + Math.round(b.h);
    if (navigator.clipboard) navigator.clipboard.writeText(txt).catch(function () {});
    this.textContent = "Copied " + txt; var self = this; setTimeout(function () { self.textContent = "Copy the 4 numbers"; }, 1800);
  });
  root.querySelector("#paCloseBtn").addEventListener("click", function () { root.remove(); _open = false; });
  }

  var auto = /[?&#]setarea\b/.test(location.href);
  var design = !!(window.Shopify && window.Shopify.designMode);
  if (!auto && !design) return;
  if (auto) openTool();
  if (design) {
    var launch = document.createElement("button");
    launch.type = "button"; launch.textContent = "◳ Set print area";
    launch.style.cssText = "position:fixed;right:16px;bottom:16px;z-index:99999;height:46px;padding:0 20px;border:0;border-radius:999px;background:#0071e3;color:#fff;font:600 14px/1 -apple-system,BlinkMacSystemFont,sans-serif;box-shadow:0 6px 20px rgba(0,0,0,.3);cursor:pointer;";
    launch.addEventListener("click", openTool);
    document.body.appendChild(launch);
  }
})();
</script>

{%- comment -%} FEATURE BLOCKS: ordered anchors + reparent the live feature nodes into them.
   Every feature is found by a stable id/selector, so moving the node keeps the app's
   wiring intact — the app fills each node in place, wherever the block order puts it. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div id="dynBlocks" hidden>
  {%- for block in section.blocks -%}
    <div class="dyn-slot" data-dyn-block="{{ block.type }}" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}></div>
  {%- endfor -%}
</div>
<script>
(function () {
  var host = document.getElementById("dynBlocks");
  if (!host) return;
  var detail = document.getElementById("buyBox") || document.querySelector(".detail");
  var cta = document.querySelector(".cta-stack");
  var actionBar = document.querySelector(".dyn-actionbar-inner");
  var bulkNoteEl = null;

  function buildBulk(slot) {
    {%- if blk_bulk != blank and blk_bulk.settings.bulk_link != blank -%}
    var a = document.createElement("a");
    a.className = "bulk-link";
    var base = {{ blk_bulk.settings.bulk_link | json }};
    var handle = {{ product.handle | json }};
    a.href = base + (handle ? ((base.indexOf("?") >= 0 ? "&" : "?") + "product=" + encodeURIComponent(handle)) : "");
    /* If the customer already designed something, their uploaded artwork
       rides along to the bulk request (URLs published by the designer). */
    /* Bulk request: host local artwork via a temp cart line, then go. */
    a.addEventListener("click", function (ev) {
      var href = base + (handle ? ((base.indexOf("?") >= 0 ? "&" : "?") + "product=" + encodeURIComponent(handle)) : "");
      var all = window.DYN_DESIGN_FILES || [];
      var http = all.filter(function (d) { return /^https?:/i.test(d.url || ""); });
      var locals = all.filter(function (d) { return /^data:/i.test(d.url || ""); });
      /* placement previews ride too */
      try {
        var pv = window.DYN_DESIGN_PREVIEWS || {};
        ["front", "back"].forEach(function (s) {
          if (pv[s]) locals.push({ side: s + " preview", url: pv[s] });
        });
      } catch (e) {}
      var S = window.DYN_SHOPIFY || {};
      var stash = function (list) {
        try {
          if (list.length) sessionStorage.setItem("dyn_bulk_designs", JSON.stringify(list.slice(0, 8)));
          else sessionStorage.removeItem("dyn_bulk_designs");
        } catch (e) {}
      };
      var withParam = function (list) {
        if (!list.length) return href;
        return href + (href.indexOf("?") >= 0 ? "&" : "?") + "designs=" +
          encodeURIComponent(list.map(function (d) { return d.side + ": " + d.url; }).join("\n"));
      };
      if (!locals.length || !S.variantId || !window.FormData) {
        stash(http); a.href = withParam(http); return; /* normal navigation */
      }
      ev.preventDefault();
      a.style.pointerEvents = "none"; a.style.opacity = "0.6";
      a.textContent = "Attaching your designs…";
      var toBlob = function (dataurl) {
        try {
          var arr = String(dataurl).split(","), m = (arr[0].match(/:(.*?);/) || [])[1] || "image/png";
          var b = atob(arr[1]), n = b.length, u = new Uint8Array(n);
          while (n--) u[n] = b.charCodeAt(n);
          return new Blob([u], { type: m });
        } catch (e) { return null; }
      };
      var hosted = http.slice(), names = [];
      var fd = new FormData();
      fd.append("id", String(S.variantId)); fd.append("quantity", "1");
      locals.slice(0, 10).forEach(function (d, i) {
        var bl = toBlob(d.url); if (!bl) return;
        var safe = String(d.side).replace(/\s+/g, "-");
        var pname = "_bulk_design_" + (i + 1) + "_" + safe;
        names.push({ prop: pname, side: d.side });
        fd.append("properties[" + pname + "]", bl, "design-" + safe + "-" + (i + 1) + ".png");
      });
      fetch("/cart/add.js", { method: "POST", headers: { Accept: "application/json" }, body: fd })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function (j) {
          var it = (j.items && j.items[0]) || j;
          names.forEach(function (n) {
            var u = it && it.properties && it.properties[n.prop];
            if (u && /^https?:/i.test(u)) hosted.push({ side: n.side, url: u });
          });
          if (it && it.key) {
            return fetch("/cart/change.js", {
              method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify({ id: it.key, quantity: 0 })
            }).catch(function () {});
          }
        })
        .catch(function () {})
        .then(function () {
          try { document.dispatchEvent(new CustomEvent("dyn:cart-changed")); } catch (e) {}
          stash(hosted);
          window.location.href = withParam(hosted);
        });
    });
    {% if blk_bulk.settings.bulk_link_icon %}
    a.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>';
    {% endif %}
    /* An old stored label/note ("Order in bulk" / "Volume pricing from 10+")
       is upgraded to the studio wording; anything else the merchant typed wins. */
    var dyxLbl = {{ blk_bulk.settings.bulk_link_label | default: 'Request Bulk Pricing' | json }};
    if (!dyxLbl || /order in bulk/i.test(dyxLbl)) dyxLbl = "Request Bulk Pricing";
    a.appendChild(document.createTextNode(dyxLbl));
    slot.appendChild(a);
    var dyxNote = {{ blk_bulk.settings.bulk_link_note | json }};
    if (!dyxNote || /volume pricing from 10/i.test(dyxNote)) dyxNote = "Ordering 25 or more? We’ll prepare custom pricing and production options.";
    if (dyxNote !== "hide") {
      var note = document.createElement("div");
      note.className = "bulk-note";
      note.textContent = dyxNote;
      bulkNoteEl = note; // placed under the whole quantity row, not inside the inline slot
    }
    {%- endif -%}
  }

  var movers = {
    reviews: function () { return document.getElementById("igSocial"); },
    gift: function () { return document.getElementById("giftMount"); }
  };

  // Fill each slot with its feature node (ids/listeners preserved), and collect them by type.
  var byType = {};
  Array.prototype.forEach.call(host.querySelectorAll(".dyn-slot"), function (slot) {
    var type = slot.getAttribute("data-dyn-block");
    byType[type] = slot;
    if (type === "bulk_link") { buildBulk(slot); return; }
    var getNode = movers[type];
    if (!getNode) return;
    var node = getNode();
    if (node) slot.appendChild(node);
  });

  // Each feature has a fixed home in the buy-box (not one stack).
  host.hidden = false;
  var qtyRow = detail ? detail.querySelector(".qty-row") : null;
  var qtyGroup = qtyRow ? (qtyRow.closest ? qtyRow.closest(".opt-group") : qtyRow.parentNode) : null;

  function after(ref, node) { if (ref && ref.parentNode) ref.parentNode.insertBefore(node, ref.nextSibling); }

  // Bulk & gift → into the bottom action bar, alongside Customize / Add to Cart.
  if (byType.bulk_link) {
    if (actionBar) { actionBar.appendChild(byType.bulk_link); }
    else if (qtyRow) { qtyRow.appendChild(byType.bulk_link); }
    if (bulkNoteEl && byType.bulk_link.parentNode) { after(byType.bulk_link, bulkNoteEl); }
  }
  if (byType.gift) {
    if (actionBar) { actionBar.appendChild(byType.gift); }
    else if (qtyGroup) { after(qtyGroup, byType.gift); }
  }
  // Reviews → below the fixed trust row (which now renders in place after the buttons).
  if (byType.reviews) { after((detail && detail.querySelector(".reassure")) || cta, byType.reviews); }

  // Anything without a specific home falls back after the buttons.
  Array.prototype.forEach.call(host.querySelectorAll(".dyn-slot"), function (slot) {
    if (!slot.parentNode || slot.parentNode === host) { if (cta) after(cta, slot); else if (detail) detail.appendChild(slot); }
  });
  if (host.parentNode && !host.children.length) host.parentNode.removeChild(host);
})();
</script>
{%- endif -%}


