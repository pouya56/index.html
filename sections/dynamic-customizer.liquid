.ig-rv-chosen .ig-rvstars { color: #f5b301; font-size: 15px; letter-spacing: 1px; margin: 0; white-space: nowrap; }
.ig-rv-chosen::after { content: ""; width: 1px; height: 20px; background: var(--line); }
