.ig-rv-text { flex: 1 1 auto; min-width: 0; border: 0; background: none; padding: 8px 2px; margin: 0; font: inherit; font-size: 14px; color: var(--ink); resize: none; min-height: 22px; max-height: 120px; line-height: 1.45; box-sizing: border-box; }
.ig-rv-text:focus { outline: none; }
.ig-rv-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
.ig-rv-send { flex: none; align-self: flex-end; width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--ink); color: #fff; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0; transition: opacity .15s ease, transform .1s ease; }
.ig-rv-send:hover { opacity: .9; }
.ig-rv-send:active { transform: scale(.92); }
.ig-rv-send:disabled { opacity: .4; cursor: default; }
.ig-rv-send svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; display: block; }
.ig-rv-note { font-size: 12.5px; margin-top: 9px; color: #1a7f37; }

.modal-root { position: fixed; inset: 0; z-index: 9990; display: none; }

.modal-root.open { display: flex; background: rgba(0, 0, 0, 0.55); overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 3vh 0; }
.modal-scrim { position: fixed; inset: 0; background: transparent;
  -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
.modal-sheet {

