.ig-rv-verified + .ig-rvstars { margin-left: 0; }
.ig-rv-hint { font-size: 12.5px; color: var(--ink-faint); margin-bottom: 8px; }
.ig-rv-gate { font-size: 13.5px; color: var(--ink-soft); padding: 6px 0; }
.ig-rv-gate a { color: var(--accent); text-decoration: none; }
