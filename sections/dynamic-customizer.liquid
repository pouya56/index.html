    "eyebrow": {{ dyn_product.vendor | default: '' | json }},
    "title": "",
    "price": "",
    "priceNote": {{ section.settings.price_note | default: '' | json }},
    "description": "",
    "modelLabel": "",
    "customizeLabel": {{ 'Start Designing' | json }},
