<style>
@font-face{font-family:'DynEmoji';src:url(data:font/woff2;base64,) format('woff2');font-display:swap;}

:root {

  --bg: #ffffff;
  --bg-elevated: #fbfbfd;
  --bg-panel: #f5f5f7;
  --ink: #1d1d1f;
  --ink-soft: #6e6e73;
  --ink-faint: #86868b;
  --line: #d2d2d7;
  --line-soft: #e8e8ed;
  --accent: #0071e3;
  --accent-hover: #0077ed;
  --accent-press: #006edb;
  --accent-soft: #e8f2fd;
  --gold: #b8860b;
  --success: #1a7f37;
  --danger: #d70015;
  --scrim: rgba(0, 0, 0, 0.48);

  --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter",
    "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

  --r-sm: 8px;
  --r-md: 12px;
  --r-lg: 18px;
  --r-xl: 28px;
  --r-pill: 980px;

  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --dur-fast: 180ms;
  --dur: 320ms;
  --dur-slow: 520ms;

  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 30px 80px rgba(0, 0, 0, 0.18);
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #ffffff;
    --bg-elevated: #fbfbfd;
    --bg-panel: #f5f5f7;
    --ink: #1d1d1f;
    --ink-soft: #6e6e73;
    --ink-faint: #86868b;
    --line: #d2d2d7;
    --line-soft: #e8e8ed;
    --accent-soft: #e8f2fd;
    --scrim: rgba(0, 0, 0, 0.48);
    --shadow-lg: 0 30px 80px rgba(0, 0, 0, 0.18);
  }
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

body {
  font-family: var(--font);
  color: var(--ink);
  background: var(--bg);
  line-height: 1.47;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size: 17px;
  letter-spacing: -0.01em;
}

img { max-width: 100%; display: block; }
button { font-family: inherit; cursor: pointer; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 6px; }

.eyebrow {
  font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
  text-transform: none; color: var(--accent);
}
.display {
  font-size: clamp(40px, 6vw, 72px); font-weight: 700;
  line-height: 1.03; letter-spacing: -0.02em;
}
.headline { font-size: clamp(28px, 4vw, 44px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.08; }
.title { font-size: 24px; font-weight: 600; letter-spacing: -0.015em; }
.lead { font-size: 21px; color: var(--ink-soft); font-weight: 400; line-height: 1.4; }
.meta { font-size: 13px; color: var(--ink-faint); }

.btn {
  appearance: none; border: none; border-radius: var(--r-pill);
  font-size: 17px; font-weight: 500; padding: 13px 26px;
  transition: transform var(--dur-fast) var(--ease-out),
    background var(--dur-fast) var(--ease-out), opacity var(--dur-fast);
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  white-space: nowrap;
}
/* [hidden] must always win — the inline-flex above otherwise overrides the
   browser default and hidden buttons (Customize / Add to Cart) stay visible. */
.btn[hidden] { display: none !important; }
.btn:active { transform: scale(0.97); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-hover); }
/* Customize + Add to Cart — glossy inflated balloon plastic (reference "M"):
   vivid orange, wet-look specular highlights, deep inflation shading, and a
   warm colour-cast shadow. */
#customizeBtn.btn-primary, #pageAddCart.btn-primary {
  position: relative; overflow: hidden; border-radius: 26px; border: none;
  color: #fff; font-weight: 600; text-shadow: 0 1px 2px rgba(160, 55, 0, 0.5);
  background: radial-gradient(120% 160% at 30% 15%, #ffc14d, #fb7f16 45%, #f2570a 75%, #d94505);
  box-shadow:
    0 3px 5px rgba(0, 0, 0, 0.08),
    0 18px 32px -9px rgba(230, 90, 10, 0.55),
    inset 0 3px 6px rgba(255, 225, 170, 0.8),
    inset 0 -8px 16px rgba(175, 45, 0, 0.55),
    inset 0 0 20px rgba(255, 140, 50, 0.35);
  transition: filter var(--dur-fast) var(--ease-out), box-shadow .2s ease, transform var(--dur-fast) var(--ease-out);
}
/* Wet-look speculars: a big soft gleam upper-left, a smaller one upper-right,
   and a faint bounce light along the bottom curve. */
#customizeBtn.btn-primary::before, #pageAddCart.btn-primary::before {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(42% 30% at 26% 18%, rgba(255,255,255,0.95), rgba(255,255,255,0) 72%),
    radial-gradient(24% 18% at 74% 14%, rgba(255,255,255,0.7), rgba(255,255,255,0) 70%),
    radial-gradient(55% 26% at 50% 100%, rgba(255,255,255,0.22), rgba(255,255,255,0) 70%);
}
