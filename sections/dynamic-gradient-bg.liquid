{% comment %}
  ============================================================================
  Dynamic Gradient Background — a self-contained animated WebGL gradient
  (a native lookalike of a ShaderGradient "waterPlane"). No React / no external
  libraries. Add it to the HOME page (or any page).
  - "Fixed" mode paints it behind the whole page.
  - "Banner" mode renders it as a tall block you can drop at the top.
  Falls back to a CSS gradient if WebGL isn't available, and pauses for
  visitors who prefer reduced motion.
  ============================================================================
{% endcomment %}

{%- assign gb = section.settings -%}
{%- assign gb_id = 'gbg-' | append: section.id -%}

<style>
  #{{ gb_id }} { --gb-op: {{ gb.opacity | default: 100 | divided_by: 100.0 }}; }
  #{{ gb_id }}.gb-fixed { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: {{ gb.z_index | default: 0 }}; pointer-events: none; }
  #{{ gb_id }}.gb-banner { position: relative; width: 100%; height: {{ gb.height | default: 520 }}px; }
  #{{ gb_id }} canvas, #{{ gb_id }} .gb-fallback { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: var(--gb-op); }
  #{{ gb_id }} .gb-fallback { background: linear-gradient(135deg, {{ gb.color1 | default: '#e8ffec' }}, {{ gb.color2 | default: '#d1f5ff' }} 55%, {{ gb.color3 | default: '#ffffff' }}); }
  @media (max-width: 700px) { #{{ gb_id }}.gb-banner { height: {{ gb.height_mobile | default: 360 }}px; } }
</style>

{%- if gb.enabled -%}
<div id="{{ gb_id }}" class="{% if gb.display == 'banner' %}gb-banner{% else %}gb-fixed{% endif %}"
     data-c1="{{ gb.color1 | default: '#e8ffec' }}" data-c2="{{ gb.color2 | default: '#d1f5ff' }}"
     data-c3="{{ gb.color3 | default: '#ffffff' }}" data-bg="{{ gb.bg_color | default: '#000000' }}"
     data-speed="{{ gb.speed | default: 20 | divided_by: 100.0 }}" data-density="{{ gb.density | default: 120 | divided_by: 100.0 }}"
     data-strength="{{ gb.strength | default: 180 | divided_by: 100.0 }}" data-grain="{{ gb.grain | default: 0 | divided_by: 100.0 }}"
     aria-hidden="true">
  <div class="gb-fallback"></div>
</div>

<script>
(function () {
  var root = document.getElementById({{ gb_id | json }});
  if (!root) return;
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var canvas = document.createElement("canvas");
  var gl = null;
  try { gl = canvas.getContext("webgl") || canvas.getContext("experimental-webgl"); } catch (e) {}
  if (!gl) return; // keep the CSS fallback
  root.insertBefore(canvas, root.firstChild);
  var fb = root.querySelector(".gb-fallback"); if (fb) fb.style.display = "none";

  function hex(h) { h = String(h || "").replace("#", ""); if (h.length === 3) h = h.replace(/(.)/g, "$1$1"); var n = parseInt(h || "000000", 16); return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255]; }
  var C1 = hex(root.dataset.c1), C2 = hex(root.dataset.c2), C3 = hex(root.dataset.c3), BG = hex(root.dataset.bg);
  var SPEED = parseFloat(root.dataset.speed) || 0.2, DENS = parseFloat(root.dataset.density) || 1.2,
      STR = parseFloat(root.dataset.strength) || 1.8, GRAIN = parseFloat(root.dataset.grain) || 0;

  var vs = "attribute vec2 p; void main(){ gl_Position = vec4(p,0.0,1.0); }";
  var fs = [
    "precision highp float;",
    "uniform vec2 u_res; uniform float u_t; uniform vec3 c1,c2,c3,bg; uniform float dens,str,grain;",
    "vec2 hash(vec2 p){ p=vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))); return -1.0+2.0*fract(sin(p)*43758.5453); }",
    "float noise(vec2 p){ vec2 i=floor(p),f=fract(p); vec2 u=f*f*(3.0-2.0*f);",
    "  return mix(mix(dot(hash(i),f),dot(hash(i+vec2(1,0)),f-vec2(1,0)),u.x),",
    "             mix(dot(hash(i+vec2(0,1)),f-vec2(0,1)),dot(hash(i+vec2(1,1)),f-vec2(1,1)),u.x),u.y); }",
    "float fbm(vec2 p){ float v=0.0,a=0.55; for(int i=0;i<4;i++){ v+=a*noise(p); p*=2.0; a*=0.55; } return v; }",
    "float rand(vec2 c){ return fract(sin(dot(c,vec2(12.9898,78.233)))*43758.5453); }",
    "void main(){",
    "  vec2 uv = gl_FragCoord.xy/u_res.xy;",
    "  float ar = u_res.x/u_res.y; vec2 p = vec2(uv.x*ar, uv.y)*dens*2.6;",
    "  float t = u_t;",
    "  float w = fbm(p + vec2(t*0.35, t*0.18)) + 0.5*fbm(p*1.9 - vec2(t*0.22, t*0.30));",
    "  w = w*str*0.5 + 0.5;",
    "  float g = clamp(uv.y + 0.18*sin(uv.x*3.0 + t*0.6) + (w-0.5)*0.6, 0.0, 1.0);",
    "  vec3 col = mix(c1, c2, g);",
    "  col = mix(col, c3, smoothstep(0.55, 1.0, w)*0.7);",
    "  col = mix(bg, col, clamp(0.35 + 0.8*w, 0.0, 1.0));",
    "  if(grain>0.0){ col += (rand(gl_FragCoord.xy + t)-0.5)*grain; }",
    "  gl_FragColor = vec4(col, 1.0);",
    "}"
  ].join("\n");

  function sh(type, src) { var s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); return s; }
  var prog = gl.createProgram();
  gl.attachShader(prog, sh(gl.VERTEX_SHADER, vs)); gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fs));
  gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return; // fallback stays hidden but CSS is gone; re-show it
  gl.useProgram(prog);
  var buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
  var loc = gl.getAttribLocation(prog, "p"); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
  var uRes = gl.getUniformLocation(prog, "u_res"), uT = gl.getUniformLocation(prog, "u_t");
  gl.uniform3fv(gl.getUniformLocation(prog, "c1"), C1); gl.uniform3fv(gl.getUniformLocation(prog, "c2"), C2);
  gl.uniform3fv(gl.getUniformLocation(prog, "c3"), C3); gl.uniform3fv(gl.getUniformLocation(prog, "bg"), BG);
  gl.uniform1f(gl.getUniformLocation(prog, "dens"), DENS); gl.uniform1f(gl.getUniformLocation(prog, "str"), STR);
  gl.uniform1f(gl.getUniformLocation(prog, "grain"), GRAIN);

  function resize() {
    var dpr = Math.min(window.devicePixelRatio || 1, 1.75);
    var w = root.clientWidth || window.innerWidth, h = root.clientHeight || window.innerHeight;
    canvas.width = Math.max(1, Math.floor(w * dpr)); canvas.height = Math.max(1, Math.floor(h * dpr));
    gl.viewport(0, 0, canvas.width, canvas.height); gl.uniform2f(uRes, canvas.width, canvas.height);
  }
  resize();
  window.addEventListener("resize", resize);

  var start = null, raf = 0, running = true;
  function frame(ts) {
    if (!running) return;
    if (start === null) start = ts;
    gl.uniform1f(uT, ((ts - start) / 1000) * SPEED * 6.0);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
    raf = requestAnimationFrame(frame);
  }
  if (reduce) { gl.uniform1f(uT, 2.0); gl.drawArrays(gl.TRIANGLES, 0, 3); }  // one static frame
  else raf = requestAnimationFrame(frame);
  // Pause when the tab/section isn't visible to save power.
  document.addEventListener("visibilitychange", function () {
    if (document.hidden) { running = false; cancelAnimationFrame(raf); }
    else if (!reduce && !running) { running = true; start = null; raf = requestAnimationFrame(frame); }
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Gradient Background",
  "tag": "section",
  "class": "dynamic-gradient-bg-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable animated background", "default": true },
    { "type": "select", "id": "display", "label": "How to show it", "default": "fixed",
      "options": [
        { "value": "fixed", "label": "Fixed behind the whole page" },
        { "value": "banner", "label": "Banner block (set a height)" }
      ], "info": "Fixed sits behind everything (works best when your page/sections are transparent). Banner is a tall block you place at the top." },
    { "type": "range", "id": "height", "label": "Banner height (desktop)", "min": 200, "max": 900, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "height_mobile", "label": "Banner height (mobile)", "min": 160, "max": 700, "step": 20, "unit": "px", "default": 360 },
    { "type": "range", "id": "z_index", "label": "Layer (fixed mode)", "min": -1, "max": 0, "step": 1, "default": 0, "info": "-1 sits behind everything; 0 sits just above the page background." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color1", "label": "Colour 1", "default": "#e8ffec" },
    { "type": "color", "id": "color2", "label": "Colour 2", "default": "#d1f5ff" },
    { "type": "color", "id": "color3", "label": "Colour 3", "default": "#ffffff" },
    { "type": "color", "id": "bg_color", "label": "Base colour", "default": "#000000" },
    { "type": "header", "content": "Motion" },
    { "type": "range", "id": "speed", "label": "Speed", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 20 },
    { "type": "range", "id": "density", "label": "Density", "min": 40, "max": 260, "step": 10, "unit": "%", "default": 120 },
    { "type": "range", "id": "strength", "label": "Wave strength", "min": 40, "max": 300, "step": 10, "unit": "%", "default": 180 },
    { "type": "range", "id": "grain", "label": "Grain", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 0 },
    { "type": "range", "id": "opacity", "label": "Opacity", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [ { "name": "Gradient Background" } ],
  "enabled_on": { "templates": ["index", "page", "collection", "product"] }
}
{% endschema %}
