{%- comment -%}
  Dynamic Recent-Purchase Notification — a single frosted card that pops into a
  corner, one purchase at a time, then slides away (classic "sales pop" / social
  proof), styled to match the macOS Notifications section.

  Source:
    • real  — the signed-in customer's own recent orders (real data).
    • fake  — merchant-authored simulated purchases that rotate (social proof).
{%- endcomment -%}

{%- assign pos = section.settings.position | default: 'bottom-left' -%}
{%- assign source = section.settings.source | default: 'fake' -%}

{%- comment -%} Decide whether we actually have anything to show. {%- endcomment -%}
{%- assign has_cards = false -%}
{%- if source == 'real' -%}
  {%- if customer and customer.orders_count > 0 -%}{%- assign has_cards = true -%}{%- endif -%}
{%- else -%}
  {%- if section.blocks.size > 0 -%}{%- assign has_cards = true -%}{%- endif -%}
{%- endif -%}

{%- if has_cards -%}
<div
  class="dyn-pnotify dyn-pnotify--{{ pos }}"
  id="dynPurch-{{ section.id }}"
  data-pnotify
  data-pos="{{ pos }}"
  data-start="{{ section.settings.start_delay | default: 3000 }}"
  data-duration="{{ section.settings.duration | default: 5 | times: 1000 }}"
  data-gap="{{ section.settings.gap | default: 7 | times: 1000 }}"
  data-loop="{% if section.settings.loop == false %}0{% else %}1{% endif %}"
  data-shuffle="{% if section.settings.shuffle %}1{% else %}0{% endif %}"
  {{ section.shopify_attributes }}
  aria-live="polite" role="region"
  aria-label="{{ 'Recent purchases' | escape }}"
  hidden
>
  <div class="dpn-hold" data-pnotify-hold>
    {%- if source == 'real' -%}
      {%- assign shown = 0 -%}
      {%- for order in customer.orders limit: 12 -%}
        {%- for line in order.line_items limit: 3 -%}
          {%- if shown < 12 -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign purl = line.url | default: order.customer_url -%}
            <div class="dpn-card" data-pnote data-ts="{{ order.created_at | date: '%s' }}"
              {% if purl != blank %}data-href="{{ purl }}"{% endif %}
              style="--tile:#2f2f34;">
              <span class="dpn-ic" aria-hidden="true">
                {%- if line.image != blank -%}
                  <img src="{{ line.image | image_url: width: 160 }}" alt="" loading="lazy" width="80" height="80">
                {%- elsif line.product.featured_image != blank -%}
                  <img src="{{ line.product.featured_image | image_url: width: 160 }}" alt="" loading="lazy" width="80" height="80">
                {%- else -%}
                  <span class="dpn-emoji">🛍️</span>
                {%- endif -%}
              </span>
              <span class="dpn-body">
                <span class="dpn-top">
                  <span class="dpn-title">{{ line.title | escape }}</span>
                  <span class="dpn-time" data-ptime>&nbsp;</span>
                </span>
                <span class="dpn-text">
                  {{ section.settings.real_text | default: 'You purchased this' | escape }}
                  {%- if line.quantity > 1 %} · ×{{ line.quantity }}{% endif -%}
                </span>
              </span>
              <button type="button" class="dpn-x" data-pnotify-x aria-label="Dismiss">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'sale' -%}
          {%- assign who = block.settings.shopper | default: 'Someone' -%}
          {%- assign where = block.settings.location -%}
          {%- comment -%} If a real product is picked, its image / title / link
            / price fill in automatically; otherwise fall back to typed text. {%- endcomment -%}
          {%- assign prod = block.settings.product -%}
          {%- assign p_img = block.settings.product_image -%}
          {%- assign p_name = block.settings.product_title -%}
          {%- assign p_link = block.settings.link -%}
          {%- if prod != blank -%}
            {%- if p_img == blank -%}{%- assign p_img = prod.featured_image -%}{%- endif -%}
            {%- capture p_name -%}{{ prod.title }}{% if block.settings.show_price %} · {{ prod.price | money }}{% endif %}{%- endcapture -%}
            {%- assign p_link = block.settings.link | default: prod.url -%}
          {%- endif -%}
          <div class="dpn-card" data-pnote data-mins="{{ block.settings.minutes_ago | default: 0 }}"
            {% if p_link != blank %}data-href="{{ p_link }}"{% endif %}
            style="--tile:{{ block.settings.icon_bg | default: '#2f2f34' }};" {{ block.shopify_attributes }}>
            <span class="dpn-ic" aria-hidden="true">
              {%- if p_img != blank -%}
                <img src="{{ p_img | image_url: width: 160 }}" alt="" loading="lazy" width="80" height="80">
              {%- elsif block.settings.emoji != blank -%}
                <span class="dpn-emoji">{{ block.settings.emoji }}</span>
              {%- else -%}
                <span class="dpn-emoji">🛍️</span>
              {%- endif -%}
            </span>
            <span class="dpn-body">
              <span class="dpn-top">
                <span class="dpn-title">{{ who | escape }}{% if where != blank %} · {{ where | escape }}{% endif %}</span>
                <span class="dpn-time" data-ptime>{{ block.settings.time_text | escape }}</span>
              </span>
              <span class="dpn-text">
                {{ block.settings.verb | default: 'just bought' | escape }} {{ p_name | escape }}
                {%- if block.settings.verified %} <span class="dpn-check" aria-hidden="true">✓</span>{% endif -%}
              </span>
            </span>
            <button type="button" class="dpn-x" data-pnotify-x aria-label="Dismiss">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
            </button>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<style>
  #dynPurch-{{ section.id }}.dyn-pnotify { position: fixed; z-index: 2147481800;
    width: min(360px, calc(100vw - 24px)); pointer-events: none; -webkit-font-smoothing: antialiased; }
  #dynPurch-{{ section.id }}.dyn-pnotify[hidden] { display: none; }
  .dyn-pnotify--top-right { top: 16px; right: 16px; }
  .dyn-pnotify--top-left { top: 16px; left: 16px; }
  .dyn-pnotify--bottom-right { bottom: 16px; right: 16px; }
  .dyn-pnotify--bottom-left { bottom: 16px; left: 16px; }
  #dynPurch-{{ section.id }} .dpn-hold { position: relative; }

  #dynPurch-{{ section.id }} .dpn-card {
    position: absolute; left: 0; right: 0; box-sizing: border-box;
    display: flex; align-items: center; gap: 12px; padding: 12px 14px;
    border-radius: 20px; text-align: left; pointer-events: auto;
    background: rgba(38, 38, 43, {{ section.settings.glass_opacity | default: 60 | divided_by: 100.0 }});
    -webkit-backdrop-filter: blur(30px) saturate(1.6); backdrop-filter: blur(30px) saturate(1.6);
    border: 1px solid rgba(255,255,255,0.14);
    box-shadow: 0 22px 55px -20px rgba(0,0,0,0.62), inset 0 1px 0 rgba(255,255,255,0.16);
    color: #fff; opacity: 0; visibility: hidden;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease, visibility 0.45s; }
  /* Anchor to the near edge so the card sits inside the chosen corner. */
  .dyn-pnotify--top-right .dpn-card, .dyn-pnotify--top-left .dpn-card { top: 0; }
  .dyn-pnotify--bottom-right .dpn-card, .dyn-pnotify--bottom-left .dpn-card { bottom: 0; }
  .dyn-pnotify--top-right .dpn-card, .dyn-pnotify--bottom-right .dpn-card { transform: translateX(120%); }
  .dyn-pnotify--top-left .dpn-card, .dyn-pnotify--bottom-left .dpn-card { transform: translateX(-120%); }
  #dynPurch-{{ section.id }} .dpn-card[data-href] { cursor: pointer; }
  #dynPurch-{{ section.id }} .dpn-card.is-in { opacity: 1; visibility: visible; transform: translateX(0); }
  #dynPurch-{{ section.id }} .dpn-card[data-href]:active { transform: translateX(0) scale(0.985); }

  #dynPurch-{{ section.id }} .dpn-ic { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    background: var(--tile); box-shadow: 0 3px 8px rgba(0,0,0,0.28); }
  #dynPurch-{{ section.id }} .dpn-ic img { width: 100%; height: 100%; object-fit: cover; }
  #dynPurch-{{ section.id }} .dpn-emoji { font-size: 24px; line-height: 1; }
  #dynPurch-{{ section.id }} .dpn-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  #dynPurch-{{ section.id }} .dpn-top { display: flex; align-items: baseline; gap: 8px; }
  #dynPurch-{{ section.id }} .dpn-title { flex: 1 1 auto; min-width: 0; font-size: 14.5px; font-weight: 700;
    line-height: 1.25; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #dynPurch-{{ section.id }} .dpn-time { flex: 0 0 auto; font-size: 12px; color: rgba(235,235,245,0.6); font-weight: 500; }
  #dynPurch-{{ section.id }} .dpn-text { font-size: 13.5px; line-height: 1.35; color: rgba(235,235,245,0.9);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #dynPurch-{{ section.id }} .dpn-check { color: #34c759; font-weight: 700; }
  #dynPurch-{{ section.id }} .dpn-x { position: absolute; top: -8px; width: 24px; height: 24px;
    border: none; border-radius: 50%; padding: 0; cursor: pointer; display: none; align-items: center; justify-content: center;
    background: rgba(70,70,76,0.92); color: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .dyn-pnotify--top-left .dpn-x, .dyn-pnotify--bottom-left .dpn-x { left: -8px; }
  .dyn-pnotify--top-right .dpn-x, .dyn-pnotify--bottom-right .dpn-x { right: -8px; }
  #dynPurch-{{ section.id }} .dpn-x svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  #dynPurch-{{ section.id }} .dpn-card.is-in:hover .dpn-x { display: flex; }
  @media (prefers-reduced-motion: reduce) {
    #dynPurch-{{ section.id }} .dpn-card { transition: opacity 0.2s ease, visibility 0.2s !important; transform: none !important; }
  }
  @media (max-width: 520px) {
    #dynPurch-{{ section.id }}.dyn-pnotify { left: 12px; right: 12px; width: auto; }
    .dyn-pnotify--top-right, .dyn-pnotify--top-left { top: 12px; }
    .dyn-pnotify--bottom-right, .dyn-pnotify--bottom-left { bottom: 12px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById("dynPurch-{{ section.id }}");
    if (!root) return;
    var cards = [].slice.call(root.querySelectorAll("[data-pnote]"));
    if (!cards.length) return;

    var start = parseInt(root.getAttribute("data-start"), 10) || 0;
    var dur = parseInt(root.getAttribute("data-duration"), 10) || 5000;
    var gap = parseInt(root.getAttribute("data-gap"), 10) || 7000;
    var loop = root.getAttribute("data-loop") !== "0";
    var shuffle = root.getAttribute("data-shuffle") === "1";

    /* Turn an epoch (real orders) or a minutes-ago number (simulated) into a
       friendly "3 days ago" style label. */
    function relFromSeconds(sec) {
      var diff = Math.max(0, Math.floor(Date.now() / 1000) - sec);
      var m = Math.floor(diff / 60), h = Math.floor(diff / 3600), d = Math.floor(diff / 86400);
      if (diff < 45) return "just now";
      if (m < 60) return m + "m ago";
      if (h < 24) return h + "h ago";
      if (d === 1) return "Yesterday";
      if (d < 30) return d + "d ago";
      return new Date(sec * 1000).toLocaleDateString(undefined, { month: "short", day: "numeric" });
    }
    cards.forEach(function (c) {
      var ts = c.getAttribute("data-ts");
      var mins = c.getAttribute("data-mins");
      var el = c.querySelector("[data-ptime]");
      if (!el) return;
      if (ts) { el.textContent = relFromSeconds(parseInt(ts, 10)); }
      else if (mins !== null && mins !== "" && el.textContent.trim() === "") {
        el.textContent = relFromSeconds(Math.floor(Date.now() / 1000) - parseInt(mins, 10) * 60);
      }
    });

    /* Play order. */
    var order = cards.map(function (_, i) { return i; });
    if (shuffle) { for (var i = order.length - 1; i > 0; i--) { var r = Math.floor(Math.random() * (i + 1)), t = order[i]; order[i] = order[r]; order[r] = t; } }

    /* Whole card is a link (except the dismiss button). */
    cards.forEach(function (c) {
      var href = c.getAttribute("data-href");
      if (href) c.addEventListener("click", function (e) {
        if (e.target.closest("[data-pnotify-x]")) return;
        window.location.href = href;
      });
      var x = c.querySelector("[data-pnotify-x]");
      if (x) x.addEventListener("click", function (e) { e.stopPropagation(); hide(c); });
    });

    root.hidden = false;
    var pos = order.length ? 0 : -1, current = null, timers = [];
    function clearTimers() { timers.forEach(clearTimeout); timers = []; }
    function hide(c) {
      c.classList.remove("is-in");
      clearTimers();
      timers.push(setTimeout(next, 500));
    }
    function next() {
      if (current) current.classList.remove("is-in");
      if (pos >= order.length) { if (loop) { pos = 0; } else { root.hidden = true; return; } }
      current = cards[order[pos]]; pos++;
      timers.push(setTimeout(function () {
        current.classList.add("is-in");
        timers.push(setTimeout(function () {
          current.classList.remove("is-in");
          timers.push(setTimeout(next, gap));
        }, dur));
      }, 40));
    }
    timers.push(setTimeout(next, start));
  })();
</script>

{% schema %}
{
  "name": "Recent purchases",
  "tag": "section",
  "class": "dynamic-purchase-notify-section",
  "settings": [
    { "type": "paragraph", "content": "A frosted 'recent purchase' card pops into a corner, one at a time, like the macOS Notifications style." },
    {
      "type": "select", "id": "source", "label": "What to show", "default": "fake",
      "options": [
        { "value": "real", "label": "My real purchases (the signed-in customer's own orders)" },
        { "value": "fake", "label": "Simulated social proof (you write the cards)" }
      ],
      "info": "Real: pulls the logged-in customer's actual recent orders — nothing shows for guests or new customers. Simulated: rotates the cards you add below (these are NOT real orders)."
    },
    { "type": "text", "id": "real_text", "label": "Real mode — line under the product", "default": "You purchased this" },
    { "type": "header", "content": "Placement" },
    {
      "type": "select", "id": "position", "label": "Corner", "default": "bottom-left",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "top-left", "label": "Top left" },
        { "value": "top-right", "label": "Top right" }
      ]
    },
    { "type": "header", "content": "Timing" },
    { "type": "range", "id": "start_delay", "label": "Wait before the first card", "min": 0, "max": 10000, "step": 500, "unit": "ms", "default": 3000 },
    { "type": "range", "id": "duration", "label": "How long each card stays", "min": 2, "max": 15, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "gap", "label": "Gap between cards", "min": 2, "max": 30, "step": 1, "unit": "s", "default": 7 },
    { "type": "checkbox", "id": "loop", "label": "Loop forever", "default": true },
    { "type": "checkbox", "id": "shuffle", "label": "Random order", "default": true },
    { "type": "header", "content": "Glass" },
    { "type": "range", "id": "glass_opacity", "label": "Card tint", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 60 }
  ],
  "blocks": [
    {
      "type": "sale",
      "name": "Simulated purchase",
      "settings": [
        { "type": "paragraph", "content": "Simulated — this is not a real order. Use responsibly." },
        { "type": "header", "content": "Product" },
        { "type": "product", "id": "product", "label": "Real product from your shop", "info": "Pick one and its image, name, price and link fill in automatically." },
        { "type": "checkbox", "id": "show_price", "label": "Show the price", "default": false },
        { "type": "text", "id": "product_title", "label": "…or type a product name", "info": "Used only if no product is picked.", "default": "the A3 Photo Printer" },
        { "type": "header", "content": "Shopper" },
        { "type": "text", "id": "shopper", "label": "Shopper name", "default": "Sarah M." },
        { "type": "text", "id": "location", "label": "Location", "default": "Toronto, CA" },
        { "type": "text", "id": "verb", "label": "Action", "default": "just bought" },
        { "type": "text", "id": "time_text", "label": "Timestamp text", "info": "Leave blank to auto-fill from 'minutes ago'." },
        { "type": "range", "id": "minutes_ago", "label": "…or minutes ago", "min": 0, "max": 1440, "step": 5, "unit": "min", "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Show a green ✓", "default": true },
        { "type": "header", "content": "Icon fallback" },
        { "type": "image_picker", "id": "product_image", "label": "Icon image", "info": "Used if no product is picked." },
        { "type": "text", "id": "emoji", "label": "…or emoji", "default": "🛍️" },
        { "type": "color", "id": "icon_bg", "label": "Icon tile color", "default": "#2f2f34" },
        { "type": "url", "id": "link", "label": "Link when tapped", "info": "Defaults to the product page when a product is picked." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recent purchases",
      "blocks": [
        { "type": "sale", "settings": { "shopper": "Sarah M.", "location": "Toronto, CA", "product_title": "the A3 Photo Printer", "minutes_ago": 4, "emoji": "🖨️" } },
        { "type": "sale", "settings": { "shopper": "James L.", "location": "London, UK", "product_title": "a Custom Mug", "minutes_ago": 18, "emoji": "☕" } },
        { "type": "sale", "settings": { "shopper": "Aisha K.", "location": "Dubai, AE", "product_title": "a Photo Canvas", "minutes_ago": 52, "emoji": "🖼️" } }
      ]
    }
  ]
}
{% endschema %}
