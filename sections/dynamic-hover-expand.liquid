{%- comment -%}
  Hover Expand — a horizontal accordion of image columns (inspired by Skiper UI
  "skiper35"). Columns sit collapsed as thin bars with a vertical label; hover
  (or tap) one and it expands to reveal its full image while the rest collapse.
  Blocks: "Column" (image + label + year + optional link).
{%- endcomment -%}

<section class="dyn-hx" id="dynHx-{{ section.id }}">
  <style>
    #shopify-section-{{ section.id }} { background: {{ section.settings.bg | default: '#0e0e0e' }}; }
    #dynHx-{{ section.id }} {
      --hx-collapsed: {{ section.settings.collapsed | default: 96 }}px;
      --hx-line: rgba(255,255,255,.09);
      --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-family: var(--font); -webkit-font-smoothing: antialiased;
    }
    .dyn-hx .hx-head { max-width: 720px; margin: 0 auto; padding: 40px 22px 8px; text-align: center; color: {{ section.settings.ink | default: '#f5f5f7' }}; }
    .dyn-hx .hx-title { font-size: clamp(24px, 4vw, 40px); font-weight: 700; letter-spacing: -0.03em; margin: 0; }
    .dyn-hx .hx-sub { font-size: 16px; opacity: .55; margin: 12px 0 0; }

    .dyn-hx .hx { display: flex; width: 100%; height: {{ section.settings.height | default: 660 }}px; overflow: hidden; }
    .dyn-hx .hx-card { position: relative; flex: 0 0 var(--hx-collapsed); overflow: hidden; cursor: pointer; text-decoration: none; color: inherit;
      border-right: 1px solid var(--hx-line); transition: flex-grow {{ section.settings.speed | default: 1.0 }}s cubic-bezier(0.16, 1, 0.3, 1); }
    .dyn-hx .hx-card:last-child { border-right: 0; }
    .dyn-hx .hx-card.is-open { flex-grow: 1; }
    /* Image sits inset to the right of the label strip, with a black border + rounded corners */
    .dyn-hx .hx-img { position: absolute; left: var(--hx-collapsed); top: 14px; right: 14px; bottom: 14px; border-radius: 16px; overflow: hidden; opacity: 0; transform: scale(1.04); transition: opacity {{ section.settings.speed | default: 1.0 | times: 1.1 }}s ease, transform {{ section.settings.speed | default: 1.0 | times: 1.3 }}s cubic-bezier(0.16, 1, 0.3, 1); }
    .dyn-hx .hx-card.is-open .hx-img { transform: scale(1); }
    .dyn-hx .hx-card.is-open .hx-img { opacity: 1; }
    .dyn-hx .hx-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    /* Label + year live on the black strip on the left, vertical */
    .dyn-hx .hx-label, .dyn-hx .hx-year { position: absolute; left: 0; width: var(--hx-collapsed); z-index: 3; display: flex; justify-content: center; }
    .dyn-hx .hx-label { bottom: 30px; }
    .dyn-hx .hx-year { top: 30px; }
    .dyn-hx .hx-label > span, .dyn-hx .hx-year > span { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
    .dyn-hx .hx-label > span { color: rgba(255,255,255,.45); font-size: 17px; font-weight: 500; letter-spacing: .01em; transition: color .6s ease; }
    .dyn-hx .hx-card.is-open .hx-label > span { color: #fff; }
    .dyn-hx .hx-year > span { color: rgba(255,255,255,.55); font-size: 13px; letter-spacing: .04em; }
    .dyn-hx .hx-empty { color: #888; text-align: center; padding: 40px; }

    @media (max-width: 760px) {
      .dyn-hx .hx { flex-direction: column; height: auto; }
      .dyn-hx .hx-card { flex: 0 0 var(--hx-collapsed); border-right: 0; border-bottom: 1px solid var(--hx-line); }
      .dyn-hx .hx-card.is-open { flex: 0 0 66vh; }
      .dyn-hx .hx-img { left: 14px; top: var(--hx-collapsed); right: 14px; bottom: 14px; }
      .dyn-hx .hx-label, .dyn-hx .hx-year { width: auto; }
      .dyn-hx .hx-label { left: 20px; bottom: auto; top: 12px; }
      .dyn-hx .hx-year { top: auto; bottom: 12px; left: auto; right: 20px; }
      .dyn-hx .hx-label > span, .dyn-hx .hx-year > span { writing-mode: horizontal-tb; transform: none; }
    }
  </style>

  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="hx-head">
      {%- if section.settings.title != blank -%}<h2 class="hx-title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="hx-sub">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="hx">
      {%- for block in section.blocks -%}
        {%- capture hx_inner -%}
          <span class="hx-img">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1000 }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" alt="{{ block.settings.label | escape }}" loading="lazy">
            {%- else -%}
              <span style="position:absolute;inset:0;background:linear-gradient(135deg,#242424,#3a3a3a)"></span>
            {%- endif -%}
          </span>
          {%- if block.settings.year != blank -%}<span class="hx-year"><span>{{ block.settings.year }}</span></span>{%- endif -%}
          <span class="hx-label"><span>{{ block.settings.label | default: 'Untitled' }}</span></span>
        {%- endcapture -%}
        {%- if block.settings.link != blank -%}
          <a class="hx-card{% if forloop.first %} is-open{% endif %}" href="{{ block.settings.link }}" data-hx-card {{ block.shopify_attributes }}>{{ hx_inner }}</a>
        {%- else -%}
          <div class="hx-card{% if forloop.first %} is-open{% endif %}" data-hx-card {{ block.shopify_attributes }}>{{ hx_inner }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- elsif request.design_mode -%}
    <div class="hx-empty">Add “Column” blocks (each with an image + label).</div>
  {%- endif -%}

  <script>
  (function () {
    var root = document.getElementById("dynHx-{{ section.id }}");
    if (!root) return;
    var cards = Array.prototype.slice.call(root.querySelectorAll("[data-hx-card]"));
    if (!cards.length) return;
    function open(i) { var n = cards.length, k = ((i % n) + n) % n; cards.forEach(function (c, idx) { c.classList.toggle("is-open", idx === k); }); }
    cards.forEach(function (c, i) {
      c.addEventListener("mouseenter", function () { open(i); });
      c.addEventListener("click", function (e) { if (!c.classList.contains("is-open")) { if (c.tagName === "A") e.preventDefault(); open(i); } });
    });
    open(0);
  })();
  </script>
</section>

{% schema %}
{
  "name": "Hover Expand",
  "tag": "section",
  "class": "dynamic-hover-expand-section",
  "settings": [
    { "type": "paragraph", "content": "A horizontal row of image columns. Hover or tap a column to expand it; the rest collapse to thin labelled bars. Add a “Column” block per image." },
    { "type": "text", "id": "title", "label": "Title (optional)" },
    { "type": "text", "id": "subtitle", "label": "Subtitle (optional)" },
    { "type": "header", "content": "Size" },
    { "type": "range", "id": "height", "min": 380, "max": 900, "step": 10, "unit": "px", "label": "Height", "default": 660 },
    { "type": "range", "id": "collapsed", "min": 60, "max": 160, "step": 2, "unit": "px", "label": "Label strip width", "default": 96 },
    { "type": "range", "id": "speed", "min": 0.4, "max": 2.0, "step": 0.1, "unit": "s", "label": "Expand speed (higher = slower & calmer)", "default": 1.0 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0e0e0e" },
    { "type": "color", "id": "ink", "label": "Heading text", "default": "#f5f5f7" }
  ],
  "blocks": [
    { "type": "column", "name": "Column", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (tall/portrait works best)" },
      { "type": "text", "id": "label", "label": "Label", "default": "Studio Name" },
      { "type": "text", "id": "year", "label": "Year / small text (optional)", "default": "2024" },
      { "type": "url", "id": "link", "label": "Link (optional)" }
    ]}
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "Hover Expand",
      "blocks": [
        { "type": "column", "settings": { "label": "Velvet Dreams Studio" } },
        { "type": "column", "settings": { "label": "Neon Pulse Agency" } },
        { "type": "column", "settings": { "label": "Midnight Canvas" } },
        { "type": "column", "settings": { "label": "Echo Digital Lab" } },
        { "type": "column", "settings": { "label": "Cosmic Brew Studios" } },
        { "type": "column", "settings": { "label": "Horizon Typography" } },
        { "type": "column", "settings": { "label": "Stellar Workshop" } }
      ]
    }
  ]
}
{% endschema %}
