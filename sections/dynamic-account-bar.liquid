    window.addEventListener("storage", function (e) { if (e && e.key === "dyn_wishlist") renderSaved(); });
    window.addEventListener("dyn:added-to-cart", loadCart);
    /* macOS-style rearranging: drag a widget over another and they trade
       places, the grid reflowing live. The order is remembered per browser. */
    var ORDER_KEY = "dyn_widget_order";
    (function () {
      var els = head.querySelectorAll("[data-wid]"), i;
      try {
        var ord = JSON.parse(localStorage.getItem(ORDER_KEY) || "null");
        if (ord && ord.length) {
          for (i = 0; i < ord.length; i++) {
            var el = head.querySelector('[data-wid="' + ord[i] + '"]');
