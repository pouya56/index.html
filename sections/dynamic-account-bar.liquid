      background: rgba(255, 255, 255, 0.55); border-radius: 18px; padding: 12px;
      box-shadow: 0 10px 24px -12px rgba(29, 29, 31, 0.3); transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .dyn-abar .dh-vitem:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -12px rgba(29, 29, 31, 0.35); }
    .dyn-abar .dh-vitem img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 12px;
      background: #fff; display: block; }
    .dyn-abar .dh-vitem-ph { width: 100%; aspect-ratio: 1 / 1; border-radius: 12px; background: #ececf0; }
    .dyn-abar .dh-vitem-t { color: #1d1d1f; font-size: 13.5px; font-weight: 600; line-height: 1.3; }
    .dyn-abar .dh-vitem-p { color: #66666b; font-size: 12.5px; }
    .dyn-abar .dh-vempty { display: block; text-align: center; color: #66666b; font-size: 14px;
      padding: 46px 10px; text-decoration: none; }
    /* Per-tile remove button (always visible on touch screens). */
    .dyn-abar .dh-vdel { position: absolute; top: 8px; right: 8px; z-index: 2; width: 28px; height: 28px;
      border-radius: 50%; border: none; padding: 0; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      background: rgba(29, 29, 31, 0.55); color: #fff; opacity: 0; transition: opacity 0.15s, background 0.15s; }
    .dyn-abar .dh-vitem:hover .dh-vdel, .dyn-abar .dh-vdel:focus-visible { opacity: 1; }
    @media (pointer: coarse) { .dyn-abar .dh-vdel { opacity: 1; } }
    .dyn-abar .dh-vdel:hover { background: rgba(200, 40, 40, 0.92); }
    .dyn-abar .dh-vdel svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
    /* Corner arrow: jumps to the full wishlist / cart page. Sticky, so it
       holds the window's top-right corner while the grid scrolls. */
    .dyn-abar .dh-vgo { position: sticky; top: 0; float: right; z-index: 6; margin-bottom: -46px;
      width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      background: rgba(255, 255, 255, 0.78); color: #1d1d1f;
      box-shadow: 0 8px 20px -8px rgba(29, 29, 31, 0.35); transition: background 0.15s, transform 0.15s; }
    .dyn-abar .dh-vgo:hover { background: #fff; transform: translateY(-1px); }
    .dyn-abar .dh-vgo[hidden] { display: none; }
    .dyn-abar .dh-vgo svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2;
      stroke-linecap: round; stroke-linejoin: round; }
    .dyn-abar .dh-apps-pop.is-vision .dh-apps-head { display: flex; flex-wrap: wrap; gap: 16px;
      align-items: center; justify-content: center; margin: 0; }
    .dyn-abar .dh-apps-pop.is-vision .dh-apps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    /* Tab filtering — only the active tab's content shows. */
    .dyn-abar .dh-apps-pop.is-vision[data-vtab="widgets"] .dh-apps-grid,
    .dyn-abar .dh-apps-pop.is-vision[data-vtab="widgets"] #dynAbSaved,
    .dyn-abar .dh-apps-pop.is-vision[data-vtab="widgets"] #dynAbCart { display: none; }
    .dyn-abar .dh-apps-pop.is-vision[data-vtab="saved"] .dh-apps-grid,
    .dyn-abar .dh-apps-pop.is-vision[data-vtab="saved"] .dh-apps-head > :not(#dynAbSaved) { display: none; }
    .dyn-abar .dh-apps-pop.is-vision[data-vtab="cart"] .dh-apps-grid,
    .dyn-abar .dh-apps-pop.is-vision[data-vtab="cart"] .dh-apps-head > :not(#dynAbCart) { display: none; }
    .dyn-abar .dh-apps-pop.is-vision[data-vtab="apps"] .dh-apps-head { display: none; }
    /* App-page preview tabs: the window shows a scaled live embed of the
       app's page with its name and an Open button on top. */
    .dyn-abar .dh-apps-pop.is-vision.is-preview .dh-apps-head,
    .dyn-abar .dh-apps-pop.is-vision.is-preview .dh-apps-grid { display: none; }
    .dyn-abar .dh-vprev[hidden] { display: none; }
    .dyn-abar .dh-vprev-top { display: flex; align-items: center; justify-content: flex-end; padding: 0 0 12px; }
    .dyn-abar .dh-vprev-top[hidden] { display: none; }
    .dyn-abar .dh-vprev-open { width: 46px; height: 46px; border-radius: 50%; display: flex;
      align-items: center; justify-content: center; color: #1d1d1f;
      background: rgba(255, 255, 255, 0.78); box-shadow: 0 8px 20px -8px rgba(29, 29, 31, 0.35);
      transition: background 0.15s, transform 0.15s; }
    .dyn-abar .dh-vprev-open:hover { background: #fff; transform: translateY(-1px); }
    .dyn-abar .dh-vprev-open svg { width: 20px; height: 20px; fill: none; stroke: currentColor;
      stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .dyn-abar .dh-vprev-hold { border-radius: 20px; background: rgba(255, 255, 255, 0.5); padding: 16px 18px; }
    /* Story sections drop their black stage inside the window. */
    .dyn-abar .dh-vprev-hold .dynaeimic-story { background: transparent !important;
      --ds-bg: transparent !important; --ds-alt-bg: transparent !important; }
    .dyn-abar .dh-vprev-hold .ds-pin-stage { background: transparent !important; }
    .dyn-abar .dh-vprev-hold[hidden] { display: none; }
    .dyn-abar .dh-vload { color: #66666b; font-size: 14px; padding: 42px 10px; text-align: center; }
    .dyn-abar .dh-vprev-ext { color: #66666b; font-size: 14px; padding: 34px 10px; text-align: center; }
    /* The account page sheds its own chrome inside the window — only the
       active panel (e.g. reviews) shows. */
    .dyn-abar .dh-vprev-hold .dyn-acct .da-topbar,
    .dyn-abar .dh-vprev-hold .dyn-acct .da-nav { display: none !important; }
    .dyn-abar .dh-vprev-hold .dyn-acct .da-wrap { display: block; padding: 0; }
    /* The bar can hold many tabs — it scrolls quietly if the screen is short. */
    .dyn-abar .dh-vbar { max-height: calc(100vh - 24px); overflow-y: auto;
      scrollbar-width: none; -ms-overflow-style: none; }
    .dyn-abar .dh-vbar::-webkit-scrollbar { display: none; }
    .dyn-abar .dh-vtab { flex: none; }
    .dyn-abar .dh-vtab img { width: 30px; height: 30px; object-fit: cover; border-radius: 9px; }
    /* Sizes inside the pane. */
    .dyn-abar .dh-apps-pop.is-vision .dh-w-greethead { width: 100%; padding: 4px 6px 8px;
      color: #1d1d1f; text-shadow: none; }
    .dyn-abar .dh-apps-pop.is-vision .dh-w-greet, .dyn-abar .dh-apps-pop.is-vision .dh-w-sub { color: #1d1d1f; }
    .dyn-abar .dh-apps-pop.is-vision .dh-w-greet svg { filter: none; }
    .dyn-abar .dh-apps-pop.is-vision .dh-w-boxlabel { color: #1d1d1f; text-shadow: none; }
    .dyn-abar .dh-apps-pop.is-vision .dh-w-clock { width: 210px; height: 210px; }
    .dyn-abar .dh-apps-pop.is-vision .dh-w-quote { width: 210px; height: 210px; aspect-ratio: auto; }
    .dyn-abar .dh-apps-pop.is-vision #dynAbSaved, .dyn-abar .dh-apps-pop.is-vision #dynAbCart { width: 300px; }
    .dyn-abar .dh-apps-pop.is-vision .dh-w-savedbox { height: 320px; }
    @media (max-width: 700px) { .dyn-abar .ab-inner { padding: 8px 16px; } }
  </style>

  <div class="ab-inner">
    <div class="ab-l">
      {%- if show_back_btn -%}
        <button type="button" class="ab-back" id="dynAbarBack" aria-label="Go back to the previous page" title="Back">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>
        </button>
      {%- endif -%}
    </div>
    <div class="ab-r">
    {%- if section.settings.show_apps -%}
      <div class="dh-menu dh-apps-menu">
        <button type="button" class="dh-icon-btn dh-apps-btn" aria-haspopup="true" aria-expanded="false" aria-label="{{ section.settings.apps_title | default: 'Apps' | escape }}">
          <span class="dh-orb-eyes" aria-hidden="true"><span class="dh-orb-eye"></span><span class="dh-orb-eye"></span></span>
        </button>
        <div class="dh-pop dh-apps-pop" hidden>
          <button type="button" class="dh-pop-x" aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
          {%- if section.settings.show_widgets -%}
          <div class="dh-apps-head" id="dynAbWidgets">
            <div class="dh-w-greethead">
              <div class="dh-w-greet"><span id="dynAbGreet">Hello</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/></svg>
              </div>
              <div class="dh-w-day" id="dynAbDay"></div>
              <div class="dh-w-sub" id="dynAbDate"></div>
            </div>
            <div class="dh-w-clock">
              <svg class="dh-w-face" viewBox="0 0 200 200" aria-hidden="true">
                  <rect x="4" y="4" width="192" height="192" rx="48" fill="#ffffff"/>
                  <g id="dynAbTicks"></g>
                  <g fill="#1d1d1f" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="30" font-weight="600" text-anchor="middle">
                    <text x="100" y="62">12</text>
                    <text x="150" y="111">3</text>
                    <text x="100" y="160">6</text>
                    <text x="50" y="111">9</text>
                  </g>
                  <g id="dynAbHr"><line x1="100" y1="104" x2="100" y2="62" stroke="#1d1d1f" stroke-width="9" stroke-linecap="round"/></g>
                  <g id="dynAbMin"><line x1="100" y1="104" x2="100" y2="40" stroke="#1d1d1f" stroke-width="6.5" stroke-linecap="round"/></g>
                  <g id="dynAbSec"><line x1="100" y1="114" x2="100" y2="34" stroke="#ff9f0a" stroke-width="2.5" stroke-linecap="round"/></g>
                  <circle cx="100" cy="100" r="5.5" fill="#ff9f0a"/>
                  <circle cx="100" cy="100" r="2.2" fill="#ffffff"/>
                </svg>
            </div>
            <div class="dh-widget dh-w-mini dh-w-quote">
              <svg class="dh-w-plant" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-8"/><path d="M12 13C12 9.5 9.5 7 5.5 7 5.5 10.5 8 13 12 13Z"/><path d="M12 11c0-3.5 2.5-6 6.5-6 0 3.5-2.5 6-6.5 6Z"/></svg>
              <div class="dh-w-mlines" id="dynAbFocus">&nbsp;</div>
            </div>
            <div class="dh-w-mini dh-w-saved" id="dynAbSaved">
              <div class="dh-w-savedbox">
                <div class="dh-w-savedtrack" id="dynAbSavedTrack"></div>
                <div class="dh-w-saveddots" id="dynAbSavedDots"></div>
              </div>
              <span class="dh-w-boxlabel">Saved</span>
            </div>
            <div class="dh-w-mini dh-w-saved" id="dynAbCart">
              <div class="dh-w-savedbox">
                <div class="dh-w-savedtrack" id="dynAbCartTrack"></div>
                <div class="dh-w-saveddots" id="dynAbCartDots"></div>
              </div>
              <span class="dh-w-boxlabel">Cart</span>
            </div>
          </div>
          {%- elsif section.settings.apps_title != blank -%}<div class="dh-pop-title">{{ section.settings.apps_title }}</div>{%- endif -%}
          {%- assign app_n = 0 -%}
          {%- for block in section.blocks -%}{%- if block.type == 'app_link' and block.settings.enabled -%}{%- assign app_n = app_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- if app_n > 0 -%}
            <div class="dh-apps-grid">
              {%- for block in section.blocks -%}
                {%- if block.type == 'app_link' and block.settings.enabled -%}
                  {%- assign app_href = block.settings.url -%}
                  {%- if app_href == blank -%}
                    {%- case block.settings.icon -%}
                      {%- when 'shop' -%}{%- assign app_href = routes.all_products_collection_url -%}
                      {%- when 'bag' -%}{%- assign app_href = routes.all_products_collection_url -%}
                      {%- when 'cart' -%}{%- assign app_href = routes.cart_url -%}
                      {%- when 'search' -%}{%- assign app_href = routes.search_url -%}
                      {%- when 'account' -%}{%- assign app_href = routes.account_url -%}
                      {%- when 'heart' -%}{%- assign app_href = '/pages/wishlist' -%}
                      {%- when 'mail' -%}{%- assign app_href = '/pages/contact' -%}
                      {%- when 'phone' -%}{%- assign app_href = '/pages/contact' -%}
                      {%- when 'info' -%}{%- assign app_href = '/pages/about' -%}
                      {%- when 'home' -%}{%- assign app_href = routes.root_url -%}
                      {%- when 'gift' -%}{%- assign app_href = '/pages/gift-card' -%}
                      {%- when 'blog' -%}{%- assign app_href = '/blogs/news' -%}
                      {%- when 'tag' -%}{%- assign app_href = '/collections/sale' -%}
                      {%- when 'star' -%}{%- assign app_href = '/pages/reviews' -%}
                      {%- when 'location' -%}{%- assign app_href = '/pages/stores' -%}
                      {%- when 'help' -%}{%- assign app_href = '/pages/faq' -%}
                      {%- else -%}{%- assign app_href = '#' -%}
                    {%- endcase -%}
                  {%- endif -%}
                  <a class="dh-app{% if block.settings.image != blank %} has-img{% endif %}" data-aid="{{ block.id }}" href="{{ app_href }}" {{ block.shopify_attributes }}>
                    <span class="dh-app-ic">
                      {%- if block.settings.image != blank -%}
                        <img draggable="false" src="{{ block.settings.image | image_url: width: 600 }}" alt="" loading="lazy"
                          width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                      {%- elsif block.settings.icon != 'none' -%}
                        <span class="dh-app-svg" aria-hidden="true">
                        {%- case block.settings.icon -%}
                          {%- when 'shop' -%}<svg viewBox="0 0 24 24"><path d="M4 9h16l-1 11H5L4 9Z"/><path d="M4 9l1.4-4.2A1 1 0 0 1 6.3 4h11.4a1 1 0 0 1 .95.7L20 9"/><path d="M9 13a3 3 0 0 0 6 0"/></svg>
                          {%- when 'bag' -%}<svg viewBox="0 0 24 24"><path d="M6 8h12l1 12H5L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                          {%- when 'cart' -%}<svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1.5"/><circle cx="18" cy="21" r="1.5"/><path d="M2 3h3l2.5 13h11l2-8H6"/></svg>
                          {%- when 'search' -%}<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                          {%- when 'account' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                          {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-5-7 5V4a1 1 0 0 1 1-1Z"/></svg>
                          {%- when 'mail' -%}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                          {%- when 'phone' -%}<svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.2-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"/></svg>
                          {%- when 'info' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="12" y1="11" x2="12" y2="16"/><line x1="12" y1="8" x2="12" y2="8"/></svg>
                          {%- when 'home' -%}<svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
                          {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="3.5" y="8" width="17" height="4.5" rx="1"/><path d="M5 12.5V20h14v-7.5"/><path d="M12 8v12"/><path d="M12 8C11 5.5 7.5 5.5 7.5 7.6 7.5 9 9.6 8 12 8Zm0 0c1-2.5 4.5-2.5 4.5-.4C16.5 9 14.4 8 12 8Z"/></svg>
                          {%- when 'blog' -%}<svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg>
                          {%- when 'tag' -%}<svg viewBox="0 0 24 24"><path d="M4 12V5a1 1 0 0 1 1-1h7l8 8-8 8-8-8Z"/><circle cx="8.5" cy="8.5" r="1.3"/></svg>
                          {%- when 'star' -%}<svg viewBox="0 0 24 24"><path d="M12 3l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9z"/></svg>
                          {%- when 'location' -%}<svg viewBox="0 0 24 24"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                          {%- when 'help' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.8.4-1 .9-1 1.7"/><line x1="12" y1="17" x2="12" y2="17"/></svg>
                          {%- when 'instagram' -%}<svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1"/></svg>
                        {%- endcase -%}
                        </span>
                      {%- else -%}
                        <span class="dh-app-init">{{ block.settings.label | default: '?' | slice: 0 | upcase }}</span>
                      {%- endif -%}
                    </span>
                    <span class="dh-app-label">{{ block.settings.label }}</span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            {%- comment -%} No App link blocks added yet — show a sensible default set of pages. {%- endcomment -%}
            <div class="dh-apps-grid">
              <a class="dh-app" data-aid="shop" href="{{ routes.all_products_collection_url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><path d="M4 9h16l-1 11H5L4 9Z"/><path d="M4 9l1.4-4.2A1 1 0 0 1 6.3 4h11.4a1 1 0 0 1 .95.7L20 9"/><path d="M9 13a3 3 0 0 0 6 0"/></svg></span></span><span class="dh-app-label">Shop</span></a>
              <a class="dh-app" data-aid="search" href="{{ routes.search_url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span></span><span class="dh-app-label">Search</span></a>
              <a class="dh-app" data-aid="contact" href="/pages/contact"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span></span><span class="dh-app-label">Contact</span></a>
              <a class="dh-app" data-aid="about" href="/pages/about"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="12" y1="11" x2="12" y2="16"/><line x1="12" y1="8" x2="12" y2="8"/></svg></span></span><span class="dh-app-label">About</span></a>
              <a class="dh-app" data-aid="blog" href="/blogs/news"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg></span></span><span class="dh-app-label">Blog</span></a>
              <a class="dh-app" data-aid="account" href="{{ routes.account_url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></span></span><span class="dh-app-label">Account</span></a>
              <a class="dh-app" data-aid="cart" href="{{ routes.cart_url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1.5"/><circle cx="18" cy="21" r="1.5"/><path d="M2 3h3l2.5 13h11l2-8H6"/></svg></span></span><span class="dh-app-label">Cart</span></a>
              <a class="dh-app" data-aid="gift" href="/pages/gift-card"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><rect x="3.5" y="8" width="17" height="4.5" rx="1"/><path d="M5 12.5V20h14v-7.5"/><path d="M12 8v12"/><path d="M12 8C11 5.5 7.5 5.5 7.5 7.6 7.5 9 9.6 8 12 8Zm0 0c1-2.5 4.5-2.5 4.5-.4C16.5 9 14.4 8 12 8Z"/></svg></span></span><span class="dh-app-label">Gift cards</span></a>
              <a class="dh-app" data-aid="home" href="{{ routes.root_url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg></span></span><span class="dh-app-label">Home</span></a>
              {%- for policy in shop.policies -%}
                {%- if policy != blank and policy.url != blank -%}
                  <a class="dh-app" data-aid="policy-{{ policy.title | handleize }}" href="{{ policy.url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5"/><line x1="8.5" y1="13" x2="15.5" y2="13"/><line x1="8.5" y1="16.5" x2="13.5" y2="16.5"/></svg></span></span><span class="dh-app-label">{{ policy.title }}</span></a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_account -%}
      <div class="dh-menu dh-acct-menu">
        <button type="button" class="dh-icon-btn dh-acct-btn" aria-haspopup="true" aria-expanded="false" aria-label="Account">
          {%- if section.settings.account_avatar != blank -%}
            {%- assign avw = section.settings.account_avatar.width | times: 30 | divided_by: section.settings.account_avatar.height -%}
            <img class="dh-avatar" src="{{ section.settings.account_avatar | image_url: width: 90 }}" alt="Account" width="{{ avw }}" height="30">
          {%- elsif customer -%}
            <span class="dh-avatar dh-avatar-initial" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0 | upcase }}</span>
          {%- else -%}
            <svg class="dh-acct-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.5"/><circle cx="12" cy="10" r="3.4"/><path d="M5.6 19.2a7 7 0 0 1 12.8 0"/></svg>
          {%- endif -%}
        </button>
        <div class="dh-pop dh-acct-pop" hidden>
          {%- if customer -%}
            {%- assign account_page = section.settings.account_page_url | default: '/pages/account' -%}
            <div class="dh-pop-title">Hi, {{ customer.first_name | default: 'there' }}</div>
            <a class="dh-pop-link" href="https://shopify.com/{{ shop.id }}/account/orders">Orders <svg class="dh-pop-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg></a>
            <a class="dh-pop-link" href="{{ account_page }}?tab=wishlist">Wishlist</a>
            <a class="dh-pop-link" href="{{ account_page }}?tab=reviews">Reviews</a>
            <a class="dh-pop-link" href="https://shopify.com/{{ shop.id }}/account/profile">Profile <svg class="dh-pop-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg></a>
            <a class="dh-pop-link" href="{{ routes.account_logout_url }}">Log out</a>
          {%- else -%}
            <div class="dh-pop-title">Your account</div>
            <p class="dh-pop-note">Sign in with your email — Shopify sends you a secure login code, so there’s no password to remember or forget.</p>
            <a class="dh-pop-btn dh-pop-cta" href="{{ section.settings.login_url | default: routes.account_login_url }}">Log in / Sign up</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    </div>
  </div>

  <script>
  (function () {
    var root = document.getElementById("dynAbar");
    if (!root) return;

    /* Back button — go to the previous page (e.g. 9-dots: Shop -> FAQ -> back
       lands on Shop). Home is only the fallback for a dead end: the page was
       opened directly and there is nothing to go back to. The timer is
       cancelled the moment the browser actually starts leaving this page, so
       a slow back-navigation is never mistaken for "no history". */
    var HOME = {{ routes.root_url | json }};
    var backBtn = document.getElementById("dynAbarBack");
    if (backBtn) backBtn.addEventListener("click", function () {
      if (history.length <= 1) { location.href = HOME; return; }
      var fallback = setTimeout(function () { location.href = HOME; }, 1500);
      window.addEventListener("pagehide", function () { clearTimeout(fallback); }, { once: true });
      history.back();
    });

    var menus = Array.prototype.slice.call(root.querySelectorAll(".dh-menu"));
    if (!menus.length) return;
    function closeMenus(except) {
      menus.forEach(function (m) {
        if (m === except) return;
        var b = m.querySelector(".dh-icon-btn"), p = m.querySelector(".dh-pop");
        if (p) p.hidden = true; if (b) b.setAttribute("aria-expanded", "false");
      });
    }
    menus.forEach(function (m) {
      var btn = m.querySelector(".dh-icon-btn"), pop = m.querySelector(".dh-pop");
      if (!btn || !pop) return;
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        var willOpen = pop.hidden;
        closeMenus(m);
        pop.hidden = !willOpen;
        btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
      });
      pop.addEventListener("click", function (e) { e.stopPropagation(); });
    });
    document.addEventListener("click", function () { closeMenus(null); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeMenus(null); });

    /* Show the photo the shopper set on their account page, if any (same device). */
    try {
      var av = localStorage.getItem("dyn_avatar");
      if (av) {
        var ab = root.querySelector(".dh-acct-btn");
        if (ab) { ab.innerHTML = '<img class="dh-avatar" src="' + av + '" alt="Account">'; }
      }
    } catch (e) {}
  })();
  {%- if section.settings.show_widgets -%}
  (function () {
    /* Apps-window dashboard: live clock + greeting, focus line, saved items. */
    var head = document.getElementById("dynAbWidgets");
    if (!head) return;
    var elGreet = document.getElementById("dynAbGreet"), elDay = document.getElementById("dynAbDay"),
        elDate = document.getElementById("dynAbDate");
    var DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    var MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    /* Apple-style analog face: 60 ticks (long black on the hours, short gray
       between), built once; hands rotate every second, orange seconds hand. */
    var ticksG = document.getElementById("dynAbTicks");
    if (ticksG) {
      var NS = "http://www.w3.org/2000/svg", t = "";
      for (var ti = 0; ti < 60; ti++) {
        var a = ti * 6 * Math.PI / 180, hourTick = ti % 5 === 0;
        var r1 = hourTick ? 74 : 84, r2 = 92;
        t += '<line x1="' + (100 + r1 * Math.sin(a)).toFixed(1) + '" y1="' + (100 - r1 * Math.cos(a)).toFixed(1) +
             '" x2="' + (100 + r2 * Math.sin(a)).toFixed(1) + '" y2="' + (100 - r2 * Math.cos(a)).toFixed(1) +
             '" stroke="' + (hourTick ? "#1d1d1f" : "#b9b9be") + '" stroke-width="' + (hourTick ? 3 : 2) + '" stroke-linecap="round"/>';
      }
      ticksG.innerHTML = t;
    }
    var gHr = document.getElementById("dynAbHr"), gMin = document.getElementById("dynAbMin"), gSec = document.getElementById("dynAbSec");
    function tick() {
      var d = new Date(), h = d.getHours(), mm = d.getMinutes(), ss = d.getSeconds();
      elGreet.textContent = h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
      elDay.textContent = DAYS[d.getDay()];
      elDate.textContent = d.getDate() + " " + MONTHS[d.getMonth()] + ", " + d.getFullYear();
      if (gHr) gHr.setAttribute("transform", "rotate(" + (((h % 12) + mm / 60) * 30).toFixed(2) + " 100 100)");
      if (gMin) gMin.setAttribute("transform", "rotate(" + ((mm + ss / 60) * 6).toFixed(2) + " 100 100)");
      if (gSec) gSec.setAttribute("transform", "rotate(" + (ss * 6) + " 100 100)");
    }
    tick();
    setInterval(tick, 1000);
    /* Focus card: a fresh motivation line on every open. Merchant lines from
       the settings (one per line) win; otherwise the built-in list. A shuffle
       bag guarantees no repeat until every line has had its turn. */
    var elFocus = document.getElementById("dynAbFocus");
    var Q = [];
    var qRaw = {{ section.settings.focus_quotes | default: '' | json }};
    if (qRaw) { Q = qRaw.split("\n").map(function (s) { return s.trim(); }).filter(Boolean); }
    if (!Q.length) {
      Q = ["Stay calm, stay positive.", "Make something you love today.", "Small steps, big smiles.",
        "You're doing better than you think.", "Create more, worry less.", "Today is a good day to start.",
        "Kindness looks good on you.", "Progress, not perfection.", "Your ideas deserve the spotlight.",
        "Good things take time — keep going.", "Collect moments, not things.", "Be the reason someone smiles today.",
        "Enjoy the little things.", "You bring the magic.", "Keep it simple, keep it true.",
        "Turn ideas into keepsakes.", "Every day is a fresh design.", "Stay curious, stay playful."];
    }
    var qBag = [];
    function pickQuote() {
      if (!elFocus || !Q.length) return;
      if (!qBag.length) { qBag = Q.slice(); for (var i = qBag.length - 1; i > 0; i--) { var r = Math.floor(Math.random() * (i + 1)), t = qBag[i]; qBag[i] = qBag[r]; qBag[r] = t; } }
      elFocus.textContent = qBag.pop();
    }
    pickQuote();
    /* Saved & Cart previews: one-square carousels with dots (latest first for
       Saved, cart order for Cart). Swipe or tap a dot to browse; each square
       opens its product. Both live-update, and empty lists say so. */
    function escA(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    function wireCar(track, dots) {
      track.addEventListener("scroll", function () {
        var w = track.clientWidth || 1, at = Math.round(track.scrollLeft / w), ds = dots.children;
        for (var k = 0; k < ds.length; k++) { ds[k].className = k === at ? "is-on" : ""; }
      }, { passive: true });
      dots.addEventListener("click", function (e) {
        var b = e.target.closest("button"); if (!b) return;
        track.scrollTo({ left: (parseInt(b.getAttribute("data-i"), 10) || 0) * track.clientWidth, behavior: "smooth" });
      });
    }
    function renderCar(track, dots, items, emptyHtml, pageUrl) {
      if (!track) return;
      /* Empty previews still link to their page. */
      if (!items.length) {
        track.innerHTML = '<a draggable="false" class="dh-w-emptylink" href="' + escA(pageUrl) + '">' + emptyHtml + '</a>';
        dots.innerHTML = "";
        return;
      }
      var pick = items.slice(0, 8), html = "", dh = "", i;
      for (i = 0; i < pick.length; i++) {
        html += '<a draggable="false" href="' + escA(pageUrl) + '" aria-label="' + escA(pick[i].title || "Product") + '">' +
                (pick[i].image ? '<img draggable="false" src="' + escA(pick[i].image) + '" alt="" loading="lazy">' : '<span class="dh-w-savedph"></span>') + '</a>';
        dh += '<button type="button"' + (i === 0 ? ' class="is-on"' : '') + ' data-i="' + i + '" aria-label="Item ' + (i + 1) + '"></button>';
      }
      track.innerHTML = html;
      dots.innerHTML = pick.length > 1 ? dh : "";
      track.scrollLeft = 0;
    }
    var savedTrack = document.getElementById("dynAbSavedTrack"), savedDots = document.getElementById("dynAbSavedDots");
    var cartTrack = document.getElementById("dynAbCartTrack"), cartDots = document.getElementById("dynAbCartDots");
    var EMPTY_SAVED = '<div class="dh-w-empty"><svg viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-5-7 5V4a1 1 0 0 1 1-1Z"/></svg>Nothing saved yet</div>';
    var EMPTY_CART = '<div class="dh-w-empty"><svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1.5"/><circle cx="18" cy="21" r="1.5"/><path d="M2 3h3l2.5 13h11l2-8H6"/></svg>Cart is empty</div>';
    function renderSaved() {
      var list = [];
      try { var a = JSON.parse(localStorage.getItem("dyn_wishlist") || "[]"); if (a && a.length) list = a; } catch (e) {}
      renderCar(savedTrack, savedDots, list, EMPTY_SAVED, "/pages/wishlist");
    }
    function loadCart() {
      if (!cartTrack) return;
      fetch("/cart.js", { credentials: "same-origin" }).then(function (r) { return r.json(); }).then(function (c) {
        var items = (c && c.items ? c.items : []).map(function (it) {
          return { image: it.image, url: it.url, title: it.product_title };
        });
        renderCar(cartTrack, cartDots, items, EMPTY_CART, "{{ routes.cart_url }}");
      }).catch(function () { renderCar(cartTrack, cartDots, [], EMPTY_CART, "{{ routes.cart_url }}"); });
    }
    if (savedTrack) wireCar(savedTrack, savedDots);
    if (cartTrack) wireCar(cartTrack, cartDots);
    renderSaved();
    loadCart();
    window.addEventListener("dyn-wishlist-change", renderSaved);
    window.addEventListener("storage", function (e) { if (e && e.key === "dyn_wishlist") renderSaved(); });
    window.addEventListener("dyn:added-to-cart", loadCart);
    /* macOS-style rearranging: drag a widget over another and they trade
       places, the grid reflowing live. The order is remembered per browser. */
    var ORDER_KEY = "dyn_widget_order";
    (function () {
      var els = head.querySelectorAll("[data-wid]"), i;
      try {
        var ord = JSON.parse(localStorage.getItem(ORDER_KEY) || "null");
        if (ord && ord.length) {
          for (i = 0; i < ord.length; i++) {
            var el = head.querySelector('[data-wid="' + ord[i] + '"]');
            if (el) head.appendChild(el);
          }
        }
      } catch (e) {}
      for (i = 0; i < els.length; i++) els[i].setAttribute("draggable", "true");
      var dragEl = null;
      head.addEventListener("dragstart", function (e) {
        var t = e.target.closest ? e.target.closest("[data-wid]") : null;
        if (!t) return;
        dragEl = t; t.classList.add("is-drag");
        try { e.dataTransfer.setData("text/plain", t.getAttribute("data-wid")); e.dataTransfer.effectAllowed = "move"; } catch (err) {}
      });
      head.addEventListener("dragover", function (e) {
        if (!dragEl) return;
        e.preventDefault();
        var t = e.target.closest ? e.target.closest("[data-wid]") : null;
        if (!t || t === dragEl) return;
        if (dragEl.compareDocumentPosition(t) & Node.DOCUMENT_POSITION_FOLLOWING) { t.after(dragEl); } else { t.before(dragEl); }
      });
      head.addEventListener("drop", function (e) { e.preventDefault(); });
      head.addEventListener("dragend", function () {
        if (dragEl) dragEl.classList.remove("is-drag");
        dragEl = null;
        var ids = [], ws = head.querySelectorAll("[data-wid]");
        for (var k = 0; k < ws.length; k++) ids.push(ws[k].getAttribute("data-wid"));
        try { localStorage.setItem(ORDER_KEY, JSON.stringify(ids)); } catch (e2) {}
      });
    })();
    var apBtn = document.querySelector(".dyn-abar .dh-apps-btn");
    if (apBtn) { apBtn.addEventListener("click", function () { pickQuote(); renderSaved(); loadCart(); }); }
  })();
  {%- endif -%}
  (function () {
    /* App tiles rearrange exactly like the widgets: drag one over another and
       they trade places; the order is remembered per browser. */
    var grid = document.querySelector(".dyn-abar .dh-apps-grid");
    if (!grid) return;
    var KEY = "dyn_app_order", i;
    try {
      var ord = JSON.parse(localStorage.getItem(KEY) || "null");
      if (ord && ord.length) {
        for (i = 0; i < ord.length; i++) {
          var el = grid.querySelector('[data-aid="' + ord[i] + '"]');
          if (el) grid.appendChild(el);
        }
      }
    } catch (e) {}
    var items = grid.querySelectorAll(".dh-app");
    for (i = 0; i < items.length; i++) items[i].setAttribute("draggable", "true");
    var dragEl = null;
    grid.addEventListener("dragstart", function (e) {
      var t = e.target.closest ? e.target.closest(".dh-app") : null;
      if (!t) return;
      dragEl = t; t.classList.add("is-drag");
      try { e.dataTransfer.setData("text/plain", t.getAttribute("data-aid") || ""); e.dataTransfer.effectAllowed = "move"; } catch (err) {}
    });
    grid.addEventListener("dragover", function (e) {
      if (!dragEl) return;
      e.preventDefault();
      var t = e.target.closest ? e.target.closest(".dh-app") : null;
      if (!t || t === dragEl) return;
      if (dragEl.compareDocumentPosition(t) & Node.DOCUMENT_POSITION_FOLLOWING) { t.after(dragEl); } else { t.before(dragEl); }
    });
    grid.addEventListener("drop", function (e) { e.preventDefault(); });
    grid.addEventListener("dragend", function () {
      if (dragEl) dragEl.classList.remove("is-drag");
      dragEl = null;
      var ids = [], its = grid.querySelectorAll(".dh-app"), k;
      for (k = 0; k < its.length; k++) ids.push(its[k].getAttribute("data-aid"));
      try { localStorage.setItem(KEY, JSON.stringify(ids)); } catch (e2) {}
    });
  })();
  {%- if section.settings.peek_scroll -%}
  (function () {
    /* Hide on scroll down, show on scroll up. Always visible near the top,
       and it never hides while one of its menus is open. */
    var bar = document.getElementById("dynAbar");
    if (!bar) return;
    var wrap = bar.closest('[id^="shopify-section-"]') || bar.parentElement || bar;
    var lastY = window.pageYOffset || 0;
    window.addEventListener("scroll", function () {
      var y = window.pageYOffset || 0;
      var d = y - lastY;
      lastY = y;
      if (bar.querySelector(".dh-pop:not([hidden])")) return;
      if (y < 90) { wrap.classList.remove("ab-peek-hide"); return; }
      if (d > 2) { wrap.classList.add("ab-peek-hide"); }
      else if (d < -2) { wrap.classList.remove("ab-peek-hide"); }
    }, { passive: true });
  })();
  {%- endif -%}
  (function () {
    /* AssistiveTouch behaviour for the 9-dots: drag the circle anywhere,
       it snaps to the nearest screen edge on release, the spot is
       remembered per browser, and the window opens beside it. A plain
       tap still opens the window. */
    var menu = document.querySelector(".dyn-abar .dh-apps-menu");
    var btn = menu && menu.querySelector(".dh-apps-btn");
    var pop = menu && menu.querySelector(".dh-apps-pop");
    if (!menu || !btn || !pop) return;
    /* Inside a page-preview iframe the floating orb stays out of the way
       (and doesn't recurse). */
    if (window.top !== window.self) { menu.style.display = "none"; return; }
    /* The bar can carry transforms (sticky peek-hide slides the whole
       section up) and a transformed ancestor hijacks position:fixed —
       the circle would stop following the pointer and ride away with the
       bar. Re-home it directly under <body>; the display:contents host
       keeps the .dyn-abar CSS scope matching. */
    var host = document.createElement("div");
    host.className = "dyn-abar";
    host.style.display = "contents";
    document.body.appendChild(host);
    host.appendChild(menu);
    /* The Vision tab bar: home (widgets), saved, cart, apps. Lives beside
       the orb; each tab shows its content in the floating window. */
    var vbar = document.createElement("div");
    vbar.className = "dh-vbar";
    vbar.innerHTML =
      '<button type="button" class="dh-vtab is-on" data-vtab="widgets" aria-label="Widgets"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></button>' +
      '<button type="button" class="dh-vtab" data-vtab="saved" aria-label="Saved"><svg viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-5-7 5V4a1 1 0 0 1 1-1Z"/></svg></button>' +
      '<button type="button" class="dh-vtab" data-vtab="cart" aria-label="Cart"><svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1.5"/><circle cx="18" cy="21" r="1.5"/><path d="M2 3h3l2.5 13h11l2-8H6"/></svg></button>' +
      '<button type="button" class="dh-vtab" data-vtab="apps" aria-label="Apps"><svg viewBox="0 0 24 24"><circle cx="5" cy="5" r="1.7"/><circle cx="12" cy="5" r="1.7"/><circle cx="19" cy="5" r="1.7"/><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/><circle cx="5" cy="19" r="1.7"/><circle cx="12" cy="19" r="1.7"/><circle cx="19" cy="19" r="1.7"/></svg></button>' +
      '<button type="button" class="dh-vtab" data-vtab="account" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></button>';
    host.appendChild(vbar);
    /* Every app gets its own tab; its window shows a live preview of the
       page (same-shop links embed; outside links get an Open button). */
    var vApps = [];
    var vAllApps = Array.prototype.slice.call(pop.querySelectorAll(".dh-apps-grid .dh-app"));
    var vRoot = {{ routes.root_url | json }};
    vAllApps.forEach(function (a, i) {
      var href = a.getAttribute("href") || "#", label = "App", ext = false, home = false, abs = href;
      var lab = a.querySelector(".dh-app-label");
      if (lab && lab.textContent) label = lab.textContent.trim();
      try {
        var u = new URL(href, location.href);
        abs = u.href;
        ext = u.host !== location.host;
        home = !ext && (u.pathname === vRoot || u.pathname === "/");
      } catch (e2) {}
      vApps.push({ href: abs, label: label, ext: ext, home: home });
      /* The last five apps stay out of the bar — they're still in the Apps
         grid tab, this just keeps the bar short. */
      if (i >= vAllApps.length - 5) return;
      var t = document.createElement("button");
      t.type = "button";
      t.className = "dh-vtab";
      t.setAttribute("data-vtab", "app-" + i);
      t.setAttribute("aria-label", label);
      var icon = a.querySelector(".dh-app-ic svg, .dh-app-ic img");
      if (icon) t.appendChild(icon.cloneNode(true));
      else t.textContent = (label.charAt(0) || "\u2022").toUpperCase();
      vbar.appendChild(t);
    });
    /* The Apps window's own page tabs: All (the grid) + every same-shop,
       non-home app by name. */
    var ptabs = document.createElement("div");
    ptabs.className = "dh-ptabs";
    var vprev = document.createElement("div");
    vprev.className = "dh-vprev";
    vprev.hidden = true;
    vprev.innerHTML = '<div class="dh-vprev-top">' +
      '<a class="dh-vprev-open" aria-label="Open the full page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7"/><path d="M9 7h8v8"/></svg></a></div>' +
      '<div class="dh-vprev-hold"></div>' +
      '<div class="dh-vprev-ext" hidden>This link opens outside the shop \u2014 use the arrow.</div>';
    pop.insertBefore(ptabs, pop.firstChild);
    pop.appendChild(vprev);
    ptabs.innerHTML = vApps.map(function (ap, i) {
      if (ap.ext || ap.home) return "";
      /* Saved has its own core tab — no duplicate pill. */
      var lab = (ap.label || "").toLowerCase();
      if (lab === "saved" || ap.href.indexOf("/pages/wishlist") !== -1) return "";
      return '<button type="button" class="dh-ptab" data-vtab="app-' + i + '">' + vEsc(ap.label) + "</button>";
    }).join("");
    ptabs.addEventListener("click", function (e) {
      e.stopPropagation();
      var t = e.target.closest ? e.target.closest(".dh-ptab") : null;
      if (!t) return;
      pop.setAttribute("data-vtab", t.getAttribute("data-vtab"));
      paintVision();
    });
    /* Account: the person icon is a plain door — profile lives on
       Shopify's own site (signed out it goes to secure login instead).
       Reviews earns its own tab in the bar once they're signed in and
       shows the reviews page in the glass window. */
    var vCust = {% if customer %}true{% else %}false{% endif %};
    var vLogin = {{ routes.account_login_url | json }};
    var vProf = {{ routes.account_url | json }};
    var vRev = null;
    Array.prototype.forEach.call(document.querySelectorAll(".dyn-abar .dh-acct-pop a"), function (a) {
      var label = (a.textContent || "").trim().toLowerCase();
      var href = a.getAttribute("href") || "#", abs = href;
      try { abs = new URL(href, location.href).href; } catch (eA) {}
      if (label === "profile") vProf = abs;
      if (label === "reviews" || /[?&]tab=reviews/.test(abs)) vRev = abs;
    });
