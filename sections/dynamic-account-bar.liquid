  <script>
  (function () {
    var root = document.getElementById("dynAbar");
    if (!root) return;

    /* Back button — go to the previous page (e.g. 9-dots: Shop -> FAQ -> back
       lands on Shop). Home is only the fallback for a dead end: the page was
       opened directly and there is nothing to go back to. The timer is
       cancelled the moment the browser actually starts leaving this page, so
       a slow back-navigation is never mistaken for "no history". */
    var HOME = {{ routes.root_url | json }};
    var backBtn = document.getElementById("dynAbarBack");
    if (backBtn) backBtn.addEventListener("click", function () {
      if (history.length <= 1) { location.href = HOME; return; }
      var fallback = setTimeout(function () { location.href = HOME; }, 1500);
      window.addEventListener("pagehide", function () { clearTimeout(fallback); }, { once: true });
      history.back();
    });

    var menus = Array.prototype.slice.call(root.querySelectorAll(".dh-menu"));
    if (!menus.length) return;
    function closeMenus(except) {
      menus.forEach(function (m) {
        if (m === except) return;
        var b = m.querySelector(".dh-icon-btn"), p = m.querySelector(".dh-pop");
        if (p) p.hidden = true; if (b) b.setAttribute("aria-expanded", "false");
      });
    }
    menus.forEach(function (m) {
      var btn = m.querySelector(".dh-icon-btn"), pop = m.querySelector(".dh-pop");
      if (!btn || !pop) return;
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        var willOpen = pop.hidden;
        closeMenus(m);
        pop.hidden = !willOpen;
        btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
      });
      pop.addEventListener("click", function (e) { e.stopPropagation(); });
    });
    document.addEventListener("click", function () { closeMenus(null); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeMenus(null); });

    /* Show the photo the shopper set on their account page, if any (same device). */
    try {
      var av = localStorage.getItem("dyn_avatar");
      if (av) {
        var ab = root.querySelector(".dh-acct-btn");
        if (ab) { ab.innerHTML = '<img class="dh-avatar" src="' + av + '" alt="Account">'; }
      }
    } catch (e) {}
  })();
  {%- if section.settings.show_widgets -%}
  (function () {
    /* Apps-window dashboard: live clock + greeting, and the studio city's
       weather from Open-Meteo (no API key). Weather loads the first time the
       window opens and is cached for 30 minutes. */
    var head = document.getElementById("dynAbWidgets");
    if (!head) return;
    var elGreet = document.getElementById("dynAbGreet"), elDay = document.getElementById("dynAbDay"),
        elDate = document.getElementById("dynAbDate"), elTime = document.getElementById("dynAbTime"),
        elAmpm = document.getElementById("dynAbAmpm"), elWxIc = document.getElementById("dynAbWxIc"),
        elWxTemp = document.getElementById("dynAbWxTemp"), elWxCond = document.getElementById("dynAbWxCond"),
        elWxFeels = document.getElementById("dynAbWxFeels"), elWxFc = document.getElementById("dynAbWxFc");
    var DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    var MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    function tick() {
      var d = new Date(), h = d.getHours(), mm = d.getMinutes();
      elGreet.textContent = h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
      elDay.textContent = DAYS[d.getDay()];
      elDate.textContent = d.getDate() + " " + MONTHS[d.getMonth()] + ", " + d.getFullYear();
      var hh = h % 12; if (hh === 0) hh = 12;
      elTime.textContent = hh + ":" + (mm < 10 ? "0" : "") + mm;
      elAmpm.textContent = h < 12 ? "AM" : "PM";
    }
    tick();
    setInterval(tick, 15000);
    function wxIcon(code) {
      var p;
      if (code === 0 || code === 1) p = '<circle cx="12" cy="12" r="4.2"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/>';
      else if (code === 2) p = '<path d="M5 12a4 4 0 0 1 7.6-1.7"/><path d="M12 5.5v-2M5.5 8.5L4 7M15 6.6l1.2-1.6"/><path d="M8 18h8.5a3.5 3.5 0 1 0-.9-6.9A5 5 0 0 0 8 12.4 3 3 0 0 0 8 18Z"/>';
      else if (code === 45 || code === 48) p = '<path d="M4 9h16M4 13h16M6 17h12"/>';
      else if (code >= 71 && code <= 86 && code !== 80 && code !== 81 && code !== 82) p = '<path d="M7 15h9.5a3.5 3.5 0 1 0-.9-6.9A5 5 0 0 0 7 9.4 3 3 0 0 0 7 15Z"/><path d="M8.5 18.5v.01M12 19.5v.01M15.5 18.5v.01"/>';
      else if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) p = '<path d="M7 14h9.5a3.5 3.5 0 1 0-.9-6.9A5 5 0 0 0 7 8.4 3 3 0 0 0 7 14Z"/><path d="M8.5 17l-1 2.5M12 17l-1 2.5M15.5 17l-1 2.5"/>';
      else if (code >= 95) p = '<path d="M7 13h9.5a3.5 3.5 0 1 0-.9-6.9A5 5 0 0 0 7 7.4 3 3 0 0 0 7 13Z"/><path d="M12.5 13.5 10 17.5h3l-2 4"/>';
      else p = '<path d="M7 16h9.5a3.5 3.5 0 1 0-.9-6.9A5 5 0 0 0 7 10.4 3 3 0 0 0 7 16Z"/>';
      return '<svg viewBox="0 0 24 24" aria-hidden="true">' + p + '</svg>';
    }
    function wxWord(code) {
      if (code === 0 || code === 1) return "Sunny";
      if (code === 2) return "Partly cloudy";
      if (code === 3) return "Cloudy";
      if (code === 45 || code === 48) return "Foggy";
      if (code >= 71 && code <= 86 && code !== 80 && code !== 81 && code !== 82) return "Snow";
      if ((code >= 51 && code <= 67)) return "Rain";
      if (code >= 80 && code <= 82) return "Showers";
      if (code >= 95) return "Thunderstorm";
      return "Cloudy";
    }
    var FDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    function showWx(w) {
      elWxIc.innerHTML = wxIcon(w.code);
      elWxTemp.textContent = w.t + "°";
      elWxCond.textContent = wxWord(w.code);
      elWxFeels.textContent = "Feels like " + w.feels + "°";
      if (w.fc && w.fc.length) {
        var html = "";
        for (var i = 0; i < w.fc.length; i++) {
          var f = w.fc[i];
          html += '<span><span class="dh-w-fd">' + f.d + '</span>' + wxIcon(f.c) +
                  '<span class="dh-w-ft">' + f.hi + '°/' + f.lo + '°</span></span>';
        }
        elWxFc.innerHTML = html;
      }
    }
    function loadWx() {
      try {
        var c = JSON.parse(sessionStorage.getItem("dyn_wx2") || "null");
        if (c && Date.now() - c.ts < 1800000) { showWx(c); return; }
      } catch (e) {}
      var u = "https://api.open-meteo.com/v1/forecast?latitude=" + head.getAttribute("data-lat") +
              "&longitude=" + head.getAttribute("data-lon") +
              "&current=temperature_2m,apparent_temperature,weather_code" +
              "&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=6&timezone=auto" +
              (head.getAttribute("data-unit") === "f" ? "&temperature_unit=fahrenheit" : "");
      fetch(u).then(function (r) { return r.json(); }).then(function (j) {
        if (!j || !j.current) return;
        var w = { t: Math.round(j.current.temperature_2m), feels: Math.round(j.current.apparent_temperature),
                  code: j.current.weather_code || 0, fc: [], ts: Date.now() };
        if (j.daily && j.daily.time) {
          for (var i = 1; i < j.daily.time.length && w.fc.length < 5; i++) {
            w.fc.push({ d: FDAYS[new Date(j.daily.time[i]).getUTCDay()], c: j.daily.weather_code[i] || 0,
                        hi: Math.round(j.daily.temperature_2m_max[i]), lo: Math.round(j.daily.temperature_2m_min[i]) });
          }
        }
        try { sessionStorage.setItem("dyn_wx2", JSON.stringify(w)); } catch (e) {}
        showWx(w);
      }).catch(function () {});
    }
    /* Focus card: a fresh motivation line on every open. Merchant lines from
       the settings (one per line) win; otherwise the built-in list. A shuffle
       bag guarantees no repeat until every line has had its turn. */
    var elFocus = document.getElementById("dynAbFocus");
    var Q = [];
    var qRaw = {{ section.settings.focus_quotes | default: '' | json }};
    if (qRaw) { Q = qRaw.split("\n").map(function (s) { return s.trim(); }).filter(Boolean); }
    if (!Q.length) {
      Q = ["Stay calm, stay positive.", "Make something you love today.", "Small steps, big smiles.",
        "You're doing better than you think.", "Create more, worry less.", "Today is a good day to start.",
        "Kindness looks good on you.", "Progress, not perfection.", "Your ideas deserve the spotlight.",
        "Good things take time — keep going.", "Collect moments, not things.", "Be the reason someone smiles today.",
        "Enjoy the little things.", "You bring the magic.", "Keep it simple, keep it true.",
        "Turn ideas into keepsakes.", "Every day is a fresh design.", "Stay curious, stay playful."];
    }
    var qBag = [];
    function pickQuote() {
      if (!elFocus || !Q.length) return;
      if (!qBag.length) { qBag = Q.slice(); for (var i = qBag.length - 1; i > 0; i--) { var r = Math.floor(Math.random() * (i + 1)), t = qBag[i]; qBag[i] = qBag[r]; qBag[r] = t; } }
      elFocus.textContent = qBag.pop();
    }
    pickQuote();
    var apBtn = document.querySelector(".dyn-abar .dh-apps-btn");
    if (apBtn) { apBtn.addEventListener("click", function () { loadWx(); pickQuote(); }); } else { loadWx(); }
  })();
  {%- endif -%}
  {%- if section.settings.peek_scroll -%}
  (function () {
    /* Hide on scroll down, show on scroll up. Always visible near the top,
       and it never hides while one of its menus is open. */
    var bar = document.getElementById("dynAbar");
    if (!bar) return;
    var wrap = bar.closest('[id^="shopify-section-"]') || bar.parentElement || bar;
    var lastY = window.pageYOffset || 0;
    window.addEventListener("scroll", function () {
      var y = window.pageYOffset || 0;
      var d = y - lastY;
      lastY = y;
      if (bar.querySelector(".dh-pop:not([hidden])")) return;
      if (y < 90) { wrap.classList.remove("ab-peek-hide"); return; }
      if (d > 2) { wrap.classList.add("ab-peek-hide"); }
      else if (d < -2) { wrap.classList.remove("ab-peek-hide"); }
    }, { passive: true });
  })();
  {%- endif -%}
  </script>
</div>

{% schema %}
{
