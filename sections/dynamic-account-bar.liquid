{%- comment -%}
  Account & Apps bar — a slim, standalone header strip that shows ONLY the
  account dropdown and the 9-dots apps menu (top-right), with the same look as
  the homepage hero. Add it to your Header section group (Customize → Header →
  Add section → "Account & apps bar") so it appears on every page. It is fully
  self-contained (its own styles + script), so it doesn't touch your main header.
{%- endcomment -%}

{%- assign ab_bg = 'transparent' -%}
{%- unless section.settings.transparent_bg -%}{%- assign ab_bg = section.settings.bar_bg -%}{%- endunless -%}

{%- comment -%} Hide the back button on the home page (nothing to go back to there). {%- endcomment -%}
{%- assign show_back_btn = section.settings.show_back -%}
{%- if template.name == 'index' and section.settings.back_hide_home -%}{%- assign show_back_btn = false -%}{%- endif -%}

<div class="dyn-abar{% if section.settings.overlay %} is-overlay{% endif %}{% if section.settings.sticky and section.settings.overlay == false %} is-sticky{% endif %}" id="dynAbar">
  <style>
    #shopify-section-{{ section.id }} .dyn-abar { background: {{ ab_bg }}; }
    {%- if section.settings.overlay -%}
    /* Float over the page: pull the whole section out of flow so it takes no row.
       With "Follow while scrolling" on, it's fixed — the corner buttons stay put. */
    #shopify-section-{{ section.id }} { position: {% if section.settings.overlay_follow %}fixed{% else %}absolute{% endif %}; top: 0; left: 0; right: 0; z-index: 60; pointer-events: none; }
    #shopify-section-{{ section.id }} .dyn-abar { background: transparent; }
    #shopify-section-{{ section.id }} .dyn-abar .dh-menu, #shopify-section-{{ section.id }} .dyn-abar .ab-back { pointer-events: auto; }
    /* Match the homepage corner links: 20px from top, 26px from the side. */
    #shopify-section-{{ section.id }} .ab-inner { padding: {{ section.settings.overlay_top | default: 20 }}px {{ section.settings.overlay_side | default: 26 }}px; }
    {%- endif -%}
    {%- if section.settings.peek_scroll -%}
    /* Peek-a-boo: slip away on scroll down, glide back on scroll up. */
    {%- if section.settings.overlay -%}
    /* No will-change here: it would turn the wrapper into the containing
       block for the fixed, screen-centered apps window. */
    #shopify-section-{{ section.id }} { transition: transform 0.3s ease; }
    #shopify-section-{{ section.id }}.ab-peek-hide { transform: translateY(-130%); }
    {%- else -%}
    #shopify-section-{{ section.id }} .dyn-abar.is-sticky { transition: transform 0.3s ease; }
    #shopify-section-{{ section.id }}.ab-peek-hide .dyn-abar.is-sticky { transform: translateY(-130%); }
    {%- endif -%}
    {%- endif -%}
    .dyn-abar {
      --bg: #ffffff; --bg-panel: #f5f5f7;
      --ink: #1d1d1f; --ink-soft: #6e6e73; --ink-faint: #86868b;
      --line: #d2d2d7; --accent: #0071e3; --danger: #c0392b;
      --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      position: relative; font-family: var(--font); -webkit-font-smoothing: antialiased;
    }
    .dyn-abar.is-sticky { position: sticky; top: 0; z-index: 50; }
    .dyn-abar .ab-inner { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 26px; }
    .dyn-abar .ab-l { display: flex; align-items: center; }
    .dyn-abar .ab-r { display: flex; align-items: center; gap: 8px; }
    /* Circular back button (top-left) — liquid glass: frosted fill, etched ring,
       a bright top highlight and a soft under-shadow, like a lens sitting on the page. */
    .dyn-abar .ab-back { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%;
      background: rgba(255,255,255,0.32);
      -webkit-backdrop-filter: blur(16px) saturate(1.5); backdrop-filter: blur(16px) saturate(1.5);
      border: 1px solid rgba(255,255,255,0.65); color: var(--ink); cursor: pointer; padding: 0;
      box-shadow: 0 12px 26px -8px rgba(29,29,31,0.28);
      transition: box-shadow .15s, background .15s, transform .08s; }
    .dyn-abar .ab-back:hover { background: rgba(255,255,255,0.5); box-shadow: 0 18px 34px -10px rgba(29,29,31,0.32); }
    .dyn-abar .ab-back:active { transform: scale(0.95); }
    .dyn-abar .ab-back svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* Account button + apps grid — same glass treatment */
    .dyn-abar .dh-menu { position: relative; display: inline-flex; }
    .dyn-abar .dh-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
      border-radius: 50%; color: var(--ink-soft); cursor: pointer; padding: 0;
      background: rgba(255,255,255,0.32);
      -webkit-backdrop-filter: blur(16px) saturate(1.5); backdrop-filter: blur(16px) saturate(1.5);
      border: 1px solid rgba(255,255,255,0.65);
      box-shadow: 0 10px 22px -7px rgba(29,29,31,0.26);
      transition: background .16s, color .16s, box-shadow .15s; }
    .dyn-abar .dh-icon-btn:hover { background: rgba(255,255,255,0.52); color: var(--ink);
      box-shadow: 0 14px 28px -9px rgba(29,29,31,0.3); }
    /* Browsers without backdrop blur get a clean solid fallback */
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .dyn-abar .ab-back, .dyn-abar .dh-icon-btn { background: rgba(255,255,255,0.88); }
    }
    .dyn-abar .dh-apps-btn svg { width: 22px; height: 22px; fill: currentColor; }
    .dyn-abar .dh-acct-ic { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 1.5; }
    .dyn-abar .dh-avatar { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; display: block; }
    .dyn-abar .dh-avatar-initial { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px;
      border-radius: 50%; background: var(--accent); color: #fff; font: 600 14px/1 var(--font); }
    .dyn-abar .dh-acct-menu .dh-icon-btn { width: 42px; height: 42px; }

    /* Dropdown panels — same liquid glass as the corner buttons */
    /* Matte frost panel matching the apps window: even 12% frost, quiet rim,
       one soft shadow — and the menu items are dark smoked rows with white
       text (like the app tiles), so they read on any background. */
    .dyn-abar .dh-pop { position: absolute; top: calc(100% + 10px); right: 0; z-index: 30; min-width: 220px;
      background: rgba(255,255,255,0.12); -webkit-backdrop-filter: blur(26px) saturate(1.6); backdrop-filter: blur(26px) saturate(1.6);
      border: 1px solid rgba(255,255,255,0.22); border-radius: 24px; padding: 12px;
      box-shadow: 0 30px 80px -24px rgba(0,0,0,0.5);
      animation: abPop .14s ease; }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .dyn-abar .dh-pop { background: rgba(60, 60, 68, 0.96); }
    }
    /* Matte glass: no gloss cap. */
    .dyn-abar .dh-pop::before { display: none; }
    @keyframes abPop { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    .dyn-abar .dh-pop[hidden] { display: none; }
    .dyn-abar .dh-pop-title { font-size: 13px; color: rgba(255,255,255,0.75); padding: 4px 10px 10px; }
    .dyn-abar .dh-pop-link { display: block; padding: 12px 14px; border-radius: 14px; font-size: 14px; color: #fff;
      text-decoration: none; transition: background .14s;
      background: rgba(42, 42, 47, 0.28); border: 1px solid rgba(255,255,255,0.10); margin-bottom: 8px; }
    .dyn-abar .dh-pop-link:last-child { margin-bottom: 0; }
    .dyn-abar .dh-pop-link:hover { background: rgba(42, 42, 47, 0.45); }
    .dyn-abar .dh-pop-ext { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; vertical-align: -1px; margin-left: 4px; opacity: .55; }
    .dyn-abar .dh-pop-btn { display: block; text-align: center; margin: 2px 4px 8px; padding: 11px 14px; border-radius: 999px;
      background: rgba(42, 42, 47, 0.6); border: 1px solid rgba(255,255,255,0.14); color: #fff; font-size: 14px; font-weight: 500; text-decoration: none; transition: background .14s; }
    .dyn-abar .dh-pop-btn:hover { background: rgba(42, 42, 47, 0.8); }
    .dyn-abar a.dh-pop-cta { text-decoration: none; }
    .dyn-abar .dh-pop-note { font-size: 12px; color: rgba(255,255,255,0.72); line-height: 1.5; padding: 0 10px 10px; }
    .dyn-abar .dh-acct-pop { min-width: 260px; }

    /* 9-dots: a big glass window hanging from the corner button. REAL liquid
       glass: barely-there white fill, strong blur + saturation so the page's
       colors bloom through, bright etched rim, no painted-white gloss. */
    /* Matte frosted glass — flat, even frost with no gloss cap, no angled
       sheen, no bright bevels. Just blur, a whisper of white, a quiet rim. */
    .dyn-abar .dh-apps-pop { top: calc(100% + 12px); right: 0;
      width: min(590px, calc(100vw - 28px)); max-height: min(84vh, 700px); overflow-y: auto;
      padding: 22px 22px 24px; border-radius: 30px;
      background: rgba(255,255,255,0.12);
      -webkit-backdrop-filter: blur(26px) saturate(1.6); backdrop-filter: blur(26px) saturate(1.6);
      border: 1px solid rgba(255,255,255,0.22);
      box-shadow: 0 30px 80px -24px rgba(0,0,0,0.5);
      animation: abWin .2s cubic-bezier(.2, .9, .3, 1.1); transform-origin: top right; }
    @keyframes abWin { from { opacity: 0; transform: scale(0.94) translateY(-6px); }
      to { opacity: 1; transform: scale(1) translateY(0); } }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .dyn-abar .dh-apps-pop { background: rgba(255,255,255,0.96); }
    }
    /* No gloss cap at all — matte glass. */
    .dyn-abar .dh-apps-pop::before { display: none; }
    .dyn-abar .dh-apps-pop .dh-pop-title { font-size: 19px; font-weight: 700; color: var(--ink); padding: 6px 8px 16px; }
    .dyn-abar .dh-apps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    /* Tiles: dark smoked glass on the light pane — deep translucent gray,
       light icons and labels, a faint top bevel catching the light. */
    .dyn-abar .dh-app { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 20px 8px 16px; border-radius: 20px;
      text-decoration: none; color: #fff; transition: background .16s, transform .12s;
      background: rgba(42, 42, 47, 0.28); border: 1px solid rgba(255,255,255,0.10);
      box-shadow: none; }
    .dyn-abar .dh-app:hover { background: rgba(42, 42, 47, 0.45); transform: translateY(-2px); }
    .dyn-abar .dh-app:active { transform: scale(0.96); }
    .dyn-abar .dh-app-ic { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; }
    .dyn-abar .dh-app-ic img { width: 46px; height: 46px; object-fit: contain; }
    .dyn-abar .dh-app-init { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px;
      border-radius: 14px; background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.9); font: 600 19px/1 var(--font); }
    .dyn-abar .dh-app-svg { display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px;
      border-radius: 15px; background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.12);
      color: #fff; }
    .dyn-abar .dh-app-svg svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .dyn-abar .dh-app-label { font-size: 13px; color: rgba(255,255,255,0.88); text-align: center; line-height: 1.25; }
    /* macOS-style widget board: a 4-column grid the widgets flow through.
       Drag any widget (clock, quote, weather, Saved) to rearrange — the board
       reflows live and the order is remembered per browser. */
    .dyn-abar .dh-apps-head { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 126px;
      grid-auto-flow: dense; gap: 12px; margin-bottom: 12px; }
    .dyn-abar .dh-apps-head [data-wid] { cursor: grab; }
    .dyn-abar .dh-apps-head [data-wid]:active { cursor: grabbing; }
    .dyn-abar .dh-apps-head .is-drag { opacity: 0.45; transform: scale(0.97); }
    .dyn-abar .dh-w-greethead { grid-column: span 2; }
    .dyn-abar .dh-w-clock, .dyn-abar .dh-w-quote { grid-column: span 1; grid-row: span 1; }
    .dyn-abar .dh-w-weather, .dyn-abar .dh-w-saved { grid-column: span 2; grid-row: span 2; }
    .dyn-abar .dh-widget { border-radius: 20px; padding: 12px 14px; color: #fff;
      background: rgba(42, 42, 47, 0.28); border: 1px solid rgba(255,255,255,0.10);
      box-shadow: none; }
    /* Strong double shadow so the bare greeting stays readable on bright walls. */
    .dyn-abar .dh-w-greethead { padding: 2px 5px 0; color: #fff;
      display: flex; flex-direction: column; justify-content: center;
      text-shadow: 0 1px 3px rgba(0,0,0,0.5), 0 2px 14px rgba(0,0,0,0.35); }
    .dyn-abar .dh-w-greet { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; color: #fff; }
    .dyn-abar .dh-w-greet svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; filter: drop-shadow(0 1px 2px rgba(0,0,0,0.4)); }
    .dyn-abar .dh-w-day { font-size: 30px; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.12; margin-top: 4px; }
    .dyn-abar .dh-w-sub { font-size: 14px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; margin-top: 4px; }
    /* Weather, widget style: big emoji + temp/condition, divider, day list. */
    .dyn-abar .dh-w-now { display: flex; align-items: center; gap: 12px; padding: 2px 2px 0; }
    .dyn-abar .dh-w-nowic { font-size: 38px; line-height: 1; filter: drop-shadow(0 3px 6px rgba(0,0,0,0.18)); }
    .dyn-abar .dh-w-nowtx { display: flex; flex-direction: column; }
    .dyn-abar .dh-w-temp { font-size: 30px; font-weight: 300; line-height: 1.05; }
    .dyn-abar .dh-w-cond { font-size: 12.5px; color: rgba(255,255,255,0.88); }
    .dyn-abar .dh-w-fc { margin-top: 10px; border-top: 1px solid rgba(255,255,255,0.22); padding-top: 4px; }
    .dyn-abar .dh-w-frow { display: flex; align-items: center; gap: 8px; padding: 5px 2px; font-size: 13px; color: rgba(255,255,255,0.92); }
    .dyn-abar .dh-w-frow .fd { flex: 1 1 auto; text-align: left; }
    .dyn-abar .dh-w-frow .fi { font-size: 17px; line-height: 1; }
    .dyn-abar .dh-w-frow .ft { min-width: 34px; text-align: right; font-variant-numeric: tabular-nums; }
    /* Clock and quote: equal squares, side by side (one grid cell each). */
    .dyn-abar .dh-w-clock { display: flex; justify-content: center; align-items: center; padding: 0; }
    .dyn-abar .dh-w-face { width: 100%; max-width: 126px; height: auto; display: block; filter: drop-shadow(0 10px 22px rgba(0,0,0,0.32)); }
    .dyn-abar .dh-w-mini { min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 5px; padding: 10px 9px; min-width: 0; }
    .dyn-abar .dh-w-plant { width: 20px; height: 20px; flex: none; fill: none; stroke: rgba(255,255,255,0.9); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    .dyn-abar .dh-w-mlines { font-size: 13px; font-weight: 600; line-height: 1.4; color: #fff; }
    /* Live "Saved" tile — the visitor's wishlist as an app-icon carousel:
       one square product at a time (latest first), swipe or tap the dots to
       browse; each square links to its product. Hidden when empty. */
    .dyn-abar .dh-w-saved { display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 10px 10px 9px; border-radius: 20px; background: #fff;
      box-shadow: 0 10px 22px rgba(0,0,0,0.22); }
    .dyn-abar .dh-w-saved[hidden] { display: none; }
    .dyn-abar .dh-w-savedtrack { display: flex; width: 100%; flex: 1 1 auto; min-height: 0; overflow-x: auto; scroll-snap-type: x mandatory;
      border-radius: 12px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .dyn-abar .dh-w-savedtrack::-webkit-scrollbar { display: none; }
    .dyn-abar .dh-w-savedtrack a { flex: 0 0 100%; scroll-snap-align: start; display: block; height: 100%; }
    .dyn-abar .dh-w-savedtrack img, .dyn-abar .dh-w-savedph { display: block; width: 100%; height: 100%;
      object-fit: contain; border-radius: 12px; background: #f5f5f7; }
    .dyn-abar .dh-w-saveddots { display: flex; gap: 5px; justify-content: center; padding-top: 8px; }
    .dyn-abar .dh-w-saveddots button { width: 6px; height: 6px; border-radius: 50%; border: none; padding: 0;
      background: #d2d2d7; cursor: pointer; transition: background .15s, transform .15s; }
    .dyn-abar .dh-w-saveddots button.is-on { background: #1d1d1f; transform: scale(1.25); }
    @media (max-width: 520px) {
      /* Anchored-to-the-button would poke past the left screen edge on a
         phone — pin the window to the viewport instead. */
      .dyn-abar .dh-apps-pop { position: fixed; left: 8px; right: 8px; top: 84px; width: auto; padding: 18px 16px 22px; border-radius: 30px; }
      .dyn-abar .dh-apps-grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }
      .dyn-abar .dh-app { padding: 16px 8px 13px; }
      .dyn-abar .dh-app-ic, .dyn-abar .dh-app-ic img, .dyn-abar .dh-app-init { width: 42px; height: 42px; }
      .dyn-abar .dh-app-svg { width: 46px; height: 46px; }
      .dyn-abar .dh-app-svg svg { width: 24px; height: 24px; }
      .dyn-abar .dh-apps-head { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 140px; gap: 10px; margin-bottom: 10px; }
      .dyn-abar .dh-widget { padding: 11px 12px; border-radius: 16px; }
      .dyn-abar .dh-w-day { font-size: 24px; }
      .dyn-abar .dh-w-sub { font-size: 12px; }
      .dyn-abar .dh-w-face { max-width: 116px; }
      .dyn-abar .dh-w-temp { font-size: 24px; }
    }
    @media (prefers-reduced-motion: reduce) { .dyn-abar .dh-apps-pop, .dyn-abar .dh-app { animation: none !important; transition: none !important; } }
    @media (max-width: 700px) { .dyn-abar .ab-inner { padding: 8px 16px; } }
  </style>

  <div class="ab-inner">
    <div class="ab-l">
      {%- if show_back_btn -%}
        <button type="button" class="ab-back" id="dynAbarBack" aria-label="Go back to the previous page" title="Back">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>
        </button>
      {%- endif -%}
    </div>
    <div class="ab-r">
    {%- if section.settings.show_apps -%}
      <div class="dh-menu dh-apps-menu">
        <button type="button" class="dh-icon-btn dh-apps-btn" aria-haspopup="true" aria-expanded="false" aria-label="{{ section.settings.apps_title | default: 'Apps' | escape }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="5" r="1.6"/><circle cx="12" cy="5" r="1.6"/><circle cx="19" cy="5" r="1.6"/><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/><circle cx="5" cy="19" r="1.6"/><circle cx="12" cy="19" r="1.6"/><circle cx="19" cy="19" r="1.6"/></svg>
        </button>
        <div class="dh-pop dh-apps-pop" hidden>
          {%- if section.settings.show_widgets -%}
          <div class="dh-apps-head" id="dynAbWidgets"
               data-lat="{{ section.settings.weather_lat | default: '40.71' }}"
               data-lon="{{ section.settings.weather_lon | default: '-74.01' }}"
               data-unit="{{ section.settings.weather_unit | default: 'f' }}"
               data-city="{{ section.settings.weather_city | default: 'New York' | escape }}">
            <div class="dh-w-greethead">
              <div class="dh-w-greet"><span id="dynAbGreet">Hello</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/></svg>
              </div>
              <div class="dh-w-day" id="dynAbDay"></div>
              <div class="dh-w-sub" id="dynAbDate"></div>
            </div>
            <div class="dh-w-clock" data-wid="clock">
              <svg class="dh-w-face" viewBox="0 0 200 200" aria-hidden="true">
                  <rect x="4" y="4" width="192" height="192" rx="48" fill="#ffffff"/>
                  <g id="dynAbTicks"></g>
                  <g fill="#1d1d1f" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="30" font-weight="600" text-anchor="middle">
                    <text x="100" y="62">12</text>
                    <text x="150" y="111">3</text>
                    <text x="100" y="160">6</text>
                    <text x="50" y="111">9</text>
                  </g>
                  <g id="dynAbHr"><line x1="100" y1="104" x2="100" y2="62" stroke="#1d1d1f" stroke-width="9" stroke-linecap="round"/></g>
                  <g id="dynAbMin"><line x1="100" y1="104" x2="100" y2="40" stroke="#1d1d1f" stroke-width="6.5" stroke-linecap="round"/></g>
                  <g id="dynAbSec"><line x1="100" y1="114" x2="100" y2="34" stroke="#ff9f0a" stroke-width="2.5" stroke-linecap="round"/></g>
                  <circle cx="100" cy="100" r="5.5" fill="#ff9f0a"/>
                  <circle cx="100" cy="100" r="2.2" fill="#ffffff"/>
                </svg>
            </div>
            <div class="dh-widget dh-w-mini dh-w-quote" data-wid="quote">
              <svg class="dh-w-plant" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-8"/><path d="M12 13C12 9.5 9.5 7 5.5 7 5.5 10.5 8 13 12 13Z"/><path d="M12 11c0-3.5 2.5-6 6.5-6 0 3.5-2.5 6-6.5 6Z"/></svg>
              <div class="dh-w-mlines" id="dynAbFocus">&nbsp;</div>
            </div>
            <div class="dh-widget dh-w-weather" data-wid="weather">
              <div class="dh-w-now">
                <span class="dh-w-nowic" id="dynAbWxIc"></span>
