    }
    var savedTrack = document.getElementById("dynAbSavedTrack"), savedDots = document.getElementById("dynAbSavedDots");
    var cartTrack = document.getElementById("dynAbCartTrack"), cartDots = document.getElementById("dynAbCartDots");
    var EMPTY_SAVED = '<div class="dh-w-empty"><svg viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-5-7 5V4a1 1 0 0 1 1-1Z"/></svg>Nothing saved yet</div>';
    var EMPTY_CART = '<div class="dh-w-empty"><svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1.5"/><circle cx="18" cy="21" r="1.5"/><path d="M2 3h3l2.5 13h11l2-8H6"/></svg>Cart is empty</div>';
    function renderSaved() {
