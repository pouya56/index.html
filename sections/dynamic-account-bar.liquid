  <script>
  (function () {
    var root = document.getElementById("dynAbar");
    if (!root) return;

    /* Back button — go to the previous page (e.g. 9-dots: Shop -> FAQ -> back
       lands on Shop). Home is only the fallback for a dead end: the page was
       opened directly and there is nothing to go back to. The timer is
       cancelled the moment the browser actually starts leaving this page, so
       a slow back-navigation is never mistaken for "no history". */
    var HOME = {{ routes.root_url | json }};
    var backBtn = document.getElementById("dynAbarBack");
    if (backBtn) backBtn.addEventListener("click", function () {
      if (history.length <= 1) { location.href = HOME; return; }
      var fallback = setTimeout(function () { location.href = HOME; }, 1500);
      window.addEventListener("pagehide", function () { clearTimeout(fallback); }, { once: true });
      history.back();
    });

    var menus = Array.prototype.slice.call(root.querySelectorAll(".dh-menu"));
    if (!menus.length) return;
    function closeMenus(except) {
      menus.forEach(function (m) {
        if (m === except) return;
        var b = m.querySelector(".dh-icon-btn"), p = m.querySelector(".dh-pop");
        if (p) p.hidden = true; if (b) b.setAttribute("aria-expanded", "false");
      });
    }
    menus.forEach(function (m) {
      var btn = m.querySelector(".dh-icon-btn"), pop = m.querySelector(".dh-pop");
      if (!btn || !pop) return;
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        var willOpen = pop.hidden;
        closeMenus(m);
        pop.hidden = !willOpen;
        btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
      });
      pop.addEventListener("click", function (e) { e.stopPropagation(); });
    });
    document.addEventListener("click", function () { closeMenus(null); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeMenus(null); });

    /* Show the photo the shopper set on their account page, if any (same device). */
    try {
      var av = localStorage.getItem("dyn_avatar");
      if (av) {
        var ab = root.querySelector(".dh-acct-btn");
        if (ab) { ab.innerHTML = '<img class="dh-avatar" src="' + av + '" alt="Account">'; }
      }
    } catch (e) {}
  })();
  {%- if section.settings.show_widgets -%}
  (function () {
    /* Apps-window dashboard: live clock + greeting, and the studio city's
       weather from Open-Meteo (no API key). Weather loads the first time the
       window opens and is cached for 30 minutes. */
    var head = document.getElementById("dynAbWidgets");
    if (!head) return;
    var elGreet = document.getElementById("dynAbGreet"), elDay = document.getElementById("dynAbDay"),
        elDate = document.getElementById("dynAbDate"), elWxIc = document.getElementById("dynAbWxIc"),
        elWxTemp = document.getElementById("dynAbWxTemp"), elWxCond = document.getElementById("dynAbWxCond"),
        elWxFc = document.getElementById("dynAbWxFc");
    var DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    var MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    /* Apple-style analog face: 60 ticks (long black on the hours, short gray
       between), built once; hands rotate every second, orange seconds hand. */
    var ticksG = document.getElementById("dynAbTicks");
    if (ticksG) {
      var NS = "http://www.w3.org/2000/svg", t = "";
      for (var ti = 0; ti < 60; ti++) {
        var a = ti * 6 * Math.PI / 180, hourTick = ti % 5 === 0;
        var r1 = hourTick ? 74 : 84, r2 = 92;
        t += '<line x1="' + (100 + r1 * Math.sin(a)).toFixed(1) + '" y1="' + (100 - r1 * Math.cos(a)).toFixed(1) +
             '" x2="' + (100 + r2 * Math.sin(a)).toFixed(1) + '" y2="' + (100 - r2 * Math.cos(a)).toFixed(1) +
             '" stroke="' + (hourTick ? "#1d1d1f" : "#b9b9be") + '" stroke-width="' + (hourTick ? 3 : 2) + '" stroke-linecap="round"/>';
      }
      ticksG.innerHTML = t;
    }
    var gHr = document.getElementById("dynAbHr"), gMin = document.getElementById("dynAbMin"), gSec = document.getElementById("dynAbSec");
    function tick() {
      var d = new Date(), h = d.getHours(), mm = d.getMinutes(), ss = d.getSeconds();
      elGreet.textContent = h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
      elDay.textContent = DAYS[d.getDay()];
      elDate.textContent = d.getDate() + " " + MONTHS[d.getMonth()] + ", " + d.getFullYear();
      if (gHr) gHr.setAttribute("transform", "rotate(" + (((h % 12) + mm / 60) * 30).toFixed(2) + " 100 100)");
      if (gMin) gMin.setAttribute("transform", "rotate(" + ((mm + ss / 60) * 6).toFixed(2) + " 100 100)");
      if (gSec) gSec.setAttribute("transform", "rotate(" + (ss * 6) + " 100 100)");
    }
    tick();
    setInterval(tick, 1000);
    function wxEmoji(code) {
      if (code === 0 || code === 1) return "☀️";
      if (code === 2) return "⛅";
      if (code === 45 || code === 48) return "🌫️";
      if (code >= 71 && code <= 86 && code !== 80 && code !== 81 && code !== 82) return "❄️";
      if (code >= 51 && code <= 67) return "🌧️";
      if (code >= 80 && code <= 82) return "🌦️";
      if (code >= 95) return "⛈️";
      return "☁️";
    }
    function wxWord(code) {
      if (code === 0 || code === 1) return "Sunny";
      if (code === 2) return "Partly cloudy";
      if (code === 3) return "Cloudy";
      if (code === 45 || code === 48) return "Foggy";
      if (code >= 71 && code <= 86 && code !== 80 && code !== 81 && code !== 82) return "Snow";
      if ((code >= 51 && code <= 67)) return "Rain";
      if (code >= 80 && code <= 82) return "Showers";
      if (code >= 95) return "Thunderstorm";
      return "Cloudy";
    }
    function showWx(w) {
      elWxIc.textContent = wxEmoji(w.code);
      elWxTemp.textContent = w.t + "°";
      elWxCond.textContent = wxWord(w.code);
      if (w.fc && w.fc.length) {
        var html = "";
        for (var i = 0; i < w.fc.length; i++) {
          var f = w.fc[i];
          html += '<div class="dh-w-frow"><span class="fd">' + f.d + '</span><span class="fi">' + wxEmoji(f.c) +
                  '</span><span class="ft">' + f.hi + '°</span></div>';
        }
        elWxFc.innerHTML = html;
      }
    }
    function loadWx() {
      try {
        var c = JSON.parse(sessionStorage.getItem("dyn_wx3") || "null");
        if (c && Date.now() - c.ts < 1800000) { showWx(c); return; }
      } catch (e) {}
      var u = "https://api.open-meteo.com/v1/forecast?latitude=" + head.getAttribute("data-lat") +
              "&longitude=" + head.getAttribute("data-lon") +
              "&current=temperature_2m,weather_code" +
              "&daily=weather_code,temperature_2m_max&forecast_days=4&timezone=auto" +
              (head.getAttribute("data-unit") === "f" ? "&temperature_unit=fahrenheit" : "");
      fetch(u).then(function (r) { return r.json(); }).then(function (j) {
        if (!j || !j.current) return;
        var FULLDAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
        var w = { t: Math.round(j.current.temperature_2m), code: j.current.weather_code || 0, fc: [], ts: Date.now() };
        if (j.daily && j.daily.time) {
          for (var i = 1; i < j.daily.time.length && w.fc.length < 3; i++) {
            w.fc.push({ d: FULLDAYS[new Date(j.daily.time[i]).getUTCDay()], c: j.daily.weather_code[i] || 0,
                        hi: Math.round(j.daily.temperature_2m_max[i]) });
          }
        }
        try { sessionStorage.setItem("dyn_wx3", JSON.stringify(w)); } catch (e) {}
        showWx(w);
      }).catch(function () {});
    }
    /* Focus card: a fresh motivation line on every open. Merchant lines from
       the settings (one per line) win; otherwise the built-in list. A shuffle
       bag guarantees no repeat until every line has had its turn. */
    var elFocus = document.getElementById("dynAbFocus");
    var Q = [];
    var qRaw = {{ section.settings.focus_quotes | default: '' | json }};
    if (qRaw) { Q = qRaw.split("\n").map(function (s) { return s.trim(); }).filter(Boolean); }
    if (!Q.length) {
      Q = ["Stay calm, stay positive.", "Make something you love today.", "Small steps, big smiles.",
        "You're doing better than you think.", "Create more, worry less.", "Today is a good day to start.",
        "Kindness looks good on you.", "Progress, not perfection.", "Your ideas deserve the spotlight.",
        "Good things take time — keep going.", "Collect moments, not things.", "Be the reason someone smiles today.",
        "Enjoy the little things.", "You bring the magic.", "Keep it simple, keep it true.",
        "Turn ideas into keepsakes.", "Every day is a fresh design.", "Stay curious, stay playful."];
    }
    var qBag = [];
    function pickQuote() {
      if (!elFocus || !Q.length) return;
      if (!qBag.length) { qBag = Q.slice(); for (var i = qBag.length - 1; i > 0; i--) { var r = Math.floor(Math.random() * (i + 1)), t = qBag[i]; qBag[i] = qBag[r]; qBag[r] = t; } }
      elFocus.textContent = qBag.pop();
    }
    pickQuote();
    /* Saved tile: the wishlist as a one-square carousel, latest first. Swipe
       (scroll-snap) or tap a dot to browse; each square opens its product.
       Live: re-renders the moment something is saved or removed. */
    var savedCard = document.getElementById("dynAbSaved"),
        savedTrack = document.getElementById("dynAbSavedTrack"),
        savedDots = document.getElementById("dynAbSavedDots");
    function escA(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    function markDot(i) {
      var ds = savedDots.children;
      for (var k = 0; k < ds.length; k++) { ds[k].className = k === i ? "is-on" : ""; }
    }
    function renderSaved() {
      if (!savedCard) return;
      var list = [];
      try { var a = JSON.parse(localStorage.getItem("dyn_wishlist") || "[]"); if (a && a.length) list = a; } catch (e) {}
      if (!list.length) { savedCard.hidden = true; return; }
      var pick = list.slice(0, 8), html = "", dots = "", i;
      for (i = 0; i < pick.length; i++) {
        html += '<a draggable="false" href="' + escA(pick[i].url || "/pages/wishlist") + '" aria-label="' + escA(pick[i].title || "Saved product") + '">' +
                (pick[i].image ? '<img draggable="false" src="' + escA(pick[i].image) + '" alt="" loading="lazy">' : '<span class="dh-w-savedph"></span>') + '</a>';
        dots += '<button type="button"' + (i === 0 ? ' class="is-on"' : '') + ' data-i="' + i + '" aria-label="Saved item ' + (i + 1) + '"></button>';
      }
      savedTrack.innerHTML = html;
      savedDots.innerHTML = pick.length > 1 ? dots : "";
      savedTrack.scrollLeft = 0;
      savedCard.hidden = false;
    }
    if (savedTrack) {
      savedTrack.addEventListener("scroll", function () {
        var w = savedTrack.clientWidth || 1;
        markDot(Math.round(savedTrack.scrollLeft / w));
      }, { passive: true });
      savedDots.addEventListener("click", function (e) {
        var b = e.target.closest("button"); if (!b) return;
        savedTrack.scrollTo({ left: (parseInt(b.getAttribute("data-i"), 10) || 0) * savedTrack.clientWidth, behavior: "smooth" });
      });
    }
    renderSaved();
    window.addEventListener("dyn-wishlist-change", renderSaved);
    window.addEventListener("storage", function (e) { if (e && e.key === "dyn_wishlist") renderSaved(); });
    /* macOS-style rearranging: drag a widget over another and they trade
       places, the grid reflowing live. The order is remembered per browser. */
    var ORDER_KEY = "dyn_widget_order";
    (function () {
      var els = head.querySelectorAll("[data-wid]"), i;
      try {
        var ord = JSON.parse(localStorage.getItem(ORDER_KEY) || "null");
        if (ord && ord.length) {
          for (i = 0; i < ord.length; i++) {
            var el = head.querySelector('[data-wid="' + ord[i] + '"]');
            if (el) head.appendChild(el);
          }
        }
      } catch (e) {}
      for (i = 0; i < els.length; i++) els[i].setAttribute("draggable", "true");
      var dragEl = null;
      head.addEventListener("dragstart", function (e) {
        var t = e.target.closest ? e.target.closest("[data-wid]") : null;
        if (!t) return;
        dragEl = t; t.classList.add("is-drag");
        try { e.dataTransfer.setData("text/plain", t.getAttribute("data-wid")); e.dataTransfer.effectAllowed = "move"; } catch (err) {}
      });
      head.addEventListener("dragover", function (e) {
        if (!dragEl) return;
        e.preventDefault();
        var t = e.target.closest ? e.target.closest("[data-wid]") : null;
        if (!t || t === dragEl) return;
        if (dragEl.compareDocumentPosition(t) & Node.DOCUMENT_POSITION_FOLLOWING) { t.after(dragEl); } else { t.before(dragEl); }
      });
      head.addEventListener("drop", function (e) { e.preventDefault(); });
      head.addEventListener("dragend", function () {
        if (dragEl) dragEl.classList.remove("is-drag");
        dragEl = null;
        var ids = [], ws = head.querySelectorAll("[data-wid]");
        for (var k = 0; k < ws.length; k++) ids.push(ws[k].getAttribute("data-wid"));
        try { localStorage.setItem(ORDER_KEY, JSON.stringify(ids)); } catch (e2) {}
      });
    })();
    var apBtn = document.querySelector(".dyn-abar .dh-apps-btn");
    if (apBtn) { apBtn.addEventListener("click", function () { loadWx(); pickQuote(); renderSaved(); }); } else { loadWx(); }
  })();
  {%- endif -%}
  {%- if section.settings.peek_scroll -%}
  (function () {
    /* Hide on scroll down, show on scroll up. Always visible near the top,
       and it never hides while one of its menus is open. */
    var bar = document.getElementById("dynAbar");
    if (!bar) return;
    var wrap = bar.closest('[id^="shopify-section-"]') || bar.parentElement || bar;
    var lastY = window.pageYOffset || 0;
    window.addEventListener("scroll", function () {
      var y = window.pageYOffset || 0;
      var d = y - lastY;
      lastY = y;
      if (bar.querySelector(".dh-pop:not([hidden])")) return;
      if (y < 90) { wrap.classList.remove("ab-peek-hide"); return; }
      if (d > 2) { wrap.classList.add("ab-peek-hide"); }
      else if (d < -2) { wrap.classList.remove("ab-peek-hide"); }
    }, { passive: true });
  })();
  {%- endif -%}
  </script>
</div>

{% schema %}
{
  "name": "Account & apps bar",
  "tag": "section",
  "class": "dynamic-account-bar-section",
  "settings": [
    { "type": "paragraph", "content": "A slim bar with a back button (top-left) plus the account menu and 9-dots apps menu (top-right), matching your homepage look. Add it to your Header group so it shows on every page." },

    { "type": "header", "content": "Back button" },
    { "type": "checkbox", "id": "show_back", "label": "Show back button (top-left)", "default": true, "info": "A round ‘←’ button that returns to the previous page — or your home page if there isn’t one." },
    { "type": "checkbox", "id": "back_hide_home", "label": "Hide it on the home page", "default": true, "info": "Recommended — the home page has no ‘previous’ page, and it would overlap the corner links there." },

    { "type": "header", "content": "Account menu" },
    { "type": "checkbox", "id": "show_account", "label": "Show account menu", "default": true },
    { "type": "image_picker", "id": "account_avatar", "label": "Avatar photo (optional)", "info": "Shown instead of the person icon. A single store-wide photo; each shopper’s own uploaded photo (from the account page) shows automatically on their device." },
    { "type": "url", "id": "login_url", "label": "Log in link", "info": "Where the Log in / Sign up button goes. Leave blank to use your store’s secure Shopify login." },
    { "type": "url", "id": "account_page_url", "label": "Account page (custom dashboard)", "info": "The page with your Dynamic Account section (Wishlist / Reviews). Leave blank to use /pages/account." },

    { "type": "header", "content": "Apps menu (9 dots)" },
    { "type": "checkbox", "id": "show_apps", "label": "Show 9-dots apps menu", "default": true },
    { "type": "text", "id": "apps_title", "label": "Apps menu title", "default": "Apps", "info": "Shown only when the dashboard widgets below are off — the greeting takes its place otherwise." },
    { "type": "header", "content": "Apps window dashboard" },
    { "type": "checkbox", "id": "show_widgets", "label": "Show greeting, clock & weather", "default": true, "info": "Two glass widgets at the top of the 9-dots window: greeting + date, and a live clock with your city's weather (free Open-Meteo service, no key needed)." },
    { "type": "text", "id": "weather_city", "label": "Weather city label", "default": "New York" },
    { "type": "text", "id": "weather_lat", "label": "Latitude", "default": "40.71" },
    { "type": "text", "id": "weather_lon", "label": "Longitude", "default": "-74.01", "info": "Find both on Google Maps: right-click your city, the numbers appear first." },
    { "type": "select", "id": "weather_unit", "label": "Temperature unit", "options": [ { "value": "f", "label": "Fahrenheit" }, { "value": "c", "label": "Celsius" } ], "default": "f" },
    { "type": "textarea", "id": "focus_quotes", "label": "Focus sentences (one per line)", "info": "A random one shows each time the window opens, never repeating until all have had a turn. Leave empty for the built-in set of 18." },
    { "type": "paragraph", "content": "Add “App link” blocks below to fill the grid. With none added, a sensible default set (Shop, Search, Contact, Account, Cart, policies…) shows automatically." },

    { "type": "header", "content": "Bar style" },
    { "type": "checkbox", "id": "overlay", "label": "Float over the page (no row)", "default": true, "info": "Sits on top of the page at the top-right — like the homepage corners — instead of taking its own row. Turn off for a normal bar." },
    { "type": "checkbox", "id": "overlay_follow", "label": "Follow while scrolling (float mode)", "default": true, "info": "Keeps the corner buttons visible in the corners as you scroll down the page." },
    { "type": "checkbox", "id": "peek_scroll", "label": "Hide on scroll down, show on scroll up", "default": true, "info": "The bar slips away while scrolling down and glides back the moment you scroll up. Needs 'Follow while scrolling' on (float mode) or 'Stick to top' (normal bar)." },
    { "type": "range", "id": "overlay_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Distance from top (float mode)", "default": 20, "info": "Match your homepage corner links (they use 20px)." },
    { "type": "range", "id": "overlay_side", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Distance from side (float mode)", "default": 26 },
    { "type": "checkbox", "id": "transparent_bg", "label": "Transparent background (normal bar only)", "default": true },
    { "type": "color", "id": "bar_bg", "label": "Bar background", "default": "#ffffff", "info": "Used when Transparent is off and Float is off." },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top when scrolling (normal bar only)", "default": false }
  ],
  "blocks": [
    { "type": "app_link", "name": "App link", "settings": [
      { "type": "checkbox", "id": "enabled", "label": "Show this link", "default": true, "info": "Uncheck to hide it from the menu without deleting it." },
      { "type": "text", "id": "label", "label": "Name", "default": "App" },
      { "type": "url", "id": "url", "label": "Link", "info": "Leave blank to use the default page for the icon you pick below (Shop→all products, Cart→cart, Account→account, Wishlist→/pages/wishlist, Contact→/pages/contact, About→/pages/about, Blog→/blogs/news, etc.). Type a link here to override it." },
      { "type": "select", "id": "icon", "label": "Icon", "default": "shop",
        "options": [
          { "value": "none", "label": "No icon (show first letter)" },
          { "value": "shop", "label": "Shop / storefront" },
          { "value": "bag", "label": "Shopping bag" },
          { "value": "cart", "label": "Cart" },
          { "value": "search", "label": "Search" },
          { "value": "account", "label": "Account" },
          { "value": "heart", "label": "Wishlist (save icon)" },
          { "value": "mail", "label": "Contact / email" },
          { "value": "phone", "label": "Phone" },
          { "value": "info", "label": "About / info" },
          { "value": "home", "label": "Home" },
          { "value": "gift", "label": "Gift card" },
          { "value": "blog", "label": "Blog / news" },
          { "value": "tag", "label": "Sale / tag" },
          { "value": "star", "label": "Reviews / star" },
          { "value": "location", "label": "Stores / location" },
          { "value": "help", "label": "Help / FAQ" },
          { "value": "instagram", "label": "Instagram" }
        ] },
      { "type": "image_picker", "id": "image", "label": "Custom icon image (optional)", "info": "Overrides the icon above. A small square icon works best." }
    ]}
  ],
  "max_blocks": 20,
  "presets": [ { "name": "Account & apps bar" } ]
}
{% endschema %}
