  <script>
  (function () {
    var root = document.getElementById("dynAbar");
    if (!root) return;

    /* Back button — go to the previous page (e.g. 9-dots: Shop -> FAQ -> back
       lands on Shop). Home is only the fallback for a dead end: the page was
       opened directly and there is nothing to go back to. The timer is
       cancelled the moment the browser actually starts leaving this page, so
       a slow back-navigation is never mistaken for "no history". */
    var HOME = {{ routes.root_url | json }};
    var backBtn = document.getElementById("dynAbarBack");
    if (backBtn) backBtn.addEventListener("click", function () {
      if (history.length <= 1) { location.href = HOME; return; }
      var fallback = setTimeout(function () { location.href = HOME; }, 1500);
      window.addEventListener("pagehide", function () { clearTimeout(fallback); }, { once: true });
      history.back();
    });

    var menus = Array.prototype.slice.call(root.querySelectorAll(".dh-menu"));
    if (!menus.length) return;
    function closeMenus(except) {
      menus.forEach(function (m) {
        if (m === except) return;
        var b = m.querySelector(".dh-icon-btn"), p = m.querySelector(".dh-pop");
        if (p) p.hidden = true; if (b) b.setAttribute("aria-expanded", "false");
      });
    }
    menus.forEach(function (m) {
      var btn = m.querySelector(".dh-icon-btn"), pop = m.querySelector(".dh-pop");
      if (!btn || !pop) return;
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        var willOpen = pop.hidden;
        closeMenus(m);
        pop.hidden = !willOpen;
