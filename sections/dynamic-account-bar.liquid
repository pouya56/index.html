{%- comment -%}
  Account & Apps bar — a slim, standalone header strip that shows ONLY the
  account dropdown and the 9-dots apps menu (top-right), with the same look as
  the homepage hero. Add it to your Header section group (Customize → Header →
  Add section → "Account & apps bar") so it appears on every page. It is fully
  self-contained (its own styles + script), so it doesn't touch your main header.
{%- endcomment -%}

{%- assign ab_bg = 'transparent' -%}
{%- unless section.settings.transparent_bg -%}{%- assign ab_bg = section.settings.bar_bg -%}{%- endunless -%}

{%- comment -%} Hide the back button on the home page (nothing to go back to there). {%- endcomment -%}
{%- assign show_back_btn = section.settings.show_back -%}
{%- if template.name == 'index' and section.settings.back_hide_home -%}{%- assign show_back_btn = false -%}{%- endif -%}

<div class="dyn-abar{% if section.settings.overlay %} is-overlay{% endif %}{% if section.settings.sticky and section.settings.overlay == false %} is-sticky{% endif %}" id="dynAbar">
  <style>
    #shopify-section-{{ section.id }} .dyn-abar { background: {{ ab_bg }}; }
    {%- if section.settings.overlay -%}
    /* Float over the page: pull the whole section out of flow so it takes no row.
       With "Follow while scrolling" on, it's fixed — the corner buttons stay put. */
    #shopify-section-{{ section.id }} { position: {% if section.settings.overlay_follow %}fixed{% else %}absolute{% endif %}; top: 0; left: 0; right: 0; z-index: 60; pointer-events: none; }
    #shopify-section-{{ section.id }} .dyn-abar { background: transparent; }
    #shopify-section-{{ section.id }} .dyn-abar .dh-menu, #shopify-section-{{ section.id }} .dyn-abar .ab-back { pointer-events: auto; }
    /* Match the homepage corner links: 20px from top, 26px from the side. */
    #shopify-section-{{ section.id }} .ab-inner { padding: {{ section.settings.overlay_top | default: 20 }}px {{ section.settings.overlay_side | default: 26 }}px; }
    {%- endif -%}
    {%- if section.settings.peek_scroll -%}
    /* Peek-a-boo: slip away on scroll down, glide back on scroll up. */
    {%- if section.settings.overlay -%}
    /* No will-change here: it would turn the wrapper into the containing
       block for the fixed, screen-centered apps window. */
    #shopify-section-{{ section.id }} { transition: transform 0.3s ease; }
    #shopify-section-{{ section.id }}.ab-peek-hide { transform: translateY(-130%); }
    {%- else -%}
    #shopify-section-{{ section.id }} .dyn-abar.is-sticky { transition: transform 0.3s ease; }
    #shopify-section-{{ section.id }}.ab-peek-hide .dyn-abar.is-sticky { transform: translateY(-130%); }
    {%- endif -%}
    {%- endif -%}
    .dyn-abar {
      --bg: #ffffff; --bg-panel: #f5f5f7;
      --ink: #1d1d1f; --ink-soft: #6e6e73; --ink-faint: #66666b;
      --line: #d2d2d7; --accent: #0071e3; --danger: #c0392b;
      --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      position: relative; font-family: var(--font); -webkit-font-smoothing: antialiased;
    }
    .dyn-abar.is-sticky { position: sticky; top: 0; z-index: 50; }
    .dyn-abar .ab-inner { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 26px; }
    .dyn-abar .ab-l { display: flex; align-items: center; }
    .dyn-abar .ab-r { display: flex; align-items: center; gap: 8px; }
    /* Circular back button (top-left) — liquid glass: frosted fill, etched ring,
       a bright top highlight and a soft under-shadow, like a lens sitting on the page. */
    .dyn-abar .ab-back { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%;
      background: rgba(255,255,255,0.32);
      -webkit-backdrop-filter: blur(16px) saturate(1.5); backdrop-filter: blur(16px) saturate(1.5);
      border: 1px solid rgba(255,255,255,0.65); color: var(--ink); cursor: pointer; padding: 0;
      box-shadow: 0 12px 26px -8px rgba(29,29,31,0.28);
      transition: box-shadow .15s, background .15s, transform .08s; }
    .dyn-abar .ab-back:hover { background: rgba(255,255,255,0.5); box-shadow: 0 18px 34px -10px rgba(29,29,31,0.32); }
    .dyn-abar .ab-back:active { transform: scale(0.95); }
    .dyn-abar .ab-back svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* Account button + apps grid — same glass treatment */
    .dyn-abar .dh-menu { position: relative; display: inline-flex; }
    .dyn-abar .dh-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
      border-radius: 50%; color: var(--ink-soft); cursor: pointer; padding: 0;
      background: rgba(255,255,255,0.32);
      -webkit-backdrop-filter: blur(16px) saturate(1.5); backdrop-filter: blur(16px) saturate(1.5);
      border: 1px solid rgba(255,255,255,0.65);
      box-shadow: 0 10px 22px -7px rgba(29,29,31,0.26);
      transition: background .16s, color .16s, box-shadow .15s; }
    .dyn-abar .dh-icon-btn:hover { background: rgba(255,255,255,0.52); color: var(--ink);
      box-shadow: 0 14px 28px -9px rgba(29,29,31,0.3); }
    /* Browsers without backdrop blur get a clean solid fallback */
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .dyn-abar .ab-back, .dyn-abar .dh-icon-btn { background: rgba(255,255,255,0.88); }
    }
    /* Cartoon eyes: white glossy ovals with big black pupils. The whites
       stay put — the pupils roll inside them (--ex/--ey set by script). */
    .dyn-abar .dh-orb-eyes { display: flex; gap: 6px; align-items: center; justify-content: center;
      position: relative; z-index: 1; }
    .dyn-abar .dh-orb-eye { width: 20px; height: 26px; border-radius: 50%; position: relative;
      display: flex; align-items: center; justify-content: center; overflow: hidden;
      background: linear-gradient(180deg, #ffffff 0%, #f2f4f7 60%, #d9dde4 100%);
      box-shadow: 0 2px 5px rgba(0, 0, 15, 0.35), inset 0 -2px 4px rgba(130, 140, 160, 0.35);
      transition: transform 0.09s ease; }
    /* Each eye has a soft blue eyelid parked above it (clipped by the eye's
       overflow); emotions slide and tilt it into view. */
    .dyn-abar .dh-orb-eye::before { content: ""; position: absolute; left: -14%; right: -14%; top: -84%; height: 84%;
      border-radius: 50%; background: linear-gradient(180deg, #a9c9f7 0%, #7fa9ec 100%);
      box-shadow: 0 1px 3px rgba(30, 60, 120, 0.4); transform: translateY(0); transition: transform 0.3s ease;
      /* Above the pupil — its transform lifts it into the same paint layer. */
      z-index: 2; }
    .dyn-abar .dh-orb-eye::after { content: ""; width: 12px; height: 16px; border-radius: 50%;
      background: radial-gradient(55% 45% at 32% 26%, #4a4a55 0%, #15151c 45%, #060609 100%);
      transform: translate(calc(var(--ex, 0px) * 0.5), calc(var(--ey, 0px) * 0.9));
      transition: transform 0.3s cubic-bezier(0.3, 0.9, 0.3, 1); }
    .dyn-abar .dh-orb-eyes.is-blink .dh-orb-eye { transform: scaleY(0.08); }
    /* Yawn: a long, slow close-hold-open (phones, where he lives more of
       his own life). */
    .dyn-abar .dh-orb-eyes.is-yawn .dh-orb-eye { animation: abYawn 1.1s ease-in-out; }
    .dyn-abar .dh-orb-eyes.is-yawn .dh-orb-eye::before { transform: translateY(45%); }
    /* Playful wink: one lid drops for a beat. */
    .dyn-abar .dh-orb-eyes.is-wink .dh-orb-eye:last-child::before { transform: translateY(96%); transition: transform 0.15s ease; }
    /* Bored: heavy half-lids and sunk pupils while the idle clock runs. */
    .dyn-abar .dh-apps-btn.is-bored .dh-orb-eye::before { transform: translateY(56%); transition: transform 0.6s ease; }
    .dyn-abar .dh-apps-btn.is-bored .dh-orb-eye::after { transform: translate(0, 2px); }
    /* Nervous: jittery wide eyes and a sweat drop — one more punch... */
    .dyn-abar .dh-orb-eyes.is-nervous { animation: abJitter 0.18s linear infinite; }
    @keyframes abJitter { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(0.7px, 0); } }
    .dyn-abar .dh-orb-eyes.is-nervous::after { content: ""; position: absolute; right: -8px; top: -7px;
      width: 6px; height: 8px; border-radius: 50% 50% 50% 50% / 35% 35% 65% 65%;
      background: linear-gradient(180deg, #bfe3ff, #58a6f5); opacity: 0; animation: abSweat 1.5s ease 0.1s; }
    @keyframes abSweat { 0% { opacity: 0; transform: translateY(0); } 25% { opacity: 1; }
      100% { opacity: 0.9; transform: translateY(9px); } }
    /* Pleased (heading to checkout): lids lowered halfway over content
       little smile-arc eyes. */
    .dyn-abar .dh-orb-eyes.is-pleased .dh-orb-eye::before { transform: translateY(52%); }
    .dyn-abar .dh-orb-eyes.is-pleased .dh-orb-eye::after { width: 12px; height: 7px; background: none;
      border: solid #241d38; border-width: 2.5px 2.5px 0 2.5px; border-radius: 50% 50% 0 0 / 100% 100% 0 0;
      transform: translateY(4px); }
    /* Surprised (the Surprise button!): eyes popped wide, pupils shrunk. */
    .dyn-abar .dh-orb-eyes.is-surprised .dh-orb-eye { transform: scale(1.14); }
    .dyn-abar .dh-orb-eyes.is-surprised .dh-orb-eye::after { width: 8px; height: 10px; transform: none; }
    /* Excited (an item was saved): sparkles dance in his pupils while he
       does the same joyful hops. */
    .dyn-abar .dh-apps-btn.is-excited { animation: abHappy 0.85s cubic-bezier(0.3, 1.5, 0.5, 1) 2; }
    .dyn-abar .dh-orb-eyes.is-excited .dh-orb-eye::after { content: "\2726"; display: flex;
      align-items: center; justify-content: center; color: #fff;
      font: 700 9px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      text-shadow: 0 0 5px rgba(255, 255, 255, 0.95);
      animation: abSparkle 0.5s ease-in-out infinite; }
    @keyframes abSparkle { 50% { transform: scale(1.4) rotate(20deg); } }
    /* Shocked: lids flung up and tilted outward, eyes popped wide. */
    .dyn-abar .dh-orb-eyes.is-shocked .dh-orb-eye { transform: scale(1.08); }
    .dyn-abar .dh-orb-eyes.is-shocked .dh-orb-eye:first-child::before { transform: translateY(12%) rotate(-16deg); }
    .dyn-abar .dh-orb-eyes.is-shocked .dh-orb-eye:last-child::before { transform: translateY(12%) rotate(16deg); }
    @keyframes abYawn { 0% { transform: scaleY(1); } 35% { transform: scaleY(0.12); }
      65% { transform: scaleY(0.12); } 100% { transform: scaleY(1); } }
    /* Asleep: lids slide shut, slow breathing, a little "z" floats up. */
    .dyn-abar .dh-apps-btn.is-asleep .dh-orb-eye::before { transform: translateY(94%); transition: transform 0.9s ease; }
    .dyn-abar .dh-apps-btn.is-asleep { animation: abBreathe 3.4s ease-in-out infinite; }
    @keyframes abBreathe { 50% { transform: scale(0.96); } }
    .dyn-abar .dh-apps-btn.is-asleep::after { content: "z"; position: absolute; top: -6px; right: -2px; z-index: 2;
      font: 700 15px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: rgba(255, 255, 255, 0.92); text-shadow: 0 0 8px rgba(160, 120, 255, 0.9);
      pointer-events: none; animation: abZzz 2.3s ease-in-out infinite; }
    @keyframes abZzz { 0% { opacity: 0; transform: translate(0, 6px) scale(0.6); }
      30% { opacity: 1; } 100% { opacity: 0; transform: translate(8px, -13px) scale(1.25); } }
    /* Dizzy: pupils go in circles while the whole head wobbles. */
    .dyn-abar .dh-orb-eyes.is-dizzy .dh-orb-eye::after { animation: abDizzy 0.4s linear infinite; }
    @keyframes abDizzy { 0%, 100% { transform: translate(0, -3.5px); } 25% { transform: translate(3.5px, 0); }
      50% { transform: translate(0, 3.5px); } 75% { transform: translate(-3.5px, 0); } }
    .dyn-abar .dh-apps-btn.is-dizzy { animation: abWobble 0.55s ease-in-out infinite; }
    @keyframes abWobble { 0%, 100% { transform: rotate(0deg); } 25% { transform: rotate(-6deg); } 75% { transform: rotate(6deg); } }
    /* AssistiveTouch-style 9-dots: a floating circle that can be dragged
       anywhere and snaps to the screen edges; the window opens beside it. */
    /* Above everything — cart drawers, modals, theme popups all stack
       below him (he's re-homed to the end of <body>, so he wins ties too). */
    .dyn-abar .dh-apps-menu { position: fixed; top: 12px; right: 12px; z-index: 2147483646;
      transition: left 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.05), top 0.22s ease; }
    .dyn-abar .dh-apps-menu.is-dragging { transition: none; }
    /* A dark glossy orb with purple and teal glow around the rim, like a
       little face — the eyes above look around and blink. */
    .dyn-abar .dh-apps-btn { width: 64px; height: 64px; border-radius: 50%; cursor: grab;
      /* touch-action lives HERE, not on the wrapper — the apps window is
         inside the wrapper and needs touch scrolling to work on phones. */
      touch-action: none;
      position: relative; overflow: visible; z-index: 1; color: #fff;
      --orb-bg:
        radial-gradient(85% 85% at 68% 76%, rgba(178, 108, 255, 0.4), rgba(178, 108, 255, 0) 58%),
        radial-gradient(75% 75% at 22% 72%, rgba(88, 216, 228, 0.28), rgba(88, 216, 228, 0) 55%),
        radial-gradient(90% 90% at 32% 18%, rgba(130, 150, 255, 0.2), rgba(130, 150, 255, 0) 50%),
        radial-gradient(120% 120% at 50% 38%, #24242e 0%, #0d0d14 72%);
      background: var(--orb-bg);
      border: 2px solid rgba(165, 165, 190, 0.4);
      box-shadow: 0 0 26px rgba(150, 110, 255, 0.4), 0 14px 30px -10px rgba(0, 0, 0, 0.55),
        inset 0 0 16px rgba(160, 120, 255, 0.22), inset 0 2px 6px rgba(255, 255, 255, 0.14); }
    /* Never white: the generic icon-button hover swaps in a frosty white
       background — re-assert his own body. */
    .dyn-abar .dh-apps-btn:hover { color: #fff; background: var(--orb-bg);
      box-shadow: 0 0 34px rgba(160, 120, 255, 0.55), 0 16px 34px -10px rgba(0, 0, 0, 0.6),
        inset 0 0 16px rgba(160, 120, 255, 0.28), inset 0 2px 6px rgba(255, 255, 255, 0.14); }
    .dyn-abar .dh-apps-btn:active { cursor: grabbing; }
    /* Clicking him lands like a punch: hard squash, knocked sideways, a
       springy recover with his eyes screwed shut — and only then does the
       window open. */
    .dyn-abar .dh-apps-btn.is-punched { animation: abPunch 0.45s cubic-bezier(0.3, 1.4, 0.5, 1); }
    @keyframes abPunch {
      0% { transform: scale(1); }
      18% { transform: scale(0.72, 0.6) rotate(-8deg) translateY(5px); }
      45% { transform: scale(1.12, 0.92) rotate(5deg) translateY(-3px); }
      70% { transform: scale(0.95, 1.05) rotate(-2deg); }
      100% { transform: scale(1); }
    }
    /* Pain after punch: droopy lids, one bloodshot wide eye with a dilated
       pupil, one purple-bruised eye squeezed to a wince line. */
    .dyn-abar .dh-orb-eyes.is-dazed .dh-orb-eye::before { transform: translateY(34%); }
    .dyn-abar .dh-orb-eyes.is-dazed .dh-orb-eye:first-child {
      background:
        radial-gradient(4px 1.2px at 30% 72%, rgba(224, 70, 70, 0.6), transparent 75%),
        radial-gradient(5px 1.4px at 72% 62%, rgba(224, 70, 70, 0.55), transparent 75%),
        radial-gradient(4px 1.2px at 52% 86%, rgba(224, 70, 70, 0.5), transparent 75%),
        linear-gradient(180deg, #ffffff 0%, #f6eaea 60%, #ecd9d9 100%); }
    .dyn-abar .dh-orb-eyes.is-dazed .dh-orb-eye:first-child::after { width: 14px; height: 18px; }
    .dyn-abar .dh-orb-eyes.is-dazed .dh-orb-eye:last-child {
      background: radial-gradient(120% 120% at 35% 30%, #9a86c9 0%, #6d5a9e 55%, #55447f 100%);
      box-shadow: 0 2px 5px rgba(0, 0, 15, 0.35), inset 0 -2px 4px rgba(40, 25, 70, 0.5); }
    .dyn-abar .dh-orb-eyes.is-dazed .dh-orb-eye:last-child::after {
      width: 12px; height: 3px; border-radius: 2px; background: #241d38; transform: rotate(-10deg); }
    /* Cool (a design was added): sunglasses — dark lenses with a glint,
       joined by a bridge — and a smug little settle. */
    .dyn-abar .dh-apps-btn.is-cool { animation: abCoolIn 0.5s cubic-bezier(0.3, 1.4, 0.5, 1); }
    @keyframes abCoolIn { 0% { transform: translateY(-5px) scale(1.04); } 100% { transform: translateY(0) scale(1); } }
    /* Real black frames worn low across both eyes, whites peeking over the
       top under confident little black brows, and a gold glint dancing on
       the right lens. */
    .dyn-abar .dh-orb-eyes.is-cool .dh-orb-eye::before { top: -6%; left: 5%; right: 5%; height: 28%;
      background: #17171c; border-radius: 50%; box-shadow: none; transform: rotate(-14deg); }
    .dyn-abar .dh-orb-eyes.is-cool .dh-orb-eye:last-child::before { transform: rotate(14deg); }
    .dyn-abar .dh-apps-btn.is-cool::after { content: "\2726"; position: absolute; right: 4px; top: 21px; z-index: 3;
      color: #ffd452; font: 700 14px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      text-shadow: 0 0 7px rgba(255, 200, 60, 0.95); pointer-events: none;
      animation: abGlint 1.1s ease-in-out infinite; }
    @keyframes abGlint { 0%, 100% { transform: scale(0.8) rotate(0deg); opacity: 0.85; }
      50% { transform: scale(1.3) rotate(20deg); opacity: 1; } }
    .dyn-abar .dh-orb-eyes.is-cool::before, .dyn-abar .dh-orb-eyes.is-cool::after { content: "";
      position: absolute; z-index: 3; top: 42%; width: 20px; height: 14px;
      border: 3px solid #16161b; border-radius: 5px 5px 8px 8px;
      background: linear-gradient(160deg, #34343d 0%, #0e0e13 65%);
      box-shadow: inset 1.5px 1.5px 2.5px rgba(255, 255, 255, 0.16), 0 2px 5px rgba(0, 0, 10, 0.45);
      opacity: 1; animation: none; transform: none; }
    .dyn-abar .dh-orb-eyes.is-cool::before { left: -3px; right: auto; }
    .dyn-abar .dh-orb-eyes.is-cool::after { right: -3px; }
    /* Angry: furrowed slanted glare, red heat, trembling with rage. */
    .dyn-abar .dh-apps-btn.is-angry { animation: abRage 0.28s linear infinite;
      border-color: rgba(255, 105, 95, 0.65);
      box-shadow: 0 0 30px rgba(255, 60, 50, 0.55), 0 14px 30px -10px rgba(0, 0, 0, 0.55),
        inset 0 0 18px rgba(255, 70, 60, 0.42), inset 0 2px 6px rgba(255, 255, 255, 0.1); }
    @keyframes abRage { 0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(-1.5px, 1px) rotate(-2deg); }
      50% { transform: translate(1.5px, -1px) rotate(2deg); }
      75% { transform: translate(-1px, -1px) rotate(-1deg); } }
    .dyn-abar .dh-orb-eyes.is-angry .dh-orb-eye { transform: scaleY(0.84); }
    .dyn-abar .dh-orb-eyes.is-angry .dh-orb-eye:first-child::before { transform: translateY(48%) rotate(24deg); }
    .dyn-abar .dh-orb-eyes.is-angry .dh-orb-eye:last-child::before { transform: translateY(48%) rotate(-24deg); }
    .dyn-abar .dh-orb-eyes.is-angry .dh-orb-eye::after { transform: translate(0, 1px); }
    /* Happy (something added to the cart): joyful hops, smiling squeezed
       eyes, a little heart floats off him. */
    .dyn-abar .dh-apps-btn.is-happy { animation: abHappy 0.85s cubic-bezier(0.3, 1.5, 0.5, 1) 2; }
    @keyframes abHappy { 0%, 100% { transform: translateY(0) scale(1); }
      30% { transform: translateY(-8px) scale(1.06, 0.94); }
      60% { transform: translateY(0) scale(0.97, 1.03); } }
    .dyn-abar .dh-orb-eyes.is-happy .dh-orb-eye::after { content: "\2665"; width: auto; height: auto; background: none;
      font: 700 15px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #ff5ea8;
      text-shadow: 0 0 6px rgba(255, 94, 168, 0.65); transform: none; animation: abLove 0.7s ease-in-out infinite; }
    @keyframes abLove { 50% { transform: scale(1.3); } }
    .dyn-abar .dh-apps-btn.is-happy::after { content: "\2665"; position: absolute; top: -6px; right: -2px; z-index: 2;
      font: 700 15px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #ff5ea8; text-shadow: 0 0 8px rgba(255, 94, 168, 0.85);
      pointer-events: none; animation: abZzz 0.95s ease-in-out 2; }
    /* Sad (something removed): he deflates and droops, eyes slant down,
       pupils sink, one tear slides off. */
    .dyn-abar .dh-apps-btn.is-sad { animation: abSad 2.6s ease; }
    @keyframes abSad { 0% { transform: translateY(0) scale(1); }
      20% { transform: translateY(3px) scale(0.97); }
      80% { transform: translateY(3px) scale(0.97); }
      100% { transform: translateY(0) scale(1); } }
    .dyn-abar .dh-orb-eyes.is-sad .dh-orb-eye:first-child::before { transform: translateY(50%) rotate(-15deg); }
    .dyn-abar .dh-orb-eyes.is-sad .dh-orb-eye:last-child::before { transform: translateY(50%) rotate(15deg); }
    .dyn-abar .dh-orb-eyes.is-sad .dh-orb-eye::after { transform: translate(0, 3px); }
    .dyn-abar .dh-orb-eyes.is-sad::before { content: ""; position: absolute; right: 3px; top: 14px; z-index: 2;
      width: 5px; height: 7px; border-radius: 50% 50% 50% 50% / 38% 38% 62% 62%;
      background: linear-gradient(180deg, #9fd8ff, #4f8cff); opacity: 0;
      animation: abTear 2s ease-in 0.35s; }
    @keyframes abTear { 0% { opacity: 0; transform: translateY(0); }
      18% { opacity: 1; } 100% { opacity: 0; transform: translateY(17px); } }
    /* Siri ring: a thin rainbow band spinning around the tray's edge.
       The gradient angle animates (not the element — rotating a square mask
       would poke through the corners). */
    @property --abA { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
    .dyn-abar .dh-apps-btn::before { content: ""; display: none; position: absolute; inset: -3px; border-radius: 50%;
      z-index: -1; pointer-events: none; padding: 3px;
      background: conic-gradient(from var(--abA), #4f8cff, #a06bff, #ff5ea8, #ff9d5e, #5edfff, #4f8cff);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude;
      animation: abSiri 3s linear infinite; }
    @supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
      .dyn-abar .dh-apps-btn::before { display: block; }
