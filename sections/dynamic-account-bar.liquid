      if (!pop.getAttribute("data-vtab")) pop.setAttribute("data-vtab", "widgets");
      pop.style.left = ""; pop.style.right = ""; pop.style.top = ""; pop.style.bottom = "";
      pop.style.width = ""; pop.style.maxHeight = ""; pop.style.height = "";
      pop.style.transform = ""; pop.style.animation = "";
      var br2 = btn.getBoundingClientRect();
      vbar.classList.add("is-on");
      var bw = vbar.offsetWidth, bh = vbar.offsetHeight;
      /* The bar stands beside him — on whichever side faces the screen
         center — vertically centered on the orb. */
      var orbLeftHalf = br2.left + br2.width / 2 < innerWidth / 2;
      var bx = orbLeftHalf ? br2.right + 14 : br2.left - 14 - bw;
      var by = br2.top + br2.height / 2 - bh / 2;
      vbar.style.left = Math.round(Math.min(Math.max(12, bx), innerWidth - bw - 12)) + "px";
      vbar.style.top = Math.round(Math.min(Math.max(12, by), innerHeight - bh - 12)) + "px";
      paintVision();
    });
    /* Position the active tab's window beside the bar, toward the screen
       center, vertically aligned with the bar. */
    function paintVision() {
      var tab = pop.getAttribute("data-vtab") || "widgets";
      Array.prototype.forEach.call(vbar.children, function (c) {
        c.classList.toggle("is-on", c.getAttribute("data-vtab") === tab);
      });
      var app = tab.indexOf("app-") === 0 ? vApps[parseInt(tab.slice(4), 10)] : null;
      var rev = tab === "reviews" && vRev ? { href: vRev, ext: false } : null;
      var isSaved = tab === "saved", isCart = tab === "cart";
      var page = app || rev;
      /* The page-pill strip rides on top only for the Apps tabs. */
      ptabs.hidden = !(tab === "apps" || app);
      Array.prototype.forEach.call(ptabs.children, function (c) {
        c.classList.toggle("is-on", c.getAttribute("data-vtab") === tab);
      });
      vprev.hidden = !page;
      vgrid.hidden = !(isSaved || isCart);
      vgo.hidden = !(isSaved || isCart);
      pop.classList.toggle("is-preview", !!page || isSaved || isCart);
      if (isSaved) {
        vgrid.setAttribute("data-kind", "saved");
        vgo.setAttribute("href", "/pages/wishlist");
        var wl = [];
        try { wl = JSON.parse(localStorage.getItem("dyn_wishlist") || "[]") || []; } catch (eW) {}
        vFill(wl.map(function (x) {
          return { url: x.url, image: x.image, title: x.title, price: x.price, del: x.id };
        }), "Nothing saved yet \u2014 tap the bookmark on any product to keep it here.", "/pages/wishlist");
      } else if (isCart) {
        vgrid.setAttribute("data-kind", "cart");
        vgo.setAttribute("href", {{ routes.cart_url | json }});
        vgrid.innerHTML = "";
        fetch("/cart.js", { credentials: "same-origin" }).then(function (rC) { return rC.json(); }).then(function (c) {
          if (pop.getAttribute("data-vtab") !== "cart" || pop.hidden) return;
          var items = ((c && c.items) || []).map(function (it) {
            return { url: it.url, image: it.image, del: it.key,
              title: (it.product_title || "Product") + (it.quantity > 1 ? " \u00d7 " + it.quantity : "") };
          });
          vFill(items, "Your cart is empty.", {{ routes.cart_url | json }});
        }).catch(function () { vFill([], "Your cart is empty.", {{ routes.cart_url | json }}); });
      }
      if (page) {
        vprev.querySelector(".dh-vprev-open").setAttribute("href", page.href);
        var hold = vprev.querySelector(".dh-vprev-hold");
        var extN = vprev.querySelector(".dh-vprev-ext");
        hold.hidden = !!page.ext;
        extN.hidden = !page.ext;
        /* The page's ACTUAL content, live in the glass: fetch the page,
           lift its <main> (styles included, scripts stripped) and inject
           it — forms are the real forms and submit normally. */
        if (!page.ext && vprev.getAttribute("data-url") !== page.href) {
          vprev.setAttribute("data-url", page.href);
          /* No loading flash — the pane stays quiet until the page lands. */
          hold.innerHTML = "";
          fetch(page.href, { credentials: "same-origin" }).then(function (r2) { return r2.text(); }).then(function (htm) {
            if (vprev.getAttribute("data-url") !== page.href) return;
            var doc = new DOMParser().parseFromString(htm, "text/html");
            var main = doc.querySelector("main, #MainContent") || doc.body;
            hold.innerHTML = main.innerHTML;
            /* Give the page its life back: innerHTML-inserted scripts don't
               run, so re-create each one in place — buttons, accordions and
               galleries inside the window then actually work. JSON data
               blocks stay inert. */
            Array.prototype.slice.call(hold.querySelectorAll("script")).forEach(function (sc) {
              var ty = (sc.getAttribute("type") || "text/javascript").toLowerCase();
              if (ty.indexOf("json") !== -1 || ty.indexOf("template") !== -1) return;
              var ns = document.createElement("script");
              Array.prototype.forEach.call(sc.attributes, function (at) { ns.setAttribute(at.name, at.value); });
              ns.text = sc.text || "";
              if (sc.parentNode) sc.parentNode.replaceChild(ns, sc);
            });
            /* Dark story sections switch to their light theme on the glass. */
            Array.prototype.forEach.call(hold.querySelectorAll(".dynaeimic-story"), function (el) {
              el.classList.add("ds-theme-light");
            });
            /* Deep-linked tabs (?tab=...) activate inside the window — the
               page's own script reads the browser URL, which is still the
               page we're standing on. */
            var mT = (page.href.match(/[?&]tab=([^&#]+)/) || [])[1];
            if (mT) {
              Array.prototype.forEach.call(hold.querySelectorAll(".da-tab"), function (tEl) {
                tEl.classList.toggle("is-active", tEl.getAttribute("data-tab") === mT);
              });
              Array.prototype.forEach.call(hold.querySelectorAll(".da-panel"), function (pn) {
                pn.classList.toggle("is-active", pn.getAttribute("data-panel") === mT);
              });
            }
            paintVision();
          }).catch(function () {
            hold.innerHTML = '<div class="dh-vload">Couldn\u2019t load the page \u2014 use Open page.</div>';
          });
        }
      }
      var vb = vbar.getBoundingClientRect();
      var pw = pop.offsetWidth || 560;
      var onLeft = vb.left + vb.width / 2 < innerWidth / 2;
      pop.style.left = onLeft
        ? Math.round(vb.right + 16) + "px"
        : Math.round(Math.max(16, vb.left - 16 - pw)) + "px";
      var ph2 = pop.offsetHeight;
      pop.style.top = Math.round(Math.min(Math.max(16, vb.top + vb.height / 2 - ph2 / 2), innerHeight - ph2 - 16)) + "px";
    }
    vbar.addEventListener("click", function (e) {
      e.stopPropagation();
      var t = e.target.closest ? e.target.closest(".dh-vtab") : null;
      if (!t || pop.hidden) return;
      var tid = t.getAttribute("data-vtab");
      /* The person icon is a door: profile on Shopify's site when signed
         in, secure login when signed out. */
      if (tid === "account") { location.href = vCust ? vProf : vLogin; return; }
      if (tid.indexOf("app-") === 0) {
        var tap = vApps[parseInt(tid.slice(4), 10)];
        /* Home is a plain door — no window, just go. */
        if (tap && tap.home) { location.href = tap.href; return; }
      }
      pop.setAttribute("data-vtab", tid);
      paintVision();
    });
    /* In the Apps grid, selecting an app opens its page in this same glass
       window (home and outside links navigate normally). */
    pop.addEventListener("click", function (e) {
      if (!pop.classList.contains("is-vision")) return;
      var a = e.target.closest ? e.target.closest(".dh-apps-grid .dh-app") : null;
      if (!a) return;
      var i = vAllApps.indexOf(a);
      if (i < 0) return;
      var ap = vApps[i];
      if (!ap || ap.home || ap.ext) return;
      e.preventDefault();
      pop.setAttribute("data-vtab", "app-" + i);
      paintVision();
    });

  })();
  </script>
</div>

{% schema %}
{
  "name": "Account & apps bar",
  "tag": "section",
  "class": "dynamic-account-bar-section",
  "settings": [
    { "type": "paragraph", "content": "A slim bar with a back button (top-left) plus the account menu and 9-dots apps menu (top-right), matching your homepage look. Add it to your Header group so it shows on every page." },

    { "type": "header", "content": "Back button" },
    { "type": "checkbox", "id": "show_back", "label": "Show back button (top-left)", "default": true, "info": "A round ‘←’ button that returns to the previous page — or your home page if there isn’t one." },
    { "type": "checkbox", "id": "back_hide_home", "label": "Hide it on the home page", "default": true, "info": "Recommended — the home page has no ‘previous’ page, and it would overlap the corner links there." },

    { "type": "header", "content": "Account menu" },
    { "type": "checkbox", "id": "show_account", "label": "Show account menu", "default": true },
    { "type": "image_picker", "id": "account_avatar", "label": "Avatar photo (optional)", "info": "Shown instead of the person icon. A single store-wide photo; each shopper’s own uploaded photo (from the account page) shows automatically on their device." },
    { "type": "url", "id": "login_url", "label": "Log in link", "info": "Where the Log in / Sign up button goes. Leave blank to use your store’s secure Shopify login." },
    { "type": "url", "id": "account_page_url", "label": "Account page (custom dashboard)", "info": "The page with your Dynamic Account section (Wishlist / Reviews). Leave blank to use /pages/account." },

    { "type": "header", "content": "Apps menu (9 dots)" },
    { "type": "checkbox", "id": "show_apps", "label": "Show 9-dots apps menu", "default": true },
    { "type": "text", "id": "apps_title", "label": "Apps menu title", "default": "Apps", "info": "Shown only when the dashboard widgets below are off — the greeting takes its place otherwise." },
    { "type": "header", "content": "Apps window dashboard" },
    { "type": "checkbox", "id": "show_widgets", "label": "Show greeting, clock & widgets", "default": true, "info": "The dashboard at the top of the 9-dots window: greeting + date, live analog clock, a rotating focus line, and the visitor's saved items." },
    { "type": "textarea", "id": "focus_quotes", "label": "Focus sentences (one per line)", "info": "A random one shows each time the window opens, never repeating until all have had a turn. Leave empty for the built-in set of 18." },
    { "type": "paragraph", "content": "Add “App link” blocks below to fill the grid. With none added, a sensible default set (Shop, Search, Contact, Account, Cart, policies…) shows automatically." },

    { "type": "header", "content": "Bar style" },
    { "type": "checkbox", "id": "overlay", "label": "Float over the page (no row)", "default": true, "info": "Sits on top of the page at the top-right — like the homepage corners — instead of taking its own row. Turn off for a normal bar." },
    { "type": "checkbox", "id": "overlay_follow", "label": "Follow while scrolling (float mode)", "default": true, "info": "Keeps the corner buttons visible in the corners as you scroll down the page." },
    { "type": "checkbox", "id": "peek_scroll", "label": "Hide on scroll down, show on scroll up", "default": true, "info": "The bar slips away while scrolling down and glides back the moment you scroll up. Needs 'Follow while scrolling' on (float mode) or 'Stick to top' (normal bar)." },
    { "type": "range", "id": "overlay_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Distance from top (float mode)", "default": 20, "info": "Match your homepage corner links (they use 20px)." },
    { "type": "range", "id": "overlay_side", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Distance from side (float mode)", "default": 26 },
    { "type": "checkbox", "id": "transparent_bg", "label": "Transparent background (normal bar only)", "default": true },
    { "type": "color", "id": "bar_bg", "label": "Bar background", "default": "#ffffff", "info": "Used when Transparent is off and Float is off." },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top when scrolling (normal bar only)", "default": false }
  ],
  "blocks": [
    { "type": "app_link", "name": "App link", "settings": [
      { "type": "checkbox", "id": "enabled", "label": "Show this link", "default": true, "info": "Uncheck to hide it from the menu without deleting it." },
      { "type": "text", "id": "label", "label": "Name", "default": "App" },
      { "type": "url", "id": "url", "label": "Link", "info": "Leave blank to use the default page for the icon you pick below (Shop→all products, Cart→cart, Account→account, Wishlist→/pages/wishlist, Contact→/pages/contact, About→/pages/about, Blog→/blogs/news, etc.). Type a link here to override it." },
      { "type": "select", "id": "icon", "label": "Icon", "default": "shop",
        "options": [
          { "value": "none", "label": "No icon (show first letter)" },
          { "value": "shop", "label": "Shop / storefront" },
          { "value": "bag", "label": "Shopping bag" },
          { "value": "cart", "label": "Cart" },
          { "value": "search", "label": "Search" },
          { "value": "account", "label": "Account" },
          { "value": "heart", "label": "Wishlist (save icon)" },
          { "value": "mail", "label": "Contact / email" },
          { "value": "phone", "label": "Phone" },
          { "value": "info", "label": "About / info" },
          { "value": "home", "label": "Home" },
          { "value": "gift", "label": "Gift card" },
          { "value": "blog", "label": "Blog / news" },
          { "value": "tag", "label": "Sale / tag" },
          { "value": "star", "label": "Reviews / star" },
          { "value": "location", "label": "Stores / location" },
          { "value": "help", "label": "Help / FAQ" },
          { "value": "instagram", "label": "Instagram" }
        ] },
      { "type": "image_picker", "id": "image", "label": "Custom icon image (optional)", "info": "Overrides the icon above. A small square icon works best." }
    ]}
  ],
  "max_blocks": 20,
  "presets": [ { "name": "Account & apps bar" } ]
}
{% endschema %}
