        if (ab) { ab.innerHTML = '<img class="dh-avatar" src="' + av + '" alt="Account">'; }
      }
    } catch (e) {}
  })();
  {%- if section.settings.show_widgets -%}
  (function () {
    /* Apps-window dashboard: live clock + greeting, focus line, saved items. */
    var head = document.getElementById("dynAbWidgets");
    if (!head) return;
    var elGreet = document.getElementById("dynAbGreet"), elDay = document.getElementById("dynAbDay"),
        elDate = document.getElementById("dynAbDate");
    var DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    var MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    /* Apple-style analog face: 60 ticks (long black on the hours, short gray
       between), built once; hands rotate every second, orange seconds hand. */
    var ticksG = document.getElementById("dynAbTicks");
    if (ticksG) {
      var NS = "http://www.w3.org/2000/svg", t = "";
      for (var ti = 0; ti < 60; ti++) {
        var a = ti * 6 * Math.PI / 180, hourTick = ti % 5 === 0;
        var r1 = hourTick ? 74 : 84, r2 = 92;
        t += '<line x1="' + (100 + r1 * Math.sin(a)).toFixed(1) + '" y1="' + (100 - r1 * Math.cos(a)).toFixed(1) +
             '" x2="' + (100 + r2 * Math.sin(a)).toFixed(1) + '" y2="' + (100 - r2 * Math.cos(a)).toFixed(1) +
             '" stroke="' + (hourTick ? "#1d1d1f" : "#b9b9be") + '" stroke-width="' + (hourTick ? 3 : 2) + '" stroke-linecap="round"/>';
      }
      ticksG.innerHTML = t;
    }
    var gHr = document.getElementById("dynAbHr"), gMin = document.getElementById("dynAbMin"), gSec = document.getElementById("dynAbSec");
    function tick() {
      var d = new Date(), h = d.getHours(), mm = d.getMinutes(), ss = d.getSeconds();
      elGreet.textContent = h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
      elDay.textContent = DAYS[d.getDay()];
      elDate.textContent = d.getDate() + " " + MONTHS[d.getMonth()] + ", " + d.getFullYear();
      if (gHr) gHr.setAttribute("transform", "rotate(" + (((h % 12) + mm / 60) * 30).toFixed(2) + " 100 100)");
      if (gMin) gMin.setAttribute("transform", "rotate(" + ((mm + ss / 60) * 6).toFixed(2) + " 100 100)");
      if (gSec) gSec.setAttribute("transform", "rotate(" + (ss * 6) + " 100 100)");
    }
    tick();
    setInterval(tick, 1000);
    /* Focus card: a fresh motivation line on every open. Merchant lines from
       the settings (one per line) win; otherwise the built-in list. A shuffle
       bag guarantees no repeat until every line has had its turn. */
    var elFocus = document.getElementById("dynAbFocus");
    var Q = [];
    var qRaw = {{ section.settings.focus_quotes | default: '' | json }};
    if (qRaw) { Q = qRaw.split("\n").map(function (s) { return s.trim(); }).filter(Boolean); }
    if (!Q.length) {
      Q = ["Stay calm, stay positive.", "Make something you love today.", "Small steps, big smiles.",
        "You're doing better than you think.", "Create more, worry less.", "Today is a good day to start.",
        "Kindness looks good on you.", "Progress, not perfection.", "Your ideas deserve the spotlight.",
        "Good things take time — keep going.", "Collect moments, not things.", "Be the reason someone smiles today.",
        "Enjoy the little things.", "You bring the magic.", "Keep it simple, keep it true.",
        "Turn ideas into keepsakes.", "Every day is a fresh design.", "Stay curious, stay playful."];
    }
    var qBag = [];
    function pickQuote() {
      if (!elFocus || !Q.length) return;
      if (!qBag.length) { qBag = Q.slice(); for (var i = qBag.length - 1; i > 0; i--) { var r = Math.floor(Math.random() * (i + 1)), t = qBag[i]; qBag[i] = qBag[r]; qBag[r] = t; } }
      elFocus.textContent = qBag.pop();
    }
    pickQuote();
    /* Saved & Cart previews: one-square carousels with dots (latest first for
