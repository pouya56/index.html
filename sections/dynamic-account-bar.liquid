  {%- if section.settings.peek_scroll -%}
  (function () {
    /* Hide on scroll down, show on scroll up. Always visible near the top,
       and it never hides while one of its menus is open. */
    var bar = document.getElementById("dynAbar");
    if (!bar) return;
    var wrap = bar.closest('[id^="shopify-section-"]') || bar.parentElement || bar;
    var lastY = window.pageYOffset || 0;
    window.addEventListener("scroll", function () {
      var y = window.pageYOffset || 0;
      var d = y - lastY;
      lastY = y;
      if (bar.querySelector(".dh-pop:not([hidden])")) return;
      if (y < 90) { wrap.classList.remove("ab-peek-hide"); return; }
      if (d > 2) { wrap.classList.add("ab-peek-hide"); }
      else if (d < -2) { wrap.classList.remove("ab-peek-hide"); }
    }, { passive: true });
  })();
