      });
      head.addEventListener("dragover", function (e) {
        if (!dragEl) return;
        e.preventDefault();
        var t = e.target.closest ? e.target.closest("[data-wid]") : null;
        if (!t || t === dragEl) return;
        if (dragEl.compareDocumentPosition(t) & Node.DOCUMENT_POSITION_FOLLOWING) { t.after(dragEl); } else { t.before(dragEl); }
      });
      head.addEventListener("drop", function (e) { e.preventDefault(); });
      head.addEventListener("dragend", function () {
        if (dragEl) dragEl.classList.remove("is-drag");
        dragEl = null;
        var ids = [], ws = head.querySelectorAll("[data-wid]");
        for (var k = 0; k < ws.length; k++) ids.push(ws[k].getAttribute("data-wid"));
        try { localStorage.setItem(ORDER_KEY, JSON.stringify(ids)); } catch (e2) {}
      });
    })();
    var apBtn = document.querySelector(".dyn-abar .dh-apps-btn");
    if (apBtn) { apBtn.addEventListener("click", function () { pickQuote(); renderSaved(); loadCart(); }); }
  })();
  {%- endif -%}
  (function () {
    /* App tiles rearrange exactly like the widgets: drag one over another and
       they trade places; the order is remembered per browser. */
    var grid = document.querySelector(".dyn-abar .dh-apps-grid");
    if (!grid) return;
    var KEY = "dyn_app_order", i;
    try {
      var ord = JSON.parse(localStorage.getItem(KEY) || "null");
      if (ord && ord.length) {
        for (i = 0; i < ord.length; i++) {
          var el = grid.querySelector('[data-aid="' + ord[i] + '"]');
