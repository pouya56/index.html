    function zones() {
      /* Things the circle must not cover: corner links, back button,
         avatar, copyright — measured live on whatever page we're on. */
      var out = [];
      document.querySelectorAll(".dyn-abar .ab-l, .dyn-abar .ab-r, .dh-corner-group, .dh-copyright").forEach(function (el) {
        var r = el.getBoundingClientRect();
        if (r.width > 4 && r.height > 4) out.push(r);
      });
      return out;
    }
    function hitZone(x, y, w, h, rs) {
      for (var i = 0; i < rs.length; i++) {
        var r = rs[i];
        if (x < r.right + 10 && x + w > r.left - 10 && y < r.bottom + 10 && y + h > r.top - 10) return r;
      }
      return null;
    }
    function avoid(x, y, w, h, axis) {
      /* Slide along the edge until clear of any protected element. Only
         moves in directions that actually fit on screen; if the edge is
         blocked at a dead end, steps off-axis past the blocker instead. */
      var rs = zones();
      for (var pass = 0; pass < 4; pass++) {
        var hit = hitZone(x, y, w, h, rs);
        if (!hit) break;
        if (axis === "x") {
          var lx = hit.left - w - 12, rx = hit.right + 12;
          var lok = lx >= 12, rok = rx <= innerWidth - w - 12;
          if (lok && (!rok || Math.abs(lx - x) <= Math.abs(rx - x))) x = lx;
          else if (rok) x = rx;
          else y = (hit.bottom + 12 <= innerHeight - h - 12) ? hit.bottom + 12 : Math.max(12, hit.top - h - 12);
        } else {
          var uy = hit.top - h - 12, dy = hit.bottom + 12;
          var uok = uy >= 12, dok = dy <= innerHeight - h - 12;
          if (uok && (!dok || Math.abs(uy - y) <= Math.abs(dy - y))) y = uy;
          else if (dok) y = dy;
          else x = (hit.right + 12 <= innerWidth - w - 12) ? hit.right + 12 : Math.max(12, hit.left - w - 12);
        }
      }
      return { x: x, y: y };
    }
    function place(x, y, snap) {
