    var dragEl = null;
    grid.addEventListener("dragstart", function (e) {
      var t = e.target.closest ? e.target.closest(".dh-app") : null;
      if (!t) return;
      dragEl = t; t.classList.add("is-drag");
      try { e.dataTransfer.setData("text/plain", t.getAttribute("data-aid") || ""); e.dataTransfer.effectAllowed = "move"; } catch (err) {}
    });
    grid.addEventListener("dragover", function (e) {
      if (!dragEl) return;
      e.preventDefault();
