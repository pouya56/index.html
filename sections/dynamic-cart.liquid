    { "type": "text", "id": "continue_label", "label": "Continue-shopping label", "default": "Continue shopping" },
    { "type": "url", "id": "continue_link", "label": "Continue-shopping link", "info": "Leave empty to link to all products." },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Estimated total" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button label", "default": "Check out" },
    { "type": "url", "id": "precheckout_url", "label": "Show suggestion page before checkout (URL)", "info": "Optional. Paste your 'Dynamic Suggest' page URL (e.g. /pages/style) to show accessories after Check out is clicked, before the real checkout. Leave empty to go straight to checkout." },
    { "type": "text", "id": "tax_note", "label": "Fine print under the total", "default": "Taxes, discounts and shipping calculated at checkout." },
