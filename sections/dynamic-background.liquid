{%- comment -%}
  Dynamic Background — an animated wallpaper that sits BEHIND the whole page.
  Two looks:
   - "Soft color glows": three pale glows drift slowly, like light through water.
   - "Sunlight & shadow": a painted wall with warm window light falling across
     it — bright diagonal panes, soft shadow in the corners.
  Pure CSS: nothing to download. Add the section anywhere on a page (top or
  bottom, it doesn't matter — it pins itself behind everything).
{%- endcomment -%}

{%- assign look = section.settings.look | default: 'glow' -%}
{%- assign bg_alpha = section.settings.strength | divided_by: 100.0 -%}
{%- assign c1 = section.settings.color_1 | color_modify: 'alpha', bg_alpha -%}
{%- assign c2 = section.settings.color_2 | color_modify: 'alpha', bg_alpha -%}
{%- assign c3 = section.settings.color_3 | color_modify: 'alpha', bg_alpha -%}
{%- assign sun_a = section.settings.strength | times: 2.2 | divided_by: 100.0 | at_most: 0.8 -%}
{%- assign shade_a = section.settings.strength | times: 1.5 | divided_by: 100.0 | at_most: 0.5 -%}
{%- assign spd = section.settings.speed -%}
{%- assign spd2 = spd | times: 1.35 | round -%}
{%- assign spd3 = spd | times: 1.7 | round -%}
{%- comment -%} Live weather: strength doubles as vividness — 40% shows the
   full Apple-style sky, lower values lay a white veil over it. {%- endcomment -%}
{%- assign veil_num = 40 | minus: section.settings.strength -%}
{%- if veil_num < 0 -%}{%- assign veil_num = 0 -%}{%- endif -%}
{%- assign veil_o = veil_num | divided_by: 44.0 -%}

<div class="dyn-bg" id="dynBg-{{ section.id }}" aria-hidden="true"
  {%- if look == 'weather' %} data-lat="{{ section.settings.weather_lat | default: '40.71' }}" data-lon="{{ section.settings.weather_lon | default: '-74.01' }}" data-alpha="{{ bg_alpha }}" data-animate="{% if section.settings.animate %}1{% else %}0{% endif %}" data-force="{{ section.settings.force_scene | default: 'auto' }}"{% endif -%}>
  {%- if look == 'sun' -%}
  <span class="dyn-bg-shade"></span>
  <span class="dyn-bg-blob dyn-bg-s1"></span>
  <span class="dyn-bg-blob dyn-bg-s2"></span>
  {%- elsif look == 'weather' -%}
  <span class="dyn-bg-blob dyn-bg-b1 dyn-bg-w1"></span>
  <span class="dyn-bg-blob dyn-bg-b2 dyn-bg-w2"></span>
  <span class="dyn-bg-blob dyn-bg-b3 dyn-bg-w3"></span>
  <span class="dyn-bg-parts" id="dynBgParts-{{ section.id }}"></span>
  <span class="dyn-bg-night" id="dynBgNight-{{ section.id }}" hidden></span>
  <span class="dyn-bg-veil"></span>
  {%- else -%}
  <span class="dyn-bg-blob dyn-bg-b1"></span>
  <span class="dyn-bg-blob dyn-bg-b2"></span>
  <span class="dyn-bg-blob dyn-bg-b3"></span>
  {%- endif -%}
  {%- if section.settings.react_mouse -%}
  <span class="dyn-bg-cursor"></span>
  {%- endif -%}
</div>

<style>
  #dynBg-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    {%- if look == 'sun' -%}
    background: {{ section.settings.wall_color | default: '#ffb42e' }};
    {%- elsif section.settings.base_tint != blank and section.settings.base_tint != 'rgba(0,0,0,0)' -%}
    background: {{ section.settings.base_tint }};
    {%- endif -%}
  }
  #dynBg-{{ section.id }} .dyn-bg-blob {
    position: absolute;
    width: 95vmax;
    height: 95vmax;
    border-radius: 50%;
    will-change: transform;
  }

  {%- if look == 'sun' -%}
  /* Sunlight & shadow: soft corner shade for depth, then two bright diagonal
     panes of "window light" that creep across the wall, slowly, like the sun
     moving. Only transform animates (GPU). */
  #dynBg-{{ section.id }} .dyn-bg-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(45deg, rgba(30, 12, 0, {{ shade_a }}) 0%, rgba(30, 12, 0, 0) 38%),
      linear-gradient(225deg, rgba(30, 12, 0, {{ shade_a }}) 0%, rgba(30, 12, 0, 0) 42%);
  }
  #dynBg-{{ section.id }} .dyn-bg-s1 {
    top: -26vmax; left: -30vmax;
    width: 170vmax; height: 30vmax;
    border-radius: 5vmax;
    background: rgba(255, 255, 255, {{ sun_a }});
    filter: blur(26px);
    transform: rotate(-30deg);
    animation: dynBgSun1 {{ spd }}s ease-in-out infinite alternate;
  }
  #dynBg-{{ section.id }} .dyn-bg-s2 {
    top: 16vmax; left: -36vmax;
    width: 180vmax; height: 18vmax;
    border-radius: 5vmax;
    background: rgba(255, 255, 255, {{ sun_a | times: 0.72 }});
    filter: blur(30px);
    transform: rotate(-30deg);
    animation: dynBgSun2 {{ spd2 }}s ease-in-out infinite alternate;
  }
  @keyframes dynBgSun1 {
    0%   { transform: rotate(-30deg) translate(0, 0); }
    100% { transform: rotate(-30deg) translate(5vmax, 3vmax); }
  }
  @keyframes dynBgSun2 {
    0%   { transform: rotate(-30deg) translate(0, 0); }
    100% { transform: rotate(-30deg) translate(-6vmax, 2vmax); }
  }
  {%- elsif look == 'weather' -%}
  /* Live weather: the glows take the sky's colors (set by the script) and the
     parts layer carries rain, snow, clouds, sun, fog or stars. */
  #dynBg-{{ section.id }} {
    --wg1: rgba(140, 160, 200, {{ bg_alpha }});
    --wg2: rgba(180, 190, 220, {{ bg_alpha }});
    --wg3: rgba(160, 170, 210, {{ bg_alpha }});
  }
  #dynBg-{{ section.id }} .dyn-bg-b1 {
    top: -35vmax; left: -25vmax;
    background: radial-gradient(circle at center, var(--wg1) 0%, transparent 62%);
    animation: dynBgDrift1 {{ spd }}s ease-in-out infinite alternate;
  }
  #dynBg-{{ section.id }} .dyn-bg-b2 {
    top: -10vmax; right: -35vmax;
    background: radial-gradient(circle at center, var(--wg2) 0%, transparent 62%);
    animation: dynBgDrift2 {{ spd2 }}s ease-in-out infinite alternate;
  }
  #dynBg-{{ section.id }} .dyn-bg-b3 {
    bottom: -40vmax; left: 10vmax;
    background: radial-gradient(circle at center, var(--wg3) 0%, transparent 62%);
    animation: dynBgDrift3 {{ spd3 }}s ease-in-out infinite alternate;
  }
  @keyframes dynBgDrift1 {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(14vmax, 10vmax) scale(1.18); }
  }
  @keyframes dynBgDrift2 {
    0%   { transform: translate(0, 0) scale(1.12); }
    100% { transform: translate(-16vmax, 14vmax) scale(0.94); }
  }
  @keyframes dynBgDrift3 {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(12vmax, -12vmax) scale(1.15); }
  }
  #dynBg-{{ section.id }} .dyn-bg-parts { position: absolute; inset: 0; overflow: hidden; }
  #dynBg-{{ section.id }} .dyn-bg-parts i { position: absolute; display: block; pointer-events: none; }
  #dynBg-{{ section.id }} .dbg-rain { top: -24px; width: 2px; height: 18px; border-radius: 2px;
    background: linear-gradient(rgba(255,255,255,0), rgba(255,255,255,0.65));
    box-shadow: 0 0 2px rgba(80, 100, 130, 0.35); animation: dynBgRain linear infinite; }
  @keyframes dynBgRain { to { transform: translateY(115vh); } }
  #dynBg-{{ section.id }} .dbg-snow { top: -10px; width: 6px; height: 6px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 0 1px rgba(140, 150, 175, 0.35), 0 1px 3px rgba(100, 115, 145, 0.4);
    animation: dynBgSnow linear infinite; }
  @keyframes dynBgSnow {
    50%  { transform: translateY(55vh) translateX(4vmax); }
    100% { transform: translateY(112vh) translateX(-2vmax); }
  }
  #dynBg-{{ section.id }} .dbg-cloud { width: 64vmax; height: 26vmax; border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255,255,255,0.30) 0%, transparent 62%);
    animation: dynBgCloud ease-in-out infinite alternate; }
  @keyframes dynBgCloud { to { transform: translateX(9vmax); } }
  #dynBg-{{ section.id }} .dbg-sun { top: -22vmax; right: -22vmax; width: 74vmax; height: 74vmax; border-radius: 50%;
    background: radial-gradient(circle at center, rgba(255, 224, 130, 0.7) 0%, rgba(255, 200, 90, 0.25) 38%, transparent 62%);
    animation: dynBgSunPulse 7s ease-in-out infinite alternate; }
  @keyframes dynBgSunPulse { to { transform: scale(1.08); } }
  #dynBg-{{ section.id }} .dbg-star { width: 3px; height: 3px; border-radius: 50%; background: #fff;
    animation: dynBgTwinkle ease-in-out infinite alternate; }
  @keyframes dynBgTwinkle { from { opacity: 0.15; } to { opacity: 0.9; } }
  #dynBg-{{ section.id }} .dbg-fog { left: -20%; width: 140%; height: 20vmax; border-radius: 50%;
    background: linear-gradient(rgba(255,255,255,0.22), rgba(255,255,255,0.05));
    filter: blur(28px); animation: dynBgCloud ease-in-out infinite alternate; }
  #dynBg-{{ section.id }} .dbg-flash { inset: 0; background: #fff; opacity: 0; animation: dynBgFlash 9s linear infinite; }
  @keyframes dynBgFlash {
    0%, 92.9%, 95.1%, 100% { opacity: 0; }
    93.2% { opacity: 0.45; }
    93.8% { opacity: 0; }
    94.4% { opacity: 0.3; }
  }
  #dynBg-{{ section.id }} .dyn-bg-night { position: absolute; inset: 0; background: rgba(8, 12, 48, 0.35); }
  /* The veil: white wash that tames the sky. Strength 40 = none (full Apple
     color), lower strength = softer, more pastel page. */
  #dynBg-{{ section.id }} .dyn-bg-veil { position: absolute; inset: 0; background: #fff; opacity: {{ veil_o }}; }
  @media (prefers-reduced-motion: reduce) {
    #dynBg-{{ section.id }} .dyn-bg-parts i { animation: none !important; }
    #dynBg-{{ section.id }} .dbg-rain, #dynBg-{{ section.id }} .dbg-snow, #dynBg-{{ section.id }} .dbg-flash { display: none; }
  }
  {%- unless section.settings.animate -%}
  #dynBg-{{ section.id }} .dyn-bg-parts i { animation: none !important; }
  #dynBg-{{ section.id }} .dbg-rain, #dynBg-{{ section.id }} .dbg-snow, #dynBg-{{ section.id }} .dbg-flash { display: none; }
  {%- endunless -%}
  {%- else -%}
  /* Soft color glows: each is a pre-faded radial gradient — no blur filter
     needed, so it stays feather-light on phones. Only transform animates. */
  #dynBg-{{ section.id }} .dyn-bg-b1 {
    top: -35vmax; left: -25vmax;
    background: radial-gradient(circle at center, {{ c1 }} 0%, transparent 62%);
    animation: dynBgDrift1 {{ spd }}s ease-in-out infinite alternate;
  }
  #dynBg-{{ section.id }} .dyn-bg-b2 {
    top: -10vmax; right: -35vmax;
    background: radial-gradient(circle at center, {{ c2 }} 0%, transparent 62%);
    animation: dynBgDrift2 {{ spd2 }}s ease-in-out infinite alternate;
  }
  #dynBg-{{ section.id }} .dyn-bg-b3 {
    bottom: -40vmax; left: 10vmax;
    background: radial-gradient(circle at center, {{ c3 }} 0%, transparent 62%);
    animation: dynBgDrift3 {{ spd3 }}s ease-in-out infinite alternate;
  }
  @keyframes dynBgDrift1 {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(14vmax, 10vmax) scale(1.18); }
  }
  @keyframes dynBgDrift2 {
    0%   { transform: translate(0, 0) scale(1.12); }
    100% { transform: translate(-16vmax, 14vmax) scale(0.94); }
  }
  @keyframes dynBgDrift3 {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(12vmax, -12vmax) scale(1.15); }
  }
  {%- endif -%}

  /* Visitors who asked their phone for less motion get a calm, frozen version. */
  @media (prefers-reduced-motion: reduce) {
    #dynBg-{{ section.id }} .dyn-bg-blob { animation: none !important; }
  }
  {%- unless section.settings.animate -%}
  #dynBg-{{ section.id }} .dyn-bg-blob { animation: none !important; }
  {%- endunless -%}

  {%- if section.settings.react_mouse -%}
  /* A soft pool of light that lazily chases the cursor. Faded in on the first
     mouse move, faded out when the mouse leaves the window. */
  #dynBg-{{ section.id }} .dyn-bg-cursor {
    position: absolute;
    left: -35vmax; top: -35vmax;
    width: 70vmax; height: 70vmax;
    border-radius: 50%;
    background: radial-gradient(circle at center, {% if look == 'sun' %}rgba(255, 255, 255, {{ sun_a | times: 0.8 }}){% else %}{{ c2 }}{% endif %} 0%, transparent 58%);
    opacity: 0;
    transition: opacity 0.9s ease;
    will-change: transform;
  }
  #dynBg-{{ section.id }} .dyn-bg-cursor.is-on { opacity: 1; }
  {%- endif -%}

  /* The page sections paint their own solid page color over the whole screen,
     which would hide the wallpaper. Where this section is present, that
     page-level coat goes see-through — cards, panels and drawers keep their
     own backgrounds. (Scoped to this page only: no wallpaper, no change.) */
  html, body { background: transparent !important; }
  .dyn-hero, .dyn-col, .dyn-sug, .dyn-about, .dyn-faq { background: transparent !important; }
  [id^="shopify-section-"]:has(> .dyn-acct), [id^="shopify-section-"]:has(> .dyn-wish) { background: transparent !important; }
</style>

{%- if section.settings.react_mouse -%}
<script>
(function () {
  var root = document.getElementById("dynBg-{{ section.id }}");
  if (!root) return;
  // Mouse-only: skip touch screens and anyone who asked for less motion.
  if (window.matchMedia) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
  }
  var blobs = root.querySelectorAll(".dyn-bg-blob");
  var glow = root.querySelector(".dyn-bg-cursor");
  // How far each layer leans toward the cursor (x, y) — different amounts and
  // directions per layer, so the movement feels like depth, not a slide.
  var LEAN = [[3, 2], [-4, 3], [2.5, -2.5]];
  var tx = 0, ty = 0, mx = 0, my = 0;
  var gxT = -9999, gyT = -9999, gx = 0, gy = 0, started = false;
  var raf = null;
  function tick() {
    mx += (tx - mx) * 0.05;
    my += (ty - my) * 0.05;
    gx += (gxT - gx) * 0.07;
    gy += (gyT - gy) * 0.07;
    var vmax = Math.max(window.innerWidth, window.innerHeight) / 100;
    for (var i = 0; i < blobs.length && i < LEAN.length; i++) {
      blobs[i].style.translate = (mx * LEAN[i][0] * vmax).toFixed(1) + "px " + (my * LEAN[i][1] * vmax).toFixed(1) + "px";
    }
    if (glow) glow.style.transform = "translate(" + gx.toFixed(1) + "px," + gy.toFixed(1) + "px)";
    // Rest when everything has settled; the next mouse move wakes it up.
    if (Math.abs(tx - mx) < 0.001 && Math.abs(ty - my) < 0.001 &&
        Math.abs(gxT - gx) < 0.3 && Math.abs(gyT - gy) < 0.3) { raf = null; return; }
    raf = requestAnimationFrame(tick);
  }
  window.addEventListener("pointermove", function (e) {
    if (e.pointerType && e.pointerType !== "mouse") return;
    tx = e.clientX / window.innerWidth - 0.5;
    ty = e.clientY / window.innerHeight - 0.5;
    gxT = e.clientX; gyT = e.clientY;
    if (!started) { started = true; gx = gxT; gy = gyT; if (glow) glow.classList.add("is-on"); }
    if (!raf) raf = requestAnimationFrame(tick);
  }, { passive: true });
  document.documentElement.addEventListener("mouseleave", function () {
    if (glow) glow.classList.remove("is-on");
  });
})();
</script>
{%- endif -%}

{%- if look == 'weather' -%}
<script>
(function () {
  /* Live weather look: ask Open-Meteo (no key) for the sky at the set spot,
     then paint it — glow colors plus rain / snow / clouds / sun / fog / stars,
     with a soft navy wash after dark. Cached for 30 minutes. */
  var root = document.getElementById("dynBg-{{ section.id }}");
  var parts = document.getElementById("dynBgParts-{{ section.id }}");
  var night = document.getElementById("dynBgNight-{{ section.id }}");
  if (!root || !parts) return;
  var alpha = parseFloat(root.getAttribute("data-alpha") || "0.12");
  var still = root.getAttribute("data-animate") !== "1" ||
    (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches);
  function glowVar(n, rgb) { root.style.setProperty("--wg" + n, "rgba(" + rgb.join(",") + "," + alpha + ")"); }
  function part(cls, style) { var i = document.createElement("i"); i.className = cls; i.style.cssText = style || ""; parts.appendChild(i); }
  function rnd(a, b) { return (a + Math.random() * (b - a)); }
  /* Full-bleed sky gradients, Apple Weather style. */
  var SKY = {
    clearDay: ["#3d7dd8", "#6aaef7", "#a8d4ff"],
    clearNight: ["#050a1e", "#101f45", "#23386b"],
    partly: ["#5c8fd6", "#8fb8e8", "#c3d9f2"],
    cloudy: ["#6a7f99", "#93a4b8", "#c0cad6"],
    rain: ["#3d4d63", "#5a6c85", "#8395ab"],
    storm: ["#1d2635", "#37455c", "#55647c"],
    snow: ["#8fa3bd", "#b9c6d8", "#e6ecf3"],
    fog: ["#97a0ab", "#b7bec7", "#d9dde2"]
  };
  function sky(name) {
    var g = SKY[name];
    root.style.background = "linear-gradient(180deg, " + g[0] + " 0%, " + g[1] + " 55%, " + g[2] + " 100%)";
  }
  function scene(code, isDay) {
    parts.innerHTML = "";
    if (night) night.hidden = !!isDay;
    var kind = code >= 95 ? "storm"
      : ((code >= 80 && code <= 82) || (code >= 51 && code <= 67)) ? "rain"
      : (code >= 71 && code <= 86) ? "snow"
      : (code === 45 || code === 48) ? "fog"
      : code === 3 ? "cloudy" : code === 2 ? "partly" : "clear";
    var i;
    if (kind === "clear") {
      if (isDay) {
        sky("clearDay");
        glowVar(1, [255, 184, 46]); glowVar(2, [255, 130, 90]); glowVar(3, [120, 180, 255]);
        part("dbg-sun");
      } else {
        sky("clearNight");
        glowVar(1, [50, 70, 170]); glowVar(2, [110, 90, 200]); glowVar(3, [30, 50, 120]);
        for (i = 0; i < 18; i++) part("dbg-star", "left:" + rnd(0, 100).toFixed(1) + "%;top:" + rnd(0, 65).toFixed(1) + "%;animation-duration:" + rnd(1.5, 4).toFixed(1) + "s;animation-delay:" + rnd(0, 2).toFixed(1) + "s;");
      }
    } else if (kind === "partly") {
      sky("partly");
      glowVar(1, [255, 200, 120]); glowVar(2, [150, 180, 220]); glowVar(3, [180, 190, 210]);
      if (isDay) part("dbg-sun");
      for (i = 0; i < 2; i++) part("dbg-cloud", "top:" + (8 + i * 26) + "vmax;left:" + (i * 30 - 10) + "vmax;animation-duration:" + rnd(24, 40).toFixed(0) + "s;");
    } else if (kind === "cloudy") {
      sky("cloudy");
      glowVar(1, [140, 150, 170]); glowVar(2, [170, 175, 190]); glowVar(3, [120, 130, 150]);
      for (i = 0; i < 3; i++) part("dbg-cloud", "top:" + (i * 20 - 4) + "vmax;left:" + (i * 24 - 14) + "vmax;animation-duration:" + rnd(22, 42).toFixed(0) + "s;");
    } else if (kind === "fog") {
      sky("fog");
      glowVar(1, [180, 180, 190]); glowVar(2, [200, 200, 210]); glowVar(3, [170, 170, 180]);
      for (i = 0; i < 3; i++) part("dbg-fog", "top:" + (12 + i * 26) + "vh;animation-duration:" + rnd(26, 44).toFixed(0) + "s;");
    } else if (kind === "snow") {
      sky("snow");
      glowVar(1, [180, 200, 230]); glowVar(2, [210, 220, 240]); glowVar(3, [160, 180, 220]);
      if (!still) for (i = 0; i < 20; i++) part("dbg-snow", "left:" + rnd(0, 100).toFixed(1) + "%;animation-duration:" + rnd(7, 14).toFixed(1) + "s;animation-delay:-" + rnd(0, 14).toFixed(1) + "s;opacity:" + rnd(0.4, 0.9).toFixed(2) + ";");
    } else {
      var storm = kind === "storm";
      sky(storm ? "storm" : "rain");
      if (storm) { glowVar(1, [70, 80, 110]); glowVar(2, [90, 100, 140]); glowVar(3, [50, 60, 90]); }
      else { glowVar(1, [90, 120, 160]); glowVar(2, [110, 140, 180]); glowVar(3, [80, 100, 140]); }
      for (i = 0; i < 2; i++) part("dbg-cloud", "top:" + (i * 22 - 6) + "vmax;left:" + (i * 34 - 12) + "vmax;animation-duration:" + rnd(20, 34).toFixed(0) + "s;");
      if (!still) {
        for (i = 0; i < (storm ? 26 : 20); i++) part("dbg-rain", "left:" + rnd(0, 100).toFixed(1) + "%;animation-duration:" + rnd(0.9, 1.5).toFixed(2) + "s;animation-delay:-" + rnd(0, 1.5).toFixed(2) + "s;");
        if (storm) part("dbg-flash");
      }
    }
  }
  /* Preview override: the 'Test a scene' setting, or ?sky=rain on any page
     URL (clear, night, partly, cloudy, rain, storm, snow, fog). */
  var MAP = { clear: [0, 1], day: [0, 1], night: [0, 0], partly: [2, 1], cloudy: [3, 1],
              rain: [61, 1], showers: [80, 1], storm: [95, 1], snow: [71, 1], fog: [45, 1] };
  var qs = (location.search.match(/[?&]sky=([a-z]+)/) || [])[1];
  var force = qs || root.getAttribute("data-force") || "auto";
  if (force !== "auto" && MAP[force]) { scene(MAP[force][0], MAP[force][1]); return; }
  try {
    var c = JSON.parse(localStorage.getItem("dyn_bgwx") || "null");
    if (c && Date.now() - c.ts < 1800000) { scene(c.code, c.isDay); return; }
  } catch (e) {}
  var u = "https://api.open-meteo.com/v1/forecast?latitude=" + root.getAttribute("data-lat") +
          "&longitude=" + root.getAttribute("data-lon") + "&current=weather_code,is_day";
  fetch(u).then(function (r) { return r.json(); }).then(function (j) {
    if (!j || !j.current) return;
    var code = j.current.weather_code || 0, isDay = j.current.is_day !== 0;
    try { localStorage.setItem("dyn_bgwx", JSON.stringify({ code: code, isDay: isDay, ts: Date.now() })); } catch (e) {}
    scene(code, isDay);
  }).catch(function () {});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Dynamic Background",
  "settings": [
    {
      "type": "paragraph",
      "content": "An animated wallpaper behind the whole page. Add it once per page — position in the page doesn't matter. Pure CSS: adds zero loading time."
    },
    {
      "type": "select",
      "id": "look",
      "label": "Look",
      "options": [
        { "value": "glow", "label": "Soft color glows" },
        { "value": "sun", "label": "Sunlight & shadow (wall)" },
        { "value": "weather", "label": "Live weather (auto)" }
      ],
      "default": "glow"
    },
