.ds-divider{width:40px;height:1px;background:linear-gradient(to right,transparent,var(--ds-accent),transparent);margin:0 0 1.8rem}
.ds-body{font-size:calc(17px * var(--ds-body-scale,1));line-height:1.65;color:var(--ds-muted);margin-bottom:2.5rem}
