/* cut-out paper chips: newspaper-clipping strips in varied cream/tan
   stocks with dark ink type, slightly scattered - like the pieces of a
   collage taped to the black page. Same size, links and reveal. */
.ds-chip{position:relative;background-color:var(--ds-chip-paper,#e6dcc6);border:none;border-radius:1px;
  padding:14px 18px;text-align:center;opacity:0;transform:translateY(16px) rotate(var(--ds-chip-tilt,0deg));
  transition:opacity .5s ease,transform .5s ease,filter .2s;text-decoration:none;display:inline-block;color:#1c1813;
  clip-path:polygon(0.6% 3%,10% 0.6%,31% 2.4%,54% 0.4%,78% 2%,99.5% 0.9%,99.1% 28%,100% 53%,99% 79%,99.4% 97.4%,81% 99.5%,57% 98%,31% 100%,4% 98.6%,0.9% 73%,0.3% 44%,1.2% 19%);
  background-image:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='120'%20height='120'%3E%3Cfilter%20id='g'%3E%3CfeTurbulence%20type='fractalNoise'%20baseFrequency='0.9'%20numOctaves='2'%20stitchTiles='stitch'/%3E%3CfeColorMatrix%20type='saturate'%20values='0'/%3E%3C/filter%3E%3Crect%20width='120'%20height='120'%20filter='url(%23g)'%20opacity='0.07'/%3E%3C/svg%3E");
  box-shadow:0 2px 0 rgba(0,0,0,.55),0 12px 24px -12px rgba(0,0,0,.8)}
.ds-chip:nth-child(5n+1){--ds-chip-paper:#e9e1d0;--ds-chip-tilt:-0.8deg}
.ds-chip:nth-child(5n+2){--ds-chip-paper:#d8ccb2;--ds-chip-tilt:0.6deg}
