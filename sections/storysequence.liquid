<script>
(function(){
  var root = document.getElementById('dynaeimic-story-{{ section.id }}');
  var bar = document.getElementById('ds-progress-{{ section.id }}');

  // Auto light/dark by time of day
  var themeMode = {{ section.settings.theme_mode | json }};
  var dayStart = {{ section.settings.day_start_hour }};
  var nightStart = {{ section.settings.night_start_hour }};
  function applyTheme(){
    var mode = themeMode;
    if(mode === 'auto'){
      var hour = new Date().getHours();
      mode = (hour >= dayStart && hour < nightStart) ? 'light' : 'dark';
    }
    if(root){
      root.classList.toggle('ds-theme-light', mode === 'light');
      root.classList.toggle('ds-theme-dark', mode === 'dark');
    }
  }
  applyTheme();
  setInterval(function(){ if(themeMode === 'auto') applyTheme(); }, 60000);


  // Progress bar
  window.addEventListener('scroll', function(){
    var s = window.scrollY, m = document.body.scrollHeight - window.innerHeight;
    if(bar) bar.style.width = (m > 0 ? (s/m)*100 : 0) + '%';
  }, {passive:true});

  // Fade-in animations
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('ds-visible');
        e.target.querySelectorAll('[data-ds-chip]').forEach(function(c,i){
          setTimeout(function(){c.classList.add('ds-chip-visible');}, 400+i*100);
        });
      }
    });
  }, {threshold:0.1});
  document.querySelectorAll('[data-ds-animate]').forEach(function(el){ obs.observe(el); });

  // Videos: per-block playback mode (data-mode = loop | play | scrub | playrewind)
  var scrubList = [], playList = [], playRewindList = [];
  var dsIsMobile = (window.matchMedia && (window.matchMedia('(max-width:768px)').matches || window.matchMedia('(pointer:coarse)').matches));
  document.querySelectorAll('[data-scrub-video]').forEach(function(video){
    var mode = video.getAttribute('data-mode');
    video.muted = true;
    if(dsIsMobile && (mode === 'scrub' || mode === 'playrewind')){ mode = 'loop'; }
    if(mode === 'scrub'){ scrubList.push(video); video.pause(); }
    else if(mode === 'play'){ playList.push(video); video.loop = false; video.removeAttribute('loop'); video.pause(); }
    else if(mode === 'once'){ video.loop = false; video.removeAttribute('loop'); playList.push(video); video.pause(); }
    else if(mode === 'playrewind'){ playRewindList.push(video); var pr0 = video.play(); if(pr0 && pr0.catch) pr0.catch(function(){}); }
    else { video.loop = true; video.setAttribute('autoplay',''); var pr = video.play(); if(pr && pr.catch) pr.catch(function(){}); }
  });

  if(playList.length){
    var playObs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(!e.isIntersecting) return;
        var pr = e.target.play(); if(pr && pr.catch) pr.catch(function(){});
        playObs.unobserve(e.target);
      });
    }, {threshold:0.25});
    playList.forEach(function(v){ playObs.observe(v); });
  }

  if(playRewindList.length){
    var prLastY = window.scrollY || 0, prIdle, prRAF = null;
    playRewindList.forEach(function(v){ v._rw = false; v._target = 0; });
    function prTick(){
      var active = false;
      playRewindList.forEach(function(v){
        if(!v._rw) return;
        active = true;
        var diff = v._target - v.currentTime;
        v.currentTime = Math.abs(diff) < 0.03 ? v._target : v.currentTime + diff * 0.18;
      });
      prRAF = active ? requestAnimationFrame(prTick) : null;
    }
    function prPlayForward(){
      playRewindList.forEach(function(v){ v._rw = false; if(v.paused){ var p = v.play(); if(p && p.catch) p.catch(function(){}); } });
    }
    window.addEventListener('scroll', function(){
      var y = window.scrollY || 0, dy = y - prLastY;
      prLastY = y;
      clearTimeout(prIdle);
      prIdle = setTimeout(prPlayForward, 180);
      if(dy >= 0){ prPlayForward(); return; }
      playRewindList.forEach(function(v){
        if(!v.duration) return;
        if(!v._rw){ v._rw = true; v._target = v.currentTime; v.pause(); }
        v._target = Math.max(0, v._target + dy * (v.duration / (window.innerHeight * 1.5)));
      });
      if(!prRAF) prRAF = requestAnimationFrame(prTick);
    }, {passive:true});
  }

  function scrubTargets(){
    scrubList.forEach(function(video){
      if(!video.duration) return;
      var section = video.closest('section') || video.closest('.ds-hero') || video.parentElement;
      var rect = section.getBoundingClientRect();
      var wh = window.innerHeight;
      var progress = (wh - rect.top) / (wh + rect.height);
      progress = Math.max(0, Math.min(1, progress));
      video._target = progress * video.duration;
    });
  }
  var scrubRAF = null;
  function scrubTick(){
    var active = false;
    scrubList.forEach(function(video){
      if(!video.duration || video.readyState < 2) return;
      var diff = video._target - video.currentTime;
      if(Math.abs(diff) > 0.01){ video.currentTime += diff * 0.2; active = true; }
    });
    scrubRAF = active ? requestAnimationFrame(scrubTick) : null;
  }
  function scrubKick(){ if(!scrubRAF) scrubRAF = requestAnimationFrame(scrubTick); }
  if(scrubList.length){
    scrubList.forEach(function(video){
      video._target = 0;
      video.addEventListener('loadedmetadata', function(){ scrubTargets(); scrubKick(); });
      video.addEventListener('canplay', function(){ scrubTargets(); scrubKick(); });
    });
    window.addEventListener('scroll', function(){ scrubTargets(); scrubKick(); }, {passive:true});
    scrubTargets(); scrubKick();
  }
})();
</script>

<script>
(function(){
  function initPin(wrap){
    var stage = wrap.querySelector('[data-pin-stage]');
    var video = wrap.querySelector('[data-pin-video]');
    var items = [].slice.call(wrap.querySelectorAll('[data-pin-text]'));
    var n = items.length;
    var pinTarget = 0, pinRAF = null;
    var pinMobile = (window.matchMedia && (window.matchMedia('(max-width:768px)').matches || window.matchMedia('(pointer:coarse)').matches));
    var pinSmooth = parseFloat(wrap.getAttribute('data-pin-smooth'));
    if(isNaN(pinSmooth)) pinSmooth = 70;
    var pinEase = 0.35 - (Math.max(0, Math.min(95, pinSmooth)) / 95) * 0.31; // 0 => 0.35 snappy, 95 => 0.04 floaty
    function pinTick(){
      var go = false;
      if(video && video.duration && video.readyState >= 2){
        var diff = pinTarget - video.currentTime;
        if(Math.abs(diff) > 0.004){ video.currentTime += diff * pinEase; go = true; }
        else { video.currentTime = pinTarget; }
      }
      pinRAF = go ? requestAnimationFrame(pinTick) : null;
    }
    function pinKick(){ if(!pinRAF) pinRAF = requestAnimationFrame(pinTick); }
    function onScroll(){
      var rect = wrap.getBoundingClientRect();
      var total = wrap.offsetHeight - window.innerHeight;
      var top = rect.top;
      var gap = Math.max(0, (window.innerHeight - stage.offsetHeight) / 2); // center shorter videos
      if(top <= 0 && -top < total){ stage.style.position = 'fixed'; stage.style.top = gap + 'px'; stage.style.bottom = 'auto'; }
      else if(-top >= total){ stage.style.position = 'absolute'; stage.style.top = 'auto'; stage.style.bottom = gap + 'px'; }
      else { stage.style.position = 'absolute'; stage.style.top = gap + 'px'; stage.style.bottom = 'auto'; }
      var scrolled = Math.min(Math.max(-top, 0), total);
      var progress = total > 0 ? scrolled / total : 0;
      if(video && video.duration && !pinMobile){ pinTarget = progress * video.duration; pinKick(); }
      for(var i=0;n>i;i++){
        var center = (i + 0.5) / n, half = 0.5 / n, plateau = half * 0.62;
        var d = Math.abs(progress - center);
        var op = d <= plateau ? 1 : 1 - (d - plateau) / (half - plateau);
        op = Math.max(0, Math.min(1, op));
        items[i].style.opacity = op;
        items[i].style.pointerEvents = op > 0.15 ? 'auto' : 'none';
        var inner = items[i].firstElementChild;
        if(inner){ inner.style.transform = 'translateY(' + ((1 - op) * 22) + 'px)'; inner.style.filter = 'blur(' + ((1 - op) * 8) + 'px)'; }
      }
    }
    window.addEventListener('scroll', onScroll, {passive:true});
    window.addEventListener('resize', onScroll, {passive:true});
    if(video){ video.addEventListener('loadedmetadata', onScroll); video.addEventListener('canplay', onScroll); if(pinMobile){ video.muted = true; video.loop = true; video.setAttribute('autoplay',''); var _pv = video.play(); if(_pv && _pv.catch) _pv.catch(function(){}); } else { video.pause(); } }
    onScroll();
  }
  document.querySelectorAll('[data-pin-wrap]').forEach(initPin);
})();
</script>

<script>
(function(){
  function initHGal(wrap){
    var stage=wrap.querySelector('[data-hgal-stage]');
    if(!stage) return;
    var down=false, sx=0, sl=0;
    stage.addEventListener('mousedown', function(e){ down=true; sx=e.clientX; sl=stage.scrollLeft; stage.style.cursor='grabbing'; e.preventDefault(); });
    window.addEventListener('mousemove', function(e){ if(down){ stage.scrollLeft = sl - (e.clientX - sx); } });
    window.addEventListener('mouseup', function(){ down=false; stage.style.cursor='grab'; });
    var prev=wrap.querySelector('[data-hgal-prev]'), next=wrap.querySelector('[data-hgal-next]');
    function step(dir){ var item=stage.querySelector('[data-hgal-item]'); var amt=item?(item.getBoundingClientRect().width+22):stage.clientWidth*0.6; stage.scrollBy({left:dir*amt,behavior:'smooth'}); }
    if(prev) prev.addEventListener('click', function(){ step(-1); });
    if(next) next.addEventListener('click', function(){ step(1); });
    var dots=[].slice.call(wrap.querySelectorAll('[data-hgal-dot]'));
    var itemsEls=[].slice.call(stage.querySelectorAll('[data-hgal-item]'));
    function goTo(k){ var it=itemsEls[k]; if(!it) return; stage.scrollTo({left:it.offsetLeft-(stage.clientWidth-it.clientWidth)/2, behavior:'smooth'}); }
    dots.forEach(function(d){ d.addEventListener('click', function(){ goTo(parseInt(d.getAttribute('data-hgal-dot'),10)); }); });
    function updateActive(){ var c=stage.scrollLeft+stage.clientWidth/2, best=0, bd=1e9; itemsEls.forEach(function(it,k){ var ic=it.offsetLeft+it.clientWidth/2, dd=Math.abs(ic-c); if(bd>dd){ bd=dd; best=k; } }); dots.forEach(function(d,k){ d.classList.toggle('ds-active', k===best); }); }
    if(dots.length){ stage.addEventListener('scroll', updateActive, {passive:true}); updateActive(); }
  }
  document.querySelectorAll('[data-hgal-wrap]').forEach(initHGal);
})();
</script>

<script>
(function(){
  function initBA(el){
    var after=el.querySelector('[data-ba-after]'), handle=el.querySelector('[data-ba-handle]');
    var target=50, cur=50, raf=null;
    function render(){ after.style.clipPath='inset(0 0 0 '+cur.toFixed(2)+'%)'; after.style.webkitClipPath='inset(0 0 0 '+cur.toFixed(2)+'%)'; handle.style.left=cur.toFixed(2)+'%'; }
    function tick(){ cur+=(target-cur)*0.15; if(Math.abs(target-cur)<0.05) cur=target; render(); raf=(cur!==target)?requestAnimationFrame(tick):null; }
    function kick(){ if(!raf) raf=requestAnimationFrame(tick); }
    function to(p){ target=Math.max(2,Math.min(98,p)); kick(); }
    after.style.transition='none'; after.style.webkitTransition='none'; handle.style.transition='none';
    render();
    el.addEventListener('mousemove',function(e){ var r=el.getBoundingClientRect(); to((e.clientX-r.left)/r.width*100); });
    el.addEventListener('mouseleave',function(){ to(50); });
    el.addEventListener('touchmove',function(e){ var r=el.getBoundingClientRect(); to((e.touches[0].clientX-r.left)/r.width*100); },{passive:true});
  }
  document.querySelectorAll('[data-ba]').forEach(initBA);
  // reveal animation for .ds-ba-inner
  var io=new IntersectionObserver(function(en){ en.forEach(function(e){ if(e.isIntersecting) e.target.classList.add('ds-visible'); }); },{threshold:0.1});
  document.querySelectorAll('.ds-ba-inner').forEach(function(el){ io.observe(el); });

  // Figurine carousel
  document.querySelectorAll('[data-toon]').forEach(function(sec){
    var items=[].slice.call(sec.querySelectorAll('[data-toon-item]'));
    var n=items.length; if(n===0) return;
    var idx=0, anim=false;
    var sc=parseFloat(sec.getAttribute('data-scale'))||1;
    function apply(){
      var center=idx, left=(idx+n-1)%n, right=(idx+1)%n, back=(idx+2)%n;
      var mob=window.innerWidth<640;
      items.forEach(function(it,i){
        var role = i===center?'center' : i===left?'left' : i===right?'right' : i===back?'back' : 'hide';
        if(role==='center'){ it.style.left='50%'; it.style.transform='translateX(-50%) scale('+((mob?1.25:1.68)*sc)+')'; it.style.filter='none'; it.style.opacity=1; it.style.zIndex=20; it.style.height=mob?'60%':'92%'; it.style.bottom=mob?'22%':'0'; }
        else if(role==='left'){ it.style.left=mob?'20%':'30%'; it.style.transform='translateX(-50%) scale('+sc+')'; it.style.filter='blur(2px)'; it.style.opacity=0.85; it.style.zIndex=10; it.style.height=mob?'16%':'28%'; it.style.bottom=mob?'32%':'12%'; }
        else if(role==='right'){ it.style.left=mob?'80%':'70%'; it.style.transform='translateX(-50%) scale('+sc+')'; it.style.filter='blur(2px)'; it.style.opacity=0.85; it.style.zIndex=10; it.style.height=mob?'16%':'28%'; it.style.bottom=mob?'32%':'12%'; }
        else if(role==='back'){ it.style.left='50%'; it.style.transform='translateX(-50%) scale('+sc+')'; it.style.filter='blur(4px)'; it.style.opacity=1; it.style.zIndex=5; it.style.height=mob?'13%':'22%'; it.style.bottom=mob?'32%':'12%'; }
        else { it.style.left='50%'; it.style.transform='translateX(-50%) scale(1)'; it.style.opacity=0; it.style.zIndex=1; it.style.height=mob?'13%':'22%'; it.style.bottom='12%'; }
      });
      var bg=items[center].getAttribute('data-bg'); if(bg) sec.style.setProperty('--toon-bg', bg);
      // reset parallax on the previously-centered inner
      items.forEach(function(it,i){ var im=it.firstElementChild; if(im){ im.style.transition='transform 650ms cubic-bezier(0.4,0,0.2,1)'; if(i!==center) im.style.transform=''; } });
    }
    // Subtle mouse parallax on the centered figure
    var px=0,py=0,tx=0,ty=0,praf=null;
    function ptick(){ px+=(tx-px)*0.08; py+=(ty-py)*0.08; var im=items[idx]&&items[idx].firstElementChild; if(im){ im.style.transition='transform 120ms ease-out'; im.style.transform='perspective(900px) rotateY('+(px*7).toFixed(2)+'deg) rotateX('+(-py*5).toFixed(2)+'deg) translate('+(px*14).toFixed(1)+'px,'+(py*10).toFixed(1)+'px)'; } if(Math.abs(tx-px)>0.001||Math.abs(ty-py)>0.001){ praf=requestAnimationFrame(ptick); } else { praf=null; } }
    function pkick(){ if(!praf) praf=requestAnimationFrame(ptick); }
    // Reveal of a second image on the centered figure (mask + soft bristle stamps)
    var mode=(sec.getAttribute('data-reveal')||'brush').trim();
    function makeOff(w,h){ var c=document.createElement('canvas'); c.width=w; c.height=h; return c; }
    var brushes=items.map(function(it){ var cv=it.querySelector('[data-toon-reveal]'); if(!cv) return null; var img=new Image(); var o={cv:cv,ctx:cv.getContext('2d'),img:img,ready:false,inner:it.querySelector('.ds-toon-inner'),a:0,at:0,px:null,py:null,stampReady:false}; img.onload=function(){ o.ready=true; o.stampReady=false; }; img.src=cv.getAttribute('data-img2'); return o; });
    var hasBrush=brushes.some(function(b){ return !!b; });
    function drawContain(ctx,img,W,H){ if(!img.width) return; var ir=img.width/img.height,dw,dh; if(ir>W/H){ dw=W; dh=W/ir; } else { dh=H; dw=H*ir; } ctx.drawImage(img,(W-dw)/2,H-dh,dw,dh); }
    function sizeBrush(b){ if(!b) return; var w=b.inner.clientWidth,h=b.inner.clientHeight; if(!w||!h) return; if(b.cv.width!==w||b.cv.height!==h||!b.mask){ b.cv.width=w; b.cv.height=h; b.stamp=makeOff(w,h); b.mask=makeOff(w,h); b.sctx=b.stamp.getContext('2d'); b.mctx=b.mask.getContext('2d'); b.stampReady=false; } }
    function ensureStamp(b){ if(b&&b.ready&&!b.stampReady&&b.sctx){ b.sctx.clearRect(0,0,b.stamp.width,b.stamp.height); drawContain(b.sctx,b.img,b.stamp.width,b.stamp.height); b.stampReady=true; } }
    function softDab(mctx,x,y,rad,alpha){ var g=mctx.createRadialGradient(x,y,0,x,y,rad); g.addColorStop(0,'rgba(255,255,255,'+alpha+')'); g.addColorStop(0.55,'rgba(255,255,255,'+(alpha*0.55)+')'); g.addColorStop(1,'rgba(255,255,255,0)'); mctx.fillStyle=g; mctx.beginPath(); mctx.arc(x,y,rad,0,7); mctx.fill(); }
    // bristle cluster: several scattered soft dabs along the stroke direction
    function dab(b,x,y){ if(!b||!b.mctx) return; var W=b.cv.width; var base=W*0.13; var dx=(b.px==null?0:x-b.px), dy=(b.py==null?0:y-b.py); var ang=Math.atan2(dy,dx); var nx=Math.cos(ang+1.5708), ny=Math.sin(ang+1.5708); var m=b.mctx; m.globalCompositeOperation='source-over'; var k=7; for(var i=0;k>i;i++){ var t=(i/(k-1)-0.5); var off=t*base*1.7; var jx=(Math.random()-0.5)*base*0.5, jy=(Math.random()-0.5)*base*0.5; softDab(m, x+nx*off+jx, y+ny*off+jy, base*(0.4+Math.random()*0.5), 0.5+Math.random()*0.4); } b.px=x; b.py=y; }
    function render(b){ if(!b) return; ensureStamp(b); var c=b.ctx,W=b.cv.width,H=b.cv.height; c.clearRect(0,0,W,H); if(!b.stampReady) return; c.globalCompositeOperation='source-over'; c.drawImage(b.stamp,0,0); c.globalCompositeOperation='destination-in'; c.drawImage(b.mask,0,0); c.globalCompositeOperation='source-over'; }
    function toXY(b,cx,cy){ var r=b.cv.getBoundingClientRect(); return {x:(cx-r.left)/r.width*b.cv.width, y:(cy-r.top)/r.height*b.cv.height}; }
    function clearMask(b){ if(b&&b.mctx){ b.mctx.clearRect(0,0,b.cv.width,b.cv.height); b.px=null; b.py=null; } }
    function clearBrushes(){ brushes.forEach(function(b){ if(b){ clearMask(b); b.a=0; b.at=0; b.ctx.clearRect(0,0,b.cv.width,b.cv.height); } }); }
    function stamp(b,cx,cy){ if(!b||!b.ready) return; var p=toXY(b,cx,cy); dab(b,p.x,p.y); render(b); }
    function spotlight(b,cx,cy){ if(!b||!b.ready||!b.mctx) return; clearMask(b); var p=toXY(b,cx,cy); var rad=b.cv.width*0.22, m=b.mctx; m.globalCompositeOperation='source-over'; m.fillStyle='rgba(255,255,255,1)'; m.beginPath(); m.arc(p.x,p.y,rad,0,7); m.fill(); render(b); }
    function wipeTo(b,cx){ if(!b||!b.ready||!b.mctx) return; var p=toXY(b,cx,0); var m=b.mctx,W=b.cv.width,H=b.cv.height; m.clearRect(0,0,W,H); var edge=W*0.06; var grd=m.createLinearGradient(Math.max(0,p.x-edge),0,p.x,0); grd.addColorStop(0,'rgba(255,255,255,1)'); grd.addColorStop(1,'rgba(255,255,255,0)'); m.fillStyle='rgba(255,255,255,1)'; m.fillRect(0,0,Math.max(0,p.x-edge),H); m.fillStyle=grd; m.fillRect(Math.max(0,p.x-edge),0,edge,H); render(b); }
    var draf=null; function dtick(){ var any=false; brushes.forEach(function(b){ if(!b||!b.mctx) return; b.a+=(b.at-b.a)*0.12; if(Math.abs(b.at-b.a)<0.01){ b.a=b.at; } else { any=true; } b.mctx.clearRect(0,0,b.cv.width,b.cv.height); b.mctx.fillStyle='rgba(255,255,255,'+b.a+')'; b.mctx.fillRect(0,0,b.cv.width,b.cv.height); render(b); }); if(any){ draf=requestAnimationFrame(dtick); } else { draf=null; } }
    function dkick(){ if(mode==='dissolve' && !draf) draf=requestAnimationFrame(dtick); }
    var fadeRaf=null; function fade(){ brushes.forEach(function(b){ if(!b||!b.mctx) return; b.mctx.globalCompositeOperation='destination-out'; b.mctx.fillStyle='rgba(0,0,0,0.045)'; b.mctx.fillRect(0,0,b.cv.width,b.cv.height); b.mctx.globalCompositeOperation='source-over'; render(b); }); fadeRaf=requestAnimationFrame(fade); }
    if(hasBrush && mode==='brush'){ fade(); }
    if(hasBrush){ window.addEventListener('resize', function(){ brushes.forEach(function(b){ sizeBrush(b); }); }, {passive:true}); }
    sec.addEventListener('mousemove', function(e){ if(anim) return; var r=sec.getBoundingClientRect(); tx=((e.clientX-r.left)/r.width-0.5)*2; ty=((e.clientY-r.top)/r.height-0.5)*2; pkick(); if(hasBrush){ var b=brushes[idx]; sizeBrush(b); if(mode==='spotlight'){ spotlight(b,e.clientX,e.clientY); } else if(mode==='wipe'){ wipeTo(b,e.clientX); } else if(mode==='dissolve'){ if(b){ b.at=1; } dkick(); } else { stamp(b,e.clientX,e.clientY); } } });
    sec.addEventListener('mouseleave', function(){ tx=0; ty=0; pkick(); if(hasBrush){ var b=brushes[idx]; if(b) b.px=null; if(mode==='spotlight'||mode==='wipe'||mode==='scratch'){ clearMask(b); render(b); } else if(mode==='dissolve'){ if(b){ b.at=0; } dkick(); } } });
    function nav(dir){ if(anim){return;} anim=true; idx = dir==='next' ? (idx+1)%n : (idx+n-1)%n; apply(); if(hasBrush){ clearBrushes(); sizeBrush(brushes[idx]); } setTimeout(function(){ anim=false; }, 650); }
    var prev=sec.querySelector('[data-toon-prev]'), next=sec.querySelector('[data-toon-next]');
    if(prev) prev.addEventListener('click', function(){ nav('prev'); });
    if(next) next.addEventListener('click', function(){ nav('next'); });
    window.addEventListener('resize', apply, {passive:true});
    apply();
    if(hasBrush){ setTimeout(function(){ brushes.forEach(sizeBrush); }, 80); }
  });
})();
</script>

<script>
{% if section.settings.enable_mouse_motion %}
(function(){
  if(!window.matchMedia || !window.matchMedia('(pointer:fine)').matches) return;
  var root = document.getElementById('dynaeimic-story-{{ section.id }}');
  if(!root) return;

  // Hero content parallax
  root.querySelectorAll('.ds-hero').forEach(function(hero){
    var content = hero.querySelector('.ds-hero-content');
    if(!content) return;
    var tx=0,ty=0,cx=0,cy=0,raf=null;
    function tick(){
      cx+=(tx-cx)*0.08; cy+=(ty-cy)*0.08;
      content.style.transform='translate('+cx.toFixed(2)+'px,'+cy.toFixed(2)+'px)';
      raf=(Math.abs(tx-cx)>0.1||Math.abs(ty-cy)>0.1)?requestAnimationFrame(tick):null;
    }
    function kick(){ if(!raf) raf=requestAnimationFrame(tick); }
    hero.addEventListener('mousemove',function(e){
      var r=hero.getBoundingClientRect();
      tx=((e.clientX-r.left)/r.width-0.5)*26;
      ty=((e.clientY-r.top)/r.height-0.5)*26;
      kick();
    });
    hero.addEventListener('mouseleave',function(){ tx=0; ty=0; kick(); });
  });

  // Pinned caption cards drift
  root.querySelectorAll('[data-pin-stage]').forEach(function(stage){
    var cards=[].slice.call(stage.querySelectorAll('[data-pin-text]'));
    if(!cards.length) return;
    var tx=0,ty=0,cx=0,cy=0,raf=null;
    function tick(){
      cx+=(tx-cx)*0.07; cy+=(ty-cy)*0.07;
      cards.forEach(function(c,i){
        var depth=10+(i%3)*8;
        c.style.setProperty('--mx',(cx*depth).toFixed(2)+'px');
        c.style.setProperty('--my',(cy*depth).toFixed(2)+'px');
      });
      raf=(Math.abs(tx-cx)>0.001||Math.abs(ty-cy)>0.001)?requestAnimationFrame(tick):null;
    }
    function kick(){ if(!raf) raf=requestAnimationFrame(tick); }
    stage.addEventListener('mousemove',function(e){
      var r=stage.getBoundingClientRect();
      tx=((e.clientX-r.left)/r.width-0.5)*2;
      ty=((e.clientY-r.top)/r.height-0.5)*2;
      kick();
    });
    stage.addEventListener('mouseleave',function(){ tx=0; ty=0; kick(); });
  });
})();
{% endif %}
</script>


