{% # theme-check-disable LiquidComplexity %}
{% comment %}
  DYNAEIMIC - Story Sequence Section
  Drop into: sections/story-sequence.liquid
  Sections are now drag-reorderable BLOCKS: Hero, Story step, Pinned video, CTA.
  Reorder / add / remove them in the theme editor. Global colors + light/dark
  (by time of day) live in the section settings.
{% endcomment %}

<div class="dynaeimic-story" id="dynaeimic-story-{{ section.id }}">
  {%- assign step_i = 0 -%}
  {%- assign row_open = false -%}
  {%- assign row_open_html = '<div class="ds-half-row">' -%}
  {%- assign row_close = '</div>' -%}
  {% for block in section.blocks %}
    {%- unless block.type == 'half' -%}{%- if row_open -%}{{ row_close }}{%- assign row_open = false -%}{%- endif -%}{%- endunless -%}
    {% case block.type %}

    {% when 'hero' %}
    {%- assign box_alpha = block.settings.box_opacity | divided_by: 100.0 -%}{%- capture box_style -%}{%- if block.settings.box_on -%}background:{{ block.settings.box_color | color_modify: 'alpha', box_alpha }};{%- if block.settings.box_blur > 0 -%}-webkit-backdrop-filter:blur({{ block.settings.box_blur }}px);backdrop-filter:blur({{ block.settings.box_blur }}px);{%- endif -%}border-radius:{{ block.settings.box_radius }}px;padding:{{ block.settings.box_padding }}px;{%- if block.settings.box_border -%}border:1px solid {{ block.settings.box_color | color_modify: 'alpha', 0.28 }};{%- else -%}border:none;{%- endif -%}box-shadow:0 20px 60px rgba(0,0,0,.28);{%- else -%}background:none;border:none;box-shadow:none;{%- endif -%}{%- endcapture -%}
    <section class="ds-hero ds-hero-{{ block.settings.hero_align }}{% unless block.settings.box_on %} ds-hero-noglass{% endunless %}" style="min-height:{{ block.settings.sec_height }}vh" {{ block.shopify_attributes }}>
      {% if block.settings.hero_video != blank %}
        <video class="ds-hero-bg" muted playsinline preload="auto" loop data-scrub-video="hero" data-mode="{{ block.settings.hero_video_mode }}"><source src="{{ block.settings.hero_video }}" type="video/mp4"></video>
      {% elsif block.settings.hero_image != blank %}
        <img class="ds-hero-bg" src="{{ block.settings.hero_image | image_url: width: 1920 }}" width="1920" height="1080" alt="" loading="eager">
      {% else %}
        <div class="ds-hero-bg ds-placeholder-bg"><div class="ds-ph-inner"><span>🎬</span><p>Add a background video or image</p></div></div>
      {% endif %}
      <div class="ds-hero-overlay"></div>
      {% if block.settings.hero_layout == 'minimal' %}
      <div class="ds-hero-min">
        <div class="ds-hero-min-top">
          {% if block.settings.eyebrow != blank %}<p class="ds-eyebrow" style="font-size:calc(min({{ block.settings.hero_eyebrow_size }}px, 5vw) * var(--ds-head-scale,1))">{{ block.settings.eyebrow }}</p>{% endif %}
          <h1 class="ds-hero-title" style="font-size:calc(min({{ block.settings.hero_title_size }}px, 12vw) * var(--ds-head-scale,1))">{{ block.settings.title_line1 }} <span class="ds-gold">{{ block.settings.title_line2 }}</span></h1>
          {% if block.settings.subtitle != blank %}<p class="ds-hero-sub" style="font-size:calc(min({{ block.settings.hero_sub_size }}px, 6vw) * var(--ds-body-scale,1))">{{ block.settings.subtitle }}</p>{% endif %}
        </div>
        <div class="ds-hero-min-btns">
          {% if block.settings.cta_label != blank %}<a href="{{ block.settings.cta_url }}" class="ds-hero-min-btn ds-hero-min-primary" style="font-size:calc(min({{ block.settings.hero_btn_size }}px, 5vw) * var(--ds-body-scale,1))">{{ block.settings.cta_label }}</a>{% endif %}
          {% if block.settings.cta2_label != blank %}<a href="{{ block.settings.cta2_url }}" class="ds-hero-min-btn ds-hero-min-secondary" style="font-size:calc(min({{ block.settings.hero_btn_size }}px, 5vw) * var(--ds-body-scale,1))">{{ block.settings.cta2_label }}</a>{% endif %}
        </div>
      </div>
      {% else %}
      <div class="ds-hero-content" style="{{ box_style }}max-width:{{ block.settings.sec_width }}px">
        {% if block.settings.eyebrow != blank %}<p class="ds-eyebrow" style="font-size:calc(min({{ block.settings.hero_eyebrow_size }}px, 5vw) * var(--ds-head-scale,1))">{{ block.settings.eyebrow }}</p>{% endif %}
        <h1 class="ds-hero-title" style="font-size:calc(min({{ block.settings.hero_title_size }}px, 12vw) * var(--ds-head-scale,1))">{{ block.settings.title_line1 }}<br><span class="ds-gold">{{ block.settings.title_line2 }}</span></h1>
        {% if block.settings.subtitle != blank %}<p class="ds-hero-sub" style="font-size:calc(min({{ block.settings.hero_sub_size }}px, 6vw) * var(--ds-body-scale,1))">{{ block.settings.subtitle }}</p>{% endif %}
        {% if block.settings.cta_label != blank %}<a href="{{ block.settings.cta_url }}" class="ds-hero-cta" style="font-size:calc(min({{ block.settings.hero_btn_size }}px, 5vw) * var(--ds-body-scale,1))">{{ block.settings.cta_label }}</a>{% endif %}
      </div>
      {% endif %}
    </section>

    {% when 'story_step' %}
    {%- assign step_i = step_i | plus: 1 -%}
    {%- assign step_mod = step_i | modulo: 2 -%}
    {%- assign box_alpha = block.settings.box_opacity | divided_by: 100.0 -%}{%- capture box_style -%}{%- if block.settings.box_on -%}background:{{ block.settings.box_color | color_modify: 'alpha', box_alpha }};{%- if block.settings.box_blur > 0 -%}-webkit-backdrop-filter:blur({{ block.settings.box_blur }}px);backdrop-filter:blur({{ block.settings.box_blur }}px);{%- endif -%}border-radius:{{ block.settings.box_radius }}px;padding:{{ block.settings.box_padding }}px;{%- if block.settings.box_border -%}border:1px solid {{ block.settings.box_color | color_modify: 'alpha', 0.28 }};{%- else -%}border:none;{%- endif -%}box-shadow:0 20px 60px rgba(0,0,0,.28);{%- else -%}background:none;border:none;box-shadow:none;{%- endif -%}{%- endcapture -%}
    <section class="ds-story-section{% if step_mod == 1 %} ds-alt{% endif %}" style="min-height:{{ block.settings.sec_height }}vh" {{ block.shopify_attributes }}>
      {%- capture ds_text -%}
        <div class="ds-split-text" style="flex:{{ block.settings.text_col }} 1 0;min-width:220px;max-height:74vh;overflow-y:auto;{{ box_style }}">
          <h2 class="ds-headline" style="font-size:calc(min({{ block.settings.story_head_size }}px, 9vw) * var(--ds-head-scale,1))">{{ block.settings.headline | newline_to_br }}</h2>
          <div class="ds-divider"></div>
          {% if block.settings.body != blank %}<p class="ds-body" style="font-size:calc(min({{ block.settings.story_body_size }}px, 6vw) * var(--ds-body-scale,1))">{{ block.settings.body }}</p>{% endif %}
          <div class="ds-icon-row">
            {%- for i in (1..5) -%}
              {%- assign lk = 'chip' | append: i | append: '_label' -%}
              {%- assign ik = 'chip' | append: i | append: '_icon' -%}
              {%- assign ck = 'chip' | append: i | append: '_link' -%}
              {%- if block.settings[lk] != blank -%}
                {%- if block.settings[ck] != blank -%}
                  <a href="{{ block.settings[ck] }}" class="ds-chip ds-chip-link" data-ds-chip style="transition-delay:{{ i | times: 0.1 }}s"><div class="ds-chip-icon">{{ block.settings[ik] }}</div><div class="ds-chip-label" style="font-size:calc(min({{ block.settings.story_chip_size }}px, 4vw) * var(--ds-body-scale,1))">{{ block.settings[lk] }}</div></a>
                {%- else -%}
                  <div class="ds-chip" data-ds-chip style="transition-delay:{{ i | times: 0.1 }}s"><div class="ds-chip-icon">{{ block.settings[ik] }}</div><div class="ds-chip-label" style="font-size:calc(min({{ block.settings.story_chip_size }}px, 4vw) * var(--ds-body-scale,1))">{{ block.settings[lk] }}</div></div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endcapture -%}
      <div class="ds-split ds-split-multi" data-ds-animate style="max-width:{{ block.settings.sec_width }}px;gap:{{ block.settings.media_gap }}rem">
        {%- for pos in (1..4) -%}
          {%- if block.settings.show_text and block.settings.text_order == pos -%}{{ ds_text }}{%- endif -%}
          {%- for mi in (1..3) -%}
            {%- assign vk = 'm' | append: mi | append: '_video' -%}
            {%- assign imk = 'm' | append: mi | append: '_image' -%}
            {%- assign mok = 'm' | append: mi | append: '_order' -%}
            {%- assign mmk = 'm' | append: mi | append: '_mode' -%}
            {%- assign mwk = 'm' | append: mi | append: '_w' -%}
            {%- assign mon = 'm' | append: mi | append: '_on' -%}
            {%- assign mtk = 'm' | append: mi | append: '_text' -%}
            {%- assign mtpk = 'm' | append: mi | append: '_text_pos' -%}
            {%- capture media_text -%}{%- if block.settings[mtk] != blank -%}<div class="ds-media-text ds-media-text-{{ block.settings[mtpk] | default: 'bottom' }}" style="font-size:calc(min({{ block.settings.media_text_size | default: 20 }}px, 5vw) * var(--ds-body-scale,1))">{{ block.settings[mtk] | newline_to_br }}</div>{%- endif -%}{%- endcapture -%}
            {%- if block.settings.show_media and block.settings[mon] and block.settings[mok] == pos -%}
              {%- if block.settings[vk] != blank -%}
                <div class="ds-split-media" data-ds-media style="flex:{{ block.settings[mwk] }} 1 0;min-width:110px;max-height:74vh;aspect-ratio:{{ block.settings.media_ratio }}">
                  <video muted playsinline preload="auto" loop data-scrub-video data-mode="{{ block.settings[mmk] }}"><source src="{{ block.settings[vk] }}" type="video/mp4"></video>
                  {{ media_text }}
                </div>
              {%- elsif block.settings[imk] != blank -%}
                <div class="ds-split-media" data-ds-media style="flex:{{ block.settings[mwk] }} 1 0;min-width:110px;max-height:74vh;aspect-ratio:{{ block.settings.media_ratio }}">
                  <img src="{{ block.settings[imk] | image_url: width: 900 }}" width="900" height="1125" alt="" loading="lazy">
                  {{ media_text }}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </section>

    {% when 'pinned' %}
    {%- assign box_alpha = block.settings.box_opacity | divided_by: 100.0 -%}{%- capture box_style -%}{%- if block.settings.box_on -%}background:{{ block.settings.box_color | color_modify: 'alpha', box_alpha }};{%- if block.settings.box_blur > 0 -%}-webkit-backdrop-filter:blur({{ block.settings.box_blur }}px);backdrop-filter:blur({{ block.settings.box_blur }}px);{%- endif -%}border-radius:{{ block.settings.box_radius }}px;padding:{{ block.settings.box_padding }}px;{%- if block.settings.box_border -%}border:1px solid {{ block.settings.box_color | color_modify: 'alpha', 0.28 }};{%- else -%}border:none;{%- endif -%}box-shadow:0 20px 60px rgba(0,0,0,.28);{%- else -%}background:none;border:none;box-shadow:none;{%- endif -%}{%- endcapture -%}
    {%- assign pin_count = 0 -%}
    {%- for i in (1..5) -%}{%- assign hk = 'head_' | append: i -%}{%- if block.settings[hk] != blank -%}{%- assign pin_count = pin_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- assign pin_rows = pin_count -%}{%- if pin_rows < 1 -%}{%- assign pin_rows = 1 -%}{%- endif -%}
    <div class="ds-pin-wrap" id="ds-pin-{{ block.id }}" data-pin-wrap data-pin-smooth="{{ block.settings.pin_smooth }}" style="height:calc({{ pin_rows }} * {{ block.settings.pin_step_vh }}vh)" {{ block.shopify_attributes }}>
      <div class="ds-pin-stage" data-pin-stage style="height:{{ block.settings.pin_height_vh }}vh;{% if block.settings.pin_max_width < 100 %}max-width:{{ block.settings.pin_max_width }}%;right:0;margin-left:auto;margin-right:auto;border-radius:18px;{% endif %}">
        {% if block.settings.pin_video != blank %}
          <video class="ds-pin-media" muted playsinline preload="auto" data-pin-video style="object-fit:{{ block.settings.pin_fit }}"><source src="{{ block.settings.pin_video }}" type="video/mp4"></video>
        {% elsif block.settings.pin_image != blank %}
          <img class="ds-pin-media" src="{{ block.settings.pin_image | image_url: width: 1920 }}" width="1920" height="1080" alt="" loading="lazy" style="object-fit:{{ block.settings.pin_fit }}">
        {% else %}
          <div class="ds-pin-media ds-pin-ph"><div class="ds-ph-inner"><span>🎞️</span><p>Add a pinned video or image</p></div></div>
        {% endif %}
        <div class="ds-pin-overlays">
          {%- for i in (1..5) -%}
            {%- assign hk = 'head_' | append: i -%}
            {%- assign bk = 'body_' | append: i -%}
            {%- assign xk = 'x_' | append: i -%}
            {%- assign yk = 'y_' | append: i -%}
            {%- if block.settings[hk] != blank -%}
              <div class="ds-pin-text" data-pin-text style="left:{{ block.settings[xk] }}%;top:{{ block.settings[yk] }}%;{{ box_style }}">
                <div class="ds-pin-inner">
                  <h2 class="ds-pin-head" style="font-size:calc(min({{ block.settings.pin_head_size }}px, 9vw) * var(--ds-head-scale,1))">{{ block.settings[hk] }}</h2>
                  {%- if block.settings[bk] != blank -%}<p class="ds-pin-body" style="font-size:calc(min({{ block.settings.pin_body_size }}px, 5vw) * var(--ds-body-scale,1))">{{ block.settings[bk] }}</p>{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {% when 'cta' %}
    {%- assign box_alpha = block.settings.box_opacity | divided_by: 100.0 -%}{%- capture box_style -%}{%- if block.settings.box_on -%}background:{{ block.settings.box_color | color_modify: 'alpha', box_alpha }};{%- if block.settings.box_blur > 0 -%}-webkit-backdrop-filter:blur({{ block.settings.box_blur }}px);backdrop-filter:blur({{ block.settings.box_blur }}px);{%- endif -%}border-radius:{{ block.settings.box_radius }}px;padding:{{ block.settings.box_padding }}px;{%- if block.settings.box_border -%}border:1px solid {{ block.settings.box_color | color_modify: 'alpha', 0.28 }};{%- else -%}border:none;{%- endif -%}box-shadow:0 20px 60px rgba(0,0,0,.28);{%- else -%}background:none;border:none;box-shadow:none;{%- endif -%}{%- endcapture -%}
    <section class="ds-cta-section" style="min-height:{{ block.settings.sec_height }}vh" {{ block.shopify_attributes }}>
      <div class="ds-cta-glow"></div>
      <div class="ds-inner" data-ds-animate style="{{ box_style }}max-width:{{ block.settings.sec_width }}px;text-align:{{ block.settings.cta_align }};margin-left:{% if block.settings.cta_align == 'left' %}0{% else %}auto{% endif %};margin-right:{% if block.settings.cta_align == 'right' %}0{% else %}auto{% endif %}">
        <h2 class="ds-cta-headline" style="font-size:calc(min({{ block.settings.cta_head_size }}px, 9vw) * var(--ds-head-scale,1)){% if block.settings.cta_text_color != blank %};color:{{ block.settings.cta_text_color }}{% endif %}">{{ block.settings.headline | newline_to_br }}</h2>
        {% if block.settings.subtitle != blank %}<p class="ds-cta-sub" style="font-size:calc(min({{ block.settings.cta_sub_size }}px, 5vw) * var(--ds-body-scale,1)){% if block.settings.cta_text_color != blank %};color:{{ block.settings.cta_text_color }}{% endif %};margin-left:{% if block.settings.cta_align == 'left' %}0{% else %}auto{% endif %};margin-right:{% if block.settings.cta_align == 'right' %}0{% else %}auto{% endif %}">{{ block.settings.subtitle }}</p>{% endif %}
        <div class="ds-btn-group{% if block.settings.cta_rainbow %} ds-btn-glow{% endif %}" style="justify-content:{% if block.settings.cta_align == 'left' %}flex-start{% elsif block.settings.cta_align == 'right' %}flex-end{% else %}center{% endif %}">
          {% if block.settings.primary_label != blank %}<a href="{{ block.settings.primary_url }}" class="ds-btn-primary" style="font-size:calc(min({{ block.settings.cta_btn_size }}px, 5vw) * var(--ds-body-scale,1))">{{ block.settings.primary_label }}</a>{% endif %}
          {% if block.settings.secondary_label != blank %}<a href="{{ block.settings.secondary_url }}" class="ds-btn-secondary" style="font-size:calc(min({{ block.settings.cta_btn_size }}px, 5vw) * var(--ds-body-scale,1))">{{ block.settings.secondary_label }}</a>{% endif %}
        </div>
      </div>
    </section>

    {% when 'gallery' %}
    {%- assign g_rows = 0 -%}
    {%- for i in (1..8) -%}{%- assign gik = 'g' | append: i | append: '_image' -%}{%- assign gvk = 'g' | append: i | append: '_video' -%}{%- if block.settings[gik] != blank or block.settings[gvk] != blank -%}{%- assign g_rows = g_rows | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if g_rows < 2 -%}{%- assign g_rows = 2 -%}{%- endif -%}
    <div class="ds-hgal-wrap" id="ds-hgal-{{ block.id }}" data-hgal-wrap {{ block.shopify_attributes }}>
      {% if block.settings.gal_title != blank %}<h2 class="ds-hgal-title" style="font-size:calc(min(56px, 8vw) * var(--ds-head-scale,1))">{{ block.settings.gal_title }}</h2>{% endif %}
      <div class="ds-hgal-stage" data-hgal-stage style="height:{{ block.settings.gal_height_vh }}vh">
        <div class="ds-hgal-track" data-hgal-track>
          {%- for i in (1..8) -%}
            {%- assign gik = 'g' | append: i | append: '_image' -%}
            {%- assign gvk = 'g' | append: i | append: '_video' -%}
            {%- assign gtk = 'g' | append: i | append: '_title' -%}
            {%- assign gsk = 'g' | append: i | append: '_sub' -%}
            {%- if block.settings[gik] != blank or block.settings[gvk] != blank -%}
              <div class="ds-hgal-item" data-hgal-item style="aspect-ratio:{{ block.settings.gal_ratio }}">
                <div class="ds-hgal-inner">
                  {%- if block.settings[gvk] != blank -%}
                    <video muted playsinline loop autoplay preload="auto"><source src="{{ block.settings[gvk] }}" type="video/mp4"></video>
                  {%- else -%}
                    <img src="{{ block.settings[gik] | image_url: width: 900 }}" width="900" height="1200" alt="" loading="lazy">
                  {%- endif -%}
                  {%- if block.settings[gtk] != blank or block.settings[gsk] != blank -%}
                  <div class="ds-hgal-cap" data-hgal-cap>
                    {%- if block.settings[gtk] != blank -%}<h3 class="ds-hgal-cap-t" style="font-size:calc(min(22px,2vw) * var(--ds-head-scale,1))">{{ block.settings[gtk] }}</h3>{%- endif -%}
                    {%- if block.settings[gsk] != blank -%}<p class="ds-hgal-cap-s" style="font-size:calc(13px * var(--ds-body-scale,1))">{{ block.settings[gsk] }}</p>{%- endif -%}
                  </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {% if block.settings.gal_arrows or block.settings.gal_dots %}
      <div class="ds-hgal-nav">
        {% if block.settings.gal_dots %}
        <div class="ds-hgal-dots" data-hgal-dots>
          {%- assign di = 0 -%}
          {%- for i in (1..8) -%}
            {%- assign gik = 'g' | append: i | append: '_image' -%}
            {%- assign gvk = 'g' | append: i | append: '_video' -%}
            {%- if block.settings[gik] != blank or block.settings[gvk] != blank -%}
              <button class="ds-hgal-dot" data-hgal-dot="{{ di }}" aria-label="Go to image {{ di | plus: 1 }}"{% if block.settings[gik] != blank %} style="background-image:url({{ block.settings[gik] | image_url: width: 80 }})"{% endif %}></button>
              {%- assign di = di | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% endif %}
        {% if block.settings.gal_arrows %}
        <div class="ds-hgal-arrows">
          <button class="ds-hgal-arrow" data-hgal-prev aria-label="Previous">‹</button>
          <button class="ds-hgal-arrow" data-hgal-next aria-label="Next">›</button>
        </div>
        {% endif %}
      </div>
      {% endif %}
    </div>

    {% when 'beforeafter' %}
    {%- assign step_i = step_i | plus: 1 -%}{%- assign step_mod = step_i | modulo: 2 -%}
    <section class="ds-ba-section{% if step_mod == 1 %} ds-alt{% endif %}">
      <div class="ds-ba-inner" data-ds-animate>
        <div class="ds-ba-row{% if block.settings.ba_side_pos == 'right' %} ds-ba-rev{% endif %}">
        {% if block.settings.ba_side_pos != 'none' %}
        <div class="ds-ba-side">
          {% if block.settings.ba_side_heading != blank %}<h3 class="ds-ba-side-h">{{ block.settings.ba_side_heading }}</h3>{% endif %}
          {% if block.settings.ba_side_body != blank %}<p class="ds-ba-side-b">{{ block.settings.ba_side_body }}</p>{% endif %}
        </div>
        {% endif %}
        <div class="ds-ba" data-ba style="aspect-ratio:{{ block.settings.ba_ratio }};max-width:{{ block.settings.ba_width }}px">
          <div class="ds-ba-before" data-ba-before>
            {% if block.settings.ba_before != blank %}<img src="{{ block.settings.ba_before | image_url: width: 1400 }}" width="1400" height="875" alt="Before" loading="lazy">{% else %}<div class="ds-ba-ph" style="background:linear-gradient(135deg,#1a1a1a,#2a2a2a)"><span>▢</span><p>before photo</p></div>{% endif %}
          </div>
          <div class="ds-ba-after" data-ba-after>
            {% if block.settings.ba_after != blank %}<img src="{{ block.settings.ba_after | image_url: width: 1400 }}" width="1400" height="875" alt="After" loading="lazy">{% else %}<div class="ds-ba-ph" style="background:linear-gradient(135deg,#3a2a18,#6b4f2f);color:var(--ds-accent)"><span>✦</span><p>after photo</p></div>{% endif %}
          </div>
          <div class="ds-ba-badge ds-ba-badge-l">{{ block.settings.ba_before_label }}</div>
          <div class="ds-ba-badge ds-ba-badge-r">{{ block.settings.ba_after_label }}</div>
          <div class="ds-ba-handle" data-ba-handle><div class="ds-ba-grip">⇄</div></div>
        </div>
        </div>
      </div>
    </section>

    {% when 'marquee' %}
    {%- capture mq_group -%}<span class="ds-mq-group">{%- assign words = block.settings.mq_words | split: ',' -%}{%- for w in words -%}{{ w | strip }} <span class="ds-mq-star">{{ block.settings.mq_sep }}</span> {%- endfor -%}</span>{%- endcapture -%}
    <section class="ds-mq-section" style="background:{% if block.settings.mq_alt %}var(--ds-alt-bg){% else %}var(--ds-bg){% endif %}">
      <div class="ds-mq-track" style="animation-duration:{{ block.settings.mq_speed }}s;font-size:{{ block.settings.mq_size }}px">{{ mq_group }}{{ mq_group }}</div>
    </section>

    {% when 'half' %}
    {%- assign box_alpha = block.settings.box_opacity | divided_by: 100.0 -%}{%- capture box_style -%}{%- if block.settings.box_on -%}background:{{ block.settings.box_color | color_modify: 'alpha', box_alpha }};{%- if block.settings.box_blur > 0 -%}-webkit-backdrop-filter:blur({{ block.settings.box_blur }}px);backdrop-filter:blur({{ block.settings.box_blur }}px);{%- endif -%}border-radius:{{ block.settings.box_radius }}px;padding:{{ block.settings.box_padding }}px;{%- if block.settings.box_border -%}border:1px solid {{ block.settings.box_color | color_modify: 'alpha', 0.28 }};{%- else -%}border:none;{%- endif -%}box-shadow:0 20px 60px rgba(0,0,0,.28);{%- else -%}background:none;border:none;box-shadow:none;{%- endif -%}{%- endcapture -%}
    {%- if row_open == false -%}{{ row_open_html }}{%- assign row_open = true -%}{%- endif -%}
    <section class="ds-half-panel" style="min-height:{{ block.settings.sec_height }}vh" {{ block.shopify_attributes }}>
      {%- if block.settings.half_type == 'media' -%}
        <div class="ds-half-media" style="aspect-ratio:{{ block.settings.media_ratio }}">
          {%- if block.settings.media_video != blank -%}
            <video muted playsinline preload="auto" loop data-scrub-video data-mode="{{ block.settings.media_mode }}"><source src="{{ block.settings.media_video }}" type="video/mp4"></video>
          {%- elsif block.settings.media_image != blank -%}
            <img src="{{ block.settings.media_image | image_url: width: 1200 }}" width="1200" height="1500" alt="" loading="lazy">
          {%- else -%}
            <div class="ds-media-ph"><span>▢</span><p>Add a photo or video</p></div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="ds-half-text" style="{{ box_style }}">
          {%- if block.settings.eyebrow != blank -%}<p class="ds-half-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="ds-headline" style="font-size:calc(min({{ block.settings.head_size }}px, 9vw) * var(--ds-head-scale,1))">{{ block.settings.headline | newline_to_br }}</h2>
          <div class="ds-divider"></div>
          {%- if block.settings.body != blank -%}<p class="ds-body" style="font-size:calc(min({{ block.settings.body_size }}px, 6vw) * var(--ds-body-scale,1))">{{ block.settings.body }}</p>{%- endif -%}
          {%- if block.settings.cta_label != blank -%}<a href="{{ block.settings.cta_url }}" class="ds-hero-cta ds-half-cta" style="font-size:calc(15px * var(--ds-body-scale,1))">{{ block.settings.cta_label }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </section>

    {% when 'categories' %}
    <section class="ds-cats-sec" {{ block.shopify_attributes }}>
      {% if block.settings.cats_title != blank %}<h2 class="ds-cats-title" style="font-size:calc(min(52px,7vw) * var(--ds-head-scale,1))">{{ block.settings.cats_title }}</h2>{% endif %}
      <div class="ds-cats-grid" data-ds-animate>
        {%- for n in (1..3) -%}
          {%- assign cnk = 'cat' | append: n | append: '_name' -%}
          {%- assign cvk = 'cat' | append: n | append: '_video' -%}
          {%- assign cik = 'cat' | append: n | append: '_image' -%}
          {%- assign cuk = 'cat' | append: n | append: '_url' -%}
          {%- if block.settings[cnk] != blank -%}
          <a class="ds-cat-card" href="{{ block.settings[cuk] | default: '#' }}" style="transition-delay:{{ forloop.index0 | times: 150 }}ms">
            {%- if block.settings[cvk] != blank -%}
              <video class="ds-cat-media" autoplay loop muted playsinline preload="auto"><source src="{{ block.settings[cvk] }}" type="video/mp4"></video>
            {%- elsif block.settings[cik] != blank -%}
              <img class="ds-cat-media" src="{{ block.settings[cik] | image_url: width: 900 }}" width="900" height="1200" alt="{{ block.settings[cnk] }}" loading="lazy">
            {%- else -%}
              <div class="ds-cat-media ds-cat-ph"></div>
            {%- endif -%}
            <div class="ds-cat-scrim"></div>
            <h3 class="ds-cat-name">{{ block.settings[cnk] }}</h3>
            <span class="ds-cat-btn">shop {{ block.settings[cnk] }}</span>
          </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>

    {% when 'toon' %}
    <section class="ds-toon" data-toon data-scale="{{ block.settings.toon_size | divided_by: 100.0 }}" data-reveal="{{ block.settings.toon_reveal_style }}" style="--toon-bg:{{ block.settings.toon1_bg }}">
      <div class="ds-toon-ghost"><span style="font-size:calc(clamp(90px,28vw,380px) * var(--ds-head-scale,1))">{{ block.settings.toon_ghost }}</span></div>
      <div class="ds-toon-stage">
        {%- for o in (1..10) -%}
          {%- for n in (1..10) -%}
            {%- assign tik = 'toon' | append: n | append: '_image' -%}
            {%- assign ti2k = 'toon' | append: n | append: '_image2' -%}
            {%- assign tbk = 'toon' | append: n | append: '_bg' -%}
            {%- assign tok = 'toon' | append: n | append: '_order' -%}
            {%- assign this_order = block.settings[tok] | default: n -%}
            {%- if block.settings[tik] != blank and this_order == o -%}
            <div class="ds-toon-item" data-toon-item data-bg="{{ block.settings[tbk] }}">
              <div class="ds-toon-inner">
                <img class="ds-toon-base" src="{{ block.settings[tik] | image_url: width: 800 }}" width="800" height="1333" alt="" draggable="false" loading="lazy">
                {%- if block.settings[ti2k] != blank -%}<canvas class="ds-toon-reveal" data-toon-reveal data-img2="{{ block.settings[ti2k] | image_url: width: 800 }}"></canvas>{%- endif -%}
              </div>
            </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
      <div class="ds-toon-info">
        {% if block.settings.toon_title != blank %}<p class="ds-toon-title">{{ block.settings.toon_title }}</p>{% endif %}
        {% if block.settings.toon_body != blank %}<p class="ds-toon-body">{{ block.settings.toon_body }}</p>{% endif %}
        <div class="ds-toon-nav">
          <button class="ds-toon-arrow" data-toon-prev aria-label="Previous">‹</button>
          <button class="ds-toon-arrow" data-toon-next aria-label="Next">›</button>
        </div>
      </div>
      {% if block.settings.toon_link_label != blank %}<a class="ds-toon-discover" href="{{ block.settings.toon_link_url | default: '#' }}">{{ block.settings.toon_link_label }} <span>→</span></a>{% endif %}
    </section>

    {% endcase %}
  {% endfor %}
  {%- if row_open -%}{{ row_close }}{%- endif -%}


</div>

{% if section.settings.show_top_btn %}<button class="ds-top-btn" id="ds-top-btn-{{ section.id }}" aria-label="Back to top">↑</button>{% endif %}
<div class="ds-progress-bar" id="ds-progress-{{ section.id }}"></div>

