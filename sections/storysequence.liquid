.ds-hero-cta::before{content:'';position:absolute;inset:-4px;border-radius:50px;background:linear-gradient(90deg,#4f8cff,#a06bff,#ff5ea8,#ff9d5e,#5edfff,#4f8cff);background-size:300% 100%;animation:dsGlow 8s linear infinite;filter:blur(9px);opacity:0;transition:opacity .3s ease;z-index:-1}
