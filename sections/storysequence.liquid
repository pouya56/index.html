{% schema %}
{
  "name": "Story Sequence",
  "tag": "section",
  "class": "dynaeimic-story-wrapper",
  "max_blocks": 30,
  "settings": [

    { "type": "header", "content": "Back to top button" },
    { "type": "checkbox", "id": "show_top_btn", "label": "Show back-to-top button", "default": true },

    { "type": "header", "content": "Motion" },
    { "type": "checkbox", "id": "enable_mouse_motion", "label": "Mouse-movement parallax (desktop)", "info": "Hero content and pinned captions drift gently with the cursor.", "default": true },

    { "type": "header", "content": "Light / Dark mode" },
    { "type": "select", "id": "theme_mode", "label": "Theme mode", "options": [{ "value": "auto", "label": "Auto (by time of day)" }, { "value": "light", "label": "Always light" }, { "value": "dark", "label": "Always dark" }], "default": "auto" },
    { "type": "range", "id": "day_start_hour", "label": "Light mode starts at", "min": 0, "max": 23, "step": 1, "unit": "h", "default": 7 },
    { "type": "range", "id": "night_start_hour", "label": "Dark mode starts at", "min": 0, "max": 23, "step": 1, "unit": "h", "default": 19 },

    { "type": "header", "content": "Colors — Dark" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#000000" },
    { "type": "color", "id": "bg_alt_color", "label": "Alternate section background", "default": "#101010" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#f5f5f7" },
    { "type": "color", "id": "accent_color", "label": "Accent color (buttons, links)", "default": "#2997ff" },

    { "type": "header", "content": "Colors — Light" },
    { "type": "color", "id": "light_bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "light_bg_alt_color", "label": "Alternate section background", "default": "#f5f5f7" },
    { "type": "color", "id": "light_text_color", "label": "Text color", "default": "#1d1d1f" },
