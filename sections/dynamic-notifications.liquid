{%- comment -%}
  Dynamic Notifications — a macOS-style stack of frosted "banner" cards that
  slide into a corner of the screen, pile up like Notification Center, and fan
  open when the visitor hovers (or taps) the stack. Each card has an app-style
  icon, a bold title, a line of text and a timestamp, and can be dismissed.
{%- endcomment -%}

{%- assign pos = section.settings.position | default: 'top-right' -%}
{%- assign anim = section.settings.reveal | default: 'slide' -%}

<div
  class="dyn-noti dyn-noti--{{ pos }}"
  id="dynNoti-{{ section.id }}"
  data-noti
  data-pos="{{ pos }}"
  data-reveal="{{ anim }}"
  data-start="{{ section.settings.start_delay | default: 700 }}"
  data-stagger="{{ section.settings.stagger | default: 260 }}"
  data-auto="{{ section.settings.auto_dismiss | default: 0 | times: 1000 }}"
  data-frequency="{{ section.settings.frequency | default: 'session' }}"
  data-open-hover="{% if section.settings.expand_on_hover == false %}0{% else %}1{% endif %}"
  {{ section.shopify_attributes }}
  aria-live="polite"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'Notifications' | escape }}"
  hidden
>
  <div class="dnoti-stack" data-noti-stack>
    {%- for block in section.blocks -%}
      {%- comment -%} Work out each card's fields from its type. A "purchase"
        block pulls a real product from the store (image, title, price, link);
        a "note" block uses whatever the merchant typed. {%- endcomment -%}
      {%- assign nid = block.settings.note_id | default: block.id -%}
      {%- assign n_img = block.settings.icon_image -%}
      {%- assign n_emoji = block.settings.emoji -%}
      {%- assign n_title = block.settings.title -%}
      {%- assign n_text = block.settings.text -%}
      {%- assign n_link = block.settings.link -%}
      {%- assign n_tile = block.settings.icon_bg | default: '#3a3a3f' -%}
      {%- if block.type == 'purchase' -%}
        {%- assign prod = block.settings.product -%}
        {%- assign n_emoji = '🛍️' -%}
        {%- assign n_tile = '#2f2f34' -%}
        {%- if prod != blank -%}
          {%- assign n_img = prod.featured_image -%}
          {%- assign n_link = block.settings.link | default: prod.url -%}
        {%- endif -%}
        {%- if block.settings.shopper != blank -%}
          {%- assign n_title = block.settings.shopper -%}
          {%- if block.settings.location != blank -%}{%- assign n_title = block.settings.shopper | append: ' · ' | append: block.settings.location -%}{%- endif -%}
          {%- capture n_text -%}{{ block.settings.verb | default: 'just bought' }}{% if prod != blank %} {{ prod.title }}{% if block.settings.show_price %} · {{ prod.price | money }}{% endif %}{% endif %}{%- endcapture -%}
        {%- else -%}
          {%- assign n_title = prod.title | default: 'New order' -%}
          {%- capture n_text -%}{{ block.settings.verb | default: 'Just purchased' }}{% if prod != blank and block.settings.show_price %} · {{ prod.price | money }}{% endif %}{%- endcapture -%}
        {%- endif -%}
      {%- endif -%}
      <div
        class="dnoti-card"
        data-note
        data-id="{{ section.id }}-{{ nid }}"
        data-once="{% if block.settings.show_once %}1{% else %}0{% endif %}"
        data-delay="{{ block.settings.delay | default: 0 }}"
        {% if n_link != blank %}data-href="{{ n_link }}"{% endif %}
        {% if block.settings.auto != blank %}data-auto="{{ block.settings.auto | times: 1000 }}"{% endif %}
        style="--tile:{{ n_tile }}; --i:{{ forloop.index0 }};"
        {{ block.shopify_attributes }}
        role="{% if n_link != blank %}link{% else %}status{% endif %}"
        {% if n_link != blank %}tabindex="0"{% endif %}
      >
        <span class="dnoti-ic" aria-hidden="true">
          {%- if n_img != blank -%}
            <img src="{{ n_img | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
          {%- elsif n_emoji != blank -%}
            <span class="dnoti-emoji">{{ n_emoji }}</span>
          {%- else -%}
            <svg viewBox="0 0 24 24" class="dnoti-bell"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          {%- endif -%}
        </span>
        <span class="dnoti-body">
          <span class="dnoti-top">
            <span class="dnoti-title">{{ n_title | escape }}</span>
            <span class="dnoti-time">{{ block.settings.time_text | escape }}</span>
          </span>
          {%- if n_text != blank -%}
            <span class="dnoti-text">{{ n_text | escape }}</span>
          {%- endif -%}
        </span>
        <button type="button" class="dnoti-x" data-noti-x aria-label="Dismiss notification">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
        </button>
      </div>
    {%- endfor -%}
  </div>
</div>

{%- comment -%} ---- Auto recent-purchases (social proof) ------------------
  Optional: pulls products from a collection and auto-rotates a single frosted
  toast pairing a random first name + city + product, e.g.
  "Emily from Austin purchased a Custom Mug". Only a first name and city show —
  no real customer data. Runs independently of the stack above.
{%- endcomment -%}
{%- if section.settings.social_enable -%}
  {%- assign sp_coll = section.settings.social_collection | default: collections.all -%}
  {%- assign sp_count = 0 -%}
  {%- for product in sp_coll.products limit: 60 -%}{%- assign sp_count = sp_count | plus: 1 -%}{%- endfor -%}
  {%- if sp_count > 0 -%}
  {%- assign sp_pos = section.settings.social_position | default: 'bottom-left' -%}
  <div
    class="dyn-sp dyn-sp--{{ sp_pos }}"
    id="dynNotiSP-{{ section.id }}"
    data-sproof data-pos="{{ sp_pos }}"
    data-first-min="{{ section.settings.social_first_min | default: 5 }}"
    data-first-max="{{ section.settings.social_first_max | default: 10 }}"
    data-show-min="{{ section.settings.social_show_min | default: 4 }}"
    data-show-max="{{ section.settings.social_show_max | default: 6 }}"
    data-gap-min="{{ section.settings.social_gap_min | default: 10 }}"
    data-gap-max="{{ section.settings.social_gap_max | default: 20 }}"
    data-verb="{{ section.settings.social_verb | default: 'purchased' | escape }}"
    data-conn="{{ section.settings.social_connector | default: 'from' | escape }}"
    aria-live="polite" role="region" aria-label="Recent purchases" hidden
  >
    <div class="sp-card" data-sp-card role="link" tabindex="0">
      <span class="sp-ic" aria-hidden="true"><img data-sp-img src="" alt="" width="80" height="80"></span>
      <span class="sp-body">
        <span class="sp-top"><span class="sp-title" data-sp-title></span><span class="sp-time" data-sp-time></span></span>
        <span class="sp-text" data-sp-text></span>
      </span>
      <button type="button" class="sp-x" data-sp-x aria-label="Dismiss">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
      </button>
    </div>
    <script type="application/json" data-sp-products>
      [
      {%- for product in sp_coll.products limit: 60 -%}
        {%- unless forloop.first %},{% endunless -%}
        {"t": {{ product.title | json }}, "u": {{ product.url | json }}, "i": {% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | json }}{% else %}""{% endif %}}
      {%- endfor -%}
      ]
    </script>
    <script type="application/json" data-sp-names>{{ section.settings.social_names | default: 'Emily, James, Sophia, Liam, Olivia, Noah, Ava, Ethan, Mia, Lucas, Isabella, Mason, Charlotte, Amelia, Harper, Benjamin, Ella, Henry, Grace, Jack' | json }}</script>
    <script type="application/json" data-sp-cities>{{ section.settings.social_cities | default: 'Austin, Denver, Seattle, Chicago, Portland, Boston, Miami, Toronto, London, Nashville, Atlanta, Brooklyn, Dallas, Phoenix, San Diego, Vancouver, Dublin, Manchester, Melbourne, Berlin' | json }}</script>
  </div>

  <style>
    #dynNotiSP-{{ section.id }}.dyn-sp { position: fixed; z-index: 2147481700;
      width: min(340px, calc(100vw - 24px)); pointer-events: none; -webkit-font-smoothing: antialiased; }
    #dynNotiSP-{{ section.id }}.dyn-sp[hidden] { display: none; }
    .dyn-sp--bottom-left { bottom: 16px; left: 16px; }
    .dyn-sp--bottom-right { bottom: 16px; right: 16px; }
    .dyn-sp--top-left { top: 16px; left: 16px; }
    .dyn-sp--top-right { top: 16px; right: 16px; }
    #dynNotiSP-{{ section.id }} .sp-card { position: relative; box-sizing: border-box; display: flex; align-items: center;
      gap: 11px; padding: 11px 13px; border-radius: 18px; text-align: left; pointer-events: auto; cursor: pointer;
      background: rgba(38, 38, 43, {{ section.settings.glass_opacity | default: 55 | divided_by: 100.0 }});
      -webkit-backdrop-filter: blur(30px) saturate(1.6); backdrop-filter: blur(30px) saturate(1.6);
      border: 1px solid rgba(255,255,255,0.14);
      box-shadow: 0 22px 55px -20px rgba(0,0,0,0.62), inset 0 1px 0 rgba(255,255,255,0.16);
      color: #fff; opacity: 0; visibility: hidden;
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease, visibility 0.45s; }
    .dyn-sp--bottom-left .sp-card, .dyn-sp--top-left .sp-card { transform: translateX(-120%); }
    .dyn-sp--bottom-right .sp-card, .dyn-sp--top-right .sp-card { transform: translateX(120%); }
    #dynNotiSP-{{ section.id }} .sp-card.is-in { opacity: 1; visibility: visible; transform: translateX(0); }
    #dynNotiSP-{{ section.id }} .sp-card.is-in:active { transform: translateX(0) scale(0.985); }
    #dynNotiSP-{{ section.id }} .sp-ic { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 11px;
      overflow: hidden; background: #2f2f34; box-shadow: 0 3px 8px rgba(0,0,0,0.28); }
    #dynNotiSP-{{ section.id }} .sp-ic img { width: 100%; height: 100%; object-fit: cover; display: block; }
    #dynNotiSP-{{ section.id }} .sp-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    #dynNotiSP-{{ section.id }} .sp-top { display: flex; align-items: baseline; gap: 8px; }
    #dynNotiSP-{{ section.id }} .sp-title { flex: 1 1 auto; min-width: 0; font-size: 14px; font-weight: 700;
      line-height: 1.25; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #dynNotiSP-{{ section.id }} .sp-time { flex: 0 0 auto; font-size: 11.5px; color: rgba(235,235,245,0.55); font-weight: 500; }
    #dynNotiSP-{{ section.id }} .sp-text { font-size: 13px; line-height: 1.35; color: rgba(235,235,245,0.9);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #dynNotiSP-{{ section.id }} .sp-x { position: absolute; top: -8px; width: 22px; height: 22px; border: none; border-radius: 50%;
      padding: 0; cursor: pointer; display: none; align-items: center; justify-content: center;
      background: rgba(70,70,76,0.92); color: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
    .dyn-sp--bottom-left .sp-x, .dyn-sp--top-left .sp-x { left: -8px; }
    .dyn-sp--bottom-right .sp-x, .dyn-sp--top-right .sp-x { right: -8px; }
    #dynNotiSP-{{ section.id }} .sp-x svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
    #dynNotiSP-{{ section.id }} .sp-card.is-in:hover .sp-x { display: flex; }
    @media (prefers-reduced-motion: reduce) {
      #dynNotiSP-{{ section.id }} .sp-card { transition: opacity 0.2s ease, visibility 0.2s !important; transform: none !important; }
    }
    @media (max-width: 520px) {
      #dynNotiSP-{{ section.id }}.dyn-sp { left: 12px; right: 12px; width: auto; }
      .dyn-sp--bottom-left, .dyn-sp--bottom-right { bottom: 12px; }
      .dyn-sp--top-left, .dyn-sp--top-right { top: 12px; }
    }
  </style>

  <script>
    (function () {
      var root = document.getElementById("dynNotiSP-{{ section.id }}");
      if (!root) return;
      var card = root.querySelector("[data-sp-card]");
      var elTitle = root.querySelector("[data-sp-title]"), elText = root.querySelector("[data-sp-text]");
      var elTime = root.querySelector("[data-sp-time]"), elImg = root.querySelector("[data-sp-img]");
      function readJSON(sel, fb) { var n = root.querySelector(sel); if (!n) return fb; try { return JSON.parse(n.textContent); } catch (e) { return fb; } }
      function toList(v) { if (Array.isArray(v)) return v; return String(v || "").split(/[\n,]+/).map(function (s) { return s.trim(); }).filter(Boolean); }
      var products = readJSON("[data-sp-products]", []), names = toList(readJSON("[data-sp-names]", "")), cities = toList(readJSON("[data-sp-cities]", ""));
      if (!products.length || !names.length || !cities.length) return;
      var verb = root.getAttribute("data-verb") || "purchased", conn = root.getAttribute("data-conn") || "from";
      function num(a, d) { var n = parseFloat(root.getAttribute(a)); return isNaN(n) ? d : n; }
      function span(aMin, aMax, dMin, dMax) { var lo = num(aMin, dMin), hi = num(aMax, dMax); if (hi < lo) { var t = lo; lo = hi; hi = t; } return [lo, hi]; }
      var firstW = span("data-first-min", "data-first-max", 5, 10), showW = span("data-show-min", "data-show-max", 4, 6), gapW = span("data-gap-min", "data-gap-max", 10, 20);
      function rnd(lo, hi) { return lo + Math.random() * (hi - lo); }
      function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
      function firstName(n) { return String(n).trim().split(/\s+/)[0]; }
      var current = null, hideT = null, lastIdx = -1;
      function populate() {
        var idx = Math.floor(Math.random() * products.length);
        if (products.length > 1 && idx === lastIdx) idx = (idx + 1) % products.length;
        lastIdx = idx; var p = products[idx]; current = p;
        var mins = Math.floor(rnd(1, 22));
        elTitle.textContent = firstName(pick(names)) + " " + conn + " " + pick(cities);
        elText.textContent = verb + " " + p.t;
        elTime.textContent = mins <= 1 ? "just now" : mins + "m ago";
        if (p.i) { elImg.src = p.i; elImg.style.display = ""; } else { elImg.removeAttribute("src"); elImg.style.display = "none"; }
      }
      function showOne() {
        populate(); card.classList.add("is-in");
        hideT = setTimeout(function () { card.classList.remove("is-in"); setTimeout(showOne, rnd(gapW[0], gapW[1]) * 1000); }, rnd(showW[0], showW[1]) * 1000);
      }
      card.addEventListener("click", function (e) { if (e.target.closest("[data-sp-x]")) return; if (current && current.u) window.location.href = current.u; });
      card.addEventListener("keydown", function (e) { if ((e.key === "Enter" || e.key === " ") && current && current.u) { e.preventDefault(); window.location.href = current.u; } });
      root.querySelector("[data-sp-x]").addEventListener("click", function (e) { e.stopPropagation(); clearTimeout(hideT); card.classList.remove("is-in"); setTimeout(showOne, rnd(gapW[0], gapW[1]) * 1000); });
      root.hidden = false;
      setTimeout(showOne, rnd(firstW[0], firstW[1]) * 1000);
    })();
  </script>
  {%- endif -%}
{%- endif -%}

<style>
  #dynNoti-{{ section.id }}.dyn-noti { position: fixed; z-index: 2147482000; width: min(384px, calc(100vw - 24px));
    pointer-events: none; -webkit-font-smoothing: antialiased; }
  #dynNoti-{{ section.id }}.dyn-noti[hidden] { display: none; }
  #dynNoti-{{ section.id }} .dnoti-stack { position: relative; width: 100%; }
  /* Corners — the JS grows the pile away from the anchored edge. */
  .dyn-noti--top-right { top: 16px; right: 16px; }
  .dyn-noti--top-left { top: 16px; left: 16px; }
  .dyn-noti--bottom-right { bottom: 16px; right: 16px; }
  .dyn-noti--bottom-left { bottom: 16px; left: 16px; }

  #dynNoti-{{ section.id }} .dnoti-card {
    position: absolute; left: 0; right: 0; box-sizing: border-box;
    display: flex; align-items: flex-start; gap: 12px; padding: 13px 14px;
    border-radius: 20px; text-align: left; pointer-events: auto; cursor: default;
    background: rgba(38, 38, 43, {{ section.settings.glass_opacity | default: 55 | divided_by: 100.0 }});
    -webkit-backdrop-filter: blur(30px) saturate(1.6); backdrop-filter: blur(30px) saturate(1.6);
    border: 1px solid rgba(255,255,255,0.14);
    box-shadow: 0 22px 55px -20px rgba(0,0,0,0.62), inset 0 1px 0 rgba(255,255,255,0.16);
    color: #fff; opacity: 0;
    transform: translateY(-14px) scale(0.94);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
    will-change: transform, opacity; }
  .dyn-noti[data-pos^="bottom"] .dnoti-card { transform: translateY(14px) scale(0.94); }
  #dynNoti-{{ section.id }} .dnoti-card[data-href] { cursor: pointer; }
  #dynNoti-{{ section.id }} .dnoti-card.is-in { opacity: 1; }
  #dynNoti-{{ section.id }} .dnoti-card.is-out {
    opacity: 0 !important; transform: translateX(120%) scale(0.9) !important;
    transition: transform 0.42s cubic-bezier(0.5, 0, 0.75, 0), opacity 0.42s ease !important; }
  .dyn-noti--top-left .dnoti-card.is-out, .dyn-noti--bottom-left .dnoti-card.is-out {
    transform: translateX(-120%) scale(0.9) !important; }

  #dynNoti-{{ section.id }} .dnoti-ic { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    background: var(--tile); box-shadow: 0 3px 8px rgba(0,0,0,0.28); }
  #dynNoti-{{ section.id }} .dnoti-ic img { width: 100%; height: 100%; object-fit: cover; }
  #dynNoti-{{ section.id }} .dnoti-emoji { font-size: 24px; line-height: 1; }
  #dynNoti-{{ section.id }} .dnoti-bell { width: 22px; height: 22px; fill: none; stroke: #fff;
    stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  #dynNoti-{{ section.id }} .dnoti-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  #dynNoti-{{ section.id }} .dnoti-top { display: flex; align-items: baseline; gap: 8px; }
  #dynNoti-{{ section.id }} .dnoti-title { flex: 1 1 auto; min-width: 0; font-size: 15px; font-weight: 700;
    line-height: 1.25; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #dynNoti-{{ section.id }} .dnoti-time { flex: 0 0 auto; font-size: 12.5px; color: rgba(235,235,245,0.6); font-weight: 500; }
  #dynNoti-{{ section.id }} .dnoti-text { font-size: 14px; line-height: 1.35; color: rgba(235,235,245,0.9);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  #dynNoti-{{ section.id }} .dnoti-x { position: absolute; top: -8px; left: -8px; width: 24px; height: 24px;
    border: none; border-radius: 50%; padding: 0; cursor: pointer; display: none; align-items: center; justify-content: center;
    background: rgba(70,70,76,0.92); color: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .dyn-noti--top-right .dnoti-x, .dyn-noti--bottom-right .dnoti-x { left: auto; right: -8px; }
  #dynNoti-{{ section.id }} .dnoti-x svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  #dynNoti-{{ section.id }} .dnoti-card.is-top:hover .dnoti-x,
  #dynNoti-{{ section.id }} .dnoti-stack.is-open .dnoti-card:hover .dnoti-x { display: flex; }
  #dynNoti-{{ section.id }} .dnoti-card[data-href]:active { transform: scale(0.985); }
  /* Piled up: only the front card shows content — the ones behind read as
     blank frosted slivers peeking out (their translucent text would otherwise
     bleed through the front card). They fade back in as the stack fans open. */
  #dynNoti-{{ section.id }} .dnoti-card .dnoti-body,
  #dynNoti-{{ section.id }} .dnoti-card .dnoti-ic { transition: opacity 0.3s ease; }
  #dynNoti-{{ section.id }} .dnoti-stack:not(.is-open) .dnoti-card:not(.is-top) .dnoti-body,
  #dynNoti-{{ section.id }} .dnoti-stack:not(.is-open) .dnoti-card:not(.is-top) .dnoti-ic { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    #dynNoti-{{ section.id }} .dnoti-card { transition: opacity 0.2s ease !important; }
  }
  @media (max-width: 520px) {
    #dynNoti-{{ section.id }}.dyn-noti { left: 12px; right: 12px; width: auto; }
    .dyn-noti--top-right, .dyn-noti--top-left { top: 12px; }
    .dyn-noti--bottom-right, .dyn-noti--bottom-left { bottom: 12px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById("dynNoti-{{ section.id }}");
    if (!root) return;
    var stack = root.querySelector("[data-noti-stack]");
    var cards = [].slice.call(root.querySelectorAll("[data-note]"));
    if (!cards.length) return;

    var pos = root.getAttribute("data-pos") || "top-right";
    var fromBottom = pos.indexOf("bottom") === 0;
    var startDelay = parseInt(root.getAttribute("data-start"), 10) || 0;
    var stagger = parseInt(root.getAttribute("data-stagger"), 10) || 240;
    var autoAll = parseInt(root.getAttribute("data-auto"), 10) || 0;
    var freq = root.getAttribute("data-frequency") || "session";
    var openHover = root.getAttribute("data-open-hover") !== "0";

    var PEEK = 14;      /* how far each buried card peeks out when piled */
    var STEP_SC = 0.05; /* scale drop per layer in the pile */
    var GAP = 12;       /* gap between cards when fanned open */

    /* ---- "already seen" memory ---------------------------------------- */
    var SEEN_KEY = "dyn_noti_seen";
    function readSeen() {
      try {
        var store = freq === "always" ? null : (freq === "once" ? window.localStorage : window.sessionStorage);
        if (!store) return {};
        return JSON.parse(store.getItem(SEEN_KEY) || "{}") || {};
      } catch (e) { return {}; }
    }
    function markSeen(id) {
      try {
        var store = freq === "once" ? window.localStorage : (freq === "always" ? null : window.sessionStorage);
        if (!store) return;
        var s = readSeen(); s[id] = 1; store.setItem(SEEN_KEY, JSON.stringify(s));
      } catch (e) {}
    }
    var seen = readSeen();

    /* A card is skipped if it's "show once" (or the whole feed is once/session)
       and we've recorded it before. */
    var live = cards.filter(function (c) {
      var once = c.getAttribute("data-once") === "1" || freq !== "always";
      if (once && seen[c.getAttribute("data-id")]) { c.parentNode.removeChild(c); return false; }
      return true;
    });
    if (!live.length) return;
    root.hidden = false;

    /* ---- layout: pile vs. fanned-open --------------------------------- */
    var open = false;
    function layout() {
      var y = 0, list = live.slice();
      for (var i = 0; i < list.length; i++) {
        var c = list[i];
        var sign = fromBottom ? -1 : 1;
        if (open) {
          c.style.transform = "translateY(" + (sign * y) + "px) scale(1)";
          c.style.zIndex = String(1000 - i);
          c.style.opacity = c.classList.contains("is-in") ? "1" : "0";
          y += c.offsetHeight + GAP;
        } else {
          /* Piled: front card readable, the rest peek out beyond it, shrinking. */
          var depth = Math.min(i, 4);
          var off = depth * PEEK;
          var sc = Math.max(1 - depth * STEP_SC, 0.8);
          c.style.transform = "translateY(" + (sign * off) + "px) scale(" + sc + ")";
          c.style.zIndex = String(1000 - i);
          if (c.classList.contains("is-in")) c.style.opacity = i > 4 ? "0" : "1";
        }
        c.classList.toggle("is-top", i === 0);
      }
      /* Keep the fixed box tall enough to catch hovers over the whole pile/fan. */
      var h = 0;
      if (open) { for (var k = 0; k < list.length; k++) h += list[k].offsetHeight + GAP; }
      else { h = (list[0] ? list[0].offsetHeight : 0) + Math.min(list.length - 1, 4) * PEEK; }
      stack.style.height = h + "px";
    }

    function setOpen(v) {
      if (open === v) return; open = v;
      stack.classList.toggle("is-open", v);
      layout();
    }

    if (openHover) {
      root.addEventListener("mouseenter", function () { setOpen(true); });
      root.addEventListener("mouseleave", function () { setOpen(false); });
      /* Touch: first tap fans open, taps after that act on the cards. */
      root.addEventListener("click", function (e) {
        if (!open && !e.target.closest("[data-noti-x]")) { setOpen(true); }
      }, true);
    } else {
      setOpen(true);
    }

    /* ---- dismissing --------------------------------------------------- */
    function dismiss(card) {
      markSeen(card.getAttribute("data-id"));
      card.classList.add("is-out");
      var done = false;
      var finish = function () {
        if (done) return; done = true;
        var idx = live.indexOf(card);
        if (idx > -1) live.splice(idx, 1);
        if (card.parentNode) card.parentNode.removeChild(card);
        if (!live.length) { root.hidden = true; return; }
        layout();
      };
      card.addEventListener("transitionend", finish);
      setTimeout(finish, 480);
    }

    live.forEach(function (card) {
      card.querySelector("[data-noti-x]").addEventListener("click", function (e) {
        e.stopPropagation(); dismiss(card);
      });
      var href = card.getAttribute("data-href");
      if (href) {
        card.addEventListener("click", function (e) {
          if (e.target.closest("[data-noti-x]")) return;
          if (openHover && !open) return; /* first tap just opens the fan */
          markSeen(card.getAttribute("data-id"));
          window.location.href = href;
        });
        card.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); markSeen(card.getAttribute("data-id")); window.location.href = href; }
        });
      }
    });

    /* ---- reveal: slide the pile in, one card at a time ---------------- */
    layout();
    var shown = 0;
    function revealNext() {
      if (shown >= live.length) return;
      var card = live[shown];
      var extra = parseInt(card.getAttribute("data-delay"), 10) || 0;
      setTimeout(function () {
        card.classList.add("is-in");
        layout();
        var perAuto = parseInt(card.getAttribute("data-auto"), 10) || autoAll;
        if (perAuto > 0) setTimeout(function () { if (card.parentNode && !open) dismiss(card); }, perAuto);
        shown++;
        revealNext();
      }, (shown === 0 ? startDelay : stagger) + extra);
    }
    revealNext();

    window.addEventListener("resize", layout);
  })();
</script>

