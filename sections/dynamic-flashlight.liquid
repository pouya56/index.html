{% comment %}
  ============================================================================
  Dynamic Flashlight — a spotlight that follows the mouse (or finger) and dims
  the rest of the page, like a torch in the dark.
  ----------------------------------------------------------------------------
  INSTALL: Edit code > Sections > Add a new section > name it
  "dynamic-flashlight" and paste this whole file. Save. Then Customize > (any
  page) > Add section > "Dynamic Flashlight". It's on by default.
  TIP: add ?torch=1 to any page URL to preview it, even without the setting.
  ============================================================================
{% endcomment %}

<div class="dyn-flash" id="dynFlash-{{ section.id }}"
  data-on="{% if section.settings.enabled %}1{% else %}0{% endif %}"
  data-size="{{ section.settings.size | default: 120 }}"
  data-dim="{{ section.settings.dim | default: 62 }}" aria-hidden="true"></div>

<style>
  /* Full-screen, click-through overlay. Hidden until the script switches it on.
     The spotlight gradient itself is built in JS (real pixel values) so there's
     no reliance on CSS custom-property gradients. */
  #dynFlash-{{ section.id }} {
    position: fixed; inset: 0; z-index: 2147483000; pointer-events: none;
    opacity: 0; transition: opacity .25s ease;
  }
  #dynFlash-{{ section.id }}.on { opacity: 1; }
</style>

<script>
(function () {
  var el = document.getElementById("dynFlash-{{ section.id }}");
  if (!el) return;
  var on = el.getAttribute("data-on") === "1" || /[?&]torch=1\b/.test(location.search);
  if (!on) { el.parentNode && el.parentNode.removeChild(el); return; }
  /* Re-parent to <body> so no theme wrapper (transform/filter/contain) can trap
     this fixed overlay in a stacking context and hide it. */
  if (el.parentNode !== document.body) document.body.appendChild(el);
  var size = parseInt(el.getAttribute("data-size") || "120", 10);
  var dim = parseInt(el.getAttribute("data-dim") || "62", 10);
  dim = Math.min(90, Math.max(15, isNaN(dim) ? 62 : dim)) / 100;
  var r = Math.round(size * 1.7);
  var raf = 0, px = (window.innerWidth || 800) / 2, py = (window.innerHeight || 600) / 2;
  function apply() {
    raf = 0;
    el.style.background = "radial-gradient(circle " + r + "px at " + px + "px " + py + "px, " +
      "rgba(0,0,0,0) 0%, rgba(0,0,0,0) 55%, rgba(0,0,0," + dim + ") 100%)";
  }
  apply();
  el.classList.add("on");
  function to(x, y) { if (typeof x !== "number") return; px = x; py = y; if (!raf) raf = requestAnimationFrame(apply); }
  window.addEventListener("pointermove", function (e) { to(e.clientX, e.clientY); }, { passive: true });
  window.addEventListener("pointerdown", function (e) { to(e.clientX, e.clientY); }, { passive: true });
  window.addEventListener("touchmove", function (e) { if (e.touches && e.touches[0]) to(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });
  window.addEventListener("resize", function () { if (!raf) raf = requestAnimationFrame(apply); }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Dynamic Flashlight",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "A spotlight follows the mouse (or finger on phones) and dims the rest of the page. Add this section to any page — it's on by default. Preview tip: add ?torch=1 to any page's URL." },
    { "type": "checkbox", "id": "enabled", "label": "Turn on", "default": true },
    { "type": "range", "id": "size", "label": "Spotlight size", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 120 },
    { "type": "range", "id": "dim", "label": "How dark the rest gets", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 62 }
  ],
  "presets": [ { "name": "Dynamic Flashlight" } ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
