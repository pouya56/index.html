{% comment %}
  ============================================================================
  Dynamic Flashlight — a spotlight that follows the mouse (or finger) and dims
  the rest of the page, like a torch in the dark.
  ----------------------------------------------------------------------------
  SELF-CONTAINED: everything lives in this one file — no asset file needed.
  INSTALL: Edit code > Sections > paste this whole file into
  "dynamic-flashlight.liquid". Save. Then Customize > (any page) >
  Add section > "Dynamic Flashlight" > Save.
  NOTE: inside the Customize preview the effect only appears after you press
  Save and reload the preview — Shopify injects new sections without running
  their scripts. On the real site it works immediately.
  ============================================================================
{% endcomment %}

<div class="dyn-flash" id="dynFlash-{{ section.id }}"
  data-on="{% if section.settings.enabled %}1{% else %}0{% endif %}"
  data-size="{{ section.settings.size | default: 120 }}"
  data-dim="{{ section.settings.dim | default: 60 }}" aria-hidden="true"></div>

<script>
(function () {
  var el = document.getElementById("dynFlash-{{ section.id }}");
  if (!el || el.__flashInit) return;
  el.__flashInit = true;
  var on = el.getAttribute("data-on") === "1" || /[?&]torch=1\b/.test(location.search);
  if (!on) { if (el.parentNode) el.parentNode.removeChild(el); return; }

  /* Re-parent to <body> so no theme wrapper (transform/filter/contain) can trap
     this fixed overlay in a stacking context and hide it. All styling is set
     right here so the effect depends on nothing else. */
  if (el.parentNode !== document.body) document.body.appendChild(el);
  var s = el.style;
  s.position = "fixed";
  s.top = s.left = s.right = s.bottom = "0";
  s.zIndex = "2147483000";
  s.pointerEvents = "none";

  var size = parseInt(el.getAttribute("data-size") || "120", 10);
  var dim = parseInt(el.getAttribute("data-dim") || "60", 10);
  dim = Math.min(90, Math.max(15, isNaN(dim) ? 60 : dim)) / 100;
  var r = Math.round((isNaN(size) ? 120 : size) * 1.7);

  var raf = 0,
      px = (window.innerWidth || 800) / 2,
      py = (window.innerHeight || 600) / 2;

  function apply() {
    raf = 0;
    el.style.background = "radial-gradient(circle " + r + "px at " + px + "px " + py + "px, " +
      "rgba(0,0,0,0) 0%, rgba(0,0,0,0) 55%, rgba(0,0,0," + dim + ") 100%)";
  }
  apply();

  function to(x, y) { if (typeof x !== "number") return; px = x; py = y; if (!raf) raf = requestAnimationFrame(apply); }
  window.addEventListener("pointermove", function (e) { to(e.clientX, e.clientY); }, { passive: true });
  window.addEventListener("pointerdown", function (e) { to(e.clientX, e.clientY); }, { passive: true });
  window.addEventListener("touchmove", function (e) { if (e.touches && e.touches[0]) to(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });
  window.addEventListener("resize", function () { if (!raf) raf = requestAnimationFrame(apply); }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Dynamic Flashlight",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "A spotlight follows the mouse (or finger on phones) and dims the rest of the page. Add this section to any page — it's on by default. In the editor preview it only shows after you Save and reload the preview; on the live site it works right away." },
    { "type": "checkbox", "id": "enabled", "label": "Turn on", "default": true },
    { "type": "range", "id": "size", "label": "Spotlight size", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 120 },
    { "type": "range", "id": "dim", "label": "How dark the rest gets", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 60 }
  ],
  "presets": [ { "name": "Dynamic Flashlight" } ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
