{% comment %}
  ============================================================================
  Dynamic Flat-lay — a collection shown as a knolling flat-lay, not cards.
  ----------------------------------------------------------------------------
  Products sit directly on a shared light surface in varied sizes with tiny
  rotations (they straighten when hovered), like a photographed flat-lay.
  White photo backgrounds melt into the page via multiply blending, so
  white-background product shots read as cut-outs. Each item links to its
  product page with a small museum-style label underneath.

  INSTALL:
  1. Edit code > Sections > Add a new section > name it "dynamic-flatlay" and
     REPLACE its contents with this whole file. Save.
  2. Customize > (any page) > Add section > "Dynamic Flat-lay".
  3. Pick the collection in the section settings. Done.

  TIP: the blend trick works while the background stays LIGHT. If you pick a
  dark background colour, turn "Blend white photo backgrounds" off.
  ============================================================================
{% endcomment %}

<style>
  .dyn-flat { position: relative; padding: clamp(28px, 5vw, 64px) clamp(14px, 3vw, 40px) clamp(48px, 6vw, 90px);
    background: {{ section.settings.bg_color | default: '#e4e4e7' }};
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #1d1d1f; -webkit-font-smoothing: antialiased; }
  .dyn-flat, .dyn-flat *, .dyn-flat *::before, .dyn-flat *::after { box-sizing: border-box; }
  .dyn-flat .fl-head { text-align: center; margin-bottom: clamp(22px, 4vw, 44px); }
  .dyn-flat .fl-head h2 { margin: 0; font-weight: 500; font-size: clamp(26px, 4vw, 44px); letter-spacing: -0.02em; }
  .dyn-flat .fl-head p { margin: 10px auto 0; max-width: 560px; font-size: 15px; line-height: 1.6; color: #6e6e73; }
  /* The lay: an aligned-but-irregular grid, like knolling. */
  .dyn-flat .fl-grid { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: clamp(92px, 11vw, 150px);
    grid-auto-flow: dense; gap: clamp(14px, 2.4vw, 34px); max-width: 1240px; margin: 0 auto; }
  .dyn-flat .fl-item { position: relative; display: grid; grid-template-rows: minmax(0, 1fr) auto;
    text-decoration: none; color: inherit; }
  .dyn-flat .fl-b { grid-column: span 2; grid-row: span 2; }
  .dyn-flat .fl-w { grid-column: span 2; grid-row: span 1; }
  .dyn-flat .fl-t { grid-column: span 1; grid-row: span 2; }
  .dyn-flat .fl-imgwrap { position: relative; min-height: 0; }
  /* The image is pinned inside its cell so it can never spill onto neighbours.
     The tilt lives ON the image (not a wrapper): a transformed ancestor would
     isolate the multiply blend and bring the white boxes back. */
  .dyn-flat .fl-img { position: absolute; inset: 0; margin: auto auto 0; max-width: 94%; max-height: 94%;
    width: auto; height: auto; object-fit: contain; transform: rotate(var(--flr, 0deg));
    transform-origin: 50% 100%; transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .dyn-flat .fl-item:hover .fl-img { transform: rotate(0deg) scale(1.05); }
  /* White photo backgrounds disappear into the light page. */
  .dyn-flat.is-blend .fl-img { mix-blend-mode: multiply; }
  /* Museum label */
  .dyn-flat .fl-label { flex: none; margin-top: 8px; text-align: center; line-height: 1.35; max-width: 100%; }
  .dyn-flat .fl-name { display: block; font-size: 12.5px; font-weight: 600; letter-spacing: 0.01em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dyn-flat .fl-price { display: block; font-size: 11.5px; font-weight: 500; color: #6e6e73; margin-top: 1px; }
  .dyn-flat .fl-item:hover .fl-name { text-decoration: underline; text-underline-offset: 3px; }
  .dyn-flat .fl-soldout { color: #b04a3a; }
  .dyn-flat .fl-empty { max-width: 560px; margin: 0 auto; text-align: center; font-size: 15.5px; line-height: 1.7; color: #6e6e73;
    padding: 40px 16px; }
  @media (max-width: 900px) { .dyn-flat .fl-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 560px) {
    .dyn-flat .fl-grid { grid-template-columns: repeat(3, 1fr); grid-auto-rows: clamp(78px, 22vw, 110px); gap: 12px; }
    .dyn-flat .fl-name { font-size: 11px; }
    .dyn-flat .fl-price { font-size: 10.5px; }
  }
  @media (prefers-reduced-motion: reduce) { .dyn-flat .fl-img { transition: none; transform: none; } }
</style>

{%- assign fl_coll = section.settings.collection -%}
<section class="dyn-flat{% if section.settings.blend %} is-blend{% endif %}" aria-label="{{ section.settings.heading | default: 'Shop' | escape }}">
  {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
    <div class="fl-head">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if fl_coll != blank and fl_coll.products.size > 0 -%}
    {%- comment -%} Deterministic variety: sizes and tilts cycle through fixed
       patterns keyed off each product's position, so the lay looks scattered
       but never changes between visits. b = 2x2, w = 2x1, t = 1x2, s = 1x1. {%- endcomment -%}
    {%- assign fl_pat = "b,s,s,w,s,t,s,s,b,s,t,s,w,s,s,s" | split: "," -%}
    {%- assign fl_rot = "-2.2,1.6,-1.1,2.3,0.6,-1.7,1.2,-0.5,1.9,-1.4" | split: "," -%}
    <div class="fl-grid">
      {%- assign fl_max = section.settings.max_items | default: 24 -%}
      {%- assign shown = 0 -%}
      {%- for p in fl_coll.products limit: 48 -%}
        {%- if shown >= fl_max -%}{%- break -%}{%- endif -%}
        {%- if p.featured_image == blank -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign pi = shown | minus: 1 -%}
        {%- assign pk = pi | modulo: 16 -%}
        {%- assign rk = pi | modulo: 10 -%}
        {%- assign shape = fl_pat[pk] -%}
        <a class="fl-item{% if shape == 'b' %} fl-b{% elsif shape == 'w' %} fl-w{% elsif shape == 't' %} fl-t{% endif %}"
           href="{{ p.url }}" style="--flr: {{ fl_rot[rk] }}deg">
          <span class="fl-imgwrap">
            <img class="fl-img" src="{{ p.featured_image | image_url: width: 640 }}" alt="{{ p.title | escape }}"
                 loading="lazy" width="320" height="320">
          </span>
          <span class="fl-label">
            <span class="fl-name">{{ p.title }}</span>
            {%- if section.settings.show_prices -%}
              <span class="fl-price">{% if p.available %}{{ p.price | money }}{% else %}<span class="fl-soldout">Sold out</span>{% endif %}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="fl-empty">Pick a collection in the section settings and its products will arrange themselves here as a flat-lay.</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Dynamic Flat-lay",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Shows a collection as a knolling flat-lay: products on a shared surface with small labels, instead of cards. Works best with product photos shot on white or transparent backgrounds." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The collection, laid out" },
    { "type": "textarea", "id": "subtext", "label": "Small text under the heading" },
    { "type": "range", "id": "max_items", "label": "Products to show", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_prices", "label": "Show prices", "default": true },
    { "type": "checkbox", "id": "blend", "label": "Blend white photo backgrounds into the page", "default": true, "info": "Makes white-background photos read as cut-outs. Turn OFF if you pick a dark background colour." },
    { "type": "color", "id": "bg_color", "label": "Surface colour", "default": "#e4e4e7" }
  ],
  "presets": [ { "name": "Dynamic Flat-lay" } ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
