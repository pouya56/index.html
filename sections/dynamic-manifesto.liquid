  /* Dims the pinned section behind as the panel rises over it. */
  .mf-scrim { position: fixed; inset: 0; z-index: 5; background: #0a0a0a; opacity: 0; pointer-events: none; }
  /* While a glass hamburger menu is open, the manifesto ducks out so it
     never shows through the frosted panel. */
  .dyn-menu-open .dyn-mf, .dyn-menu-open .mf-scrim { visibility: hidden !important; }

  .mf-text { max-width: 860px; text-align: center; font-weight: 800; text-transform: uppercase;
    font-size: clamp(21px, {{ section.settings.text_size | default: 32 | divided_by: 10.0 }}vw, {{ section.settings.text_size | default: 32 | times: 1.4 }}px);
    line-height: 1.12; letter-spacing: 0.02em; margin: 0; will-change: transform, opacity; }
  .mf-text a { color: inherit; }

  .mf-chips { position: absolute; bottom: 16px; z-index: 2; display: flex; gap: 4px; flex-wrap: wrap; }
  .mf-chips--left { left: 16px; }
  .mf-chips--right { right: 16px; justify-content: flex-end; }
  .mf-chip { display: inline-block; background: #fff; color: #0a0a0a; text-decoration: none;
    font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    line-height: 1; padding: 9px 11px; box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05); }
  .mf-chip:hover { background: #e10600; color: #fff; }
  /* Per-chip device visibility, chosen in the block settings. */
  @media (min-width: 721px) { .mf-chip.mf-hide-d { display: none; } }
  @media (max-width: 720px) { .mf-chip.mf-hide-m { display: none; } }

  /* Phones: corner-anchoring reads as scattered on a narrow screen, so the
     chips leave the corners and stack as tidy rows at the panel's bottom. */
  @media (max-width: 720px) {
    .dyn-mf { flex-direction: column; align-items: stretch; padding: 44px 16px 18px; }
    .mf-text { line-height: 1.18; margin: auto 0; align-self: center; }
    .mf-chips { position: static; }
    .mf-chips--right { justify-content: flex-start; margin-top: 4px; }
  }
</style>

<section class="dyn-mf" id="dynMf-{{ section.id }}">
  <p class="mf-text" id="mfText-{{ section.id }}">{{ section.settings.text | newline_to_br }}</p>

  {%- capture mf_left -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.side == 'left' and block.settings.label != blank -%}
        <a class="mf-chip{% if block.settings.show_desktop == false %} mf-hide-d{% endif %}{% if block.settings.show_mobile == false %} mf-hide-m{% endif %}" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture mf_right -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.side == 'right' and block.settings.label != blank -%}
        <a class="mf-chip{% if block.settings.show_desktop == false %} mf-hide-d{% endif %}{% if block.settings.show_mobile == false %} mf-hide-m{% endif %}" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if mf_left != blank -%}<div class="mf-chips mf-chips--left">{{ mf_left }}</div>{%- endif -%}
  {%- if mf_right != blank -%}<div class="mf-chips mf-chips--right">{{ mf_right }}</div>{%- endif -%}
</section>
<div class="mf-scrim" id="mfScrim-{{ section.id }}" aria-hidden="true"></div>

<script>
(function () {
  var root = document.getElementById("dynMf-{{ section.id }}");
  var scrim = document.getElementById("mfScrim-{{ section.id }}");
  var text = document.getElementById("mfText-{{ section.id }}");
  if (!root) return;
  var wrap = root.closest(".shopify-section") || root;
  var calm = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* Pin the section that comes right before this one: sticky with a top
     offset that parks its bottom edge at the bottom of the screen, so the
     page appears to stand still while the panel scrolls up over it. */
  var prev = wrap.previousElementSibling;
  function pin() {
    if (!prev) return;
    prev.style.position = "sticky";
    prev.style.top = Math.min(0, window.innerHeight - prev.offsetHeight) + "px";
  }

  var raf = 0;
  function ease(t) { return 1 - Math.pow(1 - t, 3); }
  function frame() {
    raf = 0;
    var vh = window.innerHeight;
    var r = root.getBoundingClientRect();
    var p = Math.max(0, Math.min(1, (vh - r.top) / Math.max(1, r.height)));
    if (scrim) {
      scrim.style.opacity = (p * 0.45).toFixed(3);
      scrim.style.display = p > 0 ? "" : "none";
    }
    if (text && !calm) {
      var t = ease(p);
      text.style.transform = "translateY(" + ((1 - t) * 9).toFixed(2) + "vh)";
      text.style.opacity = (0.3 + t * 0.7).toFixed(3);
    }
  }
  function queue() { if (!raf) raf = requestAnimationFrame(frame); }
  function onResize() { pin(); queue(); }

  window.addEventListener("scroll", queue, { passive: true });
  window.addEventListener("resize", onResize, { passive: true });
  window.addEventListener("load", onResize, { passive: true });
  document.addEventListener("shopify:section:load", onResize);
  pin();
  frame();

  /* Hovering a corner chip scrambles its label through random characters,
     locking the real letters back in left to right — decode-style. */
  var fine = window.matchMedia && window.matchMedia("(pointer: fine)").matches;
  if (fine && !calm) {
    var CH = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&@";
    Array.prototype.forEach.call(root.querySelectorAll(".mf-chip"), function (chip) {
      var orig = chip.textContent;
      var sRaf = 0;
      chip.addEventListener("mouseenter", function () {
        /* freeze the chip's width so the shuffle doesn't make it wobble */
        chip.style.minWidth = chip.getBoundingClientRect().width + "px";
        var f = 0;
        cancelAnimationFrame(sRaf);
        /* churn the WHOLE label for a beat first, then lock letters in
           one by one — so even the first word visibly scrambles */
        var HOLD = 14, RATE = 3;
        var step = function () {
          f++;
          var lock = Math.max(0, Math.floor((f - HOLD) / RATE));
          var out = "";
          for (var i = 0; i < orig.length; i++) {
            var c = orig.charAt(i);
            if (c === " ") { out += c; continue; }
            out += i < lock ? c : CH.charAt(Math.floor(Math.random() * CH.length));
          }
          chip.textContent = out;
          if (lock < orig.length) sRaf = requestAnimationFrame(step);
          else chip.textContent = orig;
        };
        sRaf = requestAnimationFrame(step);
      });
      chip.addEventListener("mouseleave", function () {
        cancelAnimationFrame(sRaf);
        chip.textContent = orig;
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Dynamic Manifesto",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "A closing statement on torn black paper: the panel rises over the pinned section before it with a ripped top edge, white torn fibres showing, the black flecked with paper dust — reversible with the scroll, and the content behind dims as it's covered." },
    { "type": "textarea", "id": "text", "label": "Statement", "default": "Born to be personal, made to be yours. Every piece starts blank and leaves one of a kind. A call to make it your own, with no compromise and no concession." },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 20, "max": 48, "step": 2, "default": 32 },
    { "type": "range", "id": "panel_h", "label": "Panel height", "min": 40, "max": 90, "step": 2, "unit": "vh", "default": 66, "info": "66 ≈ two-thirds of the screen." }
  ],
  "blocks": [
    { "type": "chip", "name": "Corner chip", "settings": [
      { "type": "checkbox", "id": "show_desktop", "label": "Show on desktop", "default": true },
      { "type": "checkbox", "id": "show_mobile", "label": "Show on phone", "default": true },
      { "type": "select", "id": "side", "label": "Corner", "default": "left",
        "options": [
          { "value": "left", "label": "Bottom-left" },
          { "value": "right", "label": "Bottom-right" }
        ] },
      { "type": "text", "id": "label", "label": "Text", "default": "Link" },
      { "type": "url", "id": "url", "label": "Link", "info": "Tip: use mailto:hello@yourstore.com for an email chip." }
    ]}
  ],
  "presets": [
    {
      "name": "Dynamic Manifesto",
      "blocks": [
        { "type": "chip", "settings": { "side": "left", "label": "Terms of service" } },
        { "type": "chip", "settings": { "side": "left", "label": "Shipping policy" } },
        { "type": "chip", "settings": { "side": "left", "label": "Size guide" } },
        { "type": "chip", "settings": { "side": "right", "label": "hello@dynaeimic.com", "url": "mailto:hello@dynaeimic.com" } },
        { "type": "chip", "settings": { "side": "right", "label": "Instagram" } }
      ]
    }
  ]
}
{% endschema %}
