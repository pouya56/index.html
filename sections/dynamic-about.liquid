{% comment %}
  ============================================================================
  Dynamic About - premium, editorial About page matching the Dynamic design.
  ----------------------------------------------------------------------------
  INSTALL:
  1. Edit code > Sections > Add a new section > name it "dynamic-about" and
     REPLACE its contents with this whole file. Save.
  2. Online Store > Pages > Add page > title "About". Save.
  3. Customize > (open that page) > Add section > "Dynamic About". Remove the
     default page content. Save.
  4. Everything (story, values, stats, founder note, button) is editable in the
     section settings + blocks. Link /pages/about from your menu / hero.
  ============================================================================
{% endcomment %}

<style>
  .dyn-about {
    --bg: #ffffff; --bg-panel: #f5f5f7;
    --ink: #1d1d1f; --ink-soft: #6e6e73; --ink-faint: #86868b;
    --line: #e3e3e8; --accent: #0071e3;
    --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --serif: "Cormorant Garamond", Georgia, "Times New Roman", Times, serif;
    font-family: var(--font); color: var(--ink); -webkit-font-smoothing: antialiased;
    background: {{ section.settings.bg_color | default: '#ffffff' }};
  }
  .dyn-about, .dyn-about *, .dyn-about *::before, .dyn-about *::after { box-sizing: border-box; }
  .dyn-about .da-wrap { max-width: 1160px; margin: 0 auto; padding: clamp(40px, 7vw, 92px) 22px clamp(48px, 8vw, 100px); }

  /* Intro */
  .dyn-about .da-intro { text-align: center; max-width: 760px; margin: 0 auto; }
  .dyn-about .da-eyebrow { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 14px; }
  .dyn-about .da-intro h1 { font-family: {% if section.settings.heading_font == 'sans' %}var(--font){% else %}var(--serif){% endif %};
    font-weight: 500; font-size: clamp(38px, 7vw, 76px); line-height: 1.02; letter-spacing: -0.015em; margin: 0; }
  .dyn-about .da-intro p { margin: 20px auto 0; font-size: clamp(17px, 2vw, 20px); line-height: 1.6; color: var(--ink-soft); max-width: 620px; }

  .dyn-about .da-hero-media { margin: clamp(36px, 6vw, 64px) 0 0; border-radius: 24px; overflow: hidden; background: var(--bg-panel); }
  .dyn-about .da-hero-media img { display: block; width: 100%; height: auto; }

  /* Story - two columns */
  .dyn-about .da-story { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center;
    margin-top: clamp(56px, 9vw, 120px); }
  .dyn-about .da-story.rev .da-story-media { order: 2; }
  @media (max-width: 800px) { .dyn-about .da-story { grid-template-columns: 1fr; gap: 28px; } .dyn-about .da-story.rev .da-story-media { order: 0; } }
  .dyn-about .da-story-media { border-radius: 22px; overflow: hidden; background: var(--bg-panel); }
  .dyn-about .da-story-media img { display: block; width: 100%; height: auto; }
  .dyn-about .da-story-ph { aspect-ratio: 4 / 3; display: grid; place-items: center; color: var(--ink-faint); font-size: 14px; }
  .dyn-about .da-kicker { font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; }
  .dyn-about .da-story h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(28px, 4vw, 46px); line-height: 1.08; margin: 0 0 16px; }
  .dyn-about .da-rte { font-size: 16.5px; line-height: 1.75; color: #35353b; }
  .dyn-about .da-rte p { margin: 0 0 15px; } .dyn-about .da-rte p:last-child { margin-bottom: 0; }

  /* Stats */
  .dyn-about .da-stats { display: grid; grid-template-columns: repeat({{ section.settings.stats_cols | default: 3 }}, 1fr);
    gap: 20px; margin-top: clamp(56px, 9vw, 110px); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  @media (max-width: 700px) { .dyn-about .da-stats { grid-template-columns: 1fr 1fr; } }
  .dyn-about .da-stat { text-align: center; padding: clamp(26px, 4vw, 40px) 12px; }
  .dyn-about .da-stat + .da-stat { border-left: 1px solid var(--line); }
  @media (max-width: 700px) { .dyn-about .da-stat:nth-child(odd) { border-left: none; } }
  .dyn-about .da-stat-num { font-family: var(--serif); font-weight: 500; font-size: clamp(38px, 6vw, 60px); line-height: 1; letter-spacing: -0.01em; }
  .dyn-about .da-stat-label { margin-top: 10px; font-size: 14px; color: var(--ink-soft); }

  /* Values */
  .dyn-about .da-values-head { text-align: center; max-width: 640px; margin: clamp(64px, 10vw, 128px) auto clamp(28px, 4vw, 48px); }
  .dyn-about .da-values-head h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 5vw, 50px); margin: 0; }
  .dyn-about .da-values-head p { margin: 14px auto 0; color: var(--ink-soft); font-size: 17px; line-height: 1.6; }
  .dyn-about .da-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2.5vw, 28px); }
  @media (max-width: 860px) { .dyn-about .da-values { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .dyn-about .da-values { grid-template-columns: 1fr; } }
  .dyn-about .da-value { background: var(--bg-panel); border-radius: 20px; padding: clamp(22px, 3vw, 30px); }
  .dyn-about .da-value-ic { width: 48px; height: 48px; border-radius: 14px; background: var(--bg); display: grid; place-items: center; margin-bottom: 16px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .dyn-about .da-value-ic svg { width: 24px; height: 24px; fill: none; stroke: var(--ink); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .dyn-about .da-value h3 { font-size: 19px; font-weight: 600; margin: 0 0 8px; }
  .dyn-about .da-value p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }

  /* Founder note */
  .dyn-about .da-founder { margin-top: clamp(64px, 10vw, 128px); text-align: center; max-width: 760px; margin-left: auto; margin-right: auto; }
  .dyn-about .da-quote { font-family: var(--serif); font-size: clamp(24px, 3.6vw, 38px); line-height: 1.3; letter-spacing: -0.01em; margin: 0; }
  .dyn-about .da-quote::before { content: "“"; }
  .dyn-about .da-quote::after { content: "”"; }
  .dyn-about .da-sign { margin-top: 22px; display: inline-flex; flex-direction: column; align-items: center; gap: 4px; }
  .dyn-about .da-sign img { height: 44px; width: auto; }
  .dyn-about .da-sign-name { font-weight: 600; font-size: 16px; }
  .dyn-about .da-sign-role { font-size: 14px; color: var(--ink-faint); }

  /* CTA */
  .dyn-about .da-cta { margin-top: clamp(60px, 9vw, 120px); text-align: center; background: var(--ink); color: #fff;
    border-radius: 28px; padding: clamp(40px, 7vw, 80px) 24px; }
  .dyn-about .da-cta h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(28px, 5vw, 48px); margin: 0 0 10px; }
  .dyn-about .da-cta p { margin: 0 auto 26px; color: rgba(255,255,255,0.72); font-size: 17px; max-width: 460px; }
  .dyn-about .da-cta-btn { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 34px; border-radius: 999px;
    background: #fff; color: var(--ink); font-weight: 500; font-size: 16px; text-decoration: none; transition: transform .1s, opacity .16s; }
  .dyn-about .da-cta-btn:hover { opacity: 0.9; }
  .dyn-about .da-cta-btn:active { transform: scale(0.98); }
</style>

<section class="dyn-about" id="dynAbout">
  <div class="da-wrap">

    <div class="da-intro">
      {%- if section.settings.eyebrow != blank -%}<div class="da-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1>{{ section.settings.heading | default: 'Made for the ones you love' }}</h1>
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
    </div>

    {%- if section.settings.hero_image != blank -%}
      {%- assign hw = 1160 -%}{%- assign hh = section.settings.hero_image.height | times: 1160 | divided_by: section.settings.hero_image.width -%}
      <div class="da-hero-media"><img src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="{{ section.settings.heading | escape }}" width="{{ hw }}" height="{{ hh }}" loading="lazy"></div>
    {%- endif -%}

    {%- if section.settings.story_text != blank or section.settings.story_image != blank -%}
      <div class="da-story{% if section.settings.story_flip %} rev{% endif %}">
        <div class="da-story-media">
          {%- if section.settings.story_image != blank -%}
            {%- assign sh = section.settings.story_image.height | times: 560 | divided_by: section.settings.story_image.width -%}
            <img src="{{ section.settings.story_image | image_url: width: 900 }}" alt="{{ section.settings.story_heading | escape }}" width="560" height="{{ sh }}" loading="lazy">
          {%- else -%}
            <div class="da-story-ph">Add a photo</div>
          {%- endif -%}
        </div>
        <div class="da-story-body">
          {%- if section.settings.story_kicker != blank -%}<div class="da-kicker">{{ section.settings.story_kicker }}</div>{%- endif -%}
          {%- if section.settings.story_heading != blank -%}<h2>{{ section.settings.story_heading }}</h2>{%- endif -%}
          <div class="da-rte">{{ section.settings.story_text }}</div>
        </div>
      </div>
    {%- endif -%}

    {%- assign stat_n = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}{%- assign stat_n = stat_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if stat_n > 0 -%}
      <div class="da-stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="da-stat" {{ block.shopify_attributes }}>
              <div class="da-stat-num">{{ block.settings.number }}</div>
              <div class="da-stat-label">{{ block.settings.label }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign value_n = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'value' -%}{%- assign value_n = value_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if value_n > 0 -%}
      <div class="da-values-head">
        {%- if section.settings.values_heading != blank -%}<h2>{{ section.settings.values_heading }}</h2>{%- endif -%}
        {%- if section.settings.values_intro != blank -%}<p>{{ section.settings.values_intro }}</p>{%- endif -%}
      </div>
      <div class="da-values">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div class="da-value" {{ block.shopify_attributes }}>
              <div class="da-value-ic">
                {%- case block.settings.icon -%}
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-9.5-9A4.5 4.5 0 0 1 12 6a4.5 4.5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z"/></svg>
                  {%- when 'spark' -%}<svg viewBox="0 0 24 24"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/></svg>
                  {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M4 20c8 2 16-4 16-16C10 4 2 10 4 20Z"/><path d="M4 20C8 14 12 11 18 9"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="3.5" y="8" width="17" height="4.5" rx="1"/><path d="M5 12.5V20h14v-7.5"/><path d="M12 8v12"/><path d="M12 8C11 5.5 7.5 5.5 7.5 7.6 7.5 9 9.6 8 12 8Zm0 0c1-2.5 4.5-2.5 4.5-.4C16.5 9 14.4 8 12 8Z"/></svg>
                  {%- when 'star' -%}<svg viewBox="0 0 24 24"><path d="M12 3l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9z"/></svg>
                  {%- when 'brush' -%}<svg viewBox="0 0 24 24"><path d="M4 20c0-3 2-4 4-4 1.5 0 3 1 3 3s-2 3-4 3c-2 0-3-1-3-2Z"/><path d="M11 16 20 7l-3-3-9 9"/></svg>
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24"><rect x="2" y="6" width="12" height="9" rx="1"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>
                  {%- when 'globe' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                {%- endcase -%}
              </div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.quote != blank -%}
      <div class="da-founder">
        <p class="da-quote">{{ section.settings.quote }}</p>
        {%- if section.settings.founder_signature != blank or section.settings.founder_name != blank -%}
          <div class="da-sign">
            {%- if section.settings.founder_signature != blank -%}
              {%- assign sgw = section.settings.founder_signature.width | times: 44 | divided_by: section.settings.founder_signature.height -%}
              <img src="{{ section.settings.founder_signature | image_url: width: 300 }}" alt="{{ section.settings.founder_name | escape }}" width="{{ sgw }}" height="44">
            {%- endif -%}
            {%- if section.settings.founder_name != blank -%}<span class="da-sign-name">{{ section.settings.founder_name }}</span>{%- endif -%}
            {%- if section.settings.founder_role != blank -%}<span class="da-sign-role">{{ section.settings.founder_role }}</span>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_heading != blank -%}
      <div class="da-cta">
        <h2>{{ section.settings.cta_heading }}</h2>
        {%- if section.settings.cta_text != blank -%}<p>{{ section.settings.cta_text }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="da-cta-btn" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Dynamic About",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Big title", "default": "Made for the ones you love" },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph", "default": "Dynaeimic turns everyday gifts into something personal — thoughtfully designed, made to order, and delivered with care." },
    { "type": "select", "id": "heading_font", "label": "Title font", "default": "serif",
      "options": [ { "value": "serif", "label": "Elegant serif" }, { "value": "sans", "label": "Modern sans" } ] },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (optional)" },

    { "type": "header", "content": "Story" },
    { "type": "image_picker", "id": "story_image", "label": "Story photo" },
    { "type": "checkbox", "id": "story_flip", "label": "Put photo on the right", "default": false },
    { "type": "text", "id": "story_kicker", "label": "Kicker", "default": "How it started" },
    { "type": "text", "id": "story_heading", "label": "Heading", "default": "A small idea, a big heart" },
    { "type": "richtext", "id": "story_text", "label": "Story text", "default": "<p>We started Dynaeimic with one belief: a gift should feel like it was made just for the person receiving it. So we built a place where every mug, tee, and keepsake can be personalised in seconds — and crafted to last.</p><p>Today we help thousands of people say the things that matter, in a way they'll keep forever.</p>" },

    { "type": "header", "content": "Stats" },
    { "type": "range", "id": "stats_cols", "min": 2, "max": 4, "step": 1, "label": "Stats per row", "default": 3 },
    { "type": "paragraph", "content": "Add 'Stat' blocks below (e.g. 10k+ happy customers)." },

    { "type": "header", "content": "Values" },
    { "type": "text", "id": "values_heading", "label": "Values heading", "default": "What we stand for" },
    { "type": "textarea", "id": "values_intro", "label": "Values intro", "default": "The principles behind everything we make." },
    { "type": "paragraph", "content": "Add 'Value' blocks below (icon + title + text)." },

    { "type": "header", "content": "Founder note (optional)" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Every order is someone's way of saying 'I thought of you.' That's what we protect, every single day." },
    { "type": "image_picker", "id": "founder_signature", "label": "Signature image (optional)" },
    { "type": "text", "id": "founder_name", "label": "Name", "default": "Pouya Naeimi" },
    { "type": "text", "id": "founder_role", "label": "Role", "default": "Founder, Dynaeimic" },

    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Find the perfect gift" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Personalise something they'll never forget." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Shop all" },
    { "type": "url", "id": "cta_url", "label": "Button link" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "10k+" },
      { "type": "text", "id": "label", "label": "Label", "default": "Happy customers" }
    ]},
    { "type": "value", "name": "Value", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "heart",
        "options": [
          { "value": "heart", "label": "Heart" }, { "value": "spark", "label": "Sparkle" }, { "value": "leaf", "label": "Leaf / eco" },
          { "value": "shield", "label": "Shield / quality" }, { "value": "gift", "label": "Gift" }, { "value": "star", "label": "Star" },
          { "value": "brush", "label": "Brush / design" }, { "value": "truck", "label": "Delivery" }, { "value": "globe", "label": "Globe" }
        ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Made to order" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Nothing sits in a warehouse. Each piece is created for you, only after you order it." }
    ]}
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Dynamic About",
      "blocks": [
        { "type": "stat", "settings": { "number": "10k+", "label": "Happy customers" } },
        { "type": "stat", "settings": { "number": "4.9★", "label": "Average rating" } },
        { "type": "stat", "settings": { "number": "48h", "label": "Made & shipped" } },
        { "type": "value", "settings": { "icon": "brush", "title": "Personal by design", "text": "Every product can be customised in seconds — names, photos, messages, colours." } },
        { "type": "value", "settings": { "icon": "shield", "title": "Built to last", "text": "Premium materials and prints that survive daily life, not just the unboxing." } },
        { "type": "value", "settings": { "icon": "heart", "title": "Made with care", "text": "Real people check every order before it heads out the door." } }
      ]
    }
  ],
  "enabled_on": { "templates": ["page", "index"] }
}
{% endschema %}
