{% comment %}
  ============================================================================
  Dynamic About — fashion-editorial About page (Mira-style).
  ----------------------------------------------------------------------------
  INSTALL:
  1. Edit code > Sections > dynamic-about.liquid > REPLACE contents with this
     whole file. Save.
  2. Online Store > Pages > "About" (create it if needed). Save.
  3. Customize > open that page > Add section > "Dynamic About".
  4. Everything (headline, marquee, mission, stats, values, team, CTA) is
     editable in the section settings + blocks.
  ============================================================================
{% endcomment %}

<style>
  .dyn-about {
    --bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --panel: #f5f5f7; --ink: #111113; --ink-soft: #6e6e73; --ink-faint: #98989d;
    --line: #e5e5ea; --accent: #0071e3;
    --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-family: var(--font); color: var(--ink); background: var(--bg);
    -webkit-font-smoothing: antialiased; overflow: clip;
  }
  .dyn-about, .dyn-about *, .dyn-about *::before, .dyn-about *::after { box-sizing: border-box; }
  .dyn-about .ab-wrap { max-width: 1240px; margin: 0 auto; padding: 0 22px; }

  /* Scroll reveal */
  .dyn-about .ab-rev { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .dyn-about .ab-rev.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .dyn-about .ab-rev { opacity: 1; transform: none; transition: none; } }

  /* ---- Hero: eyebrow + giant uppercase statement + full-bleed image ---- */
  .dyn-about .ab-hero { text-align: center; padding: clamp(52px, 9vw, 120px) 0 0; }
  .dyn-about .ab-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 12px;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-soft); }
  .dyn-about .ab-eyebrow::before, .dyn-about .ab-eyebrow::after { content: ""; width: 26px; height: 1px; background: var(--line); }
  .dyn-about .ab-hero h1 { margin: 18px 0 0; font-weight: 800; text-transform: uppercase;
    font-size: clamp(44px, 9.5vw, 128px); line-height: 0.96; letter-spacing: -0.025em; }
  .dyn-about .ab-hero h1 .ab-l2 { display: block; color: transparent; -webkit-text-stroke: 1.5px var(--ink); }
  .dyn-about .ab-hero-sub { margin: 22px auto 0; max-width: 560px; font-size: clamp(16px, 1.9vw, 19px);
    line-height: 1.65; color: var(--ink-soft); }
  .dyn-about .ab-hero-media { margin-top: clamp(40px, 6vw, 72px); border-radius: 20px; overflow: hidden; background: var(--panel); }
  .dyn-about .ab-hero-media img { display: block; width: 100%; height: auto; }
  .dyn-about .ab-hero-ph { aspect-ratio: 21 / 9; display: grid; place-items: center; color: var(--ink-faint); font-size: 14px; }

  /* ---- Marquee ---- */
  .dyn-about .ab-marquee { margin-top: clamp(48px, 8vw, 96px); background: #111113; color: #fff;
    overflow: hidden; padding: 18px 0; transform: rotate(-1.2deg) scale(1.02); }
  .dyn-about .ab-marquee-track { display: flex; width: max-content; animation: abMarq 26s linear infinite; }
  .dyn-about .ab-marquee span.ab-run { display: inline-flex; align-items: center; gap: 26px; padding-right: 26px;
    font-weight: 800; text-transform: uppercase; font-size: clamp(16px, 2.4vw, 24px); letter-spacing: 0.06em; white-space: nowrap; }
  .dyn-about .ab-marquee i { font-style: normal; color: transparent; -webkit-text-stroke: 1px #fff; }
  .dyn-about .ab-marquee .ab-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex: none; display: inline-block; }
  @keyframes abMarq { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .dyn-about .ab-marquee-track { animation: none; } }

  /* ---- Mission: kicker + statement | copy ---- */
  .dyn-about .ab-mission { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(30px, 6vw, 90px);
    align-items: start; padding: clamp(64px, 10vw, 140px) 0 0; }
  @media (max-width: 820px) { .dyn-about .ab-mission { grid-template-columns: 1fr; } }
  .dyn-about .ab-kicker { display: inline-block; font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 16px; }
  .dyn-about .ab-mission h2 { margin: 0; font-weight: 800; text-transform: uppercase;
    font-size: clamp(30px, 4.6vw, 58px); line-height: 1.02; letter-spacing: -0.02em; }
  .dyn-about .ab-mission-copy p { margin: 0 0 16px; font-size: clamp(16px, 1.9vw, 18.5px); line-height: 1.75; color: #3a3a40; }
  .dyn-about .ab-mission-copy p:last-child { margin-bottom: 0; }
  .dyn-about .ab-mission-media { margin-top: clamp(40px, 6vw, 70px); display: grid;
    grid-template-columns: 1.4fr 1fr; gap: clamp(14px, 2.5vw, 24px); align-items: end; }
  @media (max-width: 640px) { .dyn-about .ab-mission-media { grid-template-columns: 1fr; } }
  .dyn-about .ab-mission-media figure { margin: 0; border-radius: 18px; overflow: hidden; background: var(--panel); }
  .dyn-about .ab-mission-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .dyn-about .ab-mm-a { aspect-ratio: 4 / 3; }
  .dyn-about .ab-mm-b { aspect-ratio: 3 / 4; }
  .dyn-about .ab-mission-ph { display: grid; place-items: center; color: var(--ink-faint); font-size: 14px; height: 100%; }

  /* ---- Stats ---- */
  .dyn-about .ab-stats { margin-top: clamp(64px, 10vw, 130px); border-top: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .dyn-about .ab-stat { padding: clamp(30px, 4.5vw, 52px) 18px; text-align: center; border-bottom: 1px solid var(--line); }
  .dyn-about .ab-stat + .ab-stat { border-left: 1px solid var(--line); }
  @media (max-width: 640px) { .dyn-about .ab-stat:nth-child(odd) { border-left: none; } }
  .dyn-about .ab-stat-num { font-weight: 800; font-size: clamp(40px, 6.5vw, 72px); line-height: 1; letter-spacing: -0.03em; }
  .dyn-about .ab-stat-num small { font-size: 0.55em; font-weight: 800; vertical-align: 0.35em; margin-left: 2px; }
  .dyn-about .ab-stat-label { margin-top: 12px; font-size: 12.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }

  /* ---- Values: numbered cards ---- */
  .dyn-about .ab-values { padding-top: clamp(64px, 10vw, 140px); }
  .dyn-about .ab-values-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: clamp(26px, 4vw, 44px); }
  .dyn-about .ab-values h2, .dyn-about .ab-team-center h2, .dyn-about .ab-cta h2 { margin: 0; font-weight: 800; text-transform: uppercase;
    font-size: clamp(28px, 4.2vw, 54px); line-height: 1.02; letter-spacing: -0.02em; }
  .dyn-about .ab-values-intro { max-width: 320px; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  @media (max-width: 700px) { .dyn-about .ab-values-head { flex-direction: column; align-items: flex-start; } }
  .dyn-about .ab-values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 2vw, 20px); }
  @media (max-width: 900px) { .dyn-about .ab-values-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .dyn-about .ab-values-grid { grid-template-columns: 1fr; } }
  .dyn-about .ab-value { background: var(--panel); border-radius: 20px; padding: clamp(24px, 3.5vw, 38px);
    transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .dyn-about .ab-value:hover { transform: translateY(-5px); box-shadow: 0 24px 44px -24px rgba(17, 17, 19, 0.22); }
  .dyn-about .ab-value-num { font-size: 13px; font-weight: 800; letter-spacing: 0.14em; color: var(--ink-faint); }
  .dyn-about .ab-value h3 { margin: 46px 0 10px; font-size: clamp(19px, 2.3vw, 24px); font-weight: 700; letter-spacing: -0.01em; text-transform: uppercase; }
  .dyn-about .ab-value p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--ink-soft); }

  /* ---- Team: scroll-driven sticker collage ----
     A tall scroll runway with a sticky full-screen stage. As the shopper
     scrolls, each photo flies in from an edge like a sticker and settles
     toward the middle — by the end the pile covers the heading. */
  .dyn-about .ab-team-scroll { position: relative; height: 300vh; margin-top: clamp(64px, 10vw, 140px); }
  .dyn-about .ab-team-stage { position: sticky; top: 0; height: 100vh; height: 100svh;
    overflow: hidden; display: grid; place-items: center; }
  .dyn-about .ab-team-center { text-align: center; max-width: 620px; padding: 0 22px; }
  .dyn-about .ab-team-sub { margin: 14px auto 0; max-width: 460px; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  .dyn-about .ab-sticker { position: absolute; left: 50%; top: 50%; width: clamp(130px, 17vw, 225px);
    background: #fff; padding: 9px 9px 11px; border-radius: 14px;
    box-shadow: 0 18px 42px -16px rgba(17, 17, 19, 0.4), 0 0 0 1px rgba(17, 17, 19, 0.04);
    transform: translate(-50%, -50%); will-change: transform; }
  .dyn-about .ab-sticker figure { margin: 0; border-radius: 8px; overflow: hidden; aspect-ratio: 3 / 4; background: var(--panel); }
  .dyn-about .ab-sticker img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .dyn-about .ab-sticker-ph { display: grid; place-items: center; height: 100%; font-weight: 800; font-size: 36px; color: #d3d3d9; }
  .dyn-about .ab-sticker-cap { display: block; margin-top: 8px; text-align: center; font-size: 12px; font-weight: 700; letter-spacing: 0.01em; }
  .dyn-about .ab-sticker-cap small { display: block; font-weight: 600; font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); margin-top: 2px; }
  @media (prefers-reduced-motion: reduce) { .dyn-about .ab-team-scroll { height: auto; padding: 40px 0; }
    .dyn-about .ab-team-stage { position: static; height: auto; min-height: 80vh; } }

  /* ---- CTA ---- */
  .dyn-about .ab-cta { margin: clamp(70px, 11vw, 150px) 0 0; padding: clamp(56px, 9vw, 110px) 22px;
    background: #111113; color: #fff; text-align: center; border-radius: 28px 28px 0 0; }
  .dyn-about .ab-cta h2 { font-size: clamp(34px, 6.5vw, 84px); }
  .dyn-about .ab-cta h2 .ab-l2 { display: block; color: transparent; -webkit-text-stroke: 1.5px #fff; }
  .dyn-about .ab-cta p { margin: 18px auto 0; max-width: 460px; font-size: 16px; line-height: 1.6; color: rgba(255, 255, 255, 0.66); }
  .dyn-about .ab-cta-btn { display: inline-flex; align-items: center; gap: 10px; margin-top: 30px;
    padding: 16px 30px; border-radius: 999px; background: #fff; color: #111113; font-weight: 700; font-size: 15px;
    text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .dyn-about .ab-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 16px 34px -14px rgba(255, 255, 255, 0.45); }
  .dyn-about .ab-cta-btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
</style>

<section class="dyn-about" id="dynAbout">

  <!-- Hero -->
  <div class="ab-wrap">
    <header class="ab-hero">
      <span class="ab-eyebrow ab-rev">{{ section.settings.eyebrow | default: 'About us' }}</span>
      <h1 class="ab-rev">
        {{ section.settings.heading1 | default: 'Made for the' }}
        <span class="ab-l2">{{ section.settings.heading2 | default: 'ones you love' }}</span>
      </h1>
      {%- if section.settings.intro != blank -%}
        <p class="ab-hero-sub ab-rev">{{ section.settings.intro }}</p>
      {%- endif -%}
      {%- if section.settings.hero_image != blank -%}
        <div class="ab-hero-media ab-rev">
          <img src="{{ section.settings.hero_image | image_url: width: 2200 }}"
            srcset="{{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 2200 }} 2200w"
            sizes="(max-width: 1240px) 96vw, 1200px" alt="{{ shop.name | escape }}"
            width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" loading="lazy">
        </div>
      {%- else -%}
        <div class="ab-hero-media ab-rev"><div class="ab-hero-ph">Add a wide photo in the section settings</div></div>
      {%- endif -%}
    </header>
  </div>

  <!-- Marquee -->
  {%- assign mq = section.settings.marquee | default: 'Personalised gifts' -%}
  {%- assign mq2 = section.settings.marquee2 | default: 'Made to order' -%}
  <div class="ab-marquee" aria-hidden="true">
    <div class="ab-marquee-track">
      {%- for i in (1..2) -%}
        <span class="ab-run">
          {%- for j in (1..4) -%}
            {{ mq }} <span class="ab-dot"></span> <i>{{ mq2 }}</i> <span class="ab-dot"></span>
          {%- endfor -%}
        </span>
      {%- endfor -%}
    </div>
  </div>

  <div class="ab-wrap">

    <!-- Mission -->
    <div class="ab-mission">
      <div class="ab-rev">
        <span class="ab-kicker">{{ section.settings.mission_kicker | default: 'Our mission' }}</span>
        <h2>{{ section.settings.mission_heading | default: 'A gift should feel like it was made just for them' }}</h2>
      </div>
      <div class="ab-mission-copy ab-rev">{{ section.settings.mission_text | default: '<p>We started Dynaeimic with one belief: the best gifts carry a piece of the person giving them.</p>' }}</div>
    </div>
    {%- if section.settings.mission_image1 != blank or section.settings.mission_image2 != blank -%}
      <div class="ab-mission-media ab-rev">
        <figure class="ab-mm-a">
          {%- if section.settings.mission_image1 != blank -%}
            <img src="{{ section.settings.mission_image1 | image_url: width: 1400 }}" alt="" loading="lazy"
              width="{{ section.settings.mission_image1.width }}" height="{{ section.settings.mission_image1.height }}">
          {%- else -%}<div class="ab-mission-ph">Photo</div>{%- endif -%}
        </figure>
        <figure class="ab-mm-b">
          {%- if section.settings.mission_image2 != blank -%}
            <img src="{{ section.settings.mission_image2 | image_url: width: 1000 }}" alt="" loading="lazy"
              width="{{ section.settings.mission_image2.width }}" height="{{ section.settings.mission_image2.height }}">
          {%- else -%}<div class="ab-mission-ph">Photo</div>{%- endif -%}
        </figure>
      </div>
    {%- endif -%}

    <!-- Stats -->
    {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
    {%- if stat_blocks.size > 0 -%}
      <div class="ab-stats ab-rev">
        {%- for b in stat_blocks -%}
          <div class="ab-stat" {{ b.shopify_attributes }}>
            <div class="ab-stat-num" data-count="{{ b.settings.number | default: 0 }}">
              <span class="ab-n">{{ b.settings.number | default: 0 }}</span><small>{{ b.settings.suffix }}</small>
            </div>
            <div class="ab-stat-label">{{ b.settings.label | default: 'Label' }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Values -->
    {%- assign value_blocks = section.blocks | where: 'type', 'value' -%}
    {%- if value_blocks.size > 0 -%}
      <div class="ab-values">
        <div class="ab-values-head ab-rev">
          <h2>{{ section.settings.values_heading | default: 'What we stand for' }}</h2>
          {%- if section.settings.values_intro != blank -%}
            <div class="ab-values-intro">{{ section.settings.values_intro }}</div>
          {%- endif -%}
        </div>
        <div class="ab-values-grid">
          {%- for b in value_blocks -%}
            <div class="ab-value ab-rev" {{ b.shopify_attributes }}>
              <span class="ab-value-num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <h3>{{ b.settings.title | default: 'Value' }}</h3>
              <p>{{ b.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>

  <!-- Team: sticker collage. Scrolling drives the photos in from the sides
       until they pile over the heading. -->
  {%- assign team_blocks = section.blocks | where: 'type', 'member' -%}
  {%- if team_blocks.size > 0 -%}
    <div class="ab-team-scroll" id="abTeamScroll">
      <div class="ab-team-stage">
        <div class="ab-team-center">
          <h2>{{ section.settings.team_heading | default: 'The people behind it' }}</h2>
          {%- if section.settings.team_sub != blank -%}
            <p class="ab-team-sub">{{ section.settings.team_sub }}</p>
          {%- endif -%}
        </div>
        {%- for b in team_blocks -%}
          <div class="ab-sticker" {{ b.shopify_attributes }}>
            <figure>
              {%- if b.settings.photo != blank -%}
                <img src="{{ b.settings.photo | image_url: width: 700 }}" alt="{{ b.settings.name | escape }}" loading="lazy"
                  width="{{ b.settings.photo.width }}" height="{{ b.settings.photo.height }}">
              {%- else -%}
                <div class="ab-sticker-ph">{{ b.settings.name | default: '?' | slice: 0 | upcase }}</div>
              {%- endif -%}
            </figure>
            {%- if b.settings.name != blank -%}
              <span class="ab-sticker-cap">{{ b.settings.name }}
                {%- if b.settings.role != blank -%}<small>{{ b.settings.role }}</small>{%- endif -%}
              </span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <!-- CTA -->
  <div class="ab-wrap" style="padding: 0 0;">
    <div class="ab-cta ab-rev">
      <h2>
        {{ section.settings.cta_heading1 | default: 'Say it' }}
        <span class="ab-l2">{{ section.settings.cta_heading2 | default: 'your way' }}</span>
      </h2>
      {%- if section.settings.cta_text != blank -%}<p>{{ section.settings.cta_text }}</p>{%- endif -%}
      <a class="ab-cta-btn" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_label | default: 'Start personalising' }}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
    </div>
  </div>

  <script>
  (function () {
    /* Reveal on scroll + count-up stats. */
    var root = document.getElementById("dynAbout");
    if (!root) return;
    var reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
    var revs = root.querySelectorAll(".ab-rev");
    if (!("IntersectionObserver" in window) || reduce) {
      Array.prototype.forEach.call(revs, function (el) { el.classList.add("is-in"); });
    } else {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        });
      }, { threshold: 0.12 });
      Array.prototype.forEach.call(revs, function (el) { io.observe(el); });
    }
    /* Count the stats up from 0 the first time they scroll into view. */
    var nums = root.querySelectorAll(".ab-stat-num");
    function animateNum(el) {
      var target = parseFloat(el.getAttribute("data-count")) || 0;
      var span = el.querySelector(".ab-n");
      if (!span || reduce || target <= 0) return;
      var t0 = null, dur = 1400;
      function step(ts) {
        if (!t0) t0 = ts;
        var p = Math.min(1, (ts - t0) / dur);
        var eased = 1 - Math.pow(1 - p, 3);
        var v = target * eased;
        span.textContent = target % 1 === 0 ? Math.round(v).toLocaleString() : v.toFixed(1);
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    if (!("IntersectionObserver" in window) || reduce) return;
    var io2 = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        animateNum(e.target);
        io2.unobserve(e.target);
      });
    }, { threshold: 0.4 });
    Array.prototype.forEach.call(nums, function (el) { io2.observe(el); });
  })();
  (function () {
    /* Sticker collage: scroll progress flies each photo in from an edge
       and settles it near the middle; the pile ends up covering the
       heading. Deterministic per index — no randomness, no jumps. */
    var scroller = document.getElementById("abTeamScroll");
    if (!scroller) return;
    var sts = scroller.querySelectorAll(".ab-sticker");
    if (!sts.length) return;
    var reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
    /* Final resting spots (x in vw, y in vh, from center) — first spots ring
       the heading, later ones close in over it. */
    var SPOTS = [[-32, -26], [30, -28], [-34, 20], [32, 22], [-14, -32], [16, 30],
      [-30, -2], [30, -3], [-8, 26], [10, -26], [-18, 8], [18, 6], [-4, -10], [6, 12], [0, 0]];
    var els = Array.prototype.map.call(sts, function (el, i) {
      var s = SPOTS[i % SPOTS.length];
      var wob = (Math.floor(i / SPOTS.length) % 2) ? -4 : 3;
      return { el: el, fx: s[0] + (i >= SPOTS.length ? wob : 0), fy: s[1] + (i >= SPOTS.length ? wob : 0),
        rot: ((i * 47) % 25) - 12, dir: i % 4 };
    });
    function place(p) {
      var n = els.length;
      els.forEach(function (s, i) {
        var start = n > 1 ? (i / n) * 0.72 : 0;
        var lp = Math.min(1, Math.max(0, (p - start) / 0.28));
        var e = 1 - Math.pow(1 - lp, 3);
        var sx = s.dir === 0 ? -80 : s.dir === 1 ? 80 : s.fx * 1.6;
        var sy = s.dir === 2 ? -80 : s.dir === 3 ? 80 : s.fy * 1.6;
        var x = sx + (s.fx - sx) * e;
        var y = sy + (s.fy - sy) * e;
        var rot = s.rot * (2 - e);
        s.el.style.transform = "translate(-50%, -50%) translate(" + x.toFixed(2) + "vw, " + y.toFixed(2) + "vh) rotate(" + rot.toFixed(2) + "deg)";
      });
    }
    if (reduce) { place(1); return; }
    var tick = false;
    function onScroll() {
      if (tick) return;
      tick = true;
      requestAnimationFrame(function () {
        tick = false;
        var r = scroller.getBoundingClientRect();
        var total = r.height - innerHeight;
        place(total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1);
      });
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    onScroll();
  })();
  </script>
</section>

{% schema %}
{
  "name": "Dynamic About",
  "tag": "section",
  "class": "dynamic-about-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "About us" },
    { "type": "text", "id": "heading1", "label": "Headline line 1 (solid)", "default": "Made for the" },
    { "type": "text", "id": "heading2", "label": "Headline line 2 (outlined)", "default": "ones you love" },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph", "default": "Dynaeimic turns everyday gifts into something personal — thoughtfully designed, made to order, and delivered with care." },
    { "type": "image_picker", "id": "hero_image", "label": "Wide hero photo" },

    { "type": "header", "content": "Marquee strip" },
    { "type": "text", "id": "marquee", "label": "Solid words", "default": "Personalised gifts" },
    { "type": "text", "id": "marquee2", "label": "Outlined words", "default": "Made to order" },

    { "type": "header", "content": "Mission" },
    { "type": "text", "id": "mission_kicker", "label": "Kicker", "default": "Our mission" },
    { "type": "text", "id": "mission_heading", "label": "Statement", "default": "A gift should feel like it was made just for them" },
    { "type": "richtext", "id": "mission_text", "label": "Copy", "default": "<p>We started Dynaeimic with one belief: the best gifts carry a piece of the person giving them. So we built a place where every mug, tee and keepsake can be personalised in seconds — designed by you, crafted by us, and delivered with care.</p><p>Today we help thousands of people say the things that matter, in a way they’ll keep forever.</p>" },
    { "type": "image_picker", "id": "mission_image1", "label": "Photo (landscape)" },
    { "type": "image_picker", "id": "mission_image2", "label": "Photo (portrait)" },

    { "type": "header", "content": "Values" },
    { "type": "text", "id": "values_heading", "label": "Heading", "default": "What we stand for" },
    { "type": "textarea", "id": "values_intro", "label": "Short intro (right side)", "default": "The principles behind everything we make." },

    { "type": "header", "content": "Team — sticker collage" },
    { "type": "paragraph", "content": "Add a \u2018Team member\u2019 block per photo (photo only is fine — name and role are optional). While scrolling, the photos fly in from the sides and pile over the heading." },
    { "type": "text", "id": "team_heading", "label": "Heading", "default": "The people behind it" },
    { "type": "textarea", "id": "team_sub", "label": "Subtitle", "default": "A small team that cares about every single order." },

    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_heading1", "label": "CTA line 1 (solid)", "default": "Say it" },
    { "type": "text", "id": "cta_heading2", "label": "CTA line 2 (outlined)", "default": "your way" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Personalise something they’ll never forget — designed by you in minutes." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Start personalising" },
    { "type": "url", "id": "cta_url", "label": "Button link" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "stat", "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number (counts up)", "default": "10000" },
        { "type": "text", "id": "suffix", "label": "Suffix (e.g. +, %, ★)", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy customers" }
      ]
    },
    {
      "type": "value", "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Made with care" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every order is printed, checked and packed by hand before it ships." }
      ]
    },
    {
      "type": "member", "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo (portrait)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Name" },
        { "type": "text", "id": "role", "label": "Role", "default": "Role" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic About",
      "blocks": [
        { "type": "stat", "settings": { "number": "10000", "suffix": "+", "label": "Gifts personalised" } },
        { "type": "stat", "settings": { "number": "50", "suffix": "+", "label": "Countries delivered" } },
        { "type": "stat", "settings": { "number": "4.9", "suffix": "★", "label": "Average rating" } },
        { "type": "value", "settings": { "title": "Made with care", "text": "Every order is printed, checked and packed by hand before it ships." } },
        { "type": "value", "settings": { "title": "Yours, truly", "text": "Your design, your words — no two pieces we make are the same." } },
        { "type": "value", "settings": { "title": "Built to last", "text": "Materials and prints chosen to survive years of everyday love." } },
        { "type": "member", "settings": { "name": "Pouya Naeimi", "role": "Founder" } },
        { "type": "member", "settings": { "name": "", "role": "" } },
        { "type": "member", "settings": { "name": "", "role": "" } },
        { "type": "member", "settings": { "name": "", "role": "" } },
        { "type": "member", "settings": { "name": "", "role": "" } },
        { "type": "member", "settings": { "name": "", "role": "" } }
      ]
    }
  ]
}
{% endschema %}
