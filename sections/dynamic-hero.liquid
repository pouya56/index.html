{ "type": "text", "id": "heading", "label": "Heading override", "info": "Leave empty to use the collection title." },
{ "type": "image_picker", "id": "heading_logo", "label": "Logo instead of heading", "info": "Leave blank to use the logo from Theme settings → Logo (uploaded once for the whole site)." },
{ "type": "range", "id": "logo_width", "label": "Hero logo width", "min": 60, "max": 400, "step": 5, "unit": "px", "default": 200, "info": "Only this hero logo uses this size — every other page follows Theme settings → Logo → Custom logo width." },
{ "type": "video", "id": "head_video", "label": "Video instead of logo", "info": "Plays muted on loop in place of the logo/heading. Takes priority over the logo when set." },
{ "type": "url", "id": "head_link", "label": "Link for the logo / video", "info": "Optional. Makes the logo/video/heading clickable — e.g. link it to your home page or a featured collection." },
{ "type": "color", "id": "bg_color", "label": "Background colour", "default": "#f5f5f7", "info": "The hero's surface colour. Also shows behind a background image while it loads, or through a low veil." },
{ "type": "image_picker", "id": "bg_image", "label": "Background image", "info": "Fills the whole hero behind everything. Landscape ~2400px wide works best." },
{ "type": "header", "content": "Living words background" },
{ "type": "checkbox", "id": "words_bg", "label": "Show the word field", "default": false, "info": "Giant brand words drift diagonally behind the logo, search bar and buttons. Hovering a word pauses its row and features it; words near the cursor drift away softly." },
{ "type": "select", "id": "words_style", "label": "Field style", "default": "drift",
"options": [
{ "value": "drift", "label": "Drifting giant words" },
{ "value": "labels", "label": "Floating label strips (poster)" },
{ "value": "smear", "label": "Blurred poster (smeared ink)" },
{ "value": "wall", "label": "Text wall (red poster)" }
], "info": "Text wall packs your words edge to edge on worn red, flowing around the search bar, logo and buttons; hover lights a word white, click sends it to the search bar. Phones: tap to reveal, tap again to send." },
{ "type": "textarea", "id": "words_list", "label": "Words (one per line or comma-separated)", "default": "PERSONALIZED,CUSTOM,CREATE,DESIGN,GIFTS,MEMORIES,UNIQUE,YOURS,MUGS,NOTEBOOKS,APPAREL,EMBROIDERY,PRINTING,ENGRAVED,CORPORATE,WEDDING,PREMIUM" },
{ "type": "range", "id": "words_opacity", "label": "Word strength", "min": 3, "max": 100, "step": 1, "unit": "%", "default": 5 },
{ "type": "header", "content": "ASCII art background" },
{ "type": "select", "id": "ascii_bg", "label": "ASCII background", "default": "none",
"options": [
{ "value": "none", "label": "Off" },
{ "value": "torus", "label": "Spinning 3D ring" },
{ "value": "image", "label": "My image, drawn in characters" },
{ "value": "dither", "label": "Green dither filter (terminal)" }
], "info": "A retro terminal visual behind the hero. The ring spins with the cursor; the character mode shimmers near it; the dither filter renders your image as flickering pixel-dither with scanlines, vignette, bloom, grain and glitch — set the character colour to #00ff66 for the classic terminal green." },
{ "type": "image_picker", "id": "ascii_image", "label": "Image to render as ASCII", "info": "For the image and dither modes. Simple, high-contrast images on transparent or white backgrounds work best — your logo or a product cutout." },
{ "type": "range", "id": "ascii_opacity", "label": "Strength", "min": 4, "max": 100, "step": 2, "unit": "%", "default": 14 },
