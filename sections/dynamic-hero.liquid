                  {%- assign account_page = section.settings.account_page_url | default: '/pages/account' -%}
                  <div class="dh-pop-title">Hi, {{ customer.first_name | default: 'there' }}</div>
                  <a class="dh-pop-link" href="https://shopify.com/{{ shop.id }}/account/orders">Orders <svg class="dh-pop-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg></a>
                  <a class="dh-pop-link" href="{{ account_page }}?tab=wishlist">Wishlist</a>
                  <a class="dh-pop-link" href="{{ account_page }}?tab=reviews">Reviews</a>
                  <a class="dh-pop-link" href="https://shopify.com/{{ shop.id }}/account/profile">Profile <svg class="dh-pop-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg></a>
                  <a class="dh-pop-link" href="{{ routes.account_logout_url }}">Log out</a>
                {%- else -%}
                  <div class="dh-pop-title">Your account</div>
                  <p class="dh-pop-note">Sign in with your email — Shopify sends you a secure login code, so there’s no password to remember or forget.</p>
                  <a class="dh-pop-btn dh-pop-cta" href="{{ section.settings.login_url | default: routes.account_login_url }}">Log in / Sign up</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- capture corner_group -%}{{ corner_links }}{{ corner_extra }}{%- endcapture -%}
      {%- if corner_group != blank -%}<div class="dh-corner-group dh-corner-{{ pos }}">{{ corner_group }}</div>{%- endif -%}
  {%- endfor -%}
  {%- capture menu_rows -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'corner_link' and block.settings.label != blank and block.settings.show_mobile != false -%}
        <a class="dh-mmenu-link" href="{{ block.settings.url | default: '#' }}">{{ block.settings.label | escape }}</a>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if menu_rows != blank -%}
    <button class="dh-menu-btn" type="button" id="dhMenuBtn" aria-label="Menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
    </button>
    <div class="dh-mmenu" id="dhMenu" role="dialog" aria-modal="true" aria-label="Menu">
      <button class="dh-mmenu-close" type="button" id="dhMenuClose">Close &times;</button>
      <nav class="dh-mmenu-nav">{{ menu_rows }}</nav>
    </div>
  {%- endif -%}
  {%- if section.settings.copyright_text != blank -%}
    <div class="dh-copyright">{{ section.settings.copyright_text }}</div>
  {%- endif -%}
  {%- assign has_float = false -%}
  {%- for b in section.blocks -%}{%- if b.type == 'float' and b.settings.image != blank -%}{%- assign has_float = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_float -%}
  {%- comment -%} Positioning is inlined so the photos never join the page
     flow while styles are still streaming in — they'd shove the logo and
     search bar down and snap back (a large layout shift). {%- endcomment -%}
  <div class="dh-floats" id="dhFloats" data-paint="{{ section.settings.float_paint | default: 'rub' }}" aria-hidden="true" hidden
    style="position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden">
    {%- for b in section.blocks -%}
      {%- if b.type == 'float' and b.settings.image != blank -%}
      <span class="dh-float" data-w="{{ b.settings.size | default: 140 }}" style="position:absolute;left:-9999px;top:0;width:{{ b.settings.size | default: 140 }}px" {{ b.shopify_attributes }}>
        <span class="dh-float-bob">
          {%- assign fsz = b.settings.size | default: 140 | times: 2 | at_least: 200 | at_most: 640 -%}
          {%- comment -%} Not lazy: these sit above the fold and are often the
             page's largest image on phones — lazy-loading them delays LCP. {%- endcomment -%}
          <img class="dh-float-img" src="{{ b.settings.image | image_url: width: fsz }}" alt="" draggable="false"
            width="{{ b.settings.image.width }}" height="{{ b.settings.image.height }}">
          <canvas class="dh-float-paint"></canvas>
        </span>
      </span>
      {%- endif -%}
    {%- endfor -%}
    {%- if section.settings.float_pin -%}
    <span class="dh-float-pin" id="dhFloatPin" aria-hidden="true" data-w="{{ section.settings.pin_size | default: 60 }}"
      style="position:absolute;left:16px;bottom:16px;width:38px">
      {%- if section.settings.pin_image != blank -%}
      {%- assign psz = section.settings.pin_size | default: 60 | times: 2 | at_least: 120 | at_most: 400 -%}
      <img src="{{ section.settings.pin_image | image_url: width: psz }}" alt="" draggable="false" loading="lazy"
        width="{{ section.settings.pin_image.width }}" height="{{ section.settings.pin_image.height }}">
      {%- else -%}
      <svg viewBox="0 0 40 40">
        <line x1="23" y1="23" x2="35" y2="35" stroke="#9aa0a8" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="16" cy="16" r="10.5" fill="#e0403f"/>
        <circle cx="12.5" cy="12.5" r="3.2" fill="#ff8a80"/>
      </svg>
      {%- endif -%}
    </span>
    {%- endif -%}
  </div>
  {%- endif -%}
  <div class="dh-wrap">
    <div class="dh-head">
      {%- if section.settings.head_link != blank -%}<a class="dh-head-link" href="{{ section.settings.head_link }}" aria-label="{{ shop.name | escape }}">{%- endif -%}
      {%- assign hero_logo = section.settings.heading_logo | default: settings.logo -%}
      {%- if section.settings.head_video != blank -%}
        <video class="dh-head-video" autoplay muted playsinline preload="metadata"
          {% if section.settings.head_video.preview_image %}poster="{{ section.settings.head_video.preview_image | image_url: width: 800 }}"{% endif %}>
          {%- for source in section.settings.head_video.sources -%}
            {%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}
          {%- endfor -%}
        </video>
      {%- elsif hero_logo != blank -%}
        {%- assign hlw = hero_logo.width | times: 56 | divided_by: hero_logo.height -%}
        <a href="{{ routes.root_url }}" class="dh-head-logo-link" aria-label="{{ shop.name | escape }} — home"><img class="dh-head-logo" style="--dyn-lw: {{ section.settings.logo_width | default: 200 }}px" src="{{ hero_logo | image_url: width: 700 }}" srcset="{{ hero_logo | image_url: width: 400 }} 400w, {{ hero_logo | image_url: width: 700 }} 700w, {{ hero_logo | image_url: width: 1000 }} 1000w" sizes="(max-width: 640px) 90vw, 700px" alt="{{ shop.name | escape }}" width="{{ hlw }}" height="56" fetchpriority="high"></a>
      {%- else -%}
        <h1>{{ section.settings.heading | default: coll.title | default: 'Store' }}</h1>
      {%- endif -%}
      {%- if section.settings.head_link != blank -%}</a>{%- endif -%}
      {%- if section.settings.show_description and coll.description != blank -%}
        <div class="dh-desc">{{ coll.description | strip_html | truncatewords: 40 }}</div>
      {%- endif -%}
    </div>

    {%- assign prods = coll.products -%}
    {%- assign hide_kws = section.settings.exclude_keywords | default: '' | downcase | split: ',' -%}
    {%- if prods.size == 0 -%}
      <div class="dh-empty">
        <p>{{ section.settings.empty_text | default: 'Nothing here yet.' }}</p>
        <a href="{{ routes.all_products_collection_url }}">{{ section.settings.empty_link_label | default: 'Browse all products' }}</a>
      </div>
    {%- else -%}
      {%- if section.settings.show_search -%}
        <div class="dh-search">
          <button type="button" class="dh-search-plus" id="dhSearchPlus" aria-label="Search" tabindex="-1">
            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <input type="search" id="dhSearch" class="dh-search-input" autocomplete="off" aria-label="Search products"
            data-typing="{{ section.settings.search_examples | escape }}"
            placeholder="{{ section.settings.search_placeholder | default: 'Search these products…' }}">
          <button type="button" class="dh-search-go" id="dhSearchGo" aria-label="Search">
            <span class="dh-go-ic dh-go-back"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
            <span class="dh-go-ic dh-go-up"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg></span>
            <span class="dh-go-ic dh-go-check"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
        </div>
        {%- if section.settings.show_finding -%}
          <div class="dh-finding" aria-hidden="true"><span class="dh-finding-txt"></span></div>
        {%- endif -%}
        {%- if section.settings.show_btn1 or section.settings.show_btn2 or section.settings.show_btn3 -%}
          <div class="dh-hero-btns">
            {%- if section.settings.show_btn1 -%}<button type="button" class="dh-gbtn" id="dhBtnSearch">{{ section.settings.btn1_label | default: 'Search' }}</button>{%- endif -%}
            {%- if section.settings.show_btn2 -%}<a class="dh-gbtn" href="{{ section.settings.btn2_url | default: routes.all_products_collection_url }}">{{ section.settings.btn2_label | default: 'Shop all' }}</a>{%- endif -%}
            {%- if section.settings.show_btn3 -%}
              <span class="dh-goo-wrap">
                <span class="dh-goo" aria-hidden="true"><span class="dh-goo-core"></span><span class="dh-goo-blob dh-goo-follow"></span></span>
                <button type="button" class="dh-gbtn" id="dhBtnRandom">{{ section.settings.btn3_label | default: 'Surprise me' }}</button>
              </span>
            {%- endif -%}
          </div>
          {%- if section.settings.show_btn3 -%}
            <script type="application/json" data-dh-random>[{%- assign rfirst = true -%}{%- for product in prods limit: 50 -%}{%- assign rt = product.title | downcase -%}{%- assign rhide = false -%}{%- for kw in hide_kws -%}{%- assign kwt = kw | strip -%}{%- if kwt != blank and rt contains kwt -%}{%- assign rhide = true -%}{%- endif -%}{%- endfor -%}{%- unless rhide -%}{%- unless rfirst %},{% endunless %}{%- assign rfirst = false -%}{{ product.url | json }}{%- endunless -%}{%- endfor -%}]</script>
            <script type="application/json" data-dh-hidekw>{{ section.settings.exclude_keywords | default: '' | downcase | json }}</script>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {%- comment -%} Build the category tabs from product type or tag. {%- endcomment -%}
      {%- if section.settings.show_grid -%}
      {%- if cat_source == 'tag' -%}
        {%- assign cats = coll.all_tags -%}
      {%- else -%}
        {%- assign cats = coll.all_types -%}
      {%- endif -%}

      {%- assign real_cats = '' -%}
      {%- for c in cats -%}{%- if c != blank -%}{%- assign real_cats = real_cats | append: '1' -%}{%- endif -%}{%- endfor -%}

      {%- assign tab_count = 0 -%}
      {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}{%- endfor -%}

      {%- if section.settings.show_tabs and tab_count > 0 -%}
        {%- comment -%} Image tabs: merchant-defined blocks with an uploaded picture per category. {%- endcomment -%}
        <div class="dh-tabs-wrap" id="dhTabsWrap">
        <button type="button" class="dh-tabs-arrow dh-prev" id="dhPrev" aria-label="Scroll categories left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
        <div class="dh-tabs is-images" id="dhTabs" role="tablist">
          {%- if section.settings.show_all_tab -%}
          <button type="button" class="dh-tab is-active" data-cat="__all" role="tab" aria-selected="true">
            <span class="dh-tab-img dh-tab-all">
              {%- if section.settings.all_image != blank -%}
                <img src="{{ section.settings.all_image | image_url: width: 200 }}" alt="{{ section.settings.all_label | default: 'All' | escape }}" width="68" height="68" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
              {%- endif -%}
            </span>
            <span class="dh-tab-label">{{ section.settings.all_label | default: 'All' }}</span>
          </button>
          {%- endif -%}
          {%- assign tab_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- unless block.type == 'tab' -%}{%- continue -%}{%- endunless -%}
            {%- assign tab_i = tab_i | plus: 1 -%}
            {%- assign cv = block.settings.category_value -%}
            {%- assign first_active = false -%}
            {%- if section.settings.show_all_tab == false and tab_i == 1 -%}{%- assign first_active = true -%}{%- endif -%}
            <button type="button" class="dh-tab{% if first_active %} is-active{% endif %}" data-cat="{{ cv | handle }}" role="tab" aria-selected="{% if first_active %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
              <span class="dh-tab-img">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.label | escape }}" width="68" height="68" loading="lazy">
                {%- else -%}
                  <span class="dh-tab-init">{{ block.settings.label | default: cv | slice: 0 | upcase }}</span>
                {%- endif -%}
              </span>
              <span class="dh-tab-label">{{ block.settings.label | default: cv }}</span>
            </button>
          {%- endfor -%}
        </div>
        <button type="button" class="dh-tabs-arrow dh-next" id="dhNext" aria-label="Scroll categories right" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
        </div>
      {%- elsif section.settings.show_tabs and real_cats != blank -%}
        {%- comment -%} Auto text-pill tabs from product type / tag. {%- endcomment -%}
        <div class="dh-tabs is-pills" id="dhTabs" role="tablist">
          {%- if section.settings.show_all_tab -%}
          <button type="button" class="dh-tab is-active" data-cat="__all" role="tab" aria-selected="true">{{ section.settings.all_label | default: 'All' }}</button>
          {%- endif -%}
          {%- assign shown_i = 0 -%}
          {%- for c in cats -%}
            {%- unless c == blank -%}
              {%- assign shown_i = shown_i | plus: 1 -%}
              {%- assign first_active = false -%}
              {%- if section.settings.show_all_tab == false and shown_i == 1 -%}{%- assign first_active = true -%}{%- endif -%}
              <button type="button" class="dh-tab{% if first_active %} is-active{% endif %}" data-cat="{{ c | handle }}" role="tab" aria-selected="{% if first_active %}true{% else %}false{% endif %}">{{ c }}</button>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="dh-shelf-wrap" id="dhShelfWrap">
      <button type="button" class="dh-shelf-arrow dh-prev" id="dhGridPrev" aria-label="Scroll products left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
      <div class="dh-grid" id="dhGrid">
        {%- assign hide_tag = section.settings.hide_tag | default: 'hidden' -%}
        {%- for product in prods limit: section.settings.max_products -%}
          {%- if product.tags contains hide_tag -%}{%- continue -%}{%- endif -%}
          {%- assign p_title_dc = product.title | downcase -%}{%- assign p_hidden = false -%}
          {%- for kw in hide_kws -%}{%- assign kwt = kw | strip -%}{%- if kwt != blank and p_title_dc contains kwt -%}{%- assign p_hidden = true -%}{%- endif -%}{%- endfor -%}
          {%- if p_hidden -%}{%- continue -%}{%- endif -%}
          {%- assign on_sale = false -%}
          {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}

          {%- comment -%} Best-seller badge: by tag, and/or the top N when the collection is sorted by Best selling. {%- endcomment -%}
          {%- assign is_best = false -%}
          {%- if section.settings.show_bestseller -%}
            {%- assign bs_tag = section.settings.bestseller_tag | default: 'bestseller' | downcase | strip -%}
            {%- for t in product.tags -%}
              {%- assign tl = t | downcase | strip -%}
              {%- if tl == bs_tag -%}{%- assign is_best = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- assign bs_top = section.settings.bestseller_top | default: 0 -%}
            {%- if bs_top > 0 and forloop.index <= bs_top -%}{%- assign is_best = true -%}{%- endif -%}
          {%- endif -%}

          {%- comment -%} New badge: shows for a set number of days after the product was published, then disappears on its own. {%- endcomment -%}
          {%- assign is_new = false -%}
          {%- if section.settings.show_new -%}
            {%- assign new_days = section.settings.new_days | default: 14 -%}
            {%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
            {%- assign pub_s = product.published_at | date: '%s' | plus: 0 -%}
            {%- if pub_s > 0 -%}
              {%- assign age_days = now_s | minus: pub_s | divided_by: 86400 -%}
              {%- if age_days <= new_days -%}{%- assign is_new = true -%}{%- endif -%}
            {%- endif -%}
          {%- endif -%}

          {%- if cat_source == 'tag' -%}
            {%- capture card_cat -%}{% for tag in product.tags %}{{ tag | handle }} {% endfor %}{%- endcapture -%}
          {%- else -%}
            {%- assign card_cat = product.type | handle -%}
          {%- endif -%}

          {%- assign img2 = blank -%}
          {%- if product.images.size > 1 -%}{%- assign img2 = product.images[1] -%}{%- endif -%}

          {%- capture card_search -%}{{ product.title }} {{ product.type }} {{ product.vendor }} {% for t in product.tags %}{{ t }} {% endfor %}{% for opt in product.options_with_values %}{{ opt.name }} {% for v in opt.values %}{{ v }} {% endfor %}{% endfor %}{%- endcapture -%}
          <div class="dh-card" data-cat="{{ card_cat | strip }}" data-flags="{% if is_new %}new {% endif %}{% if is_best %}best {% endif %}{% if on_sale %}sale {% endif %}" data-search="{{ card_search | downcase | strip_newlines | escape }}">
            <div class="dh-media-wrap">
            <a class="dh-media" href="{{ product.url }}">
              <div class="dh-badges">
                {%- if is_new -%}
                  <span class="dh-badge dh-badge-new">{{ section.settings.new_label | default: 'New' }}</span>
                {%- endif -%}
                {%- if is_best -%}
                  <span class="dh-badge dh-badge-best"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9z"/></svg>{{ section.settings.bestseller_label | default: 'Best seller' }}</span>
                {%- endif -%}
                {%- if on_sale -%}
                  {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                  <span class="dh-badge dh-badge-sale">Save {{ pct }}%</span>
                {%- endif -%}
                {%- unless product.available -%}<span class="dh-badge dh-badge-soldout">Sold out</span>{%- endunless -%}
              </div>
              {%- if product.featured_image -%}
                <img class="dh-img-1{% if img2 != blank %} has-2{% endif %}" src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}" width="600" height="600" loading="lazy">
                {%- if img2 != blank -%}
                  <img class="dh-img-2" src="{{ img2 | image_url: width: 600 }}" alt="" width="600" height="600" loading="lazy" aria-hidden="true">
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'dh-img-1 dh-ph' }}
              {%- endif -%}
            </a>
            <button type="button" class="dh-save" aria-label="Save to wishlist" aria-pressed="false"
              data-wl-id="{{ product.handle }}"
              data-wl-title="{{ product.title | escape }}"
              data-wl-url="{{ product.url }}"
              data-wl-image="{{ product.featured_image | image_url: width: 400 }}"
              data-wl-price="{{ product.price | money }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-5-7 5V4a1 1 0 0 1 1-1Z"/></svg>
            </button>
            </div>

            <div class="dh-body">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <div class="dh-vendor">{{ product.vendor }}</div>
              {%- endif -%}
              <h3 class="dh-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="dh-price">
                <span class="dh-now{% if on_sale %} on-sale{% endif %}">{{ product.price | money }}</span>
                {%- if on_sale -%}<span class="dh-was">{{ product.compare_at_price | money }}</span>{%- endif -%}
              </div>

              {%- if section.settings.show_swatches -%}
                {%- assign color_opt = blank -%}
                {%- for o in product.options_with_values -%}
                  {%- assign on = o.name | downcase -%}
                  {%- if on contains 'color' or on contains 'colour' -%}{%- assign color_opt = o -%}{%- endif -%}
                {%- endfor -%}
                {%- if color_opt != blank -%}
                  <div class="dh-swatches">
                    {%- assign shown = 0 -%}
                    {%- assign cidx = color_opt.position | minus: 1 -%}
                    {%- for val in color_opt.values -%}
                      {%- if shown < 5 -%}
                        {%- assign vimg = '' -%}
                        {%- for v in product.variants -%}
                          {%- assign optval = v.options[cidx] -%}
                          {%- if optval == val and v.image -%}{%- assign vimg = v.image | image_url: width: 600 -%}{%- break -%}{%- endif -%}
                        {%- endfor -%}
                        <button type="button" class="dh-swatch" data-color="{{ val | escape }}" data-img="{{ vimg }}"
                          title="{{ val | escape }}" aria-label="{{ val | escape }}"></button>
                        {%- assign shown = shown | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign extra = color_opt.values.size | minus: 5 -%}
                    {%- if extra > 0 -%}<span class="dh-swatch-more">+{{ extra }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      <button type="button" class="dh-shelf-arrow dh-next" id="dhGridNext" aria-label="Scroll products right" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
      </div>
      <div class="dh-noresults" id="dhNoResults">
        <svg class="dh-nr-face" viewBox="0 0 48 48" aria-hidden="true"><circle cx="18" cy="20" r="2" fill="currentColor"/><circle cx="30" cy="20" r="2" fill="currentColor"/><path class="dh-nr-mouth" d="M15 30 Q24 23 33 30" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        <p class="dh-nr-title">{{ section.settings.noresults_title | default: 'No matches — yet.' }}</p>
        <p class="dh-nr-msg">{{ section.settings.noresults_message | default: "Can't find what you're looking for? Tell us what you had in mind — we might still be able to make it." }}</p>
        <a class="dh-nr-btn" href="{{ section.settings.noresults_url | default: '/pages/contact' }}">{{ section.settings.noresults_link_label | default: 'Contact us' }}</a>
      </div>
      {%- endif -%}
    {%- endif -%}
  </div>
  {%- assign slide_n = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'slide_link' -%}{%- assign slide_n = slide_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if slide_n > 0 -%}
    <div class="dh-sbtns">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide_link' and block.settings.url != blank -%}
          <button type="button" class="dh-sbtn" data-dh-slide="{{ block.settings.url }}" aria-label="{{ block.settings.label | default: 'Open' | escape }}" title="{{ block.settings.label | default: 'Open' | escape }}" {{ block.shopify_attributes }}><span class="dh-sbtn-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="14" rx="3.5" stroke="currentColor" stroke-width="1.8"/><line x1="9.5" y1="5.5" x2="9.5" y2="18.5" stroke="currentColor" stroke-width="1.8"/><rect x="5.2" y="7" width="2.6" height="10" rx="1.1" fill="currentColor"/></svg></span><span class="dh-sbtn-label">{{ block.settings.label | default: 'Open' }}</span></button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<div id="dhSlide" aria-hidden="true">
  <div class="dh-slide-scrim" data-dh-slide-close></div>
  <div class="dh-slide-panel">
    <button type="button" class="dh-slide-close" aria-label="Close" data-dh-slide-close><svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>
    <div class="dh-slide-body"></div>
    <span class="dh-slide-fade" aria-hidden="true"></span>
    <span class="dh-slide-hint" aria-hidden="true"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
  </div>
</div>

<script>
(function () {
  var slide = document.getElementById("dhSlide"); if (!slide) return;
  var sbody = slide.querySelector(".dh-slide-body");
  var spanel = slide.querySelector(".dh-slide-panel");
  var cache = {};
  function updateFade() {
    var more = sbody.scrollHeight - sbody.clientHeight - sbody.scrollTop > 12;
    spanel.classList.toggle("has-more", more);
  }
  sbody.addEventListener("scroll", function () {
    if (sbody.scrollTop > 30) spanel.classList.remove("dh-hint-on");
    updateFade();
  }, { passive: true });
  window.addEventListener("resize", updateFade);
  /* Images finishing load change the content height — recheck as they land. */
  sbody.addEventListener("load", updateFade, true);
  function fallback(url) { return '<div class="dh-slide-text"><p>Couldn’t show this page here. <a class="dh-slide-more" href="' + url + '">Open it →</a></p></div>'; }
  function inject(html, url) {
    var doc = new DOMParser().parseFromString(html, "text/html");
    var el = doc.querySelector("#MainContent") || doc.querySelector("main") || doc.querySelector('[role="main"]') || doc.querySelector(".main-content");
    if (!el) { sbody.innerHTML = fallback(url); updateFade(); return; }
    // Pull out only the runnable JavaScript, inject the HTML, then re-run those scripts so
    // interactive sections (tabs, sliders, etc.) work inside the panel. Data scripts
    // (e.g. type="application/json" holding gallery image lists) are LEFT in place so
    // they stay inside their own markup and can be found by the code that reads them.
    function runnable(s) { var t = (s.getAttribute("type") || "").toLowerCase(); return t === "" || t === "text/javascript" || t === "application/javascript" || t === "module"; }
    var scripts = Array.prototype.slice.call(el.querySelectorAll("script")).filter(runnable);
    scripts.forEach(function (s) { s.parentNode && s.parentNode.removeChild(s); });
    var wrap = document.createElement("div"); wrap.className = "dh-slide-inject"; wrap.innerHTML = el.innerHTML;
    sbody.innerHTML = ""; sbody.appendChild(wrap); sbody.scrollTop = 0;
    scripts.forEach(function (old) {
      try {
        var s = document.createElement("script");
        for (var i = 0; i < old.attributes.length; i++) { s.setAttribute(old.attributes[i].name, old.attributes[i].value); }
        if (!old.src) s.textContent = old.textContent;
        wrap.appendChild(s);
      } catch (e) {}
    });
    spanel.classList.add("dh-hint-on");
    updateFade();
    setTimeout(updateFade, 400);
    setTimeout(updateFade, 1400);
  }
  function lockScroll(on) {
    var de = document.documentElement;
    if (on) {
      var sbw = window.innerWidth - de.clientWidth; // width of the scrollbar about to disappear
      de.style.overflow = "hidden";
      if (sbw > 0) de.style.paddingRight = sbw + "px"; // keep content from shifting right
    } else {
      de.style.overflow = ""; de.style.paddingRight = "";
    }
  }
  function openSlide(url, half) {
    if (!url) return;
    slide.classList.toggle("dh-slide-half", !!half);
    slide.classList.add("is-open"); slide.setAttribute("aria-hidden", "false"); lockScroll(true);
    if (cache[url]) { inject(cache[url], url); return; }
    sbody.innerHTML = '<div class="dh-slide-loading">Loading…</div>'; sbody.scrollTop = 0;
    fetch(url, { credentials: "same-origin", cache: "no-store" }).then(function (r) { return r.text(); }).then(function (html) { cache[url] = html; if (slide.classList.contains("is-open")) inject(html, url); }).catch(function () { sbody.innerHTML = fallback(url); updateFade(); });
  }
  function closeSlide() { slide.classList.remove("is-open"); slide.setAttribute("aria-hidden", "true"); lockScroll(false); }
  document.querySelectorAll("[data-dh-slide]").forEach(function (b) { b.addEventListener("click", function (e) { e.preventDefault(); openSlide(b.getAttribute("data-dh-slide")); }); });
  slide.querySelectorAll("[data-dh-slide-close]").forEach(function (b) { b.addEventListener("click", closeSlide); });
  /* Click anywhere outside the panel (the backdrop) to close. If the click's
     target is no longer in the document, a widget inside the panel (e.g. a
     review Like button) re-rendered itself mid-click — that's an inside
     click, not the backdrop. */
  slide.addEventListener("click", function (e) {
    if (!document.contains(e.target)) return;
    if (!e.target.closest(".dh-slide-panel")) closeSlide();
  });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeSlide(); });
  window.dhSlideOpen = openSlide; /* let other buttons (e.g. Surprise me) open a URL in this pop-up */

  /* "Surprise me" — open a random product in the half-size pop-up (never the same one twice in a row). */
  var randBtn = document.getElementById("dhBtnRandom");
  if (randBtn) {
    var randSrc = document.querySelector("[data-dh-random]");
    var rlist = [];
    try { rlist = randSrc ? (JSON.parse(randSrc.textContent) || []) : []; } catch (e) {}
    var lastR = null, rBag = [];
    function pickAndOpen(urls) {
      if (!urls.length) return false;
      /* Shuffle-bag: every product is shown ONCE before any can appear again. */
      if (!rBag.length) {
        rBag = urls.filter(function (v, i, a) { return a.indexOf(v) === i; }); // unique products only
      }
      var i = Math.floor(Math.random() * rBag.length);
      var u = rBag.splice(i, 1)[0];
      /* Fresh bag could start with the product we just showed — swap it for another. */
      if (u === lastR && rBag.length) { var j = Math.floor(Math.random() * rBag.length); u = rBag.splice(j, 1, u)[0]; }
      lastR = u;
      if (u) { openSlide(u, true); return true; }
      return false;
    }
    randBtn.addEventListener("click", function () {
      /* Anyone listening (the floating orb) hears the surprise. */
      try { window.dispatchEvent(new CustomEvent("dyn-surprise")); } catch (e) {}
      if (pickAndOpen(rlist)) return;
      /* Inline list empty — fetch products live and open a random one anyway. */
      fetch("/products.json?limit=250", { credentials: "same-origin" })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          var ps = (d && d.products) || [];
          var kwEl = document.querySelector("[data-dh-hidekw]"), kws = [];
          try { kws = (JSON.parse(kwEl.textContent) || "").split(",").map(function (s) { return s.trim(); }).filter(Boolean); } catch (e) {}
          rlist = ps.filter(function (p) {
            var t = (p.title || "").toLowerCase();
            return !kws.some(function (k) { return t.indexOf(k) !== -1; });
          }).map(function (p) { return "/products/" + p.handle; });
          if (!pickAndOpen(rlist)) window.location.href = "{{ routes.all_products_collection_url }}";
        })
        .catch(function () { window.location.href = "{{ routes.all_products_collection_url }}"; });
    });
  }
})();
</script>

<noscript>
  <style>.dyn-hero .dh-grid .dh-card { opacity: 1 !important; transform: none !important; }</style>
</noscript>

<script>
(function () {
  var root = document.getElementById("dynHero");
  if (!root) return;

  // Head video: play once and stop (no loop).
  var headVid = root.querySelector(".dh-head-video");
  if (headVid) {
    headVid.loop = false; headVid.muted = true;
    var hp = headVid.play(); if (hp && hp.catch) hp.catch(function () {});
  }

  // Dropdown menus: account login + apps grid. Click to toggle; outside/Esc closes.
  /* Any link pointing to #wishlist opens the wishlist drawer (from the header
     section) instead of navigating — used by the "Wishlist / heart" app icon. */
  document.addEventListener("click", function (e) {
    var a = e.target.closest ? e.target.closest('a[href$="#wishlist"], a[href="#wishlist"]') : null;
    if (!a) return;
    e.preventDefault();
    if (window.DynamicHeader && window.DynamicHeader.openWishlist) { window.DynamicHeader.openWishlist(); }
  }, true);

  var menus = Array.prototype.slice.call(root.querySelectorAll(".dh-menu"));
  function closeMenus(except) {
    menus.forEach(function (m) {
      if (m === except) return;
      var b = m.querySelector(".dh-icon-btn"), p = m.querySelector(".dh-pop");
      if (p) p.hidden = true; if (b) b.setAttribute("aria-expanded", "false");
    });
  }
  menus.forEach(function (m) {
    var btn = m.querySelector(".dh-icon-btn"), pop = m.querySelector(".dh-pop");
    if (!btn || !pop) return;
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var willOpen = pop.hidden;
      closeMenus(m);
      pop.hidden = !willOpen;
      btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
    });
    pop.addEventListener("click", function (e) { e.stopPropagation(); });
  });
  if (menus.length) {
    document.addEventListener("click", function () { closeMenus(null); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeMenus(null); });
    // If a login attempt came back with an error, re-open the account menu so it's visible.
    var errMenu = root.querySelector(".dh-acct-pop [data-has-error]");
    if (errMenu) {
      var pop = errMenu.closest(".dh-pop"), mm = errMenu.closest(".dh-menu");
      if (pop) pop.hidden = false;
      if (mm) { var b = mm.querySelector(".dh-icon-btn"); if (b) b.setAttribute("aria-expanded", "true"); }
    }
  }

  // Login button feedback: verify the password against Shopify, then flash the
  // button green with a ✓ on success or red with a ✕ on a wrong password.
  var loginForm = root.querySelector(".dh-login-form");
  if (loginForm) {
    var loginBtn = loginForm.querySelector(".dh-pop-btn");
    var loginBtnHTML = loginBtn ? loginBtn.innerHTML : "";
    var OK_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
    var X_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>';
    function setLogin(state) {
      if (!loginBtn) return;
      loginBtn.classList.remove("is-ok", "is-err", "is-loading");
      if (state === "loading") { loginBtn.classList.add("is-loading"); loginBtn.disabled = true; }
      else if (state === "ok") { loginBtn.classList.add("is-ok"); loginBtn.innerHTML = OK_SVG; }
      else if (state === "err") { loginBtn.classList.add("is-err"); loginBtn.innerHTML = X_SVG; loginBtn.disabled = false; }
      else { loginBtn.disabled = false; loginBtn.innerHTML = loginBtnHTML; }
    }
    loginForm.addEventListener("submit", function (e) {
      var email = loginForm.querySelector('input[name="customer[email]"]');
      var pwd = loginForm.querySelector('input[name="customer[password]"]');
      // Empty fields or passwordless accounts: let Shopify handle it normally.
      if (!email || !email.value || !pwd || !pwd.value) return;
      e.preventDefault();
      if (loginBtn && loginBtn.dataset.busy) return;
      if (loginBtn) loginBtn.dataset.busy = "1";
      setLogin("loading");
      var action = loginForm.getAttribute("action") || "/account/login";
      fetch(action, { method: "POST", body: new FormData(loginForm), headers: { "Accept": "text/html" } })
        .then(function (res) {
          var url = res.url || "";
          var stayedOnLogin = !res.redirected || url.indexOf("/account/login") >= 0 || url.indexOf("/account/register") >= 0;
          if (!stayedOnLogin) {
            setLogin("ok");
            setTimeout(function () { window.location.href = url || "/account"; }, 720);
          } else {
            setLogin("err");
            if (loginBtn) loginBtn.dataset.busy = "";
            setTimeout(function () { setLogin("reset"); }, 1900);
          }
        })
        .catch(function () {
          if (loginBtn) loginBtn.dataset.busy = "";
          loginForm.submit(); // network issue → fall back to a normal submit
        });
    });
  }

  var grid = document.getElementById("dhGrid");
  var tabs = document.getElementById("dhTabs");
  var noRes = document.getElementById("dhNoResults");
  var tabsWrap = document.getElementById("dhTabsWrap");
  var shelfWrap = document.getElementById("dhShelfWrap");
  var hideUntilSearch = root.getAttribute("data-hide-until-search") === "true";
  var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll(".dh-card")) : [];

  // How many cards are visible at once (for a per-row left->right sweep).
  function colCount() {
    var first = grid.querySelector(".dh-card");
    if (!first) return 1;
    var cw = first.getBoundingClientRect().width + 22; // card + gap
    var n = Math.round(grid.clientWidth / cw);
    return Math.max(1, n || 1);
  }

  // Reveal the given cards with a left-to-right, row-by-row cascade.
  function reveal(visible) {
    var cols = colCount();
    visible.forEach(function (c) { c.classList.remove("in"); c.style.transitionDelay = "0ms"; });
    void grid.offsetWidth; // force reflow so removing/re-adding .in restarts the transition
    visible.forEach(function (c, i) {
      var col = i % cols, rowN = Math.floor(i / cols);
      c.style.transitionDelay = (col * 55 + rowN * 60) + "ms";
      c.classList.add("in");
    });
  }

  // Typo-tolerant matching (Levenshtein edit distance) so small misspellings still match.
  function lev(a, b) {
    var m = a.length, n = b.length; if (!m) return n; if (!n) return m;
    var d = [], i, j;
    for (i = 0; i <= m; i++) { d[i] = []; d[i][0] = i; }
    for (j = 0; j <= n; j++) d[0][j] = j;
    for (i = 1; i <= m; i++) {
      for (j = 1; j <= n; j++) {
        var cost = a.charCodeAt(i - 1) === b.charCodeAt(j - 1) ? 0 : 1;
        d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
        if (i > 1 && j > 1 && a.charCodeAt(i - 1) === b.charCodeAt(j - 2) && a.charCodeAt(i - 2) === b.charCodeAt(j - 1)) {
          d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1); // adjacent transposition (e.g. "mgu" -> "mug")
        }
      }
    }
    return d[m][n];
  }
  function wordHit(q, words) {
    var tol = q.length <= 5 ? 1 : (q.length <= 8 ? 2 : 3);
    for (var k = 0; k < words.length; k++) {
      var w = words[k]; if (!w) continue;
      if (w.indexOf(q) >= 0) return true;
      if (q.length < 3) continue;
      if (lev(q, w) <= tol) return true;
      if (w.length > q.length && lev(q, w.slice(0, q.length)) <= tol) return true;
    }
    return false;
  }
  function queryMatch(query, text) {
    if (!query) return true;
    if (text.indexOf(query) >= 0) return true;
    var qw = query.split(/\s+/), tw = text.split(/\s+/), i;
    for (i = 0; i < qw.length; i++) { if (qw[i] && !wordHit(qw[i], tw)) return false; }
    return true;
  }

  // Combined filter: current category tab AND the live search query.
  var currentCat = "__all";
  var query = "";
  var badgeFilter = null; // 'new' | 'best' | 'sale' — clicking a badge filters to it
  var badgeLabels = { "new": "New", "best": "Best sellers", "sale": "On sale" };
  var badgeChip = null, badgeChipTxt = null;
  function applyFilters() {
    // Landing mode: shrink + raise the logo/search once the shopper searches.
    if (hideUntilSearch) root.classList.toggle("dh-searching", query.length > 0);
    if (!grid) return; // grid removed from the hero — nothing to filter here
    // Home-page mode: keep the tabs + grid hidden until the shopper searches.
    if (hideUntilSearch && query.length === 0) {
      if (tabsWrap) tabsWrap.style.display = "none";
      if (shelfWrap) shelfWrap.style.display = "none";
      if (noRes) noRes.style.display = "none";
      return;
    }
    if (tabsWrap) tabsWrap.style.display = "";
    if (shelfWrap) shelfWrap.style.display = "";

    // When searching, look across ALL categories (ignore the tab); otherwise show the active tab.
    var searching = query.length > 0;
    if (tabs) tabs.querySelectorAll(".dh-tab").forEach(function (b) {
      b.classList.toggle("is-active", searching ? b.getAttribute("data-cat") === "__all" : b.getAttribute("data-cat") === currentCat);
    });
    var visible = [];
    cards.forEach(function (c) {
      var cc = " " + (c.getAttribute("data-cat") || "") + " ";
      var okCat = currentCat === "__all" || cc.indexOf(" " + currentCat + " ") >= 0;
      var okQ = !query || queryMatch(query, c.getAttribute("data-search") || "");
      var match;
      if (badgeFilter) {
        // A badge is selected: show every product carrying that badge (across all
        // categories), still narrowed by the search box if the shopper is typing.
        var fl = " " + (c.getAttribute("data-flags") || "") + " ";
        match = fl.indexOf(" " + badgeFilter + " ") >= 0 && okQ;
      } else {
        match = searching ? okQ : okCat;
      }
      c.style.display = match ? "" : "none";
      if (match) visible.push(c);
    });
    if (badgeChip) {
      if (badgeFilter) { badgeChip.hidden = false; if (badgeChipTxt) badgeChipTxt.textContent = badgeLabels[badgeFilter] || badgeFilter; }
      else { badgeChip.hidden = true; }
    }
    if (noRes) noRes.style.display = visible.length ? "none" : "block";
    grid.scrollLeft = 0;
    reveal(visible);
    updateGridArrows();
  }

  if (tabs) tabs.addEventListener("click", function (e) {
    var btn = e.target.closest(".dh-tab"); if (!btn) return;
    tabs.querySelectorAll(".dh-tab").forEach(function (b) { b.classList.remove("is-active"); b.setAttribute("aria-selected", "false"); });
    btn.classList.add("is-active"); btn.setAttribute("aria-selected", "true");
    try { btn.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" }); } catch (x) {}
    // Clicking a tab clears the search and just opens that category.
    if (searchEl) searchEl.value = "";
    query = "";
    badgeFilter = null;
    currentCat = btn.getAttribute("data-cat"); applyFilters();
  });

  // A small chip appears while a badge filter is active, so the shopper can clear it.
  (function () {
    var anchor = shelfWrap || tabsWrap || grid;
    if (!anchor || !anchor.parentNode) return;
    badgeChip = document.createElement("div");
    badgeChip.className = "dh-badge-chip"; badgeChip.hidden = true;
    badgeChip.innerHTML = '<span class="dh-badge-chip-txt"></span><button type="button" class="dh-badge-chip-x" aria-label="Clear filter">&#10005;</button>';
    anchor.parentNode.insertBefore(badgeChip, anchor);
    badgeChipTxt = badgeChip.querySelector(".dh-badge-chip-txt");
    badgeChip.querySelector(".dh-badge-chip-x").addEventListener("click", function () { badgeFilter = null; applyFilters(); });
  })();

  // Clicking a badge on a card filters the grid to that badge instead of opening the product.
  if (grid) grid.addEventListener("click", function (e) {
    var badge = e.target.closest ? e.target.closest(".dh-badge") : null;
    if (!badge) return;
    var flag = badge.classList.contains("dh-badge-new") ? "new"
             : badge.classList.contains("dh-badge-best") ? "best"
             : badge.classList.contains("dh-badge-sale") ? "sale" : null;
    if (!flag) return;
    e.preventDefault(); e.stopPropagation();
    badgeFilter = (badgeFilter === flag) ? null : flag;
    if (searchEl) searchEl.value = "";
    query = ""; currentCat = "__all";
    applyFilters();
  }, true);

  // Live search. Normally filters the on-page grid as the shopper types. If a
  // "results page" URL is set, Enter/submit opens that page with the query.
  var searchEl = document.getElementById("dhSearch");
  var searchBtn = document.getElementById("dhSearchGo");
  // Clicking anywhere on the bar (padding, edges, gaps) focuses the input — not just the text field.
  var searchWrap = searchEl ? searchEl.closest(".dh-search") : null;
  if (searchWrap && searchEl) {
    searchWrap.addEventListener("mousedown", function (e) {
      if (e.target === searchEl || (e.target.closest && e.target.closest("button, a, input"))) return;
      e.preventDefault();          // keep focus from moving to the bar itself
      searchEl.focus();
    });
  }
  // Helper: track the mouse over an element, updating CSS vars at most once per frame
  // (Safari fires mousemove very often and repaints SVG filters slowly, so throttle it).
  function followMouse(el, xVar, yVar, sVar) {
    if (!el) return;
    var lastE = null, raf = null;
    function apply() { raf = null; if (!lastE) return; var r = el.getBoundingClientRect(); el.style.setProperty(xVar, (lastE.clientX - r.left).toFixed(1) + "px"); el.style.setProperty(yVar, (lastE.clientY - r.top).toFixed(1) + "px"); }
    function onMove(e) { lastE = e; if (!raf) raf = requestAnimationFrame(apply); }
    el.addEventListener("mouseenter", function (e) { lastE = e; apply(); el.style.setProperty(sVar, "1"); });
    el.addEventListener("mousemove", onMove, { passive: true });
    el.addEventListener("mouseleave", function () { if (raf) { cancelAnimationFrame(raf); raf = null; } el.style.setProperty(sVar, "0"); });
  }
  // Surprise me: the gooey blob follows the cursor.
  followMouse(document.querySelector(".dh-goo-wrap"), "--gx", "--gy", "--gs");

  var resultsUrl = (root.getAttribute("data-results-url") || "").trim();
  var findingOn = root.getAttribute("data-finding") === "true";
  var findingText = root.getAttribute("data-finding-text") || "Finding your gift…";
  var findingMs = parseInt(root.getAttribute("data-finding-ms"), 10) || 550;
  var findingEl = root.querySelector(".dh-finding");
  var findingTxtEl = findingEl ? findingEl.querySelector(".dh-finding-txt") : null;
  var findingReduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  /* Move the overlay to <body> so it covers the whole page — header, account bar, everything. */
  if (findingEl && findingEl.parentNode !== document.body) document.body.appendChild(findingEl);
  /* Always clear the loader when the page is shown — fixes it being stuck after pressing Back
     (the browser restores the page from cache with the overlay still on). */
  window.addEventListener("pageshow", function () { if (findingEl) findingEl.classList.remove("is-on"); });
  function runFinding(done, keepUp) {
    if (!findingEl || !findingTxtEl || findingReduce) { if (done) done(); return; }
    findingTxtEl.textContent = findingText;
    findingEl.classList.add("is-on");
    setTimeout(function () { if (!keepUp) findingEl.classList.remove("is-on"); if (done) done(); }, Math.max(200, findingMs));
  }
  var ARROW_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>';
  var CHECK_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
  // Turn the search arrow green with a checkmark, then run cb (used before navigating).
  function flashArrowOk(cb) {
    if (!searchBtn) { if (cb) cb(); return; }
    searchBtn.classList.add("is-ok");
    if (cb) setTimeout(cb, 430);
  }
  function resetArrow() {
    if (!searchBtn) return;
    searchBtn.classList.remove("is-ok");
  }
  function runSearch(q) {
    if (!q) return;
    if (resultsUrl) {
      var go = function () { window.location.href = resultsUrl + (resultsUrl.indexOf("?") >= 0 ? "&" : "?") + "q=" + encodeURIComponent(q); };
      if (findingOn) { if (searchEl) searchEl.blur(); runFinding(go, true); /* keep the overlay up through navigation — no flash of the old page */ }
      else { flashArrowOk(go); }
    } else {
      query = q.toLowerCase();
      flashArrowOk(null); setTimeout(resetArrow, 1300);
      if (findingOn) {
        if (searchEl) searchEl.blur();
        runFinding(function () { applyFilters(); });
      } else {
        applyFilters();
        if (searchEl) searchEl.focus();
      }
    }
  }
  if (searchEl) {
    searchEl.addEventListener("input", function () {
      if (searchBtn) searchBtn.classList.toggle("has-text", !!searchEl.value.trim()); // ← empty, ↑ typing
      if (resultsUrl) return; // redirect mode: don't filter here
      // Finding mode: wait for submit to run the loader; only reset live when cleared.
      if (findingOn) { if (!searchEl.value.trim()) { query = ""; applyFilters(); } return; }
      query = searchEl.value.trim().toLowerCase();
      if (query) badgeFilter = null; // typing takes over from a badge filter
      applyFilters();
    });
    searchEl.addEventListener("keydown", function (e) {
      if (e.key !== "Enter") return;
      e.preventDefault();
      runSearch(searchEl.value.trim());
    });
  }
  if (searchBtn) searchBtn.addEventListener("click", function () {
    runSearch(searchEl ? searchEl.value.trim() : "");
  });
  // The "+" button just focuses the search field.
  var searchPlus = document.getElementById("dhSearchPlus");
  if (searchPlus && searchEl) searchPlus.addEventListener("click", function () { searchEl.focus(); });
  // "Search" glass button under the bar runs the same search.
  var btnSearch = document.getElementById("dhBtnSearch");
  if (btnSearch) btnSearch.addEventListener("click", function () {
    var q = searchEl ? searchEl.value.trim() : "";
    if (q) { runSearch(q); } else if (searchEl) { searchEl.focus(); }
  });

  // Typing effect: cycle example phrases through the placeholder like a typewriter.
  // Pauses while the shopper is focused or has typed something; resumes when empty.
  if (searchEl) {
    var typeRaw = (searchEl.getAttribute("data-typing") || "").trim();
    var phrases = typeRaw.split(/\r?\n/).map(function (s) { return s.trim(); }).filter(Boolean);
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (phrases.length && !reduce) {
      var restPh = searchEl.getAttribute("placeholder") || "";
      var pi = 0, ci = 0, deleting = false, paused = false, timer = null;
      var tick = function () {
        if (paused) return;
        var word = phrases[pi];
        if (!deleting) {
          ci++;
          searchEl.setAttribute("placeholder", word.slice(0, ci));
          if (ci >= word.length) { deleting = true; timer = setTimeout(tick, 1600); return; }
          timer = setTimeout(tick, 55);
        } else {
          ci--;
          searchEl.setAttribute("placeholder", word.slice(0, ci));
          if (ci <= 0) { deleting = false; pi = (pi + 1) % phrases.length; timer = setTimeout(tick, 350); return; }
          timer = setTimeout(tick, 28);
        }
      };
      var stopType = function () {
        paused = true; if (timer) { clearTimeout(timer); timer = null; }
        searchEl.setAttribute("placeholder", restPh);
      };
      var startType = function () {
        if (!paused || searchEl.value) return;
        paused = false; pi = 0; ci = 0; deleting = false; tick();
      };
      searchEl.addEventListener("focus", stopType);
      searchEl.addEventListener("blur", function () { if (!searchEl.value) startType(); });
      searchEl.addEventListener("input", function () { if (searchEl.value) stopType(); });
      if (document.activeElement !== searchEl) tick();
    }
  }

  // Scroll arrows: appear only when the image-tab row overflows; hide at ends.
  var prev = document.getElementById("dhPrev");
  var next = document.getElementById("dhNext");
  if (tabs && tabs.classList.contains("is-images")) {
    var updateArrows = function () {
      var overflow = tabs.scrollWidth - tabs.clientWidth > 2;
      tabs.classList.toggle("is-centered", !overflow);
      var atStart = tabs.scrollLeft <= 2;
      var atEnd = tabs.scrollLeft >= (tabs.scrollWidth - tabs.clientWidth - 2);
      if (prev) prev.hidden = !overflow || atStart;
      if (next) next.hidden = !overflow || atEnd;
    };
    var step = function () { return Math.max(180, tabs.clientWidth * 0.7); };
    if (prev) prev.addEventListener("click", function () { tabs.scrollBy({ left: -step(), behavior: "smooth" }); });
    if (next) next.addEventListener("click", function () { tabs.scrollBy({ left: step(), behavior: "smooth" }); });
    tabs.addEventListener("scroll", updateArrows, { passive: true });
    window.addEventListener("resize", updateArrows);
    updateArrows();
  }

  // Product shelf arrows: scroll the grid horizontally; hide at ends / when it fits.
  var gPrev = document.getElementById("dhGridPrev");
  var gNext = document.getElementById("dhGridNext");
  function updateGridArrows() {
    if (!grid) return;
    var overflow = grid.scrollWidth - grid.clientWidth > 2;
    var atStart = grid.scrollLeft <= 2;
    var atEnd = grid.scrollLeft >= (grid.scrollWidth - grid.clientWidth - 2);
    if (gPrev) gPrev.hidden = !overflow || atStart;
    if (gNext) gNext.hidden = !overflow || atEnd;
  }
  var gStep = function () { return Math.max(220, grid.clientWidth * 0.8); };
  if (gPrev) gPrev.addEventListener("click", function () { grid.scrollBy({ left: -gStep(), behavior: "smooth" }); });
  if (gNext) gNext.addEventListener("click", function () { grid.scrollBy({ left: gStep(), behavior: "smooth" }); });
  if (grid) {
    grid.addEventListener("scroll", updateGridArrows, { passive: true });
    window.addEventListener("resize", updateGridArrows);
  }

  // If this page was opened with a ?q= query (e.g. from the home search),
  // prefill the box and filter to those results — unless this page itself
  // redirects elsewhere.
  if (!resultsUrl) {
    try {
      var urlQ = new URLSearchParams(window.location.search).get("q");
      if (urlQ) { if (searchEl) searchEl.value = urlQ; query = urlQ.trim().toLowerCase(); }
    } catch (e) {}
  }

  // Initial load: reveal the active tab's products (works whether or not the All tab exists).
  var activeBtn = tabs ? tabs.querySelector(".dh-tab.is-active") : null;
  currentCat = activeBtn ? activeBtn.getAttribute("data-cat") : "__all";
  applyFilters();

  // Colour swatches: paint the dots from a name->colour map; hovering a dot
  // swaps the card image to that colour's variant photo.
  var MAP = {
    black:"#1d1d1f", white:"#f5f5f7", grey:"#8e8e93", gray:"#8e8e93", silver:"#c7c7cc",
    red:"#d0021b", crimson:"#b00020", maroon:"#7b1e1e", orange:"#f5820d", amber:"#ffb300",
    yellow:"#f7c948", gold:"#c9a227", green:"#2b9348", olive:"#7a7a2e", teal:"#008080",
    blue:"#0071e3", navy:"#1b2a4a", "sky blue":"#4aa8e0", "light blue":"#8ec6ef",
    purple:"#7b2ff7", violet:"#8f00ff", pink:"#ff5c8a", "hot pink":"#ff2d78", rose:"#e75480",
    brown:"#7a4b2b", tan:"#d2b48c", beige:"#e8dcc4", cream:"#f4efe1", ivory:"#fffff0",
    khaki:"#c3b091", charcoal:"#36454f", "off white":"#efefe9", natural:"#e8e0d0",
    burgundy:"#800020", mustard:"#d4a017", mint:"#a8e6cf", lavender:"#b57edc", coral:"#ff7f50",
    turquoise:"#40e0d0", indigo:"#4b0082", magenta:"#d0208a"
  };
  function colorFor(name) {
    var n = (name || "").trim().toLowerCase();
    if (MAP[n]) return MAP[n];
    var words = n.split(/[\s/]+/);
    for (var i = words.length - 1; i >= 0; i--) { if (MAP[words[i]]) return MAP[words[i]]; }
    var t = new Option().style; t.color = ""; t.color = n; if (t.color !== "") return n;
    return "#c7c7cc";
  }
  cards.forEach(function (card) {
    var img1 = card.querySelector(".dh-media .dh-img-1");
    var baseSrc = img1 ? img1.getAttribute("src") : "";
    card.querySelectorAll(".dh-swatch").forEach(function (sw) {
      sw.style.background = colorFor(sw.getAttribute("data-color"));
      var vimg = sw.getAttribute("data-img");
      if (vimg && img1) sw.addEventListener("mouseenter", function () { img1.src = vimg; });
    });
    if (img1) card.addEventListener("mouseleave", function () { if (baseSrc) img1.src = baseSrc; });
  });
})();
</script>

<script>
/* Instagram-style save button -> browser wishlist (same "dyn_wishlist" list the
   wishlist page and header drawer use). */
(function () {
  var KEY = "dyn_wishlist";
  var btns = document.querySelectorAll(".dyn-hero .dh-save");
  if (!btns.length) return;
  function read() { try { var a = JSON.parse(localStorage.getItem(KEY) || "[]"); return Array.isArray(a) ? a : []; } catch (e) { return []; } }
  function write(l) { try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (e) {} try { window.dispatchEvent(new CustomEvent("dyn-wishlist-change")); } catch (e) {} }
  function has(id) { return read().some(function (x) { return String(x.id) === String(id); }); }
  function paint() {
    btns.forEach(function (b) {
      var on = has(b.getAttribute("data-wl-id"));
      b.classList.toggle("is-saved", on);
      b.setAttribute("aria-pressed", on ? "true" : "false");
      b.setAttribute("aria-label", on ? "Saved — remove from wishlist" : "Save to wishlist");
    });
  }
  btns.forEach(function (b) {
    b.addEventListener("click", function (e) {
      e.preventDefault(); e.stopPropagation();
      var id = b.getAttribute("data-wl-id"), l = read(), i = -1, k;
      for (k = 0; k < l.length; k++) { if (String(l[k].id) === String(id)) { i = k; break; } }
      if (i >= 0) { l.splice(i, 1); }
      else {
        l.unshift({ id: id, title: b.getAttribute("data-wl-title"), url: b.getAttribute("data-wl-url"), image: b.getAttribute("data-wl-image"), price: b.getAttribute("data-wl-price") });
        b.classList.remove("just-saved"); void b.offsetWidth; b.classList.add("just-saved");
      }
      write(l); paint();
    });
  });
  window.addEventListener("dyn-wishlist-change", paint);
  window.addEventListener("storage", function (e) { if (e.key === KEY) paint(); });
  paint();
})();
</script>

{%- if section.settings.drag_objects -%}
<style>
  /* Movable objects: the drag offset lives in CSS variables so the buttons'
     own press/hover transforms keep working on top of it. */
  .dyn-hero .dh-dragobj { transform: translate(var(--ddx, 0px), var(--ddy, 0px)) scale(var(--dds, 1)); touch-action: manipulation; -webkit-touch-callout: none; }
  .dyn-hero .dh-gbtn.dh-dragobj:active { transform: translate(var(--ddx, 0px), var(--ddy, 0px)) scale(0.97); }
  /* No lift to the front while dragging: each object keeps its own layer
     (search bar 12 > buttons 11 > logo 10), so nothing jumps on release.
     Transitions off while carried — the buttons' 0.12s transform easing
     otherwise makes them rubber-band behind the hand at different speeds. */
  .dyn-hero .dh-dragobj.is-drag { position: relative; user-select: none; -webkit-user-select: none; transition: none; }
  .dyn-hero .dh-dragobj.is-anim { transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
  html.dh-grabbing, html.dh-grabbing * { cursor: grabbing !important; user-select: none !important; -webkit-user-select: none !important; }
  /* The put-it-back button: hidden until something has been moved, then a
     small liquid-glass circle with a backward arrow. */
  .dyn-hero .dh-reset-btn { position: fixed; right: 20px; bottom: 78px; z-index: 70;
    width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.35);
    background: rgba(255,255,255,0.16); backdrop-filter: blur(20px) saturate(1.6); -webkit-backdrop-filter: blur(20px) saturate(1.6);
    color: #1d1d1f; display: grid; place-items: center; cursor: pointer; padding: 0;
    box-shadow: 0 14px 44px rgba(0,0,0,0.12);
    opacity: 0; transform: scale(0.6); pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), background 0.2s ease; }
  .dyn-hero .dh-reset-btn.is-on { opacity: 1; transform: scale(1); pointer-events: auto; }
  .dyn-hero .dh-reset-btn:hover { background: rgba(255,255,255,0.32); }
  .dyn-hero .dh-reset-btn svg { width: 22px; height: 22px; stroke: currentColor; fill: none;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.5s ease; }
  .dyn-hero .dh-reset-btn.is-spin svg { transform: rotate(-360deg); }
  html.dyn-sky-dark .dyn-hero .dh-reset-btn { color: #fff; }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .dyn-hero .dh-reset-btn { background: #fff; } }
</style>
<script>
(function () {
  /* Movable objects: pick up the logo card, search bar or buttons and play.
     A real click (under 8px of travel) still clicks; anything further becomes
     a drag. Nothing is stored — a refresh puts everything back — and once
     something moves, a small glass button appears that glides it all home. */
  var hero = document.getElementById("dynHero");
  if (!hero) return;
  var defs = [
    ["head", ".dh-head"],
    ["search", ".dh-search"],
    ["btn1", "#dhBtnSearch"],
    ["btn2", ".dh-hero-btns > a.dh-gbtn"],
    ["btn3", ".dh-goo-wrap"]
  ];
  var els = {};
  defs.forEach(function (d) {
    var el = hero.querySelector(d[1]);
    if (el) { els[d[0]] = el; el.classList.add("dh-dragobj"); }
  });
  if (!Object.keys(els).length) return;
  var pos = {};
  function apply(k) {
    var el = els[k], p = pos[k] || [0, 0];
    el.style.setProperty("--ddx", p[0] + "px");
    el.style.setProperty("--ddy", p[1] + "px");
  }
  var resetBtn = document.createElement("button");
  resetBtn.type = "button";
  resetBtn.className = "dh-reset-btn";
  resetBtn.setAttribute("aria-label", "Put everything back");
  resetBtn.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 2.8-6.5"/><polyline points="3 4.5 3 9.5 8 9.5"/></svg>';
  hero.appendChild(resetBtn);
  var extMoved = false;
  hero.addEventListener("dh:ext-moved", function (e) {
    extMoved = !!(e.detail && e.detail.moved);
    updateReset();
  });
  function updateReset() {
    resetBtn.classList.toggle("is-on", Object.keys(pos).length > 0 || extMoved);
  }
  function clamp(k) {
    /* Keep the object at least 6px inside the screen so it can't get lost. */
    var el = els[k], p = pos[k];
    if (!p) return;
    var rc = el.getBoundingClientRect();
    var bx = rc.left - p[0], by = rc.top - p[1];
    var pad = 6;
    p[0] = Math.min(Math.max(p[0], pad - bx), Math.max(pad - bx, innerWidth - pad - rc.width - bx));
    p[1] = Math.min(Math.max(p[1], pad - by), Math.max(pad - by, innerHeight - pad - rc.height - by));
    apply(k);
  }
  var rT;
  window.addEventListener("resize", function () {
    clearTimeout(rT);
    rT = setTimeout(function () { Object.keys(els).forEach(clamp); }, 150);
  });

  var drag = null, squelch = 0;
  document.addEventListener("click", function (e) {
    if (Date.now() < squelch) { e.preventDefault(); e.stopPropagation(); }
  }, true);
  function lift() {
    /* Measure before the lift styling, so the walls use the true size. */
    var rc = drag.el.getBoundingClientRect();
    drag.bw = rc.width; drag.bh = rc.height;
    drag.bx = rc.left - drag.ox; drag.by = rc.top - drag.oy;
    drag.moved = true;
    drag.el.classList.add("is-drag");
    drag.el.style.setProperty("--dds", "1.04");
    document.documentElement.classList.add("dh-grabbing");
    if (document.activeElement && drag.el.contains(document.activeElement)) document.activeElement.blur();
    if (window.getSelection) { try { getSelection().removeAllRanges(); } catch (err) {} }
    if (navigator.vibrate) { try { navigator.vibrate(10); } catch (err) {} }
  }
  Object.keys(els).forEach(function (k) {
    var el = els[k];
    el.addEventListener("dragstart", function (e) { e.preventDefault(); });
    el.addEventListener("contextmenu", function (e) {
      /* No long-press link menu while a finger is holding the object. */
      if (drag && drag.el === el && drag.touch) e.preventDefault();
    });
    el.addEventListener("pointerdown", function (e) {
      if (e.button != null && e.button !== 0) return;
      /* Phones don't move the page objects — fingers scroll and tap;
         only the photos are playthings there. Mouse drags as before. */
      if (e.pointerType === "touch") return;
      /* One thing in the hand at a time — shared lock with the photos. */
      if (drag || window.__dhDrag) return;
      /* Leave the search bar alone while someone is typing or selecting. */
      if (k === "search" && document.activeElement && el.contains(document.activeElement)) return;
      window.__dhDrag = true;
      var p = pos[k] || [0, 0];
      drag = { k: k, el: el, sx: e.clientX, sy: e.clientY, ox: p[0], oy: p[1],
               moved: false, touch: e.pointerType === "touch", timer: 0 };
      /* Phone: hold a moment to pick the object up, like moving an app icon.
         A quick swipe scrolls the page as usual. */
      if (drag.touch) drag.timer = setTimeout(function () { if (drag && drag.el === el && !drag.moved) lift(); }, 300);
    });
    el.addEventListener("touchmove", function (e) {
      if (!drag || drag.el !== el || !e.cancelable) return;
      if (drag.moved) { e.preventDefault(); return; }         /* lifted: we steer, not the page */
      var t = e.touches[0];
      if (!t) return;
      var dx = t.clientX - drag.sx, dy = t.clientY - drag.sy;
      if (dx * dx + dy * dy < 100) { e.preventDefault(); }    /* jitter during the hold */
      else { clearTimeout(drag.timer); drag = null; }         /* real swipe → let it scroll */
    }, { passive: false });
  });
  window.addEventListener("pointermove", function (e) {
    if (!drag) return;
    if (drag.touch && !drag.moved) return;                    /* still waiting for the hold */
    var dx = e.clientX - drag.sx, dy = e.clientY - drag.sy;
    if (!drag.moved) {
      if (dx * dx + dy * dy < 64) return;
      lift();
    }
    /* The screen edges are walls: the object stops 6px inside, even
       while the hand keeps going. The held object is scaled up 4%, so
       pad the walls by the extra 2% that sticks out on each side. */
    var mx = 6 + drag.bw * 0.02, my = 6 + drag.bh * 0.02;
    var nx = drag.ox + dx, ny = drag.oy + dy;
    nx = Math.min(Math.max(nx, mx - drag.bx), Math.max(mx - drag.bx, innerWidth - mx - drag.bw - drag.bx));
    ny = Math.min(Math.max(ny, my - drag.by), Math.max(my - drag.by, innerHeight - my - drag.bh - drag.by));
    pos[drag.k] = [nx, ny];
    apply(drag.k);
  }, { passive: true });
  function end() {
    if (!drag) return;
    window.__dhDrag = false;
    clearTimeout(drag.timer);
    drag.el.style.removeProperty("--dds");
    if (drag.moved) {
      clamp(drag.k);
      /* Dropped basically home? Snap clean, as if never moved. */
      if (pos[drag.k] && Math.abs(pos[drag.k][0]) < 2 && Math.abs(pos[drag.k][1]) < 2) {
        delete pos[drag.k];
        apply(drag.k);
      }
      updateReset();
      squelch = Date.now() + 320;
      drag.el.classList.remove("is-drag");
    }
    document.documentElement.classList.remove("dh-grabbing");
    drag = null;
  }
  window.addEventListener("pointerup", end, { passive: true });
  window.addEventListener("pointercancel", end, { passive: true });
  function goHome() {
    pos = {};
    /* Floating photos (and anything else listening) glide home too. */
    try { hero.dispatchEvent(new CustomEvent("dh:gohome")); } catch (err) {}
    updateReset();
    Object.keys(els).forEach(function (k) { els[k].classList.add("is-anim"); apply(k); });
    setTimeout(function () {
      Object.keys(els).forEach(function (k) { els[k].classList.remove("is-anim"); });
    }, 500);
  }
  resetBtn.addEventListener("click", function () {
    resetBtn.classList.add("is-spin");
    goHome();
    setTimeout(function () { resetBtn.classList.remove("is-spin"); }, 550);
  });
  hero.addEventListener("dblclick", function (e) {
    if (e.target.closest(".dh-dragobj, a, button, input, .dh-pop, .dh-menu")) return;
    goHome();
  });
  /* Double-tap an empty spot on the phone: same glide home. */
  var lastTap = 0, lastTapX = 0, lastTapY = 0;
  hero.addEventListener("pointerup", function (e) {
    if (e.pointerType !== "touch") return;
    if (e.target.closest(".dh-dragobj, a, button, input, .dh-pop, .dh-menu")) return;
    var now = Date.now();
    if (now - lastTap < 350 && Math.abs(e.clientX - lastTapX) < 40 && Math.abs(e.clientY - lastTapY) < 40) {
      goHome();
      lastTap = 0;
      return;
    }
    lastTap = now; lastTapX = e.clientX; lastTapY = e.clientY;
  });
})();
</script>
{%- endif -%}

{%- if has_float -%}
<style>
  /* Floating photos: scattered to random spots each visit, bobbing gently.
     The whole layer ignores the pointer, so it can never block a click —
     painting is done by watching the mouse from a distance. */
  .dyn-hero .dh-floats { position: absolute; inset: 0; z-index: 1; pointer-events: none; overflow: hidden;
    user-select: none; -webkit-user-select: none; }
  /* While something is being carried, no text on the page can be selected —
     otherwise dragging paints blue selection over everything it passes. */
  html.dh-fnosel, html.dh-fnosel * { user-select: none !important; -webkit-user-select: none !important; }
  .dyn-hero .dh-float { position: absolute; opacity: 0; transform: scale(0.5); transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1); }
  .dyn-hero .dh-float.is-in { opacity: 1; transform: none; }
  .dyn-hero .dh-float-bob { display: block; position: relative;
