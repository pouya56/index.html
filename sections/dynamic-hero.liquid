{%- capture corner_group -%}{{ corner_links }}{{ corner_extra }}{%- endcapture -%}
{%- if corner_group != blank -%}<div class="dh-corner-group dh-corner-{{ pos }}">{{ corner_group }}</div>{%- endif -%}
{%- endfor -%}
{%- capture menu_rows -%}
{%- for block in section.blocks -%}
{%- if block.type == 'corner_link' and block.settings.label != blank and block.settings.show_mobile != false -%}
<a class="dh-mmenu-link" href="{{ block.settings.url | default: '#' }}">{{ block.settings.label | escape }}</a>
{%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- if menu_rows != blank -%}
<button class="dh-menu-btn" type="button" id="dhMenuBtn" aria-label="Menu" aria-expanded="false">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
