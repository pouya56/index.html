{ "type": "color", "id": "ascii_ink", "label": "Character colour", "default": "#0a0a0a" },
{ "type": "range", "id": "bg_veil", "label": "Background veil", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 30, "info": "White wash over the background image so the logo, search bar and text stay readable. 0 shows the photo untouched." },
{ "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif",
"options": [ { "value": "serif", "label": "Elegant serif (matches store)" }, { "value": "sans", "label": "Clean sans" } ] },
{ "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
{ "type": "checkbox", "id": "drag_objects", "label": "Movable objects (drag & drop)", "default": true, "info": "Shoppers can pick up the logo, search bar and buttons and play with them. As soon as something moves, a small glass button appears that glides everything back to its place — and a refresh always starts fresh. On phones, hold an object a moment to pick it up; quick swipes still scroll." },
{ "type": "select", "id": "float_paint", "label": "Floating photos: paint style", "options": [
{ "value": "rub", "label": "Rub to color in" },
{ "value": "bloom", "label": "Hover bloom (instant color)" },
{ "value": "none", "label": "Always full color" }
], "default": "rub", "info": "For 'Floating photo' blocks. Rub: the full color appears where the mouse (or finger) rubs. Bloom: one touch fills the color in at once. Full color: no painting, just the float." },
{ "type": "select", "id": "float_start", "label": "Floating photos: starting look", "options": [
{ "value": "pastel", "label": "Pastel wash (soft colors)" },
{ "value": "blur", "label": "Frosted blur (color, out of focus)" },
{ "value": "dim", "label": "Sleepy dim (color, darkened)" },
{ "value": "sepia", "label": "Vintage sepia" },
{ "value": "ghost", "label": "Ghost fade (see-through)" },
{ "value": "pop", "label": "Extra pop (starts normal, touch boosts)" },
{ "value": "gray", "label": "Gray sketch (classic)" }
], "default": "pastel", "info": "How the photos rest before a touch brings out the full color. Only used with the Rub and Bloom paint styles." },
{ "type": "checkbox", "id": "float_pin", "label": "Floating photos: pop pin (bottom left)", "default": true, "info": "A pin sits in the bottom-left corner — any touch between the pin and a photo pops the photo. The pin can be grabbed and thrown too. The put-it-back button (or a refresh) brings popped photos back." },
{ "type": "image_picker", "id": "pin_image", "label": "Pin image (optional)", "info": "Upload your own picture for the pin — a transparent PNG works best. Leave empty for the built-in red pushpin." },
{ "type": "range", "id": "pin_size", "label": "Pin size", "min": 30, "max": 160, "step": 10, "unit": "px", "default": 60, "info": "Only used when a pin image is uploaded." },

{ "type": "header", "content": "Search box" },
{ "type": "checkbox", "id": "show_search", "label": "Show live search box", "default": true, "info": "Filters the products already on this page as the shopper types — no page reload." },
{ "type": "checkbox", "id": "hide_until_search", "label": "Hide the grid until someone searches", "default": true, "info": "Only matters if 'Show product grid & tabs' is on: the products stay hidden until the shopper types. The hero is always full-screen either way." },
{ "type": "url", "id": "results_page_url", "label": "Show results on another page (URL)", "info": "Optional. Paste your Shop page URL (e.g. /collections/shop). When set, pressing Enter here opens that page with the results instead of filtering in place. Leave empty to filter on this page." },
{ "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search these products…" },
{ "type": "textarea", "id": "search_examples", "label": "Typing examples", "info": "One phrase per line. They type out in the search box one after another. Clear to turn the effect off.", "default": "I'm shopping for my wife.\nI'm looking for a birthday gift.\nI need a gift for my mom.\nI'm shopping for my dad.\nI want a gift for my best friend.\nI'm buying a gift for my boyfriend.\nI need an anniversary gift.\nI'm shopping for my daughter.\nI want something personalized.\nI'm looking for a unique gift.\nI need a Christmas gift.\nI'm shopping for a coworker.\nI want a custom mug.\nI'm shopping for myself.\nI'm not sure what to buy." },

{ "type": "checkbox", "id": "show_finding", "label": "Show a “Finding your gift…” loader on search", "default": true, "info": "When a shopper submits a search, the bar fades and a shimmering message shows for a moment before the results appear." },
{ "type": "text", "id": "finding_text", "label": "Loader message", "default": "Finding your gift…" },
