          /* Mouse / touch grab + throw. Works the same on desktop and phone:
             drag to throw, quick tap to make a box hop. */
          function pos(e) { var hr = host.getBoundingClientRect(); return { x: e.clientX - hr.left, y: e.clientY - hr.top }; }
          var held = null, grabOff = null, lastP = null, lastT = 0, throwVX = 0, throwVY = 0;
          var downQ = null, downT = 0, moved = 0, swallowClick = false;
          root.addEventListener("pointerdown", function (e) {
            swallowClick = false;
            if (e.button && e.button !== 0) return;
            var q = pos(e), best = null, bd = 1e9;
            for (var i = bodies.length - 1; i >= 0; i--) {
              var b = bodies[i], dx = b.x - q.x, dy = b.y - q.y, d = dx * dx + dy * dy;
              // Grab anywhere on the visible box (a touch wider than the physics
              // circle) so finger taps near the edge still catch it — and don't
              // fall through to a link sitting underneath on small screens.
