<script>
(function () {
  /* Entrance show — only when a scroll story (gallery/video) sits above,
     i.e. the hero starts off-screen. Logo lands big → its place, then the
     search bar, then the buttons. Classes come off right after, so drag,
     search and everything else see the hero exactly as before. */
  var hero = document.getElementById("dynHero");
  if (!hero || hero.__dhIntro) return;
  hero.__dhIntro = true;
  /* Fixed corner links: while a corner overlays the dark story sections
     above, flip its links to light ink — judged per corner, since the top
     pair crosses onto the hero before the bottom pair does. */
  var groups = Array.prototype.slice.call(hero.querySelectorAll(".dh-corner-group"));
  function paintCorners() {
    var r = hero.getBoundingClientRect();
    for (var i = 0; i < groups.length; i++) {
      var isTop = groups[i].className.indexOf("dh-corner-tl") > -1 || groups[i].className.indexOf("dh-corner-tr") > -1;
      var dark = isTop ? r.top > 30 : r.top > window.innerHeight - 70;
      groups[i].classList.toggle("is-over-dark", dark);
    }
  }
  if (groups.length) {
    window.addEventListener("scroll", paintCorners, { passive: true });
    window.addEventListener("resize", paintCorners, { passive: true });
    paintCorners();
  }
  /* Scroll-scrubbed entrance — armed only when the hero starts off-screen
     (a story section above). The hero pins for RUN extra viewports and
     the show plays in stages across entry + pin: logo lands big and
     settles first, then the search bar, then the buttons. Scrolling up
     reverses it. Past the end all inline styles are cleared and the
     class comes off, leaving the hero pristine for drag & search. */
  var mReduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (mReduce || hero.getBoundingClientRect().top < window.innerHeight * 0.6) return;
  var wrap = hero.closest(".shopify-section");
  var RUN = 0.8;
  if (wrap) wrap.classList.add("dh-introrun");
  /* Overlapping stages: the search bar and buttons rise WHILE the logo is
     still gliding to its place — everybody arrives around the same beat. */
  var parts = [
    { el: hero.querySelector(".dh-head"), a: 0.08, b: 0.6,
      fx: function (t) { return "scale(" + (2.2 - 1.2 * t).toFixed(3) + ")"; } },
    { el: hero.querySelector(".dh-search"), a: 0.3, b: 0.65,
      fx: function (t) { return "translateY(" + (26 * (1 - t)).toFixed(1) + "px)"; } },
    { el: hero.querySelector(".dh-hero-btns"), a: 0.42, b: 0.75,
      fx: function (t) { return "translateY(" + (26 * (1 - t)).toFixed(1) + "px)"; } }
  ].filter(function (x) { return x.el; });
  if (!parts.length) return;
  var iRaf = 0, iDone = false;
  function iTeardown() {
    if (iDone) return;
    iDone = true;
    if (wrap) wrap.classList.remove("dh-introrun");
    hero.classList.remove("dh-intro");
    for (var i = 0; i < parts.length; i++) { parts[i].el.style.opacity = ""; parts[i].el.style.transform = ""; }
    window.removeEventListener("scroll", iQueue);
    window.removeEventListener("resize", iQueue);
  }
  function iEase(t) { return 1 - Math.pow(1 - t, 3); }
  function iFrame() {
    iRaf = 0;
    if (iDone) return;
    var vh = window.innerHeight;
    var top = (wrap || hero).getBoundingClientRect().top;
    var p = (vh - top) / (vh * (1 + (wrap ? RUN : 0)));
    var flying = p < 1;
    hero.classList.toggle("dh-intro", flying);
    for (var i = 0; i < parts.length; i++) {
      if (!flying) { parts[i].el.style.opacity = ""; parts[i].el.style.transform = ""; continue; }
      var t = Math.max(0, Math.min(1, (p - parts[i].a) / (parts[i].b - parts[i].a)));
      t = iEase(t);
      parts[i].el.style.opacity = t.toFixed(3);
      parts[i].el.style.transform = parts[i].fx(t);
    }
  }
  function iQueue() { if (!iRaf) iRaf = requestAnimationFrame(iFrame); }
  /* A search reshapes the hero (results flow below) — hand the page back. */
  if (typeof MutationObserver !== "undefined") {
    new MutationObserver(function () {
      if (hero.classList.contains("dh-searching")) iTeardown();
    }).observe(hero, { attributes: true, attributeFilter: ["class"] });
  }
  window.addEventListener("scroll", iQueue, { passive: true });
  window.addEventListener("resize", iQueue, { passive: true });
  iFrame();
})();
</script>

<script>
(function () {
  /* Floating props: still by default, and only the one under the cursor
     wakes up — it follows the pointer magnetically (strength = its depth
     setting) with a small wobble, easing back to rest when the cursor leaves. */
  var hero = document.getElementById("dynHero");
  if (!hero) return;
  var fine = window.matchMedia && window.matchMedia("(pointer: fine)").matches;
  var calm = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var props = Array.prototype.slice.call(hero.querySelectorAll(".dh-prop"));
  if (!fine || calm || !props.length) return;
  var items = props.map(function (el) {
    return { el: el, f: Math.min(0.85, (parseFloat(el.getAttribute("data-depth")) || 5) * 0.08), tx: 0, ty: 0, cx: 0, cy: 0 };
  });
  var pRaf = 0;
  var pStep = function () {
    pRaf = 0;
    var busy = false;
    for (var i = 0; i < items.length; i++) {
      var it = items[i];
      it.cx += (it.tx - it.cx) * 0.12;
      it.cy += (it.ty - it.cy) * 0.12;
      it.el.style.setProperty("--px", it.cx.toFixed(1) + "px");
      it.el.style.setProperty("--py", it.cy.toFixed(1) + "px");
      it.el.style.setProperty("--pw", (it.cx * 0.12).toFixed(2) + "deg");
      if (Math.abs(it.tx - it.cx) > 0.2 || Math.abs(it.ty - it.cy) > 0.2) busy = true;
    }
    if (busy) pKick();
  };
  var pKick = function () { if (!pRaf) pRaf = requestAnimationFrame(pStep); };
  items.forEach(function (it) {
    it.el.addEventListener("pointermove", function (e) {
      var r = it.el.getBoundingClientRect();
      /* measure from the prop's REST centre (subtract its current shift)
         so following the cursor never feeds back into itself */
      var bx = r.left + r.width / 2 - it.cx;
      var by = r.top + r.height / 2 - it.cy;
      it.tx = (e.clientX - bx) * it.f;
      it.ty = (e.clientY - by) * it.f;
      pKick();
    });
    it.el.addEventListener("pointerleave", function () { it.tx = 0; it.ty = 0; pKick(); });
  });
})();
</script>

<script>
(function () {
  /* Hovering a corner chip scrambles its label through random characters,
     locking the real letters back in left to right — decode-style. */
  var hero = document.getElementById("dynHero");
  if (!hero) return;
  var fine = window.matchMedia && window.matchMedia("(pointer: fine)").matches;
  var calm = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!fine || calm) return;
  var CH = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&@";
  Array.prototype.forEach.call(hero.querySelectorAll(".dh-corner-link"), function (chip) {
    var txt = chip.querySelector(".dh-corner-txt");
    if (!txt) return;
    var orig = txt.textContent;
    var sRaf = 0;
    chip.addEventListener("mouseenter", function () {
      txt.style.display = "inline-block";
      txt.style.minWidth = txt.getBoundingClientRect().width + "px";
      var f = 0;
      cancelAnimationFrame(sRaf);
      var HOLD = 14, RATE = 3;
      var step = function () {
        f++;
        var lock = Math.max(0, Math.floor((f - HOLD) / RATE));
        var out = "";
        for (var i = 0; i < orig.length; i++) {
          var c = orig.charAt(i);
          if (c === " ") { out += c; continue; }
          out += i < lock ? c : CH.charAt(Math.floor(Math.random() * CH.length));
        }
        txt.textContent = out;
        if (lock < orig.length) sRaf = requestAnimationFrame(step);
        else txt.textContent = orig;
      };
      sRaf = requestAnimationFrame(step);
    });
    chip.addEventListener("mouseleave", function () {
      cancelAnimationFrame(sRaf);
      txt.textContent = orig;
    });
  });
})();
</script>

<script>
(function () {
  /* Phone hamburger: the corner links fold into a drop-down menu. */
  var btn = document.getElementById("dhMenuBtn");
  var menu = document.getElementById("dhMenu");
  var close = document.getElementById("dhMenuClose");
  if (!btn || !menu || !close) return;
  function setOpen(v) {
    menu.classList.toggle("is-open", v);
    btn.setAttribute("aria-expanded", v ? "true" : "false");
    document.documentElement.style.overflow = v ? "hidden" : "";
  }
  btn.addEventListener("click", function () { setOpen(!menu.classList.contains("is-open")); });
  close.addEventListener("click", function () { setOpen(false); });
  menu.addEventListener("click", function (e) {
    if (e.target && e.target.closest && e.target.closest(".dh-mmenu-link")) setOpen(false);
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && menu.classList.contains("is-open")) setOpen(false);
  });
})();
</script>

