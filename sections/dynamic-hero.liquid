{ "type": "text", "id": "exclude_keywords", "label": "Hide products whose name contains", "default": "gift wrapping, back print", "info": "Comma-separated. Any product whose title contains one of these is hidden from the grid and the 'Surprise me' button (e.g. add-ons like gift wrapping)." },
{ "type": "select", "id": "image_ratio", "label": "Image shape", "default": "natural",
"options": [ { "value": "natural", "label": "Natural (tall)" }, { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape" } ] },

{ "type": "header", "content": "Card" },
