40% { transform: rotate(calc(var(--pinrot, -32deg) + 14deg)) scale(1.18); }
}
.dyn-hero .dh-float-pin.is-jab { animation: dhPinJab 0.3s ease; }
.dyn-hero .dh-float-pin.is-ret { transition: left 0.45s cubic-bezier(0.22, 1, 0.36, 1), top 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
@keyframes dhFloatPop {
0%   { transform: scale(1); opacity: 1; }
35%  { transform: scale(1.28) rotate(7deg); opacity: 1; }
100% { transform: scale(0.05) rotate(-16deg); opacity: 0; }
}
.dyn-hero .dh-float.is-pop { animation: dhFloatPop 0.32s ease-in forwards; }
