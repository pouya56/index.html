ctx.globalAlpha = 1;
if (Math.random() < 0.06) {
var gy2 = Math.random() * H * 0.9, gh = 6 + Math.random() * 26, gx2 = (Math.random() - 0.5) * 24;
ctx.save();
ctx.globalCompositeOperation = "lighter";
ctx.globalAlpha = 0.5;
ctx.drawImage(cv, 0, gy2 * DPR, cv.width, gh * DPR, gx2, gy2, W, gh);
ctx.restore();
}
}
}

var A = 1.0, B = 0.4;
function drawTorus(dt) {
var tA = 0.9 + my * 1.6, tB = 0.35 + mx * 1.8;
vA += (tA - vA) * 0.04; vB += (tB - vB) * 0.04;
if (!calm) { A += vA * dt * 0.001; B += vB * dt * 0.001; }
ctx.clearRect(0, 0, cv.width, cv.height);
ctx.fillStyle = INK;
var buf = new Array(cols * rows).fill(" ");
var zb = new Float32Array(cols * rows);
var R1 = 1, R2 = 2, K2 = 5;
var K1 = Math.min(cols, rows * 1.9) * K2 * 3 / (8 * (R1 + R2));
var cA = Math.cos(A), sA = Math.sin(A), cB = Math.cos(B), sB = Math.sin(B);
for (var th = 0; th < 6.28; th += 0.07) {
var ct = Math.cos(th), st = Math.sin(th);
var circx = R2 + R1 * ct, circy = R1 * st;
for (var ph = 0; ph < 6.28; ph += 0.03) {
var cp = Math.cos(ph), sp = Math.sin(ph);
var x = circx * (cB * cp + sA * sB * sp) - circy * cA * sB;
var y = circx * (sB * cp - sA * cB * sp) + circy * cA * cB;
var z = K2 + cA * circx * sp + circy * sA;
var ooz = 1 / z;
var xp = Math.floor(cols / 2 + K1 * ooz * x);
var yp = Math.floor(rows / 2 - K1 * 0.5 * ooz * y);
if (xp < 0 || xp >= cols || yp < 0 || yp >= rows) continue;
var L = cp * ct * sB - cA * ct * sp - sA * st + cB * (cA * st - ct * sA * sp);
var idx = yp * cols + xp;
if (ooz > zb[idx]) {
zb[idx] = ooz;
buf[idx] = CH.charAt(Math.max(0, Math.floor(L * 8)));
}
}
}
for (var yy = 0; yy < rows; yy++) {
ctx.fillText(buf.slice(yy * cols, yy * cols + cols).join(""), 0, yy * CELL);
}
}

function frame(t) {
raf = 0;
if (!running) return;
var dt = Math.min(80, t - (last || t));
if (t - last >= 30) {
last = t;
if (mode === "image") drawImageMode(t);
else if (mode === "dither") drawDither(t);
else drawTorus(dt);
if (calm) return;    }
raf = requestAnimationFrame(frame);
}
function start() { if (!running) { running = true; if (!raf) raf = requestAnimationFrame(frame); } }
function stop() { running = false; }

hero.addEventListener("pointermove", function (e) {
var r = hero.getBoundingClientRect();
mx = e.clientX / Math.max(1, r.width) - 0.5;
my = e.clientY / Math.max(1, r.height) - 0.5;
if (calm && running) { last = 0; if (!raf) raf = requestAnimationFrame(frame); }
});
window.addEventListener("resize", function () { size(); last = 0; }, { passive: true });
if (typeof IntersectionObserver !== "undefined") {
new IntersectionObserver(function (es) {
es.forEach(function (e) { if (e.isIntersecting) start(); else stop(); });
}, { threshold: 0.05 }).observe(hero);
}

size();
if (mode === "image" || mode === "dither") {
img = new Image();
img.crossOrigin = "anonymous";
img.onload = function () { imgReady = true; sampleImage(); start(); };
img.onerror = function () { cv.style.display = "none"; };
img.src = cv.getAttribute("data-img") || "";
if (!img.src) cv.style.display = "none";
} else {
start();
}
})();
</script>

