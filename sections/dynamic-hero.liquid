<circle cx="70" cy="202" r="2"/><circle cx="78" cy="198" r="2"/><circle cx="62" cy="198" r="2"/><circle cx="70" cy="194" r="2"/><circle cx="78" cy="206" r="2"/><circle cx="62" cy="206" r="2"/>
