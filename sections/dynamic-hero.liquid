                    <a class="dh-app" href="/pages/contact"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span></span><span class="dh-app-label">Contact</span></a>
                    <a class="dh-app" href="/pages/about"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="12" y1="11" x2="12" y2="16"/><line x1="12" y1="8" x2="12" y2="8"/></svg></span></span><span class="dh-app-label">About</span></a>
                    <a class="dh-app" href="/blogs/news"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg></span></span><span class="dh-app-label">Blog</span></a>
                    <a class="dh-app" href="{{ routes.account_url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></span></span><span class="dh-app-label">Account</span></a>
                    <a class="dh-app" href="{{ routes.cart_url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1.5"/><circle cx="18" cy="21" r="1.5"/><path d="M2 3h3l2.5 13h11l2-8H6"/></svg></span></span><span class="dh-app-label">Cart</span></a>
                    <a class="dh-app" href="/pages/gift-card"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><rect x="3.5" y="8" width="17" height="4.5" rx="1"/><path d="M5 12.5V20h14v-7.5"/><path d="M12 8v12"/><path d="M12 8C11 5.5 7.5 5.5 7.5 7.6 7.5 9 9.6 8 12 8Zm0 0c1-2.5 4.5-2.5 4.5-.4C16.5 9 14.4 8 12 8Z"/></svg></span></span><span class="dh-app-label">Gift cards</span></a>
                    <a class="dh-app" href="{{ routes.root_url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg></span></span><span class="dh-app-label">Home</span></a>
                    {%- comment -%} Store policies (Settings > Policies) appear here automatically. {%- endcomment -%}
                    {%- for policy in shop.policies -%}
                      {%- if policy != blank and policy.url != blank -%}
                        <a class="dh-app" href="{{ policy.url }}"><span class="dh-app-ic"><span class="dh-app-svg"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5"/><line x1="8.5" y1="13" x2="15.5" y2="13"/><line x1="8.5" y1="16.5" x2="13.5" y2="16.5"/></svg></span></span><span class="dh-app-label">{{ policy.title }}</span></a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.show_account -%}
            <div class="dh-menu dh-acct-menu">
              <button type="button" class="dh-icon-btn dh-acct-btn" aria-haspopup="true" aria-expanded="false" aria-label="Account">
                {%- if section.settings.account_avatar != blank -%}
                  {%- assign avw = section.settings.account_avatar.width | times: 30 | divided_by: section.settings.account_avatar.height -%}
                  <img class="dh-avatar" src="{{ section.settings.account_avatar | image_url: width: 90 }}" alt="Account" width="{{ avw }}" height="30">
                {%- elsif customer -%}
                  <span class="dh-avatar dh-avatar-initial" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0 | upcase }}</span>
                {%- else -%}
                  <svg class="dh-acct-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.5"/><circle cx="12" cy="10" r="3.4"/><path d="M5.6 19.2a7 7 0 0 1 12.8 0"/></svg>
                {%- endif -%}
              </button>
              <div class="dh-pop dh-acct-pop" hidden>
                {%- if customer -%}
                  {%- assign account_page = section.settings.account_page_url | default: '/pages/account' -%}
                  <div class="dh-pop-title">Hi, {{ customer.first_name | default: 'there' }}</div>
                  <a class="dh-pop-link" href="https://shopify.com/{{ shop.id }}/account/orders">Orders <svg class="dh-pop-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg></a>
                  <a class="dh-pop-link" href="{{ account_page }}?tab=wishlist">Wishlist</a>
                  <a class="dh-pop-link" href="{{ account_page }}?tab=designs">Saved Designs</a>
                  <a class="dh-pop-link" href="{{ account_page }}?tab=reviews">Reviews</a>
                  <a class="dh-pop-link" href="https://shopify.com/{{ shop.id }}/account/profile">Profile <svg class="dh-pop-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg></a>
                  <a class="dh-pop-link" href="{{ routes.account_logout_url }}">Log out</a>
                {%- else -%}
                  <div class="dh-pop-title">Your account</div>
                  <p class="dh-pop-note">Sign in with your email — Shopify sends you a secure login code, so there’s no password to remember or forget.</p>
                  <a class="dh-pop-btn dh-pop-cta" href="{{ section.settings.login_url | default: routes.account_login_url }}">Log in / Sign up</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- capture corner_group -%}{{ corner_links }}{{ corner_extra }}{%- endcapture -%}
      {%- if corner_group != blank -%}<div class="dh-corner-group dh-corner-{{ pos }}">{{ corner_group }}</div>{%- endif -%}
  {%- endfor -%}
  {%- if section.settings.copyright_text != blank -%}
    <div class="dh-copyright">{{ section.settings.copyright_text }}</div>
  {%- endif -%}
  <div class="dh-wrap">
    <div class="dh-head">
      {%- if section.settings.head_link != blank -%}<a class="dh-head-link" href="{{ section.settings.head_link }}" aria-label="{{ shop.name | escape }}">{%- endif -%}
      {%- if section.settings.head_video != blank -%}
        <video class="dh-head-video" autoplay muted playsinline preload="metadata"
          {% if section.settings.head_video.preview_image %}poster="{{ section.settings.head_video.preview_image | image_url: width: 800 }}"{% endif %}>
          {%- for source in section.settings.head_video.sources -%}
            {%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}
          {%- endfor -%}
        </video>
      {%- elsif section.settings.heading_logo != blank -%}
        {%- assign hlw = section.settings.heading_logo.width | times: 56 | divided_by: section.settings.heading_logo.height -%}
        <img class="dh-head-logo" src="{{ section.settings.heading_logo | image_url: width: 700 }}" alt="{{ shop.name | escape }}" width="{{ hlw }}" height="56">
      {%- else -%}
        <h1>{{ section.settings.heading | default: coll.title | default: 'Store' }}</h1>
      {%- endif -%}
      {%- if section.settings.head_link != blank -%}</a>{%- endif -%}
      {%- if section.settings.show_description and coll.description != blank -%}
        <div class="dh-desc">{{ coll.description | strip_html | truncatewords: 40 }}</div>
      {%- endif -%}
    </div>

    {%- assign prods = coll.products -%}
    {%- if prods.size == 0 -%}
      <div class="dh-empty">
        <p>{{ section.settings.empty_text | default: 'Nothing here yet.' }}</p>
        <a href="{{ routes.all_products_collection_url }}">{{ section.settings.empty_link_label | default: 'Browse all products' }}</a>
      </div>
    {%- else -%}
      {%- if section.settings.show_search -%}
        <div class="dh-search">
          <svg class="dh-search-mag" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" id="dhSearch" class="dh-search-input" autocomplete="off" aria-label="Search products"
            data-typing="{{ section.settings.search_examples | escape }}"
            placeholder="{{ section.settings.search_placeholder | default: 'Search these products…' }}">
          <button type="button" class="dh-search-go" id="dhSearchGo" aria-label="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
          </button>
        </div>
        {%- if section.settings.show_btn1 or section.settings.show_btn2 -%}
          <div class="dh-hero-btns">
            {%- if section.settings.show_btn1 -%}<button type="button" class="dh-gbtn" id="dhBtnSearch">{{ section.settings.btn1_label | default: 'Search' }}</button>{%- endif -%}
            {%- if section.settings.show_btn2 -%}<a class="dh-gbtn" href="{{ section.settings.btn2_url | default: routes.all_products_collection_url }}">{{ section.settings.btn2_label | default: 'Shop all' }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
      {%- comment -%} Build the category tabs from product type or tag. {%- endcomment -%}
      {%- if section.settings.show_grid -%}
      {%- if cat_source == 'tag' -%}
        {%- assign cats = coll.all_tags -%}
      {%- else -%}
        {%- assign cats = coll.all_types -%}
      {%- endif -%}

      {%- assign real_cats = '' -%}
      {%- for c in cats -%}{%- if c != blank -%}{%- assign real_cats = real_cats | append: '1' -%}{%- endif -%}{%- endfor -%}

      {%- assign tab_count = 0 -%}
      {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}{%- endfor -%}

      {%- if section.settings.show_tabs and tab_count > 0 -%}
        {%- comment -%} Image tabs: merchant-defined blocks with an uploaded picture per category. {%- endcomment -%}
        <div class="dh-tabs-wrap" id="dhTabsWrap">
        <button type="button" class="dh-tabs-arrow dh-prev" id="dhPrev" aria-label="Scroll categories left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
        <div class="dh-tabs is-images" id="dhTabs" role="tablist">
          {%- if section.settings.show_all_tab -%}
          <button type="button" class="dh-tab is-active" data-cat="__all" role="tab" aria-selected="true">
            <span class="dh-tab-img dh-tab-all">
              {%- if section.settings.all_image != blank -%}
                <img src="{{ section.settings.all_image | image_url: width: 200 }}" alt="{{ section.settings.all_label | default: 'All' | escape }}" width="68" height="68" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
              {%- endif -%}
            </span>
            <span class="dh-tab-label">{{ section.settings.all_label | default: 'All' }}</span>
          </button>
          {%- endif -%}
          {%- assign tab_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- unless block.type == 'tab' -%}{%- continue -%}{%- endunless -%}
            {%- assign tab_i = tab_i | plus: 1 -%}
            {%- assign cv = block.settings.category_value -%}
            {%- assign first_active = false -%}
            {%- if section.settings.show_all_tab == false and tab_i == 1 -%}{%- assign first_active = true -%}{%- endif -%}
            <button type="button" class="dh-tab{% if first_active %} is-active{% endif %}" data-cat="{{ cv | handle }}" role="tab" aria-selected="{% if first_active %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
              <span class="dh-tab-img">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.label | escape }}" width="68" height="68" loading="lazy">
                {%- else -%}
                  <span class="dh-tab-init">{{ block.settings.label | default: cv | slice: 0 | upcase }}</span>
                {%- endif -%}
              </span>
              <span class="dh-tab-label">{{ block.settings.label | default: cv }}</span>
            </button>
          {%- endfor -%}
        </div>
        <button type="button" class="dh-tabs-arrow dh-next" id="dhNext" aria-label="Scroll categories right" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
        </div>
      {%- elsif section.settings.show_tabs and real_cats != blank -%}
        {%- comment -%} Auto text-pill tabs from product type / tag. {%- endcomment -%}
        <div class="dh-tabs is-pills" id="dhTabs" role="tablist">
          {%- if section.settings.show_all_tab -%}
          <button type="button" class="dh-tab is-active" data-cat="__all" role="tab" aria-selected="true">{{ section.settings.all_label | default: 'All' }}</button>
          {%- endif -%}
          {%- assign shown_i = 0 -%}
          {%- for c in cats -%}
            {%- unless c == blank -%}
              {%- assign shown_i = shown_i | plus: 1 -%}
              {%- assign first_active = false -%}
              {%- if section.settings.show_all_tab == false and shown_i == 1 -%}{%- assign first_active = true -%}{%- endif -%}
              <button type="button" class="dh-tab{% if first_active %} is-active{% endif %}" data-cat="{{ c | handle }}" role="tab" aria-selected="{% if first_active %}true{% else %}false{% endif %}">{{ c }}</button>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="dh-shelf-wrap" id="dhShelfWrap">
      <button type="button" class="dh-shelf-arrow dh-prev" id="dhGridPrev" aria-label="Scroll products left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
      <div class="dh-grid" id="dhGrid">
        {%- assign hide_tag = section.settings.hide_tag | default: 'hidden' -%}
        {%- for product in prods limit: section.settings.max_products -%}
          {%- if product.tags contains hide_tag -%}{%- continue -%}{%- endif -%}
          {%- assign on_sale = false -%}
          {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}

          {%- comment -%} Best-seller badge: by tag, and/or the top N when the collection is sorted by Best selling. {%- endcomment -%}
          {%- assign is_best = false -%}
          {%- if section.settings.show_bestseller -%}
            {%- assign bs_tag = section.settings.bestseller_tag | default: 'bestseller' | downcase | strip -%}
            {%- for t in product.tags -%}
              {%- assign tl = t | downcase | strip -%}
              {%- if tl == bs_tag -%}{%- assign is_best = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- assign bs_top = section.settings.bestseller_top | default: 0 -%}
            {%- if bs_top > 0 and forloop.index <= bs_top -%}{%- assign is_best = true -%}{%- endif -%}
          {%- endif -%}

          {%- comment -%} New badge: shows for a set number of days after the product was published, then disappears on its own. {%- endcomment -%}
          {%- assign is_new = false -%}
          {%- if section.settings.show_new -%}
            {%- assign new_days = section.settings.new_days | default: 14 -%}
            {%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
            {%- assign pub_s = product.published_at | date: '%s' | plus: 0 -%}
            {%- if pub_s > 0 -%}
              {%- assign age_days = now_s | minus: pub_s | divided_by: 86400 -%}
              {%- if age_days <= new_days -%}{%- assign is_new = true -%}{%- endif -%}
            {%- endif -%}
          {%- endif -%}

          {%- if cat_source == 'tag' -%}
            {%- capture card_cat -%}{% for tag in product.tags %}{{ tag | handle }} {% endfor %}{%- endcapture -%}
          {%- else -%}
            {%- assign card_cat = product.type | handle -%}
          {%- endif -%}

          {%- assign img2 = blank -%}
          {%- if product.images.size > 1 -%}{%- assign img2 = product.images[1] -%}{%- endif -%}

          {%- capture card_search -%}{{ product.title }} {{ product.type }} {{ product.vendor }} {% for t in product.tags %}{{ t }} {% endfor %}{% for opt in product.options_with_values %}{{ opt.name }} {% for v in opt.values %}{{ v }} {% endfor %}{% endfor %}{%- endcapture -%}
          <div class="dh-card" data-cat="{{ card_cat | strip }}" data-flags="{% if is_new %}new {% endif %}{% if is_best %}best {% endif %}{% if on_sale %}sale {% endif %}" data-search="{{ card_search | downcase | strip_newlines | escape }}">
            <div class="dh-media-wrap">
            <a class="dh-media" href="{{ product.url }}">
              <div class="dh-badges">
                {%- if is_new -%}
                  <span class="dh-badge dh-badge-new">{{ section.settings.new_label | default: 'New' }}</span>
                {%- endif -%}
                {%- if is_best -%}
                  <span class="dh-badge dh-badge-best"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9z"/></svg>{{ section.settings.bestseller_label | default: 'Best seller' }}</span>
                {%- endif -%}
                {%- if on_sale -%}
                  {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                  <span class="dh-badge dh-badge-sale">Save {{ pct }}%</span>
                {%- endif -%}
                {%- unless product.available -%}<span class="dh-badge dh-badge-soldout">Sold out</span>{%- endunless -%}
              </div>
              {%- if product.featured_image -%}
                <img class="dh-img-1{% if img2 != blank %} has-2{% endif %}" src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}" width="600" height="600" loading="lazy">
                {%- if img2 != blank -%}
                  <img class="dh-img-2" src="{{ img2 | image_url: width: 600 }}" alt="" width="600" height="600" loading="lazy" aria-hidden="true">
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'dh-img-1 dh-ph' }}
              {%- endif -%}
            </a>
            <button type="button" class="dh-save" aria-label="Save to wishlist" aria-pressed="false"
              data-wl-id="{{ product.handle }}"
              data-wl-title="{{ product.title | escape }}"
              data-wl-url="{{ product.url }}"
              data-wl-image="{{ product.featured_image | image_url: width: 400 }}"
              data-wl-price="{{ product.price | money }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-5-7 5V4a1 1 0 0 1 1-1Z"/></svg>
            </button>
            </div>

            <div class="dh-body">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <div class="dh-vendor">{{ product.vendor }}</div>
              {%- endif -%}
              <h3 class="dh-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="dh-price">
                <span class="dh-now{% if on_sale %} on-sale{% endif %}">{{ product.price | money }}</span>
                {%- if on_sale -%}<span class="dh-was">{{ product.compare_at_price | money }}</span>{%- endif -%}
              </div>

              {%- if section.settings.show_swatches -%}
                {%- assign color_opt = blank -%}
                {%- for o in product.options_with_values -%}
                  {%- assign on = o.name | downcase -%}
                  {%- if on contains 'color' or on contains 'colour' -%}{%- assign color_opt = o -%}{%- endif -%}
                {%- endfor -%}
                {%- if color_opt != blank -%}
                  <div class="dh-swatches">
                    {%- assign shown = 0 -%}
                    {%- assign cidx = color_opt.position | minus: 1 -%}
                    {%- for val in color_opt.values -%}
                      {%- if shown < 5 -%}
                        {%- assign vimg = '' -%}
                        {%- for v in product.variants -%}
                          {%- assign optval = v.options[cidx] -%}
                          {%- if optval == val and v.image -%}{%- assign vimg = v.image | image_url: width: 600 -%}{%- break -%}{%- endif -%}
                        {%- endfor -%}
                        <button type="button" class="dh-swatch" data-color="{{ val | escape }}" data-img="{{ vimg }}"
                          title="{{ val | escape }}" aria-label="{{ val | escape }}"></button>
                        {%- assign shown = shown | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign extra = color_opt.values.size | minus: 5 -%}
                    {%- if extra > 0 -%}<span class="dh-swatch-more">+{{ extra }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      <button type="button" class="dh-shelf-arrow dh-next" id="dhGridNext" aria-label="Scroll products right" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
      </div>
      <div class="dh-noresults" id="dhNoResults">
        <svg class="dh-nr-face" viewBox="0 0 48 48" aria-hidden="true"><circle cx="18" cy="20" r="2" fill="currentColor"/><circle cx="30" cy="20" r="2" fill="currentColor"/><path class="dh-nr-mouth" d="M15 30 Q24 23 33 30" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        <p class="dh-nr-title">{{ section.settings.noresults_title | default: 'No matches — yet.' }}</p>
        <p class="dh-nr-msg">{{ section.settings.noresults_message | default: "Can't find what you're looking for? Tell us what you had in mind — we might still be able to make it." }}</p>
        <a class="dh-nr-btn" href="{{ section.settings.noresults_url | default: '/pages/contact' }}">{{ section.settings.noresults_link_label | default: 'Contact us' }}</a>
      </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<noscript>
  <style>.dyn-hero .dh-grid .dh-card { opacity: 1 !important; transform: none !important; }</style>
</noscript>

<script>
(function () {
  var root = document.getElementById("dynHero");
  if (!root) return;

  // Head video: play once and stop (no loop).
  var headVid = root.querySelector(".dh-head-video");
  if (headVid) {
    headVid.loop = false; headVid.muted = true;
    var hp = headVid.play(); if (hp && hp.catch) hp.catch(function () {});
  }

  // Dropdown menus: account login + apps grid. Click to toggle; outside/Esc closes.
  /* Any link pointing to #wishlist opens the wishlist drawer (from the header
     section) instead of navigating — used by the "Wishlist / heart" app icon. */
  document.addEventListener("click", function (e) {
    var a = e.target.closest ? e.target.closest('a[href$="#wishlist"], a[href="#wishlist"]') : null;
    if (!a) return;
    e.preventDefault();
    if (window.DynamicHeader && window.DynamicHeader.openWishlist) { window.DynamicHeader.openWishlist(); }
  }, true);

  var menus = Array.prototype.slice.call(root.querySelectorAll(".dh-menu"));
  function closeMenus(except) {
    menus.forEach(function (m) {
      if (m === except) return;
      var b = m.querySelector(".dh-icon-btn"), p = m.querySelector(".dh-pop");
      if (p) p.hidden = true; if (b) b.setAttribute("aria-expanded", "false");
    });
  }
  menus.forEach(function (m) {
    var btn = m.querySelector(".dh-icon-btn"), pop = m.querySelector(".dh-pop");
    if (!btn || !pop) return;
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var willOpen = pop.hidden;
      closeMenus(m);
      pop.hidden = !willOpen;
      btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
    });
    pop.addEventListener("click", function (e) { e.stopPropagation(); });
  });
  if (menus.length) {
    document.addEventListener("click", function () { closeMenus(null); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeMenus(null); });
    // If a login attempt came back with an error, re-open the account menu so it's visible.
    var errMenu = root.querySelector(".dh-acct-pop [data-has-error]");
    if (errMenu) {
      var pop = errMenu.closest(".dh-pop"), mm = errMenu.closest(".dh-menu");
      if (pop) pop.hidden = false;
      if (mm) { var b = mm.querySelector(".dh-icon-btn"); if (b) b.setAttribute("aria-expanded", "true"); }
    }
  }

  // Login button feedback: verify the password against Shopify, then flash the
  // button green with a ✓ on success or red with a ✕ on a wrong password.
  var loginForm = root.querySelector(".dh-login-form");
  if (loginForm) {
    var loginBtn = loginForm.querySelector(".dh-pop-btn");
    var loginBtnHTML = loginBtn ? loginBtn.innerHTML : "";
    var OK_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
    var X_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>';
    function setLogin(state) {
      if (!loginBtn) return;
      loginBtn.classList.remove("is-ok", "is-err", "is-loading");
      if (state === "loading") { loginBtn.classList.add("is-loading"); loginBtn.disabled = true; }
      else if (state === "ok") { loginBtn.classList.add("is-ok"); loginBtn.innerHTML = OK_SVG; }
      else if (state === "err") { loginBtn.classList.add("is-err"); loginBtn.innerHTML = X_SVG; loginBtn.disabled = false; }
      else { loginBtn.disabled = false; loginBtn.innerHTML = loginBtnHTML; }
    }
    loginForm.addEventListener("submit", function (e) {
      var email = loginForm.querySelector('input[name="customer[email]"]');
      var pwd = loginForm.querySelector('input[name="customer[password]"]');
      // Empty fields or passwordless accounts: let Shopify handle it normally.
      if (!email || !email.value || !pwd || !pwd.value) return;
      e.preventDefault();
      if (loginBtn && loginBtn.dataset.busy) return;
      if (loginBtn) loginBtn.dataset.busy = "1";
      setLogin("loading");
      var action = loginForm.getAttribute("action") || "/account/login";
      fetch(action, { method: "POST", body: new FormData(loginForm), headers: { "Accept": "text/html" } })
        .then(function (res) {
          var url = res.url || "";
          var stayedOnLogin = !res.redirected || url.indexOf("/account/login") >= 0 || url.indexOf("/account/register") >= 0;
          if (!stayedOnLogin) {
            setLogin("ok");
            setTimeout(function () { window.location.href = url || "/account"; }, 720);
          } else {
            setLogin("err");
            if (loginBtn) loginBtn.dataset.busy = "";
            setTimeout(function () { setLogin("reset"); }, 1900);
          }
        })
        .catch(function () {
          if (loginBtn) loginBtn.dataset.busy = "";
          loginForm.submit(); // network issue → fall back to a normal submit
        });
    });
  }

  var grid = document.getElementById("dhGrid");
  var tabs = document.getElementById("dhTabs");
  var noRes = document.getElementById("dhNoResults");
  var tabsWrap = document.getElementById("dhTabsWrap");
  var shelfWrap = document.getElementById("dhShelfWrap");
  var hideUntilSearch = root.getAttribute("data-hide-until-search") === "true";
  var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll(".dh-card")) : [];

  // How many cards are visible at once (for a per-row left->right sweep).
  function colCount() {
    var first = grid.querySelector(".dh-card");
    if (!first) return 1;
    var cw = first.getBoundingClientRect().width + 22; // card + gap
    var n = Math.round(grid.clientWidth / cw);
    return Math.max(1, n || 1);
  }

  // Reveal the given cards with a left-to-right, row-by-row cascade.
  function reveal(visible) {
    var cols = colCount();
    visible.forEach(function (c) { c.classList.remove("in"); c.style.transitionDelay = "0ms"; });
    void grid.offsetWidth; // force reflow so removing/re-adding .in restarts the transition
    visible.forEach(function (c, i) {
      var col = i % cols, rowN = Math.floor(i / cols);
      c.style.transitionDelay = (col * 55 + rowN * 60) + "ms";
      c.classList.add("in");
    });
  }

  // Typo-tolerant matching (Levenshtein edit distance) so small misspellings still match.
  function lev(a, b) {
    var m = a.length, n = b.length; if (!m) return n; if (!n) return m;
    var d = [], i, j;
    for (i = 0; i <= m; i++) { d[i] = []; d[i][0] = i; }
    for (j = 0; j <= n; j++) d[0][j] = j;
    for (i = 1; i <= m; i++) {
      for (j = 1; j <= n; j++) {
        var cost = a.charCodeAt(i - 1) === b.charCodeAt(j - 1) ? 0 : 1;
        d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
        if (i > 1 && j > 1 && a.charCodeAt(i - 1) === b.charCodeAt(j - 2) && a.charCodeAt(i - 2) === b.charCodeAt(j - 1)) {
          d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1); // adjacent transposition (e.g. "mgu" -> "mug")
        }
      }
    }
    return d[m][n];
  }
  function wordHit(q, words) {
    var tol = q.length <= 5 ? 1 : (q.length <= 8 ? 2 : 3);
    for (var k = 0; k < words.length; k++) {
      var w = words[k]; if (!w) continue;
      if (w.indexOf(q) >= 0) return true;
      if (q.length < 3) continue;
      if (lev(q, w) <= tol) return true;
      if (w.length > q.length && lev(q, w.slice(0, q.length)) <= tol) return true;
    }
    return false;
  }
  function queryMatch(query, text) {
    if (!query) return true;
    if (text.indexOf(query) >= 0) return true;
    var qw = query.split(/\s+/), tw = text.split(/\s+/), i;
    for (i = 0; i < qw.length; i++) { if (qw[i] && !wordHit(qw[i], tw)) return false; }
    return true;
  }

  // Combined filter: current category tab AND the live search query.
  var currentCat = "__all";
  var query = "";
  var badgeFilter = null; // 'new' | 'best' | 'sale' — clicking a badge filters to it
  var badgeLabels = { "new": "New", "best": "Best sellers", "sale": "On sale" };
  var badgeChip = null, badgeChipTxt = null;
  function applyFilters() {
    // Landing mode: shrink + raise the logo/search once the shopper searches.
    if (hideUntilSearch) root.classList.toggle("dh-searching", query.length > 0);
    if (!grid) return; // grid removed from the hero — nothing to filter here
    // Home-page mode: keep the tabs + grid hidden until the shopper searches.
    if (hideUntilSearch && query.length === 0) {
      if (tabsWrap) tabsWrap.style.display = "none";
      if (shelfWrap) shelfWrap.style.display = "none";
      if (noRes) noRes.style.display = "none";
      return;
    }
    if (tabsWrap) tabsWrap.style.display = "";
    if (shelfWrap) shelfWrap.style.display = "";

    // When searching, look across ALL categories (ignore the tab); otherwise show the active tab.
    var searching = query.length > 0;
    if (tabs) tabs.querySelectorAll(".dh-tab").forEach(function (b) {
      b.classList.toggle("is-active", searching ? b.getAttribute("data-cat") === "__all" : b.getAttribute("data-cat") === currentCat);
    });
    var visible = [];
    cards.forEach(function (c) {
      var cc = " " + (c.getAttribute("data-cat") || "") + " ";
      var okCat = currentCat === "__all" || cc.indexOf(" " + currentCat + " ") >= 0;
      var okQ = !query || queryMatch(query, c.getAttribute("data-search") || "");
      var match;
      if (badgeFilter) {
        // A badge is selected: show every product carrying that badge (across all
        // categories), still narrowed by the search box if the shopper is typing.
        var fl = " " + (c.getAttribute("data-flags") || "") + " ";
        match = fl.indexOf(" " + badgeFilter + " ") >= 0 && okQ;
      } else {
        match = searching ? okQ : okCat;
      }
      c.style.display = match ? "" : "none";
      if (match) visible.push(c);
    });
    if (badgeChip) {
      if (badgeFilter) { badgeChip.hidden = false; if (badgeChipTxt) badgeChipTxt.textContent = badgeLabels[badgeFilter] || badgeFilter; }
      else { badgeChip.hidden = true; }
    }
    if (noRes) noRes.style.display = visible.length ? "none" : "block";
    grid.scrollLeft = 0;
    reveal(visible);
    updateGridArrows();
  }

  if (tabs) tabs.addEventListener("click", function (e) {
    var btn = e.target.closest(".dh-tab"); if (!btn) return;
    tabs.querySelectorAll(".dh-tab").forEach(function (b) { b.classList.remove("is-active"); b.setAttribute("aria-selected", "false"); });
    btn.classList.add("is-active"); btn.setAttribute("aria-selected", "true");
    try { btn.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" }); } catch (x) {}
    // Clicking a tab clears the search and just opens that category.
    if (searchEl) searchEl.value = "";
    query = "";
    badgeFilter = null;
    currentCat = btn.getAttribute("data-cat"); applyFilters();
  });

  // A small chip appears while a badge filter is active, so the shopper can clear it.
  (function () {
    var anchor = shelfWrap || tabsWrap || grid;
    if (!anchor || !anchor.parentNode) return;
    badgeChip = document.createElement("div");
    badgeChip.className = "dh-badge-chip"; badgeChip.hidden = true;
    badgeChip.innerHTML = '<span class="dh-badge-chip-txt"></span><button type="button" class="dh-badge-chip-x" aria-label="Clear filter">&#10005;</button>';
    anchor.parentNode.insertBefore(badgeChip, anchor);
    badgeChipTxt = badgeChip.querySelector(".dh-badge-chip-txt");
    badgeChip.querySelector(".dh-badge-chip-x").addEventListener("click", function () { badgeFilter = null; applyFilters(); });
  })();

  // Clicking a badge on a card filters the grid to that badge instead of opening the product.
  if (grid) grid.addEventListener("click", function (e) {
    var badge = e.target.closest ? e.target.closest(".dh-badge") : null;
    if (!badge) return;
    var flag = badge.classList.contains("dh-badge-new") ? "new"
             : badge.classList.contains("dh-badge-best") ? "best"
             : badge.classList.contains("dh-badge-sale") ? "sale" : null;
    if (!flag) return;
    e.preventDefault(); e.stopPropagation();
    badgeFilter = (badgeFilter === flag) ? null : flag;
    if (searchEl) searchEl.value = "";
    query = ""; currentCat = "__all";
    applyFilters();
  }, true);

  // Live search. Normally filters the on-page grid as the shopper types. If a
  // "results page" URL is set, Enter/submit opens that page with the query.
  var searchEl = document.getElementById("dhSearch");
  var searchBtn = document.getElementById("dhSearchGo");
  var resultsUrl = (root.getAttribute("data-results-url") || "").trim();
  var ARROW_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>';
  var CHECK_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
  // Turn the search arrow green with a checkmark, then run cb (used before navigating).
  function flashArrowOk(cb) {
    if (!searchBtn) { if (cb) cb(); return; }
    searchBtn.classList.add("is-ok");
    searchBtn.innerHTML = CHECK_SVG;
    if (cb) setTimeout(cb, 430);
  }
  function resetArrow() {
    if (!searchBtn) return;
    searchBtn.classList.remove("is-ok");
    searchBtn.innerHTML = ARROW_SVG;
  }
  function runSearch(q) {
    if (!q) return;
    if (resultsUrl) {
      flashArrowOk(function () {
        window.location.href = resultsUrl + (resultsUrl.indexOf("?") >= 0 ? "&" : "?") + "q=" + encodeURIComponent(q);
      });
    } else {
      query = q.toLowerCase(); applyFilters();
      flashArrowOk(null); setTimeout(resetArrow, 1300);
      if (searchEl) searchEl.focus();
    }
  }
  if (searchEl) {
    searchEl.addEventListener("input", function () {
      if (resultsUrl) return; // redirect mode: don't filter here
      query = searchEl.value.trim().toLowerCase();
      if (query) badgeFilter = null; // typing takes over from a badge filter
      applyFilters();
    });
    searchEl.addEventListener("keydown", function (e) {
      if (e.key !== "Enter") return;
      e.preventDefault();
      runSearch(searchEl.value.trim());
    });
  }
  if (searchBtn) searchBtn.addEventListener("click", function () {
    runSearch(searchEl ? searchEl.value.trim() : "");
  });
  // "Search" glass button under the bar runs the same search.
  var btnSearch = document.getElementById("dhBtnSearch");
  if (btnSearch) btnSearch.addEventListener("click", function () {
    var q = searchEl ? searchEl.value.trim() : "";
    if (q) { runSearch(q); } else if (searchEl) { searchEl.focus(); }
  });

  // Typing effect: cycle example phrases through the placeholder like a typewriter.
  // Pauses while the shopper is focused or has typed something; resumes when empty.
  if (searchEl) {
    var typeRaw = (searchEl.getAttribute("data-typing") || "").trim();
    var phrases = typeRaw.split(/\r?\n/).map(function (s) { return s.trim(); }).filter(Boolean);
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (phrases.length && !reduce) {
      var restPh = searchEl.getAttribute("placeholder") || "";
      var pi = 0, ci = 0, deleting = false, paused = false, timer = null;
      var tick = function () {
        if (paused) return;
        var word = phrases[pi];
        if (!deleting) {
          ci++;
          searchEl.setAttribute("placeholder", word.slice(0, ci));
          if (ci >= word.length) { deleting = true; timer = setTimeout(tick, 1600); return; }
          timer = setTimeout(tick, 55);
        } else {
          ci--;
          searchEl.setAttribute("placeholder", word.slice(0, ci));
          if (ci <= 0) { deleting = false; pi = (pi + 1) % phrases.length; timer = setTimeout(tick, 350); return; }
          timer = setTimeout(tick, 28);
        }
      };
      var stopType = function () {
        paused = true; if (timer) { clearTimeout(timer); timer = null; }
        searchEl.setAttribute("placeholder", restPh);
      };
      var startType = function () {
        if (!paused || searchEl.value) return;
        paused = false; pi = 0; ci = 0; deleting = false; tick();
      };
      searchEl.addEventListener("focus", stopType);
      searchEl.addEventListener("blur", function () { if (!searchEl.value) startType(); });
      searchEl.addEventListener("input", function () { if (searchEl.value) stopType(); });
      if (document.activeElement !== searchEl) tick();
    }
  }

  // Scroll arrows: appear only when the image-tab row overflows; hide at ends.
  var prev = document.getElementById("dhPrev");
  var next = document.getElementById("dhNext");
  if (tabs && tabs.classList.contains("is-images")) {
    var updateArrows = function () {
      var overflow = tabs.scrollWidth - tabs.clientWidth > 2;
      tabs.classList.toggle("is-centered", !overflow);
      var atStart = tabs.scrollLeft <= 2;
      var atEnd = tabs.scrollLeft >= (tabs.scrollWidth - tabs.clientWidth - 2);
      if (prev) prev.hidden = !overflow || atStart;
      if (next) next.hidden = !overflow || atEnd;
    };
    var step = function () { return Math.max(180, tabs.clientWidth * 0.7); };
    if (prev) prev.addEventListener("click", function () { tabs.scrollBy({ left: -step(), behavior: "smooth" }); });
    if (next) next.addEventListener("click", function () { tabs.scrollBy({ left: step(), behavior: "smooth" }); });
    tabs.addEventListener("scroll", updateArrows, { passive: true });
    window.addEventListener("resize", updateArrows);
    updateArrows();
  }

  // Product shelf arrows: scroll the grid horizontally; hide at ends / when it fits.
  var gPrev = document.getElementById("dhGridPrev");
  var gNext = document.getElementById("dhGridNext");
  function updateGridArrows() {
    if (!grid) return;
    var overflow = grid.scrollWidth - grid.clientWidth > 2;
    var atStart = grid.scrollLeft <= 2;
    var atEnd = grid.scrollLeft >= (grid.scrollWidth - grid.clientWidth - 2);
    if (gPrev) gPrev.hidden = !overflow || atStart;
    if (gNext) gNext.hidden = !overflow || atEnd;
  }
  var gStep = function () { return Math.max(220, grid.clientWidth * 0.8); };
  if (gPrev) gPrev.addEventListener("click", function () { grid.scrollBy({ left: -gStep(), behavior: "smooth" }); });
  if (gNext) gNext.addEventListener("click", function () { grid.scrollBy({ left: gStep(), behavior: "smooth" }); });
  if (grid) {
    grid.addEventListener("scroll", updateGridArrows, { passive: true });
    window.addEventListener("resize", updateGridArrows);
  }

  // If this page was opened with a ?q= query (e.g. from the home search),
  // prefill the box and filter to those results — unless this page itself
  // redirects elsewhere.
  if (!resultsUrl) {
    try {
      var urlQ = new URLSearchParams(window.location.search).get("q");
      if (urlQ) { if (searchEl) searchEl.value = urlQ; query = urlQ.trim().toLowerCase(); }
    } catch (e) {}
  }

  // Initial load: reveal the active tab's products (works whether or not the All tab exists).
  var activeBtn = tabs ? tabs.querySelector(".dh-tab.is-active") : null;
  currentCat = activeBtn ? activeBtn.getAttribute("data-cat") : "__all";
  applyFilters();

  // Colour swatches: paint the dots from a name->colour map; hovering a dot
  // swaps the card image to that colour's variant photo.
  var MAP = {
    black:"#1d1d1f", white:"#f5f5f7", grey:"#8e8e93", gray:"#8e8e93", silver:"#c7c7cc",
    red:"#d0021b", crimson:"#b00020", maroon:"#7b1e1e", orange:"#f5820d", amber:"#ffb300",
    yellow:"#f7c948", gold:"#c9a227", green:"#2b9348", olive:"#7a7a2e", teal:"#008080",
    blue:"#0071e3", navy:"#1b2a4a", "sky blue":"#4aa8e0", "light blue":"#8ec6ef",
    purple:"#7b2ff7", violet:"#8f00ff", pink:"#ff5c8a", "hot pink":"#ff2d78", rose:"#e75480",
    brown:"#7a4b2b", tan:"#d2b48c", beige:"#e8dcc4", cream:"#f4efe1", ivory:"#fffff0",
    khaki:"#c3b091", charcoal:"#36454f", "off white":"#efefe9", natural:"#e8e0d0",
    burgundy:"#800020", mustard:"#d4a017", mint:"#a8e6cf", lavender:"#b57edc", coral:"#ff7f50",
    turquoise:"#40e0d0", indigo:"#4b0082", magenta:"#d0208a"
  };
  function colorFor(name) {
    var n = (name || "").trim().toLowerCase();
    if (MAP[n]) return MAP[n];
    var words = n.split(/[\s/]+/);
    for (var i = words.length - 1; i >= 0; i--) { if (MAP[words[i]]) return MAP[words[i]]; }
    var t = new Option().style; t.color = ""; t.color = n; if (t.color !== "") return n;
    return "#c7c7cc";
  }
  cards.forEach(function (card) {
    var img1 = card.querySelector(".dh-media .dh-img-1");
    var baseSrc = img1 ? img1.getAttribute("src") : "";
    card.querySelectorAll(".dh-swatch").forEach(function (sw) {
      sw.style.background = colorFor(sw.getAttribute("data-color"));
      var vimg = sw.getAttribute("data-img");
      if (vimg && img1) sw.addEventListener("mouseenter", function () { img1.src = vimg; });
    });
    if (img1) card.addEventListener("mouseleave", function () { if (baseSrc) img1.src = baseSrc; });
  });
})();
</script>

<script>
/* Instagram-style save button -> browser wishlist (same "dyn_wishlist" list the
   wishlist page and header drawer use). */
(function () {
  var KEY = "dyn_wishlist";
  var btns = document.querySelectorAll(".dyn-hero .dh-save");
  if (!btns.length) return;
  function read() { try { var a = JSON.parse(localStorage.getItem(KEY) || "[]"); return Array.isArray(a) ? a : []; } catch (e) { return []; } }
  function write(l) { try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (e) {} try { window.dispatchEvent(new CustomEvent("dyn-wishlist-change")); } catch (e) {} }
  function has(id) { return read().some(function (x) { return String(x.id) === String(id); }); }
  function paint() {
    btns.forEach(function (b) {
      var on = has(b.getAttribute("data-wl-id"));
      b.classList.toggle("is-saved", on);
      b.setAttribute("aria-pressed", on ? "true" : "false");
      b.setAttribute("aria-label", on ? "Saved — remove from wishlist" : "Save to wishlist");
    });
  }
  btns.forEach(function (b) {
    b.addEventListener("click", function (e) {
      e.preventDefault(); e.stopPropagation();
      var id = b.getAttribute("data-wl-id"), l = read(), i = -1, k;
      for (k = 0; k < l.length; k++) { if (String(l[k].id) === String(id)) { i = k; break; } }
      if (i >= 0) { l.splice(i, 1); }
      else {
        l.unshift({ id: id, title: b.getAttribute("data-wl-title"), url: b.getAttribute("data-wl-url"), image: b.getAttribute("data-wl-image"), price: b.getAttribute("data-wl-price") });
        b.classList.remove("just-saved"); void b.offsetWidth; b.classList.add("just-saved");
      }
      write(l); paint();
    });
  });
  window.addEventListener("dyn-wishlist-change", paint);
  window.addEventListener("storage", function (e) { if (e.key === KEY) paint(); });
  paint();
})();
</script>

{% schema %}
{
  "name": "Dynamic Hero",
  "tag": "section",
  "class": "dynamic-collection-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty on a Collection template to use the current collection automatically." },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave empty to use the collection title." },
    { "type": "image_picker", "id": "heading_logo", "label": "Logo instead of heading", "info": "Upload your logo to show it in place of the heading text." },
    { "type": "video", "id": "head_video", "label": "Video instead of logo", "info": "Plays muted on loop in place of the logo/heading. Takes priority over the logo when set." },
    { "type": "url", "id": "head_link", "label": "Link for the logo / video", "info": "Optional. Makes the logo/video/heading clickable — e.g. link it to your home page or a featured collection." },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif",
      "options": [ { "value": "serif", "label": "Elegant serif (matches store)" }, { "value": "sans", "label": "Clean sans" } ] },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },

    { "type": "header", "content": "Search box" },
    { "type": "checkbox", "id": "show_search", "label": "Show live search box", "default": true, "info": "Filters the products already on this page as the shopper types — no page reload." },
    { "type": "checkbox", "id": "hide_until_search", "label": "Hide the grid until someone searches", "default": true, "info": "Only matters if 'Show product grid & tabs' is on: the products stay hidden until the shopper types. The hero is always full-screen either way." },
    { "type": "url", "id": "results_page_url", "label": "Show results on another page (URL)", "info": "Optional. Paste your Shop page URL (e.g. /collections/shop). When set, pressing Enter here opens that page with the results instead of filtering in place. Leave empty to filter on this page." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search these products…" },
    { "type": "textarea", "id": "search_examples", "label": "Typing examples", "info": "One phrase per line. They type out in the search box one after another. Clear to turn the effect off.", "default": "I'm shopping for my wife.\nI'm looking for a birthday gift.\nI need a gift for my mom.\nI'm shopping for my dad.\nI want a gift for my best friend.\nI'm buying a gift for my boyfriend.\nI need an anniversary gift.\nI'm shopping for my daughter.\nI want something personalized.\nI'm looking for a unique gift.\nI need a Christmas gift.\nI'm shopping for a coworker.\nI want a custom mug.\nI'm shopping for myself.\nI'm not sure what to buy." },

    { "type": "header", "content": "Buttons under the search (Google-style)" },
    { "type": "checkbox", "id": "show_btn1", "label": "Show the 'Search' button", "default": false },
    { "type": "text", "id": "btn1_label", "label": "Search button text", "default": "Search", "info": "Runs the search with whatever is typed." },
    { "type": "checkbox", "id": "show_btn2", "label": "Show the 'Shop' button", "default": false },
    { "type": "text", "id": "btn2_label", "label": "Shop button text", "default": "Shop all" },
    { "type": "url", "id": "btn2_url", "label": "Shop button link", "info": "Defaults to all products." },

    { "type": "text", "id": "copyright_text", "label": "Bottom copyright text", "default": "© 2026, Dynaeimic", "info": "Small centered text at the very bottom. Clear to hide." },

    { "type": "header", "content": "Floating gift game 🎁" },
    { "type": "checkbox", "id": "show_gift_game", "label": "Turn on the floating-box game", "default": false, "info": "Add up to 5 'Gift box' blocks below (Add block button at the bottom), each with its own PNG image and size. Boxes rest in a row on the bottom-left. On desktop and phone: drag to throw a box, tap to make it hop. No permissions needed." },
    { "type": "range", "id": "game_gravity", "min": 0.2, "max": 1.6, "step": 0.1, "label": "Gravity", "default": 1, "info": "Lower = floaty & slow, higher = they drop fast." },

    { "type": "header", "content": "Home corners (Google-style, landing only)" },
    { "type": "paragraph", "content": "Add 'Corner link' blocks below (button at the bottom of this panel). Up to 4 per corner, laid out in a row like Google's homepage, each with an optional icon." },

    { "type": "header", "content": "Account button (top-right)" },
    { "type": "checkbox", "id": "show_account", "label": "Show account button", "default": true, "info": "Apple-style person icon. Clicking opens a small login menu. When a customer is logged in it shows their initial + account links." },
    { "type": "image_picker", "id": "account_avatar", "label": "Avatar photo (optional)", "info": "Shown instead of the person icon. Per-customer photos need a separate app; this is a single store-wide photo for now." },
    { "type": "url", "id": "login_url", "label": "Log in link", "info": "Where the Log in / Sign up button goes. Leave blank to use your store's secure Shopify login." },
    { "type": "url", "id": "account_page_url", "label": "Account page (custom dashboard)", "info": "The page where you added the Dynamic Account section (Wishlist / Saved Designs / Reviews). Leave blank to use /pages/account." },
    { "type": "url", "id": "register_url", "label": "Create account link", "info": "Optional. Not needed for passwordless accounts (the Log in / Sign up button covers sign-up)." },

    { "type": "header", "content": "Apps grid (top-right, 9 dots)" },
    { "type": "checkbox", "id": "show_apps", "label": "Show 9-dot apps menu", "default": true, "info": "Clicking opens a grid dropdown. Fill it by adding 'App link' blocks at the bottom of this panel." },
    { "type": "text", "id": "apps_title", "label": "Apps menu title" },

    { "type": "header", "content": "Category tabs" },
    { "type": "checkbox", "id": "show_grid", "label": "Show product grid & category tabs", "default": false, "info": "Off = pure search hero (just the logo/video + search bar). Turn on to show the category tabs and product cards under the search." },
    { "type": "checkbox", "id": "show_tabs", "label": "Show category tabs", "default": true, "info": "Only applies when the product grid above is shown." },
    { "type": "select", "id": "category_source", "label": "Build tabs from", "default": "type",
      "options": [ { "value": "type", "label": "Product type" }, { "value": "tag", "label": "Product tag" } ],
      "info": "Used for AUTO text tabs and for matching products to your image tabs. Set each product's Product type (or tag) in its admin page. Add image tabs below for the Apple-style picture tabs." },
    { "type": "checkbox", "id": "show_all_tab", "label": "Show 'All' tab", "default": true, "info": "Turn off to start on the first category instead of an All tab." },
    { "type": "text", "id": "all_label", "label": "'All' tab label", "default": "All" },
    { "type": "image_picker", "id": "all_image", "label": "'All' tab image (optional)", "info": "Shown on the 'All' tab when you add image tabs below. Leave empty for a grid icon." },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Products visible at once (desktop)", "default": 4,
      "info": "The shelf scrolls sideways with arrows to reveal the rest." },
    { "type": "range", "id": "max_products", "min": 8, "max": 50, "step": 2, "label": "Max products shown", "default": 48,
      "info": "Tabs filter this loaded set instantly. Raise it if a category looks short." },
    { "type": "text", "id": "hide_tag", "label": "Hide products with this tag", "default": "hidden", "info": "Products with this tag (e.g. the internal back-print add-on) are hidden from the grid." },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "natural",
      "options": [ { "value": "natural", "label": "Natural (tall)" }, { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape" } ] },

    { "type": "header", "content": "Card" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },

    { "type": "header", "content": "Best seller badge ⭐" },
    { "type": "checkbox", "id": "show_bestseller", "label": "Show “Best seller” badge", "default": true },
    { "type": "text", "id": "bestseller_label", "label": "Badge text", "default": "Best seller" },
    { "type": "text", "id": "bestseller_tag", "label": "Show badge on products tagged", "default": "bestseller", "info": "In Shopify admin, add this tag (e.g. bestseller) to any product you want badged. Not case-sensitive." },
    { "type": "range", "id": "bestseller_top", "min": 0, "max": 12, "step": 1, "label": "Or auto-badge the top N products", "default": 0, "info": "0 = off. If set, the first N products get the badge — use this when the collection is sorted by ‘Best selling’ so it's automatic (no tagging needed)." },

    { "type": "header", "content": "New arrivals badge 🆕" },
    { "type": "checkbox", "id": "show_new", "label": "Show “New” badge", "default": true },
    { "type": "text", "id": "new_label", "label": "Badge text", "default": "New" },
    { "type": "range", "id": "new_days", "min": 1, "max": 90, "step": 1, "label": "Show as new for (days)", "default": 14, "info": "The badge shows automatically for this many days after a product is published, then disappears on its own — no tagging needed." },

    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_text", "label": "Empty message", "default": "Nothing here yet." },
    { "type": "text", "id": "empty_link_label", "label": "Empty button label", "default": "Browse all products" },

    { "type": "header", "content": "No search results" },
    { "type": "text", "id": "noresults_title", "label": "Title", "default": "No matches — yet." },
    { "type": "textarea", "id": "noresults_message", "label": "Message", "default": "Can't find what you're looking for? Tell us what you had in mind — we might still be able to make it." },
    { "type": "text", "id": "noresults_link_label", "label": "Button text", "default": "Contact us" },
    { "type": "url", "id": "noresults_url", "label": "Button link", "info": "Defaults to /pages/contact." }
  ],
  "blocks": [
    { "type": "corner_link", "name": "Corner link", "settings": [
      { "type": "select", "id": "corner", "label": "Which corner", "default": "tl",
        "options": [
          { "value": "tl", "label": "Top-left" },
          { "value": "tr", "label": "Top-right" },
          { "value": "bl", "label": "Bottom-left" },
          { "value": "br", "label": "Bottom-right" }
        ], "info": "Up to 4 links per corner; extras beyond 4 are ignored." },
      { "type": "text", "id": "label", "label": "Text", "default": "Link" },
      { "type": "url", "id": "url", "label": "Link" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "none",
        "options": [
          { "value": "none", "label": "No icon" },
          { "value": "account", "label": "Account (person)" },
          { "value": "cart", "label": "Cart" },
          { "value": "bag", "label": "Shopping bag" },
          { "value": "heart", "label": "Heart / wishlist" },
          { "value": "search", "label": "Search" },
          { "value": "info", "label": "Info" },
          { "value": "help", "label": "Help (question)" },
          { "value": "phone", "label": "Phone" },
          { "value": "mail", "label": "Email" },
          { "value": "home", "label": "Home" },
          { "value": "star", "label": "Star" },
          { "value": "location", "label": "Location pin" }
        ] },
      { "type": "image_picker", "id": "icon_image", "label": "Custom icon (optional)", "info": "Overrides the icon above. A small square image works best." },
      { "type": "checkbox", "id": "icon_only", "label": "Show icon only (hide the text)", "default": false }
    ]},
    { "type": "app_link", "name": "App link", "settings": [
      { "type": "checkbox", "id": "enabled", "label": "Show this link", "default": true, "info": "Uncheck to hide it from the menu without deleting it." },
      { "type": "text", "id": "label", "label": "Name", "default": "App" },
      { "type": "url", "id": "url", "label": "Link", "info": "Leave blank to use the default page for the icon you pick below (Shop→all products, Cart→cart, Account→account, Wishlist→/pages/wishlist, Contact→/pages/contact, About→/pages/about, Blog→/blogs/news, etc.). Type a link here to override it. Tip: use #wishlist to open the pop-out wishlist drawer instead of the page." },
      { "type": "select", "id": "icon", "label": "Icon", "default": "shop",
        "options": [
          { "value": "none", "label": "No icon (show first letter)" },
          { "value": "shop", "label": "Shop / storefront" },
          { "value": "bag", "label": "Shopping bag" },
          { "value": "cart", "label": "Cart" },
          { "value": "search", "label": "Search" },
          { "value": "account", "label": "Account" },
          { "value": "heart", "label": "Wishlist / heart" },
          { "value": "mail", "label": "Contact / email" },
          { "value": "phone", "label": "Phone" },
          { "value": "info", "label": "About / info" },
          { "value": "home", "label": "Home" },
          { "value": "gift", "label": "Gift card" },
          { "value": "blog", "label": "Blog / news" },
          { "value": "tag", "label": "Sale / tag" },
          { "value": "star", "label": "Reviews / star" },
          { "value": "location", "label": "Stores / location" },
          { "value": "help", "label": "Help / FAQ" },
          { "value": "instagram", "label": "Instagram" }
        ] },
      { "type": "image_picker", "id": "image", "label": "Custom icon image (optional)", "info": "Overrides the icon above. A small square icon works best." }
    ]},
    { "type": "tab", "name": "Image category tab", "settings": [
      { "type": "text", "id": "label", "label": "Tab label", "default": "Category" },
      { "type": "text", "id": "category_value", "label": "Filters products where Type =",
        "info": "Type the exact Product type value of the items for this tab, e.g. Drinkware. (If 'Build tabs from' is set to Tag, enter the tag instead.)" },
      { "type": "image_picker", "id": "image", "label": "Tab image" }
    ]},
    { "type": "giftbox", "name": "Gift box 🎁", "settings": [
      { "type": "image_picker", "id": "image", "label": "Box image (PNG)", "info": "Upload a transparent PNG. It is used exactly as provided — no processing. Add up to 5 of these blocks for 5 different images." },
      { "type": "range", "id": "size", "min": 40, "max": 400, "step": 5, "label": "Size (px)", "default": 110, "info": "Resize this image. Bigger number = bigger box." },
      { "type": "range", "id": "count", "min": 1, "max": 6, "step": 1, "label": "How many of this box", "default": 1, "info": "Leave at 1 for a single box, or increase to drop several copies of the same image." }
    ]}
  ],
  "max_blocks": 30,
  "presets": [
    { "name": "Dynamic Hero", "settings": { "hide_until_search": true, "show_search": true, "show_tabs": true },
      "blocks": [
        { "type": "corner_link", "settings": { "corner": "tl", "label": "About" } },
        { "type": "corner_link", "settings": { "corner": "tl", "label": "Store" } },
        { "type": "corner_link", "settings": { "corner": "tr", "label": "Wishlist", "icon": "heart" } },
        { "type": "corner_link", "settings": { "corner": "tr", "label": "Account", "icon": "account" } },
        { "type": "corner_link", "settings": { "corner": "tr", "label": "Cart", "icon": "cart" } },
        { "type": "corner_link", "settings": { "corner": "bl", "label": "Contact" } },
        { "type": "corner_link", "settings": { "corner": "bl", "label": "Help" } },
        { "type": "corner_link", "settings": { "corner": "br", "label": "Privacy" } },
        { "type": "corner_link", "settings": { "corner": "br", "label": "Terms" } },
        { "type": "app_link", "settings": { "label": "Shop", "url": "/collections/all", "icon": "shop" } },
        { "type": "app_link", "settings": { "label": "Search", "url": "/search", "icon": "search" } },
        { "type": "app_link", "settings": { "label": "Contact", "url": "/pages/contact", "icon": "mail" } },
        { "type": "app_link", "settings": { "label": "About", "url": "/pages/about", "icon": "info" } },
        { "type": "app_link", "settings": { "label": "Blog", "url": "/blogs/news", "icon": "blog" } },
        { "type": "app_link", "settings": { "label": "Account", "url": "/account", "icon": "account" } },
        { "type": "app_link", "settings": { "label": "Cart", "url": "/cart", "icon": "cart" } },
        { "type": "app_link", "settings": { "label": "Gift cards", "url": "/pages/gift-card", "icon": "gift" } },
        { "type": "app_link", "settings": { "label": "Home", "url": "/", "icon": "home" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["index"] }
}
