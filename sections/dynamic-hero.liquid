          window.addEventListener("pointermove", function (e) {
            if (!held) return;
            var q = pos(e), nx = q.x + grabOff.x, ny = q.y + grabOff.y;
            var t = e.timeStamp || (lastT + 16), dt = Math.max(0.001, (t - lastT) / 1000);
            // Heavier boxes lag behind the finger (follow a fraction of the way)
            // so they feel weighty to drag; light boxes track almost exactly.
