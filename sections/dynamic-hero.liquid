<script>
(function () {
var hero = document.getElementById("dynHero");
var box = document.getElementById("dhFloats");
if (!hero || !box) return;
var mode = box.getAttribute("data-paint") || "rub";
var dpr = Math.min(window.devicePixelRatio || 1, 2);
var its = [];
[].slice.call(box.querySelectorAll(".dh-float")).forEach(function (el) {
var img = el.querySelector(".dh-float-img");
var cv = el.querySelector(".dh-float-paint");
var aw = parseInt(img.getAttribute("width") || "1", 10);
var ah = parseInt(img.getAttribute("height") || "1", 10);
its.push({ el: el, bob: el.querySelector(".dh-float-bob"), img: img, cv: cv,
ctx: cv.getContext("2d"), baseW: parseInt(el.getAttribute("data-w") || "140", 10),
aspect: aw / Math.max(1, ah), w: 0, h: 0, x: 0, y: 0, vx: 0, vy: 0,
moved: false, popped: false, done: false, last: null });
el.querySelector(".dh-float-bob").style.setProperty("--fd", (5 + Math.random() * 4).toFixed(1) + "s");
el.querySelector(".dh-float-bob").style.setProperty("--fdel", (-Math.random() * 6).toFixed(1) + "s");
});
if (!its.length) return;
var pinEl = document.getElementById("dhFloatPin");
var pin = null;
if (pinEl) {
var pimg = pinEl.querySelector("img");
pin = { el: pinEl, isPin: true, hasImg: !!pimg,
baseW: parseInt(pinEl.getAttribute("data-w") || "60", 10),
aspect: pimg ? parseInt(pimg.getAttribute("width") || "1", 10) / Math.max(1, parseInt(pimg.getAttribute("height") || "1", 10)) : 1,
w: 38, h: 38, x: 16, y: 16, vx: 0, vy: 0, moved: false, popped: false };
if (pin.hasImg) pinEl.classList.add("is-img");
pin.tipFx = pin.hasImg ? 0.5 : 0.875;
pin.tipFy = pin.hasImg ? 0.97 : 0.875;
pin.tipR = 10;
if (pin.hasImg) {
var probe = new Image();
probe.crossOrigin = "anonymous";
probe.onload = function () {
try {
var W = 64, H = Math.max(2, Math.round(W * probe.naturalHeight / probe.naturalWidth));
var c = document.createElement("canvas");
c.width = W; c.height = H;
var cx = c.getContext("2d");
cx.drawImage(probe, 0, 0, W, H);
var d = cx.getImageData(0, 0, W, H).data;
for (var yy = H - 1; yy >= 0; yy--) {
var sum = 0, n = 0;
for (var xx = 0; xx < W; xx++) if (d[(yy * W + xx) * 4 + 3] > 50) { sum += xx; n++; }
if (n && n < W * 0.9) {
pin.tipFy = (yy + 1) / H;
pin.tipFx = (sum / n + 0.5) / W;
break;
}
if (n) break;          }
} catch (err) { }
};
probe.src = pimg.currentSrc || pimg.src;
}
}
var phys = pin ? its.concat([pin]) : its.slice();

function rand(a, b) { return a + Math.random() * (b - a); }
function render(it) { it.el.style.left = it.x + "px"; it.el.style.top = it.y + "px"; }
function place() {
var vw = innerWidth;
var vh = Math.max(480, Math.min(hero.offsetHeight || innerHeight, innerHeight));
var taken = [];
if (pin) {
var pw = pin.hasImg ? Math.round(pin.baseW * (vw < 640 ? 0.7 : 1)) : 38;
pin.w = pw; pin.h = pin.hasImg ? pw / pin.aspect : 38;
pin.x = pin.homeX = 16;
pin.y = pin.homeY = vh - pin.h - 16;
pin.vx = pin.vy = 0; pin.moved = false;
pin.tipR = Math.max(8, pin.w * 0.12);
if (pin.hasImg) pin.el.style.width = pw + "px";
pin.el.style.bottom = "auto";
render(pin);
taken.push({ x: pin.x - 10, y: pin.y - 10, w: pin.w + 20, h: pin.h + 20 });
}
var exW = Math.min(vw * 0.64, 880);
var ex = { x0: (vw - exW) / 2, x1: (vw + exW) / 2, y0: 30, y1: vh * 0.74 };
its.forEach(function (it) {
var w = it.baseW * (vw < 640 ? 0.62 : 1);
var h = w / it.aspect;
var x = 10, y = 10, ok = false;
for (var t = 0; t < 60 && !ok; t++) {
x = rand(8, Math.max(9, vw - w - 8));
y = rand(8, Math.max(9, vh - h - 8));
ok = !(x + w > ex.x0 && x < ex.x1 && y + h > ex.y0 && y < ex.y1);
if (ok) for (var j = 0; j < taken.length; j++) {
var o = taken[j];
if (x < o.x + o.w + 12 && x + w + 12 > o.x && y < o.y + o.h + 12 && y + h + 12 > o.y) { ok = false; break; }
}
}
taken.push({ x: x, y: y, w: w, h: h });
it.w = w; it.h = h;
it.x = it.homeX = x; it.y = it.homeY = y;
it.vx = 0; it.vy = 0; it.moved = false; it.popped = false;
it.el.classList.remove("is-gone", "is-pop");
it.el.style.width = w + "px";
render(it);
it.cv.width = Math.round(w * dpr);
it.cv.height = Math.round(h * dpr);
it.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
it.done = false; it.last = null;
});
placedW = innerWidth; placedH = innerHeight;
}
var placedW = 0, placedH = 0;
place();
box.removeAttribute("hidden");
its.forEach(function (it, i) { setTimeout(function () { it.el.classList.add("is-in"); }, 150 + i * 90); });
var rT;
window.addEventListener("resize", function () {
clearTimeout(rT);
rT = setTimeout(function () {
if (Math.abs(innerWidth - placedW) < 80 && Math.abs(innerHeight - placedH) < 160) {
placedW = innerWidth; placedH = innerHeight;
for (var i = 0; i < phys.length; i++) if (!phys[i].popped) { bounds(phys[i]); render(phys[i]); }
return;
}
place();
announce();
}, 200);
});

var dragPend = null;
function heldIt() { return dragPend && dragPend.moved ? dragPend.it : null; }
function announce() {
var any = false;
phys.forEach(function (it) { if (it.moved || it.popped) any = true; });
try { hero.dispatchEvent(new CustomEvent("dh:ext-moved", { detail: { moved: any } })); } catch (err) {}
}
function popIt(it) {
if (it.popped || it.isPin) return;
if (dragPend && dragPend.it === it) { dragPend = null; window.__dhDrag = false; document.documentElement.classList.remove("dh-fnosel"); }
it.popped = true; it.moved = true; it.vx = 0; it.vy = 0;
it.el.classList.remove("is-held");
it.el.classList.add("is-pop");
if (pin) { pin.el.classList.add("is-jab"); setTimeout(function () { pin.el.classList.remove("is-jab"); }, 320); }
if (navigator.vibrate) { try { navigator.vibrate([12, 40, 12]); } catch (err) {} }
setTimeout(function () { it.el.classList.remove("is-pop"); it.el.classList.add("is-gone"); }, 300);
announce();
}
function bounds(it) {
var mxX = Math.max(4, innerWidth - it.w - 4);
var mxY = Math.max(4, innerHeight - it.h - 4);
if (it.x < 4) { it.x = 4; it.vx = Math.abs(it.vx) * 0.72; }
else if (it.x > mxX) { it.x = mxX; it.vx = -Math.abs(it.vx) * 0.72; }
if (it.y < 4) { it.y = 4; it.vy = Math.abs(it.vy) * 0.72; }
