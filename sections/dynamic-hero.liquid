    var m = sctx.createRadialGradient(r, r, 0, r, r, r);
    m.addColorStop(0, "rgba(0,0,0,1)");
    m.addColorStop(0.6, "rgba(0,0,0,0.9)");
    m.addColorStop(1, "rgba(0,0,0,0)");
    sctx.fillStyle = m;
    sctx.fillRect(0, 0, r * 2, r * 2);
    it.ctx.drawImage(st, lx - r, ly - r, r * 2, r * 2);
  }
  function bloom(it) {
    /* One touch: the color lands all at once, with a happy wiggle. */
    if (it.done || !it.img.complete || !it.img.naturalWidth) return;
    it.done = true;
    it.el.classList.add("is-wig");
    setTimeout(function () { it.el.classList.remove("is-wig"); }, 600);
    if (BOOST) it.ctx.filter = BOOST;
    it.ctx.drawImage(it.img, 0, 0, it.w, it.h);
    if (BOOST) it.ctx.filter = "none";
  }
  function onMove(e) {
    var x = e.clientX, y = e.clientY;
    if (typeof x !== "number") return;
    for (var i = 0; i < its.length; i++) {
      var it = its[i];
      if (it.popped) continue;
      var rc = it.bob.getBoundingClientRect();
      if (x < rc.left - 4 || x > rc.right + 4 || y < rc.top - 4 || y > rc.bottom + 4) { it.last = null; continue; }
      /* Bloom fires even for the photo being carried, so a touch on the
         phone un-fades it the instant it's grabbed. */
      if (mode === "bloom") { bloom(it); continue; }
      if (dragPend && dragPend.moved && dragPend.it === it) { it.last = null; continue; }
      var lx = (x - rc.left) * (it.w / rc.width);
      var ly = (y - rc.top) * (it.h / rc.height);
      var r = Math.max(20, it.w * 0.16);
      if (it.last) {
        var dx = lx - it.last[0], dy = ly - it.last[1], dist = Math.sqrt(dx * dx + dy * dy);
        var step = r * 0.5;
        for (var s = step; s < dist; s += step) stamp(it, it.last[0] + dx * (s / dist), it.last[1] + dy * (s / dist), r);
      }
      stamp(it, lx, ly, r);
      it.last = [lx, ly];
    }
  }
  window.addEventListener("pointermove", onMove, { passive: true });
  window.addEventListener("pointerdown", onMove, { passive: true });
})();
</script>
