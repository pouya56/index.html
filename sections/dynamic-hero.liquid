    { "type": "text", "id": "all_label", "label": "'All' tab label", "default": "All" },
    { "type": "image_picker", "id": "all_image", "label": "'All' tab image (optional)", "info": "Shown on the 'All' tab when you add image tabs below. Leave empty for a grid icon." },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Products visible at once (desktop)", "default": 4,
