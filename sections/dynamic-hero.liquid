{ "type": "image_picker", "id": "popup_bg_image", "label": "Surprise popup background", "info": "Optional artwork behind the surprise-me product window (shown at 50vw\u00d786vh on desktop; use ~1400\u00d71600px, it crops to fit). Empty keeps the drawn crumpled paper." },

{ "type": "header", "content": "Menu window (phone)" },
{ "type": "image_picker", "id": "menu_paper_image", "label": "Menu background image", "info": "Full-page paper behind the open MENU window. Portrait ~1600px tall works best. Empty keeps the built-in crumpled paper." },

{ "type": "header", "content": "Content" },
