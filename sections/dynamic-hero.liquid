          function draw() {
            ctx.clearRect(0, 0, w, h);
            var i, b;
            /* Soft contact shadow on the floor under each box. Built from a
               radial gradient (dark in the middle, fading to fully transparent
               at the edge) and squashed into an ellipse, so it has no hard rim.
               As a box lifts off the floor the shadow spreads wider, softens,
               and fades away — the way a real cast shadow behaves. */
            for (i = 0; i < bodies.length; i++) {
              b = bodies[i]; if (!b.spr) continue;
              var bottom = b.y + b.r;
              var gap = Math.max(0, h - bottom);
              var lift = Math.min(1, gap / (b.r * 5));   // 0 on the floor, 1 high up
              var t = 1 - lift;                          // strength fades with height
              if (t <= 0.03) continue;
              var rx = b.r * (1.05 + lift * 1.5);        // spreads out as it rises
              var ry = rx * 0.3;
