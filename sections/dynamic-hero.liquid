{% # theme-check-disable LiquidComplexity, ExcessiveSettingsCount %}

<style>
.dyn-hero {
--bg: #ffffff; --bg-panel: #f5f5f7;
--ink: #1d1d1f; --ink-soft: #6e6e73; --ink-faint: #66666b;    --line: #d2d2d7; --accent: #0071e3; --danger: #c0392b;
--font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
--font-head: {% if section.settings.heading_font == 'sans' %}var(--font){% else %}"Cormorant Garamond", Georgia, "Times New Roman", Times, serif{% endif %};
--cols: {{ section.settings.columns | default: 4 }};
--ratio: {% case section.settings.image_ratio %}{% when 'square' %}1{% when 'portrait' %}0.8{% when 'landscape' %}1.3{% else %}0.85{% endcase %};
font-family: var(--font); color: var(--ink); -webkit-font-smoothing: antialiased;
--hero-bg: {{ section.settings.bg_color | default: '#f5f5f7' }};
{%- if section.settings.bg_image != blank -%}
{%- assign dhbv = section.settings.bg_veil | default: 30 | divided_by: 100.0 -%}
background: linear-gradient(rgba(255, 255, 255, {{ dhbv }}), rgba(255, 255, 255, {{ dhbv }})),
url('{{ section.settings.bg_image | image_url: width: 2400 }}') center / cover no-repeat var(--hero-bg);
{%- else -%}
background: var(--hero-bg);
{%- endif -%}
}
{%- if section.settings.bg_image != blank -%}
@media (max-width: 900px) {
.dyn-hero { background-image: linear-gradient(rgba(255, 255, 255, {{ dhbv }}), rgba(255, 255, 255, {{ dhbv }})),
url('{{ section.settings.bg_image | image_url: width: 1100 }}'); }
}
{%- endif -%}
.dyn-hero, .dyn-hero *, .dyn-hero *::before, .dyn-hero *::after { box-sizing: border-box; }
.dyn-hero .dh-wrap { max-width: 1280px; margin: 0 auto; padding: 44px 22px 90px; }

.dyn-hero.dh-landing { --media-w: min(86vw, 500px); height: 100svh; min-height: 520px; position: relative; display: flex; flex-direction: column; overflow: hidden; }
/* Phone rubber-band: the bounce used to reveal the browser's light root
   behind the red collage (a white blink on pull-down). Kill the reveal on
   the landing page and tint the root to the hero surface as a fallback. */
html:has(.dyn-hero.dh-landing) { overscroll-behavior-y: none; background-color: {{ section.settings.bg_color | default: '#f5f5f7' }} !important; }
.dyn-hero .dh-game { position: absolute; inset: 0; z-index: 5; pointer-events: none; overflow: hidden; }
.dyn-hero .dh-game canvas { display: block; }
.dyn-hero .dh-motion-btn {
position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%);
z-index: 7; -webkit-appearance: none; appearance: none; cursor: pointer;
padding: 10px 18px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.55);
background: rgba(255,255,255,0.28); -webkit-backdrop-filter: blur(14px) saturate(1.4);
backdrop-filter: blur(14px) saturate(1.4); color: var(--ink, #1d1d1f);
font: 600 14px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
letter-spacing: 0.01em; box-shadow: 0 6px 20px rgba(0,0,0,0.14);
animation: dhMotionPulse 2.4s ease-in-out infinite;
}
@keyframes dhMotionPulse { 0%,100% { transform: translateX(-50%) scale(1); } 50% { transform: translateX(-50%) scale(1.06); } }
.dyn-hero.dh-landing .dh-wrap { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; justify-content: center;
padding-top: 4vh; padding-bottom: calc(18vh + 1in); }
.dyn-hero .dh-words { position: absolute; inset: -25%; z-index: 0; overflow: hidden; pointer-events: none;
display: flex; flex-direction: column; justify-content: center; gap: clamp(2px, 1vh, 14px);
transform: rotate(-12deg); }
/* Rows 9-14 exist for tall phone screens only: 8 rows can't fill the
   rotated plane there, which bared the top-left / bottom-right corners.
   Desktop keeps its original 8. */
.dyn-hero .dh-wrow:nth-child(n+9) { display: none; }
@media (max-width: 700px) {
  .dyn-hero .dh-words { inset: -8% -28%; }
  .dyn-hero .dh-wrow:nth-child(n+9) { display: block; }
}
.dyn-hero .dh-wrow { flex: none; white-space: nowrap; }
.dyn-hero .dh-wtrack { display: inline-flex; will-change: transform;
animation: dhWordsL var(--wdur, 50s) linear infinite; animation-delay: var(--wdel, 0s); }
.dyn-hero .dh-wrow--rev .dh-wtrack { animation-name: dhWordsR; }
@keyframes dhWordsL { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes dhWordsR { from { transform: translateX(-50%); } to { transform: translateX(0); } }
.dyn-hero .dh-wset { display: inline-flex; align-items: baseline; }
.dyn-hero .dh-word { display: inline-block; pointer-events: auto; cursor: pointer; text-decoration: none;
font-weight: 900; line-height: 1; letter-spacing: -0.02em; color: #0a0a0a;
opacity: var(--wbase, 0.05); margin-right: clamp(44px, 6vw, 130px);
transform: translate(var(--wx, 0px), var(--wy, 0px)) scale(var(--ws, 1));
transition: opacity 0.3s ease; }
.dyn-hero .dh-word:nth-child(3n) { transform: translate(var(--wx, 0px), calc(var(--wy, 0px) + 0.07em)) scale(var(--ws, 1)); }
.dyn-hero .dh-word:nth-child(4n) { letter-spacing: 0.01em; }
.dyn-hero .dh-word:nth-child(5n) { transform: translate(var(--wx, 0px), calc(var(--wy, 0px) - 0.05em)) scale(var(--ws, 1)); }
.dyn-hero .dh-wrow--xl .dh-word { font-size: clamp(96px, 11.5vw, 220px); }
.dyn-hero .dh-wrow--lg .dh-word { font-size: clamp(84px, 9.5vw, 180px); }
.dyn-hero .dh-wrow--md .dh-word { font-size: clamp(72px, 8vw, 150px); }
.dyn-hero .dh-wrow--sm .dh-word { font-size: clamp(64px, 6.8vw, 120px); }
.dyn-hero .dh-wrow--xs .dh-word { font-size: clamp(44px, 4.6vw, 84px); }
.dyn-hero .dh-word.is-hot { opacity: 1; position: relative; z-index: 2; }
.dyn-hero .dh-word.is-dim { opacity: calc(var(--wbase, 0.05) * 0.45); }
@media (prefers-reduced-motion: reduce) {
.dyn-hero .dh-wtrack { animation: none; transform: translateX(-25%); }
}

.dyn-hero .dh-labcv { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; }
.dyn-hero .dh-labglass { position: absolute; inset: 0; z-index: 0; pointer-events: none;
background: rgba(255, 255, 255, 0.07);
-webkit-backdrop-filter: blur(6px) saturate(1.15); backdrop-filter: blur(6px) saturate(1.15); }
.dyn-hero .dh-labcv--top { pointer-events: none; z-index: 1; }

.dyn-hero .dh-ascii { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%;
pointer-events: none; opacity: {{ section.settings.ascii_opacity | default: 14 | divided_by: 100.0 }}; }

.dyn-hero .dh-prop { position: absolute; z-index: 1; height: auto; will-change: transform;
transform: translate(-50%, -50%) translate(var(--px, 0px), var(--py, 0px)) rotate(calc(var(--pr, 0deg) + var(--pw, 0deg)));
filter: drop-shadow(0 16px 26px rgba(0, 0, 0, 0.25)); touch-action: none; }
.dyn-hero .dh-prop.is-front { z-index: 9; }
@media (max-width: 700px) { .dyn-hero .dh-prop { max-width: 34vw; } }

.dyn-hero.dh-landing .dh-corner-group { position: absolute; z-index: 4; display: flex; flex-direction: row; align-items: center; gap: 4px; min-height: 42px; }
.dyn-hero.dh-landing .dh-corner-tl { top: 16px; left: 16px; justify-content: flex-start; }
.dyn-hero.dh-landing .dh-corner-tr { top: 16px; right: 16px; justify-content: flex-end; }
.dyn-hero.dh-landing .dh-corner-bl { bottom: 16px; left: 16px; justify-content: flex-start; }
.dyn-hero.dh-landing .dh-corner-br { bottom: 16px; right: 16px; justify-content: flex-end; }
.dyn-hero.dh-landing .dh-copyright { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 4;
font-size: 12px; color: var(--ink-faint); letter-spacing: 0.01em; white-space: nowrap; pointer-events: none; }
.dyn-hero.dh-landing .dh-corner-link { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; line-height: 1;
font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; background: #fff; color: #0a0a0a;
text-decoration: none; padding: 9px 11px; box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05);
transition: background 0.16s, color 0.16s; white-space: nowrap; }
.dyn-hero.dh-landing .dh-corner-link:hover { background: #0a0a0a; color: #fff; }
.dyn-hero.dh-landing .dh-corner-link.is-icononly { padding: 8px; }
.dyn-hero.dh-landing .dh-corner-ic { display: inline-flex; }
.dyn-hero.dh-landing .dh-corner-link svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; display: block; }
.dyn-hero.dh-landing img.dh-corner-ic { width: 14px; height: 14px; object-fit: contain; }
.dh-menu-btn { display: none; position: fixed; top: 22px; left: 20px; z-index: 70; appearance: none;
/* a small torn-paper tab, cut and pasted on: cream stock, hand-drawn ink
   outline, halftone-dot drop shadow - same recipe as the hero buttons */
width: auto; height: 52px; padding: 2px 20px 8px 16px; border: none; border-radius: 0;
background: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20210%2066'%20preserveAspectRatio='none'%3E%3Cdefs%3E%3Cpattern%20id='d'%20width='7'%20height='7'%20patternUnits='userSpaceOnUse'%3E%3Ccircle%20cx='3'%20cy='3'%20r='1.6'%20fill='%23141110'/%3E%3C/pattern%3E%3C/defs%3E%3Crect%20x='22'%20y='56'%20width='180'%20height='10'%20fill='url(%23d)'/%3E%3Crect%20x='200'%20y='16'%20width='10'%20height='44'%20fill='url(%23d)'/%3E%3Cpath%20d='M6.0%204.0%20L19.2%203.3%20L33.4%203.0%20L46.8%203.5%20L59.4%203.7%20L73.0%203.5%20L86.6%202.8%20L100.9%204.1%20L113.8%202.9%20L128.4%204.2%20L141.9%203.1%20L156.2%202.3%20L169.5%202.7%20L181.7%202.3%20L196.0%203.0%20L196.1%2013.4%20L196.2%2022.7%20L197.4%2032.2%20L197.7%2041.4%20L198.0%2052.0%20L183.5%2051.6%20L171.2%2052.3%20L156.9%2052.8%20L143.6%2052.4%20L130.8%2053.5%20L116.0%2053.4%20L103.1%2054.3%20L89.9%2053.3%20L76.9%2053.1%20L62.1%2054.7%20L48.0%2054.3%20L34.2%2054.9%20L22.1%2054.9%20L8.0%2055.0%20L8.3%2044.5%20L7.5%2034.8%20L6.9%2024.3%20L7.0%2015.0%20Z'%20fill='%23efe9da'%20stroke='%23141110'%20stroke-width='2'/%3E%3C/svg%3E") center / 100% 100% no-repeat;
-webkit-backdrop-filter: none; backdrop-filter: none;
color: #141110; cursor: pointer; align-items: center; gap: 9px;
box-shadow: none; transform: rotate(-1.6deg);
transition: transform 0.12s; }
.dh-menu-btn:hover { transform: rotate(-1.6deg) scale(1.05); }
.dh-menu-btn:active { transform: rotate(-1.6deg) scale(0.95); }
.dh-menu-btn svg { width: 21px; height: 21px; display: block; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; }
.dh-menu-btn .dh-menu-txt { font: 900 15px/1 "Archivo Narrow", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
letter-spacing: 0.1em; padding-top: 1px; }
.dh-mmenu { position: fixed; inset: 0; z-index: 140; color: #0a0a0a;
background: rgba(255, 255, 255, 0.35);
-webkit-backdrop-filter: blur(22px) saturate(1.6) brightness(1.05);
backdrop-filter: blur(22px) saturate(1.6) brightness(1.05);
transform: translateY(-102%); transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
padding: 76px 22px 30px; box-sizing: border-box; overflow-y: auto;
font-family: "Archivo", "Inter", "Helvetica Neue", Arial, sans-serif; }
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
.dh-mmenu { background: #f5f5f5; }
}
.dh-mmenu.is-open { transform: translateY(0); }
.dh-mmenu-close { position: absolute; top: 16px; left: 16px; appearance: none; border: 0; background: #fff;
color: #0a0a0a; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
line-height: 1; padding: 9px 11px; cursor: pointer; box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05); }
.dh-mmenu-nav { min-height: 100%; display: flex; flex-direction: column; gap: 6px;
align-items: center; justify-content: center; text-align: center; }
.dh-mmenu-link { color: inherit; text-decoration: none; font-size: 27px; font-weight: 800;
text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.25; }
@media (max-width: 700px) {
.dyn-hero.dh-landing .dh-corner-group { display: none; }
.dyn-hero.dh-landing:not(.dh-searching) .dh-menu-btn { display: flex; }
}
@media (prefers-reduced-motion: reduce) { .dh-mmenu { transition: none; } }
.dyn-hero.dh-landing:not(.dh-searching) .dh-corner-group { position: fixed; z-index: 60; }

.dyn-hero .dh-menu { position: relative; display: inline-flex; }
.dyn-hero .dh-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
border-radius: 50%; border: none; background: transparent; color: var(--ink-soft); cursor: pointer; padding: 0;
transition: background .16s, color .16s; }
.dyn-hero .dh-icon-btn:hover { background: rgba(0,0,0,0.06); color: var(--ink); }
.dyn-hero .dh-apps-btn svg { width: 22px; height: 22px; fill: currentColor; }
.dyn-hero .dh-acct-ic { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 1.5; }
.dyn-hero .dh-avatar { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; display: block; }
.dyn-hero .dh-avatar-initial { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px;
border-radius: 50%; background: var(--accent); color: #fff; font: 600 14px/1 var(--font); }
.dyn-hero .dh-acct-menu .dh-icon-btn { width: 42px; height: 42px; }

.dyn-hero .dh-pop { position: absolute; top: calc(100% + 10px); right: 0; z-index: 30; min-width: 220px;
background: rgba(255,255,255,0.6); -webkit-backdrop-filter: blur(22px) saturate(180%); backdrop-filter: blur(22px) saturate(180%);
border: 1px solid rgba(255,255,255,0.55); border-radius: 20px; padding: 10px;
box-shadow: 0 10px 40px rgba(0,0,0,0.16), inset 0 1px 0 rgba(255,255,255,0.7); animation: dhPop .14s ease; }
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
.dyn-hero .dh-pop { background: #fff; border-color: var(--line); }
}
.dyn-hero .dh-pop::before, .dyn-hero .dh-pop::after { display: none; }
@keyframes dhPop { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
.dyn-hero .dh-pop[hidden] { display: none; }
.dyn-hero .dh-pop-title { font-size: 13px; color: var(--ink-faint); padding: 6px 10px 8px; }
.dyn-hero .dh-pop-link { display: block; padding: 9px 10px; border-radius: 10px; font-size: 14px; color: var(--ink);
text-decoration: none; transition: background .14s; }
.dyn-hero .dh-pop-link:hover { background: var(--bg-panel); }
.dyn-hero .dh-pop-ext { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; vertical-align: -1px; margin-left: 4px; opacity: .55; }
.dyn-hero .dh-pop-btn { display: block; text-align: center; margin: 2px 4px 6px; padding: 10px 14px; border-radius: 999px;
background: var(--ink); color: #fff; font-size: 14px; font-weight: 500; text-decoration: none; transition: opacity .14s; }
.dyn-hero .dh-pop-btn:hover { opacity: .9; }
.dyn-hero a.dh-pop-cta { text-decoration: none; }
.dyn-hero .dh-pop-note { font-size: 12px; color: var(--ink-soft); line-height: 1.5; padding: 0 10px 10px; }
.dyn-hero .dh-pop-empty { font-size: 13px; color: var(--ink-faint); padding: 10px; max-width: 240px; }
.dyn-hero .dh-apps-pop { min-width: 280px; }
.dyn-hero .dh-apps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
.dyn-hero .dh-app { display: flex; flex-direction: column; align-items: center; gap: 7px; padding: 12px 6px; border-radius: 12px;
text-decoration: none; color: var(--ink); transition: background .14s; }
.dyn-hero .dh-app:hover { background: var(--bg-panel); }
.dyn-hero .dh-app-ic { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; }
.dyn-hero .dh-app-ic img { width: 34px; height: 34px; object-fit: contain; }
.dyn-hero .dh-app-init { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px;
border-radius: 10px; background: var(--bg-panel); color: var(--ink-soft); font: 600 15px/1 var(--font); }
.dyn-hero .dh-app-svg { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
border-radius: 12px; background: var(--bg-panel); color: var(--ink); }
.dyn-hero .dh-app-svg svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.dyn-hero .dh-app-label { font-size: 12px; color: var(--ink-soft); text-align: center; line-height: 1.2; }

.dyn-hero .dh-acct-pop { min-width: 300px; }
.dyn-hero .dh-login-form { display: block; }
.dyn-hero .dh-field { display: block; padding: 4px 6px 8px; }
.dyn-hero .dh-field span { display: block; font-size: 12px; color: var(--ink-faint); margin-bottom: 5px; }
.dyn-hero .dh-field input { width: 100%; height: 42px; padding: 0 12px; border-radius: 10px;
border: 1px solid rgba(0,0,0,0.18); background: rgba(255,255,255,0.55);
box-shadow: inset 0 1px 2px rgba(0,0,0,0.08), inset 0 1px 0 rgba(255,255,255,0.7); color: var(--ink); font: 15px/1 var(--font);
outline: none; transition: border-color .14s, box-shadow .14s; }
.dyn-hero .dh-field input::placeholder { color: var(--ink-soft); }
.dyn-hero .dh-field input:focus { border-color: var(--accent); box-shadow: inset 0 1px 2px rgba(0,0,0,0.06), 0 0 0 3px rgba(0,113,227,0.2); }
.dyn-hero .dh-login-form .dh-pop-btn { width: calc(100% - 8px); margin: 6px 4px 8px; cursor: pointer; border: none; font: 500 15px/1 var(--font);
min-height: 42px; transition: background .2s, opacity .2s; }
.dyn-hero .dh-pop-btn.is-loading { opacity: 0.65; cursor: default; }
.dyn-hero .dh-pop-btn.is-ok { background: #1a7f37; }
.dyn-hero .dh-pop-btn.is-err { background: var(--danger); }
.dyn-hero .dh-pop-btn svg { width: 20px; height: 20px; fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; vertical-align: middle; }
.dyn-hero .dh-form-err { margin: 2px 6px 8px; padding: 8px 10px; border-radius: 10px; background: rgba(192,57,43,0.08);
color: var(--danger); font-size: 12.5px; line-height: 1.35; }
.dyn-hero .dh-form-err ul { margin: 0; padding-left: 16px; }
.dyn-hero .dh-form-links { display: flex; flex-wrap: nowrap; justify-content: space-between; gap: 10px; padding: 2px 8px 4px; }
.dyn-hero .dh-form-links a { font-size: 11px; white-space: nowrap; color: var(--ink-soft); text-decoration: none; }
.dyn-hero .dh-form-links a:hover { color: var(--ink); text-decoration: underline; }
.dyn-hero.dh-landing .dh-head .dh-head-video { max-height: clamp(120px, 30vh, 280px); max-width: var(--media-w); }
.dyn-hero.dh-landing .dh-head h1 { font-size: clamp(30px, 5vw, 46px); }
.dyn-hero.dh-landing .dh-search { --sbw: 100%; width: var(--sbw); max-width: none;
margin-top: 30px; margin-bottom: 30px;
margin-left: calc(50% - var(--sbw) / 2); margin-right: 0; }
@media (min-width: 900px) { .dyn-hero.dh-landing .dh-search { --sbw: min(48vw, 1200px); } }

.dh-introrun { height: calc(100svh + 80vh); }
.dh-introrun .dyn-hero.dh-landing { position: sticky; top: 0; }
.dyn-hero.dh-intro .dh-head, .dyn-hero.dh-intro .dh-search, .dyn-hero.dh-intro .dh-hero-btns {
opacity: 0; will-change: opacity, transform; }

.dyn-hero .dh-head { text-align: center; max-width: 720px; margin: 0 auto; position: relative; z-index: 10; }
.dyn-hero .dh-head h1 { font-family: var(--font-head); font-weight: 500; font-size: clamp(36px, 6vw, 60px);
line-height: 1.02; margin: 0; letter-spacing: -0.01em; }
.dyn-hero .dh-head .dh-desc { font-size: 16px; color: var(--ink-soft); line-height: 1.55; margin: 16px auto 0; max-width: 620px; }
.dyn-hero .dh-head-link { display: inline-block; text-decoration: none; color: inherit; cursor: pointer; }
.dyn-hero .dh-head .dh-head-logo-link { display: inline-block; line-height: 0; }
.dyn-hero .dh-head .dh-head-logo { width: min(var(--dyn-lw, 140px), 64vw); height: auto; object-fit: contain; margin: 0 auto; display: block; }
.dyn-hero .dh-head .dh-head-video { display: block; margin: 0 auto; width: auto; max-width: min(82vw, 360px);
max-height: clamp(90px, 22vh, 220px); border-radius: 18px; object-fit: cover; background: transparent; }

.dyn-hero .dh-search { position: relative; z-index: 12; display: flex; align-items: center; gap: 10px; max-width: 784px; margin: 26px auto 0; padding: 9px;
border-radius: 26px;
background: rgba(255,255,255,0.16);
-webkit-backdrop-filter: blur(20px) saturate(1.6); backdrop-filter: blur(20px) saturate(1.6);
border: 1px solid rgba(255,255,255,0.35);
box-shadow: 0 14px 44px rgba(0,0,0,0.12);
transition: box-shadow .18s; }
