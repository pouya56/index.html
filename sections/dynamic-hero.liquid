            throwVX = (px - held.x) / dt; throwVY = (py - held.y) / dt;
            held.x = px; held.y = py; lastP = q; lastT = t;
            if (downQ) { var mx = q.x - downQ.x, my = q.y - downQ.y; moved = Math.max(moved, Math.sqrt(mx * mx + my * my)); }
          }, { passive: true });
