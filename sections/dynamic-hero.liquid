      { "type": "text", "id": "label", "label": "Text", "default": "Link" },
      { "type": "url", "id": "url", "label": "Link" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "none",
        "options": [
          { "value": "none", "label": "No icon" },
          { "value": "account", "label": "Account (person)" },
          { "value": "cart", "label": "Cart" },
          { "value": "bag", "label": "Shopping bag" },
          { "value": "heart", "label": "Heart / wishlist" },
          { "value": "search", "label": "Search" },
          { "value": "info", "label": "Info" },
          { "value": "help", "label": "Help (question)" },
          { "value": "phone", "label": "Phone" },
          { "value": "mail", "label": "Email" },
          { "value": "home", "label": "Home" },
          { "value": "star", "label": "Star" },
          { "value": "location", "label": "Location pin" }
