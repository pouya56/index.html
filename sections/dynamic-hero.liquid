{%- if section.settings.copyright_text != blank -%}
<div class="dh-copyright">{{ section.settings.copyright_text }}</div>
{%- endif -%}
{%- assign has_float = false -%}
{%- for b in section.blocks -%}{%- if b.type == 'float' and b.settings.image != blank -%}{%- assign has_float = true -%}{%- endif -%}{%- endfor -%}
{%- if has_float -%}
<div class="dh-floats" id="dhFloats" data-paint="{{ section.settings.float_paint | default: 'rub' }}" aria-hidden="true" hidden
style="position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden">
{%- for b in section.blocks -%}
{%- if b.type == 'float' and b.settings.image != blank -%}
<span class="dh-float" data-w="{{ b.settings.size | default: 140 }}" style="position:absolute;left:-9999px;top:0;width:{{ b.settings.size | default: 140 }}px" {{ b.shopify_attributes }}>
<span class="dh-float-bob">
{%- assign fsz = b.settings.size | default: 140 | times: 2 | at_least: 200 | at_most: 640 -%}
<img class="dh-float-img" src="{{ b.settings.image | image_url: width: fsz }}" alt="" draggable="false"
width="{{ b.settings.image.width }}" height="{{ b.settings.image.height }}">
<canvas class="dh-float-paint"></canvas>
</span>
</span>
{%- endif -%}
{%- endfor -%}
{%- if section.settings.float_pin -%}
<span class="dh-float-pin" id="dhFloatPin" aria-hidden="true" data-w="{{ section.settings.pin_size | default: 60 }}"
style="position:absolute;left:16px;bottom:16px;width:38px">
{%- if section.settings.pin_image != blank -%}
{%- assign psz = section.settings.pin_size | default: 60 | times: 2 | at_least: 120 | at_most: 400 -%}
<img src="{{ section.settings.pin_image | image_url: width: psz }}" alt="" draggable="false" loading="lazy"
width="{{ section.settings.pin_image.width }}" height="{{ section.settings.pin_image.height }}">
{%- else -%}
<svg viewBox="0 0 40 40">
<line x1="23" y1="23" x2="35" y2="35" stroke="#9aa0a8" stroke-width="2.6" stroke-linecap="round"/>
<circle cx="16" cy="16" r="10.5" fill="#e0403f"/>
<circle cx="12.5" cy="12.5" r="3.2" fill="#ff8a80"/>
</svg>
{%- endif -%}
</span>
{%- endif -%}
</div>
{%- endif -%}
<div class="dh-wrap">
<div class="dh-head">
{%- if section.settings.head_link != blank -%}<a class="dh-head-link" href="{{ section.settings.head_link }}" aria-label="{{ shop.name | escape }}">{%- endif -%}
{%- assign hero_logo = section.settings.heading_logo | default: settings.logo -%}
{%- if section.settings.head_video != blank -%}
<video class="dh-head-video" autoplay muted playsinline preload="metadata"
{% if section.settings.head_video.preview_image %}poster="{{ section.settings.head_video.preview_image | image_url: width: 800 }}"{% endif %}>
{%- for source in section.settings.head_video.sources -%}
{%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}
{%- endfor -%}
</video>
{%- elsif hero_logo != blank -%}
{%- assign hlw = hero_logo.width | times: 56 | divided_by: hero_logo.height -%}
<a href="{{ routes.root_url }}" class="dh-head-logo-link" aria-label="{{ shop.name | escape }} — home"><img class="dh-head-logo" style="--dyn-lw: {{ section.settings.logo_width | default: 200 }}px" src="{{ hero_logo | image_url: width: 700 }}" srcset="{{ hero_logo | image_url: width: 400 }} 400w, {{ hero_logo | image_url: width: 700 }} 700w, {{ hero_logo | image_url: width: 1000 }} 1000w" sizes="(max-width: 640px) 90vw, 700px" alt="{{ shop.name | escape }}" width="{{ hlw }}" height="56" fetchpriority="high"></a>
{%- else -%}
<h1>{{ section.settings.heading | default: coll.title | default: 'Store' }}</h1>
{%- endif -%}
{%- if section.settings.head_link != blank -%}</a>{%- endif -%}
{%- if section.settings.show_description and coll.description != blank -%}
<div class="dh-desc">{{ coll.description | strip_html | truncatewords: 40 }}</div>
{%- endif -%}
</div>

{%- assign prods = coll.products -%}
{%- assign hide_kws = section.settings.exclude_keywords | default: '' | downcase | split: ',' -%}
{%- if prods.size == 0 -%}
<div class="dh-empty">
<p>{{ section.settings.empty_text | default: 'Nothing here yet.' }}</p>
<a href="{{ routes.all_products_collection_url }}">{{ section.settings.empty_link_label | default: 'Browse all products' }}</a>
</div>
{%- else -%}
{%- if section.settings.show_search -%}
<div class="dh-search">
<button type="button" class="dh-search-plus" id="dhSearchPlus" aria-label="Search" tabindex="-1">
<svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
</button>
<input type="search" id="dhSearch" class="dh-search-input" autocomplete="off" aria-label="Search products"
data-typing="{{ section.settings.search_examples | escape }}"
placeholder="{{ section.settings.search_placeholder | default: 'Search these products…' }}">
<button type="button" class="dh-search-go" id="dhSearchGo" aria-label="Search">
<span class="dh-go-ic dh-go-back"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
<span class="dh-go-ic dh-go-up"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg></span>
<span class="dh-go-ic dh-go-check"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
</button>
</div>
{%- if section.settings.show_finding -%}
<div class="dh-finding" aria-hidden="true"><span class="dh-finding-txt"></span></div>
{%- endif -%}
{%- if section.settings.show_btn1 or section.settings.show_btn2 or section.settings.show_btn3 -%}
<div class="dh-hero-btns">
{%- if section.settings.show_btn1 -%}<button type="button" class="dh-gbtn" id="dhBtnSearch">{{ section.settings.btn1_label | default: 'Search' }}</button>{%- endif -%}
{%- if section.settings.show_btn2 -%}<a class="dh-gbtn" href="{{ section.settings.btn2_url | default: routes.all_products_collection_url }}">{{ section.settings.btn2_label | default: 'Shop all' }}</a>{%- endif -%}
{%- if section.settings.show_btn3 -%}
<span class="dh-goo-wrap">
<span class="dh-goo" aria-hidden="true"><span class="dh-goo-core"></span><span class="dh-goo-blob dh-goo-follow"></span></span>
<button type="button" class="dh-gbtn" id="dhBtnRandom">{{ section.settings.btn3_label | default: 'Surprise me' }}</button>
</span>
{%- endif -%}
</div>
{%- if section.settings.show_btn3 -%}
<script type="application/json" data-dh-random>[{%- assign rfirst = true -%}{%- for product in prods limit: 50 -%}{%- assign rt = product.title | downcase -%}{%- assign rhide = false -%}{%- for kw in hide_kws -%}{%- assign kwt = kw | strip -%}{%- if kwt != blank and rt contains kwt -%}{%- assign rhide = true -%}{%- endif -%}{%- endfor -%}{%- unless rhide -%}{%- unless rfirst %},{% endunless %}{%- assign rfirst = false -%}{{ product.url | json }}{%- endunless -%}{%- endfor -%}]</script>
<script type="application/json" data-dh-hidekw>{{ section.settings.exclude_keywords | default: '' | downcase | json }}</script>
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- if section.settings.show_grid -%}
{%- if cat_source == 'tag' -%}
{%- assign cats = coll.all_tags -%}
{%- else -%}
{%- assign cats = coll.all_types -%}
{%- endif -%}

{%- assign real_cats = '' -%}
{%- for c in cats -%}{%- if c != blank -%}{%- assign real_cats = real_cats | append: '1' -%}{%- endif -%}{%- endfor -%}

{%- assign tab_count = 0 -%}
{%- for b in section.blocks -%}{%- if b.type == 'tab' -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}{%- endfor -%}

{%- if section.settings.show_tabs and tab_count > 0 -%}
<div class="dh-tabs-wrap" id="dhTabsWrap">
<button type="button" class="dh-tabs-arrow dh-prev" id="dhPrev" aria-label="Scroll categories left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
<div class="dh-tabs is-images" id="dhTabs" role="tablist">
{%- if section.settings.show_all_tab -%}
<button type="button" class="dh-tab is-active" data-cat="__all" role="tab" aria-selected="true">
<span class="dh-tab-img dh-tab-all">
{%- if section.settings.all_image != blank -%}
<img src="{{ section.settings.all_image | image_url: width: 200 }}" alt="{{ section.settings.all_label | default: 'All' | escape }}" width="68" height="68" loading="lazy">
{%- else -%}
<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
{%- endif -%}
</span>
<span class="dh-tab-label">{{ section.settings.all_label | default: 'All' }}</span>
</button>
{%- endif -%}
{%- assign tab_i = 0 -%}
{%- for block in section.blocks -%}
{%- unless block.type == 'tab' -%}{%- continue -%}{%- endunless -%}
{%- assign tab_i = tab_i | plus: 1 -%}
{%- assign cv = block.settings.category_value -%}
{%- assign first_active = false -%}
{%- if section.settings.show_all_tab == false and tab_i == 1 -%}{%- assign first_active = true -%}{%- endif -%}
<button type="button" class="dh-tab{% if first_active %} is-active{% endif %}" data-cat="{{ cv | handle }}" role="tab" aria-selected="{% if first_active %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
<span class="dh-tab-img">
{%- if block.settings.image != blank -%}
<img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.label | escape }}" width="68" height="68" loading="lazy">
{%- else -%}
<span class="dh-tab-init">{{ block.settings.label | default: cv | slice: 0 | upcase }}</span>
{%- endif -%}
</span>
<span class="dh-tab-label">{{ block.settings.label | default: cv }}</span>
</button>
{%- endfor -%}
</div>
<button type="button" class="dh-tabs-arrow dh-next" id="dhNext" aria-label="Scroll categories right" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
</div>
{%- elsif section.settings.show_tabs and real_cats != blank -%}
<div class="dh-tabs is-pills" id="dhTabs" role="tablist">
{%- if section.settings.show_all_tab -%}
<button type="button" class="dh-tab is-active" data-cat="__all" role="tab" aria-selected="true">{{ section.settings.all_label | default: 'All' }}</button>
{%- endif -%}
{%- assign shown_i = 0 -%}
{%- for c in cats -%}
{%- unless c == blank -%}
{%- assign shown_i = shown_i | plus: 1 -%}
{%- assign first_active = false -%}
{%- if section.settings.show_all_tab == false and shown_i == 1 -%}{%- assign first_active = true -%}{%- endif -%}
<button type="button" class="dh-tab{% if first_active %} is-active{% endif %}" data-cat="{{ c | handle }}" role="tab" aria-selected="{% if first_active %}true{% else %}false{% endif %}">{{ c }}</button>
{%- endunless -%}
{%- endfor -%}
</div>
{%- endif -%}

<div class="dh-shelf-wrap" id="dhShelfWrap">
<button type="button" class="dh-shelf-arrow dh-prev" id="dhGridPrev" aria-label="Scroll products left" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
<div class="dh-grid" id="dhGrid">
{%- assign hide_tag = section.settings.hide_tag | default: 'hidden' -%}
{%- for product in prods limit: section.settings.max_products -%}
{%- if product.tags contains hide_tag -%}{%- continue -%}{%- endif -%}
{%- assign p_title_dc = product.title | downcase -%}{%- assign p_hidden = false -%}
{%- for kw in hide_kws -%}{%- assign kwt = kw | strip -%}{%- if kwt != blank and p_title_dc contains kwt -%}{%- assign p_hidden = true -%}{%- endif -%}{%- endfor -%}
{%- if p_hidden -%}{%- continue -%}{%- endif -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}

{%- assign is_best = false -%}
{%- if section.settings.show_bestseller -%}
{%- assign bs_tag = section.settings.bestseller_tag | default: 'bestseller' | downcase | strip -%}
{%- for t in product.tags -%}
{%- assign tl = t | downcase | strip -%}
{%- if tl == bs_tag -%}{%- assign is_best = true -%}{%- break -%}{%- endif -%}
{%- endfor -%}
{%- assign bs_top = section.settings.bestseller_top | default: 0 -%}
{%- if bs_top > 0 and forloop.index <= bs_top -%}{%- assign is_best = true -%}{%- endif -%}
{%- endif -%}

{%- assign is_new = false -%}
{%- if section.settings.show_new -%}
{%- assign new_days = section.settings.new_days | default: 14 -%}
{%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
{%- assign pub_s = product.published_at | date: '%s' | plus: 0 -%}
{%- if pub_s > 0 -%}
{%- assign age_days = now_s | minus: pub_s | divided_by: 86400 -%}
{%- if age_days <= new_days -%}{%- assign is_new = true -%}{%- endif -%}
{%- endif -%}
{%- endif -%}

{%- if cat_source == 'tag' -%}
{%- capture card_cat -%}{% for tag in product.tags %}{{ tag | handle }} {% endfor %}{%- endcapture -%}
{%- else -%}
{%- assign card_cat = product.type | handle -%}
{%- endif -%}

{%- assign img2 = blank -%}
{%- if product.images.size > 1 -%}{%- assign img2 = product.images[1] -%}{%- endif -%}

{%- capture card_search -%}{{ product.title }} {{ product.type }} {{ product.vendor }} {% for t in product.tags %}{{ t }} {% endfor %}{% for opt in product.options_with_values %}{{ opt.name }} {% for v in opt.values %}{{ v }} {% endfor %}{% endfor %}{%- endcapture -%}
