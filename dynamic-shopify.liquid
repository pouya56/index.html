  const wrap = (inner) =>
    `<svg viewBox="0 0 ${S} ${S}" xmlns="http://www.w3.org/2000/svg" role="img">${inner}</svg>`;

  const renderers = {
    mug(hex) {
      const s = stroke(hex), hi = shade(hex, 26), lo = shade(hex, -22);
