        <defs><linearGradient id="mg" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="${lo}"/><stop offset="0.2" stop-color="${hex}"/>
          <stop offset="0.8" stop-color="${hi}"/><stop offset="1" stop-color="${lo}"/>
